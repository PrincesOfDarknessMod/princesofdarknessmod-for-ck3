				margin_top = -10
				icon = {
					size = { 52 52 }
					texture = "[SecretType.GetIcon]"
					tintcolor = "[TooltipInfo.GetTintColor]"
				}
			}
		}

		blockoverride "title_text" {
			text = "[SecretType.GetNameNoTooltip]"
		}
		blockoverride "concept_link" {
