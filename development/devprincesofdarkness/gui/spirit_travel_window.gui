				scrollbox = {
					layoutpolicy_vertical = expanding
					minimumsize = { 290 800 }
					header_standard = {
						layoutpolicy_horizontal = expanding
						minimumsize = { 290 20 }
						blockoverride "header_text" {
							text = "[Localize('LOCAL_SPIRIT')]"
							default_format = "#high"
						}

						blockoverride "button_close"
						{
							visible = no
						}
					}
					
					blockoverride "scrollbox_content" {
						vbox = {
							margin_top = 40
							spacing = 5
							datamodel = "[GetPlayer.MakeScope.GetList('spirit_list')]"
							item = {
								vbox = {
									datacontext = "[Scope.GetCharacter]"
									hbox = {
										layoutpolicy_horizontal = growing
										spacing = 5
										
										portrait_head_small = {
											parentanchor = top|left
											blockoverride "portrait_transformation"
											{
												portrait_scale = { -1 1 }
												portrait_offset = { 1 0 }
											}
											blockoverride "opinion_box" {}
											blockoverride "status_icons" {}
										}
										vbox = {
											spacing = 5
											text_multi = {
												raw_text = "[Character.GetFirstNameNoTooltip]:"
												default_format = "#high;bold;italic"
												size = { 210 25 }
												parentanchor = top|left
												align = left|top
												fontsize = 16
											}
											text_multi = {
												text = "[Localize( Concatenate( 'random_wraith_dialog_' , Character.MakeScope.GetVariable('random_dialog').GetFlagName ) )]"
												default_format = "#high;"
												size = { 210 30 }
												parentanchor = top|left
												align = left|top
												fontsize = 16
											}
										}
									}
									expand = {}
								}
							}
						}
					}
				}
			}
		}
	}
}