window = {
	name = "spirit_travel"
	layer = middle
	parentanchor = center
	size = { 900 850 }
	using = Window_Background_Popup
	datacontext = "[GetPlayer]"
	
	# state = {
		# name = PAUSE_GAME

		# trigger_when = "[Not(IsGamePaused)]"
		# on_finish = "[SetGameSpeed('(int32)0')]"
		# on_start = "[OnPause]"
	# }
	
	state = {
		name = _show
		position = { 0 0 }
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}
	
	state = {
		name = _hide
		position = { -60 0 }
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}

	state = {
		name = spirit_location_initialize
		trigger_on_create = yes
		trigger_when = "[GetScriptedGui('spirit_location_initiate').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_start = "[GetScriptedGui('spirit_location_initiate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}
		
	background = {
		name = "triangle_background"
		alpha = 0.7
		fittype = start
		texture = "gfx/interface/illustrations/spirit_world.dds"

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
			blend_mode = alphamultiply
			mirror = vertical
		}
	}
	
	vbox = {
		name = "event_text_box"
		header_standard = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text" {
				text = "[Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_title'))]"
				default_format = "#high"
			}

			blockoverride "button_close"
			{
				onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets spirit_travel')]"
			}
		}

		widget = {
			name = "text"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			hbox = {
				name = "description_and_options"
			
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin  = { 25 25 }
					scrollarea = {
						name = "description_scrollarea"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						scrollbarpolicy_horizontal = always_off

						scrollbar_vertical = {
							using = Scrollbar_Vertical
						}

						scrollwidget = {
							text_multi = {
								name = "description"
								text = "[Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_desc'))][Localize('line_break')][Localize('line_break')][Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_effect_desc'))]"
								default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
								minimumsize = { 560 -1 }
								maximumsize = { 560 -1 }
								autoresize = yes
								fontsize = 16
							}
						}
					}
					
					vbox = {
						spacing = 10
						margin = { 10 10 }
						button_event_letter = {
							text = "[Localize('SPIRIT_TRAVELING_TOOLTIP')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							visible = "[GetScriptedGui('spirit_travel_moving').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							enabled = "[GetScriptedGui('spirit_travel_moving').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						# button_event_letter = {
							# text = "[Localize('null_zone_option')]"
