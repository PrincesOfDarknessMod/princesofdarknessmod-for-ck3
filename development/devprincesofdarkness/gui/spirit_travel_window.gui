window = {
	name = "spirit_travel"
	layer = middle
	parentanchor = center
	size = { 900 850 }
	using = Window_Background_Popup
	datacontext = "[GetPlayer]"
	
	state = {
		name = PAUSE_GAME

		trigger_when = "[Not(IsGamePaused)]"
		on_finish = "[SetGameSpeed('(int32)0')]"
		on_start = "[OnPause]"
	}

	state = {
		name = spirit_location_initialize
		trigger_on_create = yes
		trigger_when = "[GetScriptedGui('spirit_location_initiate').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_start = "[GetScriptedGui('spirit_location_initiate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	state = {
		name = spirit_list_initialize
		trigger_on_create = yes
		trigger_when = "[GetScriptedGui('spirit_list_initiate').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_start = "[GetScriptedGui('spirit_list_initiate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}
		
	background = {
		name = "triangle_background"
		alpha = 0.7
		fittype = start
		texture = "gfx/interface/illustrations/spirit_world.dds"
	}
	
	vbox = {
		name = "event_text_box"
		header_standard = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text" {
				text = "[Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_title'))]"
				default_format = "#high"
			}

			blockoverride "button_close"
			{
				onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets spirit_travel')]"
			}
		}

		widget = {
			name = "text"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			hbox = {
				name = "description_and_options"
			
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin  = { 25 25 }
					scrollarea = {
						name = "description_scrollarea"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						scrollbarpolicy_horizontal = always_off

						scrollbar_vertical = {
							using = Scrollbar_Vertical
						}

						scrollwidget = {
							text_multi = {
								name = "description"
								text = "[Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_desc'))]"
								default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
								minimumsize = { 550 -1 }
								maximumsize = { 550 -1 }
								autoresize = yes
								fontsize = 16
							}
						}
					}
					
					vbox = {
						spacing = 10
						margin = { 10 10 }
						button_event_letter = {
							text = "[Localize('SPIRIT_TRAVELING_TOOLTIP')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							visible = "[GetScriptedGui('spirit_travel_moving').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							enabled = "[GetScriptedGui('spirit_travel_moving').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_event_letter = {
							text = "[Localize('skinlands_option')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							visible = "[GetScriptedGui('spirit_location_skinlands_choose').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetScriptedGui('spirit_location_skinlands_choose').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_event_letter = {
							text = "[Localize('penumbra_option')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							tooltip = "[Localize('UMBRA_TOOLTIP')]"
							tooltip_enabled = "[Not( GetScriptedGui('spirit_location_penumbra_choose').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End) )]"
							enabled = "[GetScriptedGui('spirit_location_penumbra_choose').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							
							visible = "[GetScriptedGui('spirit_location_penumbra_choose').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetScriptedGui('spirit_location_penumbra_choose').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_event_letter = {
							text = "[Localize('astral_reaches_option')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							visible = "[GetScriptedGui('spirit_location_astral_reaches_choose').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetScriptedGui('spirit_location_astral_reaches_choose').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_event_letter = {
							text = "[Localize('spirit_wilds_option')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							visible = "[GetScriptedGui('spirit_location_spirit_wilds_choose').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetScriptedGui('spirit_location_spirit_wilds_choose').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_event_letter = {
							text = "[Localize('near_dreaming_option')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							visible = "[GetScriptedGui('spirit_location_near_dreaming_choose').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetScriptedGui('spirit_location_near_dreaming_choose').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_event_letter = {
							text = "[Localize('shadowlands_option')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							tooltip = "[Localize('UNDERWORLD_TOOLTIP')]"
							tooltip_enabled = "[Not( GetScriptedGui('spirit_location_shadowlands_choose').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End) )]"
							enabled = "[GetScriptedGui('spirit_location_shadowlands_choose').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
							visible = "[GetScriptedGui('spirit_location_shadowlands_choose').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetScriptedGui('spirit_location_shadowlands_choose').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_event_letter = {
							text = "[Localize('tempest_option')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							visible = "[GetScriptedGui('spirit_location_tempest_choose').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetScriptedGui('spirit_location_tempest_choose').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						# button_event_letter = {
							# text = "[Localize('dark_kingdom_of_clay_option')]"
							# default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							# visible = "[GetScriptedGui('spirit_location_dark_kingdom_of_clay_choose').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							# onclick = "[GetScriptedGui('spirit_location_dark_kingdom_of_clay_choose').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						# }
						button_event_letter = {
							text = "[Localize('dark_kingdom_of_iron_option')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							visible = "[GetScriptedGui('spirit_location_dark_kingdom_of_iron_choose').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetScriptedGui('spirit_location_dark_kingdom_of_iron_choose').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_event_letter = {
							text = "[Localize('dark_kingdom_of_ivory_option')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							visible = "[GetScriptedGui('spirit_location_dark_kingdom_of_ivory_choose').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetScriptedGui('spirit_location_dark_kingdom_of_ivory_choose').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_event_letter = {
							text = "[Localize('dark_kingdom_of_jade_option')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							visible = "[GetScriptedGui('spirit_location_dark_kingdom_of_jade_choose').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetScriptedGui('spirit_location_dark_kingdom_of_jade_choose').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						# button_event_letter = {
							# text = "[Localize('dark_kingdom_of_obsidian_option')]"
							# default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							# visible = "[GetScriptedGui('spirit_location_dark_kingdom_of_obsidian_choose').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							# onclick = "[GetScriptedGui('spirit_location_dark_kingdom_of_obsidian_choose').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						# }
						button_event_letter = {
							text = "[Localize('dark_kingdom_of_sand_option')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							visible = "[GetScriptedGui('spirit_location_dark_kingdom_of_sand_choose').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetScriptedGui('spirit_location_dark_kingdom_of_sand_choose').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}
				}

				scrollbox = {
					layoutpolicy_vertical = expanding
					minimumsize = { 290 800 }
					header_standard = {
						layoutpolicy_horizontal = expanding
						minimumsize = { 290 20 }
						blockoverride "header_text" {
							text = "[Localize('LOCAL_SPIRIT')]"
							default_format = "#high"
						}

						blockoverride "button_close"
						{
							visible = no
						}
					}
					
					blockoverride "scrollbox_content" {
						vbox = {
							margin_top = 40
							spacing = 5
							datamodel = "[GetPlayer.MakeScope.GetList('spirit_list')]"
							item = {
								vbox = {
									datacontext = "[Scope.GetCharacter]"
									hbox = {
										layoutpolicy_horizontal = growing
										spacing = 5
										
										portrait_head_small = {
											parentanchor = top|left
											blockoverride "portrait_transformation"
											{
												portrait_scale = { -1 1 }
												portrait_offset = { 1 0 }
											}
											blockoverride "opinion_box" {}
											blockoverride "status_icons" {}
										}
										vbox = {
											spacing = 5
											text_multi = {
												raw_text = "[Character.GetFirstNameNoTooltip]:"
												default_format = "#high;bold;italic"
												size = { 210 27 }
												parentanchor = top|left
												align = left|top
												fontsize = 16
											}
											text_multi = {
												text = "[Localize( Concatenate( 'random_wraith_dialog_' , Character.MakeScope.GetVariable('random_dialog').GetFlagName ) )]"
												default_format = "#high;"
												size = { 210 27 }
												parentanchor = top|left
												align = left|top
												fontsize = 16
											}
										}
									}
									expand = {}
								}
							}
						}
					}
				}
			}
		}
	}
}