 weather_magic_storm_modifier:0 "Tormenta"
 weather_magic_storm_modifier_desc:0 "Esta zona está dañada por huracán, tornado, ventisca, tormenta eléctrica o tormenta de arena."
 weather_magic_earthquake_modifier:0 "Terremoto"
 weather_magic_earthquake_modifier_desc:0 "Esta zona está dañada por un terremoto."
 weather_magic_plague_modifier:0 "Peste"
 weather_magic_plague_modifier_desc:0 "Esta zona está dañada por ranas, piojos, moscas, peste, forúnculos o langostas."
 weather_magic_flood_modifier:0 "Inundación"
 weather_magic_flood_modifier_desc:0 "Esta zona está dañada por inundación".
 weather_magic_drought_modifier:0 "Sequía"
 weather_magic_drought_modifier_desc:0 "Esta zona está dañada por la sequía".
 
