######################################################
############# INTERACTION Disciplines ################
######################################################

window = {
	name = "blood_sorcery"
	position = { 0 0 }
	parentanchor = center

	layer = windows_layer
	size = { 600 600 }

	state = {
		name = _show
		on_start = "[GetVariableSystem.Clear( 'character_interaction_change_title' )]"
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}
	using = Window_Background
	using = Window_Decoration_Spike
	
	visible = "[GetScriptedGui('blood_sorcery').IsShown(GuiScope.AddScope('player',GetPlayer.MakeScope).End)]"
	
	vbox = {
		using = Window_Margins
		set_parent_size_to_minimum = yes
		spacing = 5
		header_pattern_interaction = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text" {
				text = "title_bs"
			}

			blockoverride "button_close"
			{
				onclick = "[GetScriptedGui('blood_sorcery').Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
			}

			icon_character_interaction = {}
		}

		
		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 8
			
			name = "paths"
			button_tab = {
				datacontext = "[GetScriptedGui('path_of_blood_choose')]"
				texture = "gfx/interface/icons/Pathofblood_Thaum.dds"
				size = { 60 60 }
				framesize = { 60 60 }
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				down = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			button_tab = {
				datacontext = "[GetScriptedGui('path_of_mars_choose')]"
				texture = "gfx/interface/icons/PathofMars_Thaum.dds"
				size = { 60 60 }
				framesize = { 60 60 }
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				down = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
			}
			button_tab = {
				datacontext = "[GetScriptedGui('path_of_neptunes_might_choose')]"
				texture = "gfx/interface/icons/PathofNeptunesmight_Thaum.dds"
				size = { 60 60 }
				framesize = { 60 60 }
				frame = 1
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				down = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			button_tab = {
				datacontext = "[GetScriptedGui('path_of_curses_choose')]"
				texture = "gfx/interface/icons/PathofCurses_Thaum.dds"
				size = { 60 60 }
				framesize = { 60 60 }
				frame = 1
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				down = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	
			}
			button_tab = {
				datacontext = "[GetScriptedGui('path_of_focused_mind_choose')]"
				texture = "gfx/interface/icons/Pathoffocmind_Thaum.dds"
				size = { 60 60 }
				framesize = { 60 60 }
				frame = 1
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				down = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

			}
			button_tab = {
				datacontext = "[GetScriptedGui('path_of_praapti_choose')]"
				texture = "gfx/interface/icons/Pathofpraapti_Akhu.dds"
				size = { 60 60 }
				framesize = { 60 60 }
				frame = 1
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				down = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

			}
			button_tab = {
				datacontext = "[GetScriptedGui('path_of_music_of_the_shperes_choose')]"
				texture = "gfx/interface/icons/PathofSpheres_Thaum.dds"
				size = { 60 60 }
				framesize = { 60 60 }
				frame = 1
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				down = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

			}
	#		button_tab = {
	#			texture = "gfx/interface/icons/traits/oblivion.dds"
	#			size = { 60 60 }
	#			framesize = { 60 60 }
		#		frame = 1
#
			#}
			
		}
		text_single = {
			text = "[Localize(Concatenate(GetPlayer.MakeScope.GetVariable('chosen_path').GetFlagName, 'loc'))]"
			font = TitleFont
			fontsize = 23
	
		}
		spacer = {
			size = { 0 10 }
		}
		hbox = {
			spacing = 9
			widget = {
				size = { 200 30 }
				hbox = {
					text_single = {
						text = "current_exp"
					}
					text_single = {
						text = "[GetPlayer.MakeScope.Var('blood_sorcery_points').GetValue|0]"
					}
					
				}
			}
			button_standard = {
				datacontext = "[GetScriptedGui(Concatenate(GetPlayer.MakeScope.GetVariable('chosen_path').GetFlagName,'_buy'))]"
				text = "[Localize('purchase')]"
				enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				
			}
			widget = {
				size = { 200 30 }
				hbox = { 
					
					text_single = {
						text = "[Localize('cost_loc')]"
					}
					text_single = {
						text = "[GetPlayer.MakeScope.Var('blood_sorcery_cost').GetValue|0]"
					}
					
				}
			}
		}
		scrollbox = {
			
			name = "list"
			layoutpolicy_horizontal = expanding
			size = { 300 200 }


			blockoverride "scrollbox_content"
			{
				vbox = {
					datamodel = "[GetPlayer.MakeScope.GetList(GetPlayer.MakeScope.GetVariable('chosen_path').GetFlagName)]"
					layoutpolicy_horizontal = expanding
					spacing = 3

					item = {
						hbox = {
							
							layoutpolicy_horizontal = expanding
							spacing = 8
							button_standard = {
								datacontext = "[GetVariableSystem]"
								layoutpolicy_horizontal = expanding
								down = "[VariableSystem.HasValue( 'Chosen_Power', Scope.GetFlagName )]"
								onclick = "[VariableSystem.Set( 'Chosen_Power', Scope.GetFlagName )]"								
								text = "[Localize(Concatenate( 'power_', Scope.GetFlagName))]"
								datacontext = "[GetScriptedGui(Scope.GetFlagName)]"
								enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('target', GetPlayer.MakeScope.GetVariable('target').GetCharacter.MakeScope).End) ]"
								tooltip = "[ScriptedGui.BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('target', GetPlayer.MakeScope.GetVariable('target').GetCharacter.MakeScope).End)]"
							}

		
						}
					}
				}
			}
		}
		
		button_checkbox_label = {
			datacontext = "[GetScriptedGui('use_willpower_check')]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			blockoverride "checkbox" {
				checked = "[ScriptedGui.IsShown( GuiScope.SetRoot(GetPlayer.MakeScope).End)]"		
			}
			blockoverride "text" 
			{
				text = "[Localize('use_willpower')]"
			}
			
		}
		button_standard = {
			datacontext = "[GetVariableSystem]"
			datacontext = "[GetScriptedGui(VariableSystem.Get('Chosen_Power'))]"
			enabled = "[And(ScriptedGui.IsValid(GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('target', GetPlayer.MakeScope.GetVariable('target').GetCharacter.MakeScope).End), GetScriptedGui('blood_sorcery').IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End)) ]"
			onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('target', GetPlayer.MakeScope.GetVariable('target').GetCharacter.MakeScope).End)]"
			tooltip = "[ScriptedGui.BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('target', GetPlayer.MakeScope.GetVariable('target').GetCharacter.MakeScope).End)]"
			text = "[Localize('execute_loc')]"
		}
		hbox = {
			spacing = 4
			vbox = {
				text_single = {
					text = "[Localize('caster_loc')]"
				}				
				portrait_shoulders = {
					datacontext = "[GetPlayer]"
					name = "caster_portrait"
					blockoverride "opinion_box" {}
					blockoverride "status_icons" {}
				}
			}
			vbox = {
				spacing = 5
				text_single = {
					text = "[Localize('effects_loc')]"
				}
				scrollbox = {
					name = "effects_scrollarea"
					using = Window_Decoration_Spike
					
					size = { 350 170 }

					blockoverride "scrollbox_content"
					{	
						margin = { 0 20 }

						text_multi = {
							datacontext = "[GetVariableSystem]"
							datacontext = "[GetScriptedGui(VariableSystem.Get('Chosen_Power'))]"
							name = "accept_effects_info"
							layoutpolicy_horizontal = expanding
							
							autoresize = yes
							max_width = 330
							margin = { 5 0 }
							text = "[ScriptedGui.BuildTooltip( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope('target', GetPlayer.MakeScope.GetVariable('target').GetCharacter.MakeScope).End)]"
						}

						block "extra_content" {}
					}

				}
			}
			vbox = {
				text_single = {
					text = "[Localize('target_loc')]"
				}
				portrait_shoulders = {
					datacontext = "[GetPlayer.MakeScope.GetVariable('target').GetCharacter]"
					name = "target_portrait"
					#blockoverride "opinion_box" {}
					#blockoverride "status_icons" {}
				}
			}
		}
		
		

	}
	




}
