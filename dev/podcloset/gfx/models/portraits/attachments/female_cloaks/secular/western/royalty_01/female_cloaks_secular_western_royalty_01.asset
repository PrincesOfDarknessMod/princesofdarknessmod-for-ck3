pdxmesh = {
	name = "female_cloaks_secular_western_royalty_01_mesh"
	file = "female_cloaks_secular_western_royalty_01.mesh"

	meshsettings = {
		name = "female_cloaks_secular_western_royalty_01Shape"
		index = 0
		texture_diffuse = "male_cloaks_secular_western_royalty_01_diffuse.dds"
		texture_normal = "male_cloaks_secular_western_royalty_01_normal.dds"
		texture_specular = "male_cloaks_secular_western_royalty_01_properties.dds"
		shader = "portrait_attachment_pattern"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}

entity = {
	name = "female_cloaks_secular_western_royalty_01_entity"
	pdxmesh = "female_cloaks_secular_western_royalty_01_mesh"

	game_data = {
        portrait_entity_user_data = {
			portrait_accessory = {
				pattern_mask = "gfx/models/portraits/attachments/male_cloaks/secular/western/royalty_01/male_cloaks_secular_western_royalty_01_masks.dds"	#Any 4-channel texture. Each channel will be used to mask a pattern from the variation object
				variation = "western_cloaks_royalty_01"	#A "variation" object in gfx/portraits/accessory_variations/
			}
        }
	}
}





