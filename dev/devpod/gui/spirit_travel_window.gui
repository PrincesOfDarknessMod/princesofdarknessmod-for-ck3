				vbox = {
					layoutpolicy_vertical = expanding
					minimumsize = { 300 800 }
					vbox = {
						spacing = 5
						datacontext = "[GetPlayer.MakeScope.GetVariable('umbra_ruler').GetCharacter]"
						text_single = {
							name = "header_text"

							block "header_text" {
								raw_text = "[Character.GetNameNoTooltip]"
								default_format = "#high;bold;italic"
							}

							maximumsize = { 300 -1 }

							using = Font_Type_Flavor
							using = Font_Size_Big
							fontsize_min = 14
						}
						portrait_shoulders = {
							blockoverride "status_icons" {}
							blockoverride "opinion_box" {}
							blockoverride "coa" {}
							blockoverride "dead_icon" {}
						}
						hbox = {
							layoutpolicy_vertical = expanding
							spacing = 2
							
							icon = {
								size = { 30 30 }
								texture = "gfx/interface/icons/icon_grace.dds"
							}

							flowcontainer = {
								ignoreinvisible = yes
								text_single = {
									margin_bottom = 4
									text = "[GetPlayer.MakeScope.GetVariable('current_grace').GetValue|0]"
									max_width = 50
									default_format = "#high"
									using = Font_Size_Medium
								}
							}
						}
						hbox = {
							spacing = 10
							vbox = {
								spacing = 5
								text_single = {
									raw_text = "[Localize('umbra_offer')]"

									using = Font_Type_Flavor
									using = Font_Size_Big
									fontsize_min = 14
								}
								button_event_letter = {
									size = { 120 34 }
									default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
									text = "[Localize('umbra_offer_piety')]"
									datacontext = "[GetScriptedGui( 'umbra_offer_piety' )]"
							
									tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								button_event_letter = {
									size = { 120 34 }
									default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
									text = "[Localize('umbra_offer_prestige')]"
									datacontext = "[GetScriptedGui( 'umbra_offer_prestige' )]"
							
									tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
							vbox = {
								spacing = 5
								text_single = {
									text = "[Localize('umbra_request')]"

									using = Font_Type_Flavor
									using = Font_Size_Big
									fontsize_min = 14
								}
								button_event_letter = {
									size = { 120 34 }
									text = "[Localize('umbra_request_perk')]"
									default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
									using = Font_Type_Flavor
									datacontext = "[GetScriptedGui( 'umbra_request_perk' )]"
									
									tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								button_event_letter = {
									size = { 120 34 }
									text = "[Localize('umbra_request_army')]"
									default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
									using = Font_Type_Flavor
									datacontext = "[GetScriptedGui( 'umbra_request_army' )]"
									
									tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
						}
					}
					vbox = {
						layoutpolicy_vertical = expanding
					}
					vbox = {
						margin_bottom = 20
						spacing = 10
						button_standard_clean = {
							text = "UMBRA_EXPLORATION"
							datacontext = "[GetScriptedGui( 'umbra_exploration_choose' )]"
						
							enabled = "[And(Not(IsPausedByEvent), ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
							
							tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_confirm"
						}
						button_standard_clean = {
							text = "MANIPULATE_THE_WALL"
							datacontext = "[GetScriptedGui( 'manipulate_the_wall_choose' )]"
						
							tooltip = "[Localize('MANIPULATE_THE_WALL_TOOLTIP')]"
