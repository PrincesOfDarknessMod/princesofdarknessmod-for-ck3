				vbox = {
					layoutpolicy_vertical = expanding
					minimumsize = { 300 800 }
					vbox = {
						spacing = 5
						datacontext = "[GetPlayer.MakeScope.GetVariable('umbra_ruler').GetCharacter]"
						text_single = {
							name = "header_text"

							block "header_text" {
								raw_text = "[Character.GetNameNoTooltip]"
								default_format = "#high;bold;italic"
							}

							maximumsize = { 300 -1 }

							using = Font_Type_Flavor
							using = Font_Size_Big
							fontsize_min = 14
						}
						portrait_shoulders = {
							blockoverride "status_icons" {}
							blockoverride "opinion_box" {}
							blockoverride "coa" {}
							blockoverride "dead_icon" {}
						}
						hbox = {
							layoutpolicy_vertical = expanding
							spacing = 2
							
							icon = {
								size = { 30 30 }
								texture = "gfx/interface/icons/icon_grace.dds"
							}

							flowcontainer = {
								ignoreinvisible = yes
								text_single = {
									margin_bottom = 4
									text = "[GetPlayer.MakeScope.GetVariable('current_grace').GetValue|0]"
									max_width = 50
									default_format = "#high"
									using = Font_Size_Medium
								}
							}
						}
