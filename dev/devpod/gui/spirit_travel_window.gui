window = {
	name = "spirit_travel"
	layer = middle
	parentanchor = center
	size = { 900 850 }
	using = Window_Background_Popup
	datacontext = "[GetPlayer]"

	visible = "[GetVariableSystem.Exists( 'spirit_travel_open' )]"
	
	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}
	
	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}
		
	background = {
		name = "triangle_background"
		alpha = 0.7
		fittype = start
		texture = "gfx/interface/illustrations/spirit_world.dds"

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
			blend_mode = alphamultiply
			mirror = vertical
		}
	}
	
	vbox = {
		name = "event_text_box"
		header_standard = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text" {
				text = "[Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_title'))]"
				default_format = "#high"
			}

			blockoverride "button_close"
			{
				onclick = "[GetVariableSystem.Toggle('spirit_travel_open')]"
			}
		}

		widget = {
			name = "text"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			hbox = {
				name = "description_and_options"
			
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin  = { 20 20 }
					scrollarea = {
						name = "description_scrollarea"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						scrollbarpolicy_horizontal = always_off

						scrollbar_vertical = {
							using = Scrollbar_Vertical
						}

						scrollwidget = {
							text_multi = {
								name = "description"
								text = "[Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_desc'))][Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_tooltip'))]"
								default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
								minimumsize = { 560 -1 }
								maximumsize = { 560 -1 }
								autoresize = yes
								fontsize = 16
							}
						}
					}
					
					vbox = {
						spacing = 10
						margin = { 10 10 }
						button_event_letter = {
							text = "[Localize('SPIRIT_TRAVELING_TOOLTIP')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							
							visible = "[GetScriptedGui('spirit_travel_moving').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							enabled = "[GetScriptedGui('spirit_travel_moving').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_event_letter = {
							text = "[Localize('null_zone_confirm')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							datacontext = "[GetScriptedGui( 'spirit_location_null_zone_choose' )]"
							
							tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							
							visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_event_letter = {
							text = "[Localize('mirror_zone_confirm')]"
							default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
							datacontext = "[GetScriptedGui( 'spirit_location_mirror_zone_choose' )]"
							
							tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							
							visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						# button_umbra_underworld = {
