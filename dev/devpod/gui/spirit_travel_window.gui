									datacontext = "[GetScriptedGui( 'umbra_request_perk' )]"
									
									tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
								button_event_letter = {
									size = { 120 34 }
									text = "[Localize('umbra_request_army')]"
									default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
									using = Font_Type_Flavor
									datacontext = "[GetScriptedGui( 'umbra_request_army' )]"
									
									tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
						}
					}
					vbox = {
						layoutpolicy_vertical = expanding
					}
					vbox = {
						margin_bottom = 15
						spacing = 10
						button_standard_clean = {
							text = "MANIPULATE_THE_WALL"
							datacontext = "[GetScriptedGui( 'manipulate_the_wall_choose' )]"
						
							tooltip = "[Localize('MANIPULATE_THE_WALL_TOOLTIP')]"
							enabled = "[And(Not(IsPausedByEvent), ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
							
							visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_confirm"
						}
						button_standard_clean = {
							text = "MANIPULATE_THE_SHROUD"
							datacontext = "[GetScriptedGui( 'manipulate_the_shroud_choose' )]"
						
							tooltip = "[Localize('MANIPULATE_THE_SHROUD_TOOLTIP')]"
							enabled = "[And(Not(IsPausedByEvent), ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						
							visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_confirm"
						}
					}
				}
			}
		}
	}
}

