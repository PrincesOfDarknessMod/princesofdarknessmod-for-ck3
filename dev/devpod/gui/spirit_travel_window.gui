types Buttons
{
    type button_umbra_underworld = button_event_letter
    {
        texture = "gfx/interface/buttons/button_umbra_underworld.dds"

        default_format = "#light_background;high;glow_color:{0.1,0.1,0.1,1.0}"
    }

    type button_umbra_astral_reaches = button_event_letter
    {
