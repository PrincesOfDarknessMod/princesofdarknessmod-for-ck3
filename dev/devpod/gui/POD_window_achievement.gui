							blockoverride "achievement_name" { text = "achievement_06" }
							blockoverride "achievement_desc" { text = "achievement_06_tt" }
						}
						# Wait, Wrong Demon!
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 2 }
							datacontext = "[GetScriptedGui( 'achievement_08_gui' )]"
							blockoverride "achievement_name" { text = "achievement_08" }
							blockoverride "achievement_desc" { text = "achievement_08_tt" }
						}
						# No Canon Ending for Me
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 2 }
							datacontext = "[GetScriptedGui( 'achievement_13_gui' )]"
							blockoverride "achievement_name" { text = "achievement_13" }
							blockoverride "achievement_desc" { text = "achievement_13_tt" }
						}
						# The Truth about Saulot?
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 2 }
							datacontext = "[GetScriptedGui( 'achievement_14_gui' )]"
							blockoverride "achievement_name" { text = "achievement_14" }
							blockoverride "achievement_desc" { text = "achievement_14_tt" }
						}
						# My Precious
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 2 }
							datacontext = "[GetScriptedGui( 'achievement_25_gui' )]"
							blockoverride "achievement_name" { text = "achievement_25" }
							blockoverride "achievement_desc" { text = "achievement_25_tt" }
						}
						# Making Fetch Happen
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 2 }
							datacontext = "[GetScriptedGui( 'achievement_27_gui' )]"
							blockoverride "achievement_name" { text = "achievement_27" }
							blockoverride "achievement_desc" { text = "achievement_27_tt" }
						}
						# Ambition Erudition
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 2 }
							datacontext = "[GetScriptedGui( 'achievement_29_gui' )]"
							blockoverride "achievement_name" { text = "achievement_29" }
							blockoverride "achievement_desc" { text = "achievement_29_tt" }
						}
						# Bringing the Gang Back Together
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 2 }
							datacontext = "[GetScriptedGui( 'achievement_36_gui' )]"
							blockoverride "achievement_name" { text = "achievement_36" }
							blockoverride "achievement_desc" { text = "achievement_36_tt" }
						}
					}
					
					pod_achievement_category = {
						blockoverride "text" { text = "POD_hard_achievements_title" }
						blockoverride "button" {
							frame   = "[BoolTo1And2(GetVariableSystem.Exists('POD_hard_achievements'))]"
							onclick = "[GetVariableSystem.Toggle('POD_hard_achievements')]"
						}
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

						visible = "[GetVariableSystem.Exists('POD_hard_achievements')]"

						# Somehow, he has returned
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 3 }
							datacontext = "[GetScriptedGui( 'achievement_04_gui' )]"
							blockoverride "achievement_name" { text = "achievement_04" }
							blockoverride "achievement_desc" { text = "achievement_04_tt" }
						}
						# Ate My Way Up The Ladder
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 3 }
							datacontext = "[GetScriptedGui( 'achievement_38_gui' )]"
							blockoverride "achievement_name" { text = "achievement_38" }
							blockoverride "achievement_desc" { text = "achievement_38_tt" }
