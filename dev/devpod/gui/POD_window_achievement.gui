	vbox = {
		using = Window_Margins
		restrictparent_min = yes
        spacing = 10
		ignoreinvisible = yes
		allow_outside = yes

		vbox = {
			layoutpolicy_horizontal = expanding
			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					text = "ACHIEVEMENT"
				}

				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Clear('pod_achievement')]"
				}
			}
		}
		
		text_single = {
			text = "[Localize('cross_save_tt')]"
            fontsize = 20
			max_width = 580
		}
		
		spacer = { size = { 0 5 } }  
		scrollbox = {
            size = { 600 750 }

            background = {
                using = Background_Area
				alpha = 0.1
            }

            blockoverride "scrollbox_content"
            {
				vbox = {
					layoutpolicy_horizontal = expanding

					spacing = 6
					
					pod_achievement_category = {
						blockoverride "text" { text = "POD_very_easy_achievements_title" }
						blockoverride "button" {
							frame   = "[BoolTo1And2(GetVariableSystem.Exists('POD_very_easy_achievements'))]"
							onclick = "[GetVariableSystem.Toggle('POD_very_easy_achievements')]"
						}
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

						visible = "[GetVariableSystem.Exists('POD_very_easy_achievements')]"

						# True Blood
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 1 }
							datacontext = "[GetScriptedGui( 'achievement_16_gui' )]"
							blockoverride "achievement_name" { text = "achievement_16" }
							blockoverride "achievement_desc" { text = "achievement_16_tt" }
						}
						# Respect My Authority
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 1 }
							datacontext = "[GetScriptedGui( 'achievement_17_gui' )]"
							blockoverride "achievement_name" { text = "achievement_17" }
							blockoverride "achievement_desc" { text = "achievement_17_tt" }
						}
						# DIY
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 1 }
							datacontext = "[GetScriptedGui( 'achievement_18_gui' )]"
							blockoverride "achievement_name" { text = "achievement_18" }
							blockoverride "achievement_desc" { text = "achievement_18_tt" }
						}
						# Master of Puppets
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 1 }
							datacontext = "[GetScriptedGui( 'achievement_19_gui' )]"
							blockoverride "achievement_name" { text = "achievement_19" }
							blockoverride "achievement_desc" { text = "achievement_19_tt" }
						}
						# By Our Powers Combined...
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 1 }
							datacontext = "[GetScriptedGui( 'achievement_20_gui' )]"
							blockoverride "achievement_name" { text = "achievement_20" }
							blockoverride "achievement_desc" { text = "achievement_20_tt" }
						}
						# Adventure Time
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 1 }
							datacontext = "[GetScriptedGui( 'achievement_21_gui' )]"
							blockoverride "achievement_name" { text = "achievement_21" }
							blockoverride "achievement_desc" { text = "achievement_21_tt" }
						}
						# What's Yours Is Mine
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 1 }
							datacontext = "[GetScriptedGui( 'achievement_22_gui' )]"
							blockoverride "achievement_name" { text = "achievement_22" }
							blockoverride "achievement_desc" { text = "achievement_22_tt" }
						}
					}
					
					pod_achievement_category = {
						blockoverride "text" { text = "POD_easy_achievements_title" }
						blockoverride "button" {
							frame   = "[BoolTo1And2(GetVariableSystem.Exists('POD_easy_achievements'))]"
							onclick = "[GetVariableSystem.Toggle('POD_easy_achievements')]"
						}
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

						visible = "[GetVariableSystem.Exists('POD_easy_achievements')]"

						# A Fitting End for this Story
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 1 }
							datacontext = "[GetScriptedGui( 'achievement_23_gui' )]"
							blockoverride "achievement_name" { text = "achievement_23" }
							blockoverride "achievement_desc" { text = "achievement_23_tt" }
						}
						# A Fitting Start for this Fanfiction
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 1 }
							datacontext = "[GetScriptedGui( 'achievement_24_gui' )]"
							blockoverride "achievement_name" { text = "achievement_24" }
							blockoverride "achievement_desc" { text = "achievement_24_tt" }
						}
						# All Roads Lead To Me
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 1 }
							datacontext = "[GetScriptedGui( 'achievement_26_gui' )]"
							blockoverride "achievement_name" { text = "achievement_26" }
							blockoverride "achievement_desc" { text = "achievement_26_tt" }
						}
					}
					
					pod_achievement_category = {
