						}
						# Avengers Assemble
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 3 }
							datacontext = "[GetScriptedGui( 'achievement_30_gui' )]"
							blockoverride "achievement_name" { text = "achievement_30" }
							blockoverride "achievement_desc" { text = "achievement_30_tt" }
						}
					}
					
					pod_achievement_category = {
						blockoverride "text" { text = "POD_very_hard_achievements_title" }
						blockoverride "button" {
							frame   = "[BoolTo1And2(GetVariableSystem.Exists('POD_very_hard_achievements'))]"
							onclick = "[GetVariableSystem.Toggle('POD_very_hard_achievements')]"
						}
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

						visible = "[GetVariableSystem.Exists('POD_very_hard_achievements')]"

						# Somehow, he has returned 2: Dancing Queen
						pod_achievement_button = {
							datacontext = "[GetScriptedGui( 'achievement_32_gui' )]"
							blockoverride "achievement_name" { text = "achievement_32" }
							blockoverride "achievement_desc" { text = "achievement_32_tt" }
						}
						# Isis' Revenge
						pod_achievement_button = {
							datacontext = "[GetScriptedGui( 'achievement_10_gui' )]"
							blockoverride "achievement_name" { text = "achievement_10" }
							blockoverride "achievement_desc" { text = "achievement_10_tt" }
						}
						# Very Alternate History
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 3 }
							datacontext = "[GetScriptedGui( 'achievement_09_gui' )]"
							blockoverride "achievement_name" { text = "achievement_09" }
							blockoverride "achievement_desc" { text = "achievement_09_tt" }
						}
						# No, it's 'Kane'
						pod_achievement_button = {
							datacontext = "[GetScriptedGui( 'achievement_33_gui' )]"
							blockoverride "achievement_name" { text = "achievement_33" }
							blockoverride "achievement_desc" { text = "achievement_33_tt" }
						}
						# Catching the Red Dot
						pod_achievement_button = {
							datacontext = "[GetScriptedGui( 'achievement_34_gui' )]"
							blockoverride "achievement_name" { text = "achievement_34" }
							blockoverride "achievement_desc" { text = "achievement_34_tt" }
						}
						# Dream is my Reality
						pod_achievement_button = {
							datacontext = "[GetScriptedGui( 'achievement_02_gui' )]"
							blockoverride "achievement_name" { text = "achievement_02" }
							blockoverride "achievement_desc" { text = "achievement_02_tt" }
						}
						# From the Bottom to the Top
						pod_achievement_button = {
							datacontext = "[GetScriptedGui( 'achievement_15_gui' )]"
							blockoverride "achievement_name" { text = "achievement_15" }
							blockoverride "achievement_desc" { text = "achievement_15_tt" }
						}
						# Valkyrie Ascension
						pod_achievement_button = {
							datacontext = "[GetScriptedGui( 'achievement_35_gui' )]"
							blockoverride "achievement_name" { text = "achievement_35" }
							blockoverride "achievement_desc" { text = "achievement_35_tt" }
						}
					}

					pod_achievement_category = {
						visible = "[PlayerGuiIsShown('has_any_hidden_achievement_gui')]"
						blockoverride "text" { text = "POD_hidden_achievements_title" }
						blockoverride "button" {
							frame   = "[BoolTo1And2(GetVariableSystem.Exists('POD_hidden_achievements'))]"
							onclick = "[GetVariableSystem.Toggle('POD_hidden_achievements')]"
						}
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

						visible = "[GetVariableSystem.Exists('POD_hidden_achievements')]"

						# Gaia's Secret Plan
						pod_achievement_button = {
							datacontext = "[GetScriptedGui( 'achievement_hidden_01_gui' )]"
							blockoverride "achievement_name" { text = "achievement_hidden_01" }
							blockoverride "achievement_desc" { text = "achievement_hidden_01_tt" }
						}
						# Getting Crowded In Here
						pod_achievement_button = {
							datacontext = "[GetScriptedGui( 'achievement_hidden_02_gui' )]"
							blockoverride "achievement_name" { text = "achievement_hidden_02" }
							blockoverride "achievement_desc" { text = "achievement_hidden_02_tt" }
						}
						# Tourist Ascension
						pod_achievement_button = {
							datacontext = "[GetScriptedGui( 'achievement_hidden_03_gui' )]"
							blockoverride "achievement_name" { text = "achievement_hidden_03" }
							blockoverride "achievement_desc" { text = "achievement_hidden_03_tt" }
						}
						# Bragging Rights
						pod_achievement_button = {
							datacontext = "[GetScriptedGui( 'achievement_hidden_04_gui' )]"
							blockoverride "achievement_name" { text = "achievement_hidden_04" }
							blockoverride "achievement_desc" { text = "achievement_hidden_04_tt" }
						}
					}

				}
            }
        }

		expand = {}
	}
}

types PODAchievement
{
	type pod_achievement_category = widget {
	 	size = { 565 30 }
		background = {
			using = Background_Area
			alpha = 1
		}
							
		button_expand = {
			size = { 20 20 }
			parentanchor = vcenter|left

			block "button" {
				frame   = "[BoolTo1And2(GetVariableSystem.Exists('POD_very_easy_achievements'))]"
				onclick = "[GetVariableSystem.Toggle('POD_very_easy_achievements')]"
			}

			position = { 10 0 }
		}

		text_single = {
			layoutpolicy_horizontal = expanding
			block "text" { text = "POD_very_easy_achievements_title" }
			size = { 81 81 }
			fontsize = 18
			position = { 0 -2 }
			default_format = "#high"
			align = center
			parentanchor = center
		}
	}
	type pod_achievement_button = hbox
	{
		layoutpolicy_horizontal = expanding
		
		#tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		#using = tooltip_e

		button_normal = {
			size = { 75 75 }
			clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_advance"
			
			enabled = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			
			icon = {
				block "texture" { texture = "gfx/interface/icons/artifact/artifact_goblet.dds" }
				size = { 65 65 }
				framesize = { 238 240 }
				position = { 10 8 }
				block "achievement_level" { frame = 4 }
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			
			background = {
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				using = Color_Orange
				alpha = 0.3
				texture = "gfx/interface/component_masks/mask_glow.dds"
				texture_density = 2
				using = Mask_Rough_Edges
				margin_bottom = 10

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_rough_texture.dds"
					blend_mode = alphamultiply
					alpha = 0.4
				}
			}

			background = {
				visible = "[Not(ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
				using = Color_Grey
				alpha = 0.2
				texture = "gfx/interface/component_masks/mask_header_lines.dds"
				mirror = horizontal
				spriteType = corneredtiled
				spriteborder_left = 340
				texture_density = 2
				using = Mask_Rough_Edges

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_rough_texture.dds"
					blend_mode = alphamultiply
					alpha = 0.5
				}
			}

			expand = {}

			pod_achievement_title = {
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				block "achievement_name" { text = "ACHIEVEMENT" }
				default_format = "#clickable"
			}
			pod_achievement_title = {
				visible = "[Not(ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
				block "achievement_name" { text = "ACHIEVEMENT" }
				default_format = "#high"
			}
			pod_achievement_desc = {
				visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				block "achievement_desc" { text = "ACHIEVEMENT" }
				default_format = "#medium;bold"
			}
			pod_achievement_desc = {
				visible = "[Not(ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
				block "achievement_desc" { text = "ACHIEVEMENT" }
				default_format = "#weak;bold"
			}

			expand = {}
		}
	}
	type pod_achievement_title = text_multi
	{
		using = Font_Type_Flavor
		max_width = 1000
		autoresize = yes
		align = center

		fontsize = 20
	}
	type pod_achievement_desc = text_multi
	{
		max_width = 415
		autoresize = yes
		align = center
		fontsize = 14
	}
}