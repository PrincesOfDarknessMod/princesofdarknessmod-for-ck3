						blockoverride "button" {
							frame   = "[BoolTo1And2(GetVariableSystem.Exists('POD_medium_achievements'))]"
							onclick = "[GetVariableSystem.Toggle('POD_medium_achievements')]"
						}
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

						visible = "[GetVariableSystem.Exists('POD_medium_achievements')]"

						# Legendary Hero
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 2 }
							datacontext = "[GetScriptedGui( 'achievement_37_gui' )]"
							blockoverride "achievement_name" { text = "achievement_37" }
							blockoverride "achievement_desc" { text = "achievement_37_tt" }
						}
						# Stone Cold Stunner
						pod_achievement_button = {
							blockoverride "achievement_level" { frame = 2 }
							datacontext = "[GetScriptedGui( 'achievement_28_gui' )]"
							blockoverride "achievement_name" { text = "achievement_28" }
							blockoverride "achievement_desc" { text = "achievement_28_tt" }
						}
						# The Latest Crusade
						pod_achievement_button = {
