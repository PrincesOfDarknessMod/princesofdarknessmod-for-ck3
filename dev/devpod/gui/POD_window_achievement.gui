window = {
	name = "pod_achievement_window"
	size = { 600 300 }
	layer = middle
	parentanchor = center
	widgetanchor = center

	visible = "[And( Not( IsPauseMenuShown ), And(Or(Not(IsObserver), And(GetPlayer.IsValid, GetPlayer.IsAlive)), And(IsDefaultGUIMode, GetVariableSystem.Exists( 'pod_achievement' ))))]"

	using = Window_Background
	using = Window_Decoration
	using = Animation_ShowHide_Standard

	state = {
		name = _show
		using = Animation_FadeIn_Quick
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
	}

	state = {
		name = "achievement_01"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_01'), Localize('achievement_01'))]"
		on_start = "[PlayerGuiExecute('achievement_01_set')]"
	}

	state = {
		name = "achievement_02"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_02'), Localize('achievement_02'))]"
		on_start = "[PlayerGuiExecute('achievement_02_set')]"
	}

	state = {
		name = "achievement_03"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_03'), Localize('achievement_03'))]"
		on_start = "[PlayerGuiExecute('achievement_03_set')]"
	}

	state = {
		name = "achievement_04"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_04'), Localize('achievement_04'))]"
		on_start = "[PlayerGuiExecute('achievement_04_set')]"
	}

	state = {
		name = "achievement_05"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_05'), Localize('achievement_05'))]"
		on_start = "[PlayerGuiExecute('achievement_05_set')]"
	}

	state = {
		name = "achievement_06"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_06'), Localize('achievement_06'))]"
		on_start = "[PlayerGuiExecute('achievement_06_set')]"
	}

	state = {
		name = "achievement_07"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_07'), Localize('achievement_07'))]"
		on_start = "[PlayerGuiExecute('achievement_07_set')]"
	}

	state = {
		name = "achievement_08"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_08'), Localize('achievement_08'))]"
		on_start = "[PlayerGuiExecute('achievement_08_set')]"
	}

	state = {
		name = "achievement_09"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_09'), Localize('achievement_09'))]"
		on_start = "[PlayerGuiExecute('achievement_09_set')]"
	}

	state = {
		name = "achievement_10"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_10'), Localize('achievement_10'))]"
		on_start = "[PlayerGuiExecute('achievement_10_set')]"
	}

	state = {
		name = "achievement_11"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_11'), Localize('achievement_11'))]"
		on_start = "[PlayerGuiExecute('achievement_11_set')]"
	}

	state = {
		name = "achievement_12"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_12'), Localize('achievement_12'))]"
		on_start = "[PlayerGuiExecute('achievement_12_set')]"
	}

	state = {
		name = "achievement_13"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_13'), Localize('achievement_13'))]"
		on_start = "[PlayerGuiExecute('achievement_13_set')]"
	}

	state = {
		name = "achievement_14"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_14'), Localize('achievement_14'))]"
		on_start = "[PlayerGuiExecute('achievement_14_set')]"
	}

	state = {
		name = "achievement_15"
		trigger_when = "[EqualTo_string(GetPlayer.Custom('POD_achievement_15'), Localize('achievement_15'))]"
		on_start = "[PlayerGuiExecute('achievement_15_set')]"
	}
	
	vbox = {
		using = Window_Margins
		restrictparent_min = yes
        spacing = 10
		ignoreinvisible = yes
		allow_outside = yes

		vbox = {
			layoutpolicy_horizontal = expanding
			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					text = "ACHIEVEMENT"
				}

				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Clear('pod_achievement')]"
				}
			}
		}
		
		text_single = {
			text = "[Localize('cross_save_tt')]"
            fontsize = 20
			max_width = 580
		}
		
		spacer = { size = { 0 5 } }  
		scrollbox = {
            size = { 600 750 }

            background = {
                using = Background_Area
				alpha = 0.1
            }

            blockoverride "scrollbox_content"
            {
				vbox = {
					layoutpolicy_horizontal = expanding

					spacing = 6
					
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_01_view' )]"
						blockoverride "achievement_name" { text = "achievement_01" }
						blockoverride "achievement_desc" { text = "achievement_01_tt" }
					}
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_02_view' )]"
						blockoverride "achievement_name" { text = "achievement_02" }
						blockoverride "achievement_desc" { text = "achievement_02_tt" }
					}
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_03_view' )]"
						blockoverride "achievement_name" { text = "achievement_03" }
						blockoverride "achievement_desc" { text = "achievement_03_tt" }
					}
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_04_view' )]"
						blockoverride "achievement_name" { text = "achievement_04" }
						blockoverride "achievement_desc" { text = "achievement_04_tt" }
					}
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_05_view' )]"
						blockoverride "achievement_name" { text = "achievement_05" }
						blockoverride "achievement_desc" { text = "achievement_05_tt" }
					}
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_06_view' )]"
						blockoverride "achievement_name" { text = "achievement_06" }
						blockoverride "achievement_desc" { text = "achievement_06_tt" }
					}
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_07_view' )]"
						blockoverride "achievement_name" { text = "achievement_07" }
						blockoverride "achievement_desc" { text = "achievement_07_tt" }
					}
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_08_view' )]"
						blockoverride "achievement_name" { text = "achievement_08" }
						blockoverride "achievement_desc" { text = "achievement_08_tt" }
					}
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_09_view' )]"
						blockoverride "achievement_name" { text = "achievement_09" }
						blockoverride "achievement_desc" { text = "achievement_09_tt" }
					}
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_10_view' )]"
						blockoverride "achievement_name" { text = "achievement_10" }
						blockoverride "achievement_desc" { text = "achievement_10_tt" }
					}
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_11_view' )]"
						blockoverride "achievement_name" { text = "achievement_11" }
						blockoverride "achievement_desc" { text = "achievement_11_tt" }
					}
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_12_view' )]"
						blockoverride "achievement_name" { text = "achievement_12" }
						blockoverride "achievement_desc" { text = "achievement_12_tt" }
					}
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_13_view' )]"
						blockoverride "achievement_name" { text = "achievement_13" }
						blockoverride "achievement_desc" { text = "achievement_13_tt" }
					}
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_14_view' )]"
						blockoverride "achievement_name" { text = "achievement_14" }
						blockoverride "achievement_desc" { text = "achievement_14_tt" }
					}
					pod_achievement_button = {
						datacontext = "[GetScriptedGui( 'achievement_15_view' )]"
						blockoverride "achievement_name" { text = "achievement_15" }
						blockoverride "achievement_desc" { text = "achievement_15_tt" }
					}
				}
            }
        }

		expand = {}
	}
}

types PODAchievement
{
	type pod_achievement_button = hbox
	{
		layoutpolicy_horizontal = expanding
		
		#tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		#using = tooltip_e

		button_normal = {
			size = { 75 75 }
			clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_advance"
								
			# visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			
			icon = {
				block "texture" { texture = "gfx/interface/icons/artifact/artifact_goblet.dds" }
				size = { 65 65 }
				framesize = { 238 240 }
				position = { 10 8 }
				block "achievement_level" { frame = 4 }
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			
			background = {
				visible = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				using = Color_Orange
				alpha = 0.3
				texture = "gfx/interface/component_masks/mask_glow.dds"
				texture_density = 2
				using = Mask_Rough_Edges
				margin_bottom = 10

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_rough_texture.dds"
					blend_mode = alphamultiply
					alpha = 0.4
				}
			}

			background = {
				visible = "[Not(ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
				using = Color_Grey
				alpha = 0.2
				texture = "gfx/interface/component_masks/mask_header_lines.dds"
				mirror = horizontal
				spriteType = corneredtiled
				spriteborder_left = 340
				texture_density = 2
				using = Mask_Rough_Edges

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_rough_texture.dds"
					blend_mode = alphamultiply
					alpha = 0.5
				}
			}

			expand = {}

			pod_achievement_title = {
				visible = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				block "achievement_name" { text = "ACHIEVEMENT" }
				default_format = "#clickable"
			}
			pod_achievement_title = {
				visible = "[Not(ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
				block "achievement_name" { text = "ACHIEVEMENT" }
				default_format = "#high"
			}
			pod_achievement_desc = {
				visible = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				block "achievement_desc" { text = "ACHIEVEMENT" }
				default_format = "#medium;bold"
			}
			pod_achievement_desc = {
				visible = "[Not(ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
				block "achievement_desc" { text = "ACHIEVEMENT" }
				default_format = "#weak;bold"
			}

			expand = {}
		}
	}
	type pod_achievement_title = text_multi
	{
		using = Font_Type_Flavor
		max_width = 1000
		autoresize = yes
		align = center

		fontsize = 20
	}
	type pod_achievement_desc = text_multi
	{
		max_width = 415
		autoresize = yes
		align = center
		fontsize = 14
	}
}