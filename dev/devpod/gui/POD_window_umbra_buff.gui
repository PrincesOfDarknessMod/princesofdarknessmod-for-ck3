window = {
	name = "umbra_buff_window"
	size = { 1076 850 }
	position = { 610 100 }
	layer = middle

	using = Window_Background
	using = Window_Decoration
	using = Animation_ShowHide_Standard

	visible = "[And(Or(Not(IsObserver), GetPlayer.IsValid), GetPlayer.MakeScope.GetVariable('local_umbra').IsSet)]"
	datacontext = "[GetPlayer.MakeScope.GetVariable('local_umbra').GetProvince]"
	datacontext = "[GetVariableSystem]"

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		
		on_start = "[GetScriptedGui('umbra_buff_list_initiate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
	}
	
	vbox = {
		using = Window_Margins
		restrictparent_min = yes

		header_pattern = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text"
			{
				text = "UMBRA_BUFF_WINDOW_TITLE"
			}

			blockoverride "button_close"
			{
				onclick = "[GetVariableSystem.Clear('umbra_tab_choice')]"
				onclick = "[GetScriptedGui('umbra_buff_window_close').Execute(GuiScope.SetRoot(Province.MakeScope).AddScope('player', GetPlayer.MakeScope).End)]"
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
		
			vbox = {
				name = "main"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
			
				vbox = {
					name = "effect_selection"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					minimumsize = { 0 512 }
					margin = { 14 14 }

					background = {
						using = Background_Area
					}

					expand = {}
						
					hbox = {
						layoutpolicy_horizontal = expanding
						button_tab = {
							text = "spirit_wilds_title"
							layoutpolicy_horizontal = expanding
							onclick = "[GetVariableSystem.Set('umbra_tab_choice','spirit_wilds')]"
							down = "[GetVariableSystem.HasValue('umbra_tab_choice', 'spirit_wilds')]"
							datacontext = "[Province.GetCounty.GetTitle.MakeScope.GetVariable('spirit_wilds_controller').GetCharacter]"
							enabled = "[And( Character.IsValid, ObjectsEqual( Character.Self, GetPlayer ))]"
						}
						button_tab = {
							text = "shadowlands_title"
							layoutpolicy_horizontal = expanding
							onclick = "[GetVariableSystem.Set('umbra_tab_choice','shadowlands')]"
							down = "[GetVariableSystem.HasValue('umbra_tab_choice', 'shadowlands')]"
							datacontext = "[Province.GetCounty.GetTitle.MakeScope.GetVariable('shadowlands_controller').GetCharacter]"
							enabled = "[And( Character.IsValid, ObjectsEqual( Character.Self, GetPlayer ))]"
						}
					}

					scrollbox = {
						name = "characters_scroll_area"
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding

						blockoverride "scrollbox_content" {
							vbox = {
								visible = "[GetVariableSystem.HasValue('umbra_tab_choice', 'spirit_wilds')]"
								margin = { 8 8 }
								
								spirit_wilds_buff = {
									datamodel = "[GetPlayer.MakeScope.GetList('spirit_wilds_buff_list')]"
								}
							}
							vbox = {
								visible = "[GetVariableSystem.HasValue('umbra_tab_choice', 'shadowlands')]"
								margin = { 8 8 }
								
								shadowlands_buff = {
									datamodel = "[GetPlayer.MakeScope.GetList('shadowlands_buff_list')]"
								}
							}
						}
					}
					expand = {}
				}
			}
		
			vbox = {
				name = "footer"
				layoutpolicy_horizontal = expanding
				spacing = 10
				margin_bottom = 12

				hbox = {
					name = "control_buttons"
					spacing = 20

					button_standard = {
						name = "close_button"
						onclick = "[GetVariableSystem.Clear('umbra_tab_choice')]"
						onclick = "[GetScriptedGui('umbra_buff_window_close').Execute(GuiScope.SetRoot(Province.MakeScope).AddScope('player', GetPlayer.MakeScope).End)]"
						text = "CANCEL"
					}

					button_primary = {
						name = "enact_button"
						datacontext = "[GetScriptedGui( 'apply_umbra_buff_change' )]"
						onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(Province.MakeScope).End)]"
						
						onclick = "[GetVariableSystem.Clear('umbra_tab_choice')]"
						onclick = "[GetScriptedGui('umbra_buff_window_close').Execute(GuiScope.SetRoot(Province.MakeScope).AddScope('player', GetPlayer.MakeScope).End)]"

						text = "UMBRA_BUFF_WINDOW_CHANGE"

						using = tooltip_above
						tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(Province.MakeScope).End)]"
					}
				}
			}
		}
	}
}

types Buttons
{
    type spirit_wilds_buff = dynamicgridbox
	{	
		flipdirection = yes
        ignoreinvisible = yes
        maxhorizontalslots = 4
		datamodel_wrap = 4
			
		item = {
			button_standard_hover = {
				name = "trait_item"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				size = { 220 55 }
				
				datacontext = "[GetScriptedGui(Scope.GetFlagName)]"
				
				enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(Province.MakeScope).AddScope('player', GetPlayer.MakeScope).End)]"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(Province.MakeScope).AddScope('player', GetPlayer.MakeScope).End)]"
				tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(Province.MakeScope).AddScope('player', GetPlayer.MakeScope).End)]"
				onclick = "[GetScriptedGui('spirit_wilds_choice').Execute(GuiScope.SetRoot(Province.MakeScope).End)]"

				hbox = {
					margin = { 5 0 }
					margin_right = 10
					spacing = 10

					icon = {
						size = { 50 50 }
						texture = "gfx/interface/icons/icon_grace.dds"
					}

					text_single = {
						text = "[Localize(Concatenate(Scope.GetFlagName,'_name'))]"
						default_format = "#clickable"
						align = left
						layoutpolicy_horizontal = expanding
						autoresize = no
						fontsize_min = 12
					}
				}

				button_active_marker = {
					name = "victory_glow"
					visible = "[ObjectsEqual( Province.GetCounty.GetTitle.MakeScope.GetVariable('local_spirit_wilds_buff').GetFlagName, Scope.GetFlagName)]"
				}

				icon = {
					name = "victory_glow2"
					visible = "[And(Province.GetCounty.GetTitle.MakeScope.GetVariable('spirit_wilds_buff_choice').IsSet, ObjectsEqual( Province.GetCounty.GetTitle.MakeScope.GetVariable('spirit_wilds_buff_choice').GetFlagName, Scope.GetFlagName))]"
					size = { 100% 100% }
					texture = "gfx/interface/component_masks/mask_fade_circle.dds"
					using = Color_Orange
					alpha = 0.4
				}
			}
		}
	}
    type shadowlands_buff = dynamicgridbox
	{	
		flipdirection = yes
        ignoreinvisible = yes
        maxhorizontalslots = 4
		datamodel_wrap = 4
			
		item = {
			button_standard_hover = {
				name = "trait_item"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				size = { 220 55 }
				
				datacontext = "[GetScriptedGui(Scope.GetFlagName)]"
				
				enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(Province.MakeScope).AddScope('player', GetPlayer.MakeScope).End)]"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(Province.MakeScope).AddScope('player', GetPlayer.MakeScope).End)]"
				tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(Province.MakeScope).AddScope('player', GetPlayer.MakeScope).End)]"
				onclick = "[GetScriptedGui('shadowlands_choice').Execute(GuiScope.SetRoot(Province.MakeScope).End)]"

				hbox = {
					margin = { 5 0 }
					margin_right = 10
					spacing = 10

					icon = {
						size = { 50 50 }
						texture = "gfx/interface/icons/icon_umbra.dds"
					}

					text_single = {
						text = "[Localize(Concatenate(Scope.GetFlagName,'_name'))]"
						default_format = "#clickable"
						align = left
						layoutpolicy_horizontal = expanding
						autoresize = no
						fontsize_min = 12
					}
				}

				button_active_marker = {
					name = "victory_glow"
					visible = "[ObjectsEqual( Province.GetCounty.GetTitle.MakeScope.GetVariable('local_shadowlands_buff').GetFlagName, Scope.GetFlagName)]"
				}

				icon = {
					name = "victory_glow2"
					visible = "[And(Province.GetCounty.GetTitle.MakeScope.GetVariable('shadowlands_buff_choice').IsSet, ObjectsEqual( Province.GetCounty.GetTitle.MakeScope.GetVariable('shadowlands_buff_choice').GetFlagName, Scope.GetFlagName))]"
					size = { 100% 100% }
					texture = "gfx/interface/component_masks/mask_fade_circle.dds"
					using = Color_Orange
					alpha = 0.4
				}
			}
		}
	}
}