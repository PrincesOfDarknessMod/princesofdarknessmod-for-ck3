######################################################
###### POD combat discipline / trait texicons
######################################################
# Per-discipline / per-auspice / per-arcanos texicons used by the combat
# generator to give each move's display name a discipline-specific icon
# instead of the broader splat icon. The splat-level icons (vampire_icon,
# werewolf_icon, etc. -- defined in POD_texticons.gui) remain the fallback
# for moves whose required_trait doesn't have a more specific icon.
#
# Sizing matches POD_texticons.gui conventions (25x25, offset 6,
# fontsize 16) so these render in line with the existing splat icons.

# == Vampire disciplines ==============================================

texticon = {
	icon = abombwe_icon
	iconsize = { texture = "gfx/interface/icons/traits/abombweadvanced.dds"        size = { 25 25 } offset = { 0 6 } fontsize = 16 }
}
