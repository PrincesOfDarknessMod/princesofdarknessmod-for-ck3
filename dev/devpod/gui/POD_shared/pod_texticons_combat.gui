######################################################
###### POD combat text-icon definitions
######################################################
# Inline text-icons for the combat minigame:
#   * stance indicators  — guard / dodge / stealth (hand-drawn 25x25)
#   * attack-type icons  — physical / supernatural / mental
#                          (used in move-tooltip damage lines for
#                          the attack_type fallback path when a move
#                          has hp_damage but no damage_source set;
#                          NOT rendered in the combat log column for
#                          physical/supernatural — those would just
#                          add noise per row — but mental still
#                          appears there as a distinctive psychic
#                          glyph)
#   * damage-source icons — fire / cold / lightning / sun / silver /
#                           gold / holy / balefire (elemental flavors)
#   * morale-damage icon — paired with the move-tooltip morale-damage
#                          and morale-heal lines (the combat log
#                          result text uses the concept-linked word
#                          "Morale" instead, since it's already
#                          inline with the value)
#
# Used in loc strings via the @<name>! syntax, e.g.:
#
#   "Target stance: [Concept('pod_combat_guard','@pod_combat_guard_icon!')]"
#
# Wrapping each text-icon in a [Concept(...)] link turns the icon into
# a hoverable concept-card target, mirroring PoD's own pattern for
# wound-box icons (see POD_damage_box in traits_POD_l_english.yml).
#
# Asset layout: every dedicated combat icon lives at
# gfx/interface/icons/combat/<name>.dds. Balefire has no bespoke art
# yet, so it reuses a PoD asset path (wyrm faith) until a matching
# combat icon is produced.
#
# Sizing matches the stance-icon convention (25x25, baseline offset 6,
# fontsize 16) so all combat texticons render at the same scale in
# tooltip / log strings.

# ── Stances ─────────────────────────────────────────────────────────

texticon = {
	icon = pod_combat_guard_icon
	iconsize = {
		texture = "gfx/interface/icons/combat/guard.dds"
		size = { 25 25 }
		offset = { 0 6 }
		fontsize = 16
	}
}

texticon = {
	icon = pod_combat_dodge_icon
	iconsize = {
		texture = "gfx/interface/icons/combat/dodge.dds"
		size = { 25 25 }
		offset = { 0 6 }
		fontsize = 16
	}
}

texticon = {
