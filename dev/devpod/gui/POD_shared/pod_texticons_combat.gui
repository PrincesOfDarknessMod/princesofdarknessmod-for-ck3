######################################################
###### POD combat text-icon definitions
######################################################
# Combat texticons. Keep their size and baseline aligned.
# Balefire reuses PoD's wyrm icon.

texticon = {
	icon = pod_combat_encounter_icon
	iconsize = {
		texture = "gfx/interface/icons/icon_kill.dds"
		size = { 25 25 }
		offset = { 0 6 }
		fontsize = 16
	}
}

