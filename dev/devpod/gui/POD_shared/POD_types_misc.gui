	type keyboard_button = button_normal {
        size = {33 33}
        texture = "gfx/interface/buttons/button_standard.dds"
        oversound = ""
        gfxtype = togglepushbuttongfx
        effectname = "NoHighlight"

        upframe = 7
        uphoverframe = 2
        uppressedframe = 3
        downframe = 4
        downhoverframe = 4
        downpressedframe = 4
        disableframe = 7

        spriteType = Corneredtiled
        spriteborder = { 3 3 }		
		framesize = { 252 80 }
        frame = 4

		enabled = "[GetScriptedGui( 'POD_keyboard_press_key' ).IsValid( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"

		highlight_icon = {
			size = { 100% 100% }
			texture = "gfx/interface/component_masks/mask_clouds_solid.dds"
			color = { 0.1 0.1 0.1 0.6 }
			framesize = { 160 160 }
		}

		text_single = {
			margin_top = -7
			parentanchor = vcenter|hcenter
			block "button_text" {
				raw_text = "Q"
			}
			using = Font_Size_Medium
		}

		onclick = "[GetScriptedGui( 'POD_keyboard_press_key' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'letter', MakeScopeFlag( Scope.GetFlagKey ) ).End )]"
    }
