	type wordle_box = button_normal {
        size = {50 50}
        texture = "gfx/interface/buttons/button_standard.dds"
        oversound = ""
        gfxtype = togglepushbuttongfx
        effectname = "NoHighlight"

        upframe = 7
        uphoverframe = 2
        uppressedframe = 3
        downframe = 4
        downhoverframe = 4
        downpressedframe = 4
        disableframe = 7

        spriteType = Corneredtiled
        spriteborder = { 3 3 }		
		framesize = { 252 80 }
        frame = 4

		block "wordle_button_background_mask" {
			highlight_icon = {
				size = { 100% 100% }
