# these are split off into their own file to make inter-mod compatibility easier to maintain

template POD_on_character_window_opened {
	on_start = "[GetScriptedGui('splat_initiation_gui').Execute(GuiScope.SetRoot(CharacterWindow.GetCharacter.MakeScope).End)]"
	on_start = "[GetScriptedGui('set_resonance_gui').Execute(GuiScope.SetRoot(CharacterWindow.GetCharacter.MakeScope).End)]"
}

template POD_on_character_window_closed {
	on_finish = "[GetVariableSystem.Clear('pod_knight_window_open')]"
}
template POD_click_to_toggle_knight_window {
	onclick = "[GetVariableSystem.Toggle('pod_knight_window_open')]"
}


types PODVanillaCharacterTypes
{
	type POD_additional_character_window_icons = text_single {
		visible = "[Character.IsPlayer]"
		text = "[Character.Custom('PODGamemodeIcon')][Character.Custom('PODRoguelikeIcon')]"
		using = tooltip_se

		fontsize_min = 13
		align = nobaseline
	}
}