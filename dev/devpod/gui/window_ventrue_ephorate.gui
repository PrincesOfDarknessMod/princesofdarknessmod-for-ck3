window = {
	name = "ventrue_ephorate"
	#position = { 0 0 }
	parentanchor = center

	layer = windows_layer
	size = { 1500 1060 }
	
	#state = {
	#	name = _show
	#	using = Animation_FadeIn_Quick
	#	using = Sound_WindowShow_Standard
	#}
	
	#state = {
	#	name = _hide
	#	using = Animation_FadeOut_Quick
	#	using = Sound_WindowHide_Standard
	#}
	using = Window_Background
	using = Window_Decoration_Spike
	background = {	
	texture = "gfx/interface/illustrations/loading_screens/castle.dds"
	}
	
	vbox = {
		layoutpolicy_horizontal = expanding
		#margin_left = 10
		#margin_bottom = 20
		#position = { 0 0}
		#spacer = {
		#	size = { 0 14 }
		#}
		header_pattern_interaction = {
			layoutpolicy_horizontal = expanding
			max_width = 1450
			#position = { 0 0 }
			blockoverride "header_text"
			{
				text = ventrue_ephorate_tab_tt
			}
			
			blockoverride "button_close"
			{
				onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets ventrue_ephorate')]"
			}
		}
		hbox = {
			parentanchor = top|left		
			text_single = {
				max_width = 1000
				text = ventrue_ephorate_intro
				#margin_right = 20
				using = Font_Size_Big
			}
		}
		vbox_character_list = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			max_width = 1400

			blockoverride "sort_buttons" {}
			blockoverride "character_count" {}
			blockoverride "scrollbox_margins" {
				margin_right = 10
				margin_top = 6
				
			}

			blockoverride "container_implementation" {
				dynamicgridbox = {
					name = "characters_grid"

					datamodel = "[GetGlobalList('ventrue_ephorate_list')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					ignoreinvisible = yes
					datamodel_wrap = 2
					flipdirection = yes	
					#spacing = 10
					
					item = {
					
						widget = {
							size = { 750 100 } 
							#visible = "[Or(GetVariableSystem.Exists( 'web_out_of_range_chars' ),GetScriptedGui('web_of_knives_list_gui_dip_range').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Scope.GetCharacter.MakeScope ).End) )]"
							datacontext = "[Scope.GetCharacter]"
							hbox = {
								layoutpolicy_horizontal = expanding
								margin_right = 10
								spacing = 5

								background = {
									using = Background_Area_With_Header
								}
								vbox = {
									margin_left = 10
									#text_single = {
									#	text = WoK_target_loc
									#	
									#	using = Font_Size_Medium
									#}
									portrait_shoulders = {}
									
								}
								
								vbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									vbox = {
										layoutpolicy_horizontal = expanding
										
										text_single = {
											name = "name"
											layoutpolicy_horizontal = expanding
											autoresize = no
											text = "[Character.GetUIName]"
											using = Font_Size_Medium
											align = nobaseline
											fontsize_min = 14
											#margin_right = 10
											#margin_bottom = 20
											#max_width = 400
											#min_width = 400
										}

										hbox = {
											layoutpolicy_horizontal = expanding									
											text_single = {
												visible = "[GetScriptedGui('support_senate').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
												text = support_senate_loc												
												align = nobaseline
												using = Font_Size_Medium
												margin_bottom = -5
												margin_left = -250
											}
										}
										hbox = {
											layoutpolicy_horizontal = expanding									
											text_single = {
												visible = "[GetScriptedGui('support_eternal').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
												text = support_eternal_loc												
												align = nobaseline
												using = Font_Size_Medium
												margin_bottom = -5
												margin_left = -250
											}
										}						
										hbox = {
											layoutpolicy_horizontal = expanding									
											text_single = {
												visible = "[GetScriptedGui('support_merchants').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
												text = support_merchants_loc												
												align = nobaseline
												using = Font_Size_Medium
												margin_bottom = -5
												margin_left = -250
											}
										}
										hbox = {
											layoutpolicy_horizontal = expanding									
											text_single = {
												visible = "[GetScriptedGui('support_patricians').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
												text = support_patricians_loc												
												align = nobaseline
												using = Font_Size_Medium
												margin_bottom = -5
												margin_left = -250
											}
										}
										hbox = {
											layoutpolicy_horizontal = expanding									
											text_single = {
												visible = "[GetScriptedGui('support_knights').IsShown(GuiScope.SetRoot(Character.MakeScope).End)]"
												text = support_knights_loc												
												align = nobaseline
												using = Font_Size_Medium
												margin_bottom = -5
												margin_left = -250
											}
										}
										
									}
									
								}
							}
						}
					}
				}
			}
		}
		

		
	}

