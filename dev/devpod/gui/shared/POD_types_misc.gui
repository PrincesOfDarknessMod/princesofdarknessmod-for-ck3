template POD_scaling_helper {
	widget = {
		name = "scaling_helper"
		min_width = 1
		max_width = 1
		min_height = 1
		max_height = 1
	}
}

template POD_flat_icon_shadow {
	glow = {
		color = { 0.0 0.0 0.0 0.5 }
		glow_radius = 3
		glow_generation_rules= {
			glow_alpha_mask = 0
			glow_blur_passes = 1
			glow_texture_downscale = 1.5f
			glow_ignore_inside_pixels = no
		}
	}
}

types PODTypes
