window = {
	name = "ashirra_view"
	datacontext = "[GetVariableSystem]"
	datacontext = "[GetPlayer]"
	parentanchor = top|right
	allow_outside = yes
	movable = no
	layer = windows_layer
	
	visible = "[And(And(GetVariableSystem.HasValue('pod_sidebar', 'ashirra'), Not(IsRightWindowOpen)), IsSidebarVisibilityValid)]"
	datacontext = "[GetReligionByKey( 'ashirra_religion' )]"
	datacontext = "[GetPlayer.GetFaith]"

	using = Window_Size_MainTab

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab

		on_start = "[GetVariableSystem.Set('ashirra_tab_choice','edicts')]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
	}

	margin_widget = {
		size = { 100% 100% }
		margin = { 0 26 }
		margin_right = 13

		widget = {
			size = { 100% 100% }

			### WINDOW CONTENT
			vbox = {
				using = Window_Margins
				ignoreinvisible = yes

				##### HEADER TEXT #####
				header_with_picture = {
					layoutpolicy_horizontal = expanding
					minimumsize = { 0 110 }

					blockoverride "header_text" {
						text = "game_concept_ashirra"
					}

					blockoverride "size" {
						size = { 100% 128 }
					}

					blockoverride "illustration_texture" {
						texture = "gfx/interface/illustrations/window_headers/header_sects.dds"

						using = Mask_Rough_Edges

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
							blend_mode = alphamultiply
							mirror = vertical
						}
					}

					blockoverride "button_close"
					{
						onclick = "[GetVariableSystem.Clear('pod_sidebar')]"
						onclick = "[GetVariableSystem.Clear('ashirra_tab_choice')]"
					}

					vbox = {
						margin_top = 42
						margin_bottom = 10

						hbox = {
							spacing = 20

							text_single = {
								text = "ASHIRRA_WINDOW_TOTAL_INFLUENCE"
							}

							text_single = {
								text = "ASHIRRA_WINDOW_INFLUENCE_GAIN"
							}
						}

						expand = {}
					}

					widget = {
						allow_outside = yes
						size = { 89 98 }

						ashirra_symbol_big = {
							parentanchor = top|hcenter
							position = { 5 5 }
						}
					}
				}
				
				hbox = {
					name = "ashirra_tabs"
					layoutpolicy_horizontal = expanding

					button_tab = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						onclick = "[GetVariableSystem.Set('ashirra_tab_choice','edicts')]"
						down = "[GetVariableSystem.HasValue('ashirra_tab_choice', 'edicts')]"

						text = "ASHIRRA_WINDOW_TAB_EDICTS"
					}
				}
				
				expand = {}
				
				### EDICTS TAB
				vbox = {
					name = "tab_edicts"
					visible = "[GetVariableSystem.HasValue('ashirra_tab_choice', 'edicts')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					using = Animation_Tab_Switch
					
					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_margins" {
							margin = { 4 4 }
						}

						blockoverride "scrollbox_content"
						{
							vbox = {
								spacing = 10
								margin = { 8 8 }

								button_ashirra_edict = {
									datacontext = "[GetScriptedGui( 'ashirra_edict_adopt_mysticism' )]"
									blockoverride "edict_title" { text = "ashirra_edict_adopt_mysticism" }
								}

								button_ashirra_edict = {
									datacontext = "[GetScriptedGui( 'ashirra_edict_adopt_legalism' )]"
									blockoverride "edict_title" { text = "ashirra_edict_adopt_legalism" }
								}

								button_ashirra_edict = {
									datacontext = "[GetScriptedGui( 'ashirra_edict_army' )]"
									blockoverride "edict_title" { text = "ashirra_edict_army" }
								}

								button_ashirra_edict = {
									datacontext = "[GetScriptedGui( 'ashirra_edict_tax' )]"
									blockoverride "edict_title" { text = "ashirra_edict_tax" }
								}

								button_ashirra_edict = {
									datacontext = "[GetScriptedGui( 'ashirra_edict_opinion' )]"
									blockoverride "edict_title" { text = "ashirra_edict_opinion" }
								}

								button_ashirra_edict = {
									datacontext = "[GetScriptedGui( 'ashirra_edict_gain_fervor' )]"
									blockoverride "edict_title" { text = "ashirra_edict_gain_fervor" }
								}
							}
							
							expand = {}
						}
					}
				}
			}
		}
	}
}

types Buttons
{
	type ashirra_symbol_big = button_group {
		flowcontainer = {
			margin = { 3 4 }
			direction = vertical
			spacing = -1
			ignoreinvisible = yes

			widget = {
				size = { 86 94 }

				icon = {
					name = "faith_icon"
					parentanchor = center
					size = { 86 86 }
					texture = "gfx/interface/icons/Symbol_Sect_Ashr.dds"
					using = tooltip_se
					tooltipwidget = {
						faith_tooltip = {}
					}

					state = {
						name = "faith_view_refresh"
						using = Animation_Refresh_FadeOut
					}

					state = {
						using = Animation_Refresh_FadeIn
					}
				}
			}
		}
	}
	
	type button_ashirra_edict = button_standard {
 		size = { 540 45 }
		
		tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(Religion.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
		visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(Religion.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
		enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(Religion.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
		onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(Religion.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
		
 		hbox = {
 			margin = { 20 0 }
 			margin_right = 10

 			text_single = {
 				layoutpolicy_horizontal = growing
 				name = "title"
				block "edict_title" { text = "" }
 				visible = "[ScriptedGui.IsValid(GuiScope.SetRoot(Religion.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
 				default_format = "#clickable"
 				align = nobaseline
 			}

 			text_single = {
 				layoutpolicy_horizontal = growing
 				name = "title2"
 				block "edict_title" { text = "" }
 				visible = "[Not(ScriptedGui.IsValid(GuiScope.SetRoot(Religion.MakeScope).AddScope('player',GetPlayer.MakeScope).End))]"
 				block "default_format" {
 					default_format = "#low"
 				}
 				align = nobaseline
 			}

 			highlight_icon = {
 				size = { 30 30 }
 				name = "not_possible"
 				texture = "gfx/interface/icons/symbols/icon_cross.dds"
 				visible = "[Not(ScriptedGui.IsValid(GuiScope.SetRoot(Religion.MakeScope).AddScope('player',GetPlayer.MakeScope).End))]"
 			}
 		}
	}
}