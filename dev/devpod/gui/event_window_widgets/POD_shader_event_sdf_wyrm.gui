@sdf_scale = 0.9
@sdf_offset_x = 0.42
@sdf_offset_y = 0.06

pod_sdf_shader_event_widget = {
	name = "POD_shader_event_sdf_wyrm"
	
	blockoverride "effect_name" {
		effectname = "PODSDFLoadingScreen2"
	}
	
	blockoverride "shader_properties" {
		
		# primary light
		modify_texture = {
			color = { 0.3 0.8 0.6 }   # color
			spriteborder_left  =  0.9 # X position
			spriteborder_top   = -0.6 # Y position
			spriteborder_right =  0.8 # Z position
			spriteborder_bottom = 6.0 # POW
		}

		# secondary light
		modify_texture = {
			color = { 0.2 0.8 1.0 }   # color
			spriteborder_left  = -0.9 # X position
			spriteborder_top   = -1.5 # Y position
			spriteborder_right =  0.9 # Z position
		}
		
		# properties
		modify_texture = {
			# intensity of postprocessing (contrast, saturation, vignette)
			color = { 1.0 0.5 0.0 }
			spriteborder_left   = 0.0 # fake shadow/highlight intensity
			spriteborder_top    = 0.5 # speed (rot1)
			spriteborder_right  = 0.5 # speed (rot2)
			spriteborder_bottom = 0.5 # speed (height)
		}
	
		# first SDF
		modify_texture = {
			texture = "gfx/interface/sdf/sdf_wyrm.dds"
			rotate_uv = @sdf_scale # scale (SpriteTranslateRotateUVAndAlpha[4].z)
			spriteborder_left = @sdf_offset_x # uv x offset (SpriteBorder[4].x)
			spriteborder_top  = @sdf_offset_y # uv y offset (SpriteBorder[4].y)
		}

		# second SDF
		modify_texture = {
			texture = "gfx/interface/sdf/sdf_wyrm.dds"
			rotate_uv = @sdf_scale # scale (SpriteTranslateRotateUVAndAlpha[5].z)
			spriteborder_left = @sdf_offset_x # uv x offset (SpriteBorder[5].x)
			spriteborder_top  = @sdf_offset_y # uv y offset (SpriteBorder[5].y)
		}
	}
}