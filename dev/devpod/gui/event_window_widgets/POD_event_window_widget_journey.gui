
vbox = {
	name = "POD_event_window_widget_journey"
	layoutpolicy_horizontal = expanding

	state = {
		name = init
		trigger_on_create = yes
		# Set coterie status
		on_start = "[GetScriptedGui('POD_set_coterie_status_sgui').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		# Generic ending SGUI
		on_start = "[GetScriptedGui('POD_journey_on_end').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		# Select the right SGUI and call it
		on_start = "[GetScriptedGui(Concatenate(GetPlayer.MakeScope.Var('current_journey').Var('journey_type').GetFlagName,'_on_end')).Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}
	
	# Default Event Widget (any Journey besides hunt_in_capital)
	vbox = {
		visible = "[Not(GetScriptedGui('POD_hunt_in_capital_event_widget').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		
		margin_left = 64
		margin_right = 64
		margin_bottom = 36
		layoutpolicy_horizontal = expanding
		
		# text_single = {
			# text = "[Concatenate('#T ', Concatenate(Localize('POD_JOURNEY_GETNAME'), '#!') )]"
			# margin_bottom = 10
		# }
		
		hbox = {
			layoutpolicy_horizontal = expanding
			visible = "[GetPlayer.MakeScope.Var('current_journey').Var('destination').IsSet]"
			
			button_normal = {
				name = "journey_icon_button"
				onclick = "[GetVariableSystem.Toggle('journey_window_open')]"
				size = { 45 45 }
				
				highlight_icon = {
					name = "journey_icon"
					size = { 45 45 }
					alwaystransparent = yes
					texture = "[GetCultureInnovationType(Concatenate(GetPlayer.MakeScope.Var('current_journey').Var('journey_type').GetFlagName,'_icon')).GetIcon]"
					
					tooltip = "BOTTOMBAR_JOURNEY_TOOLTIP"
				}
			}
			
			widget = { min_width = 8 }
			
			button_standard = {
				name = "journey_title_button"
				datacontext = "[GetPlayer.MakeScope.Var('current_journey').Var('destination').Province.GetCounty.GetTitle]"
				
				layoutpolicy_horizontal = expanding
				size = { 0 50 }
				
				onclick = "[DefaultOnCoatOfArmsClick(Title.GetID)]"
				tooltipwidget = { using = LandedTitleTooltip }
				using = State_Title_MouseEntry

				hbox = {
					margin_left = 16
					#margin_top = 3
					#expand = {}
					
					coa_title_tiny = {
					}

					text_single = {
						margin_left = 8
						#margin_top = 4
						margin_bottom = 3
						text = "[Concatenate('#V ',Concatenate(GetPlayer.MakeScope.Var('current_journey').Var('destination').Province.GetCounty.GetTitle.GetNameNoTooltip,'#!'))]"
					}
					
					expand = {}
				}
			}
		}
		
		hbox = {
			layoutpolicy_horizontal = expanding
			margin_top = 8
			
			expand = {}
			
			text_multi = {
				visible = "[Not(GetScriptedGui('POD_can_travel_with_coterie_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
				align = top|hcenter
				layoutpolicy_horizontal = expanding
				#margin_left = 8
				#margin_top = 4
				#margin_bottom = 3
				text = "[GetPlayer.Custom('PODCoterieTravelStatusGUI')]"
			}
			
			text_single = {
				visible = "[GetScriptedGui('POD_can_travel_with_coterie_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				#align = center
				#layoutpolicy_horizontal = expanding
				#margin_left = 8
				#margin_top = 8
				margin_bottom = 5
				text = "[GetPlayer.Custom('PODCoterieTravelStatusGUI')]"
			}
			
			widget = {
				visible = "[GetScriptedGui('POD_can_travel_with_coterie_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				min_width = 6
			}
			
			button_checkbox = {
				visible = "[GetScriptedGui('POD_can_travel_with_coterie_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				size = { 24 24 }
				checked = "[GetPlayer.MakeScope.Var('traveling_with_coterie').IsSet]"
				onclick = "[GetScriptedGui('POD_toggle_coterie_travel').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "POD_journey_coterie_checkbox_tt"
			}
			
			expand = {}
			
		}
	}
	
	# hunt_in_capital Event Widget
	vbox = {
		visible = "[GetScriptedGui('POD_hunt_in_capital_event_widget').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
		#margin_left = 64
		#margin_right = 64
		margin_bottom = 24
		layoutpolicy_horizontal = expanding
		
		hbox = {
			datamodel = "[GetPlayer.MakeScope.GetList('hunt_in_capital_mortals')]"
			
			item = {
				vbox = {
					layoutpolicy_vertical = expanding
					#spacing = 6
					
					hbox = {
						#layoutpolicy_horizontal = expanding
						visible = "[Or( GetPlayer.HasPerk(GetPerk('scry_the_soul_perk')), GetScriptedGui('is_ventrue_clan_curse_applicable_gui').IsShown(GuiScope.SetRoot(Scope.Char).AddScope('actor',GetPlayer.MakeScope).End) )]"
						size = { 0 20 }
						spacing = 4
						
						pod_resonance_display = {
							datacontext = "[Scope.Char]"
						}
						
						pod_ventrue_warning_display = {
							datacontext = "[Scope.Char]"
						}
					}
					
					widget = {
						visible = "[Or( GetPlayer.HasPerk(GetPerk('scry_the_soul_perk')), GetScriptedGui('is_ventrue_clan_curse_applicable_gui').IsShown(GuiScope.SetRoot(Scope.Char).AddScope('actor',GetPlayer.MakeScope).End) )]"
						size = { 0 6 }
					}
					
					portrait_head_small = {
						datacontext = "[Scope.Char]"
						
						blockoverride "opinion_box" {
							visible = no
						}
						
						blockoverride "status_icons" {
							visible = no
						}
					}
					
					widget = {
						size = { 0 6 }
					}
					
					button_radio = {
						size = { 30 30 }
						onclick = "[GetScriptedGui('POD_hunt_in_capital_event_widget').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selection',Scope.Char.MakeScope).End)]"
						frame   = "[BoolTo1And2( ObjectsEqual( Scope.Char, GetPlayer.MakeScope.Var('hunt_in_capital_selected_mortal').Char ) )]"
					}
				}
			}
		}
	}
	
	# Fake event button (generic events)
	vbox = {
		layoutpolicy_horizontal = expanding
		margin_bottom = 1
		
		datamodel = "[EventWindow.AccessEventWindowData.GetOptions]"
		visible = "[Not(GetScriptedGui('POD_hunt_in_capital_event_widget').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		
		item = {
			pod_fake_event_button = {
				name = "journey_fake_confirm_button"
				layoutpolicy_horizontal = expanding
				
				enabled = "[GetScriptedGui('POD_can_start_travel_phase_sgui').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				
				onclick = "[GetVariableSystem.Clear('journey_window_open')]"
				onclick = "[GetScriptedGui(Concatenate(GetPlayer.MakeScope.Var('current_journey').Var('journey_type').GetFlagName,'_travel_phase')).Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[EventOption.Select]"
				
				blockoverride "button_text" {
					text = "[Localize(Concatenate(GetPlayer.MakeScope.Var('current_journey').Var('journey_type').GetFlagName,'_planning_confirm'))]"
				}
				blockoverride "button_tooltip" {
					tooltip = "POD_journey_maintenance.1.option.a.tt"
				}
			}
		}
	}
	
	# Fake event button (hunt_in_capital)
	vbox = {
		layoutpolicy_horizontal = expanding
		margin_bottom = 1
		
		datamodel = "[EventWindow.AccessEventWindowData.GetOptions]"
		visible = "[GetScriptedGui('POD_hunt_in_capital_event_widget').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
		item = {
			pod_fake_event_button = {
				name = "hunt_in_capital_fake_confirm_button"
				layoutpolicy_horizontal = expanding
				visible = "[Not( EqualTo_string( EventOption.GetText, Localize('hunt_in_capital_planning_restart') ) )]"
				
				onclick = "[GetScriptedGui('hunt_in_capital_travel_phase').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[EventOption.Select]"
				
				blockoverride "button_text" {
					text = "[Localize('hunt_in_capital_planning_confirm')]"
				}
				blockoverride "button_tooltip" {
					tooltip = "hunt_in_capital_planning_confirm_tt"
				}
			}
		}
	}
	
}