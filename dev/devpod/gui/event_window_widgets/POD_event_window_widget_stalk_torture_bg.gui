
pod_shader_event_widget = {
	name = "POD_event_window_widget_stalk_torture_bg"
	
	blockoverride "shaderfile" {
		shaderfile = "gfx/FX/POD_shaders/POD_number_display_shaders.shader"
	}
	blockoverride "effect_name" {
		effectname = "PODNumberVeins"
	}
	blockoverride "additional_inputs" {
		spriteborder_left   = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('stalk_actions'))]" # the number (actions)
		spriteborder_top    = 6     # scale (inverted, bigger number is smaller)
		spriteborder_right  = -0.65 # number offset on x-axis
		spriteborder_bottom = 0     # number offset on y-axis
		
		modify_texture = {
			name = "color_properties"
			color = { 0.25 0.025 0.015 } # color exponents
			spriteborder_left   = 8  # color falloff
			alpha = 1 # intensity of screen shake (1 is disabled, 0 is enabled)
		}
		
		modify_texture = {
			#color = { 0.045 0.03 0.015 } # color exponents (when screenshake is on)
			#color = { 0.04 0.03 0.01 } # color exponents (when screenshake is on)
			color = { 0.15 0.035 0.01 } # color exponents (when screenshake is on)
			#color = { 0.015 0.035 0.005 } # color exponents (when screenshake is on)
		}
		
		modify_texture = {
			color = { 1.0 0.8 0.8 } # color multiplier
		}
		
		state = {
			name = "POD_stalk_screenshake_start"
			duration = 0.25
			next = "POD_stalk_screenshake_end"
			
			on_start = "[PdxGuiWidget.InterruptAnimation('POD_stalk_screenshake_end')]"

			animation = {
				bezier = { 0 1 0 1 }

				modify_texture = {
					name = "color_properties"
					alpha = 0.0
				}
			}
		}
		
		state = {
			name = "POD_stalk_screenshake_end"
			duration = 0.75

			animation = {
				bezier = { 0 1 0 1 }

				modify_texture = {
					name = "color_properties"
					alpha = 1.0
				}
			}
		}
	}
}
