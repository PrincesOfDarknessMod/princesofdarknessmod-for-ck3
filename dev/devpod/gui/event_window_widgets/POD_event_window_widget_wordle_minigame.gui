
widget = {
	name = "POD_event_window_widget_wordle_minigame"
	
	position = { -94 72 }
	size = { 500 460 }
	parentanchor = right|top

	background = {
		using = Background_Area_ExtraDark
		margin = { 6 6 }
	}
	
	background = {
		texture = "gfx/interface/component_masks/mask_frame.dds"
		spriteType = Corneredstretched
		spriteborder = { 10 10 }
		color = { 1.0 0.9 0.8 0.4 }
		margin = { 6 6 }
	}
	
	background = {
		texture = "gfx/interface/component_masks/mask_frame.dds"
		spriteType = Corneredstretched
		spriteborder = { 10 10 }
		color = { 1.0 0.9 0.8 0.6 }
	}

	vbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		spacer = { size = { 0 38 } }
		
		#wordle_past_line = {}
		wordle_past_guess_lines = {}
		#spacer = { size = { 0 16 } }
		wordle_current_line = {}
		spacer = { size = { 0 16 } }
		#wordle_empty_line = {}
		#spacer = { size = { 0 16 } }
		#wordle_empty_line = {}
		#spacer = { size = { 0 16 } }
		#wordle_empty_line = {}
		#spacer = { size = { 0 16 } }
		#wordle_empty_line = {}
		#spacer = { size = { 0 16 } }
		#wordle_empty_line = {}

		expand = {}
	}
}
