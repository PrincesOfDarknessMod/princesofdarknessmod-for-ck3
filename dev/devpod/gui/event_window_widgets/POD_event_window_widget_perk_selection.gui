@is_current_selection = "[EqualTo_string( Scope.GetFlagKey, GetPlayer.MakeScope.Var('event_perk_selection').GetFlagKey )]"

vbox = {
	name = "POD_event_window_widget_perk_selection"
	layoutpolicy_horizontal = expanding
	
	datacontext = "[GetPlayer]"
	datacontext = "[GetPlayer.GetFaith]"
	
	text_single = {
		text = "POD_current_selection_tt"
		fontsize = 16
		align = center
	}
	text_single = {
		text = "POD_perk_event_selection_perkname"
		default_format = "#color:{0.15,0.08,0.0,1.0};glow_color:{0.0,0.0,0.0,1.0};FONT:PODSubtitles;bold"
		fontsize = 20
		align = center
		
		text_single = {
			position = { -2 -2 }
			
			text = "POD_perk_event_selection_perkname"
			default_format = "#color:{0.74,0.66,0.52};glow_color:{0.68,0.56,0.41,0.3};FONT:PODSubtitles;bold"
			fontsize = 20
			align = center
		}
	}
	
	spacer = { size = { 0 12 } }

	hbox = {
		datamodel = "[GetPlayer.MakeScope.GetList('event_perk_choices')]"
		
		spacing = 8
		
		item = {
			button_standard_hover = {
				size = { 78 78 }
				datacontext = "[GetPerk(Scope.GetFlagKey)]"
				
				down = @is_current_selection
				
				onclick = "[GetScriptedGui('POD_select_perk_for_event_selection').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('flag',MakeScopeFlag(Scope.GetFlagKey)).End)]"
				
				tooltipwidget = {
					using = perk_tooltip_selection
				}
				
				using = tooltip_ne
				tooltip_offset = { 30 0 }
				
				glow_effect = {
					blockoverride "glow_color" {
						color = { 0.0 0.0 0.0 0.4 }
					}
				}
		
				highlight_icon = {
					parentanchor = center
					texture = "[Perk.GetIcon]"

					size = { 60 60 }
					
					glow = {
						color = { 0.0 0.0 0.0 0.45 }
						glow_radius = 4

						glow_generation_rules = {
							glow_alpha_mask = 0
							glow_blur_passes = 2
							glow_texture_downscale = 4.0f
							glow_ignore_inside_pixels = yes
						}
					}

					# modify_texture = {
					# 	name = overlay
					# 	texture = "gfx/interface/component_effects/effect_blue_shine.dds"
					# 	blend_mode = colordodge
					# 	translate_uv = { 1 0 }
					# }

					modify_texture = {
						texture = "gfx/interface/component_masks/mask_center_shimmer.dds"
						blend_mode = mask
					}

					modify_texture = {
						name = "shimmer"
						texture = "gfx/interface/component_masks/mask_clouds_solid.dds"
						blend_mode = colordodge
						spriteType = corneredTiled
						rotate_uv = 0
					}

					modify_texture = {
						name = "shimmer_2"
						texture = "gfx/interface/component_masks/mask_clouds_solid.dds"
						blend_mode = colordodge
						spriteType = corneredTiled
						rotate_uv = 0
					}

					modify_texture = {
						name = "shimmer_3"
						texture = "gfx/interface/component_masks/mask_clouds_solid.dds"
						blend_mode = colordodge
						spriteType = corneredTiled
					}

					modify_texture = {
						name = "shimmer_4"
						texture = "gfx/interface/component_masks/mask_clouds_solid.dds"
						blend_mode = colordodge
						spriteType = corneredTiled
					}

					state = {
						trigger_on_create = yes
						name = a
						next = b
						duration = 0

						modify_texture = {
							name = "shimmer"
							translate_uv = { -0.1 0 }
							alpha = 0.1
							rotate_uv = 0
						}

						modify_texture = {
							name = "shimmer_2"
							translate_uv = { 0.1 0 }
							alpha = 0.3
							rotate_uv = 0
						}

						modify_texture = {
							name = "shimmer_3"
							translate_uv = { 1 0 }
							alpha = 0.1
						}

						modify_texture = {
							name = "shimmer_4"
							translate_uv = { -1 0 }
							alpha = 0.5
						}
					}

					state = {
						name = b
						next = c
						duration = 10

						modify_texture = {
							name = "shimmer"
							translate_uv = { 0.1 0 }
							alpha = 0.3
							rotate_uv = 180
						}

						modify_texture = {
							name = "shimmer_2"
							translate_uv = { -0.1 0 }
							alpha = 0.1
							rotate_uv = -180
						}

						modify_texture = {
							name = "shimmer_3"
							translate_uv = { 0 0 }
							alpha = 0.5
						}

						modify_texture = {
							name = "shimmer_4"
							translate_uv = { 0 0 }
							alpha = 0.1
						}
					}

					state = {
						name = c
						next = a
						duration = 10

						modify_texture = {
							name = "shimmer"
							translate_uv = { -0.1 0 }
							alpha = 0.1
							rotate_uv = 360
						}

						modify_texture = {
							name = "shimmer_2"
							translate_uv = { 0.1 0 }
							alpha = 0.3
							rotate_uv = -360
						}

						modify_texture = {
							name = "shimmer_3"
							translate_uv = { -1 0 }
							alpha = 0.1
						}

						modify_texture = {
							name = "shimmer_4"
							translate_uv = { 1 0 }
							alpha = 0.5
						}
					}
				}
				
				pod_rectangular_glow = {
					visible = @is_current_selection
				}
				
			}
		}
	}
	
	spacer = { size = { 0 14 } }
}
