
margin_widget = {
	name = "POD_event_window_widget_bnw_portrait"
	layoutstretchfactor_horizontal = 55
	parentanchor = bottom|hcenter
	margin = { -40 -20 }
	position = { -30 -15 }
	size = { 100% 100% }
	scissor = yes
	
	### RIGHT CHARACTER ###
	widget = {
		parentanchor = bottom|right
		position = { 0 0 }
		size = { 330 558 }
		
		allow_outside = no
		
		portrait_event = {
			datacontext = "[EventWindowWidget.GetScope.GetRootScope.Char]"
			parentanchor = bottom|hcenter
			position = { -80 -1 }
			size = { 500 558 }

			blockoverride "portrait_button"
			{
				size = { 700 558 }
				portrait_texture = "[Character.GetAnimatedPortraitEvenIfDead( 'POD_environment_combat_right', 'camera_event_center_pointing_slighty_left', Select_CString( PODCharHasNoHumanBody, 'personality_zealous', 'chudan_no_kamae' ), PdxGetWidgetScreenSize( PdxGuiWidget.Self ) )]"
				shaderfile = "gfx/FX/POD_shaders/POD_portrait_castshadow.shader"
				
				# actually color of the shadow
				color = { 1.0 0.05 0.15 1.0 }
				
				# actually UV offset of the shadow
				portrait_offset = { -0.02 -0.01 }
				
				using = tooltip_below
				tooltip_offset = { 550 -580 }
			}

			blockoverride "highlight_visible"
			{
				visible = "[Character.IsHovered]"
			}

			blockoverride "grayscale" {
				grayscale = yes
			}
		}
	}
}
