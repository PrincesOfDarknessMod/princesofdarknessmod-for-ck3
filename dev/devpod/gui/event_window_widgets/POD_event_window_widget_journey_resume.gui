
scrollbox = {
	name = "POD_event_window_widget_journey_resume"
	layoutpolicy_vertical = expanding
	layoutpolicy_horizontal = expanding
	size = { 0 250 }

	# blockoverride "scrollbox_background" {}
	# blockoverride "scrollbox_background_fade" {}
	# blockoverride "scrollbox_margins" {}

	blockoverride "scrollbox_content" {
		vbox = {
			name = "resumable_journeys"
			datamodel = "[GetPlayer.MakeScope.GetList('paused_journeys')]"
			layoutpolicy_horizontal = expanding
			spacing = 8
			#bottomtotop = yes

			item = {
				hbox = {
					layoutpolicy_horizontal = expanding
					visible = "[GetScriptedGui('POD_journey_is_travel_ready').IsValid(GuiScope.SetRoot(Story.MakeScope).End)]"
					
					datamodel = "[EventWindow.AccessEventWindowData.GetOptions]"
					
					item = {
						button_journey_entry = {
							layoutpolicy_horizontal = expanding

							blockoverride "totalprogress" {}
							
							enabled = "[GetScriptedGui('POD_journey_requirements').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('journey',Scope.Story.MakeScope).End)]"
							
							onclick = "[GetScriptedGui('POD_resume_travel_ready_journey').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('journey',Scope.Story.MakeScope).End)]"
							# Close event window
							onclick = "[EventOption.Select]"
							
							clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_start_game"
							
							# Show Journey flavor text.
							# If Journeys can be resumed, show a reminder.
							# If not, show why.
							tooltip = "[Concatenate( Concatenate('#help ', Concatenate( Localize( Concatenate(Scope.Var('journey_type').GetFlagName,'_tt') ), '#!' ) ), Select_CString( GetScriptedGui('POD_journey_requirements').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('journey',Scope.Story.MakeScope).End), Localize('POD_resume_travel_ready_journey'), Concatenate( Localize('JANK_LINEBREAK'), GetScriptedGui('POD_journey_requirements').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('journey',Scope.Story.MakeScope).End) ) ) )]"
						}
					}
				}
			}
		}
	}
}