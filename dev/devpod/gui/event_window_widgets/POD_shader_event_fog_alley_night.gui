
pod_shader_event_widget = {
	name = "POD_shader_event_fog_alley_night"
	
	#blockoverride "effect_name" { effectname = "Fog" }
	
	blockoverride "shaderfile" {
		shaderfile = "gfx/FX/POD_shaders/POD_shaders_with_inputs.shader"
	}
	blockoverride "effect_name" {
		effectname = "PODFBM"
	}
	blockoverride "additional_inputs" {
		spriteborder_left   = 0.9 # speed
		spriteborder_top    = 1.4 # zoom
		spriteborder_right  = 0.5 # aspect ratio stretch factor
		spriteborder_bottom = 1.0 # alpha gradient strength
		
		modify_texture = { color = { 0.0  0.2  0.2  } } # color 1
		modify_texture = { color = { 0.0  0.55 0.68 } } # color 2
		modify_texture = { color = { 0.0  0.47 0.63 } } # color 3
		
		modify_texture = {
			color = { 0.0 0.0 1.0 1.0 } # which channels to use for alpha
			spriteborder_left = 0.5 # horizontal speed
			spriteborder_top  = 0.2 # vertical speed
			alpha = 0.7 # alpha
		}
	}
}