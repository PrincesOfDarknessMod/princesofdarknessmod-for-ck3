vbox = {
	name = "POD_event_window_widget_demonic_pact"
	layoutpolicy_horizontal = expanding

	state = {
		name = init
		trigger_on_create = yes
		on_start = "[GetScriptedGui('demonic_pact_creator_innit_script').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_start = "[GetVariableSystem.Set('demonic_pact_creator_tab', 'obligation')]"
	}

	hbox = {
		button_tab = {
			size = { 0 38 }
			layoutpolicy_horizontal = expanding
			onclick = "[GetVariableSystem.Set('demonic_pact_creator_tab', 'frequency')]"
			onclick = "[GetScriptedGui('demonic_pact_creator_chance_tab_script').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tab', MakeScopeFlag('frequency')).End)]"
			down = "[GetVariableSystem.HasValue( 'demonic_pact_creator_tab', 'frequency' )]"

			text_single = {
				raw_text = "POD_infernalism_events.1.frequency"
				parentanchor = center
				default_format = @tabformat
				alwaystransparent = yes
			}
		}
		button_tab = {
			size = { 0 38 }
			layoutpolicy_horizontal = expanding
			onclick = "[GetVariableSystem.Set('demonic_pact_creator_tab', 'obligation')]"
			onclick = "[GetScriptedGui('demonic_pact_creator_chance_tab_script').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tab', MakeScopeFlag('obligation')).End)]"
			down = "[GetVariableSystem.HasValue( 'demonic_pact_creator_tab', 'obligation' )]"

			text_single = {
				raw_text = "POD_infernalism_events.1.obligation"
				parentanchor = center
				default_format = @tabformat
				alwaystransparent = yes
			}
		}
		button_tab = {
			size = { 0 38 }
			layoutpolicy_horizontal = expanding
			onclick = "[GetVariableSystem.Set('demonic_pact_creator_tab', 'consequence')]"
			onclick = "[GetScriptedGui('demonic_pact_creator_chance_tab_script').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('tab', MakeScopeFlag('consequence')).End)]"
			down = "[GetVariableSystem.HasValue( 'demonic_pact_creator_tab', 'consequence' )]"

			text_single = {
				raw_text = "POD_infernalism_events.1.consequence"
				parentanchor = center
				default_format = @tabformat
				alwaystransparent = yes
			}
		}
	}
	
	scrollbox = {
		layoutpolicy_vertical = expanding
		layoutpolicy_horizontal = expanding
		size = { 0 225 }

		blockoverride "scrollbox_content" {
			vbox = {
				datamodel = "[GetPlayer.MakeScope.GetList('pact_detail_list')]"
				layoutpolicy_horizontal = expanding
				spacing = 4

				item = {
					button_standard_hover = {
						size = { 150 35 }
						layoutpolicy_horizontal = expanding
						
						onclick = "[GetScriptedGui('demonic_pact_creator_select_detail_script').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('detail_id', MakeScopeFlag(Scope.GetVariable('id').GetFlagName)).End)]"
						
						hbox = {
							margin = { 5 0 }
							spacing = 5

							button_radio = {
								size = { 30 30 }
								frame   = "[BoolTo1And2( GetScriptedGui('demonic_pact_creator_select_detail_script').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('detail_id', MakeScopeFlag(Scope.GetVariable('id').GetFlagName)).End) )]"
							}

							text_single = {
								alwaystransparent = yes
								text = "[Localize(Concatenate('POD_detail_', Scope.GetVariable('id').GetFlagName))]"
								align = nobaseline
								max_width = 345
							}

							tooltip = "[GetScriptedGui('demonic_pact_creator_select_detail_script').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('detail_id', MakeScopeFlag(Scope.GetVariable('id').GetFlagName)).End)]"

							expand = {}
						}
					}
				}
			}
		}
	}

	spacer = { size = { 0 15 } }
	vbox = {
		layoutpolicy_horizontal = expanding
		margin_bottom = 1
		
		datamodel = "[EventWindow.AccessEventWindowData.GetOptions]"
		
		item = {
			pod_fake_event_button = {
				layoutpolicy_horizontal = expanding
				
				enabled = "[PlayerGuiIsValid('demonic_pact_creator_finish_script')]"
				
				onclick = "[PlayerGuiExecute('demonic_pact_creator_finish_script')]"
				onclick = "[EventOption.Select]"
				block "pause_onclick" {}
				
				blockoverride "button_text" {
					text = "POD_infernalism_events.1.confirm"
				}
				blockoverride "button_tooltip" { 
					tooltip = "[GetScriptedGui('demonic_pact_creator_finish_script').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}
		}
	}
}