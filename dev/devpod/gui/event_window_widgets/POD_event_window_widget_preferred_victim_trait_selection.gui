@is_current_selection = "[ObjectsEqual( Trait.Self, GetPlayer.MakeScope.Var('event_preferred_victim_trait_selection').Trait )]"
@is_not_current_selection = "[Not( ObjectsEqual( Trait.Self, GetPlayer.MakeScope.Var('event_preferred_victim_trait_selection').Trait ) )]"

widget = {
	name = "POD_event_window_widget_preferred_victim_trait_selection"
	
	datacontext = "[GetNullCharacter]"
	#datacontext = "[GetPlayer]"
	datacontext = "[GetPlayer.GetFaith]"
	
	parentanchor = right|top
	
	position = { -94 74 }
	size = { 418 448 }
	
	scrollbox = {
		#size = { 418 376 }
		size = { 100% 100% }
		
		background = {
			using = Background_Area_Dark
			margin = { 5 5 }
		}
		
		background = {
			using = Background_Frame_Gold
			margin = { 5 5 }
		}
		
		blockoverride "scrollbox_margins" {
			
		}
		blockoverride "scrollbox_background" {}
		blockoverride "scrollbox_background_fade" {}
		
		blockoverride "scrollbox_content"
		{
			margin = { 0 6 }
			margin_right = 8
			
			fixedgridbox = {
				addcolumn = 66
				addrow = 66
				datamodel_wrap = 6
				flipdirection = yes
				
				datamodel = "[GetPlayer.MakeScope.GetList('event_preferred_victim_trait_choices')]"
				
				item = {
					widget = {
						size = { 66 66 }
						
						datacontext = "[Scope.Trait]"

						using = tooltip_se

						# tooltipwidget = {
						# 	using = character_trait_tooltip
						# }
						
						button_standard = {
							size = { 60 60 }
							parentanchor = center

							onclick = "[GetScriptedGui('POD_select_preferred_victim_trait_for_event_selection').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('trait',Trait.MakeScope).End)]"
							down = @is_current_selection
							
							# icon = {
							# 	size = { 100% 100% }
							# 	visible = @is_current_selection
							# 	#tintcolor = { 1.0 0.0 0.08 1.0 }
							# 	tintcolor = { 0.0 0.0 0.0 1.0 }
								
							# 	texture = "gfx/interface/component_masks/mask_rough_edges.dds"
							# 	spriteType = Corneredtiled
							# 	spriteborder = { 20 20 }
							# 	#color = { 0 0 0 0.2 }
							# 	texture_density = 4
							# }

							
							POD_instant_glow_effect = {
								visible = @is_not_current_selection
								blockoverride "glow_color" {
									color = { 0.0 0.0 0.0 1.0 }
								}
							}
							
							POD_instant_glow_effect = {
								visible = @is_current_selection
								alpha = 1.0
								blockoverride "glow_color" {
									color = { 1 0.9 0.8 1 }
									#color = { 1.0 0.0 0.08 1.0 }
								}
							}
							
							trait_icon_base = {
								parentanchor = center
								visible = "[Not(Trait.IsPersonality)]"
								
								blockoverride "glow" {
									using = pod_icon_shimmer
								}
								blockoverride "tooltip_placement" {
									using = tooltip_es
								}
							}
							
							# no shimmer for personality traits since it looks worse there
							trait_icon_base = {
								parentanchor = center
								visible = "[Trait.IsPersonality]"
								
								blockoverride "tooltip_placement" {
									using = tooltip_es
								}
							}
							
							pod_rectangular_glow = {
								visible = @is_current_selection
								blockoverride "max_glow_alpha" {
									alpha = 0.85
								}
							}
						}
						
					}
				}
			}
		}
	}
}
