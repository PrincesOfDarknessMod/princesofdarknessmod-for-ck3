
### Reached threshold 2 -> current suspicion level is 3
vbox = {
	name = "POD_event_window_widget_heist_suspicion_threshold_2"
	layoutpolicy_horizontal = expanding
	
	vbox = {
		margin_bottom = 12
		layoutpolicy_horizontal = expanding
		
		pod_suspicion_display = {
			blockoverride "fontsize" { fontsize = 22 }
			blockoverride "header_bg" {}
			blockoverride "background" {
				background = {
					using = pod_heist_suspicion_bg
					margin = { 10 20 }
					
					shaderfile = "gfx/FX/POD_shaders/POD_event_shaders.shader"
					block "effect" { effectname = "FogSuspicion3" }

					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_horizontal_short.dds"
						blend_mode = alphamultiply
					}
					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_horizontal_short.dds"
						mirror = horizontal
						blend_mode = alphamultiply
					}
				}
			}
		}
	}
}