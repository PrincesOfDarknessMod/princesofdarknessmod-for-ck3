@margin_h = 50

hbox = {
	name = "POD_event_window_widget_secret_selection"
	layoutpolicy_horizontal = expanding
	
	margin_bottom = 30
	
	spacer = { size = { @margin_h 0 } }
	
	scrollbox = {
		layoutpolicy_horizontal = expanding
		
		size = { -1 240 }
		
		background = {
			using = Background_Frame_Gold
		}
		
		blockoverride "scrollbox_content"
		{
			vbox = {
				datamodel = "[EventWindowWidget.GetScope.GetRootScope.GetList('event_secrets')]"
				layoutpolicy_horizontal = expanding
				spacing = 3
				
				item = {
					button_standard = {
						datacontext = "[Scope.Secret]"
						layoutpolicy_horizontal = expanding
						
						text = "[Secret.GetName]"
						tooltip = "[Secret.GetTooltipDesc]"
						down = "[ObjectsEqual( Secret.Self, EventWindowWidget.GetScope.GetRootScope.Var('event_secret_selection').Secret.Self )]"
						onclick = "[GetScriptedGui('POD_secret_selector').Execute(GuiScope.SetRoot(EventWindowWidget.GetScope.GetRootScope.Char.MakeScope).AddScope('secret',Secret.MakeScope).End)]"
						visible = "[GetScriptedGui('POD_secret_selector').IsShown(GuiScope.SetRoot(EventWindowWidget.GetScope.GetRootScope.Char.MakeScope).AddScope('secret',Secret.MakeScope).End)]"

						icon = {
							size = { 26 26 }
							parentanchor = vcenter
							position = { 5 0 }
							texture = "[Secret.GetType.GetIcon]"
						}
					}
				}
			}
		}
	}
	
	spacer = { size = { @margin_h 0 } }
}
