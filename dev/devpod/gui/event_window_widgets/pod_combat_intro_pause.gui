######################################
######   POD COMBAT INTRO PAUSE   ######
######################################

# Force-pause carrier for pod_combat.0200, the first-fight intro. Embedded in
# that event's custom_widgets_container purely for its state; it draws nothing.
#
# Why it exists: Part 3 stamps engaged_in_single_combat on both principals
# before the intro is fired, and the intro can sit open while the player reads
# and edits their loadout. Letting the world tick through that window would run
# the game with two characters locked out of other interactions for a duel that
# has not begun. The combat window pins the clock the same way while a fight is
# up (pod_combat_window.gui), and the ready bar carries its own copy.
#
# If in-game verification shows the state never runs from an event widget,
# delete this file and the widgets block in pod_combat.0200: single-player
# already pauses on a player event popup, and Begin re-validates the duel
# regardless, so nothing else depends on it.

# widget, not container: a container derives its size from its children and the
# engine rejects an explicit one, but this carrier has no children to size from.
widget = {
	name = "pod_combat_intro_pause"
	size = { 0 0 }

	state = {
		name = _pause
		trigger_when = "[Not(IsGamePaused)]"
		on_start = "[OnPause]"
	}
}
