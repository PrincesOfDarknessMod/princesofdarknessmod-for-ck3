widget = {
	name = "POD_event_window_widget_stalk_torture_options"
	
	parentanchor = right|top
	
	position = { -94 74 }
	size = { 518 448 }
	
	hbox = {
		layoutpolicy_horizontal = expanding
		
		spacer = { size = { 48 0 } }
		
		vbox = {
			expand = {}
			vbox = {
				datamodel = "[GetPlayer.MakeScope.GetList('stalk_options')]"
				spacing = 4
				item = { pod_stalk_option = {} }
			}
			spacer = { size = { 0 16 } }
			expand = {}
		}
		
		expand = {}
	}
	
	widget = {
		parentanchor = right|top
		position = { -146 271 }
		alpha = 0.9
		text_single = {
			text = "POD_stalk_actions_left"
			parentanchor = center
			default_format = "#bold;font:PODGrotesque;color:{0.25,0,0}"
			fontsize = 28
				
			text_single = {
				text = "POD_stalk_actions_left"
				position = { -3 -3 }
				default_format = "#bold;font:PODGrotesque;color:{1.0,0.92,0.74};glow_color:{1.0,0.0,0.0}"
				fontsize = 28
			}
			text_single = {
				text = "POD_stalk_actions_left"
				position = { -3 -3 }
				default_format = "#bold;font:PODGrotesque;color:{0.0,0.0,0.0};glow_color:{1.0,0.7,0.5}"
				fontsize = 28
				
				alpha = 0
				
				state = {
					name = "POD_stalk_screenshake_start"
					duration = 0.25
					next = "POD_stalk_screenshake_end"
					
					on_start = "[PdxGuiWidget.InterruptAnimation('POD_stalk_screenshake_end')]"

					animation = {
						bezier = { 0 1 0 1 }
						alpha = 1.0
					}
				}
				
				state = {
					name = "POD_stalk_screenshake_end"
					duration = 0.75

					animation = {
						bezier = { 0 1 0 1 }
						alpha = 0.0
					}
				}
			}
		}
	}
}

@button_enabled = "[ScriptedGui.IsValid( GuiScope.SetRoot(GetPlayer.MakeScope).AddScope( 'recipient', EventWindowWidget.GetScope.sC('recipient').MakeScope ).AddScope( 'cost', MakeScopeValue( EmptyScope.ScriptValue( Concatenate( Scope.GetFlagKey, '_cost' ) ) ) ).End )]"
@button_enabled_not = "[Not(ScriptedGui.IsValid( GuiScope.SetRoot(GetPlayer.MakeScope).AddScope( 'recipient', EventWindowWidget.GetScope.sC('recipient').MakeScope ).AddScope( 'cost', MakeScopeValue( EmptyScope.ScriptValue( Concatenate( Scope.GetFlagKey, '_cost' ) ) ) ).End ))]"
@button_onclick = "[ScriptedGui.Execute( GuiScope.SetRoot(GetPlayer.MakeScope).AddScope( 'recipient', EventWindowWidget.GetScope.sC('recipient').MakeScope ).AddScope( 'cost', MakeScopeValue( EmptyScope.ScriptValue( Concatenate( Scope.GetFlagKey, '_cost' ) ) ) ).End )]"
@button_tooltip = "[ScriptedGui.BuildTooltip( GuiScope.SetRoot(GetPlayer.MakeScope).AddScope( 'recipient', EventWindowWidget.GetScope.sC('recipient').MakeScope ).AddScope( 'cost', MakeScopeValue( EmptyScope.ScriptValue( Concatenate( Scope.GetFlagKey, '_cost' ) ) ) ).End )]"

@lerpcolor = "[Lerp_CVector4f( '(CVector4f)1.0,0.1,0.15,1.0', '(CVector4f)1.0,0.7,0.5,1.0', PODGetLerpfactorFromChildWidget )]"

types PODStalkTypes
{
	type pod_stalk_option = button_standard {
		datacontext = "[GetScriptedGui(Scope.GetFlagKey)]"
		
		enabled = @button_enabled
		onclick = @button_onclick
		onclick = "[PdxGuiTriggerAllAnimations('POD_stalk_screenshake_start')]"
		onclick = "[PdxGuiInterruptThenTriggerAllAnimations('stalk_clicksound','stalk_clicksound')]"
		onclick = "[PdxGuiInterruptThenTriggerAllAnimations('stalk_clicksound_2','stalk_clicksound_2')]"
		onclick = "[PdxGuiWidget.FindChild('lerpfactor').TriggerAnimation('POD_stalk_buttonclick_start')]"
		
		raw_text = ""
		tooltip = @button_tooltip
		using = tooltip_ws
		
		clicksound = ""
		
		blockoverride "background_color" {
			background = {
				texture = "gfx/interface/colors/white.dds"
				color = { 0.05 0.0 0.0 0.9 }
			}
			background = {
				texture = "gfx/interface/colors/white.dds"
				
				visible = @button_enabled
				
				shaderfile = "gfx/FX/POD_shaders/POD_shaders_with_inputs.shader"
				effectname = "PODFBM"
				
				spriteborder_left   = 2.0 # speed
				spriteborder_top    = 0.5 # zoom
				spriteborder_right  = 0.2 # aspect ratio stretch factor
				spriteborder_bottom = 0.0 # alpha gradient strength
				
				modify_texture = { color = @lerpcolor } # color 1
				modify_texture = { color = @lerpcolor } # color 2
				modify_texture = { color = @lerpcolor } # color 3
				
				modify_texture = {
					color = { 1.0 0.0 0.0 1.0 } # which channels to use for alpha
					spriteborder_left = 0.5 # horizontal speed
					spriteborder_top  = 0.2 # vertical speed
					alpha = "[Lerp_float( '(float)0.2', '(float)1.0', PODGetLerpfactorFromChildWidget )]" # alpha
				}
			}
			background = {
				using = Background_Frame
				visible = @button_enabled
				color = @lerpcolor
				alpha = 0.6
				margin = { 2 2 }
			}
			background = {
				using = Background_Frame
				visible = @button_enabled_not
			}
			background = {
				texture = "gfx/interface/component_effects/innovation_glow.dds"
				visible = @button_enabled
				spriteType = Corneredstretched
				spriteborder = { 30 30 }
				alpha = "[Lerp_float( '(float)0.2', '(float)1.0', PODGetLerpfactorFromChildWidget )]"
				margin = { 10 8 }
				color = @lerpcolor
			}
		}
		
		widget = {
			name = "lerpfactor"
			
			size = { 0 100 }
			scale = "[GetInvParentScale(PdxGuiWidget.Self)]"
			
			state = {
				name = "POD_stalk_buttonclick_start"
				duration = 0.25
				next = "POD_stalk_buttonclick_end"
				
				on_start = "[PdxGuiWidget.InterruptAnimation('POD_stalk_buttonclick_end')]"

				animation = {
					bezier = { 0 1 0 1 }

					size = { 100 100 }
				}
			}

			state = {
				name = "POD_stalk_buttonclick_end"
				duration = 0.75

				animation = {
					bezier = { 0 1 0 1 }

					size = { 0 100 }
				}
			}
		}
		
		blockoverride "button_pattern" {}
		
		text_single = {
			text = "POD_stalk_option_button_text"
			visible = @button_enabled
			default_format = "#clickable"
			
			size = { 100% 100% }
			autoresize = no
			margin = { 10 0 }
			align = center|nobaseline
			alwaystransparent = yes
		}
		
		text_single = {
			text = "POD_stalk_option_button_text"
			visible = @button_enabled_not
			default_format = "#low"
			
			size = { 100% 100% }
			autoresize = no
			margin = { 10 0 }
			align = center|nobaseline
			alwaystransparent = yes
		}
		
		# done via animation state so that sounds can overlap each other
		# instead of having to wait for the previous one to end
		state = {
			name = "stalk_clicksound"
			end_sound = {
				soundeffect = "event:/SFX/UI/Unit/Army/sfx_ui_unit_army_select_army"
			}
		}
		state = {
			name = "stalk_clicksound_2"
			end_sound = {
				soundeffect = "event:/SFX/UI/Unit/Army/sfx_ui_unit_army_attach"
			}
		}
	}
}
