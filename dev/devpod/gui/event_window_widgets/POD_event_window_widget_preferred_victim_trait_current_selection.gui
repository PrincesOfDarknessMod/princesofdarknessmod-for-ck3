template POD_trait_marginalia_bg {
	fittype = centercrop
	framesize = { 1144 486 }
	texture = "gfx/interface/window_legend_chronicle/marginalia_illustration.dds"
	margin = { 10 10 }

	modify_texture = {
		texture = "gfx/interface/component_masks/mask_fade_circle.dds"
		blend_mode = alphamultiply
	}

	modify_texture = {
		texture = "gfx/interface/component_masks/mask_clouds.dds"
		blend_mode = alphamultiply
		alpha = 0.75
	}
}

vbox = {
	name = "POD_event_window_widget_preferred_victim_trait_current_selection"
	layoutpolicy_horizontal = expanding
	
	datacontext = "[GetNullCharacter]"
	#datacontext = "[GetPlayer]"
	datacontext = "[GetPlayer.GetFaith]"
	datacontext = "[GetPlayer.MakeScope.Var('event_preferred_victim_trait_selection').Trait]"
	
	widget = {
		size = { 220 60 }
		
		widget = {
			size = { 100% 100% }
			position = { 1 1 }
			
			background = {
				using = POD_trait_marginalia_bg
				color = { 0.0 0.0 0.0 1.0 }
			}
		}
		
		widget = {
			size = { 100% 100% }
			
			background = {
				using = POD_trait_marginalia_bg
				color = { 1.0 0.0 0.5 1.0 }

				modify_texture = {
					color = { 1.0 0.0 0.5 1.0 }
					blend_mode = overlay
				}
				modify_texture = {
					color = { 1.0 0.0 0.5 1.0 }
					blend_mode = overlay
				}
				modify_texture = {
					color = { 1.0 0.0 0.5 1.0 }
					blend_mode = overlay
				}
			}
		}
		
		widget = {
			size = { 60 60 }
			parentanchor = center
			
			POD_instant_glow_effect = {
				#visible = @is_current_selection
				blockoverride "glow_color" {
					#color = { 1 0.9 0.8 0.5 }
					color = { 1.0 0.0 0.2 1.0 }
				}
			}
			
			trait_icon_base = {
				parentanchor = center
				
				blockoverride "glow" {
					using = pod_icon_shimmer
				}
				blockoverride "tooltip_placement" {
					using = tooltip_es
				}
			}
		}
	}
	
	text_single = {
		text = "POD_current_selection_tt"
		fontsize = 16
		align = center
	}
	spacer = { size = { 0 1 } }
	text_single = {
		text = "POD_preferred_victim_trait_event_selection_traitname"
		default_format = "#color:{0.15,0.08,0.0,1.0};glow_color:{0.0,0.0,0.0,1.0};FONT:PODSubtitles;bold"
		fontsize = 20
		align = center
		
		text_single = {
			position = { -2 -2 }
			
			text = "POD_preferred_victim_trait_event_selection_traitname"
			default_format = "#color:{0.74,0.66,0.52};glow_color:{0.68,0.56,0.41,0.3};FONT:PODSubtitles;bold"
			fontsize = 20
			align = center
		}
	}
	
	spacer = { size = { 0 24 } }
}
