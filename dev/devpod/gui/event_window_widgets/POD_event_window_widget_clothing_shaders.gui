
vbox = {
	name = "POD_event_window_widget_clothing_shaders"
	layoutpolicy_horizontal = expanding

	hbox = {
		layoutpolicy_horizontal = expanding

		scrollbox = {
			size = { 460 370 }
	
			blockoverride "scrollbox_margins" {}
			blockoverride "scrollbox_background" {}
			blockoverride "scrollbox_background_fade" {}
			blockoverride "scrollbox_content"
			{
				vbox = {
					#layoutpolicy_horizontal = expanding
					datacontext = "[EventWindowWidget.GetScope.sC('target')]"
					datacontext = "[EventWindowWidget.GetScope.sC('target').MakeScope.GetVariable('color_root')]"
			
					margin = { 16 16 }
			
					spacing = 16
			
					background = {
						using = Background_Area
					}

					button_standard = {
						text = "POD_style_undo"
						onclick = "[PlayerGuiExecute('POD_portrait_clothing_reset')]"
					}
	
					vbox = {
						layoutpolicy_horizontal = expanding
						pod_portrait_shader_editor = {
							blockoverride "label" {
								text = "POD_portrait_clothing_1_r"
							}
							blockoverride "variable" {
								raw_text = "[Scope.GetVariable('POD_portrait_clothing_1_r').GetValue|+2]"
							}
							blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('POD_portrait_clothing_1_r_edit')]" }
