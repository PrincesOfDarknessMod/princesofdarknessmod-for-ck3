types PODClothingShaderTypes
{
	type pod_clothing_shader_preset_selector = hbox
	{
		layoutpolicy_horizontal = expanding
		spacing = 6
		text_label_left = {
			block "label" {
				raw_text = "" 
			}
		}
		expand = {}
		pod_clothing_shader_dropdown = {
			block "datacontext" {}
		}
	}
	type pod_clothing_shader_dropdown = dropDown
	{
		datamodel = "[EventWindowWidget.GetScope.GetRootScope.GetList('POD_color_presets')]"

		block "size_button_drop" {
			size = { 225 33 }
		}

		active_item = {
			widget = {
				alwaystransparent = no
				size = { 100% 100% }

				button_drop = {
					text = "POD_set_color_tt"
				}
			}
		}

		item = {
			widget = {
				alwaystransparent = no
				block "size_dropdown" {
					size = { 225 33 }
				}

				button_dropdown = {
					block "size_dropdown" {
						size = { 225 33 }
					}
					text = "[Localize( Concatenate( Scope.GetFlagName, '_tt' ) )]"
					margin_left = 0
					align = center|nobaseline
					button = {
						size = { 100% 100% }
						onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(Character.MakeScope).AddScope('flag',MakeScopeFlag(Scope.GetFlagName)).End)]"
					}
				}
			}
		}

		list = {
			scrollarea = {
				position = { 5 33 }
				maximumsize = { 225 250 }
				autoresizescrollarea = yes
				scrollbarpolicy_horizontal = always_off

				using = Background_DropDown

				scrollwidget = {
					dynamicgridbox = {
						alwaystransparent = yes
					}
				}

				scrollbar_vertical = {
					using = Scrollbar_Vertical
				}
			}
		}
	}
}