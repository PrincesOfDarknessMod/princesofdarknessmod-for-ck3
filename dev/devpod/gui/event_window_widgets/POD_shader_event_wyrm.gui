
pod_shader_event_widget = {
	name = "POD_shader_event_wyrm"
	
	blockoverride "shaderfile" {
		shaderfile = "gfx/FX/POD_shaders/POD_sdf_shaders.shader"
	}
	blockoverride "effect_name" {
		effectname = "PODCloth"
	}
	blockoverride "additional_inputs" {
		# primary light
		modify_texture = {
			color = { 0.65 0.4 0.35 } # color
			spriteborder_left  =  0.9 # X position
			spriteborder_top   = -0.6 # Y position
			spriteborder_right =  0.8 # Z position
			spriteborder_bottom = 9.0 # POW
		}

		# secondary light
		modify_texture = {
			color = { 0.5 2.4 1.9 }   # color
			spriteborder_left  =  1.2 # X position
			spriteborder_top   = -0.7 # Y position
			spriteborder_right =  0.4 # Z position
		}
		
		# properties
		modify_texture = {
			# intensity of postprocessing (contrast, saturation, vignette)
			color = { 1.0 0.5 0.0 }
			spriteborder_left   = 1.0 # fake shadow/highlight intensity
			spriteborder_top    = 1.0 # speed (rot1)
			spriteborder_right  = 1.0 # speed (rot2)
			spriteborder_bottom = 1.0 # speed (height)
		}
	}
}