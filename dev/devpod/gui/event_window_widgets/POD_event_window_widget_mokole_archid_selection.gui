
scrollbox = {
	name = "POD_event_window_widget_mokole_archid_selection"
	
	position = { -100 72 }
	size = { 390 460 }
	parentanchor = right|top

	blockoverride "scrollbox_margins" {}
	blockoverride "scrollbox_background" {}
	blockoverride "scrollbox_background_fade" {}
	blockoverride "scrollbox_content"
	{
		vbox = {
			layoutpolicy_horizontal = expanding
	
			
			margin = { 16 16 }
	
			spacing = 12
	
			background = {
				using = Background_Area_ExtraDark
			}
			
			fixedgridbox = {
				layoutpolicy_horizontal = expanding
				datamodel = "[GetPlayer.MakeScope.GetList('ArchidOptionsList')]"
				datamodel_wrap = 2
				addcolumn = 180
				addrow = 30
				setitemsizefromcell = yes
				flipdirection = yes

				item = {
					button_standard = {
						layoutpolicy_horizontal = expanding
						text = "[Localize(Concatenate(Scope.GetFlagName,'_button_loc'))]"
						
						tooltip = "[GetScriptedGui('POD_archid_option_GUI_effect').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('flag', MakeScopeFlag(Scope.GetFlagName)).End)]"
						onclick = "[GetScriptedGui('POD_archid_current_choice_toggle_button').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('flag', MakeScopeFlag(Scope.GetFlagName)).End)]"


						texture = "gfx/interface/buttons/button_standard.dds"

						#Previously Chosen
						modify_texture = {
							visible = "[GetScriptedGui('POD_archid_previous_choice_button').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('flag', MakeScopeFlag(Scope.GetFlagName)).End)]"
							#texture = "gfx/interface/component_effects/effect_blue_shine.dds"
							texture = "gfx/interface/component_effects/effect_shimmer_blue.dds"
							#blend_mode = colordodge
							translate_uv = { 0.2 0.2 }
						}

						#Available Choice
						modify_texture = {
							visible = "[GetScriptedGui('POD_archid_available_choice_button').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('flag', MakeScopeFlag(Scope.GetFlagName)).End)]"
							texture = "gfx/interface/component_masks/mask_rough_texture.dds"
							blend_mode = alphamultiply
							spriteType = corneredTiled
							alpha = 0.5
						}

						# Current Selection
						modify_texture = {
							visible = "[GetScriptedGui('POD_archid_current_choice_button').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('flag', MakeScopeFlag(Scope.GetFlagName)).End)]"
							texture = "gfx/interface/buttons/button_standard_overlay.dds"
							alpha = 0.2
						}
						
					}
				}


				#Shows remaining picks
				widget = {
					allow_outside = yes
					hbox = {
						position = { 70 380 }
						spacing = 8
						text_single = {
							text = "POD_ARCHID_REMAINING_OPTIONS"
						}
						text_single = {
							text = "[GetPlayer.MakeScope.ScriptValue('mokole_available_archid_GUI_options')]"
						}
						
					}

					# Shows how many total options you have
					# hbox = {
					# 	position = { 70 410 }
					# 	spacing = 8
					# 	text_single = {
					# 		#position = { 115 380 }
					# 		text = "POD_ARCHID_TOTAL_OPTIONS"
					# 	}
					# 	text_single = {
					# 		#position = { 180 400 }
					# 		text = "[GetPlayer.MakeScope.ScriptValue('mokole_total_archid_options')]"
					# 		tooltip = "[GetPlayer.MakeScope.GetScriptValueDesc('mokole_total_archid_options')]"
					# 		default_format = "#V;underline"
					# 	}
					# }
				}
				
			}
			
		}
	}
}