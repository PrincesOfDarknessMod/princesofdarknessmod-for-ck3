@accent_color = "['(CVector4f)0.4,0.65,0.15,1.0']"

#@accent_color = "['(CVector4f)0.9,0.1,0.15,1.0']"
#@accent_color = "['(CVector4f)1.0,0.1,0.15,1.0']"

#@accent_color = "['(CVector4f)0.0,0.0,0.0,1.0']"

vbox = {
	name = "POD_event_window_widget_stalk_handicaps"
	layoutpolicy_horizontal = expanding
	
	hbox = {
		layoutpolicy_horizontal = expanding
		
		spacer = { size = { 12 0 } }
		
		widget = {
			layoutpolicy_horizontal = expanding
			#size = { -1 220 }
			size = { -1 290 }
			scissor = yes
			
			background = {
				using = Background_Area_Dark
				
				alpha = 0.8
				
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
				}
			}
			
			background = {
				fittype = centercrop
				framesize = { 1144 486 }
				texture = "gfx/interface/window_legend_chronicle/marginalia_illustration_asian.dds"
				
				color = { 0 0 0 1 }
				alpha = 0.9
				
				margin = { 1 1 }

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
				}
			}
			
			widget = {
				size = { 100% 100% }
				position = { -2 -2 }
				
				background = {
					fittype = centercrop
					framesize = { 1144 486 }
					texture = "gfx/interface/window_legend_chronicle/marginalia_illustration_asian.dds"
					color = @accent_color
					
					margin = { 1 1 }

					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
						blend_mode = alphamultiply
						mirror = vertical
						alpha = 0.65
					}
					
					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_inverse.dds"
						blend_mode = alphamultiply
						#alpha = 0.75
					}
				}
			}
			
			background = {
				using = Background_Frame
				
				color = @accent_color
				
				margin = { 3 0 }
				margin_bottom = 1
				
				alpha = 0.8
				
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
				}
			}
			
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				
				spacer = { size = { 0 14 } }
				
				text_single = {
					text = "POD_stalk_intro_header"
					default_format = "#bold"
					fontsize = 16
				}
				spacer = { size = { 0 18 } }
				text_multi = {
					text = "POD_stalk_intro_actions_desc"
					autoresize = yes
					max_width = 420
					align = center
				}
				text_single = {
					text = "POD_stalk_intro_actions"
					default_format = "#bold;font:PODGrotesque;color:{0.4,0.65,0.15}"
					fontsize = 24
				}
				spacer = { size = { 0 16 } }
				text_multi = {
					text = "POD_stalk_intro_prowess_desc"
					autoresize = yes
					max_width = 360
					align = center
				}
				spacer = { size = { 0 8 } }
				hbox = {
					datacontext = "[GetScriptedGui('POD_stalk_change_handicaps')]"
					
					button_minus = {
						#alpha = 0.65
						onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('delta',MakeScopeValue('(CFixedPoint)1')).AddScope('shiftclick',MakeScopeBool(IsShiftDown)).End)]"
						# TODO PMVP: tooltip
						#tooltip = "POD_style_clear_tt"
						#color = @accent_color
						using = POD_flat_icon_shadow
					}
					
					spacer = { size = { 2 0 } }
					
					text_single = {
						text = "POD_stalk_intro_prowess"
						default_format = "#bold;font:PODGrotesque;color:{0.4,0.65,0.15}"
						fontsize = 24
						margin_top = -8
					}
					
					spacer = { size = { 2 0 } }
					
					button_plus = {
						#alpha = 0.65
						onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('delta',MakeScopeValue('(CFixedPoint)-1')).AddScope('shiftclick',MakeScopeBool(IsShiftDown)).End)]"
						# TODO PMVP: tooltip
						#tooltip = "POD_style_clear_tt"
						#color = @accent_color
						using = POD_flat_icon_shadow
					}
				}
				expand = {}
				text_single = {
					text = "POD_stalk_intro_actor_prowess"
				}
				#spacer = { size = { 0 2 } }
				text_single = {
					text = "POD_stalk_intro_recipient_prowess"
				}
				#expand = {}
				spacer = { size = { 0 16 } }
			}
		}
		
		spacer = { size = { 12 0 } }
	}
	
	spacer = { size = { 0 6 } }
}

types PODStalkTypes
{
	
}
