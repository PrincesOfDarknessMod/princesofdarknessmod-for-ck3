
@lerpcolor = "[Lerp_CVector4f( '(CVector4f)1.0,0.1,0.15,1.0', '(CVector4f)1.0,0.7,0.5,1.0', PODGetLerpfactorFromChildWidget )]"

vbox = {
	name = "POD_event_window_widget_stalk_torture_results"
	layoutpolicy_horizontal = expanding
	
	hbox = {
		layoutpolicy_horizontal = expanding
		
		spacer = { size = { 12 0 } }
		
		widget = {
			layoutpolicy_horizontal = expanding
			size = { -1 300 }
			
			background = {
				using = Background_Area_Dark
				
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
				}
			}
			
			background = {
				fittype = centercrop
				framesize = { 1144 486 }
				texture = "gfx/interface/window_legend_chronicle/marginalia_illustration_asian.dds"
				color = @lerpcolor
				
				margin = { 1 1 }

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_siege_fire.dds"
					blend_mode = alphamultiply
					alpha = 0.75
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_clouds.dds"
					blend_mode = alphamultiply
					alpha = 0.35
				}
				
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_scratches.dds"
					spriteType = Corneredtiled
					blend_mode = alphamultiply
					texture_density = 4
					alpha = 0.3
				}
			}
			
			background = {
				using = Background_Frame
				
				color = @lerpcolor
				
				margin = { 3 0 }
				margin_bottom = 1
				
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
				}
			}
			
			background = {
				texture = "gfx/interface/component_effects/innovation_glow.dds"
				spriteType = Corneredstretched
				spriteborder = { 30 30 }
				margin = { 10 8 }
				color = @lerpcolor
				
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
				}
				
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_corner.dds"
					blend_mode = alphamultiply
					mirror = vertical|horizontal
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_clouds.dds"
					blend_mode = alphamultiply
					alpha = "[Lerp_float( '(float)1.0', '(float)0.0', PODGetLerpfactorFromChildWidget )]"
				}
			}
			
			# TODO PMVP: scrollbox
			text_multi = {
				size = { 100% 100% }
				margin = { 20 20 }
				text = "[GetScriptedGui('POD_stalk_results_preview').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('recipient',EventWindowWidget.GetScope.sC('recipient').MakeScope).End)]"
			}
			
			pod_stalk_color_lerpfactor = {}
		}
		
		spacer = { size = { 9 0 } }
		
		vbox = {
			layoutpolicy_vertical = expanding
			expand = {}
			pod_stalk_torture_portrait = {
				datacontext = "[EventWindowWidget.GetScope.sC('recipient')]"
				blockoverride "portrait_button" {
					# camera doesn't leave the subject centered, annoyingly
					position = { -31 0 }

					portrait_texture = "[Character.GetAnimatedPortraitEvenIfDead( 'POD_environment_combat_right', 'camera_event_right', 'prisondungeon', PdxGetWidgetScreenSize( PdxGuiWidget.Self ) )]"
					
					# actually color of the shadow
					color = @lerpcolor
					
					# actually UV offset of the shadow
					portrait_offset = { -0.02 -0.01 }
				}
			}
		}
		
		spacer = { size = { 6 0 } }
	}
	
	spacer = { size = { 0 6 } }
}

types PODStalkTypes
{
	type pod_stalk_torture_portrait = widget {
		# for positioning
		size = { 120 197 }
		
		widget = {
			# for cropping the portrait
			size = { 122 250 }
			
			scissor = yes
			parentanchor = hcenter|bottom
			
			background = {
				texture = "gfx/interface/colors/white.dds"
				
				margin = { 0 -2 }
				
				shaderfile = "gfx/FX/POD_shaders/POD_shaders_with_inputs.shader"
				effectname = "PODFBM"
				
				spriteborder_left   = 0.9 # speed
				spriteborder_top    = 0.4 # zoom
				spriteborder_right  = 2.0 # aspect ratio stretch factor
				spriteborder_bottom = 1.0 # alpha gradient strength
				
				modify_texture = { color = @lerpcolor } # color 1
				modify_texture = { color = @lerpcolor } # color 2
				modify_texture = { color = @lerpcolor } # color 3
				
				modify_texture = {
					color = { 1.0 0.0 0.0 1.0 } # which channels to use for alpha
					spriteborder_left = 0.5 # horizontal speed
					spriteborder_top  = 0.2 # vertical speed
					alpha = 0.4 # alpha
				}
			}
			
			portrait_button = {
				parentanchor = hcenter|bottom
				
				size = { 250 250 }
				
				pop_out = no
				gfxtype = portraitbuttongfx
				intersectionmask = no

				background_texture = "gfx/portraits/portrait_transparent.dds"
				texture = "gfx/portraits/portrait_transparent.dds"
				mask = "gfx/portraits/portrait_mask_event.dds"
				effectname = "NoHighlight"
				
				shaderfile = "gfx/FX/POD_shaders/POD_portrait_castshadow.shader"
				
				alwaystransparent = yes # no clicking
													
				grayscale = yes
				
				block "portrait_button" {
					
				}
				
				pod_stalk_color_lerpfactor = {}
			}
		}
		
		# putting the "background" frame on top so the portrait doesn't cover it
		widget = {
			size = { 122 250 }
			
			parentanchor = hcenter|bottom
		
			background = {
				using = Background_Frame
				
				color = @lerpcolor
				
				block "frame_margin" {
					margin = { 3 0 }
				}
				margin_bottom = 1
				
				# vertical transparency gradient
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
					mirror = vertical
				}
			}
			
			background = {
				texture = "gfx/interface/component_effects/innovation_glow.dds"
				spriteType = Corneredstretched
				spriteborder = { 30 30 }
				margin = { 10 8 }
				color = @lerpcolor
				
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
					mirror = vertical
				}
				
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_corner.dds"
					blend_mode = alphamultiply
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_clouds.dds"
					blend_mode = alphamultiply
					alpha = "[Lerp_float( '(float)1.0', '(float)0.0', PODGetLerpfactorFromChildWidget )]"
				}
			}
			
			pod_stalk_color_lerpfactor = {}
		}
	}
	
	type pod_stalk_color_lerpfactor = widget {
		name = "lerpfactor"
		
		size = { 0 100 }
		scale = "[GetInvParentScale(PdxGuiWidget.Self)]"
		
		state = {
			name = "POD_stalk_screenshake_start"
			duration = 0.25
			next = "POD_stalk_screenshake_end"
			
			on_start = "[PdxGuiWidget.InterruptAnimation('POD_stalk_screenshake_end')]"

			animation = {
				bezier = { 0 1 0 1 }

				size = { 100 100 }
			}
		}

		state = {
			name = "POD_stalk_screenshake_end"
			duration = 0.75

			animation = {
				bezier = { 0 1 0 1 }

				size = { 0 100 }
			}
		}
	}
}
