vbox = {
	name = "POD_event_window_widget_gambling"
	layoutpolicy_horizontal = expanding
	
	widget = {
		size = { 450 110 }
		
		background = {
			texture = "gfx/interface/window_contract/tile_contract_2_shadow.dds"
			spriteType = Corneredtiled
			spriteborder = { 200 200 }
		}
		
		vbox = {
			margin = { 20 12 }
			
			text_single = {
				text = "POD_event_window_widget_gambling_title"
				default_format = "#shinygold"
				fontsize = 30
				using = Font_Type_Flavor
				layoutpolicy_horizontal = expanding
				align = center
			}
			
			spacer = { size = { 0 6 } }

			pod_gambling_money_var_editor = {
				blockoverride "label" {
					text = "POD_event_window_widget_gambling_label"
				}
				blockoverride "row_tooltip" {
					tooltip = "POD_event_window_widget_gambling_tt"
				}
				blockoverride "variable" {
					raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_gambling_money_gambled_val')|0]"
				}
				blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_gambling_money_gambled_edit')]" }
			}
		}
	}
	
	spacer = { size = { 0 16 } }

	vbox = {
		layoutpolicy_horizontal = expanding
		margin_bottom = 1
		
		datamodel = "[EventWindow.AccessEventWindowData.GetOptions]"
		
		item = {
			pod_fake_event_button = {
				layoutpolicy_horizontal = expanding
				
				enabled = "[GetScriptedGui('POD_gambling_finish_script').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				
				onclick = "[GetScriptedGui('POD_gambling_finish_script').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
				onclick = "[EventOption.Select]"
				block "pause_onclick" {}
				
				blockoverride "button_text" {
					text = "pod1230objectives_judges.26.a"
				}
				blockoverride "button_tooltip" {
					tooltip = "[GetScriptedGui('POD_gambling_finish_script').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}
		}
	}
}

types PODGamblingMoneyAmount
{
	type pod_gambling_money_var_editor = hbox
	{
		layoutpolicy_horizontal = expanding
		spacing = 6
		text_label_left = {
            fontsize = 16
			block "label" {
				raw_text = ""
			}
			block "row_tooltip" {}
		}
		expand = {}
		hbox = {
			spacing = 6
			block "datacontext_edit" {}
			button_icon = {
				size = { 24 24 }
				texture = "gfx/interface/icons/flat_icons/select_arrow_left_double.dds"
				raw_tooltip = "-50"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('delta',MakeScopeValue('(CFixedPoint)-50')).End)]"
			}
			button_icon = {
				size = { 24 24 }
				mirror = horizontal
				texture = "gfx/interface/icons/flat_icons/select_arrow.dds"
				raw_tooltip = "-10"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('delta',MakeScopeValue('(CFixedPoint)-10')).End)]"
			}
			text_label_center = {
				min_width = 36
				block "variable" {
					raw_text = ""
				}
			}
			button_icon = {
				size = { 24 24 }
				texture = "gfx/interface/icons/flat_icons/select_arrow.dds"
				raw_tooltip = "+10"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('delta',MakeScopeValue('(CFixedPoint)10')).End)]"
			}
			button_icon = {
				size = { 24 24 }
				texture = "gfx/interface/icons/flat_icons/select_arrow_double.dds"
				raw_tooltip = "+50"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('delta',MakeScopeValue('(CFixedPoint)50')).End)]"
			}
		}
	}
}
