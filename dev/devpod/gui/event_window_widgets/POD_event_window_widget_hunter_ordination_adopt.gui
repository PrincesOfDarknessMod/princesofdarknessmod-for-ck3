
vbox = {
	name = "POD_event_window_widget_hunter_ordination_adopt"
	layoutpolicy_horizontal = expanding
	
	vbox = {
		margin_bottom = 12
		layoutpolicy_horizontal = expanding
		
		hbox = {
			layoutpolicy_horizontal = expanding
			
			tooltip = "hunter_ordination_adopt_widget_tt"
			
			expand = {}
			
			text_single = {
				margin_bottom = 5
				text = "hunter_ordination_adopt_widget_desc"
			}
			
			widget = {
				min_width = 6
			}
			
			button_checkbox = {
				size = { 24 24 }
				checked = "[GetPlayer.MakeScope.Var('will_adopt_newly_ordinated_hunter').IsSet]"
				onclick = "[PlayerGuiExecute('POD_toggle_ordination_adopt_hunter')]"
			}
			
			expand = {}
			
		}
	}
}