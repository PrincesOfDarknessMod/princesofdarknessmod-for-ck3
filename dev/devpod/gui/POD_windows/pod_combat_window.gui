															texture = "gfx/interface/icons/text_icons/normaldamagehealthtrack.dds"
															size = { 12 12 }
														}
														icon = {
															visible = "[GreaterThan_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_total_damage_sv'))]"
															texture = "gfx/interface/icons/text_icons/emptyhealthtrack.dds"
															size = { 12 12 }
