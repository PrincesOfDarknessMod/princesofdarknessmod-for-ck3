												blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)9', GetPlayer.MakeScope.ScriptValue('pod_combat_c9_total_damage_sv'))]" }
											}
											pod_combat_wound_box = {
												blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_max_hp_value'), '(CFixedPoint)10')]" }
												blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c9_agg_damage_sv'))]" }
												blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c9_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c9_total_damage_sv')))]" }
												blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c9_total_damage_sv'))]" }
												blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c9_agg_damage_sv'))]" }
												blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c9_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c9_total_damage_sv')))]" }
												blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c9_total_damage_sv'))]" }
											}
										}
									}
									blockoverride "morale_progressbar" {
										progressbar_standard = {
											size = { 150 10 }
											value = "[GetPlayer.MakeScope.ScriptValue('pod_combat_c9_morale_pct')]"
											tooltip = "pod_combat_morale_tooltip_c9"
										}
									}
									blockoverride "knocked_out" {
										button_standard = {
											size = { 240 22 }
											margin = { 5 0 }
											visible = "[GetPlayer.MakeScope.Var('pod_combat_c9_char').IsSet]"
											onclick = "[GetScriptedGui('pod_combat_select_target_9').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											enabled = "[GetScriptedGui('pod_combat_select_target_9').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											tooltip = "pod_combat_select_target_tooltip"
											text_single = {
												visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_alive_value'), '(CFixedPoint)0')]"
												raw_text = "#bold KNOCKED OUT#!"
												parentanchor = center
											}
											text_single = {
												visible = "[And(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_alive_value'), '(CFixedPoint)1'), EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pc_target_value'), '(CFixedPoint)9'))]"
												raw_text = "#bold TARGETED#!"
												parentanchor = center
											}
											text_single = {
												visible = "[And(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_alive_value'), '(CFixedPoint)1'), Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pc_target_value'), '(CFixedPoint)9')))]"
												raw_text = "Target"
												parentanchor = center
											}
										}
									}
									blockoverride "stance_icons" {
										icon = {
											visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_is_guarding_value'), '(CFixedPoint)0')]"
											texture = "gfx/interface/icons/combat/guard.dds"
											size = { 24 24 }
											position = { 210 2 }
											tooltip = "pod_combat_status_guard_tt"
										}
										icon = {
											visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_is_dodging_value'), '(CFixedPoint)0')]"
											texture = "gfx/interface/icons/combat/dodge.dds"
											size = { 24 24 }
											position = { 210 28 }
											tooltip = "pod_combat_status_dodge_tt"
										}
										icon = {
											visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_is_stealthed_value'), '(CFixedPoint)0')]"
											texture = "gfx/interface/icons/combat/stealth.dds"
											size = { 24 24 }
											position = { 210 54 }
											tooltip = "pod_combat_status_stealth_tt"
										}
									}
									blockoverride "stats_block" {
										vbox = {
											layoutpolicy_horizontal = expanding
											spacing = 0
											tooltipwidget = {
												pod_combat_slot_stats_tooltip = {
											blockoverride "hit_main" {
												raw_text = "[Concept('pod_combat_hit_chance','Hit Chance')|E]: #bold [GetPlayer.MakeScope.ScriptValue('pod_combat_c9_hit_chance_value')|0]%#!"
											}
											blockoverride "hit_buff_round" {
												visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_hit_buff_round_mag_sv'), '(CFixedPoint)0')]"
												raw_text = "#P +[GetPlayer.MakeScope.ScriptValue('pod_combat_c9_hit_buff_round_mag_sv')|0]% (round)#!"
											}
											blockoverride "hit_buff_combat" {
												visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_hit_buff_combat_mag_sv'), '(CFixedPoint)0')]"
												raw_text = "#P +[GetPlayer.MakeScope.ScriptValue('pod_combat_c9_hit_buff_combat_mag_sv')|0]% (combat)#!"
											}
											blockoverride "hit_debuff_round" {
												visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_hit_debuff_round_mag_sv'), '(CFixedPoint)0')]"
												raw_text = "#N -[GetPlayer.MakeScope.ScriptValue('pod_combat_c9_hit_debuff_round_mag_sv')|0]% (round)#!"
											}
											blockoverride "hit_debuff_combat" {
												visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_hit_debuff_combat_mag_sv'), '(CFixedPoint)0')]"
												raw_text = "#N -[GetPlayer.MakeScope.ScriptValue('pod_combat_c9_hit_debuff_combat_mag_sv')|0]% (combat)#!"
											}
											blockoverride "soak_main" {
												raw_text = "[Concept('soak_damage','Soak')|E]: #bold [GetPlayer.MakeScope.ScriptValue('pod_combat_c9_soak_value')|0]%#!"
											}
											blockoverride "soak_buff_round" {
												visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_soak_buff_round_mag_sv'), '(CFixedPoint)0')]"
												raw_text = "#P +[GetPlayer.MakeScope.ScriptValue('pod_combat_c9_soak_buff_round_mag_sv')|0]% (round)#!"
											}
											blockoverride "soak_buff_combat" {
												visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_soak_buff_combat_mag_sv'), '(CFixedPoint)0')]"
												raw_text = "#P +[GetPlayer.MakeScope.ScriptValue('pod_combat_c9_soak_buff_combat_mag_sv')|0]% (combat)#!"
											}
											blockoverride "soak_debuff_round" {
												visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_soak_debuff_round_mag_sv'), '(CFixedPoint)0')]"
												raw_text = "#N -[GetPlayer.MakeScope.ScriptValue('pod_combat_c9_soak_debuff_round_mag_sv')|0]% (round)#!"
											}
											blockoverride "soak_debuff_combat" {
												visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_soak_debuff_combat_mag_sv'), '(CFixedPoint)0')]"
												raw_text = "#N -[GetPlayer.MakeScope.ScriptValue('pod_combat_c9_soak_debuff_combat_mag_sv')|0]% (combat)#!"
											}
											blockoverride "init_main" {
												raw_text = "[Concept('pod_combat_initiative','Initiative')|E]: #bold [GetPlayer.MakeScope.ScriptValue('pod_combat_c9_initiative_value')|0]#!  ([Concept('pod_combat_turn_order','Turn')|E] [GetPlayer.MakeScope.ScriptValue('pod_combat_c9_turn_order_value')|0])"
											}
												}
											}
											text_single = {
												margin = { 4 1 }
												raw_text = "[Concept('prowess','#E Prowess#!')]: [GetPlayer.MakeScope.ScriptValue('pod_combat_c9_prowess_value')|0]  [Concept('pod_combat_hit_chance','#E Hit#!')]: [GetPlayer.MakeScope.ScriptValue('pod_combat_c9_hit_chance_value')|0]%  [Concept('soak_damage','#E Soak#!')]: [GetPlayer.MakeScope.ScriptValue('pod_combat_c9_soak_value')|0]%"
												default_format = "#weak"
											}
											text_single = {
												margin = { 4 1 }
												visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c9_initiative_value'), '(CFixedPoint)0')]"
												raw_text = "[Concept('pod_combat_initiative','#E Init#!')]:[GetPlayer.MakeScope.ScriptValue('pod_combat_c9_initiative_value')|0] [Concept('pod_combat_turn_order','#E Turn#!')]:[GetPlayer.MakeScope.ScriptValue('pod_combat_c9_turn_order_value')|0]"
												default_format = "#weak"
											}
										}
									}
									blockoverride "current_actor_bg" {
										background = {
											visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_current_actor_value'), '(CFixedPoint)9')]"
											using = Background_Area_Dark
											margin = { -2 -2 }
										}
									}
								}

								expand = {}
							}
						}
					}
				}
			}

				# Bottom buffer row (20px empty space)
				widget = {
					minimumsize = { -1 20 }
					maximumsize = { -1 20 }
				}
			}

			# Right padding (empty)
			widget = {
				minimumsize = { 30 -1 }
				maximumsize = { 30 -1 }
			}
		}
	}
}

types PODCombatTypes {
	
	# Combat-stats breakdown tooltip — used on each character slot's
	# stat line in pod_combat_window.gui. The widget reads from
	# slot-prefixed SVs (pod_combat_c{N}_*); each slot's invocation
	# blockoverrides the c0 defaults below to point at its own SVs.
	# Modifier lines collapse to invisible when their magnitude SV
	# is 0, so the tooltip shows only currently-active buffs/debuffs.
	#
	# Replaces the per-slot buff-display flowcontainer that used to
	# live inline in the portrait area — the same conditional-visibility
	# rendering, now packed into a hover affordance instead of taking
	# permanent screen real-estate.
	type pod_combat_slot_stats_tooltip = widget {
		alwaystransparent = no

		using = DefaultTooltipBackground
		using = GeneralTooltipSetup

		vbox = {
			resizeparent = yes
			margin = { 14 11 }
			layoutpolicy_horizontal = expanding
			spacing = 2

			text_single = {
				raw_text = "#bold;V;outline Combat Stats#!"
				fontsize = 16
				alwaystransparent = yes
			}

			spacer = { size = { 0 4 } }

			# ── HIT CHANCE ─────────────────────────────
			text_single = {
				block "hit_main" {
					raw_text = "[Concept('pod_combat_hit_chance','Hit Chance')|E]: #bold [GetPlayer.MakeScope.ScriptValue('pod_combat_c0_hit_chance_value')|0]%#!"
				}
				alwaystransparent = yes
			}
			flowcontainer = {
				margin_left = 12
				spacing = 6
				ignoreinvisible = yes

				text_single = {
					block "hit_buff_round" {
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_hit_buff_round_mag_sv'), '(CFixedPoint)0')]"
						raw_text = "#P +[GetPlayer.MakeScope.ScriptValue('pod_combat_c0_hit_buff_round_mag_sv')|0]% (round)#!"
					}
					alwaystransparent = yes
				}
				text_single = {
					block "hit_buff_combat" {
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_hit_buff_combat_mag_sv'), '(CFixedPoint)0')]"
						raw_text = "#P +[GetPlayer.MakeScope.ScriptValue('pod_combat_c0_hit_buff_combat_mag_sv')|0]% (combat)#!"
					}
					alwaystransparent = yes
				}
				text_single = {
					block "hit_debuff_round" {
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_hit_debuff_round_mag_sv'), '(CFixedPoint)0')]"
						raw_text = "#N -[GetPlayer.MakeScope.ScriptValue('pod_combat_c0_hit_debuff_round_mag_sv')|0]% (round)#!"
					}
					alwaystransparent = yes
				}
				text_single = {
					block "hit_debuff_combat" {
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_hit_debuff_combat_mag_sv'), '(CFixedPoint)0')]"
						raw_text = "#N -[GetPlayer.MakeScope.ScriptValue('pod_combat_c0_hit_debuff_combat_mag_sv')|0]% (combat)#!"
					}
					alwaystransparent = yes
				}
			}

			spacer = { size = { 0 6 } }

			# ── SOAK CHANCE ────────────────────────────
			text_single = {
				block "soak_main" {
					raw_text = "[Concept('soak_damage','Soak')|E]: #bold [GetPlayer.MakeScope.ScriptValue('pod_combat_c0_soak_value')|0]%#!"
				}
				alwaystransparent = yes
			}
			flowcontainer = {
				margin_left = 12
				spacing = 6
				ignoreinvisible = yes

				text_single = {
					block "soak_buff_round" {
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_soak_buff_round_mag_sv'), '(CFixedPoint)0')]"
						raw_text = "#P +[GetPlayer.MakeScope.ScriptValue('pod_combat_c0_soak_buff_round_mag_sv')|0]% (round)#!"
					}
					alwaystransparent = yes
				}
				text_single = {
					block "soak_buff_combat" {
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_soak_buff_combat_mag_sv'), '(CFixedPoint)0')]"
						raw_text = "#P +[GetPlayer.MakeScope.ScriptValue('pod_combat_c0_soak_buff_combat_mag_sv')|0]% (combat)#!"
					}
					alwaystransparent = yes
				}
				text_single = {
					block "soak_debuff_round" {
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_soak_debuff_round_mag_sv'), '(CFixedPoint)0')]"
						raw_text = "#N -[GetPlayer.MakeScope.ScriptValue('pod_combat_c0_soak_debuff_round_mag_sv')|0]% (round)#!"
					}
					alwaystransparent = yes
				}
				text_single = {
					block "soak_debuff_combat" {
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_soak_debuff_combat_mag_sv'), '(CFixedPoint)0')]"
						raw_text = "#N -[GetPlayer.MakeScope.ScriptValue('pod_combat_c0_soak_debuff_combat_mag_sv')|0]% (combat)#!"
					}
					alwaystransparent = yes
				}
			}

			spacer = { size = { 0 6 } }

			# ── INITIATIVE ─────────────────────────────
			text_single = {
				block "init_main" {
					raw_text = "[Concept('pod_combat_initiative','Initiative')|E]: #bold [GetPlayer.MakeScope.ScriptValue('pod_combat_c0_initiative_value')|0]#!  ([Concept('pod_combat_turn_order','Turn')|E] [GetPlayer.MakeScope.ScriptValue('pod_combat_c0_turn_order_value')|0])"
				}
				alwaystransparent = yes
			}
			text_multi = {
				raw_text = "#weak;italic Re-rolled at the start of each round from prowess + splat speed bonuses, modified by initiative debuffs from the previous round.#!"
				autoresize = yes
				maximumsize = { 360 -1 }
				alwaystransparent = yes
			}
		}
	}

	# One Health Track wound box. Three icon variants (aggravated /
	# superficial / empty) layered with three transparent concept-link
	# text overlays so hovering pops the matching damage-class card.
	# Defaults reference slot c0 box index 1; box invocations override
	# the 7 visibility blocks to swap in their own slot prefix and
	# CFixedPoint index. The pattern mirrors PoD's own wound-track
	# rendering in the character sheet.
	type pod_combat_wound_box = widget {
		block "outer_visible" {
			visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_max_hp_value'), '(CFixedPoint)1')]"
		}
		size = { 12 12 }
		icon = {
			block "agg_icon_visible" {
				visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv'))]"
			}
			texture = "gfx/interface/icons/text_icons/aggravateddamagehealthtrack.dds"
			size = { 12 12 }
		}
		icon = {
			block "super_icon_visible" {
				visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_total_damage_sv')))]"
			}
			texture = "gfx/interface/icons/text_icons/normaldamagehealthtrack.dds"
			size = { 12 12 }
		}
		icon = {
			block "empty_icon_visible" {
				visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_total_damage_sv'))]"
			}
			texture = "gfx/interface/icons/text_icons/emptyhealthtrack.dds"
			size = { 12 12 }
		}
		text_single = {
			block "agg_text_visible" {
				visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv'))]"
			}
			raw_text = "[Concept('POD_aggravated_damage','     ')]"
			default_format = "#!"
			fontsize = 12
			fontsize_min = 11
			parentanchor = center
		}
		text_single = {
			block "super_text_visible" {
				visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_total_damage_sv')))]"
			}
			raw_text = "[Concept('POD_superficial_damage','     ')]"
			default_format = "#!"
			fontsize = 12
			fontsize_min = 11
			parentanchor = center
		}
		text_single = {
			block "empty_text_visible" {
				visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_total_damage_sv'))]"
			}
			raw_text = "[Concept('POD_health_track','     ')]"
			default_format = "#!"
			fontsize = 12
			fontsize_min = 11
			parentanchor = center
		}
	}

	# One character slot in the combat window. Wraps what used to be
	# 10 hand-duplicated 534-line slot blocks as a widget type with
	# named blocks for every slot-prefixed reference. Defaults all
	# reference c0 / the player; slots 1-9 override each named block
	# with their own slot prefix when they invoke the widget. The
	# wound-bar section is itself a row of pod_combat_wound_box
	# invocations, each with their own slot+box-index overrides — so
	# this widget composes with the wound-box widget rather than
	# inlining all the wound-box markup.
	#
	# Base type is `vbox` so the slot stacks naturally inside the
	# column vbox in pod_combat_window.gui. `type X = widget` was
	# tried first and failed: `widget` doesn't size to its children,
	# so every slot reported 0×0 to the parent layout and they all
	# drew on top of each other.
	#
	#  the engine seemd to rejects `margin` at the body of a
	# `type X = ...` declaration regardless of base (`widget` AND
	# `vbox` both refuse it — the "Property 'margin'(630) not
	# handled" error). The 2px visual gap between slots is now
	# provided by the parent vbox's `spacing = 4` setting in
	# pod_combat_window.gui instead of a slot-internal margin.
	type pod_combat_slot = vbox {
		block "outer_visible" {
			visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_max_hp_value'), '(CFixedPoint)0')]"
		}
		# Sizing on the outer vbox so the parent column-vbox in
		# pod_combat_window.gui can stack each slot at the right
		# width. -1 height = auto-fit content.
		minimumsize = { 240 -1 }
		maximumsize = { 240 -1 }
		background = { using = Background_Area }
		widget = {
			block "char_datacontext" {
				datacontext = "[GetPlayer]"
			}
			size = { 240 90 }
			hbox = {
				margin = { 3 2 }
				portrait_head_small = {}
				vbox = {
					margin_left = 4
					spacing = 1
					text_single = {
						raw_text = "[Character.GetFirstNameNoTooltip]"
						default_format = "#bold"
					}
					text_single = {
						raw_text = "[Concept('POD_health_track','#E;bold Health Track:#!')]"
						default_format = "#weak"
					}
					block "wound_boxes" {
								flowcontainer = {
									direction = horizontal
									spacing = 0
									ignoreinvisible = yes
									pod_combat_wound_box = {
										blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_max_hp_value'), '(CFixedPoint)1')]" }
										blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv'))]" }
										blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_total_damage_sv')))]" }
										blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_total_damage_sv'))]" }
										blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv'))]" }
