######################################
######   POD COMBAT WINDOW   ######
######################################

# Three-panel group combat layout.
# Left: Ally team (slots 0-4).  Center: Controls + log.  Right: Enemy team (slots 5-9).
# Visible when pod_combat_active variable is set on the player.

widget = {
	name = "pod_combat_window"
	visible = "[And(And(Not(IsPauseMenuShown), IsDefaultGUIMode), GetPlayer.IsValid)]"
	layer = royal_court
	size = { 100% 100% }

	window = {
		parentanchor = center
		size = { 1410 940 }
		using = Window_Background
		using = Window_Decoration

		visible = "[And(GetPlayer.MakeScope.Var('pod_combat_active').IsSet, Not(GetPlayer.MakeScope.Var('pod_combat_config_open').IsSet))]"

		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			# Left padding (empty)
			widget = {
				minimumsize = { 30 -1 }
				maximumsize = { 30 -1 }
			}

			# Content column: top buffer, header, middle buffer, three-panel hbox, bottom buffer
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				# Top buffer row (20px empty space above the Combat header)
				widget = {
					minimumsize = { -1 20 }
					maximumsize = { -1 20 }
				}

				##############################
				###### HEADER (content width)
				##############################

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text" {
						text = "pod_combat_window_title"
					}

					blockoverride "button_close" {
						onclick = "[GetScriptedGui('pod_combat_forfeit').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						tooltip = "pod_combat_forfeit_tooltip"
					}
				}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 5 5 }

			##############################
			###### LEFT PANEL: ALLIES
			##############################

				vbox = {
					minimumsize = { 280 -1 }
					maximumsize = { 280 -1 }
					layoutpolicy_vertical = expanding
					margin = { 5 2 }

					text_single = {
						raw_text = "#bold ALLIES#!"
						default_format = "#weak"
						align = center
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_content"
						{
							vbox = {
								margin = { 0 2 }

								# Slot 0
								vbox = {
									visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_max_hp_value'), '(CFixedPoint)0')]"
									minimumsize = { 240 -1 }
									maximumsize = { 240 -1 }
									margin = { 2 2 }
									background = { using = Background_Area }
									widget = {
										datacontext = "[GetPlayer]"
										size = { 240 90 }
										hbox = {
											margin = { 3 2 }
											portrait_head_small = {}
											vbox = {
												margin_left = 4
												spacing = 1
												text_single = {
													raw_text = "[Character.GetFirstNameNoTooltip]"
													default_format = "#bold"
												}
												text_single = {
													raw_text = "#bold HP#!"
													default_format = "#weak"
												}
												flowcontainer = {
													direction = horizontal
													spacing = 0
													ignoreinvisible = yes
													widget = {
														visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_max_hp_value'), '(CFixedPoint)1')]"
														size = { 12 12 }
														icon = {
															visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv'))]"
															texture = "gfx/interface/icons/text_icons/aggravateddamagehealthtrack.dds"
															size = { 12 12 }
														}
														icon = {
															visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_total_damage_sv')))]"
															texture = "gfx/interface/icons/text_icons/normaldamagehealthtrack.dds"
															size = { 12 12 }
														}
														icon = {
															visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_total_damage_sv'))]"
															texture = "gfx/interface/icons/text_icons/emptyhealthtrack.dds"
															size = { 12 12 }
														}
													}
													widget = {
														visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_max_hp_value'), '(CFixedPoint)2')]"
														size = { 12 12 }
														icon = {
															visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv'))]"
															texture = "gfx/interface/icons/text_icons/aggravateddamagehealthtrack.dds"
															size = { 12 12 }
														}
														icon = {
															visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_total_damage_sv')))]"
															texture = "gfx/interface/icons/text_icons/normaldamagehealthtrack.dds"
															size = { 12 12 }
														}
														icon = {
															visible = "[GreaterThan_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_total_damage_sv'))]"
															texture = "gfx/interface/icons/text_icons/emptyhealthtrack.dds"
															size = { 12 12 }
														}
													}
													widget = {
														visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_max_hp_value'), '(CFixedPoint)3')]"
														size = { 12 12 }
														icon = {
															visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv'))]"
															texture = "gfx/interface/icons/text_icons/aggravateddamagehealthtrack.dds"
															size = { 12 12 }
														}
														icon = {
															visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_total_damage_sv')))]"
															texture = "gfx/interface/icons/text_icons/normaldamagehealthtrack.dds"
															size = { 12 12 }
														}
														icon = {
															visible = "[GreaterThan_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_total_damage_sv'))]"
															texture = "gfx/interface/icons/text_icons/emptyhealthtrack.dds"
															size = { 12 12 }
														}
													}
