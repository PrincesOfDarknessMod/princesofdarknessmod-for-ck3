											visible = "[GetPlayer.MakeScope.Var('pod_combat_c5_char').IsSet]"
											onclick = "[GetScriptedGui('pod_combat_select_target_5').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											enabled = "[GetScriptedGui('pod_combat_select_target_5').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											tooltip = "pod_combat_select_target_tooltip"
											text_single = {
												visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c5_alive_value'), '(CFixedPoint)0')]"
												raw_text = "#bold KNOCKED OUT#!"
												parentanchor = center
											}
											text_single = {
												visible = "[And(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c5_alive_value'), '(CFixedPoint)1'), EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pc_target_value'), '(CFixedPoint)5'))]"
												raw_text = "#bold TARGETED#!"
												parentanchor = center
											}
											text_single = {
												visible = "[And(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c5_alive_value'), '(CFixedPoint)1'), Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pc_target_value'), '(CFixedPoint)5')))]"
												raw_text = "Target"
												parentanchor = center
											}
										}
									}
									blockoverride "stance_icons" {
										icon = {
											visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c5_is_guarding_value'), '(CFixedPoint)0')]"
											texture = "gfx/interface/icons/combat/guard.dds"
											size = { 24 24 }
											position = { 210 2 }
											tooltip = "pod_combat_status_guard_tt"
