														size = { 12 12 }
														icon = {
															visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)9', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv'))]"
															texture = "gfx/interface/icons/text_icons/aggravateddamagehealthtrack.dds"
															size = { 12 12 }
