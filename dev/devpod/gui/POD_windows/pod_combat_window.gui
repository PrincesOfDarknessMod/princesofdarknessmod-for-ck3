														}
													}
													widget = {
														visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_max_hp_value'), '(CFixedPoint)7')]"
														size = { 12 12 }
														icon = {
															visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)7', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv'))]"
															texture = "gfx/interface/icons/text_icons/aggravateddamagehealthtrack.dds"
															size = { 12 12 }
														}
														icon = {
															visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)7', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)7', GetPlayer.MakeScope.ScriptValue('pod_combat_c0_total_damage_sv')))]"
															texture = "gfx/interface/icons/text_icons/normaldamagehealthtrack.dds"
															size = { 12 12 }
