######################################
######   POD COMBAT WINDOW   ######
######################################

# Three-panel group combat layout.
# Left: Ally team (slots 0-4).  Center: Controls + log.  Right: Enemy team (slots 5-9).
# Visible when pod_combat_active is set on the player AND
# pod_combat_config_open is NOT set

widget = {
	name = "pod_combat_window"
	# Gate the whole wrapper on pod_combat_active so the subtree (incl. the
	# window's _pause / OnPause state) isn't live on the default map view.
	# The inner window adds the config_open check so the skills-window
	# hand-off still hides it mid-combat without tearing down the wrapper.
	visible = "[And(And(And(Not(IsPauseMenuShown), IsDefaultGUIMode), GetPlayer.IsValid), GetPlayer.MakeScope.Var('pod_combat_active').IsSet)]"
	layer = royal_court
	size = { 100% 100% }

	

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
	}

	window = {
		parentanchor = center
		# Fallback only - the content hbox below carries
		# set_parent_size_to_minimum, which overrides a declared window
		# size (vanilla precedent with the same background/decoration
		# templates: interaction_modify_vassal_window.gui, whose size
		# line Paradox comments as doing nothing for the same reason).
		size = { 1525 940 }
		using = Window_Background
		using = Window_Decoration

		visible = "[And(GetPlayer.MakeScope.Var('pod_combat_active').IsSet, Not(GetPlayer.MakeScope.Var('pod_combat_config_open').IsSet))]"

		# Fade in/out when the visible binding above flips. _show fires on
		# visible->true (combat starts, or returns from skills window);
		# _hide fires on visible->false (combat cleanup, or jumping to
		# skills window mid-fight). Uses the vanilla Standard duration to
		# match other contextual windows (artifact details, etc.) - a
		# touch slower than _Quick, appropriate for a heavy panel.
		state = {
			name = _show
			using = Animation_FadeIn_Standard
		}
		state = {
			name = _hide
			using = Animation_FadeOut_Standard
		}

		state = {
			name = _pause
			trigger_when = "[Not(IsGamePaused)]"
			on_start = "[OnPause]"
		}

		background = {
			texture = "gfx/interface/component_tiles/tile_window_background.dds"
			spriteType = Corneredtiled
			spriteborder = { 18 0 }
			texture_density = 2
			margin = { -23 -17 }
	
			modify_texture = {
				texture = "gfx/interface/component_overlay/overlay_effect.dds"
				blend_mode = overlay
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			# The window adopts this box's minimum size, so it widens
			# automatically when the move rows hold 5+ buttons (raised
			# pod_combat_max_per_category) and snaps back when they
			# don't. minimumsize is the resting size: the width floor
			# keeps the layout at today's 1525 when content is narrower
			# (30+5+280+870+280+5+55), and the height floor is
			# load-bearing - the vertical chain is all expanding
			# scrollboxes with ~0 minimum and would collapse without it.
			set_parent_size_to_minimum = yes
			minimumsize = { 1525 940 }

			# Left padding (empty)
			widget = {
				minimumsize = { 30 -1 }
				maximumsize = { 30 -1 }
			}

			# Content column: top buffer, header, three-panel hbox, bottom buffer
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				# Top buffer row (20px empty space above the Combat header)
				widget = {
					minimumsize = { -1 20 }
					maximumsize = { -1 20 }
				}

				##############################
				###### HEADER (content width)
				##############################

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text" {
						text = "pod_combat_window_title"
					}

					blockoverride "button_close" {
						# Dispatches through pod_combat_close_window so the
						# X behaves intuitively across the combat lifecycle:
						# forfeits while combat is in progress, dismisses
						# the window once combat is resolved (same as the
						# End Combat bottom-bar button). is_valid stays
						# loose so the button is always clickable while
						# the window is open.
						onclick = "[GetScriptedGui('pod_combat_close_window').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						tooltip = "pod_combat_close_window_tooltip"
					}

					blockoverride "header_pattern" {
						modify_texture = {
							name = "pod_combat_header_shine"
							texture = "gfx/interface/component_effects/effect_header_blue_shine.dds"
							blend_mode = colordodge
							translate_uv = { 0.6 0 }
						}

						state = {
							name = right
							next = left
							duration = 8
							bezier = { 0.8 0.18 0.96 .05 }
							modify_texture = {
								name = "pod_combat_header_shine"
								translate_uv = { -0.6 0 }
							}
						}

						state = {
							name = left
							next = right
							duration = 0
							delay = 5
							modify_texture = {
								name = "pod_combat_header_shine"
								translate_uv = { 0.6 0 }
							}
						}

						state = {
							trigger_on_create = yes
							name = start
							next = right
							duration = 0
							modify_texture = {
								name = "pod_combat_header_shine"
								translate_uv = { 0.6 0 }
							}
						}
					}
				}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 5 5 }

			##############################
			###### LEFT PANEL: ALLIES
			##############################

				vbox = {
					minimumsize = { 280 -1 }
					maximumsize = { 280 -1 }
					layoutpolicy_vertical = expanding
					margin = { 5 2 }

					text_single = {
						raw_text = "#color_yellow;bold ALLIES#!"
						default_format = "#weak"
						align = center
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_content"
						{
							vbox = {
								margin = { 0 2 }
								# Slot widgets have no internal margin (the
								# `type X = vbox` parser rejects `margin` at
								# the type-body level); replace the per-slot
								# 2px padding with parent-level spacing.
								spacing = 4

								# Ally panel - datamodel iteration over the host's
								# pod_combat_active_slots variable list, filtered to
								# combat_team = flag:player (the PC at position 0,
								# ally knights at positions 1-4). Each iteration's Scope is
								# the slot story; the pod_combat_datamodel_slot
								# widget reads everything off Scope.Var('slot_X')
								# and Scope.ScriptValue('pod_combat_slot_X').
								#
								# pod_combat_active_slots is filled-only by construction
								# (the slot story is created lazily on first
								# pod_combat_set_slot_char_effect call), so the widget's
								# `datacontext = "[Scope.Var('slot_char').GetCharacter]"`
								# never evaluates against an unset slot_char (CK3 reports
								# that as "Scoped object of type 'character' is not
								# valid"). The list is populated in
								# pod_combat_set_slot_char_effect and cleared in
								# pod_combat_clear_slot_stories_effect.
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4

									datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_active_slots')]"
									item = {
										pod_combat_datamodel_slot = {
											# Ally-team filter only - slot_char-set
											# already implied by being in active_slots.
											visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_enemy_value'), '(CFixedPoint)0')]"
										}
									}
								}


								expand = {}
							}
						}
					}
			}

			##############################
			###### CENTER PANEL
			##############################

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				# Width floor: under minimum-driven window sizing each
				# row contributes only its fixed-content minimum (the
				# widest is the action-button row at ~712), so without
				# this pin a sparse loadout (every category under 4
				# moves) would shrink the whole window. 870 = 4-button
				# move row (42 label + 4x204 + 3x4 spacing).
				minimumsize = { 870 -1 }


				# ── Initiative track ──────────────────────────────────────
				# Turn order this round, left to right; the datamodel list is
				# pre-sorted by pod_combat_build_turn_order_list_effect at
				# round start (display order = list order). Hidden for 1v1,
				# where the two cards already tell the story. Gold underbar =
				# acting now; dimmed chip = already acted or knocked out.
				hbox = {
					visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_combatant_count_value'), '(CFixedPoint)2')]"
					expand = {}
					scrollarea = {
						layoutpolicy_horizontal = expanding
						minimumsize = { 0 108 }
						scrollbarpolicy_vertical = always_off
						scrollbarpolicy_horizontal = as_needed

						scrollbar_horizontal = {
							using = Scrollbar_Horizontal
						}

						scrollwidget = {
							hbox = {
								datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_turn_order_list')]"
								item = {
									pod_combat_initiative_track_item = {}
								}
							}
						}
					}
					expand = {}
				}

				# Round counter (left) + AP pip readout (right). The AP
				# readout is a six-icon pip strip plus a "N / 6" numeric
				# tag, mirroring the mana-globe pattern many tactical
				# games use. Each pip is three stacked icon widgets with
				# mutually-exclusive `visible` bindings - empty / filled /
				# supercharge - so the AP-gain overcap state (current_ap
				# > base_ap) swaps the pip artwork in place instead of
				# growing the row. The numeric "N / 6" trailing the
				# pips is the precise readout for players who want the
				# exact value; the pip row is the glanceable summary.
				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 4 }
					spacing = 12

					text_single = {
						raw_text = "[Localize('pod_combat_round')]"
						default_format = "#bold;glow_color:{0.0,0.0,0.0,1.0}"
						fontsize = 17
					}

					# PC target / hit readout. Per-slot cards show net
					# buff/debuff modifiers uniformly via
					# PODCombatSlotHitDisplay, so this widget carries the
					# absolute PC-vs-current-target percentage in the
					# header where the player sees it without hovering a
					# slot. Sits left-adjacent to the round counter with
					# a middle-dot separator (mirroring the combat-log
					# grammar) so the two header pieces read as a single
					# "round + current focus" block; the trailing expand
					# on this row pushes the whole left cluster away from
					# the AP pip strip on the right edge.
					#
					# Gated on PC having a target AND being in active
					# combat - the inner Var('pod_combat_pc_target_team') read
					# would also resolve when combat ended (the var
					# lingers briefly until cleanup), and slot 0's
					# slot_hit_chance is a stale post-combat value at
					# that point. Hiding rather than showing "0%" avoids
					# misinformation during the brief End-Combat-to-cleanup
					# window.
					text_single = {
						visible = "[And(GetPlayer.MakeScope.Var('pod_combat_active').IsSet, GetPlayer.MakeScope.Var('pod_combat_pc_target_team').IsSet)]"
						raw_text = "#weak ·#!  #glow_color:{0.0,0.0,0.0,1.0} [Localize('pod_combat_pc_target_display')]"
						fontsize = 17
						tooltip = "pod_combat_pc_hit_breakdown_tt"
					}

					expand = {}

					text_single = {
						raw_text = "[Localize('pod_combat_ap_label')]"
						default_format = "#weak;glow_color:{0.0,0.0,0.0,1.0}"
						fontsize = 17
					}

					# ── AP pip strip ──
					# Six fixed-position pip slots. Each slot renders one
					# of three icons based on the slot's index N versus
					# current_ap and a per-row threshold computed by
					# pod_combat_pip_supercharge_threshold:
					#   N >  current_ap            -> empty
					#   N <= current_ap, N <= thr  -> filled
					#   N <= current_ap, N >  thr  -> supercharge
					# When current_ap is at or below the effective cap the
					# threshold = the cap, so the supercharge test never
					# fires. When current_ap overflows the cap, the
					# threshold contracts so exactly (current_ap - cap)
					# pips at the RIGHT edge of the row render as
					# supercharge while the rest stay filled. E.g. 7 AP ->
					# pips 1-5 filled + pip 6 supercharge; 8 AP -> pips
					# 1-4 filled + pips 5-6 supercharge. The pips still
					# cap at six slots; magnitudes beyond 2*cap aren't
					# expressible without growing the row. Each instance is
					# also gated on index <= the (tunable) effective cap, so
					# a lowered cap collapses the row (ignoreinvisible).
					hbox = {
						spacing = 4
						ignoreinvisible = yes

						# Six pip instances, indices 1..6 hard-coded into each
						# instance's visibility expressions. Type lives in the
						# PODCombatTypes block below.
						pod_combat_ap_pip = {
							visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_effective_ap_cap_value'))]"
							blockoverride "empty_visible"       { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value'))]" }
							blockoverride "filled_visible"      { visible = "[And(LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_pip_supercharge_threshold')))]" }
							blockoverride "supercharge_visible" { visible = "[And(LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value')), GreaterThan_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_pip_supercharge_threshold')))]" }
						}
						pod_combat_ap_pip = {
							visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_effective_ap_cap_value'))]"
							blockoverride "empty_visible"       { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value'))]" }
							blockoverride "filled_visible"      { visible = "[And(LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_pip_supercharge_threshold')))]" }
							blockoverride "supercharge_visible" { visible = "[And(LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value')), GreaterThan_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_pip_supercharge_threshold')))]" }
						}
						pod_combat_ap_pip = {
							visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_effective_ap_cap_value'))]"
							blockoverride "empty_visible"       { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value'))]" }
							blockoverride "filled_visible"      { visible = "[And(LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_pip_supercharge_threshold')))]" }
							blockoverride "supercharge_visible" { visible = "[And(LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value')), GreaterThan_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_pip_supercharge_threshold')))]" }
						}
						pod_combat_ap_pip = {
							visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', GetPlayer.MakeScope.ScriptValue('pod_combat_effective_ap_cap_value'))]"
							blockoverride "empty_visible"       { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)4', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value'))]" }
							blockoverride "filled_visible"      { visible = "[And(LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', GetPlayer.MakeScope.ScriptValue('pod_combat_pip_supercharge_threshold')))]" }
							blockoverride "supercharge_visible" { visible = "[And(LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value')), GreaterThan_CFixedPoint('(CFixedPoint)4', GetPlayer.MakeScope.ScriptValue('pod_combat_pip_supercharge_threshold')))]" }
						}
						pod_combat_ap_pip = {
							visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_effective_ap_cap_value'))]"
							blockoverride "empty_visible"       { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value'))]" }
							blockoverride "filled_visible"      { visible = "[And(LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_pip_supercharge_threshold')))]" }
							blockoverride "supercharge_visible" { visible = "[And(LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value')), GreaterThan_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_pip_supercharge_threshold')))]" }
						}
						pod_combat_ap_pip = {
							visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', GetPlayer.MakeScope.ScriptValue('pod_combat_effective_ap_cap_value'))]"
							blockoverride "empty_visible"       { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)6', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value'))]" }
							blockoverride "filled_visible"      { visible = "[And(LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', GetPlayer.MakeScope.ScriptValue('pod_combat_pip_supercharge_threshold')))]" }
							blockoverride "supercharge_visible" { visible = "[And(LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value')), GreaterThan_CFixedPoint('(CFixedPoint)6', GetPlayer.MakeScope.ScriptValue('pod_combat_pip_supercharge_threshold')))]" }
						}
					}

					# Numeric readout: bold-gold current, muted slash + max.
					text_single = {
						raw_text = "#high;bold;glow_color:{0.0,0.0,0.0,1.0} [GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value')|0]#! #weak;glow_color:{0.0,0.0,0.0,1.0} / [GetPlayer.MakeScope.ScriptValue('pod_combat_effective_ap_cap_value')|0]#!"
						fontsize = 17
					}
				}

				##############################
				###### MOVE BUTTONS
				##############################
				# Datamodel-driven, grouped by combat_category. Four hbox
				# rows (ATK / DEF / CTL / PWR) share the same
				# pod_combat_loadout datamodel but filter per-button via
				# the category-check SGUIs (pod_combat_is_atk_move, etc.).
				# Matches the loadout-editor column grouping so players
				# see the same structure during setup and play.
				#
				# All four rows render unconditionally so the
				# ATK / DEF / CTL / PWR label column stays in a fixed
				# vertical line regardless of which categories the actor
				# has moves equipped in. An empty category row shows just
				# the bold label with empty space to its right - which
				# also doubles as a visual cue that the category slot is
				# unused. The label widget is fixed at 33 high so the row
				# keeps its baseline even when the flowcontainer renders
				# zero buttons, and the per-row spacing in the outer vbox
				# (`spacing = 2`) keeps the four labels evenly stacked.
				#
				# These rows are what the window auto-sizes for (see the
				# content hbox at the top): a 5th move in any category
				# pushes the row minimum past the center column's 870
				# floor and the whole window widens to fit. No horizontal
				# margin here - 42 + 4x204 + 3x4 = 870 exactly, so a
				# 4-move loadout reproduces the resting width instead of
				# nudging the window 10px wider.

				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 2

					# ── ATK row ──
					# `expand = {}` after the flowcontainer absorbs the
					# leftover horizontal space inside the expanding hbox
					# so the label + buttons stay left-anchored. Without
					# it the row content centers within the hbox and the
					# label drifts right whenever the actor has fewer
					# moves equipped (a 1-button row's center is much
					# closer to the hbox center than a 4-button row's).
					# Same trailing-expand pattern the round/AP header
					# above uses.
					#
					# Category labels are tinted with named color tags
					# (vanilla #color_red / _light_blue / _porple - note
					# vanilla's "porple" typo - plus our _pwr_orange from
					# preload/textformatting.gui) so each row gets its own
					# visual lane and a player scanning for "I want to
					# defend" can pick the right row in one glance.
					# Matches the mockup palette.
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 0 1 }

						widget = {
							size = { 42 33 }
							text_single = {
								parentanchor = vcenter
								raw_text = "#color_red;bold ATK#!"
								default_format = "#weak"
								margin_left = 2
							}
						}

						flowcontainer = {
							direction = horizontal
							spacing = 4
							ignoreinvisible = yes

							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								button_combat_atk = {
									size = { 204 33 }
									visible = "[GetScriptedGui('pod_combat_is_atk_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									tooltipwidget = { pod_fancy_combat_move_tooltip = {} }

									onclick = "[GetScriptedGui('pod_combat_execute_move').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									enabled = "[GetScriptedGui('pod_combat_execute_move').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

									# Label rendered by button_combat_atk's text_singles (color-by-enable).
									tooltip = "POD_combat_move_tooltip"
								}
							}
						}

						expand = {}
					}

					# ── DEF row ──
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 0 1 }

						widget = {
							size = { 42 33 }
							text_single = {
								parentanchor = vcenter
								raw_text = "#color_light_blue;bold DEF#!"
								default_format = "#weak"
								margin_left = 2
							}
						}

						flowcontainer = {
							direction = horizontal
							spacing = 4
							ignoreinvisible = yes

							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								button_combat_def = {
									size = { 204 33 }
									visible = "[GetScriptedGui('pod_combat_is_def_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									tooltipwidget = { pod_fancy_combat_move_tooltip = {} }

									onclick = "[GetScriptedGui('pod_combat_execute_move').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									enabled = "[GetScriptedGui('pod_combat_execute_move').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

									# Label rendered by the type's text_singles (color-by-enable).
									tooltip = "POD_combat_move_tooltip"
								}
							}
						}

						expand = {}
					}

					# ── CTL row ──
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 0 1 }

						widget = {
							size = { 42 33 }
							text_single = {
								parentanchor = vcenter
								raw_text = "#color_porple;bold CTL#!"
								default_format = "#weak"
								margin_left = 2
							}
						}

						flowcontainer = {
							direction = horizontal
							spacing = 4
							ignoreinvisible = yes

							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								button_combat_ctl = {
									size = { 204 33 }
									visible = "[GetScriptedGui('pod_combat_is_ctl_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									tooltipwidget = { pod_fancy_combat_move_tooltip = {} }

									onclick = "[GetScriptedGui('pod_combat_execute_move').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									enabled = "[GetScriptedGui('pod_combat_execute_move').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

									# Label rendered by the type's text_singles (color-by-enable).
									tooltip = "POD_combat_move_tooltip"
								}
							}
						}

						expand = {}
					}

					# ── PWR row ──
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 0 1 }

						widget = {
							size = { 42 33 }
							text_single = {
								parentanchor = vcenter
								raw_text = "#color_pwr_orange;bold PWR#!"
								default_format = "#weak"
								margin_left = 2
							}
						}

						flowcontainer = {
							direction = horizontal
							spacing = 4
							ignoreinvisible = yes

							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								button_combat_pwr = {
									size = { 204 33 }
									visible = "[GetScriptedGui('pod_combat_is_pwr_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									tooltipwidget = { pod_fancy_combat_move_tooltip = {} }

									onclick = "[GetScriptedGui('pod_combat_execute_move').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									enabled = "[GetScriptedGui('pod_combat_execute_move').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

									# Label rendered by the type's text_singles (color-by-enable).
									tooltip = "POD_combat_move_tooltip"
								}
							}
						}

						expand = {}
					}

					expand = {}
				}


				##############################
				###### ACTION BUTTONS
				##############################

				hbox = {
					# Margin matches the skill rows above (margin = { 0 1 })
					# so this row's left edge sits flush with the ATK/DEF/
					# CTL/PWR label column. Combined with the 42px
					# placeholder widget below, End Turn lines up under
					# the first move button.
					margin = { 0 4 }
					spacing = 20
					# Stretch to fill the parent's full width so the
					# expand below has leftover space to push the
					# Auto-Resolve+Help group flush right.
					layoutpolicy_horizontal = expanding
					# Hidden children (End Turn / Auto-Resolve during
					# post-combat, End Combat during active combat) drop
					# out of layout so the visible group stays packed
					# together instead of leaving gaps from collapsed
					# siblings.
					ignoreinvisible = yes

					# Left-inset placeholder - mirrors the 42px label
					# widget (ATK / DEF / CTL / PWR) on the skill rows
					# above so End Turn's left edge aligns with the
					# first move button in those rows.
					widget = {
						size = { 42 33 }
					}

					button_standard = {
						visible = "[And(Not(GetPlayer.MakeScope.Var('pod_combat_is_over').IsSet), Not(GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_current_actor_value'), '(CFixedPoint)0')))]"
						size = { 170 33 }
						text = "pod_combat_end_turn"
						onclick = "[GetScriptedGui('pod_combat_end_turn').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						enabled = "[GetScriptedGui('pod_combat_end_turn').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						tooltip = "pod_combat_end_turn_desc"
					}

					button_standard = {
						visible = "[And(Not(GetPlayer.MakeScope.Var('pod_combat_is_over').IsSet), GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_current_actor_value'), '(CFixedPoint)0'))]"
						size = { 170 33 }
						text = "pod_combat_advance_turn_label"
						onclick = "[GetScriptedGui('pod_combat_advance_turn').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						enabled = "[GetScriptedGui('pod_combat_advance_turn').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						tooltip = "pod_combat_advance_turn_tt"
					}

					# Auto-advance Preference Checkbox.
					# Sits beside End Turn (its semantic modifier). checked reads the
					# persistent global preference; onclick toggles it via the
					# pod_combat_toggle_auto_advance SGUI. visible mirrors End Turn so
					# it disappears post-combat.
					button_checkbox_label = {
						visible = "[Not(GetPlayer.MakeScope.Var('pod_combat_is_over').IsSet)]"
						tooltip = "pod_combat_auto_advance_tt"
						onclick = "[GetScriptedGui('pod_combat_toggle_auto_advance').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

						blockoverride "checkbox" {
							checked = "[GetGlobalVariable('pod_combat_auto_advance').IsSet]"
						}

						blockoverride "text" {
							text = "pod_combat_auto_advance_label"
						}
					}

					# Single flexible spacer pushes the Auto-Resolve+Help
					# group to the right edge. The group itself stays
					# packed via the hbox's standard 20px spacing  - 
					# Auto-Resolve and Help read as a related pair
					# ("alternate-resolve" and "look up help"), distinct
					# from End Turn's "commit your turn" semantic on the left.
					expand = {}

					button_standard = {
						visible = "[Not(GetPlayer.MakeScope.Var('pod_combat_is_over').IsSet)]"
						size = { 170 33 }
						text = "pod_combat_auto_resolve"
						onclick = "[GetScriptedGui('pod_combat_auto_resolve').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						enabled = "[GetScriptedGui('pod_combat_auto_resolve').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						tooltip = "pod_combat_auto_resolve_desc"
					}

					button_standard = {
						visible = "[GetPlayer.MakeScope.Var('pod_combat_is_over').IsSet]"
						size = { 170 33 }
						text = "pod_combat_end_combat"
						onclick = "[GetScriptedGui('pod_combat_end_combat').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						enabled = "[GetScriptedGui('pod_combat_end_combat').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}

					button_standard = {
						size = { 80 33 }
						text = "pod_combat_help_button"
						onclick = "[GetScriptedGui('pod_combat_help').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						enabled = "[GetScriptedGui('pod_combat_help').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						tooltip = "pod_combat_help_tooltip"
					}
				}

				##############################
				###### COMBAT LOG
				##############################

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 10 5 }

					background = {
						using = Background_Area
					}

					# No column headers - structural information is encoded
					# directly in each row's visual signal:
					#   * 3px gold / red side-bar on the left edge marks
					#     ally vs enemy actions at a glance
					#   * actor name carries the same gold / red tint as
					#     a redundant fallback while scrolling
					#   * inline "-> <target>" via PODCombatLogTargetText
					#     replaces the standalone Target column ("Self" /
					#     "AoE Allies" etc. collapse to empty or merge
					#     into the actor segment)
					#   * action name flows as #weak;italic context, no
					#     longer competes for focus
					#   * result column right-anchors with bold weight,
					#     making outcome the most prominent text on each
					#     row - where attention should land
					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content"
						{
							vbox = {
								layoutpolicy_horizontal = expanding
								margin = { 0 2 }

						# ── Combat Log Entries (datamodel iteration) ──
						# Each entry in pod_combat_log is a POD_combat_log_entry
						# story_cycle holding the snapshot needed to render one
						# log row. Move-static properties (capability flags +
						# damage class / targeting / tier vars)
						# are pulled live from the entry's stored move ref via
						# Scope.Var('move').Story.MakeScope. No per-entry
						# duplication on the log entry itself.
						#
						# Per-entry side classification reads
						# Scope.Var('actor_side') (captured by push_log as a
						# team code: 0 = player, 1 = enemy, -1 = system).
						# 0 = ally / player team, 1 = enemy team;
						# the side bar + actor-name tint both key off this
						# one = 0 / = 1 check.
						#
						# Container choice: vbox (not flowcontainer).
						# flowcontainer disallows hbox / vbox as direct
						# `item` children; vbox accepts them and naturally
						# stacks vertically.
						vbox = {
							layoutpolicy_horizontal = expanding
							# The pod_combat_log list is APPENDED oldest-first (no per-push
							# rebuild); bottomtotop seats item 0 (oldest) at the bottom and
							# stacks newer entries upward, so the feed reads newest-at-top -
							# matching the round-divider chapter order (a round_begins row,
							# pushed at round start, sits just below its round's action rows).
							# The resting scroll position (top) always shows the newest.
							bottomtotop = yes
							# No inter-row spacing - successive row frames butt
							# up against each other, the bottom edge of one
							# row's Background_Frame meets the top edge of the
							# next. Reads as a continuous bordered list rather
							# than a sequence of floating cards. The side bar
							# colour flip still differentiates adjacent rows
							# from different actors even without a gap.
							spacing = 0
							ignoreinvisible = yes

							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_log')]"

							item = {
								# Outer wrapper - CK3 datamodel item blocks accept
								# exactly one child widget. We need two row variants
								# (system divider vs standard action row) gated on
								# entry.var:system_message, so they live inside a
								# single vbox here with ignoreinvisible = yes
								# collapsing the hidden one to zero height. Without
								# the wrapper the parser rejects the item with
								# "Malformed item desc - single child only."
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 0
									ignoreinvisible = yes

								# ── System bookend divider row ─────────────────
								# Combat-lifecycle markers pushed by
								# pod_combat_push_system_log_effect (combat begins
								# / round N begins / combat ends) render as a
								# distinct visual divider instead of the
								# action-row frame: thin top + bottom rule with
								# the message centered in italic between them.
								# Reads as "this isn't an actor action," matching
								# the HTML mockup's chapter-break treatment so a
								# scroll back through a long combat finds round
								# transitions easily.
								#
								# Identification: system rows carry
								# entry.var:system_message (push_system_log_effect's
								# only required write); action rows leave it unset.
								# Single IsSet check rather than reaching into the
								# message-flag value because the divider styling
								# is uniform across system-message types - only
								# the inner text differs by flag.
								vbox = {
									visible = "[Scope.Var('system_message').IsSet]"
									layoutpolicy_horizontal = expanding
									margin = { 0 6 }
									spacing = 0

									# Top rule. 1px tall, dim grey, full-width.
									# Uses the vanilla pure-white texture tinted
									# down - CK3 backgrounds without a texture
									# render nothing, so just specifying `color`
									# would leave the line invisible.
									widget = {
										layoutpolicy_horizontal = expanding
										size = { -1 1 }
										background = {
											texture = "gfx/interface/colors/white.dds"
											color = { 0.5 0.55 0.6 0.5 }
										}
									}

									# Centered system-message text. Padded with
									# 4px top/bottom so the text doesn't crowd
									# the rules. Renders via the same
									# PODCombatLogSystemMessageText dispatcher
									# the move-less result-column branch also
									# calls - single source of truth for the
									# bookend loc keys.
									hbox = {
										layoutpolicy_horizontal = expanding
										margin = { 0 4 }
										expand = {}
										pod_combat_log_text = {
											raw_text = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('entry', Scope.Story.MakeScope).Custom('PODCombatLogSystemMessageText')]"
										}
										expand = {}
									}

									# Bottom rule - mirror of the top.
									widget = {
										layoutpolicy_horizontal = expanding
										size = { -1 1 }
										background = {
											texture = "gfx/interface/colors/white.dds"
											color = { 0.5 0.55 0.6 0.5 }
										}
									}
								}

								# ── Standard action row ────────────────────────
								# Per-row outline. Background_Frame is the vanilla
								# subtle-gray frame mask (#e6e6e6 @ 15% alpha over
								# the mask_frame.dds texture) - same template the
								# vanilla character sheet uses to box stat rows.
								# Wrapping the inner row hbox in a frame-backed
								# vbox gives each combat-log entry a discrete
								# outlined card, separating successive characters'
								# actions visually instead of letting the rows
								# bleed into one another.
								#
								# The frame is per-row (not per-actor-change)
								# because CK3 datamodels don't expose adjacent-
								# item comparison - there's no clean way to
								# stamp a heavier divider only at actor
								# transitions. Outlining every row gives a
								# uniform "firm" separator, which is the closest
								# approximation.
								#
								# Gated on the absence of system_message so the
								# divider branch above takes system rows.
								vbox = {
									visible = "[Not(Scope.Var('system_message').IsSet)]"
									layoutpolicy_horizontal = expanding
									# Team-tint wash. Two mutually-exclusive backgrounds
									# branch on entry.var:actor_side (0 = ally / player
									# team, 1 = enemy team) using the same palette as the
									# slot-card side bars - the per-row tint reinforces
									# team affiliation at a glance when scanning a long
									# log, so the player doesn't have to read the actor
									# name to know which side just acted.
									#
									# Declared BEFORE the Background_Frame so the frame's
									# subtle grey border + mask render on top of the wash
									# (CK3 backgrounds layer in document order, first =
									# bottom). Alpha is kept very low (0.10) so the
									# actor-name and side-bar colours still pop and the
									# frame's outline remains the dominant separator
									# between rows; raise the alpha to make team tinting
									# more emphatic, drop it to make it subtler.
									#
									# Both wash widgets need an explicit white.dds texture
									# because backgrounds with only `color` set don't
									# render any pixels - same constraint the side-bar
									# backgrounds work around.
									background = {
										visible = "[EqualTo_CFixedPoint(Scope.Var('actor_side').GetValue, '(CFixedPoint)0')]"
										texture = "gfx/interface/colors/white.dds"
										color = { 0.83 0.72 0.47 0.05 }
									}
									background = {
										visible = "[EqualTo_CFixedPoint(Scope.Var('actor_side').GetValue, '(CFixedPoint)1')]"
										texture = "gfx/interface/colors/white.dds"
										color = { 0.76 0.33 0.31 0.05 }
									}
									background = { using = Background_Frame }

									hbox = {
										layoutpolicy_horizontal = expanding
										# 5px horizontal padding inside the frame +
										# 8px vertical - with frames touching each
										# other, the row content needs noticeable
										# top / bottom breathing room or the text
										# crowds against the bordering frame edges.
										# Inner widgets are 22px tall (side bar /
										# action / result), so 8px vertical margin
										# puts each row at 38px total inside its
										# frame.
										margin = { 5 8 }
										spacing = 0

									# ── Side-bar (3 × full row) ────────────────────
									# Three-state visibility on entry.var:actor_side:
									#   0  = ally / player team (gold bar)
									#   1  = enemy team (red bar)
									#   -1   = system entry, no acting slot - no bar
									#
									# Colours match the mockup palette:
									#   ally  ≈ (0.83, 0.72, 0.47)
									#   enemy ≈ (0.76, 0.33, 0.31)
									#
									# Each background pairs `color` with the vanilla
									# pure-white texture. CK3 backgrounds without a
									# texture don't render any pixels for `color` to
									# tint, so the bar would be invisible if we only
									# specified `color`.
									#
									# push_log always sets actor_side; system entries
									# (no acting slot at push time) get the -1 sentinel
									# and fall into neither bar branch (ally = 0,
									# enemy = 1, system = -1).
									#
									# `layoutpolicy_vertical = expanding` makes the
									# bar stretch to the row's full height.
									widget = {
										size = { 4 -1 }
										layoutpolicy_vertical = expanding
										background = {
											visible = "[EqualTo_CFixedPoint(Scope.Var('actor_side').GetValue, '(CFixedPoint)0')]"
											texture = "gfx/interface/colors/white.dds"
											color = { 0.83 0.72 0.47 1 }
										}
										background = {
											visible = "[EqualTo_CFixedPoint(Scope.Var('actor_side').GetValue, '(CFixedPoint)1')]"
											texture = "gfx/interface/colors/white.dds"
											color = { 0.76 0.33 0.31 1 }
										}
									}

									# ── Context segment ────────────────────────────
									# Actor name (side-tinted) + inline "-> target"
									# (via PODCombatLogTargetText, empty for self /
									# no-target) + action name (#weak;italic). The
									# segment lives inside a single flowcontainer so
									# its parts tighten together without baseline
									# gaps. Context is content-sized. an `expand = {}`
									# widget after it absorbs the leftover row width,
									# pushing the result column to the row's right edge.
									flowcontainer = {
										direction = horizontal
										margin = { 8 0 }
										spacing = 0
										ignoreinvisible = yes

										# Actor - ally tint. Vanilla named format
										# `color_yellow` = (0.82, 0.77, 0.5), the
										# closest named gold to the mockup's
										# (0.83, 0.72, 0.47) bar. Inline RGB in
										# raw_text format tags isn't a vanilla
										# pattern, so we accept the small mismatch
										# in exchange for staying with named formats.
										# push_log always sets actor_side now, so
										# the comparison can be unguarded.
										pod_combat_log_text = {
											visible = "[And(Scope.Var('actor').IsSet, EqualTo_CFixedPoint(Scope.Var('actor_side').GetValue, '(CFixedPoint)0'))]"
											parentanchor = vcenter
											raw_text = "#color_yellow;bold [Scope.Var('actor').GetCharacter.GetFirstNameNoTooltip]#!"
										}
										# Actor - enemy tint. `color_red` =
										# (0.80, 0.3, 0.3), matches the enemy bar
										# (0.76, 0.33, 0.31) closely enough.
										pod_combat_log_text = {
											visible = "[And(Scope.Var('actor').IsSet, EqualTo_CFixedPoint(Scope.Var('actor_side').GetValue, '(CFixedPoint)1'))]"
											parentanchor = vcenter
											raw_text = "#color_red;bold [Scope.Var('actor').GetCharacter.GetFirstNameNoTooltip]#!"
										}

										# Arrow + target. PODCombatLogTargetText
										# returns "  -> <name>" (or "  -> All Enemies"
										# / "  -> All Allies" for AoE) and resolves to
										# empty for self-targeted / move-less rows.
										pod_combat_log_text = {
											parentanchor = vcenter
											raw_text = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('entry', Scope.Story.MakeScope).Custom('PODCombatLogTargetText')]"
										}

										# Action name (italic context). Hovers the
										# fancy move tooltip - the three blockoverrides
										# drill through Scope.Var('move').Story instead
										# of Scope.Story directly (datamodel Scope IS
										# the log entry, not the move).
										widget = {
											size = { 240 22 }
											tooltipwidget = {
												pod_fancy_combat_move_tooltip = {
													blockoverride "bg_texture" {
														texture = "[Scope.Var('move').Story.MakeScope.Var('decision').DecisionType.GetPicture(GetPlayer.Self)]"
													}
													blockoverride "text_title" {
														text = "POD_combat_log_move_title"
													}
													blockoverride "text_desc" {
														text = "POD_combat_log_move_tooltip"
													}
												}
											}
											pod_combat_log_text = {
												visible = "[Scope.Var('move').IsSet]"
												parentanchor = left|vcenter
												margin_left = 8
												raw_text = "#weak;italic [Scope.Var('move').Story.MakeScope.Var('decision').DecisionType.GetTitleForPlayer]#!"
											}
										}
									}

									# Flexible spacer between the context segment and
									# the result column. `expand = {}` is the standard
									# CK3 hbox pattern for pushing subsequent siblings
									# to the parent's far edge - it grabs all leftover
									# horizontal space inside the row hbox so the
									# result widget after it sits flush against the
									# row's right border.
									expand = {}

									# ── Result column (right-aligned, bold) ───────
									# Same six-rider stack as before; structure
									# unchanged. The widget itself is content-sized;
									# right-alignment comes from the `expand = {}`
									# above pushing this column to the row's right
									# edge, not from any inner anchoring. Main result
									# text gets a #bold prefix here because the
									# customizable_loc returns the raw amount string;
									# riders bring their own styling inside their loc
									# bodies.
									#
									# Each rider's `visible` gates on whether its
									# move variable is set so empty riders fully
									# collapse via ignoreinvisible (without the
									# gate, the customizable_loc returns "" but the
									# text_single still reserves baseline width,
									# leaving gaps).
									#
									# Render order (left-to-right inside the column):
									#   1. main result text (rolled amount + label).
									#      Ends with the wound-box icon for damage
									#      outcomes. AoE moves push one row per
									#      target, so each row carries its own
									#      per-target amount and label directly  - 
									#      no intent-fallback intercept needed.
									#   2. damage-source icon (fire / silver / holy
									#      / etc.) - trailing tag after the amount.
									#   3. heal rider - ", +X ▢" for life-drain /
									#      combined moves
									#   4. morale-damage rider - ", -X Morale"
									#   5. morale-heal rider - ", +X Morale"
									#   5b. retal rider - "+ Counter -X HP" overlay
									#      for any main outcome where a counter-
									#      strike resolved
									#   6. buff / debuff / status rider - stance /
									#      tier buff / utility flag the move applied.
									#      Gated on aoe_burst_index = 0 OR unset
									#      so move-level buffs render once per move
									#      instead of repeating across every per-
									#      target AoE row.
									hbox = {
										spacing = 0
										ignoreinvisible = yes

											# 1. Main result text. The customizable_loc's
											# branch loc keys carry their own styling
											# (#weak;italic verb + #bold;N negative
											# magnitude / #bold;P positive magnitude +
											# concept-linked wound-box icon). The
											# row-level ally/enemy POV signal is carried
											# by the side bar + actor-name tint upstream,
											# not by the result text - they're
											# independent signals.
											pod_combat_log_text = {
												visible = "[Scope.Var('move').IsSet]"
												raw_text = "[PODSegText('PODCombatLogResultText')]"
											}
												# ── Result-column segments ──
												# Each segment = separator + content widget pair
												# built from the PODSeg* data-binding macros.
												# A segment's visible SV returns 1 only when its
												# renderer emits content (outcome-suppression and
												# AoE burst gates live inside the SV); the
												# separator checks that SV AND the linked
												# pod_combat_log_before_* accumulator, so widget,
												# separator, and dispatcher can never disagree,
												# and appending a segment never edits existing ones.

												# 2a. Separator before heal rider.
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_heal_rider_visible_value', 'pod_combat_log_before_heal_value')]"
													raw_text = " #bold ·#! "
												}
												# 2. Heal rider - renders only when heal_amount > 0 AND
												# outcome != flag:heal (otherwise the heal primary
												# line already shows the same amount).
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_heal_rider_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogHealRider')]"
												}
												# 3a. Separator before morale-damage rider.
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_morale_damage_rider_visible_value', 'pod_combat_log_before_morale_damage_value')]"
													raw_text = " #bold ·#! "
												}
												# 3. Morale-damage rider - same suppression pattern as
												# heal rider, gated on the visible SV.
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_morale_damage_rider_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogMoraleDamageRider')]"
												}
												# 4a. Separator before morale-heal rider.
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_morale_heal_rider_visible_value', 'pod_combat_log_before_morale_heal_value')]"
													raw_text = " #bold ·#! "
												}
												# 4. Morale-heal rider.
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_morale_heal_rider_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogMoraleHealRider')]"
												}
												# 4ba. Separator before retal rider.
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_retal_rider_visible_value', 'pod_combat_log_before_retal_value')]"
													raw_text = " #bold ·#! "
												}
												# 4b. Retal rider - renders the "+ Counter -X HP" /
												# "+ Counter Soaked" rider line independent of the
												# main outcome line; works for ANY main attack outcome
												# (hp_damage / soaked / guard_blocked / missed / dodged
												# / stealthed). Not suppressed by any outcome.
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_retal_rider_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogRetalRider')]"
												}
												# Recoil segment (outcome): post-soak self-damage the actor took.
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_seg_recoil_visible_value', 'pod_combat_log_before_recoil_value')]"
													raw_text = " #bold ·#! "
												}
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_seg_recoil_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogSegRecoil')]"
												}
												# Intent segments (one separator+content pair per move
												# primitive class). Order: tiers, stances, guard strip, 
												# armed counter, AP, initiative.
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_seg_hit_tier_visible_value', 'pod_combat_log_before_hit_tier_value')]"
													raw_text = " #bold ·#! "
												}
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_seg_hit_tier_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogSegHitTier')]"
												}
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_seg_soak_tier_visible_value', 'pod_combat_log_before_soak_tier_value')]"
													raw_text = " #bold ·#! "
												}
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_seg_soak_tier_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogSegSoakTier')]"
												}
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_seg_guard_visible_value', 'pod_combat_log_before_guard_value')]"
													raw_text = " #bold ·#! "
												}
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_seg_guard_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogSegGuard')]"
												}
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_seg_dodge_visible_value', 'pod_combat_log_before_dodge_value')]"
													raw_text = " #bold ·#! "
												}
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_seg_dodge_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogSegDodge')]"
												}
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_seg_stealth_visible_value', 'pod_combat_log_before_stealth_value')]"
													raw_text = " #bold ·#! "
												}
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_seg_stealth_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogSegStealth')]"
												}
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_seg_remove_guard_visible_value', 'pod_combat_log_before_remove_guard_value')]"
													raw_text = " #bold ·#! "
												}
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_seg_remove_guard_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogSegRemoveGuard')]"
												}
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_seg_retal_armed_visible_value', 'pod_combat_log_before_retal_armed_value')]"
													raw_text = " #bold ·#! "
												}
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_seg_retal_armed_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogSegRetalArmed')]"
												}
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_seg_ap_gain_visible_value', 'pod_combat_log_before_ap_gain_value')]"
													raw_text = " #bold ·#! "
												}
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_seg_ap_gain_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogSegApGain')]"
												}
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_seg_ap_drain_visible_value', 'pod_combat_log_before_ap_drain_value')]"
													raw_text = " #bold ·#! "
												}
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_seg_ap_drain_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogSegApDrain')]"
												}
												pod_combat_log_text = {
													visible = "[PODSegSepVisible('pod_combat_log_seg_init_debuff_visible_value', 'pod_combat_log_before_init_debuff_value')]"
													raw_text = " #bold ·#! "
												}
												pod_combat_log_text = {
													visible = "[PODSegVisible('pod_combat_log_seg_init_debuff_visible_value')]"
													raw_text = "[PODSegText('PODCombatLogSegInitDebuff')]"
												}
												# Move-less rows - system-message bookends pushed by
												# pod_combat_push_system_log_effect (combat start /
												# victory / defeat). The dispatcher reads
												# entry.var:system_message and resolves to the matching
												# loc key. For move-less entries WITHOUT a system_message
												# (shouldn't happen in normal play but possible if a
												# debug tool pushes one), the dispatcher's unknown
												# fallback returns a muted " - " placeholder.
												pod_combat_log_text = {
													visible = "[And(Not(Scope.Var('move').IsSet), Scope.Var('system_message').IsSet)]"
													raw_text = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('entry', Scope.Story.MakeScope).Custom('PODCombatLogSystemMessageText')]"
												}
												pod_combat_log_text = {
													visible = "[And(Not(Scope.Var('move').IsSet), Not(Scope.Var('system_message').IsSet))]"
													raw_text = "#weak —#!"
												}
											}
										}
									}
								}
								}
							}

						# Empty state placeholder - shows when the log list is empty.
						pod_combat_log_text = {
							visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('pod_combat_log'))]"
							text = "pod_combat_log_empty"
							margin = { 5 4 }
						}
							}
						}
					}
				}
			}

			##############################
			###### RIGHT PANEL: ENEMIES
			##############################

				vbox = {
					minimumsize = { 280 -1 }
					maximumsize = { 280 -1 }
					layoutpolicy_vertical = expanding
					margin = { 5 2 }

					text_single = {
						raw_text = "#color_red;bold ENEMIES#!"
						default_format = "#weak"
						align = center
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_content"
						{
							vbox = {
								margin = { 0 2 }

								# Enemy panel - same datamodel iteration pattern as the
								# ally panel above, filtered to combat_team = flag:enemy
								# (enemy team: opponent leader at enemy/0, enemy
								# knights at enemy/1-4). See the ally panel block's
								# comments for container-shape and filter rationale.
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4

									datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_active_slots')]"
									item = {
										pod_combat_datamodel_slot = {
											# Enemy-team filter: combat_team = flag:enemy.
											# Ally slots (player team) are rendered by the
											# left panel's iteration.
											visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_enemy_value'), '(CFixedPoint)1')]"
										}
									}
								}

								expand = {}
							}
						}
					}
				}
			}

				# Bottom buffer row (20px empty space)
				widget = {
					minimumsize = { -1 20 }
					maximumsize = { -1 20 }
				}
			}

			# Right padding (empty). Mirrors the 30px left pad but
			# adds an extra 25px (55 total) so the ENEMIES panel has
			# noticeable breathing room from the window's right
			# decoration. Paired with the +25 window-width bump
			# (1500 -> 1525, now the auto-size floor rather than the
			# fixed size) - together they shift the gap from
			# "inside the central column" to "between the ENEMIES
			# panel and the window edge" without changing the
			# central column's tightened width.
			widget = {
				minimumsize = { 55 -1 }
				maximumsize = { 55 -1 }
			}
		}
	}
}

types PODCombatTypes {

	# Combat-log text style. Every prose / amount / rider widget in the
	# log datamodel uses this type instead of bare text_single so the log
	# font size is tunable from a single knob here. Inherits all other
	# text_single behaviour (raw_text, parentanchor, default_format,
	# visible). Only the default font size changes. Per-widget override
	# remains available (`fontsize = N` inside any usage still wins),
	# but the established log convention is "leave fontsize alone, let
	# the type drive it." Separator dot widgets use the same type so the
	# middle-dot character lines up with the surrounding rider text
	# instead of riding the smaller default baseline.
	type pod_combat_log_text = text_single {
		fontsize = 16
	}

	# One Health Track wound box. Three icon variants (aggravated /
	# superficial / empty) layered with three transparent concept-link
	# text overlays so hovering pops the matching damage-class card.
	# Defaults assume box index 1 with current Scope = the slot story
	# (read via the slot-agnostic pod_combat_slot_*_sv family); box
	# invocations override all 7 visibility blocks to swap in their
	# own CFixedPoint box index. The pattern mirrors PoD's own
	# wound-track rendering in the character sheet.
	type pod_combat_wound_box = widget {
		block "outer_visible" {
			visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.Var('slot_mirror_maxhp').GetValue, '(CFixedPoint)1')]"
		}
		size = { 12 12 }
		icon = {
			block "agg_icon_visible" {
				visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_agg').GetValue)]"
			}
			texture = "gfx/interface/icons/text_icons/aggravateddamagehealthtrack.dds"
			size = { 12 12 }
		}
		icon = {
			block "super_icon_visible" {
				visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_total').GetValue))]"
			}
			texture = "gfx/interface/icons/text_icons/normaldamagehealthtrack.dds"
			size = { 12 12 }
		}
		icon = {
			block "empty_icon_visible" {
				visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_total').GetValue)]"
			}
			texture = "gfx/interface/icons/text_icons/emptyhealthtrack.dds"
			size = { 12 12 }
		}
		text_single = {
			block "agg_text_visible" {
				visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_agg').GetValue)]"
			}
			raw_text = "[Concept('POD_aggravated_damage','     ')]"
			default_format = "#!"
			fontsize = 12
			fontsize_min = 11
			parentanchor = center
		}
		text_single = {
			block "super_text_visible" {
				visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_total').GetValue))]"
			}
			raw_text = "[Concept('POD_superficial_damage','     ')]"
			default_format = "#!"
			fontsize = 12
			fontsize_min = 11
			parentanchor = center
		}
		text_single = {
			block "empty_text_visible" {
				visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_total').GetValue)]"
			}
			raw_text = "[Concept('POD_health_track','     ')]"
			default_format = "#!"
			fontsize = 12
			fontsize_min = 11
			parentanchor = center
		}
	}

	# One pip slot in the Action-Points header strip. Stacks the three
	# state-icons (empty / filled / supercharge) at position 0,0 inside
	# a 16x16 widget; exactly one icon is visible per render (set by
	# the caller's three blockoverrides) so the pip appears as a single
	# textured pip in the appropriate state.
	#
	# Visibility-state contract:
	#   * empty       : current_ap < pip_index
	#   * filled      : current_ap >= pip_index AND pip_index <= threshold
	#   * supercharge : current_ap >= pip_index AND pip_index >  threshold
	#
	# Used in the AP pip strip (hbox of six pod_combat_ap_pip instances,
	# pip indices 1..6 hard-coded into each instance's blockoverrides).
	# Replaces what used to be six near-identical ~22-line widget copies.
	type pod_combat_ap_pip = widget {
		size = { 16 16 }
		icon = {
			size = { 16 16 }
			texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
			block "empty_visible" { visible = no }
		}
		icon = {
			size = { 16 16 }
			texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
			block "filled_visible" { visible = no }
		}
		icon = {
			size = { 16 16 }
			texture = "gfx/interface/icons/combat/ap_pip_supercharge.dds"
			block "supercharge_visible" { visible = no }
		}
	}

	# Single character slot card. Reads everything off the iterated
	# scope (the slot story) - no per-slot SVs, no blockoverrides.
	# Used inside the ally / enemy panels' datamodel iterations over
	# the host's pod_combat_active_slots variable list - each
	# iteration's Scope is the iterated slot story, so:
	#   - Scope.Var('slot_X').GetValue|0  reads a numeric slot var
	#   - Scope.Var('slot_char').GetCharacter  yields the participant
	#   - Scope.ScriptValue('pod_combat_slot_X')  evaluates
	#     a slot-story-scoped SV (defined in pod_combat_values.txt)
	#
	# Click-to-target surfaces (card-body underlay, initiative chips)
	# call pod_combat_select_target (unified SGUI taking
	# scope:target_slot, defined in pod_combat_control_guis.txt).
	# Hidden when this slot is the PC (player/0) since the PC can't target self.
	#
	# Initiative line shows both the rolled Init value and the Turn
	# rank within the round. Turn rank is stored as slot_turn_order
	# on each slot story (stamped by pod_combat_calc_turn_orders_effect
	# at the end of initiative calc) - read directly from there
	# rather than computed live, since computing rank requires
	# comparing against all 9 other slots which a slot-story-scoped
	# SV can't reach without a host back-reference.
	# Initiative-track chip: small portrait + short name for one combatant,
	# in turn order (list pre-sorted script-side). Same ordinal-key compare
	# as the slot cards for the current-actor state; same white.dds tint
	# recipe as the dead-slot overlay for the acted/KO dim.
	type pod_combat_initiative_track_item = vbox {
		visible = "[Scope.Var('slot_char').IsSet]"
		background = {
			using = Background_Area_Dark
		}
		background = {
			visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_current_actor_value'), Scope.ScriptValue('pod_combat_slot_ordinal_value'))]"
			using = Background_Area
		}
		widget = {
			datacontext = "[Scope.Var('slot_char').GetCharacter]"
			size = { 64 76 }
			vbox = {
				widget = {
					size = { 84 88 }
					#portrait_head_small without block "opinion_box"/status_icons/widget_portrait_frame
					widget = {
						size = { 84 88 }

						background = {
							using = Background_Area_Solid

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
								blend_mode = alphamultiply
								alpha = 0.2
								mirror = vertical
							}
						}

						widget = {
							size = { 100% 100% }
							using = Portrait_Background_Glows

							block "empty_character" {}
						}

						portrait_button = {
							parentanchor = bottom|hcenter
							size = { 80 100 }
							using = portrait_base

							block "portrait_texture"
							{
								portrait_texture = "[Character.GetPortrait('environment_head', 'camera_head', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
							}

							mask = "gfx/portraits/portrait_mask_head_small.dds"
							effectname = "NoHighlight"

							highlight_icon = {
								name = "prison_bars"
								visible = "[Character.IsImprisoned]"
								visible_at_creation = no
								size = { 80 88 }
								parentanchor = center
								effectname = "NoHighlight"
								texture = "gfx/portraits/portrait_prison_head.dds"

								modify_texture = {
									name = "mask"
									texture = "gfx/portraits/portrait_mask_head_small.dds"
									spriteType = Corneredstretched
									blend_mode = alphamultiply
								}
							}
						}
					}
					# Friend/foe frame: gold = player team, red = enemy, the
					# combat log's side-bar palette. Declared before the
					# acted/KO dim so spent chips dim frame and portrait
					# together.
					icon = {
						visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_enemy_value'), '(CFixedPoint)0')]"
						size = { 100% 100% }
						texture = "gfx/portraits/portrait_frame.dds"
						color = { 1 1 0.5 1 }
						alwaystransparent = yes
					}
					icon = {
						visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_enemy_value'), '(CFixedPoint)1')]"
						size = { 100% 100% }
						texture = "gfx/portraits/portrait_frame.dds"
						color = { 1 0 0 0.9 }
						alwaystransparent = yes
					}
					# Dim once this combatant has acted this round, or is down.
					icon = {
						visible = "[Or(GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_has_acted_value'), '(CFixedPoint)0'), EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_alive_value'), '(CFixedPoint)0'))]"
						size = { 100% 100% }
						texture = "gfx/interface/colors/white.dds"
						color = { 0 0 0 0.55 }
						alwaystransparent = yes
					}
					icon = {
						visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_current_actor_value'), Scope.ScriptValue('pod_combat_slot_ordinal_value'))]"
						size = { 100% 100% }
						texture = "gfx/interface/colors/white.dds"
						color = { 0.95 0.8 0.25 0.1 }
						alwaystransparent = yes
					}
					# Targeted badge - icon centered in a strip across the
					# top of the portrait (gfx/interface/icons/combat/Targeted.dds)
					widget = {
						visible = "[And(EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_pc_value'), '(CFixedPoint)0'), And(EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_alive_value'), '(CFixedPoint)1'), EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pc_target_value'), Scope.ScriptValue('pod_combat_slot_ordinal_value'))))]"
						size = { 100% 17 }
						alwaystransparent = yes
						state = {
							name = _show
							using = Animation_FadeIn_Quick
							using = Sound_WindowShow_Standard
						}
						state = {
							name = _hide
							using = Animation_FadeOut_Quick
							using = Sound_WindowHide_Standard
						}
						icon = {
							texture = "gfx/interface/icons/combat/Targeted.dds"
							size = { 50 25 }
							parentanchor = center
							alwaystransparent = yes
							shaderfile = "gfx/FX/POD_shaders/POD_shaders_with_inputs.shader"
							effectname = "PODHeartblood"
							spriteborder_left   = 1.0  # heart rate / flow speed
							spriteborder_top    = 3.0  # vessel scale (zoom)
							spriteborder_right  = 1.0  # contraction strength
							spriteborder_bottom = 0.75  # radial edge falloff
							modify_texture = { color = { 0.18 0.01 0.02 } } # venous (dark)
							modify_texture = { color = { 0.75 0.04 0.06 } } # arterial (bright)
						}
					}
					# Click-to-target: same pod_combat_select_target wiring as
					# the slot cards' body underlay (this chip's slot story =
					# scope:target_slot); the SGUI's IsValid keeps KO'd slots
					# and off-turn clicks disabled. Hidden on the PC's own
					# chip (cannot target self), which keeps the PC portrait's
					# normal hover. Declared last so it sits on top of the
					# portrait's own click (character window), which strip
					# chips intentionally trade for targeting.
					button = {
						visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_pc_value'), '(CFixedPoint)0')]"
						size = { 100% 100% }
						onclick = "[GetScriptedGui('pod_combat_select_target').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_slot', Scope.Story.MakeScope).End)]"
						enabled = "[GetScriptedGui('pod_combat_select_target').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_slot', Scope.Story.MakeScope).End)]"
						tooltip = "pod_combat_strip_set_target_tt"
					}
				}
			}
		}
	}

	type pod_combat_datamodel_slot = vbox {
		# Outer visibility - hide entirely if the slot has no participant.
		# The slot story always exists during combat (created at init),
		# but unfilled slots have no slot_char.
		visible = "[Scope.Var('slot_char').IsSet]"

		minimumsize = { 240 -1 }
		maximumsize = { 240 -1 }
		background = { using = Background_Area }

		widget = {
			# Datacontext = the participant character. This makes
			# [Character.GetFirstNameNoTooltip] and friends work for the
			# inner widget body.
			datacontext = "[Scope.Var('slot_char').GetCharacter]"
			size = { 240 90 }
			# Card-body click-to-target underlay. First child = bottom of the
			# z-order: the portrait (character window), morale bar, and
			# wound boxes keep their own hover/click, while clicks on the
			# rest of the card body fall through here and set the target.
			# Hidden on the PC's own card (cannot target self).
			button = {
				visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_pc_value'), '(CFixedPoint)0')]"
				size = { 100% 100% }
				onclick = "[GetScriptedGui('pod_combat_select_target').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_slot', Scope.Story.MakeScope).End)]"
				enabled = "[GetScriptedGui('pod_combat_select_target').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_slot', Scope.Story.MakeScope).End)]"
				tooltip = "pod_combat_select_target_tooltip"
			}
			hbox = {
				margin = { 3 2 }
				# Opinion badge suppressed; see the initiative-chip portrait.
				portrait_shoulders = {
					size = {90 90}
					blockoverride "opinion_box" {}
					blockoverride "coa" {}
					blockoverride "status_icons" {}
					blockoverride "portrait_size" {size = {90 100} }
					# Targeted badge - icon centered in a strip across the
					# top of the portrait (gfx/interface/icons/combat/Targeted.dds)
					widget = {
						visible = "[And(EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_pc_value'), '(CFixedPoint)0'), And(EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_alive_value'), '(CFixedPoint)1'), EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pc_target_value'), Scope.ScriptValue('pod_combat_slot_ordinal_value'))))]"
						size = { 100% 17 }
						alwaystransparent = yes
						state = {
							name = _show
							using = Animation_FadeIn_Quick
							using = Sound_WindowShow_Standard
							using = Window_Position_MainTab
						}

						state = {
							name = _hide
							using = Animation_FadeOut_Quick
							using = Sound_WindowHide_Standard
							using = Window_Position_MainTab_Hide
						}
						icon = {
							texture = "gfx/interface/icons/combat/Targeted.dds"
							size = { 50 25 }
							parentanchor = center
							alwaystransparent = yes
							shaderfile = "gfx/FX/POD_shaders/POD_shaders_with_inputs.shader"
							effectname = "PODHeartblood"
							spriteborder_left   = 1.0  # heart rate / flow speed
							spriteborder_top    = 3.0  # vessel scale (zoom)
							spriteborder_right  = 1.0  # contraction strength
							spriteborder_bottom = 0.75  # radial edge falloff
							modify_texture = { color = { 0.18 0.01 0.02 } } # venous (dark)
							modify_texture = { color = { 0.75 0.04 0.06 } } # arterial (bright)
						}
					}
				}
				vbox = {
					margin_left = 4
					spacing = 1
					# Character name - wrapped in an expanding hbox + trailing
					# `expand = {}` so the name pins to the vbox's left edge
					# alongside the Health Track / Morale labels below.
					# `align = left|nobaseline` left-aligns the text within
					# the 150px text_single bounds (was `center|nobaseline`);
					# the wrap then keeps the whole widget against the vbox's
					# left edge instead of letting the vbox auto-center it
					# under the wider wound-box row.
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = {
							raw_text = "[Character.GetFirstNameNoTooltip]"
							default_format = "#bold"
							align = left|nobaseline
							autoresize = no
							size = { 150 10 }
						}
						expand = {}
					}
					# "Health Track:" label - wrapped in an expanding
					# hbox with a trailing `expand = {}` so the label
					# hugs the vbox's left edge instead of auto-centering
					# under the widest sibling (the 10-box wound row
					# below). The hbox stretches to the vbox's full
					# width; the label sits at its left, the expand
					# spacer absorbs the rest.
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = {
							raw_text = "[Concept('POD_health_track','#E;bold Health#!')]"
							default_format = "#weak"
						}
						expand = {}
					}
					# Wound boxes - 10 fixed boxes, each gated on max_hp/total/agg.
					# Same expanding-hbox + trailing-expand pattern as the
					# label above so the box row pins to the left edge of
					# the vbox.
					hbox = {
						layoutpolicy_horizontal = expanding
						flowcontainer = {
							direction = horizontal
							spacing = 0
							ignoreinvisible = yes
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.Var('slot_mirror_maxhp').GetValue, '(CFixedPoint)1')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_total').GetValue)]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.Var('slot_mirror_total').GetValue)]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.Var('slot_mirror_maxhp').GetValue, '(CFixedPoint)2')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)2', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)2', Scope.Var('slot_mirror_total').GetValue)]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)2', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)2', Scope.Var('slot_mirror_total').GetValue)]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.Var('slot_mirror_maxhp').GetValue, '(CFixedPoint)3')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)3', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)3', Scope.Var('slot_mirror_total').GetValue)]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)3', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)3', Scope.Var('slot_mirror_total').GetValue)]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.Var('slot_mirror_maxhp').GetValue, '(CFixedPoint)4')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)4', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)4', Scope.Var('slot_mirror_total').GetValue)]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)4', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)4', Scope.Var('slot_mirror_total').GetValue)]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.Var('slot_mirror_maxhp').GetValue, '(CFixedPoint)5')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)5', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)5', Scope.Var('slot_mirror_total').GetValue)]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)5', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)5', Scope.Var('slot_mirror_total').GetValue)]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.Var('slot_mirror_maxhp').GetValue, '(CFixedPoint)6')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)6', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)6', Scope.Var('slot_mirror_total').GetValue)]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)6', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)6', Scope.Var('slot_mirror_total').GetValue)]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.Var('slot_mirror_maxhp').GetValue, '(CFixedPoint)7')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)7', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)7', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)7', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)7', Scope.Var('slot_mirror_total').GetValue)]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)7', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)7', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)7', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)7', Scope.Var('slot_mirror_total').GetValue)]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.Var('slot_mirror_maxhp').GetValue, '(CFixedPoint)8')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)8', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)8', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)8', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)8', Scope.Var('slot_mirror_total').GetValue)]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)8', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)8', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)8', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)8', Scope.Var('slot_mirror_total').GetValue)]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.Var('slot_mirror_maxhp').GetValue, '(CFixedPoint)9')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)9', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)9', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)9', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)9', Scope.Var('slot_mirror_total').GetValue)]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)9', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)9', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)9', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)9', Scope.Var('slot_mirror_total').GetValue)]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.Var('slot_mirror_maxhp').GetValue, '(CFixedPoint)10')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)10', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)10', Scope.Var('slot_mirror_total').GetValue)]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', Scope.Var('slot_mirror_agg').GetValue)]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)10', Scope.Var('slot_mirror_agg').GetValue), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', Scope.Var('slot_mirror_total').GetValue))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)10', Scope.Var('slot_mirror_total').GetValue)]" }
						}
						}
						expand = {}
					}
					# "Morale" label - same expanding-hbox + trailing-expand
					# pattern as the Health Track label above.
					hbox = {
						layoutpolicy_horizontal = expanding
						text_single = {
							raw_text = "[Concept('pod_combat_morale','#E;bold Morale#!')]"
							default_format = "#weak"
						}
						expand = {}
					}
					# Morale progress bar - wrapped so it left-aligns
					# under the Morale label.
					hbox = {
						layoutpolicy_horizontal = expanding
						progressbar_standard = {
							size = { 140 10 }
							value = "[Scope.ScriptValue('pod_combat_slot_morale_pct')]"
						# Per-slot morale tooltip reads `Scope.Var('slot_morale')`
						# directly off the slot story scope provided by the row's
						# datamodel. See `pod_combat_slot_morale_tt` in
						# pod_combat_static_l_english.yml.
						tooltip = "pod_combat_slot_morale_tt"
					}
					expand = {}
				}
				}
			}

			# Dead-slot overlay - semi-transparent black tint that
			# covers the portrait + name + Health Track + Morale bar
			# block (the upper 240×90 of the slot card) when this
			# combatant is knocked out. Sits INSIDE the portrait
			# widget, which has a hard-coded `size = { 240 90 }`,
			# so the icon's `size = { 100% 100% }` resolves to a
			# fixed 240×90 - no layout-cycle risk that the earlier
			# whole-card overlay attempt triggered (where a
			# full-card overlay inside the auto-sized outer vbox
			# crashed CK3 trying to size itself against its own
			# child).
			#
			# Renders ON TOP of the portrait + stats hbox because
			# it's declared after the hbox: CK3 draws regular
			# child widgets in document order, last-on-top. The
			# "KNOCKED OUT" label declared after this tint rides
			# above the darkening by the same rule, so the dim
			# plus the centered label read as a single "this
			# combatant is down" signal.
			#
			# `alwaystransparent = yes` keeps the overlay from
			# intercepting hover events for the underlying portrait
			# tooltips.
			icon = {
				visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_alive_value'), '(CFixedPoint)0')]"
				size = { 100% 100% }
				texture = "gfx/interface/colors/white.dds"
				color = { 0 0 0 0.55 }
				alwaystransparent = yes
			}
			# Same alive == 0 gate as the tint (sibling, so the tint's
			# own visible doesn't gate it). The `size = { 100% 100% }`
			# + `align = center|nobaseline` recipe centers the label
			# in the dimmed 240x90 box.
			text_single = {
				visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_alive_value'), '(CFixedPoint)0')]"
				size = { 100% 100% }
				autoresize = no
				align = center|nobaseline
				raw_text = "#bold KNOCKED OUT#!"
				alwaystransparent = yes
			}
		}
		# Stats block - prowess / hit / soak summary line + tooltip.
		# The full breakdown tooltip is a scoped variant of
		# pod_combat_slot_stats_tooltip - see pod_combat_datamodel_slot_stats_tooltip.
		# Hidden once the slot is down (stats are meaningless for a KO'd
		# combatant); collapses in the card vbox, so a downed card is just
		# the dimmed portrait block.
		# Also a click-to-target surface, layered like the portrait
		# widget above: a wrapper holds the select-target underlay
		# button as first child (bottom of the z-order), with the stat
		# rows and stance icons as later siblings. The icons must not
		# be button children - enabled (IsValid) is false on the PC
		# card and off the player's turn, and a disabled button
		# desaturates its children (the icons rendered black and
		# white). As topmost siblings they keep their own tooltips and
		# colors; row hover still falls through to the underlay for
		# the stats tooltip and targeting click (IsValid rejects
		# self-targeting, so the PC card just gets an inert underlay -
		# no is_pc gate). The resizeparent vbox sizes the wrapper, the
		# underlay tracks it at 100%, and the vbox's pinned 240 width
		# keeps the rows' expand spacers working.
		widget = {
			visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_alive_value'), '(CFixedPoint)1')]"
			button = {
				size = { 100% 100% }
				onclick = "[GetScriptedGui('pod_combat_select_target').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_slot', Scope.Story.MakeScope).End)]"
				enabled = "[GetScriptedGui('pod_combat_select_target').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_slot', Scope.Story.MakeScope).End)]"
				tooltipwidget = {
					pod_combat_datamodel_slot_stats_tooltip = {}
				}
			}
			vbox = {
				resizeparent = yes
				minimumsize = { 240 -1 }
				maximumsize = { 240 -1 }
				spacing = 0
				# Prowess / Hit / Soak stats - split into three text_singles
				# separated by `expand = {}` spacers so the three stats
				# distribute evenly across the card: Prowess pins to the
				# left, Soak pins to the right, Hit centers between them.
				# `margin = { 10 1 }` gives an 10px gap from the card's edges
				# so the text doesn't kiss the side bars / frame.
				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 0 }
					text_single = {
						raw_text = "[Concept('prowess','#E Prowess#!')]: [Scope.ScriptValue('pod_combat_slot_prowess_value')|0]"
						default_format = "#weak"
					}
					expand = {}
					# Hit cell. Every slot renders the SIGNED net tier
					# modifier ("+20%" green / "-10%" red / " - " muted) via
					# PODCombatSlotHitDisplay - uniform across PC and NPC
					# slots so each card's "Hit:" line means the same thing.
					# The absolute PC-vs-current-target percentage lives in
					# the combat window's top-row "Target / Hit" readout
					# instead of on the slot 0 card.
					text_single = {
						raw_text = "[Concept('pod_combat_hit_chance','#E Hit#!')]: [GuiScope.SetRoot(Scope.Story.MakeScope).Custom('PODCombatSlotHitDisplay')]"
						default_format = "#weak"
					}
					expand = {}
					text_single = {
						raw_text = "[Concept('soak_damage','#E Soak#!')]: [Scope.ScriptValue('pod_combat_slot_soak_value')|0]%"
						default_format = "#weak"
					}
				}
				# Init + Turn rank - Init pins left, Turn pins right via the
				# expand spacer between them. `margin = { 10 1 }` matches the
				# Prowess/Hit/Soak line above so both stat rows share the
				# same edge gap and read as a paired block. slot_turn_order
				# is stamped on each alive slot story by
				# pod_combat_calc_turn_orders_effect at the end of
				# pod_combat_calculate_initiative_effect (called once per
				# round). Reading it as a stored slot var avoids needing
				# per-slot turn_order SVs that compare against all other
				# slots - the slot story can't reach the host's other slot
				# pointers from its own scope.
				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 1 }
					text_single = {
						raw_text = "[Concept('pod_combat_initiative','#E Init#!')]:[Scope.ScriptValue('pod_combat_slot_initiative_value')|0]"
						default_format = "#weak"
					}
					expand = {}
					text_single = {
						raw_text = "[Concept('pod_combat_turn_order','#E Turn#!')]:[Scope.Var('slot_turn_order').GetValue|0]"
						default_format = "#weak"
					}
				}
				# Focus-Target Readout: names whoever this AI combatant is going
				# after, from its persistent cross-turn focus mark. Hidden
				# for the PC and any AI with no mark yet (pre-first-turn or 
				# mind-controlled). raw_text still evaluates while hidden, so the
				# render routes through PODCombatSlotFocusTarget's guarded branch.
				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 1 }
					visible = "[Scope.Var('slot_char').GetCharacter.MakeScope.Var('pod_combat_ai_focus_char').IsSet]"
					text_single = {
						raw_text = "[GuiScope.SetRoot(Scope.Story.MakeScope).Custom('PODCombatSlotFocusTarget')]"
						default_format = "#weak"
						# Cap the line so a long target name can't widen the 240px card: grow to
						# fit, then ellipsize (same intent as the autoresize=no name field above).
						autoresize = yes
						max_width = 210
						elide = right
					}
					expand = {}
				}
			}
			# Stance / status icons - guard / dodge / stealth / retaliation /
			# DoT / daze / control flag indicators, an 18x18 row (19 px
			# stride) along the card bottom. Later siblings of the underlay
			# button, never its children: topmost wins hover, so each icon
			# keeps its own tooltip and never inherits the button's
			# disabled-state desaturation.
			icon = {
				visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_guarding_value'), '(CFixedPoint)0')]"
				texture = "gfx/interface/icons/combat/guard.dds"
				size = { 18 18 }
				position = { 56 26 }
				tooltip = "pod_combat_status_guard_tt"
			}
			icon = {
				visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_dodging_value'), '(CFixedPoint)0')]"
				texture = "gfx/interface/icons/combat/dodge.dds"
				size = { 18 18 }
				position = { 75 26 }
				tooltip = "pod_combat_status_dodge_tt"
			}
			icon = {
				visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_stealthed_value'), '(CFixedPoint)0')]"
				texture = "gfx/interface/icons/combat/stealth.dds"
				size = { 18 18 }
				position = { 94 26 }
				tooltip = "pod_combat_status_stealth_tt"
			}
			icon = {
				visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_has_retaliation_value'), '(CFixedPoint)0')]"
				texture = "gfx/interface/icons/combat/retaliation.dds"
				size = { 18 18 }
				position = { 113 26 }
				tooltip = "pod_combat_status_retaliation_tt"
			}
			icon = {
				visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_has_dot_value'), '(CFixedPoint)0')]"
				texture = "gfx/interface/icons/combat/DoT.dds"
				size = { 18 18 }
				position = { 132 26 }
				tooltip = "pod_combat_status_dot_tt"
			}
			icon = {
				visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_dazed_value'), '(CFixedPoint)0')]"
				texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
				size = { 18 18 }
				position = { 151 26 }
				tooltip = "pod_combat_status_daze_tt"
			}
			icon = {
				visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_controlled_value'), '(CFixedPoint)0')]"
				texture = "gfx/interface/icons/traits/dominate.dds"
				size = { 18 18 }
				position = { 170 26 }
				tooltip = "pod_combat_status_control_tt"
			}
		}
		# Team frame: gold = player, red = enemy, the combat log's
		# side-bar palette (matches the initiative-chip frames).
		# Background_Frame (vanilla shared/backgrounds.gui) is the
		# hollow 9-slice mask_frame.dds, so it scales to the card
		# without stretching and leaves the actor-highlight fill
		# visible through its open center; declared after the
		# highlight so the colored edge draws on top of that fill.
		background = {
			visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_enemy_value'), '(CFixedPoint)0')]"
			using = Background_Frame
			color = { 0.83 0.72 0.47 1 }
			margin = { 6 6 }
		}
		background = {
			visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_enemy_value'), '(CFixedPoint)0')]"
			using = Background_Area_Border_Solid
			color = { 0.83 0.72 0.47 1 }
			margin = { 0 0 }
		}
		background = {
			visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_enemy_value'), '(CFixedPoint)1')]"
			using = Background_Frame
			color = { 1 0.2 0.2 1 }
			margin = { 5 5 }
		}
		background = {
			visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_enemy_value'), '(CFixedPoint)1')]"
			using = Background_Area_Border_Solid
			color = { 1 0.1 0.1 1 }
			margin = { 0 0 }
		}
		# Current-actor highlight - compares this slot's ordinal
		# (pod_combat_slot_ordinal_value) against the host's
		# pod_combat_current_actor_value (both 0-9, player 0-4 / enemy 5-9).
		background = {
			visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_current_actor_value'), Scope.ScriptValue('pod_combat_slot_ordinal_value'))]"
			using = Background_Area_Dark
			margin = { 0 0 }
		}
	}


	# Combat-stats breakdown tooltip - used on each character slot's
	# stat line via the pod_combat_datamodel_slot widget's
	# tooltipwidget. Reads tier magnitudes via
	# Scope.ScriptValue('pod_combat_slot_X_mag_sv') against the
	# iterated slot story scope. Modifier lines collapse to invisible
	# when their magnitude SV returns 0, so the tooltip shows only
	# currently-active buffs/debuffs.
	type pod_combat_datamodel_slot_stats_tooltip = widget {
		alwaystransparent = no

		using = DefaultTooltipBackground
		using = GeneralTooltipSetup

		vbox = {
			resizeparent = yes
			margin = { 14 11 }
			layoutpolicy_horizontal = expanding
			spacing = 2

			text_single = {
				raw_text = "#bold;V;outline Combat Stats#!"
				fontsize = 16
				alwaystransparent = yes
			}

			spacer = { size = { 0 4 } }

			# ── HIT CHANCE ─────────────────────────────
			# Headline routed through PODCombatSlotHitDisplay so PC shows
			# the absolute hit chance and NPC slots show the signed net
			# tier modifier - same rationale as the card-line stat row,
			# see the GUI comment there. The buff/debuff breakdown
			# flowcontainer below still itemises the contributing axes
			# (round / combat × buff / debuff) for both PC and NPCs,
			# so the tooltip remains diagnostic for either side.
			text_single = {
				raw_text = "[Concept('pod_combat_hit_chance','Hit Chance')|E]: #bold [GuiScope.SetRoot(Scope.Story.MakeScope).Custom('PODCombatSlotHitDisplay')]#!"
				alwaystransparent = yes
			}
			flowcontainer = {
				margin_left = 12
				spacing = 6
				ignoreinvisible = yes

				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_hit_buff_round_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#P +[Scope.ScriptValue('pod_combat_slot_hit_buff_round_mag_sv')|0]% (round)#!"
					alwaystransparent = yes
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_hit_buff_combat_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#P +[Scope.ScriptValue('pod_combat_slot_hit_buff_combat_mag_sv')|0]% (combat)#!"
					alwaystransparent = yes
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_hit_debuff_round_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#N -[Scope.ScriptValue('pod_combat_slot_hit_debuff_round_mag_sv')|0]% (round)#!"
					alwaystransparent = yes
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_hit_debuff_combat_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#N -[Scope.ScriptValue('pod_combat_slot_hit_debuff_combat_mag_sv')|0]% (combat)#!"
					alwaystransparent = yes
				}
			}

			spacer = { size = { 0 6 } }

			# ── SOAK CHANCE ────────────────────────────
			text_single = {
				raw_text = "[Concept('soak_damage','Soak')|E]: #bold [Scope.ScriptValue('pod_combat_slot_soak_value')|0]%#!"
				alwaystransparent = yes
			}
			flowcontainer = {
				margin_left = 12
				spacing = 6
				ignoreinvisible = yes

				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_soak_buff_round_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#P +[Scope.ScriptValue('pod_combat_slot_soak_buff_round_mag_sv')|0]% (round)#!"
					alwaystransparent = yes
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_soak_buff_combat_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#P +[Scope.ScriptValue('pod_combat_slot_soak_buff_combat_mag_sv')|0]% (combat)#!"
					alwaystransparent = yes
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_soak_debuff_round_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#N -[Scope.ScriptValue('pod_combat_slot_soak_debuff_round_mag_sv')|0]% (round)#!"
					alwaystransparent = yes
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_soak_debuff_combat_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#N -[Scope.ScriptValue('pod_combat_slot_soak_debuff_combat_mag_sv')|0]% (combat)#!"
					alwaystransparent = yes
				}
			}

			spacer = { size = { 0 6 } }

			# ── INITIATIVE ─────────────────────────────
			text_single = {
				visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_alive_value'), '(CFixedPoint)1')]"
				raw_text = "[Concept('pod_combat_initiative','Initiative')|E]: #bold [Scope.ScriptValue('pod_combat_slot_initiative_value')|0]#!"
				alwaystransparent = yes
			}
		}
	}

	# The move label is rendered as two mutually-exclusive text_single
	# widgets instead of the button's own `text`: a gray copy here in the
	# base (shown when the move can't be selected now - no AP/energy,
	# wrong target, off-turn) and a category-colored copy in each derived
	# type (shown when it can). `default_format` can't be data-bound, so
	# the visible-gate swap is how the color tracks the enable state.
	# Both are alwaystransparent so clicks still reach the button.
	type button_combat_base = button_standard {
		widget = {
			size = { 100% 100% }
			alwaystransparent = yes
			using = pod_combat_button_bg
		}
		text_single = {
			visible = "[Not(GetScriptedGui('pod_combat_execute_move').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"
			size = { 100% 100% }
			autoresize = no
			align = center|nobaseline
			alwaystransparent = yes
			default_format = "#glow_color:{0.0,0.0,0.0,1.0};bold"
			text = "POD_combat_move_title_plain"
		}
	}

	# Each derived type adds only its colored label, shown when the move
	# is selectable (mutually exclusive with the base's gray copy).
	type button_combat_move_label = text_single {
		visible = "[GetScriptedGui('pod_combat_execute_move').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
		size = { 100% 100% }
		autoresize = no
		align = center|nobaseline
		alwaystransparent = yes
		text = "POD_combat_move_title_plain"
	}
	type button_combat_atk = button_combat_base {
		button_combat_move_label = { default_format = "#color_red;glow_color:{0.0,0.0,0.0,1.0};bold" }
	}
	type button_combat_def = button_combat_base {
		button_combat_move_label = { default_format = "#color_light_blue;glow_color:{0.0,0.0,0.0,1.0};bold" }
	}
	type button_combat_ctl = button_combat_base {
		button_combat_move_label = { default_format = "#color_porple;glow_color:{0.0,0.0,0.0,1.0};bold" }
	}
	type button_combat_pwr = button_combat_base {
		button_combat_move_label = { default_format = "#color_pwr_orange;glow_color:{0.0,0.0,0.0,1.0};bold" }
	}
}
