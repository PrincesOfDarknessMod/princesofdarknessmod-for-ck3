######################################
######   POD COMBAT WINDOW   ######
######################################

# Three-panel group combat layout.
# Left: Ally team (slots 0-4).  Center: Controls + log.  Right: Enemy team (slots 5-9).
# Visible when pod_combat_active is set on the player AND
# pod_combat_config_open is NOT set — the loadout editor temporarily
# hides this window while the player reconfigures their skills.

widget = {
	name = "pod_combat_window"
	visible = "[And(And(Not(IsPauseMenuShown), IsDefaultGUIMode), GetPlayer.IsValid)]"
	layer = royal_court
	size = { 100% 100% }

	window = {
		parentanchor = center
		size = { 1550 940 }
		using = Window_Background
		using = Window_Decoration

		visible = "[And(GetPlayer.MakeScope.Var('pod_combat_active').IsSet, Not(GetPlayer.MakeScope.Var('pod_combat_config_open').IsSet))]"

		state = {
			name = _pause
			trigger_when = "[Not(IsGamePaused)]"
			on_start = "[OnPause]"
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			# Left padding (empty)
			widget = {
				minimumsize = { 30 -1 }
				maximumsize = { 30 -1 }
			}

			# Content column: top buffer, header, middle buffer, three-panel hbox, bottom buffer
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				# Top buffer row (20px empty space above the Combat header)
				widget = {
					minimumsize = { -1 20 }
					maximumsize = { -1 20 }
				}

				##############################
				###### HEADER (content width)
				##############################

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text" {
						text = "pod_combat_window_title"
					}

					blockoverride "button_close" {
						onclick = "[GetScriptedGui('pod_combat_forfeit').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						tooltip = "pod_combat_forfeit_tooltip"
					}
				}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 5 5 }

			##############################
			###### LEFT PANEL: ALLIES
			##############################

				vbox = {
					minimumsize = { 280 -1 }
					maximumsize = { 280 -1 }
					layoutpolicy_vertical = expanding
					margin = { 5 2 }

					text_single = {
						raw_text = "#bold ALLIES#!"
						default_format = "#weak"
						align = center
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_content"
						{
							vbox = {
								margin = { 0 2 }
								# Slot widgets have no internal margin (the
								# `type X = vbox` parser rejects `margin` at
								# the type-body level); replace the per-slot
								# 2px padding with parent-level spacing.
								spacing = 4

								# Ally panel — datamodel iteration over the host's
								# pod_combat_active_slots variable list, filtered to
								# slot_index < 5 (player team: PC at slot 0, ally
								# knights at slots 1-4). Each iteration's Scope is
								# the slot story; the pod_combat_datamodel_slot
								# widget reads everything off Scope.Var('slot_X')
								# and Scope.ScriptValue('pod_combat_slot_X').
								#
								# Container shape notes (CK3 GUI parser quirks):
								#   - vbox not flowcontainer — flowcontainers reject
								#     vbox/hbox direct children, and pod_combat_datamodel_slot
								#     is itself `type X = vbox`.
								#   - item = { single_widget } — items must contain
								#     EXACTLY ONE child widget and zero direct
								#     properties (no `visible` / `tooltip` etc. on the
								#     item itself). Per-item visibility filter goes on
								#     the widget invocation.
								#
								# pod_combat_active_slots is filled-only by construction
								# (the slot story is created lazily on first
								# pod_combat_set_slot_char_effect call), so the widget's
								# `datacontext = "[Scope.Var('slot_char').GetCharacter]"`
								# never evaluates against an unset slot_char (CK3 reports
								# that as "Scoped object of type 'character' is not
								# valid"). The list is populated in
								# pod_combat_set_slot_char_effect and cleared in
								# pod_combat_clear_slot_stories_effect.
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4

									datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_active_slots')]"
									item = {
										pod_combat_datamodel_slot = {
											# Ally-team filter only — slot_char-set
											# already implied by being in active_slots.
											visible = "[LessThan_CFixedPoint(Scope.Var('slot_index').GetValue, '(CFixedPoint)5')]"
										}
									}
								}


								expand = {}
							}
						}
					}
			}

			##############################
			###### CENTER PANEL
			##############################

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding


				# Round counter + Action Points on a single line
				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 4 }
					spacing = 24
					text_single = {
						raw_text = "[Localize('pod_combat_round')]"
						default_format = "#bold"
					}
					text_single = {
						raw_text = "[Localize('pod_combat_ap_label')]: [GetPlayer.MakeScope.ScriptValue('pod_combat_current_ap_value')|0] / [GetPlayer.MakeScope.ScriptValue('pod_combat_base_ap')|0]"
						default_format = "#bold"
					}
					expand = {}
				}

				##############################
				###### MOVE BUTTONS
				##############################
				# Datamodel-driven, grouped by combat_category. Four hbox
				# rows (ATK / DEF / CTL / PWR) share the same
				# pod_combat_loadout datamodel but filter per-button via
				# the category-check SGUIs (pod_combat_is_atk_move, etc.).
				# Matches the loadout-editor column grouping so players
				# see the same structure during setup and play.
				#
				# All four rows render unconditionally so the
				# ATK / DEF / CTL / PWR label column stays in a fixed
				# vertical line regardless of which categories the actor
				# has moves equipped in. An empty category row shows just
				# the bold label with empty space to its right — which
				# also doubles as a visual cue that the category slot is
				# unused. The label widget is fixed at 33 high so the row
				# keeps its baseline even when the flowcontainer renders
				# zero buttons, and the per-row spacing in the outer vbox
				# (`spacing = 2`) keeps the four labels evenly stacked.

				vbox = {
					layoutpolicy_horizontal = expanding
					margin = { 5 0 }
					spacing = 2

					# ── ATK row ──
					# `expand = {}` after the flowcontainer absorbs the
					# leftover horizontal space inside the expanding hbox
					# so the label + buttons stay left-anchored. Without
					# it the row content centers within the hbox and the
					# label drifts right whenever the actor has fewer
					# moves equipped (a 1-button row's center is much
					# closer to the hbox center than a 4-button row's).
					# Same trailing-expand pattern the round/AP header
					# above and the combat-log header below use.
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 0 1 }

						widget = {
							size = { 42 33 }
							text_single = {
								parentanchor = vcenter
								raw_text = "#bold ATK#!"
								default_format = "#weak"
								margin_left = 2
							}
						}

						flowcontainer = {
							direction = horizontal
							spacing = 4
							ignoreinvisible = yes

							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								button_standard = {
									size = { 204 33 }
									visible = "[GetScriptedGui('pod_combat_is_atk_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									tooltipwidget = { pod_fancy_combat_move_tooltip = {} }

									onclick = "[GetScriptedGui('pod_combat_execute_move').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									enabled = "[GetScriptedGui('pod_combat_execute_move').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

									text = "POD_combat_move_title"
									tooltip = "POD_combat_move_tooltip"
								}
							}
						}

						expand = {}
					}

					# ── DEF row ──
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 0 1 }

						widget = {
							size = { 42 33 }
							text_single = {
								parentanchor = vcenter
								raw_text = "#bold DEF#!"
								default_format = "#weak"
								margin_left = 2
							}
						}

						flowcontainer = {
							direction = horizontal
							spacing = 4
							ignoreinvisible = yes

							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								button_standard = {
									size = { 204 33 }
									visible = "[GetScriptedGui('pod_combat_is_def_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									tooltipwidget = { pod_fancy_combat_move_tooltip = {} }

									onclick = "[GetScriptedGui('pod_combat_execute_move').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									enabled = "[GetScriptedGui('pod_combat_execute_move').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

									text = "POD_combat_move_title"
									tooltip = "POD_combat_move_tooltip"
								}
							}
						}

						expand = {}
					}

					# ── CTL row ──
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 0 1 }

						widget = {
							size = { 42 33 }
							text_single = {
								parentanchor = vcenter
								raw_text = "#bold CTL#!"
								default_format = "#weak"
								margin_left = 2
							}
						}

						flowcontainer = {
							direction = horizontal
							spacing = 4
							ignoreinvisible = yes

							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								button_standard = {
									size = { 204 33 }
									visible = "[GetScriptedGui('pod_combat_is_ctl_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									tooltipwidget = { pod_fancy_combat_move_tooltip = {} }

									onclick = "[GetScriptedGui('pod_combat_execute_move').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									enabled = "[GetScriptedGui('pod_combat_execute_move').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

									text = "POD_combat_move_title"
									tooltip = "POD_combat_move_tooltip"
								}
							}
						}

						expand = {}
					}

					# ── PWR row ──
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 0 1 }

						widget = {
							size = { 42 33 }
							text_single = {
								parentanchor = vcenter
								raw_text = "#bold PWR#!"
								default_format = "#weak"
								margin_left = 2
							}
						}

						flowcontainer = {
							direction = horizontal
							spacing = 4
							ignoreinvisible = yes

							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								button_standard = {
									size = { 204 33 }
									visible = "[GetScriptedGui('pod_combat_is_pwr_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									tooltipwidget = { pod_fancy_combat_move_tooltip = {} }

									onclick = "[GetScriptedGui('pod_combat_execute_move').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									enabled = "[GetScriptedGui('pod_combat_execute_move').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

									text = "POD_combat_move_title"
									tooltip = "POD_combat_move_tooltip"
								}
							}
						}

						expand = {}
					}

					expand = {}
				}


				##############################
				###### ACTION BUTTONS
				##############################

				hbox = {
					margin = { 10 4 }
					spacing = 20

					button_standard = {
						visible = "[Not(GetPlayer.MakeScope.Var('pod_combat_is_over').IsSet)]"
						size = { 170 33 }
						text = "pod_combat_end_turn"
						onclick = "[GetScriptedGui('pod_combat_end_turn').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						enabled = "[GetScriptedGui('pod_combat_end_turn').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						tooltip = "pod_combat_end_turn_desc"
					}

					button_standard = {
						visible = "[Not(GetPlayer.MakeScope.Var('pod_combat_is_over').IsSet)]"
						size = { 170 33 }
						text = "pod_combat_auto_resolve"
						onclick = "[GetScriptedGui('pod_combat_auto_resolve').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						enabled = "[GetScriptedGui('pod_combat_auto_resolve').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						tooltip = "pod_combat_auto_resolve_desc"
					}

					button_standard = {
						visible = "[GetPlayer.MakeScope.Var('pod_combat_is_over').IsSet]"
						size = { 170 33 }
						text = "pod_combat_end_combat"
						onclick = "[GetScriptedGui('pod_combat_end_combat').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						enabled = "[GetScriptedGui('pod_combat_end_combat').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}

					button_standard = {
						size = { 80 33 }
						text = "pod_combat_help_button"
						onclick = "[GetScriptedGui('pod_combat_help').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						enabled = "[GetScriptedGui('pod_combat_help').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						tooltip = "pod_combat_help_tooltip"
					}
				}

				##############################
				###### COMBAT LOG
				##############################

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 10 5 }

					background = {
						using = Background_Area
					}

					# Column headers: all left-aligned so each column's data
					# rows visually line up at the same column-start position.
					# Markers (AoE / agg / damage-source) trail their column's
					# primary text inline; left-alignment keeps the primary
					# text anchored regardless of which markers are present.
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 5 2 }
						widget = {
							size = { 180 20 }
							text_single = { text = "pod_combat_log_header_actor" parentanchor = left|vcenter }
						}
						widget = {
							size = { 200 20 }
							text_single = { text = "pod_combat_log_header_action" parentanchor = center|vcenter }
						}
						widget = {
							size = { 180 20 }
							text_single = { text = "pod_combat_log_header_target" parentanchor = center|vcenter }
						}
						widget = {
							size = { 160 20 }
							text_single = { text = "pod_combat_log_header_result" parentanchor = center|vcenter }
						}
						expand = {}
					}

					divider_light = {
						layoutpolicy_horizontal = expanding
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content"
						{
							vbox = {
								layoutpolicy_horizontal = expanding
								margin = { 0 2 }

						# ── Combat Log Entries (datamodel iteration) ──
						# Each entry in pod_combat_log is a POD_combat_log_entry
						# story_cycle holding the snapshot needed to render one
						# log row. Move-static properties (emitted capability
						# flags — requires_hit_roll / checks_guard /
						# checks_stance / checks_spirit_gate — plus
						# damage_source, damage_type, targeting, soak/hit buff
						# vars, etc.) are pulled from the entry's stored move
						# ref via Scope.Var('move').Story.MakeScope — no
						# per-entry duplication of the move's data on the log
						# entry itself. 
						#
						# Container choice: vbox (not flowcontainer). flowcontainer
						# disallows hbox/vbox as direct children of `item`, while
						# vbox accepts them and naturally stacks vertically.
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 0
							ignoreinvisible = yes
						
							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_log')]"
						
							item = {
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 0
						
									hbox = {
										layoutpolicy_horizontal = expanding
										margin = { 5 2 }
						
										# Attacker name (left-aligned to match header)
										widget = {
											size = { 180 20 }
											text_single = {
												parentanchor = left|vcenter
												visible = "[Scope.Var('actor').IsSet]"
												raw_text = "#bold [Scope.Var('actor').GetCharacter.GetFirstNameNoTooltip]#!"
											}
										}
						
										# Action: move name. Hovering pops the same fancy
										# tooltip widget the loadout buttons use. Background
										# image from the move's decision picture, bold title,
										# rich stat block. The widget normally reads
										# Scope.Story.MakeScope to find the move story, but in
										# the combat log datamodel Scope IS the LOG ENTRY (and
										# the move ref lives on entry.var:move). We override the
										# three blocks the widget exposes, bg_texture,
										# text_title, text_desc, to drill through
										# Scope.Var('move').Story.MakeScope instead.
										#
										# tooltipwidget binds to a widget definition, not a loc
										# key, so CK3's resolver can't intercept "Guard"
										# mid-render and swap the tooltip target to the
										# pod_combat_guard concept card — must be a widget binding
										# (NOT `#TOOLTIP:<key>` syntax) to preserve the link.
										widget = {
											size = { 200 20 }
											tooltipwidget = {
												pod_fancy_combat_move_tooltip = {
													blockoverride "bg_texture" {
														texture = "[Scope.Var('move').Story.MakeScope.Var('decision').DecisionType.GetPicture(GetPlayer.Self)]"
													}
													blockoverride "text_title" {
														text = "POD_combat_log_move_title"
													}
													blockoverride "text_desc" {
														text = "POD_combat_log_move_tooltip"
													}
												}
											}

											hbox = {
												parentanchor = left|vcenter
												spacing = 4
												ignoreinvisible = yes

												text_single = {
													visible = "[Scope.Var('move').IsSet]"
													raw_text = "[Scope.Var('move').Story.MakeScope.Var('decision').DecisionType.GetTitleForPlayer]"
												}
											}
										}
						
										# Target column: dispatched through PODCombatLogTargetText
										# customizable_loc which inspects the entry's stored move
										# (var:move) and renders one of:
										#   * "AoE Enemies" / "AoE Allies" for team_enemy / team_ally
										#   * "Self" for self-targeted moves
										#   * the target's first name for single-target moves
										#   * an dash placeholder for system entries
										# The dispatcher only needs `entry` saved. It chains into
										# the move via var:move = { var:targeting = ... } internally.
										widget = {
											size = { 180 20 }
											hbox = {
												parentanchor = left|vcenter
												spacing = 4
												ignoreinvisible = yes

												text_single = {
													raw_text = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('entry', Scope.Story.MakeScope).Custom('PODCombatLogTargetText')]"
												}
											}
										}
						
										# Result column: composed from a stack of customizable_loc
										# invocations, each rendered as its own text_single in this
										# hbox so the engine can pass the saved-scope chain it
										# needs. Saved scopes don't propagate through nested
										# [GetPlayer.Custom('SubName')] calls in 1.18.x — every
										# customizable_loc call has to be top-level from the GUI.
										#
										# Each rider's `visible` is gated on whether its move
										# variable is actually present, so empty riders fully
										# collapse via ignoreinvisible — without that gate, the
										# customizable_loc returns an empty string but the
										# text_single still reserves baseline width, leaving big
										# gaps between the result text and any visible rider.
										# rcode-based rider suppression (heal-on-soak, etc.) is
										# handled inside the customizable_loc's triggers — the
										# rider returns blank for those cases, and the empty
										# text_single still renders, but only in the rare case
										# where the move HAS the variable but rcode suppresses
										# it. Most rows never reach that path.
										#
										# Render order (left to right):
										#   1. main result text — rolled amount + label + AoE
										#      intercept (per-target fail labels are suppressed
										#      on team_enemy / team_ally moves). Ends with a
										#      wound-box icon (superficial / aggravated) conveying
										#      both the damage classification AND standing in for
										#      the "HP" label word.
										#   2. damage-source icon — fire / silver / holy / etc.
										#      Comes AFTER the amount + wound-box so the row reads
										#      "-5 ▢ 🔥" — the damage and classification are the
										#      headline, the elemental flavor is a trailing tag.
										#      Loc values prefix a leading space so the icon stays
										#      detached from the wound-box that ends the result text.
										#   3. heal rider — ", +X ▢" for life-drain / combined
										#   4. morale-damage rider — ", -X Morale"
										#   5. morale-heal rider — ", +X Morale"
										#   6. buff / debuff / status rider — most prominent
										#      stance / tier buff / utility flag the move applied
										widget = {
											size = { 160 20 }
											hbox = {
												parentanchor = left|vcenter
												spacing = 0
												ignoreinvisible = yes

												# 1. Main result text (always present; handles AoE intercept).
												# Ends in the wound-box icon when damage is dealt.
												text_single = {
													visible = "[Scope.Var('move').IsSet]"
													raw_text = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('entry', Scope.Story.MakeScope).AddScope('move', Scope.Var('move').Story.MakeScope).AddScope('rcode', MakeScopeFlag(Scope.Story.MakeScope.Var('result').GetFlagKey)).Custom('PODCombatLogResultText')]"
												}
												# 2. Damage-source icon — only shown when the move has an
												# elemental damage_source (fire / cold / lightning / sun /
												# silver / gold / holy / balefire). Utility / heal-only
												# moves and plain physical / supernatural / mental damage
												# moves all collapse — the icon is for elemental flavor,
												# not pipeline shape, since pipeline shape already reads
												# off the move name.
												#
												# Additionally suppressed on attack-failure outcomes
												# (guard_blocked / missed / dodged / stealthed) via
												# pod_combat_log_show_damage_source_value — the elemental
												# flavor adds noise on those rows since no damage of any
												# element actually landed. Damage / heal / utility rows
												# still surface the icon when present.
												text_single = {
													visible = "[And(And(Scope.Var('move').IsSet, Scope.Var('move').Story.MakeScope.Var('damage_source').IsSet), GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_log_show_damage_source_value'), '(CFixedPoint)0'))]"
													raw_text = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('move', Scope.Var('move').Story.MakeScope).Custom('PODCombatDamageSourceMarker')]"
												}
												# 3. Heal rider — gated on entry.heal_amount (the actual
												# rolled heal amount captured by push_log). Collapses for
												# moves that didn't trigger a heal AND for capped heals
												# (target near full HP — heal_amount stays 0).
												text_single = {
													visible = "[Scope.Var('heal_amount').IsSet]"
													raw_text = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('entry', Scope.Story.MakeScope).AddScope('move', Scope.Var('move').Story.MakeScope).AddScope('rcode', MakeScopeFlag(Scope.Story.MakeScope.Var('result').GetFlagKey)).Custom('PODCombatLogHealRider')]"
												}
												# 4. Morale-damage rider — gated on entry.morale_damage_amount
												text_single = {
													visible = "[Scope.Var('morale_damage_amount').IsSet]"
													raw_text = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('entry', Scope.Story.MakeScope).AddScope('move', Scope.Var('move').Story.MakeScope).AddScope('rcode', MakeScopeFlag(Scope.Story.MakeScope.Var('result').GetFlagKey)).Custom('PODCombatLogMoraleDamageRider')]"
												}
												# 5. Morale-heal rider — gated on entry.morale_heal_amount
												text_single = {
													visible = "[Scope.Var('morale_heal_amount').IsSet]"
													raw_text = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('entry', Scope.Story.MakeScope).AddScope('move', Scope.Var('move').Story.MakeScope).AddScope('rcode', MakeScopeFlag(Scope.Story.MakeScope.Var('result').GetFlagKey)).Custom('PODCombatLogMoraleHealRider')]"
												}
												# 6. Buff / debuff / status rider — collapse only if NONE of
												# the buff/stance/utility vars are present on the move.
												text_single = {
													visible = "[And(Scope.Var('move').IsSet, Or(Or(Or(Scope.Var('move').Story.MakeScope.Var('set_guard').IsSet, Scope.Var('move').Story.MakeScope.Var('dodge').IsSet), Or(Scope.Var('move').Story.MakeScope.Var('stealth').IsSet, Scope.Var('move').Story.MakeScope.Var('remove_guard').IsSet)), Or(Or(Or(Scope.Var('move').Story.MakeScope.Var('soak_buff_round_tier').IsSet, Scope.Var('move').Story.MakeScope.Var('soak_buff_combat_tier').IsSet), Or(Scope.Var('move').Story.MakeScope.Var('soak_debuff_round_tier').IsSet, Scope.Var('move').Story.MakeScope.Var('soak_debuff_combat_tier').IsSet)), Or(Or(Or(Scope.Var('move').Story.MakeScope.Var('hit_buff_round_tier').IsSet, Scope.Var('move').Story.MakeScope.Var('hit_buff_combat_tier').IsSet), Or(Scope.Var('move').Story.MakeScope.Var('hit_debuff_round_tier').IsSet, Scope.Var('move').Story.MakeScope.Var('hit_debuff_combat_tier').IsSet)), Or(Or(Scope.Var('move').Story.MakeScope.Var('ap_gain').IsSet, Scope.Var('move').Story.MakeScope.Var('ap_drain').IsSet), Or(Or(Scope.Var('move').Story.MakeScope.Var('retaliate_if_hit').IsSet, Scope.Var('move').Story.MakeScope.Var('retaliate_if_missed').IsSet), Scope.Var('move').Story.MakeScope.Var('initiative_debuff').IsSet))))))]"
													raw_text = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('move', Scope.Var('move').Story.MakeScope).Custom('PODCombatLogBuffRider')]"
												}
												# Move-less fallback (system entries with no move captured)
												text_single = {
													visible = "[Not(Scope.Var('move').IsSet)]"
													raw_text = "#weak —#!"
												}
											}
										}
						
										expand = {}
									}
						
									divider_light = {
										layoutpolicy_horizontal = expanding
									}
								}
							}
						}
						
						# Empty state placeholder — shows when the log list is empty.
						text_single = {
							visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('pod_combat_log'))]"
							text = "pod_combat_log_empty"
							margin = { 5 4 }
						}
							}
						}
					}
				}
			}

			##############################
			###### RIGHT PANEL: ENEMIES
			##############################

				vbox = {
					minimumsize = { 280 -1 }
					maximumsize = { 280 -1 }
					layoutpolicy_vertical = expanding
					margin = { 5 2 }

					text_single = {
						raw_text = "#bold ENEMIES#!"
						default_format = "#weak"
						align = center
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_content"
						{
							vbox = {
								margin = { 0 2 }

								# Enemy panel — same datamodel iteration pattern as the
								# ally panel above, filtered to slot_index >= 5
								# (enemy team: opponent leader at slot 5, enemy
								# knights at slots 6-9). See the ally panel block's
								# comments for container-shape and filter rationale.
								vbox = {
									layoutpolicy_horizontal = expanding
									spacing = 4

									datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_active_slots')]"
									item = {
										pod_combat_datamodel_slot = {
											# Enemy-team filter — slot indices 5-9.
											# Ally slots (0-4) are rendered by the
											# left panel's iteration.
											visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.Var('slot_index').GetValue, '(CFixedPoint)5')]"
										}
									}
								}

								expand = {}
							}
						}
					}
				}
			}

				# Bottom buffer row (20px empty space)
				widget = {
					minimumsize = { -1 20 }
					maximumsize = { -1 20 }
				}
			}

			# Right padding (empty)
			widget = {
				minimumsize = { 30 -1 }
				maximumsize = { 30 -1 }
			}
		}
	}
}

types PODCombatTypes {

	# One Health Track wound box. Three icon variants (aggravated /
	# superficial / empty) layered with three transparent concept-link
	# text overlays so hovering pops the matching damage-class card.
	# Defaults assume box index 1 with current Scope = the slot story
	# (read via the slot-agnostic pod_combat_slot_*_sv family); box
	# invocations override all 7 visibility blocks to swap in their
	# own CFixedPoint box index. The pattern mirrors PoD's own
	# wound-track rendering in the character sheet.
	type pod_combat_wound_box = widget {
		block "outer_visible" {
			visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_max_hp_value'), '(CFixedPoint)1')]"
		}
		size = { 12 12 }
		icon = {
			block "agg_icon_visible" {
				visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]"
			}
			texture = "gfx/interface/icons/text_icons/aggravateddamagehealthtrack.dds"
			size = { 12 12 }
		}
		icon = {
			block "super_icon_visible" {
				visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]"
			}
			texture = "gfx/interface/icons/text_icons/normaldamagehealthtrack.dds"
			size = { 12 12 }
		}
		icon = {
			block "empty_icon_visible" {
				visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]"
			}
			texture = "gfx/interface/icons/text_icons/emptyhealthtrack.dds"
			size = { 12 12 }
		}
		text_single = {
			block "agg_text_visible" {
				visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]"
			}
			raw_text = "[Concept('POD_aggravated_damage','     ')]"
			default_format = "#!"
			fontsize = 12
			fontsize_min = 11
			parentanchor = center
		}
		text_single = {
			block "super_text_visible" {
				visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]"
			}
			raw_text = "[Concept('POD_superficial_damage','     ')]"
			default_format = "#!"
			fontsize = 12
			fontsize_min = 11
			parentanchor = center
		}
		text_single = {
			block "empty_text_visible" {
				visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]"
			}
			raw_text = "[Concept('POD_health_track','     ')]"
			default_format = "#!"
			fontsize = 12
			fontsize_min = 11
			parentanchor = center
		}
	}

	# Single character slot card. Reads everything off the iterated
	# scope (the slot story) — no per-slot SVs, no blockoverrides.
	# Used inside the ally / enemy panels' datamodel iterations over
	# the host's pod_combat_active_slots variable list — each
	# iteration's Scope is the iterated slot story, so:
	#   - Scope.Var('slot_X').GetValue|0  reads a numeric slot var
	#   - Scope.Var('slot_char').GetCharacter  yields the participant
	#   - Scope.ScriptValue('pod_combat_slot_X')  evaluates
	#     a slot-story-scoped SV (defined in pod_combat_values.txt)
	#
	# Target button calls pod_combat_select_target (unified SGUI taking
	# scope:target_slot, defined in pod_combat_control_guis.txt).
	# Hidden when slot_index = 0 since the PC can't target self.
	#
	# Initiative line shows both the rolled Init value and the Turn
	# rank within the round. Turn rank is stored as slot_turn_order
	# on each slot story (stamped by pod_combat_calc_turn_orders_effect
	# at the end of initiative calc) — read directly from there
	# rather than computed live, since computing rank requires
	# comparing against all 9 other slots which a slot-story-scoped
	# SV can't reach without a host back-reference.
	type pod_combat_datamodel_slot = vbox {
		# Outer visibility — hide entirely if the slot has no participant.
		# The slot story always exists during combat (created at init),
		# but unfilled slots have no slot_char.
		visible = "[Scope.Var('slot_char').IsSet]"

		minimumsize = { 240 -1 }
		maximumsize = { 240 -1 }
		background = { using = Background_Area }

		widget = {
			# Datacontext = the participant character. This makes
			# [Character.GetFirstNameNoTooltip] and friends work for the
			# inner widget body.
			datacontext = "[Scope.Var('slot_char').GetCharacter]"
			size = { 240 90 }
			hbox = {
				margin = { 3 2 }
				portrait_head_small = {}
				vbox = {
					margin_left = 4
					spacing = 1
					text_single = {
						raw_text = "[Character.GetFirstNameNoTooltip]"
						default_format = "#bold"
						align = center|nobaseline
						autoresize = no
						size = { 150 10 }
					}
					text_single = {
						raw_text = "[Concept('POD_health_track','#E;bold Health Track:#!')]"
						default_format = "#weak"
					}
					# Wound boxes — 10 fixed boxes, each gated on max_hp/total/agg.
					flowcontainer = {
						direction = horizontal
						spacing = 0
						ignoreinvisible = yes
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_max_hp_value'), '(CFixedPoint)1')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_max_hp_value'), '(CFixedPoint)2')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)2', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)2', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)2', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)2', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_max_hp_value'), '(CFixedPoint)3')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)3', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)3', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)3', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)3', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_max_hp_value'), '(CFixedPoint)4')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)4', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)4', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)4', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)4', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_max_hp_value'), '(CFixedPoint)5')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)5', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)5', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)5', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)5', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_max_hp_value'), '(CFixedPoint)6')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)6', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)6', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)6', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)6', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_max_hp_value'), '(CFixedPoint)7')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)7', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)7', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)7', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)7', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)7', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)7', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)7', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)7', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_max_hp_value'), '(CFixedPoint)8')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)8', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)8', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)8', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)8', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)8', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)8', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)8', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)8', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_max_hp_value'), '(CFixedPoint)9')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)9', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)9', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)9', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)9', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)9', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)9', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)9', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)9', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
						}
						pod_combat_wound_box = {
							blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_max_hp_value'), '(CFixedPoint)10')]" }
							blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)10', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)10', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
							blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', Scope.ScriptValue('pod_combat_slot_agg_damage_sv'))]" }
							blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)10', Scope.ScriptValue('pod_combat_slot_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', Scope.ScriptValue('pod_combat_slot_total_damage_sv')))]" }
							blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)10', Scope.ScriptValue('pod_combat_slot_total_damage_sv'))]" }
						}
					}
					text_single = {
						raw_text = "[Concept('pod_combat_morale','#E;bold Morale#!')]"
						default_format = "#weak"
					}
					progressbar_standard = {
						size = { 140 10 }
						value = "[Scope.ScriptValue('pod_combat_slot_morale_pct')]"
						# Per-slot morale tooltip reads `Scope.Var('slot_morale')`
						# directly off the slot story scope provided by the row's
						# datamodel. See `pod_combat_slot_morale_tt` in
						# pod_combat_static_l_english.yml.
						tooltip = "pod_combat_slot_morale_tt"
					}
				}
			}
			# Stance icons — guard / dodge / stealth / retaliation flag
			# indicators. Stack of four 17×17 icons in the right-edge
			# column (x=214) with 19 px stride, fitting four icons inside
			# the 90 px card. 
			icon = {
				visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_guarding_value'), '(CFixedPoint)0')]"
				texture = "gfx/interface/icons/combat/guard.dds"
				size = { 17 17 }
				position = { 214 2 }
				tooltip = "pod_combat_status_guard_tt"
			}
			icon = {
				visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_dodging_value'), '(CFixedPoint)0')]"
				texture = "gfx/interface/icons/combat/dodge.dds"
				size = { 17 17 }
				position = { 214 21 }
				tooltip = "pod_combat_status_dodge_tt"
			}
			icon = {
				visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_is_stealthed_value'), '(CFixedPoint)0')]"
				texture = "gfx/interface/icons/combat/stealth.dds"
				size = { 17 17 }
				position = { 214 40 }
				tooltip = "pod_combat_status_stealth_tt"
			}
			icon = {
				visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_has_retaliation_value'), '(CFixedPoint)0')]"
				texture = "gfx/interface/icons/combat/retaliation.dds"
				size = { 17 17 }
				position = { 214 57 }
				tooltip = "pod_combat_status_retaliation_tt"
			}
		}
		# Knocked-out / TARGETED / Target button.
		# Slot 0 (the PC) gets a bare KO indicator only — they can't
		# target self. Other slots get the click-to-target button with
		# its three text states (KNOCKED OUT / TARGETED / Target).
		hbox = {
			visible = "[And(EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_alive_value'), '(CFixedPoint)0'), EqualTo_CFixedPoint(Scope.Var('slot_index').GetValue, '(CFixedPoint)0'))]"
			minimumsize = { 230 22 }
			text_single = {
				raw_text = "#bold KNOCKED OUT#!"
			}
		}
		button_standard = {
			visible = "[GreaterThan_CFixedPoint(Scope.Var('slot_index').GetValue, '(CFixedPoint)0')]"
			size = { 230 22 }
			margin = { 5 0 }
			# Calls the unified pod_combat_select_target SGUI (defined
			# in pod_combat_control_guis.txt) — passes the iterated slot
			# story as scope:target_slot. The SGUI reads slot_index off
			# that scope and writes pc_target / selected_target / loads
			# the workspace target accordingly. Same enabled/onclick
			# pattern as PoD's pod_combat_loadout_toggle SGUI invocation
			# in the loadout window.
			onclick = "[GetScriptedGui('pod_combat_select_target').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_slot', Scope.Story.MakeScope).End)]"
			enabled = "[GetScriptedGui('pod_combat_select_target').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target_slot', Scope.Story.MakeScope).End)]"
			tooltip = "pod_combat_select_target_tooltip"
			text_single = {
				visible = "[EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_alive_value'), '(CFixedPoint)0')]"
				raw_text = "#bold KNOCKED OUT#!"
				parentanchor = center
			}
			text_single = {
				visible = "[And(EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_alive_value'), '(CFixedPoint)1'), EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pc_target_value'), Scope.Var('slot_index').GetValue))]"
				raw_text = "#bold TARGETED#!"
				parentanchor = center
			}
			text_single = {
				visible = "[And(EqualTo_CFixedPoint(Scope.ScriptValue('pod_combat_slot_alive_value'), '(CFixedPoint)1'), Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pc_target_value'), Scope.Var('slot_index').GetValue)))]"
				raw_text = "Target"
				parentanchor = center
			}
		}
		# Stats block — prowess / hit / soak summary line + tooltip.
		# The full breakdown tooltip is a scoped variant of
		# pod_combat_slot_stats_tooltip — see pod_combat_datamodel_slot_stats_tooltip.
		vbox = {
			layoutpolicy_horizontal = expanding
			spacing = 0
			tooltipwidget = {
				pod_combat_datamodel_slot_stats_tooltip = {}
			}
			text_single = {
				margin = { 4 1 }
				raw_text = "[Concept('prowess','#E Prowess#!')]: [Scope.ScriptValue('pod_combat_slot_prowess_value')|0]  [Concept('pod_combat_hit_chance','#E Hit#!')]: [Scope.ScriptValue('pod_combat_slot_hit_chance_value')|0]%  [Concept('soak_damage','#E Soak#!')]: [Scope.ScriptValue('pod_combat_slot_soak_value')|0]%"
				default_format = "#weak"
			}
			text_single = {
				margin = { 4 1 }
				visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_initiative_value'), '(CFixedPoint)0')]"
				# Init + Turn rank. slot_turn_order is stamped on each
				# alive slot story by pod_combat_calc_turn_orders_effect
				# at the end of pod_combat_calculate_initiative_effect
				# (called once per round). Reading it as a stored slot
				# var avoids needing per-slot turn_order SVs that compare
				# against all other slots — the slot story can't reach
				# the host's other slot pointers from its own scope.
				raw_text = "[Concept('pod_combat_initiative','#E Init#!')]:[Scope.ScriptValue('pod_combat_slot_initiative_value')|0] [Concept('pod_combat_turn_order','#E Turn#!')]:[Scope.Var('slot_turn_order').GetValue|0]"
				default_format = "#weak"
			}
		}
		# Current-actor highlight — compares this slot's slot_index
		# against the host's pod_combat_current_actor_value.
		background = {
			visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_current_actor_value'), Scope.Var('slot_index').GetValue)]"
			using = Background_Area_Dark
			margin = { 0 0 }
		}
	}


	# Combat-stats breakdown tooltip — used on each character slot's
	# stat line via the pod_combat_datamodel_slot widget's
	# tooltipwidget. Reads tier magnitudes via
	# Scope.ScriptValue('pod_combat_slot_X_mag_sv') against the
	# iterated slot story scope. Modifier lines collapse to invisible
	# when their magnitude SV returns 0, so the tooltip shows only
	# currently-active buffs/debuffs.
	type pod_combat_datamodel_slot_stats_tooltip = widget {
		alwaystransparent = no

		using = DefaultTooltipBackground
		using = GeneralTooltipSetup

		vbox = {
			resizeparent = yes
			margin = { 14 11 }
			layoutpolicy_horizontal = expanding
			spacing = 2

			text_single = {
				raw_text = "#bold;V;outline Combat Stats#!"
				fontsize = 16
				alwaystransparent = yes
			}

			spacer = { size = { 0 4 } }

			# ── HIT CHANCE ─────────────────────────────
			text_single = {
				raw_text = "[Concept('pod_combat_hit_chance','Hit Chance')|E]: #bold [Scope.ScriptValue('pod_combat_slot_hit_chance_value')|0]%#!"
				alwaystransparent = yes
			}
			flowcontainer = {
				margin_left = 12
				spacing = 6
				ignoreinvisible = yes

				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_hit_buff_round_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#P +[Scope.ScriptValue('pod_combat_slot_hit_buff_round_mag_sv')|0]% (round)#!"
					alwaystransparent = yes
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_hit_buff_combat_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#P +[Scope.ScriptValue('pod_combat_slot_hit_buff_combat_mag_sv')|0]% (combat)#!"
					alwaystransparent = yes
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_hit_debuff_round_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#N -[Scope.ScriptValue('pod_combat_slot_hit_debuff_round_mag_sv')|0]% (round)#!"
					alwaystransparent = yes
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_hit_debuff_combat_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#N -[Scope.ScriptValue('pod_combat_slot_hit_debuff_combat_mag_sv')|0]% (combat)#!"
					alwaystransparent = yes
				}
			}

			spacer = { size = { 0 6 } }

			# ── SOAK CHANCE ────────────────────────────
			text_single = {
				raw_text = "[Concept('soak_damage','Soak')|E]: #bold [Scope.ScriptValue('pod_combat_slot_soak_value')|0]%#!"
				alwaystransparent = yes
			}
			flowcontainer = {
				margin_left = 12
				spacing = 6
				ignoreinvisible = yes

				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_soak_buff_round_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#P +[Scope.ScriptValue('pod_combat_slot_soak_buff_round_mag_sv')|0]% (round)#!"
					alwaystransparent = yes
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_soak_buff_combat_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#P +[Scope.ScriptValue('pod_combat_slot_soak_buff_combat_mag_sv')|0]% (combat)#!"
					alwaystransparent = yes
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_soak_debuff_round_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#N -[Scope.ScriptValue('pod_combat_slot_soak_debuff_round_mag_sv')|0]% (round)#!"
					alwaystransparent = yes
				}
				text_single = {
					visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_soak_debuff_combat_mag_sv'), '(CFixedPoint)0')]"
					raw_text = "#N -[Scope.ScriptValue('pod_combat_slot_soak_debuff_combat_mag_sv')|0]% (combat)#!"
					alwaystransparent = yes
				}
			}

			spacer = { size = { 0 6 } }

			# ── INITIATIVE ─────────────────────────────
			text_single = {
				visible = "[GreaterThan_CFixedPoint(Scope.ScriptValue('pod_combat_slot_initiative_value'), '(CFixedPoint)0')]"
				raw_text = "[Concept('pod_combat_initiative','Initiative')|E]: #bold [Scope.ScriptValue('pod_combat_slot_initiative_value')|0]#!"
				alwaystransparent = yes
			}
		}
	}
}
