													default_format = "#weak"
												}
												progressbar_standard = {
													size = { 150 10 }
													value = "[GetPlayer.MakeScope.ScriptValue('pod_combat_c0_morale_pct')]"
												}
											}
										}
										icon = {
											visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_is_guarding_value'), '(CFixedPoint)0')]"
											texture = "gfx/interface/icon/combat/guard.dds"
											size = { 24 24 }
											position = { 210 2 }
											tooltip = "pod_combat_status_guard_tt"
										}
										icon = {
