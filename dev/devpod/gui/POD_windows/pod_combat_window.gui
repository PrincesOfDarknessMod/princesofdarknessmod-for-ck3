											tooltip = "pod_combat_select_target_tooltip"
											text_single = {
												visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c7_alive_value'), '(CFixedPoint)0')]"
												raw_text = "#bold KNOCKED OUT#!"
