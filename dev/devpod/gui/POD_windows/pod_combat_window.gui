######################################
######   POD COMBAT WINDOW   ######
######################################

# Three-panel group combat layout.
# Left: Ally team (slots 0-4).  Center: Controls + log.  Right: Enemy team (slots 5-9).
# Visible when pod_combat_active variable is set on the player.

widget = {
	name = "pod_combat_window"
	visible = "[And(And(Not(IsPauseMenuShown), IsDefaultGUIMode), GetPlayer.IsValid)]"
	layer = royal_court
	size = { 100% 100% }

	window = {
		parentanchor = center
		size = { 1410 940 }
		using = Window_Background
		using = Window_Decoration

		visible = "[And(GetPlayer.MakeScope.Var('pod_combat_active').IsSet, Not(GetPlayer.MakeScope.Var('pod_combat_config_open').IsSet))]"

		state = {
			name = _pause
			trigger_when = "[Not(IsGamePaused)]"
			on_start = "[OnPause]"
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			# Left padding (empty)
			widget = {
				minimumsize = { 30 -1 }
				maximumsize = { 30 -1 }
			}

			# Content column: top buffer, header, middle buffer, three-panel hbox, bottom buffer
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				# Top buffer row (20px empty space above the Combat header)
				widget = {
					minimumsize = { -1 20 }
					maximumsize = { -1 20 }
				}

				##############################
				###### HEADER (content width)
				##############################

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text" {
						text = "pod_combat_window_title"
					}

					blockoverride "button_close" {
						onclick = "[GetScriptedGui('pod_combat_forfeit').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						tooltip = "pod_combat_forfeit_tooltip"
					}
				}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin = { 5 5 }

			##############################
			###### LEFT PANEL: ALLIES
			##############################

				vbox = {
					minimumsize = { 280 -1 }
					maximumsize = { 280 -1 }
					layoutpolicy_vertical = expanding
					margin = { 5 2 }

					text_single = {
						raw_text = "#bold ALLIES#!"
						default_format = "#weak"
						align = center
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						blockoverride "scrollbox_content"
						{
							vbox = {
								margin = { 0 2 }
								# Slot widgets have no internal margin (the
								# `type X = vbox` parser rejects `margin` at
								# the type-body level); replace the per-slot
								# 2px padding with parent-level spacing.
								spacing = 4

								# Slot 0 (the player) — uses the pod_combat_slot widget defaults
								# directly (all c0_ SV references match the widget definition).
								pod_combat_slot = {}

								# Slot 1
								pod_combat_slot = {
									blockoverride "outer_visible" {
										visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_max_hp_value'), '(CFixedPoint)0')]"
									}
									blockoverride "char_datacontext" {
										visible = "[GetPlayer.MakeScope.Var('pod_combat_c1_char').IsSet]"
										datacontext = "[GetPlayer.MakeScope.Var('pod_combat_c1_char').GetCharacter]"
									}
									blockoverride "wound_boxes" {
										flowcontainer = {
											direction = horizontal
											spacing = 0
											ignoreinvisible = yes
											pod_combat_wound_box = {
												blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_max_hp_value'), '(CFixedPoint)1')]" }
												blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
												blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)1', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
											}
											pod_combat_wound_box = {
												blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_max_hp_value'), '(CFixedPoint)2')]" }
												blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
												blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)2', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
											}
											pod_combat_wound_box = {
												blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_max_hp_value'), '(CFixedPoint)3')]" }
												blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
												blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)3', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
											}
											pod_combat_wound_box = {
												blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_max_hp_value'), '(CFixedPoint)4')]" }
												blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)4', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)4', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
												blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)4', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)4', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)4', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
											}
											pod_combat_wound_box = {
												blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_max_hp_value'), '(CFixedPoint)5')]" }
												blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
												blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)5', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
											}
											pod_combat_wound_box = {
												blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_max_hp_value'), '(CFixedPoint)6')]" }
												blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)6', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)6', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
												blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)6', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)6', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)6', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
											}
											pod_combat_wound_box = {
												blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_max_hp_value'), '(CFixedPoint)7')]" }
												blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)7', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)7', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)7', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)7', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
												blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)7', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)7', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)7', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)7', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
											}
											pod_combat_wound_box = {
												blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_max_hp_value'), '(CFixedPoint)8')]" }
												blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)8', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)8', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)8', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)8', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
												blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)8', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)8', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)8', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)8', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
											}
											pod_combat_wound_box = {
												blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_max_hp_value'), '(CFixedPoint)9')]" }
												blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)9', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)9', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)9', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)9', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
												blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)9', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)9', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)9', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)9', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
											}
											pod_combat_wound_box = {
												blockoverride "outer_visible"      { visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_max_hp_value'), '(CFixedPoint)10')]" }
												blockoverride "agg_icon_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_icon_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_icon_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
												blockoverride "agg_text_visible"   { visible = "[LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv'))]" }
												blockoverride "super_text_visible" { visible = "[And(GreaterThan_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_agg_damage_sv')), LessThanOrEqualTo_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv')))]" }
												blockoverride "empty_text_visible" { visible = "[GreaterThan_CFixedPoint('(CFixedPoint)10', GetPlayer.MakeScope.ScriptValue('pod_combat_c1_total_damage_sv'))]" }
											}
										}
									}
									blockoverride "morale_progressbar" {
										progressbar_standard = {
											size = { 150 10 }
											value = "[GetPlayer.MakeScope.ScriptValue('pod_combat_c1_morale_pct')]"
											tooltip = "pod_combat_morale_tooltip_c1"
										}
									}
									blockoverride "knocked_out" {
										button_standard = {
											size = { 240 22 }
											margin = { 5 0 }
											visible = "[GetPlayer.MakeScope.Var('pod_combat_c1_char').IsSet]"
											onclick = "[GetScriptedGui('pod_combat_select_target_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											enabled = "[GetScriptedGui('pod_combat_select_target_1').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
											tooltip = "pod_combat_select_target_tooltip"
											text_single = {
												visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_alive_value'), '(CFixedPoint)0')]"
												raw_text = "#bold KNOCKED OUT#!"
												parentanchor = center
											}
											text_single = {
												visible = "[And(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_alive_value'), '(CFixedPoint)1'), EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pc_target_value'), '(CFixedPoint)1'))]"
												raw_text = "#bold TARGETED#!"
												parentanchor = center
											}
											text_single = {
												visible = "[And(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_alive_value'), '(CFixedPoint)1'), Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pc_target_value'), '(CFixedPoint)1')))]"
												raw_text = "Target"
												parentanchor = center
											}
										}
									}
									blockoverride "stance_icons" {
										icon = {
											visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_is_guarding_value'), '(CFixedPoint)0')]"
											texture = "gfx/interface/icons/combat/guard.dds"
											size = { 24 24 }
											position = { 210 2 }
											tooltip = "pod_combat_status_guard_tt"
										}
										icon = {
											visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_is_dodging_value'), '(CFixedPoint)0')]"
											texture = "gfx/interface/icons/combat/dodge.dds"
											size = { 24 24 }
											position = { 210 28 }
											tooltip = "pod_combat_status_dodge_tt"
										}
										icon = {
											visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_is_stealthed_value'), '(CFixedPoint)0')]"
											texture = "gfx/interface/icons/combat/stealth.dds"
											size = { 24 24 }
											position = { 210 54 }
											tooltip = "pod_combat_status_stealth_tt"
										}
									}
									blockoverride "stats_block" {
										vbox = {
											layoutpolicy_horizontal = expanding
											spacing = 0
											tooltipwidget = {
												pod_combat_slot_stats_tooltip = {
											blockoverride "hit_main" {
												raw_text = "[Concept('pod_combat_hit_chance','Hit Chance')|E]: #bold [GetPlayer.MakeScope.ScriptValue('pod_combat_c1_hit_chance_value')|0]%#!"
											}
											blockoverride "hit_buff_round" {
												visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_hit_buff_round_mag_sv'), '(CFixedPoint)0')]"
												raw_text = "#P +[GetPlayer.MakeScope.ScriptValue('pod_combat_c1_hit_buff_round_mag_sv')|0]% (round)#!"
											}
											blockoverride "hit_buff_combat" {
												visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_hit_buff_combat_mag_sv'), '(CFixedPoint)0')]"
												raw_text = "#P +[GetPlayer.MakeScope.ScriptValue('pod_combat_c1_hit_buff_combat_mag_sv')|0]% (combat)#!"
											}
											blockoverride "hit_debuff_round" {
												visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_hit_debuff_round_mag_sv'), '(CFixedPoint)0')]"
												raw_text = "#N -[GetPlayer.MakeScope.ScriptValue('pod_combat_c1_hit_debuff_round_mag_sv')|0]% (round)#!"
											}
											blockoverride "hit_debuff_combat" {
												visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c1_hit_debuff_combat_mag_sv'), '(CFixedPoint)0')]"
