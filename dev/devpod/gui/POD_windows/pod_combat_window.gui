				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 10 5 }

					background = {
						using = Background_Area
					}

					# Column headers
					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 5 2 }
						widget = {
							size = { 180 20 }
							text_single = { raw_text = "#bold Attacker#!" align = center }
						}
						widget = {
							size = { 200 20 }
							text_single = { raw_text = "#bold Action#!" }
						}
						widget = {
							size = { 180 20 }
							text_single = { raw_text = "#bold Target#!" align = center }
						}
						widget = {
							size = { 160 20 }
							text_single = { raw_text = "#bold Result#!" }
						}
						expand = {}
					}

