												visible = "[And(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c3_alive_value'), '(CFixedPoint)1'), EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pc_target_value'), '(CFixedPoint)3'))]"
												raw_text = "#bold TARGETED#!"
												parentanchor = center
											}
											text_single = {
												visible = "[And(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c3_alive_value'), '(CFixedPoint)1'), Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pc_target_value'), '(CFixedPoint)3')))]"
