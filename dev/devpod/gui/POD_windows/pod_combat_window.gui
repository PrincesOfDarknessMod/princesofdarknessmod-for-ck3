			block "stance_icons" {
				icon = {
					visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_is_guarding_value'), '(CFixedPoint)0')]"
					texture = "gfx/interface/icons/combat/guard.dds"
					size = { 24 24 }
					position = { 210 2 }
					tooltip = "pod_combat_status_guard_tt"
				}
				icon = {
					visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_is_dodging_value'), '(CFixedPoint)0')]"
					texture = "gfx/interface/icons/combat/dodge.dds"
					size = { 24 24 }
					position = { 210 28 }
					tooltip = "pod_combat_status_dodge_tt"
				}
				icon = {
					visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_is_stealthed_value'), '(CFixedPoint)0')]"
					texture = "gfx/interface/icons/combat/stealth.dds"
					size = { 24 24 }
					position = { 210 54 }
					tooltip = "pod_combat_status_stealth_tt"
				}
			}
		}
		# Default: bare KO indicator (only renders when alive_value=0).
		# This is right for slot 0 — the PC can't target themselves so
		# they don't need a Target button. Slots 1-9 override this
		# block with a `button_standard` whose three nested text_singles
		# swap between "KNOCKED OUT" / "TARGETED" / "Target" based on
		# alive_value and pc_target_value, routed through the per-slot
		# `pod_combat_select_target_{N}` SGUI.
		block "knocked_out" {
			hbox = {
				visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_alive_value'), '(CFixedPoint)0')]"
				minimumsize = { 240 22 }
				text_single = {
					raw_text = "#bold KNOCKED OUT#!"
				}
			}
		}
		block "stats_block" {
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 0
				tooltipwidget = {
					pod_combat_slot_stats_tooltip = {}
				}
				text_single = {
					margin = { 4 1 }
					raw_text = "[Concept('prowess','#E Prowess#!')]: [GetPlayer.MakeScope.ScriptValue('pod_combat_c0_prowess_value')|0]  [Concept('pod_combat_hit_chance','#E Hit#!')]: [GetPlayer.MakeScope.ScriptValue('pod_combat_c0_hit_chance_value')|0]%  [Concept('soak_damage','#E Soak#!')]: [GetPlayer.MakeScope.ScriptValue('pod_combat_c0_soak_value')|0]%"
					default_format = "#weak"
				}
				text_single = {
					margin = { 4 1 }
					visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_c0_initiative_value'), '(CFixedPoint)0')]"
					raw_text = "[Concept('pod_combat_initiative','#E Init#!')]:[GetPlayer.MakeScope.ScriptValue('pod_combat_c0_initiative_value')|0] [Concept('pod_combat_turn_order','#E Turn#!')]:[GetPlayer.MakeScope.ScriptValue('pod_combat_c0_turn_order_value')|0]"
					default_format = "#weak"
				}
			}
		}
		block "current_actor_bg" {
			background = {
				visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_current_actor_value'), '(CFixedPoint)0')]"
				using = Background_Area_Dark
				margin = { -2 -2 }
			}
		}
	}
}
