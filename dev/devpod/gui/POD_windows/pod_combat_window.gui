						default_format = "#weak"
					}
					block "morale_progressbar" {
						progressbar_standard = {
							size = { 150 10 }
							value = "[GetPlayer.MakeScope.ScriptValue('pod_combat_c0_morale_pct')]"
							tooltip = "pod_combat_morale_tooltip_c0"
						}
					}
				}
