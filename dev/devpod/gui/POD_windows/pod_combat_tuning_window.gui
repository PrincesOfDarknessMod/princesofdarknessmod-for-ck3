# Combat tuning window - runtime balancing knobs (debug tool).
# Opened by the pod_combat_debug_tuning_interaction (sets
# global_var:pod_combat_tuning_open); each row steps a
# global_var:pod_combat_tune_* override read by the matching script
# value in pod_combat_values.txt (unset = shipped default; * marks a
# tuned knob). Stepper rows use the local pod_combat_tune_var_editor
# type below (single arrow +-1, double arrow +-5; the arrows pass
# scope:delta to one SGUI per knob in pod_combat_tuning_guis.txt -
# same shape as the umbra-adventure debug editors, with finer steps
# and a per-row tooltip). Values shown are the EFFECTIVE numbers the
# game is using right now.
#
# Each knob row carries the same `*` tuned marker, gated on its own
# override's IsSet. That gate is safe because the marker is static
# raw_text: nothing dereferences the variable while it is unset.
widget = {
	name = "pod_combat_tuning_window"
	visible = "[And(And(Not(IsPauseMenuShown), IsDefaultGUIMode), GetGlobalVariable('pod_combat_tuning_open').IsSet)]"
	# royal_court = the combat windows' layer (above the HUD, below events).
	# On the standard `middle` layer the combat panel and HUD ate clicks
	# wherever they overlapped this window. Registered after the combat
	# windows in POD_scripted_widgets.txt, so it draws (and hit-tests) above
	# them within the layer.
	layer = royal_court
	# Full-screen NON-BLOCKING wrapper (visibility gate only - plain widget
	# containers pass input through; combat/umbra windows use the same
	# shape). The sized window inside stays fully hit-testable wherever it
	# is dragged; a wrapper sized to the panel would drop input once the
	# movable window left its parent's rect.
	size = { 100% 100% }

	window = {
		parentanchor = top|left
		position = { 20 110 }
		size = { 1100 428 }
		using = Window_Background_Subwindow
		movable = yes

		vbox = {
			margin = { 14 10 }
			spacing = 4

			hbox = {
				layoutpolicy_horizontal = expanding
				text_single = {
					text = "pod_combat_tune_window_title"
				}
				expand = {}
				button_standard_small = {
					text = "pod_combat_tune_reset_all"
					tooltip = "pod_combat_tune_reset_all_tt"
					onclick = "[PlayerGuiExecute('pod_combat_tuning_reset_all')]"
				}
				button_close = {
					onclick = "[PlayerGuiExecute('pod_combat_tuning_close')]"
				}
			}

			divider_light = {
				layoutpolicy_horizontal = expanding
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 30

				# Left: AP economy / morale / loadout - live at each turn seed
				# (starting morale: next fight; loadout caps: editor-open).
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 3
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							text = "pod_combat_tune_base_ap_label"
						}
						blockoverride "row_tooltip" {
							tooltip = "pod_combat_tune_base_ap_tt"
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_base_ap')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_base_ap_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_base_ap').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							text = "pod_combat_tune_ap_regen_label"
						}
						blockoverride "row_tooltip" {
							tooltip = "pod_combat_tune_ap_regen_tt"
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_tune_ap_regen_display_value')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_ap_regen_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_ap_regen').IsSet]"
							raw_text = "#P *#!"
						}
						button_close = {
							size = { 20 20 }
							visible = "[GetGlobalVariable('pod_combat_tune_ap_regen').IsSet]"
							tooltip = "pod_combat_tune_ap_regen_clear_tt"
							onclick = "[PlayerGuiExecute('pod_combat_tune_ap_regen_clear')]"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							text = "pod_combat_tune_ap_cap_start_label"
						}
						blockoverride "row_tooltip" {
							tooltip = "pod_combat_tune_ap_cap_start_tt"
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_tune_ap_cap_start_display_value')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_ap_cap_start_edit')]" }
						text_single = {
