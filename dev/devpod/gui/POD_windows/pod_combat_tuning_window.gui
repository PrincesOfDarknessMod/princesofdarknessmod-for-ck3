						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_ap_cap_increment_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_ap_cap_increment').IsSet]"
							raw_text = "#P *#!"
						}
						button_close = {
							size = { 20 20 }
							visible = "[GetGlobalVariable('pod_combat_tune_ap_cap_increment').IsSet]"
							tooltip = "pod_combat_tune_ap_cap_increment_clear_tt"
							onclick = "[PlayerGuiExecute('pod_combat_tune_ap_cap_increment_clear')]"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							text = "pod_combat_tune_starting_morale_label"
						}
						blockoverride "row_tooltip" {
