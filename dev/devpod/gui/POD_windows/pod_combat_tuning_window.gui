# Combat tuning window - runtime balancing knobs (debug tool).
# Opened by the pod_combat_debug_tuning_interaction (sets
# global_var:pod_combat_tuning_open); each row steps a
# global_var:pod_combat_tune_* override read by the matching script
# value in pod_combat_values.txt (unset = shipped default; * marks a
# tuned knob). Stepper rows use the local pod_combat_tune_var_editor
# type below (single arrow +-1, double arrow +-5; the arrows pass
# scope:delta to one SGUI per knob in pod_combat_tuning_guis.txt -
# same shape as the umbra-adventure debug editors, with finer steps
# and a per-row tooltip). Values shown are the EFFECTIVE numbers the
# game is using right now.
#
# Each knob row carries the same `*` tuned marker, gated on its own
# override's IsSet. That gate is safe because the marker is static
# raw_text: nothing dereferences the variable while it is unset.
widget = {
	name = "pod_combat_tuning_window"
	visible = "[And(And(Not(IsPauseMenuShown), IsDefaultGUIMode), GetGlobalVariable('pod_combat_tuning_open').IsSet)]"
	# royal_court = the combat windows' layer (above the HUD, below events).
	# On the standard `middle` layer the combat panel and HUD ate clicks
	# wherever they overlapped this window. Registered after the combat
	# windows in POD_scripted_widgets.txt, so it draws (and hit-tests) above
	# them within the layer.
	layer = royal_court
	# Full-screen NON-BLOCKING wrapper (visibility gate only - plain widget
	# containers pass input through; combat/umbra windows use the same
	# shape). The sized window inside stays fully hit-testable wherever it
	# is dragged; a wrapper sized to the panel would drop input once the
	# movable window left its parent's rect.
	size = { 100% 100% }

	window = {
		parentanchor = top|left
		position = { 20 110 }
		size = { 1100 428 }
		using = Window_Background_Subwindow
		movable = yes

		vbox = {
			margin = { 14 10 }
			spacing = 4

			hbox = {
				layoutpolicy_horizontal = expanding
				text_single = {
					raw_text = "#high;bold Combat Tuning (debug)#!"
				}
				expand = {}
				button_standard_small = {
					raw_text = "Reset All"
					raw_tooltip = "Remove every tuned override - back to shipped defaults"
					onclick = "[PlayerGuiExecute('pod_combat_tuning_reset_all')]"
				}
				button_close = {
					onclick = "[PlayerGuiExecute('pod_combat_tuning_close')]"
				}
			}

			divider_light = {
				layoutpolicy_horizontal = expanding
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 30

				# Left: AP economy / morale / loadout - live at each turn seed
				# (starting morale: next fight; loadout caps: editor-open).
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 3
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Max AP cap"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Max AP per turn (the full bar). Applies from the next turn. The pip strip displays at most 6."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_base_ap')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_base_ap_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_base_ap').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "AP regen / round"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "AP regained each turn; unspent AP carries over on the slot, capped at the AP cap. Unset = full-bar refill. A combatant's first turn always starts full."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_tune_ap_regen_display_value')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_ap_regen_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_ap_regen').IsSet]"
							raw_text = "#P *#!"
						}
						button_close = {
							size = { 20 20 }
							visible = "[GetGlobalVariable('pod_combat_tune_ap_regen').IsSet]"
							raw_tooltip = "Clear: back to full-bar refill each turn"
							onclick = "[PlayerGuiExecute('pod_combat_tune_ap_regen_clear')]"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "AP cap start (rnd 1)"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Escalating cap: the AP cap in round 1. Only matters while AP cap +/round is set."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_tune_ap_cap_start_display_value')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_ap_cap_start_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_ap_cap_start').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "AP cap +/round"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Escalating cap: the AP cap grows by this each round (start + N per round) until it reaches Max AP cap. Clear = off."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_tune_ap_cap_increment_display_value')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_ap_cap_increment_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_ap_cap_increment').IsSet]"
							raw_text = "#P *#!"
						}
						button_close = {
							size = { 20 20 }
							visible = "[GetGlobalVariable('pod_combat_tune_ap_cap_increment').IsSet]"
							raw_tooltip = "Clear: no escalating cap"
							onclick = "[PlayerGuiExecute('pod_combat_tune_ap_cap_increment_clear')]"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Starting morale"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Morale every combatant enters the fight with (per-character hooks add on top; floored at 1). Takes effect next fight."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_tune_starting_morale_display_value')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_starting_morale_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_starting_morale').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Morale cap (6-box)"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Morale ceiling for a 6-box combatant (vampire, kuei-jin, risen). Every wound box above or below 6 shifts that combatant's own ceiling by 5, so this moves the whole ladder rather than setting one flat cap. Drives heals and the end-of-fight strain deficit. Live."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_max_morale_base')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_max_morale_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_max_morale').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Morale->stress mult"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Stress inflicted per point of end-of-fight morale deficit (Mental Strain, applied once at combat end)."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_morale_stress_multiplier')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_morale_stress_mult_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_morale_stress_mult').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Loadout / category"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Equip cap per category (ATK / DEF / CTL / PWR). Enforced in the loadout editor; the pip strips still draw 4. The combat window widens to fit 5+ moves per row - past 5 it can outgrow a 1920-wide screen."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_max_per_category')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_max_per_category_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_max_per_category').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Loadout total"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Total equip cap across all categories. Enforced in the loadout editor."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_max_equipped')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_max_equipped_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_max_equipped').IsSet]"
							raw_text = "#P *#!"
						}
					}
					expand = {}
				}

				# Right: initiative / hit math / tiers / stealth - live from the
				# next roll or recalc.
				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 3
					hbox = {
						layoutpolicy_horizontal = expanding
						text_label_left = {
							raw_text = "Initiative: no reroll"
							raw_tooltip = "Keep round 1's initiative order for the whole fight (mid-fight joiners still roll once when they enter). An initiative debuff folded while this is on lasts the rest of the fight."
						}
						expand = {}
						button_checkbox = {
							size = { 24 24 }
							raw_tooltip = "Keep round 1's initiative for the whole fight (mid-fight joiners still roll once)"
							onclick = "[PlayerGuiExecute('pod_combat_tune_toggle_no_reroll')]"
							checked = "[GetGlobalVariable('pod_combat_tune_init_no_reroll').IsSet]"
						}
					}
					hbox = {
						layoutpolicy_horizontal = expanding
						text_label_left = {
							raw_text = "Init: decouple prowess"
							raw_tooltip = "Use a flat baseline instead of prowess as each combatant's initiative starting line. The baseline is the Init baseline knob below (default 20). Applies from the next roll."
						}
						expand = {}
						button_checkbox = {
							size = { 24 24 }
							raw_tooltip = "Use the flat Init baseline instead of prowess as the initiative starting line"
							onclick = "[PlayerGuiExecute('pod_combat_tune_toggle_decouple_prowess')]"
							checked = "[GetGlobalVariable('pod_combat_tune_init_decouple_prowess').IsSet]"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Init baseline"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Flat initiative starting line used INSTEAD of prowess while decouple prowess is on (ignored otherwise). Applies from the next roll."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_tune_init_base_display_value')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_init_base_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_init_base').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Initiative roll max"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Random part of initiative: a roll of 1 to N added to the base (prowess, or the flat baseline if decoupled). 1 = near-deterministic (the base decides). Applies from the next roll."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_initiative_roll_max')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_init_roll_max_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_init_roll_max').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Init / speed perk"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Initiative per perk owned in the Celerity (Vampire) or Black Wind (Kuei-jin) speed tree (0 = off)."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_tune_init_celerity_bonus_display_value')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_init_celerity_bonus_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_init_celerity_bonus').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Hit chance base"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Base hit chance before the prowess difference. Applies from the next hit-chance recalc."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_hit_chance_base')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_hit_base_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_hit_base').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Hit chance min"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Lower clamp on live hit chance."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_hit_chance_min')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_hit_min_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_hit_min').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Hit chance max"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Upper clamp on live hit chance (also caps the conditional bonus hit)."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_hit_chance_max')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_hit_max_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_hit_max').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Tier small mag"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Magnitude of tier-1 buffs and debuffs (soak and hit alike). Live via the recalcs."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_tier_small_mag')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_tier_small_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_tier_small').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Tier medium mag"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Magnitude of tier-2 buffs and debuffs."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_tier_medium_mag')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_tier_medium_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_tier_medium').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Tier large mag"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Magnitude of tier-3 buffs and debuffs."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_tier_large_mag')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_tier_large_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_tier_large').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "Stealth hit bonus"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Hit-chance bonus while stealthed (consumed on the next attack). Help texts keep saying +30 until the value is promoted."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_stealth_hit_bonus')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_stealth_bonus_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_stealth_bonus').IsSet]"
							raw_text = "#P *#!"
						}
					}
					expand = {}
				}
			vbox = {
					layoutpolicy_vertical = expanding
					hbox = {
						layoutpolicy_horizontal = expanding
						text_label_left = {
							raw_text = "AI decision trace"
							raw_tooltip = "Log one line per AI move pick and per AI turn to debug.log (search 'pod_combat_trace'). Records what the AI chose and the state it chose from, plus why each turn ended. Debug only: it roughly doubles the per-action selection work while on."
						}
						expand = {}
						button_checkbox = {
							size = { 24 24 }
							raw_tooltip = "Emit the AI decision trace to debug.log (costs performance while on)"
							onclick = "[PlayerGuiExecute('pod_combat_tune_toggle_ai_trace')]"
							checked = "[GetGlobalVariable('pod_combat_tune_ai_trace').IsSet]"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "AI finish threshold"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Empty wound boxes at or below which the AI treats an enemy as finishable - drives its emergency-heal restraint. Applies immediately. Default 1."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_ai_hp_finish_threshold')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_ai_hp_finish_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_ai_hp_finish').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "AI top-band width"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "How far below the BEST-scoring move a move may score and still be considered. Lower = sharper and more predictable; 0 means the AI always takes its top-scored move (plus ties). Raise it past ~100 and the band stops doing anything. Inside the band the AI still picks proportionally by score."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_ai_band_width_value')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_ai_band_width_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_ai_band_width').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "AI kill-priority boxes"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Empty wound boxes at or below which the AI target selector triples a target's weight (focus the nearly-dead). Applies immediately. Default 2."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_ai_kill_priority_boxes')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_ai_kill_priority_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_ai_kill_priority').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "AI morale-finish threshold"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Enemy morale at or below which the AI counts that enemy as finishable by morale damage. Feeds the finishable flag, and through it the intent lottery's kill bonuses and a dying actor's restraint about healing instead of finishing. Target SELECTION is the morale kill-priority row below, not this one. Applies immediately. Default 2."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_ai_morale_finish_threshold')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_ai_mor_finish_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_ai_mor_finish').IsSet]"
							raw_text = "#P *#!"
						}
					}
					pod_combat_tune_var_editor = {
						blockoverride "label" {
							raw_text = "AI morale kill-priority"
						}
						blockoverride "row_tooltip" {
							raw_tooltip = "Enemy morale at or below which the AI target selector triples that target's weight, for an actor that can actually deal morale damage. The morale twin of kill-priority boxes. Keep it at or above the morale-finish threshold, or the AI converges on enemies it cannot finish. Applies immediately. Default 3."
						}
						blockoverride "variable" {
							raw_text = "[GetPlayer.MakeScope.ScriptValue('pod_combat_ai_morale_kill_priority')|0]"
						}
						blockoverride "datacontext_edit"   { datacontext = "[GetScriptedGui('pod_combat_tune_ai_mor_kill_edit')]" }
						text_single = {
							visible = "[GetGlobalVariable('pod_combat_tune_ai_mor_kill').IsSet]"
							raw_text = "#P *#!"
						}
					}
					expand = {}
				}
			}

			text_single = {
				raw_text = "#weak * = tuned override (persists in the save). AP / initiative / hit / tier knobs apply from the next turn or roll; starting morale from the next fight; loadout caps at the editor.#!"
			}
			expand = {}
		}
	}
}

types PODCombatTuningTypes
{
	# Local stepper row: single arrow +-1, double arrow +-5. Same shape as
	# the umbra-adventure pod_debug_var_editor (which steps +-1/+-10), but
	# balancing wants finer coarse moves, and each row carries a tooltip
	# on its label. The arrows pass the signed step to the row's SGUI as
	# scope:delta.
	type pod_combat_tune_var_editor = hbox
	{
		layoutpolicy_horizontal = expanding
		spacing = 6
		text_label_left = {
			block "label" {
				raw_text = ""
			}
			block "row_tooltip" {}
		}
		expand = {}
		hbox = {
			block "datacontext_edit" {}
			button_icon = {
				size = { 24 24 }
				texture = "gfx/interface/icons/flat_icons/select_arrow_left_double.dds"
				raw_tooltip = "-5"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('delta',MakeScopeValue('(CFixedPoint)-5')).End)]"
			}
			button_icon = {
				size = { 24 24 }
				mirror = horizontal
				texture = "gfx/interface/icons/flat_icons/select_arrow.dds"
				raw_tooltip = "-1"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('delta',MakeScopeValue('(CFixedPoint)-1')).End)]"
			}
			text_label_center = {
				min_width = 48
				block "variable" {
					raw_text = ""
				}
			}
			button_icon = {
				size = { 24 24 }
				texture = "gfx/interface/icons/flat_icons/select_arrow.dds"
				raw_tooltip = "+1"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('delta',MakeScopeValue('(CFixedPoint)1')).End)]"
			}
			button_icon = {
				size = { 24 24 }
				texture = "gfx/interface/icons/flat_icons/select_arrow_double.dds"
				raw_tooltip = "+5"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('delta',MakeScopeValue('(CFixedPoint)5')).End)]"
			}
		}
	}
}
