window = {
	name = "pod_craft_window"
	parentanchor = top|right
	layer = windows_layer
	movable = no
	
	using = Window_Size_MainTab
	
	visible = "[And(And(GetVariableSystem.HasValue('pod_sidebar', 'craft'), Not(IsRightWindowOpen)), IsSidebarVisibilityValid)]"
	
	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab

		on_start = "[GetScriptedGui('POD_crafting_minigame_crafter_selection').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('crafter',GetPlayer.MakeScope).End)]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
	}

	container = {
		name = "craft_window_tutorial_uses_this"
		widgetid = "craft_window_tutorial_uses_this"
	}

	margin_widget = {
		size = { 100% 100% }
		margin = { 0 26 }
		margin_right = 13

		widget = {
			size = { 100% 100% }

			vbox = {
				using = Window_Margins
				
				##### HEADER TEXT #####
				header_pattern = {
					layoutpolicy_horizontal = expanding

                                blockoverride "header_text"
                                {
                                        text = "POD_crafting_minigame_title"
                                }

					blockoverride "button_close"
					{
						onclick = "[GetVariableSystem.Clear('pod_sidebar')]"
						onclick = "[GetVariableSystem.Clear('craft_tab_choice')]"
					}

				}
				

				vbox = {
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding
					
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						background = {
							texture = "gfx/interface/illustrations/event_scenes/armory_night.dds"
							fittype = centercrop
							alpha = 0.6
							margin_top = 10
							margin_left = 5
							margin_right = 5
							margin_bottom = 5
							modify_texture = {
								texture = "gfx/interface/component_masks/mask_edge_3px.dds"
								spriteType = Corneredtiled
								spriteborder = { 4 4 }
								blend_mode = alphamultiply
							}

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
								blend_mode = alphamultiply
								mirror = vertical
							}
						}	
						datacontext = "[GetPlayer.MakeScope.GetVariable('craft_creator').GetCharacter]"

						margin_top = 42
						margin_bottom = 42

						text_label_center = {
							text = "POD_crafting_minigame_current_creator"
							default_format = "#low"
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							portrait_body = {

								blockoverride "status_icons" {}
								blockoverride "opinion_box" {}
								blockoverride "coa" {}
								blockoverride "dead_icon" {}

								blockoverride "portrait_button"
								{
									size = { 300 480 }
								}

								blockoverride "portrait_texture"
								{
									portrait_texture = "[Character.GetAnimatedPortrait('environment_body', 'camera_body', 'inspect_weapon', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
								}

									button_change = {
										size = { 32 32 }
										position = { 10 200 }
										onclick = "[PlayerGuiExecute('POD_reload_crafting_minigame')]"
										
									}
								
							}
							vbox = {
								layoutpolicy_horizontal = expanding
								margin_bottom = 200
								vbox = {
									spacing = 4
									background = {
										using = Background_Area
										margin = { 5 0 }
										margin_top = -40
										margin_bottom = 10
										max_height = 100
									}

									text_label_left = {
										layoutpolicy_horizontal = expanding
										text = "[Character.GetUINameNoTooltip]"
										margin_left = 5
									}

									hbox_skills_grid_character_model = {
									}
									spacer = { size = { 1 25 } }
									button_standard = {

										enabled = "[Not(GetPlayer.MakeScope.Var('crafting_minigame').IsSet)]"
										size = { -1 65 }
										
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding

										hbox = {
											margin = { 16 0 }
											margin_right = 10
											
											container = { min_width = 16 }

											text_multi = {
												layoutpolicy_vertical = expanding
												layoutpolicy_horizontal = expanding

												margin = { 8 4 }
												text = "POD_crafting_minigame_start_crafting"
												align = nobaseline
											}
										}
										onclick = "[GetScriptedGui('POD_create_crafting_minigame').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									}
								}
								
							}
							
						}
					}
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						background = {
							using = Background_Area_Solid
						}
						button_standard = {
							enabled = "[And(GetPlayer.MakeScope.Var('target_artifact').IsSet,Not(GetPlayer.MakeScope.Var('crafting_minigame').IsSet))]"
							size = { -1 65 }
							
							layoutpolicy_horizontal = expanding

							hbox = {
								margin = { 16 0 }
								margin_right = 10
								
								container = { min_width = 16 }

								text_multi = {
									layoutpolicy_vertical = expanding
									layoutpolicy_horizontal = expanding

									margin = { 8 4 }
									text = "POD_crafting_minigame_deselect_artifact"
									align = nobaseline
								}
							}
							onclick = "[GetScriptedGui('POD_crafting_minigame_deselect_artifact').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						scrollbox = {

							enabled = "[Not(GetPlayer.MakeScope.Var('crafting_minigame').IsSet)]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							blockoverride "scrollbox_margins" {
								margin = { 4 4 }
							}

							blockoverride "scrollbox_content"
							{	
								vbox = {	
									datamodel = "[GetPlayer.GetInventory.GetArtifacts]"
									ignoreinvisible = yes
									spacing = 10
										
									item = {
										widget_target_artifact = { 
											datacontext = "[Scope.Artifact]" 
										}
									}
								}

								expand = {}
							}
						}
					}
					divider_light = { layoutpolicy_horizontal = expanding }
					vbox = {
						visible = "[GetPlayer.MakeScope.Var('crafting_minigame').IsSet]"
						layoutpolicy_horizontal = expanding
						spacing = 15
						
						spacer = { min_width = 8 }
						
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 10

							text_label_center = {
								text = "POD_crafting_minigame_current_crafting"
								default_format = "#V"
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 8

								hbox = {
									
									layoutpolicy_horizontal = expanding

									button_standard = {
										size = { -1 65 }
										
										layoutpolicy_horizontal = expanding

										hbox = {
											margin = { 16 0 }
											margin_right = 10
											
											container = { min_width = 16 }

											text_single = {
												layoutpolicy_horizontal = growing
												name = "title"
												text = "POD_crafting_minigame_current_crafting_button"
												default_format = "#clickable"
												align = nobaseline
												alwaystransparent = yes
											}
										}
										onclick = "[GetScriptedGui('POD_open_crafting_minigame').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									}
									spacer = { min_width = 8 }
								}
							}

						}
						spacer = { min_width = 12 }
					}
				}
			}
		}
	}

}
