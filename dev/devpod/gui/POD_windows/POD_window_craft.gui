window = {
	name = "pod_craft_window"
	parentanchor = top|right
	layer = windows_layer
	movable = no
	
	using = Window_Size_MainTab
	
	visible = "[And(And(GetVariableSystem.HasValue('pod_sidebar', 'craft'), Not(IsRightWindowOpen)), IsSidebarVisibilityValid)]"
	
	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab

		on_start = "[GetScriptedGui('POD_crafting_minigame_crafter_selection').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('crafter',GetPlayer.MakeScope).End)]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
	}

	container = {
		name = "craft_window_tutorial_uses_this"
		widgetid = "craft_window_tutorial_uses_this"
	}

	margin_widget = {
		size = { 100% 100% }
		margin = { 0 26 }
		margin_right = 13

		widget = {
			size = { 100% 100% }

			vbox = {
				using = Window_Margins
				
				##### HEADER TEXT #####
				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text"
					{
						text = "POD_crafting_minigame_title"
					}

					blockoverride "button_close"
					{
						onclick = "[GetVariableSystem.Clear('pod_sidebar')]"
						onclick = "[GetVariableSystem.Clear('craft_tab_choice')]"
					}

				}

				vbox = {
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding
					
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						background = {
							texture = "gfx/interface/illustrations/event_scenes/armory_night.dds"
							fittype = centercrop
							alpha = 0.6
							margin_top = 10
							margin_left = 5
							margin_right = 5
							margin_bottom = 5
							modify_texture = {
								texture = "gfx/interface/component_masks/mask_edge_3px.dds"
								spriteType = Corneredtiled
								spriteborder = { 4 4 }
								blend_mode = alphamultiply
							}

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
								blend_mode = alphamultiply
								mirror = vertical
							}
						}	
						datacontext = "[GetPlayer.MakeScope.GetVariable('craft_creator').GetCharacter]"

						margin_top = 42
						margin_bottom = 42

						text_label_center = {
							text = "POD_crafting_minigame_current_creator"
							default_format = "#low"
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							portrait_body = {

								blockoverride "status_icons" {}
								blockoverride "opinion_box" {}
								blockoverride "coa" {}
								blockoverride "dead_icon" {}

								blockoverride "portrait_button"
								{
									size = { 300 480 }
								}

								blockoverride "portrait_texture"
								{
									portrait_texture = "[Character.GetAnimatedPortrait('environment_body', 'camera_body', 'inspect_weapon', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
								}

								button_change = {
									size = { 32 32 }
									position = { 10 200 }
									enabled = "[Not(GetPlayer.MakeScope.Var('crafting_minigame').IsSet)]"
									onclick = "[GetVariableSystem.Toggle('selecting_crafters')]"
								}
								
							}
							vbox = {
								layoutpolicy_horizontal = expanding
								margin_bottom = 200
								vbox = {
									spacing = 4
									background = {
										using = Background_Area
										margin = { 5 0 }
										margin_top = -40
										margin_bottom = 10
										max_height = 100
									}
									expand = {}
									text_label_left = {
										layoutpolicy_horizontal = expanding
										text = "[Character.GetUINameNoTooltip]"
										margin_left = 5
										max_width = 300
										min_width = 300
									}

									hbox_skills_grid_character_model = { }
									spacer = { size = { 1 25 } }
									button_standard = {

										enabled = "[Not(GetPlayer.MakeScope.Var('crafting_minigame').IsSet)]"
										size = { -1 65 }
										
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding

										hbox = {
											margin = { 16 0 }
											margin_right = 10
											
											container = { min_width = 16 }

											text_multi = {
												layoutpolicy_vertical = expanding
												layoutpolicy_horizontal = expanding

												#margin = { 8 4 }
												text = "POD_crafting_minigame_start_crafting"
												align = nobaseline
											}
										}
										onclick = "[GetScriptedGui('POD_open_crafting_minigame').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('creating',MakeScopeValue('(CFixedPoint)1')).End)]"
										onclick = "[GetVariableSystem.Clear('selecting_crafters')]"
									}
									expand = {}
								}
								
							}
							
						}
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						background = {
							using = Background_Area_Solid
						}
						scrollbox = {
							visible = "[Not(GetPlayer.GetInventory.IsEmpty)]"
							enabled = "[Not(GetPlayer.MakeScope.Var('crafting_minigame').IsSet)]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							blockoverride "scrollbox_margins" {
								margin = { 4 4 }
							}

							blockoverride "scrollbox_content"
							{	
								vbox = {	
									datamodel = "[GetPlayer.GetInventory.GetArtifacts]"
									ignoreinvisible = yes
									spacing = 10
										
									item = {
										widget_target_artifact = { 
											datacontext = "[Scope.Artifact]" 
										}
									}
								}

								expand = {}
							}
						}
					}

					divider_light = { layoutpolicy_horizontal = expanding }

					vbox = {
						visible = "[GetPlayer.MakeScope.Var('crafting_minigame').IsSet]"
						layoutpolicy_horizontal = expanding
						spacing = 15
						
						spacer = { min_width = 8 }
						
						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 10

							text_label_center = {
								text = "POD_crafting_minigame_current_crafting"
								default_format = "#V"
							}

							vbox = {
								layoutpolicy_horizontal = expanding
								spacing = 8

								hbox = {
									
									layoutpolicy_horizontal = expanding

									button_standard = {
										size = { -1 65 }
										
										layoutpolicy_horizontal = expanding

										hbox = {
											margin = { 16 0 }
											margin_right = 10
											
											container = { min_width = 16 }

											text_single = {
												layoutpolicy_horizontal = growing
												name = "title"
												text = "POD_crafting_minigame_current_crafting_button"
												default_format = "#clickable"
												align = nobaseline
												alwaystransparent = yes
											}
										}
										onclick = "[GetScriptedGui('POD_open_crafting_minigame').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									}
									spacer = { min_width = 8 }
								}
							}

						}
						spacer = { min_width = 12 }
					}
				}
				
			}
			
		}
		
	}
	
}
window = {
	name = "pod_craft_window_side"
	size = { 500 700 }
	parentanchor = center
	visible = "[And(GetVariableSystem.Exists('selecting_crafters'),And(And(GetVariableSystem.HasValue('pod_sidebar', 'craft'), Not(IsRightWindowOpen)), IsSidebarVisibilityValid))]"
	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab

		on_start = "[GetScriptedGui('POD_crafting_minigame_crafter_init').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}
	vbox = {
		using = Window_Background_Subwindow
		layoutpolicy_vertical = expanding
		margin = { 10 10 }
		spacing = 5

		text_single = {
			text = "POD_crafting_minigame_creators_title"
		}
		
		divider_light = {
			layoutpolicy_horizontal = expanding
		}
		
		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			blockoverride "scrollbox_margins" {
				margin = { 4 4 }
			}

			blockoverride "scrollbox_content"
			{	
				vbox = {	
					datamodel = "[GetPlayer.MakeScope.GetList('possible_crafters')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					ignoreinvisible = yes

					spacing = 12
					item = {
						widget_target_crafter = {}
					}
				}

				expand = {}
			}
		}
	}
}
types CraftingGUI {
	type widget_target_artifact = widget {
		datacontext = "[Scope.Artifact]"
		datacontext = "[GetIllustration( 'artifact_regional_pattern' )]"
		size = { 560 110 }
		using = tooltip_above

		button_standard = {
			size = { 92% 100% }

			framesize = { 252 80 }
			spriteType = Corneredtiled
			spriteborder = { 10 10 }

			icon =  {
				texture = "[Illustration.GetTexture( Artifact.GetCulture.MakeScope )]"
				spriteType = Corneredtiled
				size = { 100% 15% }
				color = "[Artifact.GetRarityColor]"
				alpha = 0.2
				alwaystransparent = yes
			}

			icon =  {
				texture = "[Illustration.GetTexture( Artifact.GetCulture.MakeScope )]"
				spriteType = Corneredtiled
				size = { 100% 15% }
				color = "[Artifact.GetRarityColor]"
				alpha = 0.2
				alwaystransparent = yes
				parentanchor = bottom
			}

			block "button"
			{
				onclick = "[GetScriptedGui( 'POD_crafting_minigame_artifact_target' ).Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('artifact', Artifact.MakeScope).End)]"
				clicksound = "event:/DLC/EP1/SFX/UI/inventory_artifact_place"
			}

			block "overlay"
			{
				using = default_character_list_overlay
			}

			block "background_button_overrides"
			{
				down = "[ObjectsEqual( Artifact.Self , GetPlayer.MakeScope.GetVariable('target_artifact').Artifact )]"
			}

			tooltipwidget = {
				artifact_tooltip = {}
			}

			using = tooltip_es
		}

		flowcontainer = {
			name = "equip_status"
			visible = "[ObjectsEqual( Artifact.Self , GetPlayer.MakeScope.GetVariable('target_artifact').Artifact )]"
			parentanchor = top|right
			widgetanchor = top|right
			position = { -52 18 }

			allow_outside = yes

			text_single = {
				text = "TARGET_ARTIFACT_WINDOW_CURRENTLY_APPOINTED"
				align = right|nobaseline
				default_format = "#weak"
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding

			vbox = {
				name = "icon"
				layoutpolicy_vertical = expanding
				margin = { 2 2 }

				icon_artifact = {
					blockoverride "tooltipwidget" {}
				}
			}

			vbox = {
				name = "text"
				layoutpolicy_vertical = expanding
				margin_top = 4
				margin_bottom = 10

				expand = {}

				text_single = {
					layoutpolicy_horizontal = expanding
					text = "[Artifact.GetRarityAndSlotType]"
					max_width = 300
					using = Font_Size_Small
				}

				text_multi = {
					layoutpolicy_horizontal = expanding
					text = "[Artifact.GetNameNoTooltip]"
					autoresize = yes
					max_width = 350
					using = Font_Size_Medium
					default_format = "#high"
					alwaystransparent = yes
				}

				spacer = {
					size = { 0 6 }
				}

				hbox_artifact_durability = {
					layoutpolicy_horizontal = expanding
					# simple tooltip override so that the durability tooltip doesnt show up here
					tooltip = ""
				}

				expand = {}
			}

			expand = {}
		}
	}
	type widget_target_crafter = widget {
		datacontext = "[Scope.GetCharacter]"
		size = { 460 110 }
		using = tooltip_above

		button_standard = {
			size = { 98% 100% }

			framesize = { 252 80 }
			spriteType = Corneredtiled
			spriteborder = { 10 10 }

			#portrait_head_small = {}

			block "button"
			{
				onclick = "[GetScriptedGui( 'POD_crafting_minigame_crafter_selection' ).Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('crafter', Character.MakeScope).End)]"
				clicksound = "event:/DLC/EP1/SFX/UI/inventory_artifact_place"
			}

			block "overlay"
			{
				using = default_character_list_overlay
			}

			block "background_button_overrides"
			{
				down = "[ObjectsEqual( Character.Self , GetPlayer.MakeScope.GetVariable('craft_creator').Char )]"
			}

			tooltipwidget = {
				container_character_tooltip = {}
			}

			using = tooltip_es
		}

		flowcontainer = {
			name = "equip_status"
			visible = "[ObjectsEqual( Character.Self , GetPlayer.MakeScope.GetVariable('craft_creator').Char )]"
			parentanchor = top|right
			widgetanchor = top|right
			position = { -52 18 }

			allow_outside = yes

			text_single = {
				text = "TARGET_ARTIFACT_WINDOW_CURRENTLY_APPOINTED"
				align = right|nobaseline
				default_format = "#weak"
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding

			vbox = {
				name = "icon"
				layoutpolicy_vertical = expanding
				margin = { 2 2 }

				portrait_head_small = {
					blockoverride "tooltipwidget" {}
				}
			}
			expand = {}

			vbox = {
				name = "text"
				layoutpolicy_vertical = expanding
				margin_top = 4
				margin_bottom = 10

				expand = {}

				text_multi = {
					layoutpolicy_horizontal = expanding
					text = "[Character.GetNameNoTooltip]"
					autoresize = yes
					max_width = 350
					using = Font_Size_Medium
					default_format = "#high"
					alwaystransparent = yes
				}

				spacer = {
					size = { 0 6 }
				}

				hbox_skills_grid_character_model = {
					layoutpolicy_horizontal = expanding
					# simple tooltip override so that the durability tooltip doesnt show up here
					tooltip = ""
				}

			}
			expand = {}

		}
	}
}