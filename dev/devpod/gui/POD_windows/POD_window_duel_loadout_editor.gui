widget = {
	name = "POD_window_duel_loadout_editor"
	visible = "[And( Not( IsPauseMenuShown ), And(Or(Not(IsObserver), GetPlayer.IsValid), IsDefaultGUIMode))]"
	layer = royal_court
	size = { 100% 100% }

	window = {
		visible = "[And( GetPlayer.MakeScope.Var('pod_combat_config_open').IsSet, Not(GetPlayer.MakeScope.Var('pod_combat_active').IsSet) )]"
		parentanchor = center
		size = { 900 800 }
		using = Window_Background
		using = Window_Decoration
		allow_outside = yes

		vbox = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			using = Window_Margins

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text" {
					text = "POD_duel_loadout_title"
				}

				blockoverride "button_close" {
					onclick = "[PlayerGuiExecute('POD_duel_close_loadout_window')]"
				}
			}
			
			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				
				vbox = {
					layoutpolicy_vertical = expanding
					
					spacer = { size = { 300 0 } }
					
					text_single = {
						text = "POD_duel_loadout_equipped_title"
						default_format = "#clickable"
					}
					
					spacer = { size = { 0 12 } }

					fixedgridbox = {
						addcolumn = 240
						addrow = 43
						
						datamodel = "[GetPlayer.MakeScope.GetList('POD_duel_moves')]"
						
						item = {
							pod_duel_move_button_compact = {
								onclick = "[StoryGuiExecute('POD_duel_loadout_toggle')]"
							}
						}
					}
					
					expand = {}
					
					text_single = {
						text = "POD_duel_loadout_example_perk_title"
						default_format = "#clickable"
					}
					text_single = {
						text = "POD_duel_loadout_example_perk_desc"
					}
					
					spacer = { size = { 0 300 } }
				}
				
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					
					hbox = {
						button_checkbox_label = {
							onclick = "[PlayerGuiExecute('POD_duel_loadout_show_all_moves')]"
							enabled = "[Not( GetVariableSystem.Exists('POD_duel_loadout_compact') )]"

							blockoverride "checkbox"
							{
								checked = "[Or( GetPlayer.MakeScope.Var('show_all_duel_moves').IsSet, GetVariableSystem.Exists('POD_duel_loadout_compact') )]"
							}

							blockoverride "text"
							{
								text = "POD_duel_loadout_show_all"
								max_width = 150
							}
						}
						
						spacer = { size = { 60 0 } }
					
						button_checkbox_label = {
							onclick = "[GetVariableSystem.Toggle('POD_duel_loadout_compact')]"

							blockoverride "checkbox"
							{
								checked = "[GetVariableSystem.Exists('POD_duel_loadout_compact')]"
							}

							blockoverride "text"
							{
								text = "POD_duel_loadout_compact_view"
								max_width = 150
							}
						}
						
					}
					
					spacer = { size = { 0 4 } }
					
					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								ignoreinvisible = yes

								vbox = {
									layoutpolicy_horizontal = expanding
									ignoreinvisible = yes
									visible = "[Not(GetVariableSystem.Exists('POD_duel_loadout_compact'))]"
									
									spacing = 4
									
									datamodel = "[GetGlobalList('POD_duel_moves')]"

									item = {
										pod_duel_move_button_detailed = {
											visible = "[StoryGuiIsShown('POD_duel_loadout_option')]"
											enabled = "[StoryGuiIsValid('POD_duel_loadout_option')]"
											
											onclick = "[StoryGuiExecute('POD_duel_loadout_toggle')]"
											
											blockoverride "checkbox" {
												checked = "[StoryGuiIsShown('POD_duel_loadout_toggle')]"
											}
											
											blockoverride "glow_visible" {
												visible = "[StoryGuiIsShown('POD_duel_loadout_toggle')]"
											}
											
											blockoverride "fade_alpha" {
												alpha = "[Select_float( StoryGuiIsShown('POD_duel_loadout_toggle'), '(float)0.7', '(float)0.9' )]"
											}
											
											layoutpolicy_horizontal = expanding
										}
									}
								}
								
								dynamicgridbox = {
									visible = "[GetVariableSystem.Exists('POD_duel_loadout_compact')]"
									
									datamodel = "[GetGlobalList('POD_duel_moves')]"
									
									flipdirection = yes
									ignoreinvisible = yes
									maxhorizontalslots = 2
									datamodel_wrap = 2
									
									item = {
										widget = {
											size = { 242 42 }
											
											pod_duel_move_button_compact = {
												#visible = "[StoryGuiIsShown('POD_duel_loadout_option')]"
												enabled = "[StoryGuiIsValid('POD_duel_loadout_option')]"
												
												onclick = "[StoryGuiExecute('POD_duel_loadout_toggle')]"
												
												blockoverride "glow_visible" {
													visible = "[StoryGuiIsShown('POD_duel_loadout_toggle')]"
												}
												
												blockoverride "fade_alpha" {
													alpha = "[Select_float( StoryGuiIsShown('POD_duel_loadout_toggle'), '(float)0.7', '(float)0.9' )]"
												}
											}
										}
									}
								}
								
								expand = {}
							}
						}
					}
				}
			}
		}
	}
}


# types and templates can be used to make GUI elements more reusable

template pod_duel_button_bg {
	background = {
		texture ="gfx/interface/colors/black.dds"
		margin = { -2 -2 }
		alpha = 0.8
		
		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_corner.dds"
			blend_mode = alphamultiply
		}
	}
	
	background = {
		block "glow_visible" { visible = no }
		
		texture ="gfx/interface/colors/black.dds"
		margin = { -2 -2 }
		alpha = 0.8
		
		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_corner.dds"
			mirror = horizontal|vertical
			blend_mode = alphamultiply
		}
	}
	
	background = {
		block "bg_texture" {
			texture = "[Scope.Story.MakeScope.Var('decision').DecisionType.GetPicture(GetPlayer.Self)]"
		}
		fittype = centercrop
		framesize = { 1100 440 }
		alpha = 0.9
		
		margin = { -5 -5 }
		
		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_corner.dds"
			blend_mode = alphamultiply
			mirror = vertical
			block "fade_alpha" { alpha = 0.9 }
		}
				
		modify_texture = {
			texture = "gfx/interface/component_masks/mask_scratches.dds"
			blend_mode = alphamultiply
			spriteType = corneredTiled
			alpha = 0.3
			texture_density = 4
		}

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_clouds.dds"
			blend_mode = alphamultiply
			spriteType = corneredTiled
			alpha = 0.4
		}
	}
}


types PODDuelTypes {
	type pod_duel_move_button_compact = button_standard {
		size = { 240 40 }
		
		tooltipwidget = { pod_fancy_duel_move_tooltip = {} }
		
		pod_fleshcraft_glow = {
			block "glow_visible" { visible = no }
			blockoverride "background_properties" {
				margin = { 10 8 }
				tintcolor = { 1 0.9 0.8 0.75 }
			}
		}
		
		widget = {
			size = { 100% 100% }
			
			using = pod_duel_button_bg
		}
		
		text_single = {
			block "text_title" { text = "POD_duel_move_title_unformatted" }
			block "text_format" { default_format = "#high;outline" }
			fontsize = 16
			alwaystransparent = yes
			parentanchor = center
			position = { 0 -3 }
		}
	}
	
	type pod_duel_move_button_detailed = button_standard {
		margin = { 8 2 }
		
		pod_fleshcraft_glow = {
			block "glow_visible" { visible = no }
			blockoverride "background_properties" {
				margin = { 10 8 }
				tintcolor = { 1 0.9 0.8 0.75 }
			}
		}
		
		hbox = {
			layoutpolicy_horizontal = expanding
			resizeparent = yes
			
			using = pod_duel_button_bg
			
			spacer = { size = { 12 0 } }
			
			vbox = {
				layoutpolicy_horizontal = expanding
				margin = { 8 5 }
				margin_bottom = 12

				text_single = {
					block "text_title" { text = "POD_duel_move_title" }
					default_format = "#high;outline"
					fontsize = 16
					alwaystransparent = yes
				}
				
				spacer = { size = { 0 2 } }
				
				text_multi = {
					block "text_desc" { text = "POD_duel_move_tooltip" }
					# formatting is done in the loc entry itself
					autoresize = yes
					maximumsize = { 440 -1 }
					align = center
					alwaystransparent = yes
				}
			}
			
			button_checkbox = {
				block "checkbox" {}
				# not actually clickable
				# the parent button tracks the clicks, this is just to track which duel move is selected
				alwaystransparent = yes
				
				pod_fleshcraft_glow = {
					block "glow_visible" { visible = no }
					blockoverride "background_properties" {
						margin = { 10 8 }
						tintcolor = { 1 0.9 0.8 0.35 }
					}
				}
			}
			
			spacer = { size = { 12 0 } }
		}
	}
	
	type pod_fancy_duel_move_tooltip = widget
	{
		alwaystransparent = no
		
		using = DefaultTooltipBackground
		using = GeneralTooltipSetup
		
		vbox = {
			resizeparent = yes
			margin = { 14 11 }
			margin_bottom = 18
			
			# not reusing the pod_duel_button_bg template since this is slightly different
			background = {
				block "bg_texture" {
					texture = "[Scope.Story.MakeScope.Var('decision').DecisionType.GetPicture(GetPlayer.Self)]"
				}
				fittype = centercrop
				framesize = { 1100 440 }
				alpha = 0.4
				
				margin = { -5 -5 }
				
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
				}
						
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_scratches.dds"
					blend_mode = alphamultiply
					spriteType = corneredTiled
					alpha = 0.3
					texture_density = 4
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_clouds.dds"
					blend_mode = alphamultiply
					spriteType = corneredTiled
					alpha = 0.4
				}
			}
			
			text_single = {
				block "text_title" { text = "POD_duel_move_title" }
				default_format = "#high;outline"
				fontsize = 16
				alwaystransparent = yes
			}
			
			spacer = { size = { 0 2 } }
			
			text_multi = {
				block "text_desc" { text = "POD_duel_move_tooltip" }
				# formatting is done in the loc entry itself
				autoresize = yes
				maximumsize = { 440 -1 }
				align = center
				alwaystransparent = yes
			}
			
			block "additional_text" {}
		}
	}
}