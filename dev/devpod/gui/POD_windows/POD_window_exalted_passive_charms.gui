@show_passive_charms_window = "[GetPlayer.MakeScope.Var('POD_open_passive_charms_gui').IsSet]"
widget = {
	name = "pod_passive_charms_window"
	visible = "[And( And( Not( IsPauseMenuShown ), IsDefaultGUIMode ), GetPlayer.IsValid)]"
	layer = royal_court # above the HUD, but below interaction windows and events
	size = { 100% 100% }

	window = {
		visible = @show_passive_charms_window
		
		parentanchor = center
		position = { 0 1000 }
		alpha = 0

			allow_outside = yes

		state = {
			name = _hide
			using = Animation_Curve_Default
			duration = 0.6

			bezier = { 0 1 0 1 }

			position = { 0 1000 }
			alpha = 0

			on_start = "[GetScriptedGui('POD_passive_charms_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}

		state = {
			name = _show
			duration = 0.8

			start_sound = {
				soundeffect = "event:/DLC/FP2/SFX/UI/fp2_struggle_ui_intro_end_animate"
			}

			bezier = { 0 1 0 1 }

			position = { 0 0 }
			alpha = 1

			on_start = "[GetScriptedGui('POD_passive_charms_innit').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
		
		state = {
			name = show_after_loading_save
			
			# fix for window getting stuck off-screen after loading a save
			trigger_when = @show_passive_charms_window
			
			position = { 0 1000 }
			alpha = 0
			
			next = _show
		}

		using = Window_Decoration

		background = {
			texture = "gfx/interface/component_tiles/tile_window_background.dds"
			spriteType = Corneredtiled
			spriteborder = { 18 0 }
			texture_density = 2
	
			modify_texture = {
				texture = "gfx/interface/component_overlay/overlay_effect.dds"
				blend_mode = overlay
			}
	
			block "bg_margins"
			{
				margin = { -23 -17 }
			}
		}
		
		# # j a n k
		# state = {
		# 	name = _pause
		# 	trigger_when = "[Not(IsGamePaused)]"
		# 	on_start = "[OnPause]"
		# }

		
		vbox = {
			using = Window_Margins

			min_width = 1340
			min_height = 700

			set_parent_size_to_minimum = yes

			header_pattern_interaction = {
				layoutpolicy_horizontal = expanding
				minimumsize = { 100% -1 }

				blockoverride "header_text" {
					text = "game_concept_exalted_passive_charms"
					fontsize = 32
					default_format = "#color:{0.91,0.9,0.88,0.85};FONT:PODSubtitles"
				}

				blockoverride "button_close"
				{
					onclick = "[GetScriptedGui('POD_passive_charms_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				hbox = {
					min_height = 40
					layoutpolicy_horizontal = expanding
					spacing = 7
					button_standard = {
						size = { 25 25 }

						down = "[GetVariableSystem.Exists('ALF_spellbook_open_filters')]"
						onclick = "[GetVariableSystem.Toggle('ALF_spellbook_open_filters')]"

						tooltip = "TOGGLE_FILTERS"
						using = tooltip_nw

						button_search = {
							alwaystransparent = yes
							parentanchor = center
							size = { 20 20 }
						}
					}

					divider_light = { size = { 3 20 } }

					text_single = {
						text = "SORT_BY"
						align = nobaseline
						max_width = 90
					}
					dropdown_menu_standard = {
						blockoverride "dropdown_properties"
						{
							datamodel = "[GetPlayer.MakeScope.GetList('POD_passive_charms_sort_by_list')]"
						}
						blockoverride "dropdown_active_item_properties"
						{
							text = "[Localize(Concatenate('POD_PASSIVE_CHARMS_SORT_BY_', GetPlayer.MakeScope.GetVariable('POD_passive_charms_sort_by').GetFlagKey))]"
						}
						blockoverride "dropdown_item_properties"
						{
							text = "[Localize(Concatenate('POD_PASSIVE_CHARMS_SORT_BY_', Scope.GetFlagKey))]"
							onmousehierarchyenter = "[GetScriptedGui('POD_passive_charms_set_sort_by').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('type', MakeScopeFlag(Scope.GetFlagKey)).End)]"
						}
					}

					button_standard = {
						name = "sort_order"
						size = { 25 25 }
						visible = "[GetScriptedGui('POD_passive_charms_reverse_sort_order').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						onclick = "[GetScriptedGui('POD_passive_charms_reverse_sort_order').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

						tooltip = "POD_PASSIVE_CHARMS_REVERSE_ORDER"
						using = tooltip_nw

						button_icon = {
							alwaystransparent = yes
							parentanchor = center
							size = { 25 25 }
							texture = "gfx/interface/icons/flat_icons/sort_icon.dds"
							framesize = { 66 66 }

							frame = "[BoolTo1And2(GetPlayer.MakeScope.GetVariable('POD_passive_charms_sort_by_reverse').IsSet)]"

							blockoverride "button_frames" { effectname = "NoHighlight" }
						}
					}

					expand = {}

					button_standard_clean = {
						default_format = "#V;outline"

						tooltip = "POD_PASSIVE_CHARMS_SAVED_LOADOUTS"
						enabled = "[PlayerGuiIsValid('POD_passive_charm_update')]"
						
						onclick = "[GetVariableSystem.Toggle('POD_passive_charms_loadouts')]"

						size = { 200 30 }
						
						text = "POD_PASSIVE_CHARMS_SAVED_LOADOUTS"
						
						background = {
							texture = "gfx/interface/buttons/button_standard.dds"
							framesize = { 252 80 }
							frame = 4
							color = { 0.0 0.3 0.0 1.0 }
						}
					}
				}
				scrollbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding


					blockoverride "scrollbox_background" {
						background = {
							texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
							fittype = centercrop
							
							shaderfile = "gfx/FX/POD_shaders/POD_event_shaders.shader"
							effectname = "FlowyGold"

							using = Mask_Rough_Edges

							modify_texture = {
								texture = "gfx/interface/component_masks/patterns/mask_pattern_floral.dds"
								spriteType = Corneredtiled
								blend_mode = alphamultiply
								alpha = 0.6
							}

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
								blend_mode = alphamultiply
								mirror = vertical
							}

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
								blend_mode = alphamultiply
								alpha = 0.4
							}
						}
					}

					blockoverride "scrollbox_margins"
					{
						margin_top = 15
						margin_bottom = 15
						margin_right = 5
					}

					blockoverride "scrollbox_content"
					{
						dynamicgridbox = {
							visible = "[Not(IsDataModelEmpty(GetPlayer.MakeScope.GetList('charm_list')))]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical= expanding

							datamodel = "[GetPlayer.MakeScope.GetList('charm_list')]"
							datamodel_wrap = 4
							flipdirection = yes

							item = {
								POD_passive_charm_button = {
									datacontext = "[Scope.Story]"
								}
								
							}
						}
						text_single = {
							visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('charm_list'))]"
							align = center
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical= expanding
							text = "POD_PASSIVE_CHARMS_EMPTY" 
						}
					}
				}
				hbox = {
					layoutpolicy_horizontal = expanding

					min_height = 70
					max_height = 70

					margin_left = 20
					margin_right = 20

					text_single = { 
						layoutpolicy_horizontal = expanding
						text = "POD_PASSIVE_CHARM_TOTAL_COST" 
						fontsize = 22
						default_format = "#color:{0.91,0.9,0.88,0.85};FONT:PODSubtitles"
						alwaystransparent = yes
					}

					expand = {}

					button_standard_clean = {
						default_format = "#V;outline"

						tooltip = "[PlayerGuiBuildTooltip('POD_passive_charm_clear')]"
						enabled = "[PlayerGuiIsValid('POD_passive_charm_clear')]"
						
						onclick = "[PlayerGuiExecute('POD_passive_charm_clear')]"

						size = { 150 30 }
						
						text = "POD_PASSIVE_CHARM_CLEAR"
						
						background = {
							texture = "gfx/interface/buttons/button_standard.dds"
							framesize = { 252 80 }
							frame = 4
							color = { 0.7 0.7 0.7 1 }
						}
					}

					spacer = { size = { 16 0 } }

					button_standard_clean = {
						default_format = "#V;outline"

						tooltip = "[PlayerGuiBuildTooltip('POD_passive_charm_update')]"
						enabled = "[PlayerGuiIsValid('POD_passive_charm_update')]"
						
						onclick = "[PlayerGuiExecute('POD_passive_charm_update')]"

						size = { 200 40 }
						
						text = "CONFIRM"
						
						background = {
							texture = "gfx/interface/buttons/button_standard.dds"
							framesize = { 252 80 }
							frame = 4
							color = { 1.0 0.3 0.4 1.0 }
						}
					}
				}
			}
		}
		window = {
			visible = "[GetVariableSystem.Exists('ALF_spellbook_open_filters')]"
			parentanchor = top|right
			position = { -1320 10 }
			size = { 260 270 }
			focuspolicy = click

			allow_outside = yes

			using = Window_Movable
			using = Window_Background_Subwindow

			state = {
				name = _show
				using = Animation_FadeIn_Quick
			}

			state = {
				name = _hide
				using = Animation_FadeOut_Quick
			}

			vbox = {
				margin = { 4 4 }

				spacing = 10

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text"
					{
						text = "POD_PASSIVE_CHARMS_FILTERS"
						default_format = "#color:{0.91,0.9,0.88,0.85};FONT:PODSubtitles"
					}
					blockoverride "button_close"
					{
						onclick = "[GetVariableSystem.Toggle('ALF_spellbook_open_filters')]"
					}
				}
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					scrollbox = {
						layoutpolicy_horizontal = expanding
						min_height = 200

						blockoverride "scrollbox_margins"
						{
							margin_top = 5
							margin_bottom = 5
							margin_right = 5
						}

						blockoverride "scrollbox_content"
						{
							layoutpolicy_horizontal = expanding
							margin = { 5 10 }
							hbox = {
								layoutpolicy_horizontal = expanding
								text_single = { text = "POD_PASSIVE_CHARMS_FILER_CHARM" }
								expand = {}
								dropdown_menu_standard = {
									blockoverride "dropdown_size"
									{
										size = { 150 32 }
									}
									blockoverride "dropdown_properties"
									{
										datamodel = "[GetPlayer.MakeScope.GetList('POD_passive_charms_type_filter_list')]"
									}
									blockoverride "dropdown_active_item_properties"
									{
										text = "[Localize(Concatenate('POD_PASSIVE_CHARM_FILTER_', GetPlayer.MakeScope.GetVariable('POD_passive_charms_type_filter').GetFlagKey))]"
									}
									blockoverride "dropdown_item_properties"
									{
										text = "[Localize(Concatenate('POD_PASSIVE_CHARM_FILTER_', Scope.GetFlagKey))]"
										onmousehierarchyenter = "[GetScriptedGui('POD_passive_charms_set_filter_charm').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('charm', MakeScopeFlag(Scope.GetFlagKey)).End)]"
									}
								}
							}
							hbox = {
								layoutpolicy_horizontal = expanding
								text_single = { text = "POD_PASSIVE_CHARMS_FILER_ACTIVE" }
								expand = {}
								dropdown_menu_standard = {
									blockoverride "dropdown_size"
									{
										size = { 150 32 }
									}
									blockoverride "dropdown_properties"
									{
										datamodel = "[GetPlayer.MakeScope.GetList('POD_passive_charms_active_filter_list')]"
									}
									blockoverride "dropdown_active_item_properties"
									{
										text = "[Localize(Concatenate('POD_PASSIVE_CHARM_FILTER_', GetPlayer.MakeScope.GetVariable('POD_passive_charms_active_filter').GetFlagKey))]"
									}
									blockoverride "dropdown_item_properties"
									{
										text = "[Localize(Concatenate('POD_PASSIVE_CHARM_FILTER_', Scope.GetFlagKey))]"
										onmousehierarchyenter = "[GetScriptedGui('POD_passive_charms_set_filter_active').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('active', MakeScopeFlag(Scope.GetFlagKey)).End)]"
									}
								}
							}
						}
					}
					expand = {}
				}
			}
		}

		window = {
			visible = "[GetVariableSystem.Exists('POD_passive_charms_loadouts')]"
			parentanchor = top|right
			position = { 230 20 }
			size = { 250 670 }
			focuspolicy = click

			allow_outside = yes

			using = Window_Movable
			using = Window_Background_Subwindow

			state = {
				name = _show
				using = Animation_FadeIn_Quick
			}

			state = {
				name = _hide
				using = Animation_FadeOut_Quick
			}

			vbox = {
				margin = { 4 4 }

				spacing = 10

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text"
					{
						text = "POD_PASSIVE_CHARMS_LOADOUTS"
						default_format = "#color:{0.91,0.9,0.88,0.85};FONT:PODSubtitles"
					}
					blockoverride "button_close"
					{
						onclick = "[GetVariableSystem.Toggle('POD_passive_charms_loadouts')]"
					}
				}
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_margins"
						{
							margin_top = 5
							margin_bottom = 5
							margin_right = 10
							margin_left = 10
						}

						blockoverride "scrollbox_content"
						{
							vbox = {
								layoutpolicy_horizontal = expanding
								datamodel = "[GetPlayer.MakeScope.GetList('POD_passive_charms_loadouts')]"

								spacing = 5

								item = {
									button_standard = {
										layoutpolicy_horizontal = expanding
										size = { 150 40 }
										onclick = "[GetScriptedGui('POD_passive_charms_select_loadout').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loadout', Scope.Story.MakeScope).End)]"
										tooltip = "[GetScriptedGui('POD_passive_charms_select_loadout').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loadout', Scope.Story.MakeScope).End)]"
										hbox = {
											margin = { 5 0 }
											layoutpolicy_horizontal = expanding
											text_single = { 
												layoutpolicy_horizontal = expanding
												text = "[Scope.Var('nameholder').Char.GetFirstNameNoTooltip|L]" 
												max_width = 150
												margin_bottom = 5
											}
											button_change = {
												name = "button_replace"
												onclick = "[GetScriptedGui('POD_passive_charms_replace_loadout').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loadout', Scope.Story.MakeScope).End)]"
												size = { 25 25 }

												tooltip = "POD_PASSIVE_CHARMS_LOADOUT_REPLACE"
												using = tooltip_ne
											}
											button_edit_text = {
												name = "button_rename"
												onclick = "[GetScriptedGui('POD_passive_charms_rename_loadout').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loadout', Scope.Story.MakeScope).End)]"
												size = { 25 25 }

												tooltip = "POD_PASSIVE_CHARMS_LOADOUT_RENAME"
												using = tooltip_ne
											}
											button_close = {
												name = "button_close"

												onclick = "[GetScriptedGui('POD_passive_charms_delete_loadout').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('loadout', Scope.Story.MakeScope).End)]"
												tooltip = "POD_PASSIVE_CHARMS_LOADOUT_DELETE"
												clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_close"
											}
										}
									}
								}
							}
						}
					}
				}
				button_standard = {
					size = { 200 40 }
					onclick = "[GetScriptedGui('POD_passive_charms_save_loadout').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					tooltip = "[GetScriptedGui('POD_passive_charms_save_loadout').BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text = "POD_PASSIVE_CHARMS_SAVE_LOADOUT"
					using = tooltip_below
				}
				spacer = { size = { 0 5 } }
			}
		}
	}
}

types PODPassiveCharmsTypes
{
	# based on the portrait from portrait_legend_chronicle
	type POD_passive_charm_button = button_standard {
		size = { 310 120 }
		
		hbox = {
			margin = { 5 5 }
			vbox = {
				layoutpolicy_vertical = expanding
				min_width = 70
				max_width = 70
				text_single = { 
					visible = "[EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue(Concatenate3('POD_passive_charm_', Story.MakeScope.Var('flag_name').GetFlagKey, '_cost')), GetScriptedCharacterByHistoryID('POD_wraith_01').MakeScope.ScriptValue(Concatenate3('POD_passive_charm_', Story.MakeScope.Var('flag_name').GetFlagKey, '_cost')))]"
					align = center
					layoutpolicy_horizontal = expanding
					text = "POD_PASSIVE_CHARM_COST" 
					alwaystransparent = yes
				}
				text_single = { 
					visible = "[Not(EqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue(Concatenate3('POD_passive_charm_', Story.MakeScope.Var('flag_name').GetFlagKey, '_cost')), GetScriptedCharacterByHistoryID('POD_wraith_01').MakeScope.ScriptValue(Concatenate3('POD_passive_charm_', Story.MakeScope.Var('flag_name').GetFlagKey, '_cost'))))]"
					align = center
					layoutpolicy_horizontal = expanding
					text = "POD_PASSIVE_CHARM_COST" 
					tooltip = "[GetPlayer.MakeScope.GetScriptValueDesc(Concatenate3('POD_passive_charm_', Story.MakeScope.Var('flag_name').GetFlagKey, '_cost'))]"
					default_format = "#underline" 
					alwaystransparent = yes
				}
				divider_light = { layoutpolicy_horizontal = expanding }
				icon = {
					name = "interaction_icon"
					size = { 60 60 }
					texture = "[GetCultureInnovationType(Concatenate(Story.MakeScope.Var('flag_type').GetFlagKey,'_icon')).GetIcon]"
					alpha = 0.7
				}
			}
			divider_light = { layoutpolicy_vertical  = expanding }
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				text_single = { 
					align = center
					fontsize_min = 12
					margin_bottom = 5
					max_width = 221
					min_height = 35
					max_height = 35
					layoutpolicy_horizontal = expanding
					default_format = "#bold"
					text = "[GetPerk(Story.MakeScope.Var('charm_perk').GetFlagKey).GetName(GetPlayer)]" 
					alwaystransparent = yes
				}

				divider_light = { layoutpolicy_horizontal = expanding }
				text_multi = { 
					align = center
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin_bottom = 5
					text = "[GetPerk(Story.MakeScope.Var('charm_perk').GetFlagKey).GetEffectDescription(GetPlayer)]" 
					tooltip = "[GetPerk(Story.MakeScope.Var('charm_perk').GetFlagKey).GetEffectDescription(GetPlayer)]" 
					alwaystransparent = yes
				}
			}
		}
		background = {
			using = pod_fleshcraft_perk_bg_solid
			color = { 0 0.1 0 0.9 }
			
			modify_texture = {
				texture = "gfx/interface/icons/map_coa/at_war_mask.dds"
				blend_mode = alphamultiply
				spriteType = corneredTiled
			}
		}
		background = {
			using = pod_fleshcraft_perk_bg_frames
		}
		background = {
			texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
			fittype = centercrop

			visible = "[GetScriptedGui('POD_passive_charms_select').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('charm', Story.MakeScope).End)]"
			
			shaderfile = "gfx/FX/POD_shaders/POD_event_shaders.shader"
			effectname = "FlowyGold"

			using = Mask_Rough_Edges


			modify_texture = {
				texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
				blend_mode = alphamultiply
				mirror = vertical
			}
		}
		
		onclick = "[GetScriptedGui('POD_passive_charms_select').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('charm', Story.MakeScope).End)]"
		down = "[GetScriptedGui('POD_passive_charms_select').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('charm', Story.MakeScope).End)]"
	}
}