@show_passive_charms_window = "[GetPlayer.MakeScope.Var('POD_open_passive_charms_gui').IsSet]"
widget = {
	name = "pod_passive_charms_window"
	visible = "[And( And( Not( IsPauseMenuShown ), IsDefaultGUIMode ), GetPlayer.IsValid)]"
	layer = royal_court # above the HUD, but below interaction windows and events
	size = { 100% 100% }

	window = {
		visible = @show_passive_charms_window
		
		parentanchor = center
		position = { 0 1000 }
		alpha = 0

		state = {
			name = _hide
			using = Animation_Curve_Default
			duration = 0.6

			bezier = { 0 1 0 1 }

			position = { 0 1000 }
			alpha = 0

			on_start = "[GetScriptedGui('POD_passive_charms_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}

		state = {
			name = _show
			duration = 0.8

			start_sound = {
				soundeffect = "event:/DLC/FP2/SFX/UI/fp2_struggle_ui_intro_end_animate"
			}

			bezier = { 0 1 0 1 }

			position = { 0 0 }
			alpha = 1

			on_start = "[GetScriptedGui('POD_passive_charms_innit').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		}
		
		state = {
			name = show_after_loading_save
			
			# fix for window getting stuck off-screen after loading a save
			trigger_when = @show_passive_charms_window
			
			position = { 0 1000 }
			alpha = 0
			
			next = _show
		}

		using = Window_Decoration

		background = {
			texture = "gfx/interface/component_tiles/tile_window_background.dds"
			spriteType = Corneredtiled
			spriteborder = { 18 0 }
			texture_density = 2
	
			modify_texture = {
				texture = "gfx/interface/component_overlay/overlay_effect.dds"
				blend_mode = overlay
			}
	
			block "bg_margins"
			{
				margin = { -23 -17 }
			}
		}
		
		# j a n k
		state = {
			name = _pause
			trigger_when = "[Not(IsGamePaused)]"
			on_start = "[OnPause]"
		}

		
		vbox = {
			using = Window_Margins

			min_width = 1320
			min_height = 700

			set_parent_size_to_minimum = yes

			header_pattern_interaction = {
				layoutpolicy_horizontal = expanding
				minimumsize = { 100% -1 }

				blockoverride "header_text" {
					text = "game_concept_exalted_passive_charms"
					fontsize = 32
					default_format = "#color:{0.91,0.9,0.88,0.85};FONT:PODSubtitles"
				}

				blockoverride "button_close"
				{
					onclick = "[GetScriptedGui('POD_passive_charms_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				hbox = {
					min_height = 40
					layoutpolicy_horizontal = expanding
					spacing = 7
					button_standard = {
						size = { 25 25 }

						tooltip = "TOGGLE_FILTERS"
						using = tooltip_nw

						button_search = {
							alwaystransparent = yes
							parentanchor = center
							size = { 20 20 }
						}
					}

					divider_light = { size = { 3 20 } }

					text_single = {
						text = "SORT_BY"
						align = nobaseline
						max_width = 90
					}
					dropdown_menu_standard = {}

					button_standard = {
						name = "sort_order"
						size = { 25 25 }
					
						using = tooltip_nw

						button_icon = {
							alwaystransparent = yes
							parentanchor = center
							size = { 25 25 }
							texture = "gfx/interface/icons/flat_icons/sort_icon.dds"
							framesize = { 66 66 }

							frame = "1"

							blockoverride "button_frames" { effectname = "NoHighlight" }
						}
					}

					expand = {}
				}
				scrollbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					blockoverride "scrollbox_margins"
					{
						margin_top = 15
						margin_bottom = 15
						margin_right = 5
					}

					blockoverride "scrollbox_content"
					{
						dynamicgridbox = {
							visible = "[Not(IsDataModelEmpty(GetPlayer.MakeScope.GetList('possible_charms')))]"
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical= expanding

							datamodel = "[GetPlayer.MakeScope.GetList('possible_charms')]"
							datamodel_wrap = 4
							flipdirection = yes

							item = {
								POD_passive_charm_button = {
									datacontext = "[Scope.Story]"
								}
								
							}
						}
					}
				}
				hbox = {
					layoutpolicy_horizontal = expanding

					min_height = 70

					margin_left = 20
					margin_right = 20

					expand = {}

					button_standard_clean = {
						default_format = "#V;outline"

						size = { 200 40 }
						
						text = "CONFIRM"
						
						background = {
							texture = "gfx/interface/buttons/button_standard.dds"
							framesize = { 252 80 }
							frame = 4
							color = { 1.0 0.3 0.4 1.0 }
						}
					}
				}
			}
		}
	}
}

types PODPassiveCharmsTypes
{
	# based on the portrait from portrait_legend_chronicle
	type POD_passive_charm_button = button_standard {
		size = { 310 120 }
		
		hbox = {
			margin = { 5 5 }
			# layoutpolicy_horizontal = expanding
			# layoutpolicy_vertical = expanding
			# hbox = {
			# 	layoutpolicy_horizontal = expanding
			# 	text_single = { 
			# 		min_height = 20
			# 		max_width = 25
			# 		align = center
			# 		fontsize_min = 12
			# 		margin_bottom = 5
			# 		raw_text = "[GetPlayer.MakeScope.ScriptValue(Concatenate3('POD_passive_charm_', Story.MakeScope.Var('flag_name').GetFlagKey, '_cost'))]%" 
			# 		alwaystransparent = yes
			# 	}
			# 	divider_light = { layoutpolicy_vertical = expanding }
			# 	text_single = { 
			# 		min_height = 20
			# 		max_width = 250
			# 		align = center
			# 		fontsize_min = 12
			# 		margin_bottom = 5
			# 		layoutpolicy_horizontal = expanding
			# 		default_format = "#bold"
			# 		text = "[GetPerk(Story.MakeScope.Var('charm_perk').GetFlagKey).GetName(GetPlayer)]" 
			# 		alwaystransparent = yes
			# 	}
			# }

			# divider_light = { layoutpolicy_horizontal = expanding }
			# text_multi = { 
			# 	align = center
			# 	layoutpolicy_horizontal = expanding
			# 	layoutpolicy_vertical = expanding
			# 	raw_text = "[GetPerk(Story.MakeScope.Var('charm_perk').GetFlagKey).GetEffectDescription(GetPlayer)]" 
			# 	tooltip = "[GetPerk(Story.MakeScope.Var('charm_perk').GetFlagKey).GetEffectDescription(GetPlayer)]" 
			# 	alwaystransparent = yes
			# }
			vbox = {
				layoutpolicy_vertical = expanding
				min_width = 70
				max_width = 70
				icon = {
					name = "interaction_icon"
					size = { 60 60 }
					texture = "[GetCultureInnovationType(Concatenate(Story.MakeScope.Var('flag_type').GetFlagKey,'_icon')).GetIcon]"
				}
				divider_light = { layoutpolicy_horizontal = expanding }
				text_single = { 
					align = center
					fontsize_min = 12
					margin_bottom = 5
					min_width = 70
					max_width = 70
					layoutpolicy_horizontal = expanding
					default_format = "#italic"
					text = "POD_PASSIVE_CHARM_COST" 
					alwaystransparent = yes
				}
			}
			divider_light = { layoutpolicy_vertical  = expanding }
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				text_single = { 
					align = center
					fontsize_min = 12
					margin_bottom = 5
					max_width = 221
					min_height = 25
					max_height = 25
					layoutpolicy_horizontal = expanding
					default_format = "#bold"
					text = "[GetPerk(Story.MakeScope.Var('charm_perk').GetFlagKey).GetName(GetPlayer)]" 
					alwaystransparent = yes
				}

				divider_light = { layoutpolicy_horizontal = expanding }
				text_multi = { 
					align = center
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					text = "[GetPerk(Story.MakeScope.Var('charm_perk').GetFlagKey).GetEffectDescription(GetPlayer)]" 
					tooltip = "[GetPerk(Story.MakeScope.Var('charm_perk').GetFlagKey).GetEffectDescription(GetPlayer)]" 
					alwaystransparent = yes
				}
			}
		}
		
		onclick = "[GetScriptedGui('POD_passive_charms_select').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('charm', Story.MakeScope).End)]"
		down = "[GetScriptedGui('POD_passive_charms_select').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('charm', Story.MakeScope).End)]"
	}
}