############################################
######   POD COMBAT SKILLS WINDOW   ######
############################################

# Skill configuration window — visible outside combat when opened via decision.
# Players equip/unequip combat moves here. Loadout persists between fights.

widget = {
	name = "pod_combat_skills_window"
	visible = "[And(And(Not(IsPauseMenuShown), IsDefaultGUIMode), And(GetPlayer.IsValid, And(GetPlayer.MakeScope.Var('pod_combat_config_open').IsSet, Not(GetPlayer.MakeScope.Var('pod_combat_active').IsSet))))]"
	layer = royal_court
	size = { 100% 100% }

	window = {
		parentanchor = center
		size = { 800 1050 }
		using = Window_Background
		using = Window_Decoration
		allow_outside = yes

		vbox = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			using = Window_Margins

			##############################
			###### HEADER
			##############################

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text" {
					text = "pod_combat_skills_title"
				}

				blockoverride "button_close" {
					onclick = "[GetScriptedGui('pod_combat_close_skills').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			# Equipped count per category
			hbox = {
				margin = { 0 5 }
				spacing = 20
				text_single = {
					raw_text = "[Localize('pod_combat_equipped_label')]"
					default_format = "#bold"
				}
				text_single = {
					raw_text = "ATK: [GetPlayer.MakeScope.ScriptValue('pod_combat_atk_count')|0] / [GetPlayer.MakeScope.ScriptValue('pod_combat_max_per_category')|0]"
				}
				text_single = {
					raw_text = "CTL: [GetPlayer.MakeScope.ScriptValue('pod_combat_ctl_count')|0] / [GetPlayer.MakeScope.ScriptValue('pod_combat_max_per_category')|0]"
				}
				text_single = {
					raw_text = "DEF: [GetPlayer.MakeScope.ScriptValue('pod_combat_def_count')|0] / [GetPlayer.MakeScope.ScriptValue('pod_combat_max_per_category')|0]"
				}
				text_single = {
					raw_text = "PWR: [GetPlayer.MakeScope.ScriptValue('pod_combat_pwr_count')|0] / [GetPlayer.MakeScope.ScriptValue('pod_combat_max_per_category')|0]"
				}
				text_single = {
					raw_text = "Total: [GetPlayer.MakeScope.ScriptValue('pod_combat_equipped_count')|0] / [GetPlayer.MakeScope.ScriptValue('pod_combat_max_equipped')|0]"
					default_format = "#weak"
				}
			}

			divider_light = {
				layoutpolicy_horizontal = expanding
			}

			##############################
			###### SKILL LIST
			##############################

			scrollarea = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				scrollbarpolicy_horizontal = always_off
				scrollbarpolicy_vertical = as_needed

				scrollbar_vertical = {
					using = Scrollbar_Vertical
				}

				scrollwidget = {

					vbox = {
						layoutpolicy_horizontal = expanding
						ignoreinvisible = yes
						margin = { 5 5 }
						margin_right = 22

						##############################
						###### BASE PHYSICAL
						##############################

						vbox = {
							layoutpolicy_horizontal = expanding
							ignoreinvisible = yes

							hbox = {
								layoutpolicy_horizontal = expanding
								margin = { 5 4 }
								text_single = {
									raw_text = "#bold BASE PHYSICAL#!"
									default_format = "#weak"
								}
							}

								# Strike
								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 8 2 }

									background = {
										using = Background_Area
									}

									vbox = {
										layoutpolicy_horizontal = expanding
										margin = { 8 4 }

										text_single = {
											text = "pod_combat_move_strike"
											default_format = "#bold"
										}
										text_multi = {
											text = "pod_combat_move_strike_desc"
											default_format = "#weak"
											autoresize = yes
											maximumsize = { 440 -1 }
											align = center
										}
									}

									button_standard = {
										size = { 90 35 }
										visible = "[Not(GetPlayer.MakeScope.Var('pod_combat_equipped_strike').IsSet)]"
										text = "pod_combat_equip_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_strike').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										enabled = "[GetScriptedGui('pod_combat_toggle_strike').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
									button_standard = {
										size = { 90 35 }
										visible = "[GetPlayer.MakeScope.Var('pod_combat_equipped_strike').IsSet]"
										text = "pod_combat_remove_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_strike').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
								}

								# Heavy Blow
								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 8 2 }

									background = {
										using = Background_Area
									}

									vbox = {
										layoutpolicy_horizontal = expanding
										margin = { 8 4 }

										text_single = {
											text = "pod_combat_move_heavy_blow"
											default_format = "#bold"
										}
										text_multi = {
											text = "pod_combat_move_heavy_blow_desc"
											default_format = "#weak"
											autoresize = yes
											maximumsize = { 440 -1 }
											align = center
										}
									}

									button_standard = {
										size = { 90 35 }
										visible = "[Not(GetPlayer.MakeScope.Var('pod_combat_equipped_heavy_blow').IsSet)]"
										text = "pod_combat_equip_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_heavy_blow').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										enabled = "[GetScriptedGui('pod_combat_toggle_heavy_blow').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
									button_standard = {
										size = { 90 35 }
										visible = "[GetPlayer.MakeScope.Var('pod_combat_equipped_heavy_blow').IsSet]"
										text = "pod_combat_remove_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_heavy_blow').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
								}

								# Quick Jab
								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 8 2 }

									background = {
										using = Background_Area
									}

									vbox = {
										layoutpolicy_horizontal = expanding
										margin = { 8 4 }

										text_single = {
											text = "pod_combat_move_quick_jab"
											default_format = "#bold"
										}
										text_multi = {
											text = "pod_combat_move_quick_jab_desc"
											default_format = "#weak"
											autoresize = yes
											maximumsize = { 440 -1 }
											align = center
										}
									}

									button_standard = {
										size = { 90 35 }
										visible = "[Not(GetPlayer.MakeScope.Var('pod_combat_equipped_quick_jab').IsSet)]"
										text = "pod_combat_equip_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_quick_jab').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										enabled = "[GetScriptedGui('pod_combat_toggle_quick_jab').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
									button_standard = {
										size = { 90 35 }
										visible = "[GetPlayer.MakeScope.Var('pod_combat_equipped_quick_jab').IsSet]"
										text = "pod_combat_remove_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_quick_jab').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
								}

								# Reckless Charge
								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 8 2 }

									background = {
										using = Background_Area
									}

									vbox = {
										layoutpolicy_horizontal = expanding
										margin = { 8 4 }

										text_single = {
											text = "pod_combat_move_reckless_charge"
											default_format = "#bold"
										}
										text_multi = {
											text = "pod_combat_move_reckless_charge_desc"
											default_format = "#weak"
											autoresize = yes
											maximumsize = { 440 -1 }
											align = center
										}
									}

									button_standard = {
										size = { 90 35 }
										visible = "[Not(GetPlayer.MakeScope.Var('pod_combat_equipped_reckless_charge').IsSet)]"
										text = "pod_combat_equip_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_reckless_charge').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										enabled = "[GetScriptedGui('pod_combat_toggle_reckless_charge').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
									button_standard = {
										size = { 90 35 }
										visible = "[GetPlayer.MakeScope.Var('pod_combat_equipped_reckless_charge').IsSet]"
										text = "pod_combat_remove_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_reckless_charge').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
								}
						}

						##############################
						###### BASE TACTICAL
						##############################

						vbox = {
							layoutpolicy_horizontal = expanding
							ignoreinvisible = yes

							hbox = {
								layoutpolicy_horizontal = expanding
								margin = { 5 4 }
								text_single = {
									raw_text = "#bold BASE TACTICAL#!"
									default_format = "#weak"
								}
							}

								# Guard
								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 8 2 }

									background = {
										using = Background_Area
									}

									vbox = {
										layoutpolicy_horizontal = expanding
										margin = { 8 4 }

										text_single = {
											text = "pod_combat_move_guard"
											default_format = "#bold"
										}
										text_multi = {
											text = "pod_combat_move_guard_desc"
											default_format = "#weak"
											autoresize = yes
											maximumsize = { 440 -1 }
											align = center
										}
									}

									button_standard = {
										size = { 90 35 }
										visible = "[Not(GetPlayer.MakeScope.Var('pod_combat_equipped_guard').IsSet)]"
										text = "pod_combat_equip_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_guard').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										enabled = "[GetScriptedGui('pod_combat_toggle_guard').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
									button_standard = {
										size = { 90 35 }
										visible = "[GetPlayer.MakeScope.Var('pod_combat_equipped_guard').IsSet]"
										text = "pod_combat_remove_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_guard').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
								}

								# Feint
								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 8 2 }

									background = {
										using = Background_Area
									}

									vbox = {
										layoutpolicy_horizontal = expanding
										margin = { 8 4 }

										text_single = {
											text = "pod_combat_move_feint"
											default_format = "#bold"
										}
										text_multi = {
											text = "pod_combat_move_feint_desc"
											default_format = "#weak"
											autoresize = yes
											maximumsize = { 440 -1 }
											align = center
										}
									}

									button_standard = {
										size = { 90 35 }
										visible = "[Not(GetPlayer.MakeScope.Var('pod_combat_equipped_feint').IsSet)]"
										text = "pod_combat_equip_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_feint').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										enabled = "[GetScriptedGui('pod_combat_toggle_feint').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
									button_standard = {
										size = { 90 35 }
										visible = "[GetPlayer.MakeScope.Var('pod_combat_equipped_feint').IsSet]"
										text = "pod_combat_remove_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_feint').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
								}

								# Intimidate
								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 8 2 }

									background = {
										using = Background_Area
									}

									vbox = {
										layoutpolicy_horizontal = expanding
										margin = { 8 4 }

										text_single = {
											text = "pod_combat_move_intimidate"
											default_format = "#bold"
										}
										text_multi = {
											text = "pod_combat_move_intimidate_desc"
											default_format = "#weak"
											autoresize = yes
											maximumsize = { 440 -1 }
											align = center
										}
									}

									button_standard = {
										size = { 90 35 }
										visible = "[Not(GetPlayer.MakeScope.Var('pod_combat_equipped_intimidate').IsSet)]"
										text = "pod_combat_equip_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_intimidate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										enabled = "[GetScriptedGui('pod_combat_toggle_intimidate').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
									button_standard = {
										size = { 90 35 }
										visible = "[GetPlayer.MakeScope.Var('pod_combat_equipped_intimidate').IsSet]"
										text = "pod_combat_remove_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_intimidate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
								}

								# Rally
								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 8 2 }

									background = {
										using = Background_Area
									}

									vbox = {
										layoutpolicy_horizontal = expanding
										margin = { 8 4 }

										text_single = {
											text = "pod_combat_move_rally"
											default_format = "#bold"
										}
										text_multi = {
											text = "pod_combat_move_rally_desc"
											default_format = "#weak"
											autoresize = yes
											maximumsize = { 440 -1 }
											align = center
										}
									}

									button_standard = {
										size = { 90 35 }
										visible = "[Not(GetPlayer.MakeScope.Var('pod_combat_equipped_rally').IsSet)]"
										text = "pod_combat_equip_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_rally').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										enabled = "[GetScriptedGui('pod_combat_toggle_rally').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
									button_standard = {
										size = { 90 35 }
										visible = "[GetPlayer.MakeScope.Var('pod_combat_equipped_rally').IsSet]"
										text = "pod_combat_remove_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_rally').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
								}
						}

						##############################
						###### HUNTER GENERIC
						##############################

						vbox = {
							layoutpolicy_horizontal = expanding
							ignoreinvisible = yes
							visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_has_hunter_sv'), '(CFixedPoint)0')]"

							hbox = {
								layoutpolicy_horizontal = expanding
								margin = { 5 4 }
								text_single = {
									raw_text = "#bold HUNTER GENERIC#!"
									default_format = "#weak"
								}
							}

								# Silver Dagger Strike
								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 8 2 }
									visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_has_hunter_sv'), '(CFixedPoint)0')]"

									background = {
										using = Background_Area
									}

									vbox = {
										layoutpolicy_horizontal = expanding
										margin = { 8 4 }

										text_single = {
											text = "pod_combat_move_silver_dagger_strike"
											default_format = "#bold"
										}
										text_multi = {
