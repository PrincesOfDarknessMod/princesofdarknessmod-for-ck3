############################################
######   POD COMBAT SKILLS WINDOW
############################################
# Two scrollable datamodels replace the per-move button grid:
#
#   Left column  — the PC's currently equipped moves (pod_combat_loadout)
#                  rendered as a compact grid of fancy-backdrop buttons.
#                  Clicking a compact button unequips it.
#
#   Right column — all available moves (POD_combat_moves global list)
#                  in either detailed scrollbox (default) or compact
#                  grid (toggled by the "Compact view" checkbox).
#                  Visibility of each row is gated by the unlock
#                  decision (pod_combat_loadout_option SGUI); the
#                  "Show all moves" checkbox flips the
#                  show_all_combat_moves character var to override
#                  that gate.
#
# Show-all / Compact are INDEPENDENT:
#   The "Compact view" checkbox (pod_combat_loadout_compact_view) only
#   changes the row LAYOUT (compact cards vs. detailed cards). The "Show
#   all moves" checkbox (show_all_combat_moves) only changes VISIBILITY
#   (whether locked moves are listed). Each toggles and reads only its own
#   flag, so any combination is allowed - e.g. compact layout showing only
#   your unlocked moves.
#
# Widget templates at the bottom render the fancy decision-art
# backdrops (pod_combat_button_bg) and two button sizes.

widget = {
	name = "pod_combat_skills_window"
	visible = "[And(Not(IsPauseMenuShown), And(IsDefaultGUIMode, And(GetPlayer.IsValid, And(GetPlayer.MakeScope.Var('pod_combat_config_open').IsSet, Not(GetPlayer.MakeScope.Var('pod_combat_active').IsSet)))))]"
	layer = royal_court
	size = { 100% 100% }

	window = {
		parentanchor = center
		size = { 1000 900 }
		using = Window_Background
		using = Window_Decoration
		allow_outside = yes

		# Fade in/out when the visible binding (on the parent widget)
		# flips. _show fires on the configure-skills decision opening
		# this panel; _hide fires when the player commits the loadout
		# and returns to either the map (out-of-combat) or the combat
		# window (mid-fight reconfigure). Standard duration matches the
		# combat window's pairing so the cross-fade between the two
		# feels balanced.
		# Reference: CK3 Reference/gui/window_artifact_details.gui:15-24.
		state = {
			name = _show
			using = Animation_FadeIn_Standard
		}
		state = {
			name = _hide
			using = Animation_FadeOut_Standard
		}

		vbox = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			using = Window_Margins

			##############################
			###### HEADER
			##############################

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text" {
					text = "pod_combat_skills_title"
				}

				blockoverride "button_close" {
					onclick = "[GetScriptedGui('pod_combat_close_skills').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			# Equipped-counts stat bar — pip strip per category + a
			# numeric TOTAL readout on the right. Each category group
			# is a clickable button (visually a label + four pip
			# icons) that filters the right-hand move pool to that
			# category; the click semantics match the previous text
			# buttons (toggle, multi-select, click-again-to-clear).
			# Visually the pip strip telegraphs capacity at a glance:
			# filled pips = equipped slots in that category, empty
			# pips = remaining room. Category colour on both the
			# label and the filled pips lets the eye filter by
			# category in peripheral vision.
			#
			# `down = "[...filter_X.IsSet]"` keeps the button visually
			# "pressed in" while the filter is active — the same
			# convention the previous text buttons used.
			hbox = {
				margin = { 0 5 }
				spacing = 8
				layoutpolicy_horizontal = expanding

				text_single = {
					raw_text = "[Localize('pod_combat_equipped_label')]"
					default_format = "#bold"
				}

				# ── ATK group ──
				#
				# Filter-active visual lives on the background swap
				# below (NOT on `down`). Removing `down` keeps the
				# button from holding the vanilla button_standard
				# pressed-frame (the brown clay look that clashes with
				# the dark UI); the conditional bg pair below shows
				# the flat dark tone when the filter is OFF and a
				# desaturated category-color tint when the filter is
				# ON. Click feedback during press still happens
				# briefly via button_standard's regular down animation
				# — just no persistent brown.
				button_standard = {
					size = { 112 44 }
					tooltip = "pod_combat_filter_atk_tt"
					onclick = "[GetScriptedGui('pod_combat_toggle_filter_atk').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text = ""

					# Two mutually-exclusive backgrounds gated on the
					# filter-active var. Flat dark when off, red tint
					# when on. Both use the white.dds + `color` pattern
					# so the colour channel fully drives the rendered
					# tint.
					blockoverride "background_color" {
						background = {
							visible = "[Not( GetPlayer.MakeScope.Var('pod_combat_filter_atk').IsSet )]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.05 0.07 0.1 0.85 }
						}
						background = {
							visible = "[GetPlayer.MakeScope.Var('pod_combat_filter_atk').IsSet]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.40 0.15 0.15 0.95 }
						}
					}

					# Vertical layout: category label centered above a
					# centered row of 4 pips. Earlier layout was a
					# horizontal label-then-pips row that visually
					# parked the label on the left side of the button;
					# stacking puts the label dead-centre and gives
					# the pips room to breathe at a larger size
					# (10 → 14 px each).
					vbox = {
						parentanchor = center|vcenter
						spacing = 3
						alwaystransparent = yes

						text_single = {
							raw_text = "#color_red;bold ATK#!"
						}
						hbox = {
							spacing = 4
							alwaystransparent = yes
							# Pip 1
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_atk_count'), '(CFixedPoint)1')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.76 0.33 0.31 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_atk_count'), '(CFixedPoint)1')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
							# Pip 2
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_atk_count'), '(CFixedPoint)2')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.76 0.33 0.31 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_atk_count'), '(CFixedPoint)2')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
							# Pip 3
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_atk_count'), '(CFixedPoint)3')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.76 0.33 0.31 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_atk_count'), '(CFixedPoint)3')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
							# Pip 4
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_atk_count'), '(CFixedPoint)4')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.76 0.33 0.31 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_atk_count'), '(CFixedPoint)4')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
						}
					}
				}

				# ── DEF group ──
				button_standard = {
					size = { 112 44 }
					tooltip = "pod_combat_filter_def_tt"
					onclick = "[GetScriptedGui('pod_combat_toggle_filter_def').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text = ""

					blockoverride "background_color" {
						background = {
							visible = "[Not( GetPlayer.MakeScope.Var('pod_combat_filter_def').IsSet )]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.05 0.07 0.1 0.85 }
						}
						background = {
							visible = "[GetPlayer.MakeScope.Var('pod_combat_filter_def').IsSet]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.15 0.25 0.40 0.95 }
						}
					}

					vbox = {
						parentanchor = center|vcenter
						spacing = 3
						alwaystransparent = yes

						text_single = {
							raw_text = "#color_light_blue;bold DEF#!"
						}
						hbox = {
							spacing = 4
							alwaystransparent = yes
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_def_count'), '(CFixedPoint)1')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.37 0.56 0.78 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_def_count'), '(CFixedPoint)1')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_def_count'), '(CFixedPoint)2')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.37 0.56 0.78 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_def_count'), '(CFixedPoint)2')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_def_count'), '(CFixedPoint)3')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.37 0.56 0.78 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_def_count'), '(CFixedPoint)3')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_def_count'), '(CFixedPoint)4')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.37 0.56 0.78 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_def_count'), '(CFixedPoint)4')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
						}
					}
				}

				# ── CTL group ──
				button_standard = {
					size = { 112 44 }
					tooltip = "pod_combat_filter_ctl_tt"
					onclick = "[GetScriptedGui('pod_combat_toggle_filter_ctl').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text = ""

					blockoverride "background_color" {
						background = {
							visible = "[Not( GetPlayer.MakeScope.Var('pod_combat_filter_ctl').IsSet )]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.05 0.07 0.1 0.85 }
						}
						background = {
							visible = "[GetPlayer.MakeScope.Var('pod_combat_filter_ctl').IsSet]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.28 0.20 0.40 0.95 }
						}
					}

					vbox = {
						parentanchor = center|vcenter
						spacing = 3
						alwaystransparent = yes

						text_single = {
							raw_text = "#color_porple;bold CTL#!"
						}
						hbox = {
							spacing = 4
							alwaystransparent = yes
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_ctl_count'), '(CFixedPoint)1')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.60 0.48 0.83 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_ctl_count'), '(CFixedPoint)1')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_ctl_count'), '(CFixedPoint)2')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.60 0.48 0.83 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_ctl_count'), '(CFixedPoint)2')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_ctl_count'), '(CFixedPoint)3')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.60 0.48 0.83 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_ctl_count'), '(CFixedPoint)3')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_ctl_count'), '(CFixedPoint)4')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.60 0.48 0.83 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_ctl_count'), '(CFixedPoint)4')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
						}
					}
				}

				# ── PWR group ──
				button_standard = {
					size = { 112 44 }
					tooltip = "pod_combat_filter_pwr_tt"
					onclick = "[GetScriptedGui('pod_combat_toggle_filter_pwr').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text = ""

					blockoverride "background_color" {
						background = {
							visible = "[Not( GetPlayer.MakeScope.Var('pod_combat_filter_pwr').IsSet )]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.05 0.07 0.1 0.85 }
						}
						background = {
							visible = "[GetPlayer.MakeScope.Var('pod_combat_filter_pwr').IsSet]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.50 0.30 0.10 0.95 }
						}
					}

					vbox = {
						parentanchor = center|vcenter
						spacing = 3
						alwaystransparent = yes

						text_single = {
							raw_text = "#color_pwr_orange;bold PWR#!"
						}
						hbox = {
							spacing = 4
							alwaystransparent = yes
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pwr_count'), '(CFixedPoint)1')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.9 0.55 0.15 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pwr_count'), '(CFixedPoint)1')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pwr_count'), '(CFixedPoint)2')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.9 0.55 0.15 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pwr_count'), '(CFixedPoint)2')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pwr_count'), '(CFixedPoint)3')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.9 0.55 0.15 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pwr_count'), '(CFixedPoint)3')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
							widget = {
								size = { 14 14 }
								icon = {
									visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pwr_count'), '(CFixedPoint)4')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
									color = { 0.9 0.55 0.15 1 }
								}
								icon = {
									visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pwr_count'), '(CFixedPoint)4')]"
									size = { 14 14 }
									texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
								}
							}
						}
					}
				}

				expand = {}

				# TOTAL display — bold-gold count + muted "/ 16" max,
				# matching the AP pip-strip readout in the combat
				# window. Clicking the surrounding button clears all
				# four filters (same `clear_filters` SGUI as before).
				# Height matches the category buttons' new 44px
				# (taller to accommodate their vbox layout) so the
				# stat bar reads as one horizontal strip.
				button_standard = {
					size = { 110 44 }
					tooltip = "pod_combat_filter_total_tt"
					onclick = "[GetScriptedGui('pod_combat_clear_filters').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text = ""

					blockoverride "background_color" {
						background = {
							texture = "gfx/interface/colors/white.dds"
							color = { 0.05 0.07 0.1 0.85 }
						}
					}

					hbox = {
						parentanchor = center|vcenter
						spacing = 6
						alwaystransparent = yes

						text_single = {
							raw_text = "#weak;bold TOTAL#!"
						}
						text_single = {
							raw_text = "#high;bold [GetPlayer.MakeScope.ScriptValue('pod_combat_equipped_count')|0]#! #weak / [GetPlayer.MakeScope.ScriptValue('pod_combat_max_equipped')|0]#!"
						}
					}
				}
			}

			divider_light = {
				layoutpolicy_horizontal = expanding
			}

			##############################
			###### SPLIT LAYOUT
			##############################

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				####### LEFT: EQUIPPED MOVES GROUPED BY CATEGORY #######
				# One vbox section per combat_category (ATK/DEF/CTL/PWR).
				# Each shares the same pod_combat_loadout datamodel but
				# filters per-item via a category-check SGUI, so only
				# moves matching that section's category render.
				# ignoreinvisible collapses hidden items so sections
				# stack cleanly without gaps.
				vbox = {
					layoutpolicy_vertical = expanding

					spacer = { size = { 300 0 } }

					text_single = {
						text = "pod_combat_loadout_equipped_header"
						default_format = "#clickable"
					}

					spacer = { size = { 0 13 } }

					# Equipped-moves scrollbox: wraps the four category
					# sections (ATK / DEF / CTL / PWR) so the column can
					# scroll vertically when the actor has many moves
					# equipped. Without this, four full categories
					# (4 × 4 compact buttons + headers + spacers) push
					# past the bottom of the editor window.
					#
					# layoutpolicy_vertical = expanding makes the scrollbox
					# absorb the leftover vertical space in the parent vbox.
					# The hint title / desc / checkboxes rendered AFTER the
					# scrollbox still pin to the bottom of the parent vbox
					# because the scrollbox claims all the slack between
					# the equipped-header and them.
					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding

					# ── ATK section ──
					vbox = {
						ignoreinvisible = yes
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_atk_count'), '(CFixedPoint)0')]"

						text_single = {
							text = "pod_combat_cat_atk_header"
							default_format = "#weak"
						}

						vbox = {
							ignoreinvisible = yes
							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								pod_combat_move_button_compact = {
									visible = "[GetScriptedGui('pod_combat_is_atk_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
								}
							}
						}

						spacer = { size = { 0 8 } }
					}

					# ── DEF section ──
					vbox = {
						ignoreinvisible = yes
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_def_count'), '(CFixedPoint)0')]"

						text_single = {
							text = "pod_combat_cat_def_header"
							default_format = "#weak"
						}

						vbox = {
							ignoreinvisible = yes
							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								pod_combat_move_button_compact = {
									visible = "[GetScriptedGui('pod_combat_is_def_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
								}
							}
						}

						spacer = { size = { 0 8 } }
					}

					# ── CTL section ──
					vbox = {
						ignoreinvisible = yes
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_ctl_count'), '(CFixedPoint)0')]"

						text_single = {
							text = "pod_combat_cat_ctl_header"
							default_format = "#weak"
						}

						vbox = {
							ignoreinvisible = yes
							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								pod_combat_move_button_compact = {
									visible = "[GetScriptedGui('pod_combat_is_ctl_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
								}
							}
						}

						spacer = { size = { 0 8 } }
					}

					# ── PWR section ──
					vbox = {
						ignoreinvisible = yes
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pwr_count'), '(CFixedPoint)0')]"

						text_single = {
							text = "pod_combat_cat_pwr_header"
							default_format = "#weak"
						}

						vbox = {
							ignoreinvisible = yes
							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								pod_combat_move_button_compact = {
									visible = "[GetScriptedGui('pod_combat_is_pwr_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
								}
							}
						}
					}

							}
						}
					}

					text_single = {
						text = "pod_combat_loadout_hint_title"
						default_format = "#clickable"
					}
					# text_multi (not text_single) — text_single keeps the
					# whole loc on one line and lets it overflow / clip;
					# text_multi wraps at the maximumsize width below.
					text_multi = {
						text = "pod_combat_loadout_hint_desc"
						autoresize = yes
						maximumsize = { 290 -1 }
					}

					spacer = { size = { 0 24 } }
				}

				####### RIGHT: AVAILABLE MOVES #######
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					# Toggle row — fixed 24-tall so it lines up with
					# the equipped column's wrapped header on the
					# left. Without the explicit height, this row
					# auto-sizes to the checkbox texture (slightly
					# taller than a bare text_single) and the right
					# scrollbox starts a few pixels lower than the
					# left.
					hbox = {
						minimumsize = { -1 24 }
						maximumsize = { -1 24 }
						button_checkbox_label = {
							onclick = "[GetScriptedGui('pod_combat_loadout_show_all_moves').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

							blockoverride "checkbox" {
								# Independent of compact view (decoupled): reads only its own flag.
								checked = "[GetPlayer.MakeScope.Var('show_all_combat_moves').IsSet]"
							}
							blockoverride "text" {
								text = "pod_combat_loadout_show_all"
								max_width = 200
							}
						}

						spacer = { size = { 60 0 } }

						button_checkbox_label = {
							# Compact-view toggle now uses an SGUI-driven
							# character variable (pod_combat_loadout_compact_view)
							# instead of the GUI-only GetVariableSystem,
							# so the is_shown dispatch in
							# pod_combat_loadout_option can actually read
							# the state. See pod_combat_skill_guis.txt for
							# the toggle SGUI.
							onclick = "[GetScriptedGui('pod_combat_loadout_compact_view').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

							blockoverride "checkbox" {
								checked = "[GetPlayer.MakeScope.Var('pod_combat_loadout_compact_view').IsSet]"
							}
							blockoverride "text" {
								text = "pod_combat_loadout_compact_view"
								max_width = 200
							}
						}
					}

					spacer = { size = { 0 4 } }

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								ignoreinvisible = yes

								####### DETAILED LIST (default) #######
								vbox = {
									layoutpolicy_horizontal = expanding
									ignoreinvisible = yes
									visible = "[Not( GetPlayer.MakeScope.Var('pod_combat_loadout_compact_view').IsSet )]"

									spacing = 4

									datamodel = "[GetGlobalList('POD_combat_moves')]"

									item = {
										pod_combat_move_button_detailed = {
											visible = "[And(GetScriptedGui('pod_combat_loadout_option').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End), GetScriptedGui('pod_combat_loadout_category_match').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"
											enabled = "[GetScriptedGui('pod_combat_loadout_option').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

											onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

											blockoverride "checkbox" {
												checked = "[GetScriptedGui('pod_combat_loadout_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
											}

											blockoverride "glow_visible" {
												visible = "[GetScriptedGui('pod_combat_loadout_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
											}

											blockoverride "fade_alpha" {
												alpha = "[Select_float( GetScriptedGui('pod_combat_loadout_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End), '(float)0.7', '(float)0.9' )]"
											}

											layoutpolicy_horizontal = expanding
										}
									}
								}

								####### COMPACT LIST (toggle) #######
								# Single-column vbox of thin row cards (was a
								# 2-up dynamicgridbox of squarer cells). Each
								# row is a `pod_combat_move_card_compact` —
								# name | basic effect | AP | checkbox in a
								# row-card layout. Switching from grid to vbox
								# means the basic-effect column has horizontal
								# room to breathe at any window width, and the
								# AP / checkbox columns line up vertically
								# across rows so the eye can scan for "what's
								# the AP cost of X?" in one column.
								vbox = {
									visible = "[GetPlayer.MakeScope.Var('pod_combat_loadout_compact_view').IsSet]"
									layoutpolicy_horizontal = expanding
									ignoreinvisible = yes
									spacing = 2

									datamodel = "[GetGlobalList('POD_combat_moves')]"

									item = {
										pod_combat_move_card_compact = {
											visible = "[And(GetScriptedGui('pod_combat_loadout_option').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End), GetScriptedGui('pod_combat_loadout_category_match').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"
											enabled = "[GetScriptedGui('pod_combat_loadout_option').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

											onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

											# Checkbox checked state mirrors the
											# detailed-card pattern — driven by
											# the loadout-toggle SGUI's IsShown
											# (true when the move is in the
											# player's pod_combat_loadout list).
											blockoverride "checkbox" {
												checked = "[GetScriptedGui('pod_combat_loadout_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
											}
										}
									}
								}

								expand = {}
							}
						}
					}
				}
			}
		}
	}
}


##############################
###### WIDGET TEMPLATES
##############################
# Reusable button templates for datamodel rows.
#
# All templates expect Scope.Story to be a story_cycle of type
# POD_combat_move (provided by the parent datamodel item).

template pod_combat_button_bg {
	background = {
		texture = "gfx/interface/colors/black.dds"
		margin = { -2 -2 }
		alpha = 0.5

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_corner.dds"
			blend_mode = alphamultiply
			alpha = 0.3
		}
	}

	background = {
		block "bg_texture" {
			texture = "[Scope.Story.MakeScope.Var('decision').DecisionType.GetPicture(GetPlayer.Self)]"
		}
		fittype = centercrop
		framesize = { 1100 440 }
		alpha = .8

		margin = { -4 -4 }

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_corner.dds"
			blend_mode = alphamultiply
			mirror = vertical
			block "fade_alpha" { alpha = 0.8 }
		}
	}
}

# Reusable category-color left-edge stripe used by all three move-card
# types below (compact button, compact row card, detailed card). Four
# mutually-exclusive 3-wide bars pinned to the parent widget's left
# edge, each visible only when the move's combat_category matches.
# `parentanchor = left|vcenter` + `size = { 3 100% }` stretches full
# parent height; `alwaystransparent = yes` keeps clicks routing through
# to the underlying button.
#
# Colour palette (kept in sync with the equivalent stripes baked into
# button_combat_base in pod_combat_window.gui — those style the
# in-combat move bar; this template styles the loadout-picker rows):
#   ATK = warm red    { 0.76 0.33 0.31 1 }
#   DEF = cool blue   { 0.37 0.56 0.78 1 }
#   CTL = soft purple { 0.60 0.48 0.83 1 }
#   PWR = warm orange { 0.9  0.55 0.15 1 }
template pod_combat_category_stripe {
	widget = {
		visible = "[GetScriptedGui('pod_combat_is_atk_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
		parentanchor = left|vcenter
		size = { 3 100% }
		alwaystransparent = yes
		background = {
			texture = "gfx/interface/colors/white.dds"
			color = { 0.76 0.33 0.31 1 }
		}
	}
	widget = {
		visible = "[GetScriptedGui('pod_combat_is_def_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
		parentanchor = left|vcenter
		size = { 3 100% }
		alwaystransparent = yes
		background = {
			texture = "gfx/interface/colors/white.dds"
			color = { 0.37 0.56 0.78 1 }
		}
	}
	widget = {
		visible = "[GetScriptedGui('pod_combat_is_ctl_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
		parentanchor = left|vcenter
		size = { 3 100% }
		alwaystransparent = yes
		background = {
			texture = "gfx/interface/colors/white.dds"
			color = { 0.60 0.48 0.83 1 }
		}
	}
	widget = {
		visible = "[GetScriptedGui('pod_combat_is_pwr_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
		parentanchor = left|vcenter
		size = { 3 100% }
		alwaystransparent = yes
		background = {
			texture = "gfx/interface/colors/white.dds"
			color = { 0.9 0.55 0.15 1 }
		}
	}
}


types PODCombatTypes {

	type pod_combat_move_button_compact = button_standard {
		size = { 240 40 }

		tooltipwidget = {
			pod_fancy_combat_move_tooltip = {
				# Locked rows (show-all view) explain themselves: the move's
				# requirements render via the engine's own condition text
				# (GetCommandDescForPlayer on the move's hidden decision;
				# is_valid_showing_failures_only shows only FAILED lines).
				blockoverride "additional_text" {
					text_multi = {
						visible = "[Not(GetScriptedGui('pod_combat_loadout_option').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"
						raw_text = "[Scope.Story.MakeScope.Var('decision').DecisionType.GetCommandDescForPlayer]"
						default_format = "#weak"
						autoresize = yes
						maximumsize = { 500 -1 }
						align = center
						alwaystransparent = yes
					}
				}
			}
		}

		# Two mutually-exclusive backgrounds, gated on the
		# pod_combat_loadout_compact_view toggle:
		#   * OFF (default / detailed view) — the fancy decision-art
		#     bg that pairs with the pool column's detailed cards.
		#   * ON (compact view) — a flat dark tint matching the
		#     pool column's row-card layout.
		# Result: the equipped column on the left always uses the
		# same visual treatment as whichever pool view is currently
		# active on the right, so the two columns read as one
		# stylistic family in either mode.
		widget = {
			visible = "[Not( GetPlayer.MakeScope.Var('pod_combat_loadout_compact_view').IsSet )]"
			size = { 100% 100% }
			using = pod_combat_button_bg
		}
		widget = {
			visible = "[GetPlayer.MakeScope.Var('pod_combat_loadout_compact_view').IsSet]"
			size = { 100% 100% }
			background = {
				texture = "gfx/interface/colors/white.dds"
				color = { 0.05 0.07 0.1 0.85 }
			}
		}

		# Category-color left-edge stripe — see template definition
		# above this types block for the 4-widget pattern and rationale.
		using = pod_combat_category_stripe

		# Title text — left-anchored next to the category stripe
		# (instead of the previous centered position). The 12px
		# left margin sits the text past the 3px stripe + a small
		# gap, mirroring the mockup's `.name-block` left-aligned
		# layout. max_width still elides on overflow.
		text_single = {
			block "text_title" { text = "POD_combat_move_title" }
			block "text_format" { default_format = "#high;outline" }
			fontsize = 14
			max_width = 220
			alwaystransparent = yes
			parentanchor = left|vcenter
			margin_left = 12
		}
	}

	# Pool-list row card for the skills window's compact view —
	# a horizontal four-column row (Name | Basic Effect | AP | ☐)
	# stretched to the full pool width. Distinct from
	# `pod_combat_move_button_compact` (the 240×40 cell used by
	# the equipped column + the previous 2-column compact grid)
	# because the pool list now reads as a single column of
	# thin row cards rather than a 2-up grid of squarer cells.
	# Each row carries:
	#   * Name on the left (POD_combat_move_name — no AP suffix
	#     because AP gets its own column).
	#   * Basic effect line in the middle (via the new
	#     PODCombatMoveBasicEffectInline customizable_loc — short
	#     glanceable summary of the dominant effect, no
	#     bypass / always-hit / retaliation riders).
	#   * AP cost on the right.
	#   * Equipped-state checkbox at the far right.
	# Background + category stripe + tooltip mirror the compact
	# button so the visual family stays consistent.
	type pod_combat_move_card_compact = button_standard {
		layoutpolicy_horizontal = expanding
		size = { 100% 32 }

		tooltipwidget = {
			pod_fancy_combat_move_tooltip = {
				# Locked rows (show-all view) explain themselves: the move's
				# requirements render via the engine's own condition text
				# (GetCommandDescForPlayer on the move's hidden decision;
				# is_valid_showing_failures_only shows only FAILED lines).
				blockoverride "additional_text" {
					text_multi = {
						visible = "[Not(GetScriptedGui('pod_combat_loadout_option').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"
						raw_text = "[Scope.Story.MakeScope.Var('decision').DecisionType.GetCommandDescForPlayer]"
						default_format = "#weak"
						autoresize = yes
						maximumsize = { 500 -1 }
						align = center
						alwaystransparent = yes
					}
				}
			}
		}

		# Same subtle flat bg as the equipped-column compact pill.
		blockoverride "background_color" {
			background = {
				texture = "gfx/interface/colors/white.dds"
				color = { 0.05 0.07 0.1 0.85 }
			}
		}

		# Category-color left stripe — see template definition above
		# this types block. Same pattern used by the equipped pill +
		# detailed card so the three card variants stay visually consistent.
		using = pod_combat_category_stripe

		hbox = {
			size = { 100% 100% }
			margin = { 14 0 }
			spacing = 10
			alwaystransparent = yes

			# Name column — fixed width so the basic-effect column
			# below has a stable start position regardless of
			# move-name length. Long names elide via max_width.
			text_single = {
				text = "POD_combat_move_name"
				default_format = "#bold;V"
				fontsize = 14
				autoresize = no
				size = { 200 -1 }
				max_width = 200
				align = left|nobaseline
				alwaystransparent = yes
			}

			# Basic effect — grows to fill leftover horizontal
			# space between name and AP. Single-line; elides
			# overflow rather than wrapping so each card stays
			# one row tall.
			text_single = {
				raw_text = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).Custom('PODCombatMoveBasicEffectInline')]"
				default_format = "#weak"
				layoutpolicy_horizontal = expanding
				align = left|nobaseline
				alwaystransparent = yes
			}

			# AP cost — right-anchored numeric tag.
			text_single = {
				raw_text = "#bold;V [Scope.Story.MakeScope.Var('ap_cost').GetValue|0] #weak AP#!#!"
				autoresize = no
				size = { 48 -1 }
				align = right|nobaseline
				alwaystransparent = yes
			}

			# Equipped checkbox — same widget the detailed
			# variant uses; `checked` block is overridden by the
			# datamodel-item invocation site, which reads the
			# loadout-toggle SGUI's IsShown state.
			button_checkbox = {
				block "checkbox" {}
				alwaystransparent = yes
			}
		}
	}

	type pod_combat_move_button_detailed = button_standard {
		margin = { 8 2 }

		# No tooltipwidget — the description row below the title already
		# renders the dynamic stat block (POD_combat_move_tooltip via
		# PODCombatMoveEffect), so a hover popup would just duplicate
		# what the row shows. The compact-grid variant keeps its
		# tooltip since it doesn't have a description row.

		hbox = {
			layoutpolicy_horizontal = expanding
			resizeparent = yes

			using = pod_combat_button_bg

			spacer = { size = { 12 0 } }

			vbox = {
				layoutpolicy_horizontal = expanding
				margin = { 8 5 }
				margin_bottom = 12

				text_single = {
					# Title with AP suffix. This detailed-button variant
					# sits in the loadout picker AWAY from any AP pip
					# header — the explicit "AP" keeps the cost unit
					# unambiguous in that detached context, matching
					# the rule used by the hover-popup tooltip title.
					# The compact-button variant (and the in-combat
					# move-bar) drop the AP word because the prominent
					# AP pip strip above the move grid carries the
					# unit context there.
					block "text_title" { text = "POD_combat_move_title_tooltip" }
					default_format = "#high;outline"
					fontsize = 16
					# Cap to match the desc text_multi below — same 500-wide
					# bound keeps the title from overflowing the button when
					# a move name with a splat icon prefix and bold formatting
					# stretches past the row's content area. text_single's
					# default elide = right kicks in once text would exceed
					# max_width, so long names render with a trailing "...".
					max_width = 500
					alwaystransparent = yes
				}

				spacer = { size = { 0 2 } }

				text_multi = {
					block "text_desc" { text = "POD_combat_move_tooltip" }
					autoresize = yes
					maximumsize = { 500 -1 }
					align = center
					alwaystransparent = yes
				}

				# Locked rows (show-all view) explain themselves INLINE here:
				# this variant has no hover tooltip (see the type header), so
				# the requirements line joins the card body. Same gate and
				# engine-rendered condition text as the compact tooltips.
				text_multi = {
					visible = "[Not(GetScriptedGui('pod_combat_loadout_option').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"
					raw_text = "[Scope.Story.MakeScope.Var('decision').DecisionType.GetCommandDescForPlayer]"
					default_format = "#weak"
					autoresize = yes
					maximumsize = { 500 -1 }
					align = center
					alwaystransparent = yes
				}
			}

			button_checkbox = {
				block "checkbox" {}
				# not actually clickable
				# the parent button tracks the clicks, this is just to track which move is equipped
				alwaystransparent = yes
			}

			spacer = { size = { 12 0 } }
		}

		# Category-color left-edge stripe — see template definition
		# above this types block. Declared AFTER the hbox above so the
		# stripe renders on top of the hbox's background art rather
		# than being buried underneath. The stripe stretches the full
		# row height (which varies with the description row's wrapped
		# text) via the template's `size = { 3 100% }`.
		using = pod_combat_category_stripe
	}

	type pod_fancy_combat_move_tooltip = widget {
		alwaystransparent = no

		using = DefaultTooltipBackground
		using = GeneralTooltipSetup

		vbox = {
			resizeparent = yes
			margin = { 14 11 }
			margin_bottom = 18

			# not reusing pod_combat_button_bg since this is slightly different
			background = {
				block "bg_texture" {
					texture = "[Scope.Story.MakeScope.Var('decision').DecisionType.GetPicture(GetPlayer.Self)]"
				}
				fittype = centercrop
				framesize = { 1100 440 }
				alpha = 0.4

				margin = { -5 -5 }

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_scratches.dds"
					blend_mode = alphamultiply
					spriteType = corneredTiled
					alpha = 0.3
					texture_density = 4
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_clouds.dds"
					blend_mode = alphamultiply
					spriteType = corneredTiled
					alpha = 0.4
				}
			}

			text_single = {
				# Default title text uses the "with AP" variant
				# (`POD_combat_move_title_tooltip`) because this
				# widget appears as a detached hover popup, away
				# from the in-window AP pip header — the unit
				# stays explicit. Callers that need a different
				# title (e.g. the combat-log row's hover, which
				# reads the move ref off the log entry's
				# var:move rather than Scope.Story) blockoverride
				# `text_title` with their own variant.
				block "text_title" { text = "POD_combat_move_title_tooltip" }
				default_format = "#high;outline"
				fontsize = 16
				alwaystransparent = yes
			}

			spacer = { size = { 0 2 } }

			text_multi = {
				block "text_desc" { text = "POD_combat_move_tooltip" }
				autoresize = yes
				maximumsize = { 500 -1 }
				align = center
				alwaystransparent = yes
			}

			block "additional_text" {}
		}
	}
}
