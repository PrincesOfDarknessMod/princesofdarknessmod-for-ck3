										text = "pod_combat_equip_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_steel_skin').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										enabled = "[GetScriptedGui('pod_combat_toggle_steel_skin').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
