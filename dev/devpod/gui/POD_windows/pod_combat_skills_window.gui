############################################
######   POD COMBAT SKILLS WINDOW
############################################
# Two columns:
#
#   Left column  - the PC's currently equipped moves (pod_combat_loadout)
#                  rendered as a compact grid of fancy-backdrop buttons.
#                  Clicking a compact button unequips it.
#
#   Right column - the available-moves pool (POD_combat_moves global
#                  list) in one of THREE views picked by the
#                  pod_combat_pool_view_* radio buttons: detailed cards
#                  (neither var set), compact row cards
#                  (pod_combat_loadout_compact_view), or the move sheet
#                  (pod_combat_sheet_view) - a sortable, filterable
#                  table over the pre-built pod_combat_sheet_rows
#                  scratch list. Detailed/compact row visibility is
#                  gated by the unlock bake (pod_combat_loadout_option
#                  SGUI); the sheet filters at list-build time instead.
#
# "Show all skills" (pod_combat_show_all_moves) is INDEPENDENT of the
# view mode: it only changes which moves are listed (locked ones too),
# never the layout. Any combination is allowed. It lists the locked
# moves of the PC's own splat families; its sub-checkbox "Show other
# splats" (pod_combat_show_other_splats) widens that to the whole
# catalogue, which is ~570 rows.
#
# Widget templates at the bottom render the fancy decision-art
# backdrops (pod_combat_button_bg), the button sizes, and the sheet's
# row/cell/header types.

@detailed_view_is_shown = "[And(Not( GetPlayer.MakeScope.Var('pod_combat_loadout_compact_view').IsSet ), Not( GetPlayer.MakeScope.Var('pod_combat_sheet_view').IsSet ))]"
@compact_view_is_shown = "[And(GetPlayer.MakeScope.Var('pod_combat_loadout_compact_view').IsSet, Not( GetPlayer.MakeScope.Var('pod_combat_sheet_view').IsSet ))]"
@sheet_view_is_shown = "[GetPlayer.MakeScope.Var('pod_combat_sheet_view').IsSet]"

@pip_size = "['(CVector2f)14,14']"

widget = {
	name = "pod_combat_skills_window"
	visible = "[And(Not(IsPauseMenuShown), And(IsDefaultGUIMode, And(GetPlayer.IsValid, And(GetPlayer.MakeScope.Var('pod_combat_config_open').IsSet, Not(PODCombatFight.Var('pod_combat_active').IsSet)))))]"
	layer = royal_court
	size = { 100% 100% }

	window = {
		parentanchor = center
		# Sized for the widest pool view (the move sheet's fixed-width
		# table + header); the detailed/compact cards are expanding and
		# simply stretch into the same pool width.
		size = { 1460 900 }
		using = Window_Background
		# not using Window_Decoration_Warfare since this gui has enough ornamentation as is
		using = Window_Decoration
		allow_outside = yes
		
		# header background
		background = {
			texture = "gfx/interface/illustrations/event_story/fp3_concession.dds"
			fittype = start
			# size of the event_story illustrations
			framesize = { 3840 1252 }
			# bg_margins from the Window_Background template
			margin = { -23 -17 }
			
			# adjust colors to match the marginalia
			modify_texture = {
				color = { 0.3 0.8 1.0 1.0 }
				blend_mode = multiply
			}
			
			# alpha mask so that it matches the frayed edges from Window_Background
			modify_texture = {
				texture = "gfx/interface/skinned/tile_window_background.dds"
				spriteType = Corneredtiled
				spriteborder = { 18 0 }
				texture_density = 2
				blend_mode = alphamultiply
			}
			
			# diagonal transparency gradient
			modify_texture = {
				texture = "gfx/interface/component_masks/mask_fade_corner.dds"
				blend_mode = alphamultiply
				# fade towards the top right (instead of the bottom right)
				mirror = vertical
			}
			
			# radial transparency gradient to lower the contrast in the center
			modify_texture = {
				texture = "gfx/interface/component_masks/mask_siege_fire.dds"
				blend_mode = alphamultiply
				alpha = 0.5
			}
			
			# vignette
			modify_texture = {
				texture = "gfx/interface/component_overlay/overlay_effect.dds"
				blend_mode = overlay
			}
			
			# some texture
			modify_texture = {
				texture = "gfx/interface/component_masks/mask_clouds.dds"
				blend_mode = alphamultiply
				spriteType = corneredTiled
				alpha = 0.5
			}
		}

		# Fade in/out when the visible binding (on the parent widget)
		# flips. _show fires on the configure-skills decision opening
		# this panel; _hide fires when the player closes it back to the
		# map (the decision is blocked mid-fight, so there is no combat
		# cross-fade path). Standard duration matches the combat
		# window's fade so the pair feels consistent.
		# Reference: CK3 Reference/gui/window_artifact_details.gui:15-24.
		state = {
			name = _show
			using = Animation_FadeIn_Standard
		}
		state = {
			name = _hide
			using = Animation_FadeOut_Standard
		}

		vbox = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			using = Window_Margins
			# NOT auto-sized (unlike the combat window): invisible children
			# still pin a box's minimum under set_parent_size_to_minimum -
			# ignoreinvisible affects positional layout, not minimum
			# propagation - so the hidden sheet header/table held the window
			# at sheet width in every pool view and the pool content
			# overflowed its scrollbox. The window is simply sized for the
			# widest view instead (see size above).

			##############################
			###### HEADER
			##############################

			header_pattern = {
				layoutpolicy_horizontal = expanding
				
				# disable the default header texture in favor of the background image
				blockoverride "header_background" { alpha = 0 }
				blockoverride "header_pattern"    { alpha = 0 }

				blockoverride "header_text" {
					# cast shadow
					text = "pod_combat_skills_title"
					font = PODGrotesque
					default_format = "#outline;color:{0.2,0.15,0.0}"
					fontsize = 34
					# the actual text, offset from the shadow
					text_single = {
						text = "pod_combat_skills_title"
						font = PODGrotesque
						default_format = "#clickable"
						fontsize = 34
						position = { -3 -2 }
						align = nobaseline
					}
				}

				blockoverride "button_close" {
					onclick = "[GetScriptedGui('pod_combat_close_skills').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			# Equipped-counts stat bar - pip strip per category + a
			# numeric TOTAL readout on the right. Each category group
			# is a clickable button (visually a label + four pip
			# icons) that filters the right-hand move pool to that
			# category: toggle, multi-select, click again to clear.
			# The pip strip telegraphs capacity at a glance: filled
			# pips = equipped slots in that category, empty pips =
			# remaining room. Category colour on both the label and
			# the filled pips lets the eye filter by category in
			# peripheral vision.
			hbox = {
				margin = { 10 5 }
				spacing = 8
				layoutpolicy_horizontal = expanding

				text_single = {
					raw_text = "[Localize('pod_combat_equipped_label')]"
					default_format = "#bold"
				}

				# ── ATK group ──
				#
				# Filter-active visual lives on the background swap
				# below (NOT on `down`). Removing `down` keeps the
				# button from holding the vanilla button_standard
				# pressed-frame (the brown clay look that clashes with
				# the dark UI); the conditional bg pair below shows
				# the flat dark tone when the filter is OFF and a
				# desaturated category-color tint when the filter is
				# ON. Click feedback during press still happens
				# briefly via button_standard's regular down animation
				# - just no persistent brown.
				button_standard = {
					size = { 112 44 }
					tooltip = "pod_combat_filter_atk_tt"
					onclick = "[GetScriptedGui('pod_combat_toggle_filter_atk').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text = ""

					# Two mutually-exclusive backgrounds gated on the
					# filter-active var. Flat dark when off, red tint
					# when on. Both use the white.dds + `color` pattern
					# so the colour channel fully drives the rendered
					# tint.
					blockoverride "background_color" {
						background = {
							visible = "[Not( GetPlayer.MakeScope.Var('pod_combat_filter_atk').IsSet )]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.05 0.07 0.1 0.85 }
						}
						background = {
							visible = "[GetPlayer.MakeScope.Var('pod_combat_filter_atk').IsSet]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.40 0.15 0.15 0.95 }
						}
					}

					# Vertical layout: category label centered above a
					# centered row of 4 pips. Stacking keeps the label
					# dead-centre and leaves the pips room at 14px
					# each; a horizontal label-then-pips row parks the
					# label against the button's left edge instead.
					vbox = {
						parentanchor = center|vcenter
						alwaystransparent = yes

						text_single = {
							text = "pod_combat_sheet_cat_atk"
							margin_bottom = -4
						}
						pod_combat_category_pips = {
							name = "pod_combat_atk_count" # name of the script value
							blockoverride "filled_pip_color" { color = { 0.76 0.33 0.31 1 } }
						}
					}
				}

				# ── DEF group ──
				button_standard = {
					size = { 112 44 }
					tooltip = "pod_combat_filter_def_tt"
					onclick = "[GetScriptedGui('pod_combat_toggle_filter_def').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text = ""

					blockoverride "background_color" {
						background = {
							visible = "[Not( GetPlayer.MakeScope.Var('pod_combat_filter_def').IsSet )]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.05 0.07 0.1 0.85 }
						}
						background = {
							visible = "[GetPlayer.MakeScope.Var('pod_combat_filter_def').IsSet]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.15 0.25 0.40 0.95 }
						}
					}

					vbox = {
						parentanchor = center|vcenter
						alwaystransparent = yes

						text_single = {
							text = "pod_combat_sheet_cat_def"
							margin_bottom = -4
						}
						pod_combat_category_pips = {
							name = "pod_combat_def_count" # name of the script value
							blockoverride "filled_pip_color" { color = { 0.37 0.56 0.78 1 } }
						}
					}
				}

				# ── CTL group ──
				button_standard = {
					size = { 112 44 }
					tooltip = "pod_combat_filter_ctl_tt"
					onclick = "[GetScriptedGui('pod_combat_toggle_filter_ctl').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text = ""

					blockoverride "background_color" {
						background = {
							visible = "[Not( GetPlayer.MakeScope.Var('pod_combat_filter_ctl').IsSet )]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.05 0.07 0.1 0.85 }
						}
						background = {
							visible = "[GetPlayer.MakeScope.Var('pod_combat_filter_ctl').IsSet]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.28 0.20 0.40 0.95 }
						}
					}

					vbox = {
						parentanchor = center|vcenter
						alwaystransparent = yes

						text_single = {
							text = "pod_combat_sheet_cat_ctl"
							margin_bottom = -4
						}
						pod_combat_category_pips = {
							name = "pod_combat_ctl_count" # name of the script value
							blockoverride "filled_pip_color" { color = { 0.60 0.48 0.83 1 } }
						}
					}
				}

				# ── PWR group ──
				button_standard = {
					size = { 112 44 }
					tooltip = "pod_combat_filter_pwr_tt"
					onclick = "[GetScriptedGui('pod_combat_toggle_filter_pwr').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text = ""

					blockoverride "background_color" {
						background = {
							visible = "[Not( GetPlayer.MakeScope.Var('pod_combat_filter_pwr').IsSet )]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.05 0.07 0.1 0.85 }
						}
						background = {
							visible = "[GetPlayer.MakeScope.Var('pod_combat_filter_pwr').IsSet]"
							texture = "gfx/interface/colors/white.dds"
							color = { 0.50 0.30 0.10 0.95 }
						}
					}

					vbox = {
						parentanchor = center|vcenter
						alwaystransparent = yes

						text_single = {
							text = "pod_combat_sheet_cat_pwr"
							margin_bottom = -4
						}
						pod_combat_category_pips = {
							name = "pod_combat_pwr_count" # name of the script value
							blockoverride "filled_pip_color" { color = { 0.9 0.55 0.15 1 } }
						}
					}
				}

				expand = {}

				# TOTAL display - bold-gold equipped count + muted
				# pod_combat_max_equipped, matching the AP pip-strip
				# readout in the combat window. Clicking the
				# surrounding button runs pod_combat_clear_filters,
				# dropping all four category filters. Height matches
				# the category buttons' 44px so the stat bar reads as
				# one horizontal strip.
				button_standard = {
					size = { 110 44 }
					tooltip = "pod_combat_filter_total_tt"
					onclick = "[GetScriptedGui('pod_combat_clear_filters').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text = ""

					blockoverride "background_color" {
						background = {
							texture = "gfx/interface/colors/white.dds"
							color = { 0.05 0.07 0.1 0.85 }
						}
					}

					hbox = {
						parentanchor = center|vcenter
						spacing = 6
						alwaystransparent = yes

						text_single = {
							text = "pod_combat_sheet_cat_total"
							default_format = "#weak;bold"
						}
						text_single = {
							raw_text = "#high;bold [GetPlayer.MakeScope.ScriptValue('pod_combat_equipped_count')|0]#! #weak / [GetPlayer.MakeScope.ScriptValue('pod_combat_max_equipped')|0]#!"
						}
					}
				}
			}

			divider_light = {
				layoutpolicy_horizontal = expanding
			}

			##############################
			###### SPLIT LAYOUT
			##############################

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				####### LEFT: EQUIPPED MOVES GROUPED BY CATEGORY #######
				# One vbox section per combat_category (ATK/DEF/CTL/PWR).
				# Each shares the same pod_combat_loadout datamodel but
				# filters per-item via a category-check SGUI, so only
				# moves matching that section's category render.
				# ignoreinvisible collapses hidden items so sections
				# stack cleanly without gaps.
				vbox = {
					layoutpolicy_vertical = expanding

					spacer = { size = { 300 0 } }

					text_single = {
						text = "pod_combat_loadout_equipped_header"
						default_format = "#clickable"
					}

					spacer = { size = { 0 13 } }

					# Equipped-moves scrollbox: wraps the four category
					# sections (ATK / DEF / CTL / PWR) so the column can
					# scroll vertically when the actor has many moves
					# equipped. Without this, four full categories
					# (4 x 4 compact buttons + headers + spacers) push
					# past the bottom of the editor window.
					#
					# layoutpolicy_vertical = expanding makes the scrollbox
					# absorb the leftover vertical space in the parent vbox.
					# The hint title / desc / checkboxes rendered AFTER the
					# scrollbox still pin to the bottom of the parent vbox
					# because the scrollbox claims all the slack between
					# the equipped-header and them.
					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding

					# ── ATK section ──
					vbox = {
						ignoreinvisible = yes
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_atk_count'), '(CFixedPoint)0')]"

						text_single = {
							text = "pod_combat_cat_atk_header"
							default_format = "#weak"
						}
						
						spacer = { size = { 0 3 } }

						vbox = {
							ignoreinvisible = yes
							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"
							spacing = 2

							item = {
								pod_combat_move_button_compact = {
									visible = "[GetScriptedGui('pod_combat_is_atk_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
								}
							}
						}

						spacer = { size = { 0 8 } }
					}

					# ── DEF section ──
					vbox = {
						ignoreinvisible = yes
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_def_count'), '(CFixedPoint)0')]"

						text_single = {
							text = "pod_combat_cat_def_header"
							default_format = "#weak"
						}
						
						spacer = { size = { 0 3 } }

						vbox = {
							ignoreinvisible = yes
							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"
							spacing = 2

							item = {
								pod_combat_move_button_compact = {
									visible = "[GetScriptedGui('pod_combat_is_def_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
								}
							}
						}

						spacer = { size = { 0 8 } }
					}

					# ── CTL section ──
					vbox = {
						ignoreinvisible = yes
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_ctl_count'), '(CFixedPoint)0')]"

						text_single = {
							text = "pod_combat_cat_ctl_header"
							default_format = "#weak"
						}
						
						spacer = { size = { 0 3 } }

						vbox = {
							ignoreinvisible = yes
							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"
							spacing = 2

							item = {
								pod_combat_move_button_compact = {
									visible = "[GetScriptedGui('pod_combat_is_ctl_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
								}
							}
						}

						spacer = { size = { 0 8 } }
					}

					# ── PWR section ──
					vbox = {
						ignoreinvisible = yes
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pwr_count'), '(CFixedPoint)0')]"

						text_single = {
							text = "pod_combat_cat_pwr_header"
							default_format = "#weak"
						}
						
						spacer = { size = { 0 3 } }

						vbox = {
							ignoreinvisible = yes
							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"
							spacing = 2

							item = {
								pod_combat_move_button_compact = {
									visible = "[GetScriptedGui('pod_combat_is_pwr_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
								}
							}
						}
					}

							}
						}
					}

					text_single = {
						text = "pod_combat_loadout_hint_title"
						default_format = "#clickable"
					}
					# text_multi (not text_single) - text_single keeps the
					# whole loc on one line and lets it overflow / clip;
					# text_multi wraps at the maximumsize width below.
					text_multi = {
						text = "pod_combat_loadout_hint_desc"
						default_format = "#weak;outline"
						autoresize = yes
						maximumsize = { 290 -1 }
					}

					spacer = { size = { 0 24 } }
				}

				####### RIGHT: AVAILABLE MOVES #######
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					ignoreinvisible = yes

					# Toggle row - fixed 24-tall so it lines up with
					# the equipped column's wrapped header on the
					# left. Without the explicit height, this row
					# auto-sizes to the checkbox texture (slightly
					# taller than a bare text_single) and the right
					# scrollbox starts a few pixels lower than the
					# left.
					hbox = {
						minimumsize = { -1 24 }
						maximumsize = { -1 24 }
						ignoreinvisible = yes
						spacing = 8
						button_checkbox_label = {
							onclick = "[GetScriptedGui('pod_combat_loadout_show_all_moves').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

							blockoverride "checkbox" {
								# Reads the flag the SGUI actually toggles (a
								# past regression had this bound to a var that
								# nothing sets).
								checked = "[GetPlayer.MakeScope.Var('pod_combat_show_all_moves').IsSet]"
							}
							blockoverride "text" {
								text = "pod_combat_loadout_show_all"
								max_width = 160
							}
						}

						# Sub-toggle of the checkbox above, so it only exists
						# while that one is checked. The hbox ignoreinvisible
						# collapses the gap when it is hidden.
						button_checkbox_label = {
							visible = "[GetPlayer.MakeScope.Var('pod_combat_show_all_moves').IsSet]"
							onclick = "[GetScriptedGui('pod_combat_loadout_show_other_splats').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

							blockoverride "checkbox" {
								checked = "[GetPlayer.MakeScope.Var('pod_combat_show_other_splats').IsSet]"
							}
							blockoverride "text" {
								text = "pod_combat_loadout_show_other_splats"
								max_width = 140
							}
						}

						expand = {}

						# Pool view mode - three exclusive presence-var states
						# (Detailed = neither var set); the SGUIs enforce
						# exclusivity and their is_shown doubles as the
						# pressed-state binding. See pod_combat_skill_guis.txt.
						button_standard = {
							size = { 78 24 }
							text = "pod_combat_pool_view_detailed_l"
							tooltip = "pod_combat_pool_view_tt"
							onclick = "[GetScriptedGui('pod_combat_pool_view_detailed').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							down = "[GetScriptedGui('pod_combat_pool_view_detailed').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_standard = {
							size = { 78 24 }
							text = "pod_combat_pool_view_compact_l"
							tooltip = "pod_combat_pool_view_tt"
							onclick = "[GetScriptedGui('pod_combat_pool_view_compact').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							down = "[GetScriptedGui('pod_combat_pool_view_compact').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
						button_standard = {
							size = { 78 24 }
							text = "pod_combat_pool_view_sheet_l"
							tooltip = "pod_combat_pool_view_tt"
							onclick = "[GetScriptedGui('pod_combat_pool_view_sheet').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							down = "[GetScriptedGui('pod_combat_pool_view_sheet').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}

						button_standard = {
							visible = @sheet_view_is_shown
							size = { 66 24 }
							text = "pod_combat_sheet_filters_open"
							tooltip = "pod_combat_sheet_filters_open_tt"
							onclick = "[GetVariableSystem.Toggle('pod_combat_sheet_filters')]"
							down = "[GetVariableSystem.Exists('pod_combat_sheet_filters')]"
						}

						button_standard = {
							size = { 150 24 }
							text = "pod_combat_preset_open"
							tooltip = "pod_combat_preset_open_tt"
							onclick = "[GetVariableSystem.Toggle('pod_combat_presets_panel')]"
						}
					}

					spacer = { size = { 0 4 } }

					# ── Sheet header ──
					# Same type as the data rows with EVERY cell overridden,
					# so none of the type's Scope.Story bindings evaluate
					# outside a datamodel item (the ledger alignment trick:
					# one type = header and columns can never drift apart).
					# Sits above the scrollbox so it never scrolls away;
					# margin_left mirrors the scrollbox content margin so
					# header cells sit over the row cells.
					pod_combat_sheet_row = {
						visible = @sheet_view_is_shown
						layoutpolicy_horizontal = expanding
						margin_left = 15
						blockoverride "row_decor" {
							background = { using = Background_Area }
						}
						blockoverride "cell_equip" {
							widget = { size = { 30 30 } }
						}
						blockoverride "cell_name" {
							widget = {
								size = { 230 30 }
								text_single = {
									parentanchor = vcenter
									margin_left = 4
									text = "pod_combat_sheet_h_name"
									default_format = "#weak;bold"
									tooltip = "pod_combat_sheet_no_sort_tt"
									align = left|nobaseline
								}
							}
						}
						blockoverride "cell_cat" {
							pod_combat_sheet_text_cell = {
								size = { 45 30 }
								tooltip = "pod_combat_sheet_no_sort_tt"
								blockoverride "cell_text" {
									text = "pod_combat_sheet_h_cat"
									default_format = "#weak;bold"
								}
							}
						}
						blockoverride "cell_ap" {
							pod_combat_sheet_sort_button = {
								size = { 35 30 }
								text = "pod_combat_sheet_h_ap"
								tooltip = "pod_combat_sheet_sort_tt"
								onclick = "[GetScriptedGui('pod_combat_sheet_sort_ap').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								down = "[GetScriptedGui('pod_combat_sheet_sort_ap').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								blockoverride "sort_arrow" {
									visible = "[GetScriptedGui('pod_combat_sheet_sort_ap').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
						}
						blockoverride "cell_energy" {
							pod_combat_sheet_sort_button = {
								size = { 108 30 }
								text = "pod_combat_sheet_h_energy"
								tooltip = "pod_combat_sheet_sort_tt"
								onclick = "[GetScriptedGui('pod_combat_sheet_sort_energy').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								down = "[GetScriptedGui('pod_combat_sheet_sort_energy').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								blockoverride "sort_arrow" {
									visible = "[GetScriptedGui('pod_combat_sheet_sort_energy').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
						}
						blockoverride "cell_dmg" {
							pod_combat_sheet_sort_button = {
								size = { 45 30 }
								text = "pod_combat_sheet_h_dmg"
								tooltip = "pod_combat_sheet_sort_tt"
								onclick = "[GetScriptedGui('pod_combat_sheet_sort_damage').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								down = "[GetScriptedGui('pod_combat_sheet_sort_damage').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								blockoverride "sort_arrow" {
									visible = "[GetScriptedGui('pod_combat_sheet_sort_damage').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
						}
						blockoverride "cell_type" {
							pod_combat_sheet_text_cell = {
								size = { 30 30 }
								tooltip = "pod_combat_sheet_h_type_tt"
								blockoverride "cell_text" {
									text = "pod_combat_sheet_h_type"
									default_format = "#weak;bold"
								}
							}
						}
						blockoverride "cell_heal" {
							pod_combat_sheet_sort_button = {
								size = { 45 30 }
								text = "pod_combat_sheet_h_heal"
								tooltip = "pod_combat_sheet_sort_tt"
								onclick = "[GetScriptedGui('pod_combat_sheet_sort_heal').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								down = "[GetScriptedGui('pod_combat_sheet_sort_heal').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								blockoverride "sort_arrow" {
									visible = "[GetScriptedGui('pod_combat_sheet_sort_heal').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
						}
						blockoverride "cell_mor" {
							pod_combat_sheet_sort_button = {
								size = { 45 30 }
								text = "pod_combat_sheet_h_mor"
								tooltip = "pod_combat_sheet_sort_tt"
								onclick = "[GetScriptedGui('pod_combat_sheet_sort_morale').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								down = "[GetScriptedGui('pod_combat_sheet_sort_morale').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								blockoverride "sort_arrow" {
									visible = "[GetScriptedGui('pod_combat_sheet_sort_morale').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
						}
						blockoverride "cell_dot" {
							pod_combat_sheet_sort_button = {
								size = { 55 30 }
								text = "pod_combat_sheet_h_dot"
								tooltip = "pod_combat_sheet_sort_tt"
								onclick = "[GetScriptedGui('pod_combat_sheet_sort_dot').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								down = "[GetScriptedGui('pod_combat_sheet_sort_dot').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								blockoverride "sort_arrow" {
									visible = "[GetScriptedGui('pod_combat_sheet_sort_dot').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
						}
						blockoverride "cell_apswing" {
							pod_combat_sheet_sort_button = {
								size = { 48 30 }
								text = "pod_combat_sheet_h_apswing"
								tooltip = "pod_combat_sheet_h_apswing_tt"
								onclick = "[GetScriptedGui('pod_combat_sheet_sort_apswing').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								down = "[GetScriptedGui('pod_combat_sheet_sort_apswing').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								blockoverride "sort_arrow" {
									visible = "[GetScriptedGui('pod_combat_sheet_sort_apswing').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								}
							}
						}
						blockoverride "cell_target" {
							pod_combat_sheet_text_cell = {
								size = { 85 30 }
								tooltip = "pod_combat_sheet_no_sort_tt"
								blockoverride "cell_text" {
									text = "pod_combat_sheet_h_target"
									default_format = "#weak;bold"
								}
							}
						}
						blockoverride "cell_hit" {
							pod_combat_sheet_text_cell = {
								size = { 50 30 }
								tooltip = "pod_combat_sheet_no_sort_tt"
								blockoverride "cell_text" {
									text = "pod_combat_sheet_h_hit"
									default_format = "#weak;bold"
								}
							}
						}
						blockoverride "cell_use" {
							pod_combat_sheet_text_cell = {
								size = { 50 30 }
								tooltip = "pod_combat_sheet_h_use_tt"
								blockoverride "cell_text" {
									text = "pod_combat_sheet_h_use"
									default_format = "#weak;bold"
								}
							}
						}
						blockoverride "cell_fx" {
							pod_combat_sheet_text_cell = {
								size = { 60 30 }
								tooltip = "pod_combat_sheet_h_fx_tt"
								blockoverride "cell_text" {
									text = "pod_combat_sheet_h_fx"
									default_format = "#weak;bold"
								}
							}
						}

						# Left-anchors the fixed cells in the expanding hbox
						# (matching the grid below); without it they center.
						expand = {}
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								ignoreinvisible = yes

								####### DETAILED LIST (default) #######
								vbox = {
									layoutpolicy_horizontal = expanding
									max_width = 640
									ignoreinvisible = yes
									visible = @detailed_view_is_shown

									spacing = 6

									datamodel = "[GetGlobalList('POD_combat_moves')]"

									item = {
										pod_combat_move_button_detailed = {
											visible = "[And(GetScriptedGui('pod_combat_loadout_option').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End), GetScriptedGui('pod_combat_loadout_category_match').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"
											# Unlock AND capacity: the toggle refuses a cap-full equip, so
											# without the room term the row looks live and clicks to nothing.
											enabled = "[And(GetScriptedGui('pod_combat_loadout_option').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End), GetScriptedGui('pod_combat_loadout_room').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"

											onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

											blockoverride "checkbox" {
												checked = "[GetScriptedGui('pod_combat_loadout_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
											}

											blockoverride "glow_visible" {
												visible = "[GetScriptedGui('pod_combat_loadout_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
											}

											blockoverride "fade_alpha" {
												alpha = 0.95
											}

											layoutpolicy_horizontal = expanding
										}
									}
								}

								####### COMPACT LIST (toggle) #######
								# Single-column vbox of thin row cards, one
								# `pod_combat_move_card_compact` per move:
								# name | basic effect | AP | checkbox. A vbox
								# rather than a grid gives the basic-effect
								# column horizontal room at any window width
								# and lines the AP / checkbox columns up
								# vertically, so the eye can scan for "what's
								# the AP cost of X?" in one column.
								vbox = {
									visible = @compact_view_is_shown
									layoutpolicy_horizontal = expanding
									ignoreinvisible = yes
									spacing = 2

									datamodel = "[GetGlobalList('POD_combat_moves')]"

									item = {
										pod_combat_move_card_compact = {
											visible = "[And(GetScriptedGui('pod_combat_loadout_option').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End), GetScriptedGui('pod_combat_loadout_category_match').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"
											# Unlock AND capacity - see the detailed card above.
											enabled = "[And(GetScriptedGui('pod_combat_loadout_option').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End), GetScriptedGui('pod_combat_loadout_room').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"

											onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

											# Checkbox checked state mirrors the
											# detailed-card pattern - driven by
											# the loadout-toggle SGUI's IsShown
											# (true when the move is in the
											# player's pod_combat_loadout list).
											blockoverride "checkbox" {
												checked = "[GetScriptedGui('pod_combat_loadout_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
											}
										}
									}
								}

								####### SHEET LIST (spreadsheet view) #######
								# Rows come pre-filtered AND pre-sorted from
								# the pod_combat_sheet_rows scratch list
								# (insertion order = display order), so no
								# per-row visible gates. The header
								# lives above the scrollbox.
								fixedgridbox = {
									visible = @sheet_view_is_shown
									layoutpolicy_horizontal = expanding
									addcolumn = 1024
									addrow = 32
									# Items forced to the cell size (ledger
									# pattern). NO datamodel_reuse_widgets:
									# recycling without pinned item sizes
									# drew ghost bands and misplaced rows;
									# the pre-filtered list is small enough
									# that recycling buys nothing anyway.
									setitemsizefromcell = yes
									datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_sheet_rows')]"

									item = {
										pod_combat_sheet_row = {}
									}
								}
								text_single = {
									visible = "[And(GetPlayer.MakeScope.Var('pod_combat_sheet_view').IsSet, IsDataModelEmpty(GetPlayer.MakeScope.GetList('pod_combat_sheet_rows')))]"
									text = "pod_combat_sheet_empty"
									default_format = "#weak"
								}

								expand = {}
							}
						}
					}
				}
			}
		}
		# floral marginalia pattern, only visible in the detailed view
		# manually setting their position is very jank
		# but it's the easiest way to place these in the existing layout
		pod_combat_skills_window_marginalia = {
			visible = @detailed_view_is_shown
			parentanchor = bottom|right
			position = { -906 -22 }
			blockoverride "mirror" { mirror = horizontal }
		}
		pod_combat_skills_window_marginalia = {
			visible = @detailed_view_is_shown
			parentanchor = bottom|right
			position = { -55 -22 }
		}
	}

	# Saved-loadout presets: a movable, decorated sub-window styled to match the skills
	# window (Window_Background + Window_Decoration + header_pattern). GUI-local
	# visibility (pod_combat_presets_panel); no script state. Four slots; each row reads
	# its count from pod_combat_saved_loadout_N_count and drives the per-slot SGUIs.
	# Later sibling than the skills window, so it draws on top; movable = yes lets the
	# player drag it by the header (the standard CK3 drag handle).
	window = {
		name = "pod_combat_presets_window"
		# Initial dock: the skills window is screen-centered, so center plus an
		# x-offset near its half-width lands this at the top-right; widgetanchor
		# top|left puts it just inside the right edge (the offset predates the
		# sheet-view widening). The player can drag it from there.
		parentanchor = center
		widgetanchor = top|left
		position = { 646 -450 }
		size = { 480 320 }
		movable = yes
		using = Window_Background
		using = Window_Decoration
		visible = "[GetVariableSystem.Exists('pod_combat_presets_panel')]"

		state = { name = _show  using = Animation_FadeIn_Standard }
		state = { name = _hide  using = Animation_FadeOut_Standard }

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			using = Window_Margins

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text" {
					text = "pod_combat_preset_window_title"
				}

				blockoverride "button_close" {
					onclick = "[GetVariableSystem.Clear('pod_combat_presets_panel')]"
				}
			}

			spacer = { size = { 0 6 } }
			hbox = {
				minimumsize = { -1 34 }
				text_single = {
					minimumsize = { 110 -1 }
					fontsize = 16
					text = "pod_combat_preset_slot_1"
				}
				text_single = {
					minimumsize = { 80 -1 }
					fontsize = 14
					default_format = "#weak"
					text = "pod_combat_preset_count_1"
				}
				expand = {}
				button_standard = {
					size = { 64 28 }
					text = "pod_combat_preset_save"
					tooltip = "pod_combat_preset_save_tt"
					onclick = "[GetScriptedGui('pod_combat_save_loadout_slot_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					enabled = "[GetScriptedGui('pod_combat_save_loadout_slot_1').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				button_standard = {
					size = { 64 28 }
					text = "pod_combat_preset_load"
					tooltip = "pod_combat_preset_load_tt"
					onclick = "[GetScriptedGui('pod_combat_load_loadout_slot_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					enabled = "[GetScriptedGui('pod_combat_load_loadout_slot_1').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				button_standard = {
					size = { 64 28 }
					text = "pod_combat_preset_clear"
					onclick = "[GetScriptedGui('pod_combat_clear_loadout_slot_1').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					enabled = "[GetScriptedGui('pod_combat_clear_loadout_slot_1').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				spacer = { size = { 6 0 } }
			}
			spacer = { size = { 0 4 } }
			hbox = {
				minimumsize = { -1 34 }
				text_single = {
					minimumsize = { 110 -1 }
					fontsize = 16
					text = "pod_combat_preset_slot_2"
				}
				text_single = {
					minimumsize = { 80 -1 }
					fontsize = 14
					default_format = "#weak"
					text = "pod_combat_preset_count_2"
				}
				expand = {}
				button_standard = {
					size = { 64 28 }
					text = "pod_combat_preset_save"
					tooltip = "pod_combat_preset_save_tt"
					onclick = "[GetScriptedGui('pod_combat_save_loadout_slot_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					enabled = "[GetScriptedGui('pod_combat_save_loadout_slot_2').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				button_standard = {
					size = { 64 28 }
					text = "pod_combat_preset_load"
					tooltip = "pod_combat_preset_load_tt"
					onclick = "[GetScriptedGui('pod_combat_load_loadout_slot_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					enabled = "[GetScriptedGui('pod_combat_load_loadout_slot_2').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				button_standard = {
					size = { 64 28 }
					text = "pod_combat_preset_clear"
					onclick = "[GetScriptedGui('pod_combat_clear_loadout_slot_2').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					enabled = "[GetScriptedGui('pod_combat_clear_loadout_slot_2').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				spacer = { size = { 6 0 } }
			}
			spacer = { size = { 0 4 } }
			hbox = {
				minimumsize = { -1 34 }
				text_single = {
					minimumsize = { 110 -1 }
					fontsize = 16
					text = "pod_combat_preset_slot_3"
				}
				text_single = {
					minimumsize = { 80 -1 }
					fontsize = 14
					default_format = "#weak"
					text = "pod_combat_preset_count_3"
				}
				expand = {}
				button_standard = {
					size = { 64 28 }
					text = "pod_combat_preset_save"
					tooltip = "pod_combat_preset_save_tt"
					onclick = "[GetScriptedGui('pod_combat_save_loadout_slot_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					enabled = "[GetScriptedGui('pod_combat_save_loadout_slot_3').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				button_standard = {
					size = { 64 28 }
					text = "pod_combat_preset_load"
					tooltip = "pod_combat_preset_load_tt"
					onclick = "[GetScriptedGui('pod_combat_load_loadout_slot_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					enabled = "[GetScriptedGui('pod_combat_load_loadout_slot_3').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				button_standard = {
					size = { 64 28 }
					text = "pod_combat_preset_clear"
					onclick = "[GetScriptedGui('pod_combat_clear_loadout_slot_3').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					enabled = "[GetScriptedGui('pod_combat_clear_loadout_slot_3').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				spacer = { size = { 6 0 } }
			}
			spacer = { size = { 0 4 } }
			hbox = {
				minimumsize = { -1 34 }
				text_single = {
					minimumsize = { 110 -1 }
					fontsize = 16
					text = "pod_combat_preset_slot_4"
				}
				text_single = {
					minimumsize = { 80 -1 }
					fontsize = 14
					default_format = "#weak"
					text = "pod_combat_preset_count_4"
				}
				expand = {}
				button_standard = {
					size = { 64 28 }
					text = "pod_combat_preset_save"
					tooltip = "pod_combat_preset_save_tt"
					onclick = "[GetScriptedGui('pod_combat_save_loadout_slot_4').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					enabled = "[GetScriptedGui('pod_combat_save_loadout_slot_4').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				button_standard = {
					size = { 64 28 }
					text = "pod_combat_preset_load"
					tooltip = "pod_combat_preset_load_tt"
					onclick = "[GetScriptedGui('pod_combat_load_loadout_slot_4').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					enabled = "[GetScriptedGui('pod_combat_load_loadout_slot_4').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				button_standard = {
					size = { 64 28 }
					text = "pod_combat_preset_clear"
					onclick = "[GetScriptedGui('pod_combat_clear_loadout_slot_4').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					enabled = "[GetScriptedGui('pod_combat_clear_loadout_slot_4').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
				spacer = { size = { 6 0 } }
			}
			spacer = { size = { 0 4 } }
			expand = {}
		}
	}

	# Sheet filter popup - same GUI-local subwindow pattern as the presets
	# panel above (GetVariableSystem open/close; script never reads the
	# open state). The FILTER VALUES are character vars though: the
	# rebuild effect's limit reads them, so every checkbox goes through
	# an SGUI. Category rows share the editor-wide filter flags (the
	# pip-strip header buttons toggle the same ones); the rest are
	# sheet-only presence filters. Docked below the presets panel's spot,
	# just inside the window's right edge, where it overlaps the last
	# sheet columns while open - the window is movable, so cosmetic.
	window = {
		name = "pod_combat_sheet_filter_window"
		parentanchor = center
		widgetanchor = top|left
		position = { 646 -110 }
		size = { 385 560 }
		movable = yes
		using = Window_Background
		using = Window_Decoration
		# Only meaningful in sheet view; the auto_close state also clears
		# the toggle when the player switches pool views, so the popup
		# doesn't surprise-reopen on the next visit to the sheet (ledger
		# filter-window idiom: window_ledger.gui auto_close).
		visible = "[And(GetVariableSystem.Exists('pod_combat_sheet_filters'), And(GetPlayer.IsValid, GetPlayer.MakeScope.Var('pod_combat_sheet_view').IsSet))]"

		state = {
			name = auto_close
			trigger_when = "[And(GetPlayer.IsValid, Not(GetPlayer.MakeScope.Var('pod_combat_sheet_view').IsSet))]"
			on_finish = "[GetVariableSystem.Clear('pod_combat_sheet_filters')]"
		}

		state = { name = _show  using = Animation_FadeIn_Standard }
		state = { name = _hide  using = Animation_FadeOut_Standard }

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			using = Window_Margins

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text" {
					text = "pod_combat_sheet_filters_title"
				}

				blockoverride "button_close" {
					onclick = "[GetVariableSystem.Clear('pod_combat_sheet_filters')]"
				}
			}

			spacer = { size = { 0 6 } }

			text_single = {
				text = "pod_combat_sheet_f_cats_l"
				default_format = "#weak"
			}
			button_checkbox_label = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetScriptedGui('pod_combat_toggle_filter_atk').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				blockoverride "checkbox" {
					checked = "[GetPlayer.MakeScope.Var('pod_combat_filter_atk').IsSet]"
				}
				blockoverride "text" {
					text = "pod_combat_cat_atk_header"
				}
			}
			button_checkbox_label = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetScriptedGui('pod_combat_toggle_filter_def').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				blockoverride "checkbox" {
					checked = "[GetPlayer.MakeScope.Var('pod_combat_filter_def').IsSet]"
				}
				blockoverride "text" {
					text = "pod_combat_cat_def_header"
				}
			}
			button_checkbox_label = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetScriptedGui('pod_combat_toggle_filter_ctl').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				blockoverride "checkbox" {
					checked = "[GetPlayer.MakeScope.Var('pod_combat_filter_ctl').IsSet]"
				}
				blockoverride "text" {
					text = "pod_combat_cat_ctl_header"
				}
			}
			button_checkbox_label = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetScriptedGui('pod_combat_toggle_filter_pwr').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				blockoverride "checkbox" {
					checked = "[GetPlayer.MakeScope.Var('pod_combat_filter_pwr').IsSet]"
				}
				blockoverride "text" {
					text = "pod_combat_cat_pwr_header"
				}
			}

			divider_light = {
				layoutpolicy_horizontal = expanding
			}
			spacer = { size = { 0 4 } }
			button_checkbox_label = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetScriptedGui('pod_combat_sheet_filter_equipped').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				blockoverride "checkbox" {
					checked = "[GetPlayer.MakeScope.Var('pod_combat_sheet_f_equipped').IsSet]"
				}
				blockoverride "text" {
					text = "pod_combat_sheet_f_equipped_l"
				}
			}
			button_checkbox_label = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetScriptedGui('pod_combat_sheet_filter_damage').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				blockoverride "checkbox" {
					checked = "[GetPlayer.MakeScope.Var('pod_combat_sheet_f_damage').IsSet]"
				}
				blockoverride "text" {
					text = "pod_combat_sheet_f_damage_l"
				}
			}
			button_checkbox_label = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetScriptedGui('pod_combat_sheet_filter_heal').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				blockoverride "checkbox" {
					checked = "[GetPlayer.MakeScope.Var('pod_combat_sheet_f_heal').IsSet]"
				}
				blockoverride "text" {
					text = "pod_combat_sheet_f_heal_l"
				}
			}
			button_checkbox_label = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetScriptedGui('pod_combat_sheet_filter_energy').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				blockoverride "checkbox" {
					checked = "[GetPlayer.MakeScope.Var('pod_combat_sheet_f_energy').IsSet]"
				}
				blockoverride "text" {
					text = "pod_combat_sheet_f_energy_l"
				}
			}
			button_checkbox_label = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetScriptedGui('pod_combat_sheet_filter_agg').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				blockoverride "checkbox" {
					checked = "[GetPlayer.MakeScope.Var('pod_combat_sheet_f_agg').IsSet]"
				}
				blockoverride "text" {
					text = "pod_combat_sheet_f_agg_l"
				}
			}
			button_checkbox_label = {
				layoutpolicy_horizontal = expanding
				tooltip = "pod_combat_sheet_f_elemental_tt"
				onclick = "[GetScriptedGui('pod_combat_sheet_filter_elemental').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				blockoverride "checkbox" {
					checked = "[GetPlayer.MakeScope.Var('pod_combat_sheet_f_elemental').IsSet]"
				}
				blockoverride "text" {
					text = "pod_combat_sheet_f_elemental_l"
				}
			}
			button_checkbox_label = {
				layoutpolicy_horizontal = expanding
				onclick = "[GetScriptedGui('pod_combat_sheet_filter_conditional').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				blockoverride "checkbox" {
					checked = "[GetPlayer.MakeScope.Var('pod_combat_sheet_f_conditional').IsSet]"
				}
				blockoverride "text" {
					text = "pod_combat_sheet_f_conditional_l"
				}
			}

			divider_light = {
				layoutpolicy_horizontal = expanding
			}
			spacer = { size = { 0 6 } }

			button_standard = {
				size = { 120 26 }
				text = "pod_combat_sheet_reset"
				tooltip = "pod_combat_sheet_reset_tt"
				onclick = "[GetScriptedGui('pod_combat_sheet_reset').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}

			expand = {}
		}
	}
}


##############################
###### WIDGET TEMPLATES
##############################
# Reusable button templates for datamodel rows.
#
# All templates expect Scope.Story to be a story_cycle of type
# POD_combat_move (provided by the parent datamodel item).

template pod_combat_button_bg {
	background = {
		texture = "gfx/interface/colors/black.dds"
		margin = { -2 -2 }
		alpha = 0.5

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_corner.dds"
			blend_mode = alphamultiply
			alpha = 0.3
		}
	}

	background = {
		block "bg_texture" {
			texture = "[Scope.Story.MakeScope.Var('decision').DecisionType.GetPicture(GetPlayer.Self)]"
		}
		fittype = centercrop
		framesize = { 1100 440 }
		alpha = .8

		margin = { -4 -4 }
		
		# allow for greyscale if the button is disabled
		shaderfile = "gfx/FX/POD_shaders/POD_image_manipulation_shaders.shader"
		effectname = "PODGreyscaleBlend"
		
		modify_texture = {
			color = { 1 1 1 0 }
			blend_mode = multiply
			# greyscale factor (1 is fully greyscale, 0 is the original color)
			block "bnw_factor" { alpha = 0 }
		}

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_corner.dds"
			blend_mode = alphamultiply
			mirror = vertical
			block "fade_alpha" { alpha = 0.8 }
		}
	}
}

# Reusable category-color left-edge stripe used by all three move-card
# types below (compact button, compact row card, detailed card). Four
# mutually-exclusive 3-wide bars pinned to the parent widget's left
# edge, each visible only when the move's combat_category matches.
# `parentanchor = left|vcenter` + `size = { 3 100% }` stretches full
# parent height; `alwaystransparent = yes` keeps clicks routing through
# to the underlying button.
#
# Colour palette (kept in sync with the equivalent stripes baked into
# button_combat_base in pod_combat_window.gui - those style the
# in-combat move bar; this template styles the loadout-picker rows):
#   ATK = warm red    { 0.76 0.33 0.31 1 }
#   DEF = cool blue   { 0.37 0.56 0.78 1 }
#   CTL = soft purple { 0.60 0.48 0.83 1 }
#   PWR = warm orange { 0.9  0.55 0.15 1 }
template pod_combat_category_stripe {
	widget = {
		visible = "[GetScriptedGui('pod_combat_is_atk_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
		parentanchor = left|vcenter
		size = { 3 100% }
		alwaystransparent = yes
		background = {
			texture = "gfx/interface/colors/white.dds"
			color = { 0.76 0.33 0.31 1 }
		}
	}
	widget = {
		visible = "[GetScriptedGui('pod_combat_is_def_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
		parentanchor = left|vcenter
		size = { 3 100% }
		alwaystransparent = yes
		background = {
			texture = "gfx/interface/colors/white.dds"
			color = { 0.37 0.56 0.78 1 }
		}
	}
	widget = {
		visible = "[GetScriptedGui('pod_combat_is_ctl_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
		parentanchor = left|vcenter
		size = { 3 100% }
		alwaystransparent = yes
		background = {
			texture = "gfx/interface/colors/white.dds"
			color = { 0.60 0.48 0.83 1 }
		}
	}
	widget = {
		visible = "[GetScriptedGui('pod_combat_is_pwr_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
		parentanchor = left|vcenter
		size = { 3 100% }
		alwaystransparent = yes
		background = {
			texture = "gfx/interface/colors/white.dds"
			color = { 0.9 0.55 0.15 1 }
		}
	}
}


types PODCombatTypes {

	# Plain centered text cell for the move-sheet row.
	type pod_combat_sheet_text_cell = widget {
		size = { 45 30 }
		text_single = {
			parentanchor = vcenter
			size = { 100% 22 }
			autoresize = no
			fontsize = 14
			align = center|nobaseline
			block "cell_text" {
				raw_text = ""
			}
		}
	}

	# Guarded optional-stat cell: value text (bound to a 0-defaulting SV,
	# safe to evaluate even while hidden) plus a weak dash when the stat
	# is absent. Overrides supply both visibles + the value binding.
	type pod_combat_sheet_stat_cell = widget {
		size = { 45 30 }
		text_single = {
			parentanchor = vcenter
			size = { 100% 22 }
			autoresize = no
			fontsize = 14
			align = center|nobaseline
			block "stat_value" {
				visible = no
				raw_text = ""
			}
		}
		text_single = {
			parentanchor = vcenter
			size = { 100% 22 }
			autoresize = no
			fontsize = 14
			align = center|nobaseline
			default_format = "#weak"
			raw_text = "-"
			block "stat_absent" {
				visible = no
			}
		}
	}

	# Column-header sort button. The direction arrow reads the shared asc
	# flag (BoolTo1And2: unset/descending = frame 1, ascending = frame 2 -
	# which frame draws which arrow is an in-game eyeball item); instances
	# override "sort_arrow" with their column's active-check so only the
	# sorted column shows it.
	type pod_combat_sheet_sort_button = button_standard {
		size = { 45 30 }
		icon = {
			parentanchor = right|vcenter
			position = { -1 0 }
			size = { 16 16 }
			texture = "gfx/interface/buttons/button_sort_toggle.dds"
			framesize = { 36 36 }
			frame = "[BoolTo1And2(GetPlayer.MakeScope.Var('pod_combat_sheet_asc').IsSet)]"
			alwaystransparent = yes
			block "sort_arrow" {
				visible = no
			}
		}
	}

	# ── Move-sheet row ──────────────────────────────────────────
	# One spreadsheet row: fixed-width cells in an hbox. The SAME type
	# serves the data rows (the cell blocks' defaults below bind
	# Scope.Story, valid only as a pod_combat_sheet_rows datamodel item)
	# and the header (a standalone instance that overrides EVERY cell) -
	# the ledger's alignment trick: one type means header and columns
	# can never drift apart. Total width 1017 (incl. 4px gaps); the
	# grid's addcolumn keys off it.
	type pod_combat_sheet_row = hbox {
		spacing = 4

		block "row_decor" {
			background = {
				using = Background_Area
				# Even-index striping (vanilla shared template; reads the
				# datamodel index, so data rows only).
				using = Background_Alternate_Datamodel
			}
		}

		block "cell_equip" {
			widget = {
				size = { 30 30 }
				button_checkbox = {
					parentanchor = vcenter
					size = { 24 24 }
					onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
					# enabled reads the unlock via pod_combat_loadout_option
					# (pod_combat_unlocked_moves membership) AND the capacity via
					# pod_combat_loadout_room, same as the detailed and compact
					# rows. NOTE: this per-frame IsValid is the deferred
					# GUI-companion target - re-source the pool datamodel from the
					# per-char list to restore the O(1) path. Both SGUIs are
					# themselves O(1); neither runs the unlock dispatcher.
					enabled = "[And(GetScriptedGui('pod_combat_loadout_option').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End), GetScriptedGui('pod_combat_loadout_room').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"
					checked = "[GetScriptedGui('pod_combat_loadout_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
				}
			}
		}

		block "cell_name" {
			widget = {
				size = { 230 30 }
				text_single = {
					parentanchor = vcenter
					margin_left = 4
					# Category-tinted name (story = ROOT in the custom loc).
					raw_text = "[GuiScope.SetRoot(Scope.Story.MakeScope).Custom('PODCombatSheetMoveName')]"
					fontsize = 14
					autoresize = no
					size = { 226 22 }
					max_width = 226
					align = left|nobaseline
					tooltipwidget = { pod_fancy_combat_move_tooltip_editor = {} }
				}
			}
		}

		block "cell_cat" {
			pod_combat_sheet_text_cell = {
				size = { 45 30 }
				blockoverride "cell_text" {
					raw_text = "[GuiScope.SetRoot(Scope.Story.MakeScope).Custom('PODCombatSheetCatTag')]"
				}
			}
		}

		block "cell_ap" {
			pod_combat_sheet_text_cell = {
				size = { 35 30 }
				blockoverride "cell_text" {
					raw_text = "[Scope.Story.MakeScope.Var('ap_cost').GetValue|0]"
				}
			}
		}

		# Energy cost and energy restore share the column (cost, +gain, or
		# cost/+gain). The dispatcher scales both to the viewer (same Multiply
		# idiom as the tooltip cost line); the sort still uses the RAW numbers,
		# which is order-identical since the multiplier is constant per viewer.
		block "cell_energy" {
			pod_combat_sheet_stat_cell = {
				size = { 108 30 }
				blockoverride "stat_value" {
					visible = "[Or(Scope.Story.MakeScope.Var('energy_cost').IsSet, Scope.Story.MakeScope.Var('energy_gain').IsSet)]"
					raw_text = "[GuiScope.SetRoot(Scope.Story.MakeScope).Custom('PODCombatSheetEnergy')]"
				}
				blockoverride "stat_absent" {
					visible = "[And(Not(Scope.Story.MakeScope.Var('energy_cost').IsSet), Not(Scope.Story.MakeScope.Var('energy_gain').IsSet))]"
				}
			}
		}

		block "cell_dmg" {
			pod_combat_sheet_stat_cell = {
				size = { 45 30 }
				blockoverride "stat_value" {
					visible = "[Scope.Story.MakeScope.Var('hp_damage').IsSet]"
					raw_text = "[Scope.Story.MakeScope.ScriptValue('pod_combat_sheet_damage_cell_value')|0]"
				}
				blockoverride "stat_absent" {
					visible = "[Not(Scope.Story.MakeScope.Var('hp_damage').IsSet)]"
				}
			}
		}

		# Damage class, right of the number it qualifies.
		block "cell_type" {
			pod_combat_sheet_text_cell = {
				size = { 30 30 }
				blockoverride "cell_text" {
					raw_text = "[GuiScope.SetRoot(Scope.Story.MakeScope).Custom('PODCombatSheetType')]"
				}
			}
		}

		block "cell_heal" {
			pod_combat_sheet_stat_cell = {
				size = { 45 30 }
				blockoverride "stat_value" {
					visible = "[Scope.Story.MakeScope.Var('hp_heal').IsSet]"
					# Dispatched, not a bare SV read: an aggravated heal
					# appends a wound-box icon to the same centered string.
					raw_text = "[GuiScope.SetRoot(Scope.Story.MakeScope).Custom('PODCombatSheetHeal')]"
				}
				blockoverride "stat_absent" {
					visible = "[Not(Scope.Story.MakeScope.Var('hp_heal').IsSet)]"
				}
			}
		}

		# Morale damage and morale heal share the column - a move does
		# one or the other, never both.
		block "cell_mor" {
			pod_combat_sheet_stat_cell = {
				size = { 45 30 }
				blockoverride "stat_value" {
					visible = "[Or(Scope.Story.MakeScope.Var('morale_damage').IsSet, Scope.Story.MakeScope.Var('morale_heal').IsSet)]"
					raw_text = "[GuiScope.SetRoot(Scope.Story.MakeScope).Custom('PODCombatSheetMor')]"
				}
				blockoverride "stat_absent" {
					visible = "[And(Not(Scope.Story.MakeScope.Var('morale_damage').IsSet), Not(Scope.Story.MakeScope.Var('morale_heal').IsSet))]"
				}
			}
		}

		block "cell_dot" {
			pod_combat_sheet_stat_cell = {
				size = { 55 30 }
				blockoverride "stat_value" {
					visible = "[Scope.Story.MakeScope.Var('dot_amount').IsSet]"
					raw_text = "[Scope.Story.MakeScope.ScriptValue('pod_combat_sheet_dot_amount_cell_value')|0]x[Scope.Story.MakeScope.ScriptValue('pod_combat_sheet_dot_rounds_cell_value')|0]"
				}
				blockoverride "stat_absent" {
					visible = "[Not(Scope.Story.MakeScope.Var('dot_amount').IsSet)]"
				}
			}
		}

		block "cell_apswing" {
			pod_combat_sheet_text_cell = {
				size = { 48 30 }
				blockoverride "cell_text" {
					raw_text = "[GuiScope.SetRoot(Scope.Story.MakeScope).Custom('PODCombatSheetApSwing')]"
				}
			}
		}

		block "cell_target" {
			pod_combat_sheet_text_cell = {
				size = { 85 30 }
				blockoverride "cell_text" {
					# Compact table labels; the prose flag names the
					# tooltips use ("one enemy", "the player character")
					# run long and lowercase for an 85px column.
					raw_text = "[Localize(Concatenate3('pod_combat_sheet_tgt_', Scope.Story.MakeScope.Var('targeting').GetFlagKey, '_l'))]"
				}
			}
		}

		block "cell_hit" {
			widget = {
				size = { 50 30 }
				text_single = {
					parentanchor = vcenter
					size = { 100% 22 }
					autoresize = no
					fontsize = 14
					align = center|nobaseline
					default_format = "#weak"
					visible = "[Scope.Story.MakeScope.Var('requires_hit_roll').IsSet]"
					text = "pod_combat_sheet_hit_roll"
				}
				text_single = {
					parentanchor = vcenter
					size = { 100% 22 }
					autoresize = no
					fontsize = 14
					align = center|nobaseline
					default_format = "#weak"
					visible = "[Not(Scope.Story.MakeScope.Var('requires_hit_roll').IsSet)]"
					text = "pod_combat_sheet_hit_auto"
				}
			}
		}

		block "cell_use" {
			pod_combat_sheet_text_cell = {
				size = { 50 30 }
				blockoverride "cell_text" {
					raw_text = "[GuiScope.SetRoot(Scope.Story.MakeScope).Custom('PODCombatSheetUse')]"
				}
			}
		}

		# Rider markers. Character-rooted like the compact line: the
		# wrapper key chains per-rider segments off the story scope, so a
		# move carrying several riders shows all of them.
		block "cell_fx" {
			pod_combat_sheet_text_cell = {
				size = { 60 30 }
				blockoverride "cell_text" {
					raw_text = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).Custom('PODCombatSheetFx')]"
				}
			}
		}
	}

	type pod_combat_move_button_compact = button_standard {
		size = { 240 40 }

		tooltipwidget = { pod_fancy_combat_move_tooltip_editor = {} }

		# Two mutually-exclusive backgrounds, gated on the
		# pod_combat_loadout_compact_view var:
		#   * unset (detailed view, and also sheet view - the sheet
		#     clears the compact var, so it shares the fancy look) -
		#     the decision-art bg pairing with the detailed cards.
		#   * set (compact view) - a flat dark tint matching the
		#     pool column's row-card layout.
		# So the left column matches the pool view except in sheet
		# mode, where it simply keeps the detailed treatment.
		widget = {
			visible = "[Not( GetPlayer.MakeScope.Var('pod_combat_loadout_compact_view').IsSet )]"
			size = { 100% 100% }
			using = pod_combat_button_bg
		}
		widget = {
			visible = "[GetPlayer.MakeScope.Var('pod_combat_loadout_compact_view').IsSet]"
			size = { 100% 100% }
			background = {
				texture = "gfx/interface/colors/white.dds"
				color = { 0.05 0.07 0.1 0.85 }
			}
		}

		# Category-color left-edge stripe - see template definition
		# above this types block for the 4-widget pattern and rationale.
		using = pod_combat_category_stripe

		# Title text - left-anchored next to the category stripe.
		# The 12px left margin sits the text past the 3px stripe
		# plus a small gap. max_width elides on overflow.
		text_single = {
			block "text_title" { text = "POD_combat_move_title" }
			block "text_format" { default_format = "#high;outline" }
			font = PODGrotesque
			fontsize = 17
			max_width = 220
			alwaystransparent = yes
			parentanchor = left|vcenter
			margin_left = 8
			position = { 0 -2 }
		}
	}

	# Pool-list row card for the skills window's compact view -
	# a horizontal four-column row (Name | Basic Effect | AP |
	# equipped checkbox) stretched to the full pool width.
	# Distinct from `pod_combat_move_button_compact`, the fixed
	# 240x40 cell the equipped column uses. Each row carries:
	#   * Name on the left (POD_combat_move_name - no AP suffix
	#     because AP gets its own column).
	#   * Basic effect line in the middle (via the
	#     PODCombatMoveCompactLine customizable_loc - shorthand
	#     glanceable summary of the dominant effect, no
	#     bypass / always-hit / retaliation riders).
	#   * AP cost on the right.
	#   * Equipped-state checkbox at the far right.
	# Background + category stripe + tooltip mirror the compact
	# button so the visual family stays consistent.
	type pod_combat_move_card_compact = button_standard {
		layoutpolicy_horizontal = expanding
		size = { 100% 32 }

		tooltipwidget = { pod_fancy_combat_move_tooltip_editor = {} }

		# Same subtle flat bg as the equipped-column compact pill.
		blockoverride "background_color" {
			background = {
				texture = "gfx/interface/colors/white.dds"
				color = { 0.05 0.07 0.1 0.85 }
			}
		}

		# Category-color left stripe - see template definition above
		# this types block. Same pattern used by the equipped pill +
		# detailed card so the three card variants stay visually consistent.
		using = pod_combat_category_stripe

		hbox = {
			size = { 100% 100% }
			margin = { 10 0 }
			spacing = 8
			alwaystransparent = yes

			# Name column - fixed width so the basic-effect column
			# below has a stable start position regardless of
			# move-name length. Long names elide via max_width.
			text_single = {
				text = "POD_combat_move_name"
				default_format = "#bold;V"
				fontsize = 14
				autoresize = no
				size = { 200 -1 }
				max_width = 200
				align = left|nobaseline
				alwaystransparent = yes
			}

			# Feature line - every attribute the move has, in log
			# shorthand (PODCombatCL* segment chain). Grows to fill
			# the space between name and AP; single-line, clips the
			# tail on the very busiest moves (tooltip has it all).
			# fontsize matches the name column - the default 16 wastes
			# ~12% of the line's capacity.
			text_single = {
				raw_text = "[GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).Custom('PODCombatMoveCompactLine')]"
				default_format = "#weak"
				fontsize = 14
				layoutpolicy_horizontal = expanding
				align = left|nobaseline
				alwaystransparent = yes
			}

			# Cost bundle: splat energy (icon + scaled number; blank when
			# the move costs none - the PODCombatCLEnergy dispatcher's
			# fallback) then AP, both right-anchored so the two cost
			# numbers line up in a column across rows.
			text_single = {
				raw_text = "[GuiScope.SetRoot(Scope.Story.MakeScope).Custom('PODCombatCLEnergy')]"
				autoresize = no
				size = { 52 -1 }
				align = right|nobaseline
				alwaystransparent = yes
			}
			# AP cost - right-anchored numeric tag ("6 AP" needs ~40px).
			text_single = {
				text = "pod_combat_compact_ap_cost"
				autoresize = no
				size = { 42 -1 }
				align = right|nobaseline
				alwaystransparent = yes
			}

			# Equipped checkbox - same widget the detailed
			# variant uses; `checked` block is overridden by the
			# datamodel-item invocation site, which reads the
			# loadout-toggle SGUI's IsShown state.
			button_checkbox = {
				block "checkbox" {}
				alwaystransparent = yes
			}
		}
	}

	type pod_combat_move_button_detailed = button_standard {
		margin = { 8 2 }
		
		pod_rectangular_glow = {
			block "glow_visible" {}
			blockoverride "max_glow_alpha" { alpha = 0.9 }
			blockoverride "min_glow_alpha" { alpha = 0.9 }
			blockoverride "glow_margin" {
				margin = { 7 5 }
			}
		}

		# No tooltipwidget - the description row below the title already
		# renders the dynamic stat block (POD_combat_move_tooltip via
		# PODCombatMoveEffect), so a hover popup would just duplicate
		# what the row shows. The compact-grid variant keeps its
		# tooltip since it doesn't have a description row.

		hbox = {
			layoutpolicy_horizontal = expanding
			resizeparent = yes

			using = pod_combat_button_bg

			spacer = { size = { 12 0 } }

			vbox = {
				layoutpolicy_horizontal = expanding
				margin = { 8 5 }
				margin_bottom = 12

				text_single = {
					# Title with AP suffix. This detailed-button variant
					# sits in the loadout picker AWAY from any AP pip
					# header - the explicit "AP" keeps the cost unit
					# unambiguous in that detached context, matching
					# the rule used by the hover-popup tooltip title.
					# The compact-button variant (and the in-combat
					# move-bar) drop the AP word because the prominent
					# AP pip strip above the move grid carries the
					# unit context there.
					block "text_title" { text = "POD_combat_move_title_tooltip" }
					default_format = "#high;outline"
					font = PODGrotesque
					fontsize = 19
					# Cap to match the desc text_multi below - same 500-wide
					# bound keeps the title from overflowing the button when
					# a move name with a splat icon prefix and bold formatting
					# stretches past the row's content area. text_single's
					# default elide = right kicks in once text would exceed
					# max_width, so long names render with a trailing "...".
					max_width = 500
					alwaystransparent = yes
				}

				spacer = { size = { 0 2 } }

				text_multi = {
					block "text_desc" { text = "POD_combat_move_tooltip" }
					autoresize = yes
					maximumsize = { 500 -1 }
					align = center
					alwaystransparent = yes
				}

				# Locked rows (show-all view) explain themselves INLINE here:
				# this variant has no hover tooltip (see the type header), so
				# the requirements line joins the card body. Same gate and
				# engine-rendered condition text as the compact tooltips.
				text_multi = {
					visible = "[Not(GetScriptedGui('pod_combat_loadout_option').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"
					raw_text = "[Scope.Story.MakeScope.Var('decision').DecisionType.GetCommandDescForPlayer]"
					default_format = "#weak"
					autoresize = yes
					maximumsize = { 500 -1 }
					align = center
					alwaystransparent = yes
				}

				# Cap-block reason, inline for the same reason as the line above.
				# Mirrors the second section of pod_fancy_combat_move_tooltip_editor;
				# both SGUIs are O(1) (cached counts + list membership), so this is
				# comparable to the requirements eval already on this card.
				text_multi = {
					visible = "[And( GetScriptedGui('pod_combat_loadout_option').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End), Not(GetScriptedGui('pod_combat_loadout_room').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)) )]"
					text = "[GetScriptedGui('pod_combat_loadout_block_tt').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
					autoresize = yes
					maximumsize = { 500 -1 }
					align = center
					alwaystransparent = yes
				}
			}

			button_checkbox = {
				block "checkbox" {}
				# not actually clickable
				# the parent button tracks the clicks, this is just to track which move is equipped
				alwaystransparent = yes
				pod_rectangular_glow = {
					block "glow_visible" {}
					blockoverride "max_glow_alpha" { alpha = 0.4 }
					blockoverride "min_glow_alpha" { alpha = 0.2 }
				}
			}

			spacer = { size = { 12 0 } }
		}

		# Category-color left-edge stripe - see template definition
		# above this types block. Declared AFTER the hbox above so the
		# stripe renders on top of the hbox's background art rather
		# than being buried underneath. The stripe stretches the full
		# row height (which varies with the description row's wrapped
		# text) via the template's `size = { 3 100% }`.
		using = pod_combat_category_stripe
	}

	type pod_fancy_combat_move_tooltip = widget {
		alwaystransparent = no

		using = DefaultTooltipBackground
		using = GeneralTooltipSetup

		vbox = {
			resizeparent = yes
			margin = { 28 11 }
			margin_bottom = 22

			# not reusing pod_combat_button_bg since this is slightly different
			background = {
				block "combat_move_texture" {
					texture = "[Scope.Story.MakeScope.Var('decision').DecisionType.GetPicture(GetPlayer.Self)]"
				}
				fittype = centercrop
				framesize = { 1100 440 }
				alpha = 0.4

				margin = { -5 -5 }

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_scratches.dds"
					blend_mode = alphamultiply
					spriteType = corneredTiled
					alpha = 0.3
					texture_density = 4
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_clouds.dds"
					blend_mode = alphamultiply
					spriteType = corneredTiled
					alpha = 0.4
				}
			}

			text_single = {
				# Default title text uses the "with AP" variant
				# (`POD_combat_move_title_tooltip`) because this
				# widget appears as a detached hover popup, away
				# from the in-window AP pip header - the unit
				# stays explicit. Callers that need a different
				# title (e.g. the combat-log row's hover, which
				# reads the move ref off the log entry's
				# var:move rather than Scope.Story) blockoverride
				# `text_title` with their own variant.
				block "text_title" { text = "POD_combat_move_title_tooltip" }
				default_format = "#high;outline"
				font = PODGrotesque
				fontsize = 19
				alwaystransparent = yes
			}

			spacer = { size = { 0 3 } }

			text_multi = {
				block "text_desc" { text = "POD_combat_move_tooltip" }
				autoresize = yes
				maximumsize = { 500 -1 }
				align = center
				alwaystransparent = yes
			}

			block "additional_text" {}
		}
	}

	# Loadout-editor variant of the move card: the base card plus the two
	# reasons a pool row can refuse to be equipped. Both sections self-hide, so
	# an equippable row renders exactly the base card.
	#   1. LOCKED - the move's own requirements, rendered by the engine from the
	#      hidden decision's is_valid_showing_failures_only (failed lines only).
	#   2. CAPPED - unlocked but its category (or the total) is full. The click
	#      gate always checked this; nothing used to say so, and nothing greyed
	#      the row, so clicking it silently did nothing.
	# The two are mutually exclusive by construction: section 2 requires the
	# unlock section 1 fires on the absence of.
	type pod_fancy_combat_move_tooltip_editor = pod_fancy_combat_move_tooltip {
		blockoverride "additional_text" {
			text_multi = {
				visible = "[Not(GetScriptedGui('pod_combat_loadout_option').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"
				raw_text = "[Scope.Story.MakeScope.Var('decision').DecisionType.GetCommandDescForPlayer]"
				default_format = "#weak"
				autoresize = yes
				maximumsize = { 500 -1 }
				align = center
				alwaystransparent = yes
			}
			# text, not raw_text: IsValidTooltip returns already-formatted text.
			# Gated rather than trusting the SGUI to render empty when it passes -
			# its failures-only shape should, but nothing in the tree relies on that.
			text_multi = {
				visible = "[And( GetScriptedGui('pod_combat_loadout_option').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End), Not(GetScriptedGui('pod_combat_loadout_room').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)) )]"
				text = "[GetScriptedGui('pod_combat_loadout_block_tt').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
				autoresize = yes
				maximumsize = { 500 -1 }
				align = center
				alwaystransparent = yes
			}
		}
	}

	# Live-fight variant: appends the execute gate's failing reasons under the
	# stat block, so a greyed-out move button on the combat bar says WHY - not
	# enough AP, already used this round, no target selected, and so on.
	#
	# Declared HERE, beside its base type, although its only consumers are the
	# four move buttons in pod_combat_window.gui. A derived type has to resolve
	# its base when the file is parsed, and .gui files load alphabetically, so
	# declaring it over there would silently rest on "skills" sorting before
	# "window". Using a type across files is already proven in the other
	# direction (those same buttons use the base type from this file).
	#
	# Both SGUI calls sit inside the tooltipwidget subtree, which the engine
	# builds only while the button is hovered, so the documented
	# four-IsValid-per-move-button-per-frame hotspot gains nothing. The visible
	# gate reuses the buttons' own enabled construction rather than asking the
	# render-only SGUI whether it found anything to say.
	type pod_fancy_combat_move_tooltip_live = pod_fancy_combat_move_tooltip {
		blockoverride "additional_text" {
			text_multi = {
				visible = "[Not(GetScriptedGui('pod_combat_execute_move').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).AddScope('actor', PODCombatMyCombatant).End))]"
				text = "[GetScriptedGui('pod_combat_move_usability_tt').IsValidTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).AddScope('actor', PODCombatMyCombatant).End)]"
				autoresize = yes
				maximumsize = { 500 -1 }
				align = center
				alwaystransparent = yes
			}
		}
	}

	type pod_combat_category_pips = hbox {
		spacing = 4
		alwaystransparent = yes
		# Pip 1
		widget = {
			size = @pip_size
			icon = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue(PdxGuiWidget.AccessParent.AccessParent.GetName), '(CFixedPoint)1')]"
				size = @pip_size
				texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
				block "filled_pip_color" {}
			}
			icon = {
				visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue(PdxGuiWidget.AccessParent.AccessParent.GetName), '(CFixedPoint)1')]"
				size = @pip_size
				texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
			}
		}
		# Pip 2
		widget = {
			size = @pip_size
			icon = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue(PdxGuiWidget.AccessParent.AccessParent.GetName), '(CFixedPoint)2')]"
				size = @pip_size
				texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
				block "filled_pip_color" {}
			}
			icon = {
				visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue(PdxGuiWidget.AccessParent.AccessParent.GetName), '(CFixedPoint)2')]"
				size = @pip_size
				texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
			}
		}
		# Pip 3
		widget = {
			size = @pip_size
			icon = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue(PdxGuiWidget.AccessParent.AccessParent.GetName), '(CFixedPoint)3')]"
				size = @pip_size
				texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
				block "filled_pip_color" {}
			}
			icon = {
				visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue(PdxGuiWidget.AccessParent.AccessParent.GetName), '(CFixedPoint)3')]"
				size = @pip_size
				texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
			}
		}
		# Pip 4
		widget = {
			size = @pip_size
			icon = {
				visible = "[GreaterThanOrEqualTo_CFixedPoint(GetPlayer.MakeScope.ScriptValue(PdxGuiWidget.AccessParent.AccessParent.GetName), '(CFixedPoint)4')]"
				size = @pip_size
				texture = "gfx/interface/icons/combat/ap_pip_filled.dds"
				block "filled_pip_color" {}
			}
			icon = {
				visible = "[LessThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue(PdxGuiWidget.AccessParent.AccessParent.GetName), '(CFixedPoint)4')]"
				size = @pip_size
				texture = "gfx/interface/icons/combat/ap_pip_empty.dds"
			}
		}
	}
	
	type pod_combat_skills_window_marginalia = widget {
		size = { 204 704 }
		
		background = {
			using = Background_Area_Dark
			margin = { 4 4 }
			alpha = 0.5
		}
		
		widget = {
			parentanchor = center
			size = { 200 700 }
		
			background = {
				# Texture (Normal map)
				texture = "gfx/POD_interface/normalmaps/normal_floral02.dds"

				shaderfile = "gfx/FX/POD_shaders/POD_normalmap_shaders.shader"
				effectname = "PODNormalRefraction01"
				
				block "mirror" {}

				# ModifyTexture0 (Cubemap)
				modify_texture = {
					texture = "gfx/POD_interface/cubemaps/hdri.dds"
					blend_mode = normal
					alpha = 1.0
				}

				# Diffuse color
				modify_texture = {
					block "color_diffuse" {
						color = { 0.25 0.16 0.08 } # SpriteModifyTexturesColors[2]
					}
				}

				# Specular color
				modify_texture = {
					block "color_specular" {
						color = { 0.0 0.7 0.7 } # SpriteModifyTexturesColors[3]
					}
				}

				# Fresnel color
				modify_texture = {
					block "color_fresnel" {
						color = { 0.8 0.35 0.14 } # SpriteModifyTexturesColors[4]
					}
					block "properties_fresnel" {
						spriteborder_left = 4     # SpriteBorder[4].x (POW)
						spriteborder_top  = 2520  # SpriteBorder[4].y (multiplier)
					}
				}

				modify_texture = {
					texture = "gfx/interface/component_tiles/tile_window_background.dds"
					blend_mode = alphamultiply
					spriteType = Corneredtiled
					spriteborder = { 18 0 }
					texture_density = 2
				}
				
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_rough_edges.dds"
					spriteType = Corneredtiled
					spriteborder = { 20 20 }
					blend_mode = alphamultiply
					texture_density = 2
				}
				
				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_corner.dds"
					blend_mode = alphamultiply
					mirror = horizontal
					alpha = 0.85
				}
			}
		}
	}
}
