										enabled = "[GetScriptedGui('pod_combat_toggle_silver_dagger_strike').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
									button_standard = {
										size = { 90 35 }
										visible = "[GetPlayer.MakeScope.Var('pod_combat_equipped_silver_dagger_strike').IsSet]"
										text = "pod_combat_remove_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_silver_dagger_strike').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
								}

								# Torch Sweep
								hbox = {
									layoutpolicy_horizontal = expanding
									margin = { 8 2 }
									visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_has_hunter_sv'), '(CFixedPoint)0')]"

									background = {
										using = Background_Area
									}

									vbox = {
										layoutpolicy_horizontal = expanding
										margin = { 8 4 }

										text_single = {
											text = "pod_combat_move_torch_sweep"
											default_format = "#bold"
										}
										text_multi = {
											text = "pod_combat_move_torch_sweep_desc"
											default_format = "#weak"
