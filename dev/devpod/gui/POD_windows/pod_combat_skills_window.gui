										enabled = "[GetScriptedGui('pod_combat_toggle_gold_arrow_shot').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
									button_standard = {
										size = { 90 35 }
										visible = "[GetPlayer.MakeScope.Var('pod_combat_equipped_gold_arrow_shot').IsSet]"
										text = "pod_combat_remove_btn"
										onclick = "[GetScriptedGui('pod_combat_toggle_gold_arrow_shot').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
										margin_right = 8
									}
								}
						}

						##############################
						###### HUNTER QIAO
						##############################

						vbox = {
							layoutpolicy_horizontal = expanding
							ignoreinvisible = yes
							visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_has_hunter_sv'), '(CFixedPoint)0')]"

							hbox = {
