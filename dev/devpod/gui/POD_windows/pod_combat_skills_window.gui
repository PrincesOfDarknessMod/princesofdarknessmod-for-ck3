############################################
######   POD COMBAT SKILLS WINDOW
############################################
# Datamodel-driven loadout editor ported from DUEL-Refactor's
# POD_window_duel_loadout_editor layout. Two scrollable datamodels
# replace the per-move button grid:
#
#   Left column  — the PC's currently equipped moves (pod_combat_loadout)
#                  rendered as a compact grid of fancy-backdrop buttons.
#                  Clicking a compact button unequips it.
#
#   Right column — all available moves (POD_combat_moves global list)
#                  in either detailed scrollbox (default) or compact
#                  grid (toggled by the "Compact view" checkbox).
#                  Visibility of each row is gated by the unlock
#                  decision (pod_combat_loadout_option SGUI); the
#                  "Show all moves" checkbox flips the
#                  show_all_combat_moves character var to override
#                  that gate.
#
# Show-all / Compact COUPLING (state-coupled, not independent):
#   When the "Compact view" checkbox is on (GUI variable
#   pod_combat_loadout_compact is set) the "Show all moves"
#   checkbox is forcibly DISABLED (`enabled` binding around line
#   265) and its visual `checked` state is OR'd with the compact
#   flag (around line 268), so it always appears checked while
#   compact view is active. Compact mode implies "show all" — you
#   can't browse a partial list in compact view. A refactor that
#   moves either control needs to preserve both the disable AND
#   the checked-as-if-on coupling.
#
# Widget templates at the bottom render the fancy decision-art
# backdrops (pod_combat_button_bg) and two button sizes.

widget = {
	name = "pod_combat_skills_window"
	visible = "[And(Not(IsPauseMenuShown), And(IsDefaultGUIMode, And(GetPlayer.IsValid, And(GetPlayer.MakeScope.Var('pod_combat_config_open').IsSet, Not(GetPlayer.MakeScope.Var('pod_combat_active').IsSet)))))]"
	layer = royal_court
	size = { 100% 100% }

	window = {
		parentanchor = center
		size = { 900 900 }
		using = Window_Background
		using = Window_Decoration
		allow_outside = yes

		vbox = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			using = Window_Margins

			##############################
			###### HEADER
			##############################

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text" {
					text = "pod_combat_skills_title"
				}

				blockoverride "button_close" {
					onclick = "[GetScriptedGui('pod_combat_close_skills').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			# Equipped counts per category + total. Each category counter
			# is a toggle button that filters the available-moves list on
			# the right. Clicking ATK, for instance, shows only attack
			# moves; clicking again clears that filter. Multiple can be
			# active at once (multi-select). The Total counter clears
			# all filters.
			hbox = {
				margin = { 0 5 }
				spacing = 20

				text_single = {
					raw_text = "[Localize('pod_combat_equipped_label')]"
					default_format = "#bold"
				}

				button_standard = {
					size = { 90 24 }
					tooltip = "pod_combat_filter_atk_tt"
					onclick = "[GetScriptedGui('pod_combat_toggle_filter_atk').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					down = "[GetPlayer.MakeScope.Var('pod_combat_filter_atk').IsSet]"
					text = "pod_combat_filter_atk_btn"
				}

				button_standard = {
					size = { 90 24 }
					tooltip = "pod_combat_filter_def_tt"
					onclick = "[GetScriptedGui('pod_combat_toggle_filter_def').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					down = "[GetPlayer.MakeScope.Var('pod_combat_filter_def').IsSet]"
					text = "pod_combat_filter_def_btn"
				}

				button_standard = {
					size = { 90 24 }
					tooltip = "pod_combat_filter_ctl_tt"
					onclick = "[GetScriptedGui('pod_combat_toggle_filter_ctl').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					down = "[GetPlayer.MakeScope.Var('pod_combat_filter_ctl').IsSet]"
					text = "pod_combat_filter_ctl_btn"
				}

				button_standard = {
					size = { 90 24 }
					tooltip = "pod_combat_filter_pwr_tt"
					onclick = "[GetScriptedGui('pod_combat_toggle_filter_pwr').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					down = "[GetPlayer.MakeScope.Var('pod_combat_filter_pwr').IsSet]"
					text = "pod_combat_filter_pwr_btn"
				}

				button_standard = {
					size = { 120 24 }
					tooltip = "pod_combat_filter_total_tt"
					onclick = "[GetScriptedGui('pod_combat_clear_filters').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					text = "pod_combat_filter_total_btn"
				}
			}

			divider_light = {
				layoutpolicy_horizontal = expanding
			}

			##############################
			###### SPLIT LAYOUT
			##############################

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				####### LEFT: EQUIPPED MOVES GROUPED BY CATEGORY #######
				# One vbox section per combat_category (ATK/DEF/CTL/PWR).
				# Each shares the same pod_combat_loadout datamodel but
				# filters per-item via a category-check SGUI, so only
				# moves matching that section's category render.
				# ignoreinvisible collapses hidden items so sections
				# stack cleanly without gaps.
				vbox = {
					layoutpolicy_vertical = expanding

					spacer = { size = { 300 0 } }

					text_single = {
						text = "pod_combat_loadout_equipped_header"
						default_format = "#clickable"
					}

					spacer = { size = { 0 8 } }

					# ── ATK section ──
					vbox = {
						ignoreinvisible = yes
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_atk_count'), '(CFixedPoint)0')]"

						text_single = {
							text = "pod_combat_cat_atk_header"
							default_format = "#weak"
						}

						vbox = {
							ignoreinvisible = yes
							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								pod_combat_move_button_compact = {
									visible = "[GetScriptedGui('pod_combat_is_atk_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
								}
							}
						}

						spacer = { size = { 0 8 } }
					}

					# ── DEF section ──
					vbox = {
						ignoreinvisible = yes
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_def_count'), '(CFixedPoint)0')]"

						text_single = {
							text = "pod_combat_cat_def_header"
							default_format = "#weak"
						}

						vbox = {
							ignoreinvisible = yes
							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								pod_combat_move_button_compact = {
									visible = "[GetScriptedGui('pod_combat_is_def_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
								}
							}
						}

						spacer = { size = { 0 8 } }
					}

					# ── CTL section ──
					vbox = {
						ignoreinvisible = yes
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_ctl_count'), '(CFixedPoint)0')]"

						text_single = {
							text = "pod_combat_cat_ctl_header"
							default_format = "#weak"
						}

						vbox = {
							ignoreinvisible = yes
							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								pod_combat_move_button_compact = {
									visible = "[GetScriptedGui('pod_combat_is_ctl_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
								}
							}
						}

						spacer = { size = { 0 8 } }
					}

					# ── PWR section ──
					vbox = {
						ignoreinvisible = yes
						visible = "[GreaterThan_CFixedPoint(GetPlayer.MakeScope.ScriptValue('pod_combat_pwr_count'), '(CFixedPoint)0')]"

						text_single = {
							text = "pod_combat_cat_pwr_header"
							default_format = "#weak"
						}

						vbox = {
							ignoreinvisible = yes
							datamodel = "[GetPlayer.MakeScope.GetList('pod_combat_loadout')]"

							item = {
								pod_combat_move_button_compact = {
									visible = "[GetScriptedGui('pod_combat_is_pwr_move').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
									onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
								}
							}
						}
					}

					expand = {}

					text_single = {
						text = "pod_combat_loadout_hint_title"
						default_format = "#clickable"
					}
					text_single = {
						text = "pod_combat_loadout_hint_desc"
						autoresize = yes
						maximumsize = { 290 -1 }
					}

					spacer = { size = { 0 24 } }
				}

				####### RIGHT: AVAILABLE MOVES #######
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					hbox = {
						button_checkbox_label = {
							onclick = "[GetScriptedGui('pod_combat_loadout_show_all_moves').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							enabled = "[Not( GetVariableSystem.Exists('pod_combat_loadout_compact') )]"

							blockoverride "checkbox" {
								checked = "[Or( GetPlayer.MakeScope.Var('show_all_combat_moves').IsSet, GetVariableSystem.Exists('pod_combat_loadout_compact') )]"
							}
							blockoverride "text" {
								text = "pod_combat_loadout_show_all"
								max_width = 200
							}
						}

						spacer = { size = { 60 0 } }

						button_checkbox_label = {
							onclick = "[GetVariableSystem.Toggle('pod_combat_loadout_compact')]"

							blockoverride "checkbox" {
								checked = "[GetVariableSystem.Exists('pod_combat_loadout_compact')]"
							}
							blockoverride "text" {
								text = "pod_combat_loadout_compact_view"
								max_width = 200
							}
						}
					}

					spacer = { size = { 0 4 } }

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								ignoreinvisible = yes

								####### DETAILED LIST (default) #######
								vbox = {
									layoutpolicy_horizontal = expanding
									ignoreinvisible = yes
									visible = "[Not(GetVariableSystem.Exists('pod_combat_loadout_compact'))]"

									spacing = 4

									datamodel = "[GetGlobalList('POD_combat_moves')]"

									item = {
										pod_combat_move_button_detailed = {
											visible = "[And(GetScriptedGui('pod_combat_loadout_option').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End), GetScriptedGui('pod_combat_loadout_category_match').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"
											enabled = "[GetScriptedGui('pod_combat_loadout_option').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

											onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

											blockoverride "checkbox" {
												checked = "[GetScriptedGui('pod_combat_loadout_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
											}

											blockoverride "glow_visible" {
												visible = "[GetScriptedGui('pod_combat_loadout_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
											}

											blockoverride "fade_alpha" {
												alpha = "[Select_float( GetScriptedGui('pod_combat_loadout_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End), '(float)0.7', '(float)0.9' )]"
											}

											layoutpolicy_horizontal = expanding
										}
									}
								}

								####### COMPACT GRID (toggle) #######
								dynamicgridbox = {
									visible = "[GetVariableSystem.Exists('pod_combat_loadout_compact')]"

									datamodel = "[GetGlobalList('POD_combat_moves')]"

									flipdirection = yes
									ignoreinvisible = yes
									maxhorizontalslots = 2
									datamodel_wrap = 2

									item = {
										widget = {
											size = { 242 42 }
											# Hide cells that fail the unlock check or the active
											# category filter. dynamicgridbox's ignoreinvisible
											# skips hidden widgets so the grid collapses cleanly.
											visible = "[And(GetScriptedGui('pod_combat_loadout_option').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End), GetScriptedGui('pod_combat_loadout_category_match').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End))]"

											pod_combat_move_button_compact = {
												enabled = "[GetScriptedGui('pod_combat_loadout_option').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

												onclick = "[GetScriptedGui('pod_combat_loadout_toggle').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"

												blockoverride "glow_visible" {
													visible = "[GetScriptedGui('pod_combat_loadout_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End)]"
												}

												blockoverride "fade_alpha" {
													alpha = "[Select_float( GetScriptedGui('pod_combat_loadout_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('story', Scope.Story.MakeScope).End), '(float)0.7', '(float)0.9' )]"
												}
											}
										}
									}
								}

								expand = {}
							}
						}
					}
				}
			}
		}
	}
}


##############################
###### WIDGET TEMPLATES
##############################
# Reusable button templates for datamodel rows. Adapted from
# DUEL-Refactor's pod_duel_* widgets — same structure, different
# variable names so the two mods coexist without conflict.
#
# All templates expect Scope.Story to be a story_cycle of type
# POD_combat_move (provided by the parent datamodel item).

template pod_combat_button_bg {
	background = {
		texture = "gfx/interface/colors/black.dds"
		margin = { -2 -2 }
		alpha = 0.8

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_corner.dds"
			blend_mode = alphamultiply
		}
	}

	background = {
		block "glow_visible" { visible = no }

		texture = "gfx/interface/colors/black.dds"
		margin = { -2 -2 }
		alpha = 0.8

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_corner.dds"
			mirror = horizontal|vertical
			blend_mode = alphamultiply
		}
	}

	background = {
		block "bg_texture" {
			texture = "[Scope.Story.MakeScope.Var('decision').DecisionType.GetPicture(GetPlayer.Self)]"
		}
		fittype = centercrop
		framesize = { 1100 440 }
		alpha = 0.9

		margin = { -5 -5 }

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_corner.dds"
			blend_mode = alphamultiply
			mirror = vertical
			block "fade_alpha" { alpha = 0.9 }
		}

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_scratches.dds"
			blend_mode = alphamultiply
			spriteType = corneredTiled
			alpha = 0.3
			texture_density = 4
		}

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_clouds.dds"
			blend_mode = alphamultiply
			spriteType = corneredTiled
			alpha = 0.4
		}
	}
}


types PODCombatTypes {

	type pod_combat_move_button_compact = button_standard {
		size = { 240 40 }

		# Plain tooltipwidget — when the button is disabled because
		# pod_combat_loadout_option.IsValid returns false, CK3 auto-
		# appends the failure tooltip from that SGUI's is_valid block.
		# The SGUI's is_valid uses trigger_if/trigger_else wrappers
		# directly (no custom_description); CK3 surfaces the unmet
		# trigger names with their stock failure formatting. No
		# additional widget plumbing needed here.
		tooltipwidget = { pod_fancy_combat_move_tooltip = {} }

		widget = {
			size = { 100% 100% }
			using = pod_combat_button_bg
		}

		text_single = {
			block "text_title" { text = "POD_combat_move_title" }
			block "text_format" { default_format = "#high;outline" }
			fontsize = 16
			alwaystransparent = yes
			parentanchor = center
			position = { 0 -3 }
		}
	}

	type pod_combat_move_button_detailed = button_standard {
		margin = { 8 2 }

		# No tooltipwidget — the description row below the title already
		# renders the dynamic stat block (POD_combat_move_tooltip via
		# PODCombatMoveEffect), so a hover popup would just duplicate
		# what the row shows. The compact-grid variant keeps its
		# tooltip since it doesn't have a description row.

		hbox = {
			layoutpolicy_horizontal = expanding
			resizeparent = yes

			using = pod_combat_button_bg

			spacer = { size = { 12 0 } }

			vbox = {
				layoutpolicy_horizontal = expanding
				margin = { 8 5 }
				margin_bottom = 12

				text_single = {
					# Bare title (no AP suffix). The description row
					# below the title already shows the AP cost as
					# part of the rendered stat block, so duplicating
					# it here would clutter the row label.
					block "text_title" { text = "POD_combat_move_title_bare" }
					default_format = "#high;outline"
					fontsize = 16
					alwaystransparent = yes
				}

				spacer = { size = { 0 2 } }

				text_multi = {
					block "text_desc" { text = "POD_combat_move_tooltip" }
					# formatting is done in the loc entry itself
					autoresize = yes
					maximumsize = { 440 -1 }
					align = center
					alwaystransparent = yes
				}
			}

			button_checkbox = {
				block "checkbox" {}
				# not actually clickable
				# the parent button tracks the clicks, this is just to track which move is equipped
				alwaystransparent = yes
			}

			spacer = { size = { 12 0 } }
		}
	}

	type pod_fancy_combat_move_tooltip = widget {
		alwaystransparent = no

		using = DefaultTooltipBackground
		using = GeneralTooltipSetup

		vbox = {
			resizeparent = yes
			margin = { 14 11 }
			margin_bottom = 18

			# not reusing pod_combat_button_bg since this is slightly different
			background = {
				block "bg_texture" {
					texture = "[Scope.Story.MakeScope.Var('decision').DecisionType.GetPicture(GetPlayer.Self)]"
				}
				fittype = centercrop
				framesize = { 1100 440 }
				alpha = 0.4

				margin = { -5 -5 }

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
					blend_mode = alphamultiply
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_scratches.dds"
					blend_mode = alphamultiply
					spriteType = corneredTiled
					alpha = 0.3
					texture_density = 4
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_clouds.dds"
					blend_mode = alphamultiply
					spriteType = corneredTiled
					alpha = 0.4
				}
			}

			text_single = {
				block "text_title" { text = "POD_combat_move_title" }
				default_format = "#high;outline"
				fontsize = 16
				alwaystransparent = yes
			}

			spacer = { size = { 0 2 } }

			text_multi = {
				block "text_desc" { text = "POD_combat_move_tooltip" }
				autoresize = yes
				maximumsize = { 440 -1 }
				align = center
				alwaystransparent = yes
			}

			block "additional_text" {}
		}
	}
}
