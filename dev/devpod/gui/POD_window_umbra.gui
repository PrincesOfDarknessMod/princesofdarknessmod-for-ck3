window = {
	name = "spirit_travel"
	layer = middle
	parentanchor = center
	size = { 1192 848 }
	using = Window_Background_Popup
	datacontext = "[GetPlayer]"

	visible = "[GetVariableSystem.Exists( 'spirit_travel_open' )]"
	
	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}
	
	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}
	
	vbox = {
		name = "event_text_box"
		header_standard = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text" {
				text = "[Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_title'))]"
				default_format = "#high"
			}

			blockoverride "button_close"
			{
				onclick = "[GetVariableSystem.Toggle('spirit_travel_open')]"
			}
		}
		
		widget = {
			name = "text"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			
