window = {
	name = "spirit_travel"
	layer = middle
	parentanchor = center
	size = { 1192 868 }
	using = Window_Background_Popup
	datacontext = "[GetPlayer]"

	visible = "[And( Not( IsPauseMenuShown ), And(Or(Not(IsObserver), And(GetPlayer.IsValid, GetPlayer.IsAlive)), And(IsDefaultGUIMode, And(Not(GetVariableSystem.Exists('window_umbra_map')), GetVariableSystem.Exists( 'spirit_travel_open' )))))]"
	
	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}
	
	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}
	
	vbox = {
		name = "event_text_box"
		header_standard = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text" {
				text = "[Localize(Concatenate('game_concept_', GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName))]"
				default_format = "#high"
			}

			blockoverride "button_close"
			{
				onclick = "[GetVariableSystem.Toggle('spirit_travel_open')]"
			}
		}
		
		widget = {
			name = "text"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			
			container = {
				position = { 0 5 }
				datacontext = "[GetScriptedGui( 'is_in_earth_gui' )]"
				visible = "[And(ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), Not(GetScriptedGui( 'spirit_travel_moving' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)))]"
				progressbar_green = {
					position = { 70 27 }
					size = { 1052 15 }
					max = 10
					value = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('no_gauntlet_level'))]"
				}
				icon = {
					datacontext = "[GetScriptedGui( 'gauntlet_10_gui' )]"
					enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 35 0 }
					size = { 70 70 }
					tooltip = "gauntletdesc10"
				}
				icon = {
					enabled = "[LessThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('location_gauntlet_level'), '(CFixedPoint)9' )]"
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 140 0 }
					size = { 70 70 }
					tooltip = "gauntletdesc9"
				}
				icon = {
					enabled = "[LessThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('location_gauntlet_level'), '(CFixedPoint)8' )]"
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 245 0 }
					size = { 70 70 }
					tooltip = "gauntletdesc8"
				}
				icon = {
					enabled = "[LessThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('location_gauntlet_level'), '(CFixedPoint)7' )]"
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 351 0 }
					size = { 70 70 }
					tooltip = "gauntletdesc7"
				}
				icon = {
					enabled = "[LessThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('location_gauntlet_level'), '(CFixedPoint)6' )]"
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 456 0 }
					size = { 70 70 }
					tooltip = "gauntletdesc6"
				}
				icon = {
					enabled = "[LessThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('location_gauntlet_level'), '(CFixedPoint)5' )]"
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 561 0 }
					size = { 70 70 }
					tooltip = "gauntletdesc5"
				}
				icon = {
					enabled = "[LessThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('location_gauntlet_level'), '(CFixedPoint)4' )]"
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 666 0 }
					size = { 70 70 }
					tooltip = "gauntletdesc4"
				}
				icon = {
					enabled = "[LessThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('location_gauntlet_level'), '(CFixedPoint)3' )]"
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 771 0 }
					size = { 70 70 }
					tooltip = "gauntletdesc3"
				}
				icon = {
					enabled = "[LessThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('location_gauntlet_level'), '(CFixedPoint)2' )]"
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 877 0 }
					size = { 70 70 }
					tooltip = "gauntletdesc2"
				}
				icon = {
					enabled = "[LessThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('location_gauntlet_level'), '(CFixedPoint)1' )]"
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 982 0 }
					size = { 70 70 }
					tooltip = "gauntletdesc1"
				}
				icon = {
					enabled = "[LessThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('location_gauntlet_level'), '(CFixedPoint)0' )]"
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 1087 0 }
					size = { 70 70 }
					tooltip = "gauntletdesc0"
				}
			}
			
			container = {
				position = { 0 5 }
				visible = "[GetScriptedGui( 'umbra_exploration_available_gui' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				progressbar_royal_court = {
					position = { 70 27 }
					size = { 1052 15 }
					max = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('umbra_progress_size'))]"
					value = "[FixedPointToFloat(GetPlayer.MakeScope.ScriptValue('umbra_progress'))]"
					tooltip = "UMBRA_EXPLORAITON_PROGRESS"
				}
				icon = {
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 35 0 }
					size = { 70 70 }
					tooltip = "[Localize(Concatenate('game_concept_', GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName))][Localize('UMBRA_SPACE')][Localize('umbra_level_0')][Localize('line_break')][Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_0_tt'))]"
				}
				icon = {
					enabled = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('umbra_level'), '(CFixedPoint)1' )]"
					
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 245 0 }
					size = { 70 70 }
					tooltip = "[Localize(Concatenate('game_concept_', GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName))][Localize('UMBRA_SPACE')][Localize('umbra_level_1')][Localize('line_break')][Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_1_tt'))]"
				}
				icon = {
					enabled = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('umbra_level'), '(CFixedPoint)2' )]"
					
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 456 0 }
					size = { 70 70 }
					tooltip = "[Localize(Concatenate('game_concept_', GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName))][Localize('UMBRA_SPACE')][Localize('umbra_level_2')][Localize('line_break')][Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_2_tt'))]"
				}
				icon = {
					enabled = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('umbra_level'), '(CFixedPoint)3' )]"
					
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 666 0 }
					size = { 70 70 }
					tooltip = "[Localize(Concatenate('game_concept_', GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName))][Localize('UMBRA_SPACE')][Localize('umbra_level_3')][Localize('line_break')][Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_3_tt'))]"
				}
				icon = {
					enabled = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('umbra_level'), '(CFixedPoint)4' )]"
					
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 877 0 }
					size = { 70 70 }
					tooltip = "[Localize(Concatenate('game_concept_', GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName))][Localize('UMBRA_SPACE')][Localize('umbra_level_4')][Localize('line_break')][Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_4_tt'))]"
				}
				icon = {
					enabled = "[GreaterThanOrEqualTo_CFixedPoint( GetPlayer.MakeScope.ScriptValue('umbra_level'), '(CFixedPoint)5' )]"
					
					texture = "gfx/interface/icons/event_types/type_umbra.dds"
					position = { 1087 0 }
					size = { 70 70 }
					tooltip = "[Localize(Concatenate('game_concept_', GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName))][Localize('UMBRA_SPACE')][Localize('umbra_level_5')][Localize('line_break')][Localize(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName, '_5_tt'))]"
				}
			}

			window_umbra_adventure = {}
			
			hbox = {
				name = "description_and_options"
					
				vbox = {
					layoutpolicy_vertical = expanding
					minimumsize = { 306 800 }
			
					spacer = { 
						visible = "[Or(GetScriptedGui( 'is_in_earth_gui' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End) ,GetScriptedGui( 'umbra_exploration_available_gui' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						size = { 0 75 } 
					}

					text_single = {
						name = "header_text"

						block "header_text" {
							text = "umbra_domain"
							default_format = "#high;bold;italic"
						}

						maximumsize = { 306 -1 }
						margin_bottom = 10

						using = Font_Type_Flavor
						using = Font_Size_Big
						fontsize_min = 14
					}
					
					scrollbox = {
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding
						
						blockoverride "scrollbox_background" {}
						blockoverride "scrollbox_background_fade" {}
						blockoverride "scrollbox_content" {
							vbox = {
								spacing = 10
								ignoreinvisible = yes
								visible = "[Not(GetScriptedGui( 'spirit_travel_moving' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
								datamodel = "[GetPlayer.MakeScope.GetList('umbra_locations_list')]"

								item = {
									button_umbra_location = {
										text = "[Localize(Concatenate(Scope.GetFlagName,'_confirm'))]"
										datacontext = "[GetScriptedGui(Concatenate(Scope.GetFlagName,'_location'))]"
									}	
								}
							}
						}
					}
					vbox = {
						margin_bottom = 15
						spacing = 5
						layoutpolicy_horizontal = expanding
						
						hbox = {
							visible = "[PlayerGuiIsValid('POD_has_coterie_sgui')]"
							layoutpolicy_horizontal = expanding
							
							tooltip = "coterie_spirit_travel_tt"
							
							widget = {
								min_width = 15
							}
							
							button_checkbox = {
								size = { 24 24 }
								checked = "[GetPlayer.MakeScope.Var('coterie_spirit_travel').IsSet]"
								onclick = "[PlayerGuiExecute('POD_toggle_coterie_spirit_travel')]"
							}
							
							widget = {
								min_width = 6
							}
							
							text_single = {
								margin_bottom = 5
								text = "coterie_spirit_travel_desc"
							}
							
							expand = {}
						}
						hbox = {
							visible = "[PlayerGuiIsValid('POD_toggle_physical_spirit_travel')]"
							layoutpolicy_horizontal = expanding
							
							tooltip = "physical_spirit_travel_tt"
							
							widget = {
								min_width = 15
							}
							
							button_checkbox = {
								size = { 24 24 }
								checked = "[GetPlayer.MakeScope.Var('physical_spirit_travel').IsSet]"
								onclick = "[PlayerGuiExecute('POD_toggle_physical_spirit_travel')]"
							}
							
							widget = {
								min_width = 6
							}
							
							text_single = {
								margin_bottom = 5
								text = "physical_spirit_travel_desc"
							}
							
							expand = {}
						}
					}
					expand = {}
				}
				
				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin  = { 10 10 }
			
					spacer = { 
						visible = "[Or(GetScriptedGui( 'is_in_earth_gui' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End) ,GetScriptedGui( 'umbra_exploration_available_gui' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						size = { 0 75 } 
					}
					
					background = {
						name = "triangle_background"
						alpha = 0.4
						fittype = start
						texture = "gfx/interface/illustrations/spirit_world.dds"

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
							blend_mode = alphamultiply
							mirror = vertical
						}
					}
					
					scrollarea = {
						name = "description_scrollarea"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = growing
				
						visible = "[Not(GetScriptedGui( 'spirit_travel_moving' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"

						scrollbarpolicy_horizontal = always_off

						scrollbar_vertical = {
							using = Scrollbar_Vertical
						}

						scrollwidget = {
							text_multi = {
								name = "description"
								text = "[GetScriptedGui(Concatenate(GetPlayer.MakeScope.GetVariable('spirit_location').GetFlagName,'_location')).BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
								minimumsize = { 560 -1 }
								maximumsize = { 560 -1 }
								autoresize = yes
								fontsize = 16
							}
						}
					}
					
					vbox = {
						spacing = 10
						margin = { 10 10 }
						ignoreinvisible = yes
						visible = "[Not(GetScriptedGui( 'spirit_travel_moving' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						datamodel = "[GetPlayer.MakeScope.GetList('umbra_realms_list')]"
						
						item = {
							button_umbra_location = {
								size = { 325 34 }
								text = "[Localize(Concatenate(Scope.GetFlagName,'_confirm'))]"
								datacontext = "[GetScriptedGui(Concatenate(Scope.GetFlagName,'_location'))]"
							
								highlight_icon = {
									name = "death"
									visible = "[EqualTo_string( Scope.GetFlagName, 'oblivion' )]"
									size = { 34 34 }
									texture = "gfx/interface/icons/icon_dead.dds"
								}
							}
						}
					}
				}

				vbox = {
					layoutpolicy_vertical = expanding
					minimumsize = { 306 800 }
					ignoreinvisible = yes
			
					spacer = { 
						visible = "[Or(GetScriptedGui( 'is_in_earth_gui' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End) ,GetScriptedGui( 'umbra_exploration_available_gui' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
						size = { 0 75 } 
					}
					
					vbox = {
						datacontext = "[GetPlayer.MakeScope.GetVariable('umbra_ruler').GetCharacter]"
						visible = "[GetScriptedGui( 'umbra_request_army' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						spacing = 5
						margin_bottom = 30
						text_single = {
							name = "header_text"

							block "header_text" {
								raw_text = "[Character.GetNameNoTooltip]"
								default_format = "#high;bold;italic"
							}

							maximumsize = { 306 -1 }

							using = Font_Type_Flavor
							using = Font_Size_Big
							fontsize_min = 14
						}
						portrait_shoulders = {
							blockoverride "status_icons" {}
							blockoverride "opinion_box" {}
							blockoverride "coa" {}
							blockoverride "dead_icon" {}
						}
						hbox = {
							layoutpolicy_vertical = expanding
							spacing = 2
							
							icon = {
								size = { 30 30 }
								texture = "gfx/interface/icons/umbra/icon_grace.dds"
							}

							flowcontainer = {
								ignoreinvisible = yes
								text_single = {
									margin_bottom = 4
									text = "[GetPlayer.MakeScope.GetVariable('current_grace').GetValue|0]"
									max_width = 50
									default_format = "#high"
									using = Font_Size_Medium
								}
							}
						}
						hbox = {
							spacing = 10
							vbox = {
								spacing = 5
								text_single = {
									raw_text = "[Localize('umbra_offer')]"

									using = Font_Type_Flavor
									using = Font_Size_Big
									fontsize_min = 14
								}
								button_umbra_grace = {
									text = "[Localize('umbra_offer_piety')]"
									datacontext = "[GetScriptedGui( 'umbra_offer_piety' )]"
								}
								button_umbra_grace = {
									text = "[Localize('umbra_offer_prestige')]"
									datacontext = "[GetScriptedGui( 'umbra_offer_prestige' )]"
								}
							}
							vbox = {
								spacing = 5
								text_single = {
									text = "[Localize('umbra_request')]"

									using = Font_Type_Flavor
									using = Font_Size_Big
									fontsize_min = 14
								}
								button_umbra_grace = {
									text = "[Localize('umbra_request_perk')]"
									datacontext = "[GetScriptedGui( 'umbra_request_perk' )]"
								}
								button_umbra_grace = {
									text = "[Localize('umbra_request_opinion')]"
									datacontext = "[GetScriptedGui( 'umbra_request_opinion' )]"
								}
								button_umbra_grace = {
									text = "[Localize('umbra_request_army')]"
									datacontext = "[GetScriptedGui( 'umbra_request_army' )]"
								}
							}
						}
					}
					
					text_single = {
						name = "header_text"

						block "header_text" {
							text = "action"
							default_format = "#high;bold;italic"
						}

						maximumsize = { 306 -1 }
						margin_bottom = 10

						using = Font_Type_Flavor
						using = Font_Size_Big
						fontsize_min = 14
					}
					scrollbox = {
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding
						
						blockoverride "scrollbox_background" {}
						blockoverride "scrollbox_background_fade" {}
						blockoverride "scrollbox_content" {
							vbox = {
								spacing = 10
								ignoreinvisible = yes
								datamodel = "[GetPlayer.MakeScope.GetList('umbra_actions_list')]"
								button_event_letter = {
									text = "open_umbra_map"
									default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
									clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_confirm"
									datacontext = "[GetScriptedGui( 'umbra_map' )]"
									
									visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									enabled = "[And(Not(IsPausedByEvent), ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
									onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									onclick = "[GetVariableSystem.Toggle( 'window_umbra_map' )]"
								}
								button_umbra_action = {
									text = "open_capital_window"
									onclick = "[GetVariableSystem.Clear( 'window_local_umbra' )]"
									onclick = "[GetVariableSystem.Toggle( 'window_local_umbra' )]"
									datacontext = "[GetScriptedGui( 'is_in_earth_gui' )]"
								}
								button_umbra_action = {
									text = "umbra_expedition_confirm"
									datacontext = "[GetScriptedGui( 'umbra_expedition_choose' )]"
								}
								item = {
									button_umbra_action = {
										text = "[Localize(Concatenate(Scope.GetFlagName,'_confirm'))]"
										datacontext = "[GetScriptedGui(Concatenate(Scope.GetFlagName,'_choose'))]"
									}
								}
								button_umbra_action = {
									text = "umbra_bow_to_wyrm_confirm"
									datacontext = "[GetScriptedGui( 'umbra_bow_to_wyrm_choose' )]"
									
									modify_texture = {
										texture = "gfx/interface/buttons/button_umbra_underworld.dds"
										blend_mode = overlay
									}
								}
								button_umbra_action = {
									text = "umbra_bow_to_demon_confirm"
									datacontext = "[GetScriptedGui( 'umbra_bow_to_demon_choose' )]"
									
									modify_texture = {
										texture = "gfx/interface/buttons/button_umbra_deep_umbra.dds"
										blend_mode = overlay
									}
								}
								button_umbra_action = {
									text = "[Localize('glen_confirm')]"
									datacontext = "[GetScriptedGui( 'umbra_place_glen_choose' )]"
									
									modify_texture = {
										texture = "gfx/interface/buttons/button_umbra_spirit_wilds.dds"
										blend_mode = overlay
									}
								}
								button_umbra_action = {
									text = "[Localize('hellhole_confirm')]"
									datacontext = "[GetScriptedGui( 'umbra_place_hellhole_choose' )]"
									
									modify_texture = {
										texture = "gfx/interface/buttons/button_umbra_deep_umbra.dds"
										blend_mode = overlay
									}
								}
								button_umbra_action = {
									text = "[Localize('veinous_stair_confirm')]"
									datacontext = "[GetScriptedGui( 'umbra_place_veinous_stair_choose' )]"
									
									modify_texture = {
										texture = "gfx/interface/buttons/button_umbra_underworld.dds"
										blend_mode = overlay
									}
								}
								button_umbra_action = {
									text = "[Localize('onyx_tower_confirm')]"
									datacontext = "[GetScriptedGui( 'umbra_place_onyx_tower_choose' )]"
									
									modify_texture = {
										texture = "gfx/interface/buttons/button_umbra_underworld.dds"
										blend_mode = overlay
									}
								}
								button_umbra_action = {
									text = "[Localize('broken_mirror_confirm')]"
									datacontext = "[GetScriptedGui( 'umbra_place_broken_mirror_choose' )]"
									
									modify_texture = {
										texture = "gfx/interface/buttons/button_umbra_underworld.dds"
										blend_mode = overlay
									}
								}
							}
						}
					}
					
					vbox = {
						margin_bottom = 20
						visible = "[GetScriptedGui( 'is_in_earth_gui' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						text_single = {
							visible = "[GetPlayer.MakeScope.GetVariable('umbra_stationed_location').IsSet]"
							text = "[Localize('CURRENT_EXPLORATION_PLACE')][Localize(Concatenate('game_concept_', GetPlayer.MakeScope.GetVariable('umbra_stationed_location').GetFlagName))]"
						}
						text_single = {
							visible = "[GetScriptedGui( 'has_umbra_explorer' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							text = "[Localize('employ_umbra_explorer')]"
						}
					}
					
					vbox = {
						datacontext = "[GetPlayer.MakeScope.GetVariable('local_umbra_explorer').GetCharacter]"
						visible = "[GetScriptedGui( 'umbra_exploration_available_gui' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						
						margin_bottom = 20
						
						text_single = {
							text = "local_umbra_explorer"
						}
					
						portrait_head_small = {
							blockoverride "portrait_button"
							{
								onclick = "[GetVariableSystem.Toggle('potential_umbra_explorer_window_open')]"
								onclick = "[GetScriptedGui('potential_umbra_explorer_initiate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"	
							}
							blockoverride "onclick"
							{
								button_icon = {
									parentanchor = center
									alwaystransparent = yes
									size = { 20 20 }
									position = {-5 -5}
									texture = "gfx/interface/icons/flat_icons/plus.dds"
								}
							}
						}
					}
				}
			}
		}
	}
}

window = {
	name = "potential_umbra_explorer_window"
	position = { 0 20 }
	parentanchor = center

	allow_outside = yes
	layer = top

	using = Window_Size_CharacterList
	using = Window_Background
	using = Window_Decoration_Spike

	visible = "[GetVariableSystem.Exists( 'potential_umbra_explorer_window_open' )]"
	
	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}
	
	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}
	
	vbox = {
		using = Window_Margins

		hbox = {
			margin_bottom = -10
			layoutpolicy_horizontal = expanding

			header_pattern_interaction = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					text = "umbra_explorer_window"
				}

				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Toggle('potential_umbra_explorer_window_open')]"
				}
			}
		}
		
		vbox = {
			datacontext = "[GetPlayer.MakeScope.GetVariable('local_umbra_explorer').GetCharacter]"
			layoutpolicy_horizontal = expanding
			margin = { 15 0 }

			hbox = {
				layoutpolicy_horizontal = expanding
				margin_right = 3

				portrait_shoulders = {}

				vbox = {
					layoutpolicy_vertical = expanding
					margin = { 10 20 }
					spacing = 2

					text_label_center = {
						text = "UMBRA_EXPLORER_WINDOW_CURRENTLY_APPOINTED"
						default_format = "#low"
					}

					text_multi = {
						layoutpolicy_horizontal = expanding
						autoresize = yes
						text = "[Character.GetUINameNoTooltip]"
						default_format = "#high"
						using = Font_Size_Medium
						min_width = 300
						max_width = 300
					}

					text_single = {
						visible = "[GetPlayer.MakeScope.GetVariable('local_umbra_explorer').IsSet]"
						layoutpolicy_horizontal = expanding
						autoresize = no
						text = "[Localize('CURRENT_EXPLORATION_PLACE')][Localize(Concatenate('game_concept_', Character.MakeScope.GetVariable('umbra_stationed_location').GetFlagName))]"
						tooltip = "EXTENDED_RELATIONS_TOOLTIP"
					}

					expand = {}

					button_standard = {
						datacontext = "[GetScriptedGui( 'fire_umbra_explorer_choose' )]"

						text = "CONFIRM_FIRE_COUNCILLOR_ACCEPT"

						visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}

				vbox = {
					layoutpolicy_vertical = expanding
					margin_bottom = 28

					expand = {}

					vbox = {
						spacing = 10
						visible = "[GetPlayer.MakeScope.GetVariable('local_umbra_explorer').IsSet]"

						background = {
							using = Background_Area
							margin = { 5 0 }
							margin_bottom = 10
						}

						text_multi = {
							text = "UMBRA_APTITUDE"
							autoresize = yes
							min_width = 175
							max_width = 175
						}

						text_multi = {
							text = "UMBRA_EXPLORAITON_PROGRESS"
							autoresize = yes
							min_width = 175
							max_width = 175
						}
					}
				}
			}

			divider_light = {
				layoutpolicy_horizontal = expanding
			}
		}
		
		### Character List
		vbox = {
			name = "character_list"
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			spacing = 5
			
			vbox_character_list = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				blockoverride "sort_buttons" {}
				blockoverride "character_count" {}
				blockoverride "scrollbox_empty_visibility" {}

				blockoverride "container_implementation" {
					dynamicgridbox = {
						name = "characters_grid"
						datamodel = "[GetPlayer.MakeScope.GetList('potential_umbra_explorer')]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						ignoreinvisible = yes
						item = {
							widget = {
								size = { 100% 110 } 
								datacontext = "[Scope.GetCharacter]"
								
								hbox = {
									margin = { 0 5 }
									spacing = 15

									portrait_head_small = {}

									button_standard = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding

										framesize = { 252 80 }
										spriteType = Corneredtiled
										spriteborder = { 10 30 }
										texture = "gfx/interface/buttons/button_entry_characterlist.dds"

										block "button" {}

										character_list_arrow = {
											name = "character_list_arrow"
										}

										block "overlay" {
											using = default_character_list_overlay
										}
										
										block "button_content"
										{
											hbox = {
												layoutpolicy_horizontal = expanding
												layoutpolicy_vertical = expanding
												margin_top = 5

												vbox = {
													layoutpolicy_horizontal = expanding
													layoutpolicy_vertical = expanding

													# Name and age
													vbox = {
														layoutpolicy_horizontal = expanding
														layoutpolicy_vertical = expanding
														margin_left = 10

														text_single = {
															layoutpolicy_horizontal = expanding
															using = Font_Size_Medium
															autoresize = no
															alwaystransparent = yes

															text = "[Character.GetUINameNoTooltip]"
														}

														hbox = {
															layoutpolicy_horizontal = expanding
															layoutpolicy_vertical = expanding

															using = character_age_or_death_text
															blockoverride "list_layout" {}

															block "character_relation"
															{
																text_single = {
																	name = "character_relation"
																	layoutpolicy_horizontal = expanding
																	raw_text = "|  [Localize('CURRENT_EXPLORATION_PLACE')][Localize(Concatenate('game_concept_', Character.MakeScope.GetVariable('umbra_stationed_location').GetFlagName))]"
																	tooltip = "EXTENDED_RELATIONS_TOOLTIP"
																	default_format = "#low"
																	autoresize = no
																	align = nobaseline
																	visible = "[Character.MakeScope.GetVariable('umbra_stationed_location').IsSet]"
																	alwaystransparent = yes
																}

																expand = {
																	visible = "[Not(Character.MakeScope.GetVariable('umbra_stationed_location').IsSet)]"
																}
															}
														}
														block "character_description_extra" {}
													}


													### BOTTOM ROW ###
													hbox = {
														layoutpolicy_horizontal = expanding
														layoutpolicy_vertical = expanding

														vbox = {
															layoutpolicy_horizontal = expanding
															layoutpolicy_vertical = expanding
										
															text_single = {
																name = "aptitude"
																layoutpolicy_horizontal = expanding
																align = left|nobaseline
																margin = {16 8}

																text = "UMBRA_APTITUDE"
															}
														}

														vbox = {
															layoutpolicy_horizontal = expanding
															layoutpolicy_vertical = expanding

															block "bottom_right_box"
															{
																hbox = {
																	layoutpolicy_horizontal = expanding
																	layoutpolicy_vertical = expanding
																	
																	margin_left = 8
																	margin_right = 4
																	spacing = 5

																	expand = {}

																	button_standard = {
																		name = "assign_position"
																		datacontext = "[GetScriptedGui( 'assign_umbra_explorer_choose' )]"

																		text = "POTENTIAL_COUNCILLOR_ASSIGN"
																		default_format = "#high"
																		
																		using = tooltip_below
																		tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('courtier', Character.MakeScope).End)]"
																		visible = "[And(ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('courtier', Character.MakeScope).End), Not(Character.IsGuest))]"
																		enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('courtier', Character.MakeScope).End)]"
																		onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('courtier', Character.MakeScope).End)]"
																	}

																	button_standard = {
																		name = "swap_position"
																		datacontext = "[GetScriptedGui( 'swap_umbra_explorer_choose' )]"

																		text = "POTENTIAL_COUNCILLOR_SWAP"
																		default_format = "#high"
																		
																		using = tooltip_below
																		tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
																		visible = "[And(ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('courtier', Character.MakeScope).End), Not(Character.IsGuest))]"
																		enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('courtier', Character.MakeScope).End)]"
																		onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('courtier', Character.MakeScope).End)]"
																	}

																	button_standard = {
																		name = "recruit_guest"
																		visible = "[And(Character.IsPlayerInteractionShown('recruit_guest_interaction'), Character.IsGuest)]"
																		onclick = "[Character.OpenPlayerInteraction('recruit_guest_interaction')]"
																		enabled = "[Character.IsPlayerInteractionValid('recruit_guest_interaction')]"

																		text = "[Character.GetPlayerInteractionName('recruit_guest_interaction')]"

																		tooltip = "[Character.GetPlayerInteractionTooltip('recruit_guest_interaction')]"
																		using = tooltip_below
																	}
																}
															}
														}
													}
												}
											}
										}
									}		
								}
							}
						}
					}
				}
			}
		}
	}
}

types Buttons
{
    type button_umbra_location = button_umbra_letter
    {
		highlight_icon = {
			visible = "[GetScriptedGui(Concatenate(Scope.GetFlagName,'_explored')).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			size = { 34 34 }
			texture = "gfx/interface/icons/umbra/icon_umbra.dds"
		}
    }
	
    type button_umbra_letter = button_event_letter
    {
        default_format = "#light_background;high;glow_color:{0.1,0.1,0.1,1.0}"
		clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_advance"
							
		tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							
		visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		enabled = "[And(Not(IsPausedByEvent), ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
		modify_texture = {
            visible = "[GetScriptedGui(Concatenate(Scope.GetFlagName,'_in_underworld')).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			texture = "gfx/interface/buttons/button_umbra_underworld.dds"
			blend_mode = overlay
		}
		modify_texture = {
            visible = "[GetScriptedGui(Concatenate(Scope.GetFlagName,'_in_astral_reaches')).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			texture = "gfx/interface/buttons/button_umbra_astral_reaches.dds"
			blend_mode = overlay
		}
		modify_texture = {
            visible = "[GetScriptedGui(Concatenate(Scope.GetFlagName,'_in_spirit_wilds')).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			texture = "gfx/interface/buttons/button_umbra_spirit_wilds.dds"
			blend_mode = overlay
		}
		modify_texture = {
            visible = "[GetScriptedGui(Concatenate(Scope.GetFlagName,'_in_dreaming')).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			texture = "gfx/interface/buttons/button_umbra_dreaming.dds"
			blend_mode = overlay
		}
		modify_texture = {
            visible = "[GetScriptedGui(Concatenate(Scope.GetFlagName,'_in_deep_umbra')).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			texture = "gfx/interface/buttons/button_umbra_deep_umbra.dds"
			blend_mode = overlay
		}
    }

    type button_umbra_grace = button_event_letter
    {
		size = { 120 34 }
		default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
		using = Font_Type_Flavor
									
		tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }

    type button_umbra_action = button_event_letter
    {
		default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
		clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_confirm"
		
		tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		enabled = "[And(Not(IsPausedByEvent), ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
    }
}
