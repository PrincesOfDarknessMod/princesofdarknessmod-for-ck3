			margin = { 3 2 }

			scrollarea = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding

				scrollbarpolicy_horizontal = always_off
				scrollbar_vertical = {
					using = Scrollbar_Vertical_Alpha
				}

				scrollwidget = {
					vbox = {
						layoutpolicy_vertical = expanding
						ignoreinvisible = yes

						RUI_Ch_relationship_box = {
							blockoverride "label" {
								text = "neterus_row_header_expanded"
							}
							blockoverride "onclick" {
								onclick = "[GetVariableSystem.Set( 'RUI_Ch_expanded', 'PODS_worshipping_neteru' )]"
								onrightclick = "[GetVariableSystem.Set( 'RUI_Ch_expanded', 'PODS_worshipping_neteru' )]"
							}
							blockoverride "datamodel" {
