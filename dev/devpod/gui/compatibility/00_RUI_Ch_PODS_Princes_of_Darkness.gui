	type RUI_Ch_PODS_type_12 = RUI_Ch_tab_button {
		visible = "[GetScriptedGui( 'should_see_cultists_gui' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End)]"
		blockoverride "onclick_down" {
			onclick = "[VariableSystem.Set( 'RUI_Ch_tabs', 'tab_cultists' )]"
			onrightclick = "[VariableSystem.Set( 'RUI_Ch_tabs', 'tab_cultists' )]"
			onrightclick = "[VariableSystem.Set( 'RUI_Ch_keep_tab', 'tab_cultists' )]"
			down = "[And( CharacterWindow.IsTabShown( 'relations' ), And( VariableSystem.HasValue( 'RUI_Ch_tabs', 'tab_cultists' ), Not( VariableSystem.Exists( 'RUI_Ch_expanded' ) ) ) )]"
		}
		blockoverride "enlarged_mode" {}

		blockoverride "tab_label" {
			text = "cultists_row_header_expanded"
		}

		blockoverride "not_disabled" {}
		blockoverride "not_lock" {}
	}

	type RUI_Ch_PODS_type_13 = widget {
		name = "cultists_tab"
		visible = "[And( CharacterWindow.IsTabShown( 'relations' ), And( VariableSystem.HasValue( 'RUI_Ch_tabs', 'tab_cultists' ), Not( VariableSystem.Exists( 'RUI_Ch_expanded' ) ) ) )]"
		size = { 100% 100% }

		using = Animation_Tab_Switch

		background = {
			texture = "gfx/interface/illustrations/decisions/decision_misc.dds"
			using = RUI_Ch_Background_Common
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 3 2 }

			scrollarea = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding

				scrollbarpolicy_horizontal = always_off
				scrollbar_vertical = {
					using = Scrollbar_Vertical_Alpha
				}

				scrollwidget = {
					vbox = {
						layoutpolicy_vertical = expanding
						ignoreinvisible = yes

						RUI_Ch_relationship_box = {
							blockoverride "label" {
								text = "cultists_row_header_expanded"
							}
							blockoverride "onclick" {
								onclick = "[GetVariableSystem.Set( 'RUI_Ch_expanded', 'PODS_worshipping_cultist' )]"
								onrightclick = "[GetVariableSystem.Set( 'RUI_Ch_expanded', 'PODS_worshipping_cultist' )]"
							}
							blockoverride "datamodel" {
								datamodel = "[CharacterWindow.GetRelationsOfTypeFillEmpty( GetRelation( 'worshipping_cultist' ), '(int32)1' )]"
							}
						}

						expand = {}
					}
				}
			}
		}
	}

	type RUI_Ch_PODS_type_14 = RUI_Ch_tab_button {
		visible = "[GetScriptedGui( 'should_see_neterus_gui' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End)]"
