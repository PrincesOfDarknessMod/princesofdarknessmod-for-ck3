								}
							}
							RUI_Ch_relationship_box = {
								visible = "[GetScriptedGui( 'has_mindless_clone_gui' ).IsShown( GuiScope.SetRoot( CharacterWindow.GetCharacter.MakeScope ).End )]"
								blockoverride "label" {
									text = "mindless_clone_row_header"
								}
								blockoverride "enabled" {
									enabled = no
								}
								blockoverride "datamodel" {
									datamodel = "[CharacterWindow.GetRelationsOfType( GetRelation( 'mindless_clone_servant' ) )]"
								}
							}
						}

						# Ghouls
						RUI_Ch_relationship_box = {
							visible = "[And(GetScriptedGui( 'has_ghouls_gui' ).IsShown( GuiScope.SetRoot( CharacterWindow.GetCharacter.MakeScope ).End ), GetScriptedGui('is_vampire_g').IsShown(GuiScope.SetRoot(CharacterWindow.GetCharacter.MakeScope).End))]"
							blockoverride "label" {
								text = "ghouls_row_header"
							}
							blockoverride "onclick" {
								onclick = "[GetVariableSystem.Set( 'RUI_Ch_expanded', 'PODS_ghouls' )]"
								onrightclick = "[GetVariableSystem.Set( 'RUI_Ch_expanded', 'PODS_ghouls' )]"
							}
							blockoverride "datamodel" {
