# MOD名 / MOD Name .......... Princes of Darkness
# 互換性ID / Comp ID ........ *PODS
# 作成者 / Author ........... "Princes of Darkness" MOD Project
# Workshop ID ............... 2216659254
# 対応日付 / Support Date ... 2026/07/02

types CharacterWindow
{
	type RUI_Ch_PODS_type_01 = pod_lore_buttons {}

	type RUI_Ch_PODS_type_02 = coa_house_small {
		visible = "[GetScriptedGui('POD_has_personal_coa').IsShown(GuiScope.SetRoot(CharacterWindow.GetCharacter.MakeScope).End)]"
		datacontext = "[CharacterWindow.GetCharacter.GetRelationOfType( GetRelation( 'pod_personal_coa_slave' ) ).GetHouse]"
		blockoverride "coa_tooltip" {}
		tooltipwidget = {
			using = POD_personal_coa_tooltip
		}
		blockoverride "coa_button" {}
		flowcontainer = {
			parentanchor = top|right
			ignoreinvisible = yes
			button_find_title = {
				visible = "[Character.IsPlayer]"
				onmousehierarchyenter = "[PlayerGuiExecute('POD_summon_personal_coa_slave')]"
				onclick = "[OpenHouseCustomizationWindow(DynastyHouse.Self)]"
				tooltip = CUSTOMIZE_PERSONAL_ARMS
				mirror = horizontal
				size = { 15 15 }
			}
		}
	}

	type RUI_Ch_PODS_type_03 = widget {
		size = { 32 32 }
		pod_resonance_display = {
			datacontext = "[CharacterWindow.GetCharacter]"
		}
	}

	type RUI_Ch_PODS_type_04 = POD_character_window_sidebar {
		movable = yes
		visible_at_creation = no

		state = {
			name = _show
			using = Animation_FadeIn_Quick
			position_x = 360
			position_y = 0
			trigger_on_create = yes
		}
	}

	type RUI_Ch_PODS_type_06 = POD_window_character_knight_window {
		datacontext = "[CharacterWindow.GetCharacter]"
	}

	type RUI_Ch_PODS_type_07 = pod_ventrue_warning_display {
		ignoreinvisible = yes
		datacontext = "[CharacterWindow.GetCharacter]"
	}

	type RUI_Ch_PODS_type_09 = RUI_Ch_tab_button {
		visible = "[GetScriptedGui( 'should_see_minions_gui' ).IsShown( GuiScope.SetRoot( Character.MakeScope ).End)]"
		blockoverride "onclick_down" {
			onclick = "[VariableSystem.Set( 'RUI_Ch_tabs', 'tab_minions' )]"
			onrightclick = "[VariableSystem.Set( 'RUI_Ch_tabs', 'tab_minions' )]"
			onrightclick = "[VariableSystem.Set( 'RUI_Ch_keep_tab', 'tab_minions' )]"
			down = "[And( CharacterWindow.IsTabShown( 'relations' ), And( VariableSystem.HasValue( 'RUI_Ch_tabs', 'tab_minions' ), Not( VariableSystem.Exists( 'RUI_Ch_expanded' ) ) ) )]"
		}
		blockoverride "enlarged_mode" {}

		blockoverride "tab_label" {
			text = "minions_button_name"
		}

		blockoverride "not_disabled" {}
		blockoverride "not_lock" {}
	}

	type RUI_Ch_PODS_type_10 = widget {
		name = "minions_tab"
		visible = "[And( CharacterWindow.IsTabShown( 'relations' ), And( VariableSystem.HasValue( 'RUI_Ch_tabs', 'tab_minions' ), Not( VariableSystem.Exists( 'RUI_Ch_expanded' ) ) ) )]"
		size = { 100% 100% }

		using = Animation_Tab_Switch

		background = {
			texture = "gfx/interface/illustrations/decisions/decision_misc.dds"
			using = RUI_Ch_Background_Common
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			margin = { 3 2 }

			scrollarea = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding

				scrollbarpolicy_horizontal = always_off
				scrollbar_vertical = {
					using = Scrollbar_Vertical_Alpha
				}

				scrollwidget = {
					vbox = {
						layoutpolicy_vertical = expanding
						ignoreinvisible = yes
	
						# coterie
						RUI_Ch_relationship_box = {
							visible = "[GetScriptedGui( 'POD_has_coterie_sgui' ).IsValid( GuiScope.SetRoot( CharacterWindow.GetCharacter.MakeScope ).End )]"
							blockoverride "label" {
								text = "coterie_row_header"
							}
							blockoverride "onclick" {
								onclick = "[GetVariableSystem.Set( 'RUI_Ch_expanded', 'PODS_coterie' )]"
								onrightclick = "[GetVariableSystem.Set( 'RUI_Ch_expanded', 'PODS_coterie' )]"
							}
							blockoverride "datamodel" {
								datamodel = "[CharacterWindow.GetCharacter.MakeScope.Var('coterie').GetList('members')]"
							}
							blockoverride "additional_content_horizontal" {
								coa_house_medium = {
									datacontext = "[CharacterWindow.GetCharacter.MakeScope.Var('coterie').Var('coa_dummy').Char.GetHouse]"
									blockoverride "coa_button" {}
								}
							}
							blockoverride "datacontext" {
								datacontext = "[Scope.Char]"
							}
						}

						# Unique relations. The UI can hold up to 6 or 8? but it's impossible to have them all visible so safe.
						hbox = {
							layoutpolicy_horizontal = expanding

							RUI_Ch_relationship_box = {
								visible = "[GetScriptedGui( 'has_fetter_gui' ).IsShown( GuiScope.SetRoot( CharacterWindow.GetCharacter.MakeScope ).End )]"
								blockoverride "label" {
									text = "fetter_row_header"
								}
								blockoverride "enabled" {
									enabled = no
								}
								blockoverride "datamodel" {
									datamodel = "[CharacterWindow.GetRelationsOfType( GetRelation( 'fetter' ) )]"
								}
							}
							RUI_Ch_relationship_box = {
								visible = "[GetScriptedGui( 'has_spirits_gui' ).IsShown( GuiScope.SetRoot( CharacterWindow.GetCharacter.MakeScope ).End )]"
								blockoverride "label" {
									text = "spirit_companions_row_header"
								}
								blockoverride "enabled" {
									enabled = no
								}
								blockoverride "datamodel" {
									datamodel = "[CharacterWindow.GetRelationsOfType( GetRelation( 'spirit_companion' ) )]"
								}
							}
							RUI_Ch_relationship_box = {
								visible = "[GetScriptedGui( 'has_human_companion_gui' ).IsShown( GuiScope.SetRoot( CharacterWindow.GetCharacter.MakeScope ).End )]"
								blockoverride "label" {
									text = "human_companions_row_header"
								}
								blockoverride "enabled" {
									enabled = no
								}
								blockoverride "datamodel" {
									datamodel = "[CharacterWindow.GetRelationsOfType( GetRelation( 'human_companion' ) )]"
								}
							}
							RUI_Ch_relationship_box = {
								visible = "[GetScriptedGui( 'has_innocent_gui' ).IsShown( GuiScope.SetRoot( CharacterWindow.GetCharacter.MakeScope ).End )]"
								blockoverride "label" {
									text = "innocent_tormentors_row_header"
								}
								blockoverride "enabled" {
									enabled = no
								}
								blockoverride "datamodel" {
									datamodel = "[CharacterWindow.GetRelationsOfType( GetRelation( 'innocent_tormentor' ) )]"
								}
							}
							RUI_Ch_relationship_box = {
								visible = "[GetScriptedGui( 'has_possesses_gui' ).IsShown( GuiScope.SetRoot( CharacterWindow.GetCharacter.MakeScope ).End )]"
								blockoverride "label" {
									text = "possessed_targets_row_header"
								}
								blockoverride "enabled" {
									enabled = no
								}
								blockoverride "datamodel" {
									datamodel = "[CharacterWindow.GetRelationsOfType( GetRelation( 'possessed_target' ) )]"
								}
							}
							RUI_Ch_relationship_box = {
								visible = "[GetScriptedGui( 'has_fascinates_gui' ).IsShown( GuiScope.SetRoot( CharacterWindow.GetCharacter.MakeScope ).End )]"
								blockoverride "label" {
									text = "fascinate_targets_row_header"
								}
								blockoverride "enabled" {
									enabled = no
								}
								blockoverride "datamodel" {
									datamodel = "[CharacterWindow.GetRelationsOfType( GetRelation( 'fascinate_target' ) )]"
								}
							}
							RUI_Ch_relationship_box = {
								visible = "[GetScriptedGui( 'has_stolen_hearts_gui' ).IsShown( GuiScope.SetRoot( CharacterWindow.GetCharacter.MakeScope ).End )]"
								blockoverride "label" {
									text = "stolen_hearts_row_header"
								}
								blockoverride "enabled" {
