window = {
	name = "umbra_map_window"
	layer = middle
	parentanchor = center
	size = { 975 975 }
	using = Window_Background_Popup
		
	visible = "[GetVariableSystem.Exists('window_umbra_map')]"
	
	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}
	
	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}
	
	vbox = {
		header_standard = {
			layoutpolicy_horizontal = expanding

			blockoverride "header_text" {
				text = "umbra_map"
				default_format = "#high"
			}

			blockoverride "button_close"
			{
				onclick = "[GetVariableSystem.Toggle('window_umbra_map')]"
			}
		}
		
		expand = {}
	}
	line = {
		using = Line_Lifestyles_Unlocked
		from = { 375 500 }
		to = { 75 500 }
	}
	line = {
		using = Line_Lifestyles_Unlocked
		from = { 375 500 }
		to = { 375 100 }
	}
	line = {
		using = Line_Lifestyles_Unlocked
		from = { 375 500 }
		to = { 375 900 }
	}
	line = {
		using = Line_Lifestyles_Unlocked
		from = { 375 500 }
		to = { 475 500 }
	}
	line = {
		using = Line_Lifestyles_CanUnlock
		from = { 475 500 }
		to = { 575 500 }
	}
	line = {
		using = Line_Lifestyles_Unlocked
		from = { 575 500 }
		to = { 875 500 }
	}
	#ROW1
	button_normal = {
		position = { 50 475 }
		size = { 50 50 }
		datacontext = "[GetScriptedGui( 'deep_dreaming_fast_travel' )]"
									
		tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		enabled = "[And(ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
		highlight_icon = {
			texture = "gfx/interface/icons/umbra/icon_dreaming.dds"
			size = { 50 50 }
		}

		text_multi = {
			parentanchor = top|hcenter
			position = { 0 50 }
			max_width = 75
			autoresize = yes

			text = "game_concept_deep_dreaming"
			default_format = "#high"
			align = top|hcenter

			background = {
				using = Background_Area
				margin = { 20 0 }
				margin_bottom = 5
				margin_top = 5
			}
		}
	}
	#ROW2
