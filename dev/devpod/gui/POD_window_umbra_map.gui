		vbox = {
			layoutpolicy_vertical = expanding
			minimumsize = { 306 800 }
	
			spacer = { 
				size = { 0 50 } 
			}

			text_single = {
				name = "header_text"

				block "header_text" {
					text = "umbra_stationed_location"
					default_format = "#high;bold;italic"
				}

				maximumsize = { 306 -1 }
				margin_bottom = 10

				using = Font_Type_Flavor
				using = Font_Size_Big
				fontsize_min = 14
			}
			
			scrollbox = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				
				blockoverride "scrollbox_background" {}
				blockoverride "scrollbox_background_fade" {}
				blockoverride "scrollbox_content" {
					vbox = {
						spacing = 10
						ignoreinvisible = yes
						
						datamodel = "[GetPlayer.MakeScope.GetList('stationed_locations_list')]"

						item = {
							button_event_letter = {
								text = "[Localize(Concatenate(Scope.GetFlagName,'_confirm'))]"
								datacontext = "[GetScriptedGui(Concatenate(Scope.GetFlagName,'_location'))]"
								
								default_format = "#light_background;high;glow_color:{0.1,0.1,0.1,1.0}"
								clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_advance"
													
								tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
													
								visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
								
								highlight_icon = {
									visible = "[GetScriptedGui(Concatenate(Scope.GetFlagName,'_interest')).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
									size = { 34 34 }
									texture = "gfx/interface/icons/activity_pulse_actions/stewardship.dds"
								}
							}	
						}
					}
				}
			}
			expand = {}
		}
	}
}