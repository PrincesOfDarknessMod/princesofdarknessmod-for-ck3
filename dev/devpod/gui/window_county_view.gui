	type widget_building_item_needs = widget {
		size = { 60 40 }

		overlappingitembox = {
			size = { 100% 40 }
			# One icon per trade good need of this building; checkmark shown only when the need is fully supplied.
			ignoreinvisible = yes
			spacing = -22
			datamodel = "[GUIBuildingItem.GetBuildingNeeds]"

			item = {
				building_need_icon = {
					# extra size for spacing in the overlappingitembox
					size = { 40 40 }
					# hide entrepot needs since there are so many
					visible = "[Not(GUIBuildingNeedItem.IsSkippingInternalFulfillment)]"
				}
			}
		}

		background = {
			using = Background_Area
		}
	}

