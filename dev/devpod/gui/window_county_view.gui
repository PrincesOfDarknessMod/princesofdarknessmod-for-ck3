	type vbox_construct_new_district = vbox_construction_window_contents {
		layoutpolicy_vertical = expanding
		blockoverride "track_content" {
			## Construct New District

			hbox = {
				datacontext = "[HoldingView.GetProvince]"
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				spacing = 2

				scrollbox = {
					layoutpolicy_vertical = expanding
					size = { 92 0 }
					blockoverride "scrollbox_content" {
						name = "potential_district_icons"

						vbox = {
							datamodel = "[HoldingView.GetPotentialDistricts]"
							datacontext = "[HoldingView.GetProvince]"
							spacing = 6

							item = {
								widget = {
									size = { 64 64 }

									button_standard = {
										size = { 100% 100% }
										datacontext = "[GUIPotentialDistrictItem.GetDistrictType]"
										onclick = "[GetVariableSystem.Set( 'selected_potential_district', GUIPotentialDistrictItem.GetDistrictType.GetKey )]"
										down = "[Or( GetVariableSystem.HasValue( 'selected_potential_district', GUIPotentialDistrictItem.GetDistrictType.GetKey ), And( Not( GetVariableSystem.Exists( 'selected_potential_district' ) ), EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' ) ) )]"
										alwaystransparent = "[Or( GetVariableSystem.HasValue( 'selected_potential_district', GUIPotentialDistrictItem.GetDistrictType.GetKey ), And( Not( GetVariableSystem.Exists( 'selected_potential_district' ) ), EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' ) ) )]"

										widget_district_with_background = {
											datacontext = "[GUIPotentialDistrictItem.GetDistrictType]"
											size = { 100% 100% }

											blockoverride "icon_district_modify" {
												size = { 56 56 }
											}
										}

										selection_glow = {
											visible = "[Or( GetVariableSystem.HasValue( 'selected_potential_district', GUIPotentialDistrictItem.GetDistrictType.GetKey ), And( Not( GetVariableSystem.Exists( 'selected_potential_district' ) ), EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' ) ) )]"
										}
									}
								}
							}
						}
					}
				}

				vbox = {
					datamodel = "[HoldingView.GetPotentialDistricts]"
					datacontext = "[HoldingView.GetProvince]"
					visible = "[Or( HoldingView.IsSelectingNewDistrict, HoldingView.IsReplacingDistrict )]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					item = {
						vbox = {
							visible = "[Or( GetVariableSystem.HasValue( 'selected_potential_district', GUIPotentialDistrictItem.GetDistrictType.GetKey ), And( Not( GetVariableSystem.Exists( 'selected_potential_district' ) ), EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' ) ) )]"
							datacontext = "[GUIPotentialDistrictItem.AccessAsPotentialItem]"
							datacontext = "[GUIPotentialDistrictItem.GetDistrictType]"
							layoutpolicy_vertical = expanding
							layoutpolicy_horizontal = expanding

							hbox = {
								name = "header"
								layoutpolicy_horizontal = expanding
								margin_left = 16

								background = {
									texture = "[DistrictType.GetBackground( HoldingView.GetProvince )]"
									alpha = 0.3
									fittype = centercrop

									modify_texture = {
										texture = "gfx/interface/component_masks/mask_rough_edges.dds"
										spriteType = Corneredtiled
										spriteborder = { 25 25 }
										blend_mode = alphamultiply
									}
								}

								hbox = {
									layoutpolicy_horizontal = expanding

									vbox = {
										layoutpolicy_vertical = expanding
										margin_bottom = 8

										expand = {}

										text_label_left = {
											using = Font_Size_Medium
											align = left
											autoresize = yes
											multiline = yes

											min_width = 240
											max_width = 240

											text = "[GUIPotentialDistrictItem.GetDistrictType.CalcTriggeredNameNoTooltip( HoldingView.GetProvince )]"
										}
									}



									expand = {}

									vbox = {

										margin  = { 8 0 }
										margin_top = 3
										margin_bottom = 8

										spacing = 4

										background = {
											using = Background_Area_Dark
										}

										potential_item_costs = {
										}

										# Construct / Queue buttons
										vbox = {
											layoutpolicy_horizontal = expanding

											button_standard = {
												size = { 120 36 }
												layoutpolicy_horizontal = expanding

												text = "START_CONSTRUCTION"
												using = tooltip_es

												visible = "[And( Not( GUIPotentialDistrictItem.IsSponsorConstructionVisible ), Or( GUIPotentialDistrictItem.CanConstruct, Not( GUIPotentialDistrictItem.CanQueue ) ) )]"
												enabled = "[GUIPotentialDistrictItem.CanConstruct]"
												onclick = "[GUIPotentialDistrictItem.Queue]"
												onclick = "[GetVariableSystem.Clear( 'selected_potential_district' )]"
												clicksound = "event:/DLC/EP5/SFX/UIX/ep5_uix_district_build_start"
												tooltip = "[GUIPotentialDistrictItem.GetTooltip( GetPlayer.Self )]"
											}

											button_tertiary = {
												size = { 120 36 }
												layoutpolicy_horizontal = expanding

												text = "QUEUE_CONSTRUCTION"
												using = tooltip_es

												visible = "[And( Not( GUIPotentialDistrictItem.IsSponsorConstructionVisible ), And( GUIPotentialDistrictItem.CanQueue, Not( GUIPotentialDistrictItem.CanConstruct ) ) )]"
												enabled = "[GUIPotentialDistrictItem.CanQueue]"
												onclick = "[GUIPotentialDistrictItem.Queue]"
												clicksound = "event:/DLC/EP5/SFX/UIX/ep5_uix_district_build_start"
												tooltip = "[GUIPotentialDistrictItem.GetTooltip( GetPlayer.Self )]"
											}

											button_standard = {
												size = { 120 36 }
												layoutpolicy_horizontal = expanding

												text = "merchant_sponsor_construction_button"
												onclick = "[HoldingView.CloseTracksView]"
												tooltip = "merchant_sponsor_construction_button_tooltip"
												using = tooltip_es

												visible = "[GUIPotentialDistrictItem.IsSponsorConstructionVisible]"
												enabled = "[GUIPotentialDistrictItem.CanOpenSponsorConstructionInteraction]"
												onclick = "[GUIPotentialDistrictItem.OpenSponsorConstructionInteraction]"
												tooltip_when_disabled = "[GUIPotentialDistrictItem.GetSponsorConstructionBlockTooltip]"
											}
										}
									}
								}
							}

							scrollbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								blockoverride "scrollbox_content" {
									vbox = {
										name = "dynamic_content"
										datacontext = "[GUIPotentialDistrictItem.GetDistrictType]"
										layoutpolicy_horizontal = expanding
										spacing = 8

										text_multi = {
											visible = "[DistrictType.HasGameplayDescription]"
											text = "[DistrictType.GetGameplayDescription]"
											autoresize = yes
											min_width = 400
											max_width = 400
										}

										vbox = {
											name = "buildings"
											layoutpolicy_horizontal = expanding
											layoutpolicy_vertical = expanding
											spacing = 8

											hbox = {
												name = "primary_building"
												datacontext = "[GUIPotentialDistrictItem.GetDistrictType.GetPrimaryBuildingType]"
												layoutpolicy_horizontal = expanding

												tooltipwidget = {
													using = BuildingTypeTooltip
												}
												spacing = 16
												margin = { 8 8 }

												background = {
													using = Background_Area
													alpha = 0.8
												}

												icon_building = {
													size = { 64 64 }
													texture = "[BuildingType.GetTypeIcon]"
												}

												vbox = {
													layoutpolicy_horizontal = expanding
													spacing = 4

													text_label_left = {
														layoutpolicy_horizontal = expanding
														text = CONSTRUCT_DISTRICTS_MAIN_BUILDING
														autoresize = no
													}

													text_single = {
														layoutpolicy_horizontal = expanding
														autoresize = no
														text = "[BuildingType.CalcTriggeredNameNoTooltip( Province.Self )|V]"
														align = nobaseline
														using = Font_Size_Medium
													}
												}
											}

											vbox = {
												name = "potential_buildings"
												visible = "[Not(IsDataModelEmpty(GUIPotentialDistrictItem.GetPotentialBuildingTypes))]"
												layoutpolicy_horizontal = expanding
												margin = { 10 0 }
												spacing = 4

												text_label_left = {
													layoutpolicy_horizontal = expanding
													text = CONSTRUCT_DISTRICTS_POTENTIAL_BUILDINGS
													autoresize = no
												}

												flowcontainer = {
													datamodel = "[GUIPotentialDistrictItem.GetPotentialBuildingTypes]"
													wrap_count = 7

													item = {
														widget = {
															size = { 54 54 }

															tooltipwidget = {
																using = BuildingTypeTooltip
															}
															using = tooltip_se

															background = {
																using = Background_Area
															}

															icon_building = {
																parentanchor = center
																size = { 46 46 }
																texture = "[BuildingType.GetTypeIcon]"
															}
														}
													}
												}
											}
										}

										text_multi = {
											margin = { 16 8 }
											visible = "[DistrictType.HasFlavorDescription]"
											text = "[DistrictType.GetFlavorDescription]"
											default_format = "#F"
											autoresize = yes
											min_width = 400
											max_width = 400

											background = {
												using = Background_Area
												alpha = 0.8
											}
										}
										expand = {  }
									}
								}
							}
						}
					}
				}
			}
		}
	}

	type button_potential_building = button_standard {
		size = { 100% 100% }
		onclick = "[GetVariableSystem.Set( 'selected_potential_building', GUIPotentialItem.GetBuilding.GetKey )]"

		icon_building = {
			parentanchor = center
			size = { 56 56 }
			texture = "[GUIPotentialItem.GetBuilding.GetTypeIcon]"
			block "icon_alpha" {}
		}

		block "selected_state" {
			down = "[Or( GetVariableSystem.HasValue( 'selected_potential_building', GUIPotentialItem.GetBuilding.GetKey ), And( Not( GetVariableSystem.Exists( 'selected_potential_building' ) ), EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' ) ) )]"
			alwaystransparent = "[Or( GetVariableSystem.HasValue( 'selected_potential_building', GUIPotentialItem.GetBuilding.GetKey ), And( Not( GetVariableSystem.Exists( 'selected_potential_building' ) ), EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' ) ) )]"

			selection_glow = {
				visible = "[Or( GetVariableSystem.HasValue( 'selected_potential_building', GUIPotentialItem.GetBuilding.GetKey ), And( Not( GetVariableSystem.Exists( 'selected_potential_building' ) ), EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' ) ) )]"
			}
		}
	}

	type vbox_construct_new_building = vbox_construction_window_contents {
		layoutpolicy_vertical = expanding

		state = {
			name = _show
			on_start = "[GetVariableSystem.Clear( 'selected_potential_building' )]"
		}

		blockoverride "track_content" {
			text_single = {
				name = "no_potential_buildings_text"
				visible = "[IsDataModelEmpty(HoldingView.GetPotentialBuildings)]"
				layoutpolicy_horizontal = shrinking
				text = "NO_POTENTIAL_BUILDINGS_WARNING"
				margin_bottom = 10
			}

			## Construct New Building
			hbox = {
				datacontext = "[HoldingView.GetProvince]"
				visible = "[Not( And( IsDataModelEmpty( HoldingView.GetPotentialBuildings ), IsDataModelEmpty( HoldingView.GetLockedBuildings ) ) )]"
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				spacing = 4

				scrollbox = {
					layoutpolicy_vertical = expanding
					size = { 100 0 }
					blockoverride "scrollbox_content" {
						name = "potential_building_icons"

						vbox = {
							spacing = 8
							oncreate = "[BindFoldOutContext]"

							## Buildings you currently meet the requirements for
							## (But may not currently be able to afford)
							vbox = {
								visible = "[Not( IsDataModelEmpty( HoldingView.GetPotentialBuildings ) )]"
								spacing = 8
								datamodel = "[HoldingView.GetPotentialBuildings]"

								item = {
									widget = {
										datacontext = "[GUIPotentialBuildingItem.AccessAsPotentialItem]"
										size = { 64 64 }

										button_potential_building = {}
									}
								}
							}

							widget = {
								name = "collapse_future_buildings"
								visible = "[DataModelHasItems( HoldingView.GetLockedBuildings)]"
								layoutpolicy_horizontal = expanding
								size = { 0 22 }

								button_expand_fold_out_up_down = {
									parentanchor = center
									tooltip = "FUTURE_POSSIBLE_BUILDINGS"
								}

								divider_light = {
									size = { 100% 3 }
									parentanchor = center
								}
							}

							## Buildings which currently don't meet 1 or more requirements
							## But could be constructed in the future
							vbox = {
								visible = "[And( PdxGuiFoldOut.IsUnfolded, DataModelHasItems( HoldingView.GetLockedBuildings) )]"
								spacing = 8
								datamodel = "[HoldingView.GetLockedBuildings]"

								item = {
									widget = {
										datacontext = "[GUIPotentialBuildingItem.AccessAsPotentialItem]"
										size = { 64 64 }

										button_potential_building = {
											blockoverride "icon_alpha" {
												alpha = 0.5
											}
											blockoverride "selected_state" {
												down = "[Or( GetVariableSystem.HasValue( 'selected_potential_building', GUIPotentialItem.GetBuilding.GetKey ), And3( Not( GetVariableSystem.Exists( 'selected_potential_building' ) ), IsDataModelEmpty( HoldingView.GetPotentialBuildings ), EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' ) ) )]"
												alwaystransparent = "[Or( GetVariableSystem.HasValue( 'selected_potential_building', GUIPotentialItem.GetBuilding.GetKey ), And3( Not( GetVariableSystem.Exists( 'selected_potential_building' ) ), IsDataModelEmpty( HoldingView.GetPotentialBuildings ), EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' ) ) )]"

												selection_glow = {
													visible = "[Or( GetVariableSystem.HasValue( 'selected_potential_building', GUIPotentialItem.GetBuilding.GetKey ), And3( Not( GetVariableSystem.Exists( 'selected_potential_building' ) ), IsDataModelEmpty( HoldingView.GetPotentialBuildings ), EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' ) ) )]"
												}
											}
										}
									}
								}
							}
						}
					}
				}

				# picks out ONE item from the datamodel of all buildings to show
				widget = {
					name = "detail_view"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					vbox = {
						visible = "[Not( IsDataModelEmpty( HoldingView.GetPotentialBuildings ) )]"
						size = { 100% 100% }
						datamodel = "[HoldingView.GetPotentialBuildings]"

						item = {
							vbox_potential_building_detail = {
								datacontext = "[GUIPotentialBuildingItem.AccessAsPotentialItem]"
								visible = "[Or( GetVariableSystem.HasValue( 'selected_potential_building', GUIPotentialItem.GetBuilding.GetKey ), And( Not( GetVariableSystem.Exists( 'selected_potential_building' ) ), EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' ) ) )]"
							}
						}
					}

					vbox = {
						visible = "[Not( IsDataModelEmpty( HoldingView.GetLockedBuildings ) )]"
						size = { 100% 100% }
						datamodel = "[HoldingView.GetLockedBuildings]"

						item = {
							vbox_potential_building_detail = {
								datacontext = "[GUIPotentialBuildingItem.AccessAsPotentialItem]"
								visible = "[Or( GetVariableSystem.HasValue( 'selected_potential_building', GUIPotentialItem.GetBuilding.GetKey ), And3( Not( GetVariableSystem.Exists( 'selected_potential_building' ) ), IsDataModelEmpty( HoldingView.GetPotentialBuildings ), EqualTo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)0' ) ) )]"
							}
						}
					}
				}
			}
		}
	}

	### BUILDING LEVEL TRACK TYPES ###
	type hbox_track_item_action_row = hbox {
		spacing = 10

		hbox = {
			visible = "[And( Or( GUITrackItem.HasNextBuilding, GUITrackItem.IsCurrentBuildingSelected ), Not( GUITrackItem.IsGreatBuildingRuined ) )]"
			layoutpolicy_horizontal = expanding
			margin = { 0 10 }

			hbox = {
				visible = "[GUITrackItem.HasNextBuilding]"
				margin = { 10 5 }
				margin_right = 15
				spacing = 10

				background = {
					using = Background_Area
					margin_bottom = 4
					margin_left = 6
				}

				text_single = {
					datacontext = "[GUITrackItem.GetNextGoldCost( GetPlayer.Self )]"
					visible = "[GUITrackItem.HasNextGoldCost]"
					text = "[ValueBreakdown.GetValue]"
					tooltip_visible = "[ValueBreakdown.HasTooltip]"

					tooltipwidget = {
						widget_value_breakdown_tooltip = {  }
					}

					background = {
						visible = "[Not( GUITrackItem.CanAffordNextCost( GetPlayer.Self ) )]"
						using = Status_Bad
					}
				}

				text_single = {
					datacontext = "[GUITrackItem.GetNextPrestigeCost]"
					visible = "[GUITrackItem.HasNextPrestigeCost]"
					text = "[ValueBreakdown.GetValue]"
					tooltip_visible = "[ValueBreakdown.HasTooltip]"

					tooltipwidget = {
						widget_value_breakdown_tooltip = {  }
					}

					background = {
						visible = "[LessThan_CFixedPoint( GetPlayer.GetPrestige, ValueBreakdown.GetFixedPointValue )]"
						using = Status_Bad
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					datacontext = "[GUITrackItem.GetNextPietyCost]"
					visible = "[GUITrackItem.HasNextPietyCost]"

					text_single = {
						text = "[ValueBreakdown.GetValue]"
						tooltip_visible = "[ValueBreakdown.HasTooltip]"

						tooltipwidget = {
							widget_value_breakdown_tooltip = {  }
						}
					}

					text_single = {
						visible = "[LessThan_CFixedPoint( GetPlayer.GetPiety, ValueBreakdown.GetFixedPointValue )]"
						raw_text = "@warning_icon!"
					}
					expand = {  }
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					datacontext = "[GUITrackItem.GetNextConstructionTime]"
					visible = "[LessThan_CFixedPoint( '(CFixedPoint)0', ValueBreakdown.GetFixedPointValue )]"
					text = "[ValueBreakdown.GetValue]"
					tooltip_visible = "[ValueBreakdown.HasTooltip]"

					tooltipwidget = {
						widget_value_breakdown_tooltip = {  }
					}
				}
			}
		}

		hbox = {
			visible = "[GUITrackItem.IsGreatBuildingRuined]"
			layoutpolicy_horizontal = expanding

			hbox = {
				margin = { 10 5 }
				margin_right = 15
				spacing = 10

				background = {
					using = Background_Area
					margin_bottom = 4
					margin_left = 6
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					text = "[GUITrackItem.GetRebuildConstructionTime]"
				}
			}
		}

		container = {
			name = "main_construction_button"
			visible = "[And4( GUITrackItem.HasNextBuilding, Not( GUITrackItem.IsUpgradingWithGreatProject ), Not( GUITrackItem.IsGreatBuildingRuined ), Not( GUITrackItem.IsSponsorConstructionVisible ) )]"

			# Swaps between a primary look and a tertiary look depending on if it will queue the construction or not
			button_primary = {
				visible = "[Not( And3( GUITrackItem.CanQueueNextBuilding, Not( GUITrackItem.CanConstructNextBuilding ), Not( GUITrackItem.UpgradesViaGreatProject ) ))]"
				text = "[SelectLocalization( EqualTo_int32( GUITrackItem.GetNextBuilding.GetLevel, '(int32)1' ), 'CONSTRUCT', Select_CString( GUITrackItem.UpgradesViaGreatProject, 'CONSTRUCT_BUILDING_PLAN_EXPANSION', 'UPGRADE' ) )]"
				using = Main_Construction_Button
			}

			button_tertiary = {
				visible = "[And3( GUITrackItem.CanQueueNextBuilding, Not( GUITrackItem.CanConstructNextBuilding ), Not( GUITrackItem.UpgradesViaGreatProject ) )]"
				text = "[SelectLocalization( EqualTo_int32( GUITrackItem.GetNextBuilding.GetLevel, '(int32)1' ), 'QUEUE_CONSTRUCTION', 'QUEUE_UPGRADE' )]"
				using = Main_Construction_Button
			}
		}

		button_primary = {
			name = "merchant_sponsor_construction_tutorial_uses_this"
			widgetid = "merchant_sponsor_construction_tutorial_uses_this"
			onclick = "[GUITrackItem.OpenSponsorConstructionInteraction]"
			onclick = "[HoldingView.CloseTracksView]"
			tooltip = "merchant_sponsor_construction_button_tooltip"
			tooltip_when_disabled = "[GUITrackItem.GetSponsorConstructionBlockTooltip]"
			enabled = "[GUITrackItem.CanOpenSponsorConstructionInteraction]"
			visible = "[And( And( And( GUITrackItem.HasNextBuilding, Not( GUITrackItem.IsUpgradingWithGreatProject ) ), Not( GUITrackItem.IsGreatBuildingRuined ) ), GUITrackItem.IsSponsorConstructionVisible )]"
			text = "merchant_sponsor_construction_button"
		}

		button_primary = {
			onclick = "[GUITrackItem.ShowGreatProjectUpgrade]"
			onclick = "[HoldingView.CloseTracksView]"
			visible = "[GUITrackItem.IsUpgradingWithGreatProject]"
			text = "CONSTRUCT_BUILDING_SEE_UPGRADE_PROJECT"
		}

		button_primary = {
			onclick = "[CreateCommandPopup( HoldingView.GetProvince.RebuildGreatDistrict( GetPlayer ) )]"
			enabled = "[IsValidCommand( HoldingView.GetProvince.RebuildGreatDistrict( GetPlayer ) )]"
			tooltip = "[GetCommandDesc( HoldingView.GetProvince.RebuildGreatDistrict( GetPlayer ) )]"
			visible = "[GUITrackItem.IsGreatBuildingRuined]"
			text = "REBUILD_GREAT_BUILDING_BUTTON"
		}
	}

