				tooltip = "CANCEL_HOLDING_CONSTRUCTION_TOOLTIP"
				min_height = 64

				text_multi = {
					text = "CANCEL_HOLDING_CONSTRUCTION"
					parentanchor = center
					max_width = 170
					autoresize = yes
					using = Font_Size_Medium
					align = center|nobaseline
					default_format = "#clickable"
				}
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			margin = { 4 4 }

			button_standard = {
				name = "holding_district_button_tutorial_uses_this"
				# reactive_advice_building_needs uses this
				visible = "[HoldingView.HasHolding]"
				datacontext = "[HoldingView.GetGUIHoldingDistrict]"
				min_height = 84
				layoutpolicy_horizontal = expanding
				onclick = "[GUIDistrictItem.OnClick]"
				down = "[GUIDistrictItem.IsHighlighted]"

				tooltipwidget = {
					district_item_tooltip = {  }
				}

				hbox = {
					margin = { 8 8 }
					ignoreinvisible = no

					vbox = {
						visible = "[HoldingView.GetTitle.HasHolder]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 4

						widget = {
							layoutpolicy_horizontal = expanding
							size = { 0 30 }

							background = {
								visible = "[Not( HoldingView.GetProvince.HasFort )]"
								using = Background_Area
							}

							county_holding_stat = {
								visible = "[HoldingView.GetProvince.HasFort]"
								size = { 100% 100% }
								tooltip = "[Province.GetFortLevelTooltip]"
								blockoverride "card_icon" {
									texture = "gfx/interface/window_siege/fort_icon.dds"
								}
								blockoverride "card_value" {
									text = "HOLDING_FORT_LEVEL_VALUE"
								}
							}
						}

						county_holding_stat = {
							layoutpolicy_horizontal = expanding
							tooltip = "[HoldingView.GetGarrisonTooltip]"
							blockoverride "card_icon" {
								texture = "gfx/interface/icons/icon_garrison.dds"
							}
							blockoverride "card_value" {
								text = "HOLDING_GARRISON_VALUE"
							}
						}
					}

					widget = {
						name = "holding_district"
						size = { 64 64 }

						background = {
							using = Background_Area_Dark
							alpha = 0.65
						}

						widget = {
							visible = "[Nor( GUIDistrictItem.IsInQueue, GUIDistrictItem.CanConstructDistrict )]"
							size = { 100% 100% }
							alpha = "[Select_float( GUIDistrictItem.IsDistrictInactive, '(float)0.5', '(float)1.0' )]"

							icon_holding_district_art = {
								visible = "[EqualTo_string( HoldingView.GetHolding.GetType.GetKey, 'castle_holding' )]"
								texture = "gfx/interface/icons/building_types/holding_type/castle.dds"
								size = { 100% 100% }
							}

							icon_holding_district_art = {
								visible = "[EqualTo_string( HoldingView.GetHolding.GetType.GetKey, 'city_holding' )]"
								texture = "gfx/interface/icons/building_types/holding_type/city.dds"
								size = { 100% 100% }
							}

							icon_holding_district_art = {
								visible = "[EqualTo_string( HoldingView.GetHolding.GetType.GetKey, 'church_holding' )]"
								texture = "gfx/interface/icons/building_types/holding_type/temple.dds"
								size = { 100% 100% }
							}

							# CfV PoD: Grand City icon
							icon_holding_district_art = {
								visible = "[EqualTo_string( HoldingView.GetHolding.GetType.GetKey, 'grand_city_holding' )]"
								texture = "gfx/interface/icons/laws/republic_type_civic.dds"
								size = { 100% 100% }
							}

							icon_holding_district_art = {
								visible = "[EqualTo_string( HoldingView.GetHolding.GetType.GetKey, 'temple_citadel_holding' )]"
								texture = "gfx/interface/icons/building_types/holding_type/temple_citadel.dds"
								size = { 100% 100% }
							}

							icon_holding_district_art = {
								visible = "[EqualTo_string( HoldingView.GetHolding.GetType.GetKey, 'tribal_holding' )]"
								texture = "gfx/interface/icons/building_types/holding_type/tribes.dds"
								size = { 100% 100% }
							}

							icon_holding_district_art = {
								visible = "[EqualTo_string( HoldingView.GetHolding.GetType.GetKey, 'nomad_holding' )]"
								texture = "gfx/interface/icons/building_types/holding_type/nomad.dds"
								size = { 100% 100% }
							}

							icon_holding_district_art = {
								visible = "[EqualTo_string( HoldingView.GetHolding.GetType.GetKey, 'herder_holding' )]"
								texture = "gfx/interface/icons/building_types/holding_type/herder.dds"
								size = { 100% 100% }
							}

							progressbar_standard = {
								name = "construct_progressbar"
								visible = "[GUIDistrictItem.IsConstructingBuilding]"
								parentanchor = bottom|hcenter
								alwaystransparent = yes
								size = { 100% 10 }
								value = "[Holding.GetConstructionProgress]"
								direction = horizontal
							}
						}

						warning_icon = {
							name = "reduced_by_fixable_situation"
							visible = "[Or( GUIDistrictItem.IsDistrictDisabled, GUIDistrictItem.IsDistrictInactive )]"
							alwaystransparent = yes
							position = { -3 0 }
							size = { 28 28 }
						}

						button_icon_can_upgrade = {
							visible = "[GUIDistrictItem.HasImmediatelyUpgradableBuilding]"
							tooltip = "HOLDING_DISTRICT_CAN_UPGRADE_BUILDING_NOW"
							parentanchor = top|right
						}

						widget_icon_can_build  = {
							visible = "[GUIDistrictItem.HasImmediatelyConstructableBuilding]"
							parentanchor = top|right
						}

						widget_in_build_queue_indicator = {
							blockoverride "visible_data" {
								visible = "[GUIDistrictItem.IsInQueue]"
							}
							parentanchor = top|left
							blockoverride "queue_position_data" {
								raw_text = "##[GUIDistrictItem.GetLocalQueuePosition]"
							}
							position = { 0 -4 }
						}

						widget_cancel_district_construction_button = {
							visible = "[And( Or( GUIDistrictItem.IsConstructing, GUIDistrictItem.IsInQueue ), GUIDistrictItem.CanShowCancel ) ]"
							parentanchor = top|right
						}
					}
				}

				icon_construction_progress_indicator = {
					parentanchor = top|right
					position = { -2 2 }
					size = { 28 28 }
					blockoverride "icon_size" {
						size = { 20 20 }
					}
					blockoverride "visible_data" {
						visible = "[And3( GUIDistrictItem.IsOperational, Not( GUIDistrictItem.IsDistrictRuined ), GUIDistrictItem.IsConstructingBuilding )]"
					}
				}
			}
		}

	}

