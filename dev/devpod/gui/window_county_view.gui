	### POTENTIAL BUILDING/DISTRICT TYPES ###
	type vbox_potential_building_detail = vbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		hbox = {
			name = "header"
			layoutpolicy_horizontal = expanding
			datacontext = "[HoldingView.GetViewedDistrictType]"

			background = {
				using = Background_Area
			}

			background = {
				texture = "[DistrictType.GetBackground( HoldingView.GetProvince )]"
				alpha = 0.3
				fittype = centercrop

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_rough_edges.dds"
					spriteType = Corneredtiled
					spriteborder = { 25 25 }
					blend_mode = alphamultiply
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 8
				margin_left = 16

				vbox = {
					layoutpolicy_vertical = expanding
					margin_bottom = 8

					expand = {}

					text_label_left = {
						using = Font_Size_Small
						align = left
						autoresize = yes
						multiline = yes

						min_width = 200
						max_width = 200

						text = "[DistrictType.CalcTriggeredNameNoTooltip( HoldingView.GetProvince )]"
						default_format = "#low"
					}

					text_label_left = {
						using = Font_Size_Medium
						align = left
						autoresize = yes
						multiline = yes

						min_width = 200
						max_width = 200

						text = "[GUIPotentialItem.GetBuilding.CalcTriggeredNameNoTooltip( HoldingView.GetProvince )]"
					}


				}

				expand = {}

				vbox = {
					layoutpolicy_vertical = expanding
					margin_bottom = 12

					expand = {}

					icon_flat_standard = {
						size = { 30 30 }
						texture = "gfx/interface/icons/flat_icons/internal_building.dds"
						using = tooltip_es

						tooltipwidget = {
							potential_building_upgrade_levels_tooltip = {}
						}
					}
				}


				vbox = {
					margin = { 8 0 }
					margin_top = 3
					margin_bottom = 8

					spacing = 4

					background = {
						using = Background_Area_Dark
					}

					potential_item_costs = {}

					# Construct / Queue buttons
					vbox = {
						layoutpolicy_horizontal = expanding
						margin = { 4 4 }

						button_standard = {
							size = { 120 36 }
							layoutpolicy_horizontal = expanding

							text = "START_CONSTRUCTION"
							using = tooltip_es

							visible = "[And( Not( GUIPotentialBuildingItem.IsSponsorConstructionVisible ), Or( GUIPotentialBuildingItem.CanConstruct, Not( GUIPotentialBuildingItem.CanQueue ) ) )]"
							enabled = "[GUIPotentialBuildingItem.CanConstruct]"
							onclick = "[GUIPotentialBuildingItem.Queue]"
							onclick = "[GetVariableSystem.Clear( 'selected_potential_building' )]"
							tooltip = "[GUIPotentialBuildingItem.GetTooltip( GetPlayer.Self )]"
						}

						button_tertiary = {
							size = { 120 36 }
							layoutpolicy_horizontal = expanding

							text = "QUEUE_CONSTRUCTION"
							using = tooltip_es

							visible = "[And( Not( GUIPotentialBuildingItem.IsSponsorConstructionVisible ), And( GUIPotentialBuildingItem.CanQueue, Not( GUIPotentialBuildingItem.CanConstruct ) ) )]"
							enabled = "[GUIPotentialBuildingItem.CanQueue]"
							onclick = "[GUIPotentialBuildingItem.Queue]"
							onclick = "[GetVariableSystem.Clear( 'selected_potential_building' )]"
							tooltip = "[GUIPotentialBuildingItem.GetTooltip( GetPlayer.Self )]"
						}

						button_standard = {
							size = { 120 36 }
							layoutpolicy_horizontal = expanding

							text = "merchant_sponsor_construction_button"
							onclick = "[HoldingView.CloseTracksView]"
							tooltip = "merchant_sponsor_construction_button_tooltip"
							using = tooltip_es

							visible = "[GUIPotentialBuildingItem.IsSponsorConstructionVisible]"
							enabled = "[GUIPotentialBuildingItem.CanOpenSponsorConstructionInteraction]"
							onclick = "[GUIPotentialBuildingItem.OpenSponsorConstructionInteraction]"
							tooltip_when_disabled = "[GUIPotentialBuildingItem.GetSponsorConstructionBlockTooltip]"
						}
					}
				}
			}
		}

		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			blockoverride "scrollbox_content" {
				vbox = {
					name = "dynamic_content"
					layoutpolicy_horizontal = expanding
					spacing = 6

					text_single = {
						visible = "[Not( GUIPotentialBuildingItem.MeetsDistrictLevelRequirement )]"
						text = "BUILDING_DISTRICT_LEVEL_REQUIREMENT"
						default_format = "#X"
						layoutpolicy_horizontal = expanding
						autoresize = no
						margin = { 6 0 }
						align = nobaseline
					}

					vbox_building_effect_and_needs = {
						blockoverride "effect_description" {
							text_multi = {
								layoutpolicy_horizontal = expanding
								autoresize = yes
								min_width = 380
								max_width = 380
								text = "[GUIPotentialItem.GetBuilding.GetEffectDescriptionAtProvinceWithoutNeeds( Character.Self, Province.Self )]"
							}
						}
						blockoverride "needs_list" {
							vbox = {
								layoutpolicy_horizontal = expanding
								datamodel = "[GUIPotentialItem.GetBuildingNeeds]"

								item = {
									building_need_segment_preview = {
										blockoverride "building_need_segment_effect_description_width" {
											min_width = 260
											max_width = 260
										}

									}
								}
							}
						}
					}

					text_building_flavor = {
						datacontext = "[GUIPotentialItem.GetBuilding]"
						max_width = 380
					}

					expand = {}
				}
			}
		}
	}

