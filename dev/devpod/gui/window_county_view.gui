											}

											hbox = {
												name = "holding_rare_statuses"
												spacing = 4
												ignoreinvisible = yes

												datamodel = "[HoldingView.GetHoldingStatuses]"

												item = {
													widget = {
														### This visible trigger checks if there are more than 8 elements amongst modifiers, plagues and legends in a barony
														visible = "[And( Or( HoldingStatus.IsEpidemic, HoldingStatus.IsLegend ), LessThan_int32( PdxGuiWidget.GetIndexInDataModel, Add_int32( Subtract_int32( GetDataModelSize( HoldingView.GetHoldingStatuses ), Add_int32( GetDataModelSize( HoldingView.GetProvince.GetEpidemics ), GetDataModelSize( HoldingView.GetProvince.GetLegends ) ) ), Select_int32( GreaterThan_int32( Add_int32( Add_int32( GetDataModelSize( HoldingView.GetProvince.GetEpidemics ), GetDataModelSize( HoldingView.GetProvince.GetLegends ) ), GetDataModelSize( HoldingView.GetHoldingModifiers ) ), '(int32)8' ), '(int32)7', '(int32)8' ) ) ) )]"
														size = { 38 38 }

														county_holding_status_epidemic = {
															parentanchor = center
														}

														county_holding_status_legend = {
															parentanchor = center
														}
