					text = "[HoldingView.GetProvince.GetTerrain.GetNameNoTooltip]"
					default_format = "#high"
				}

				expand = {}

				vbox = {
					layoutpolicy_horizontal = expanding
					visible = "[Province.HasWinter]"
					tooltip = "PROVINCE_VIEW_TOOLTIP_WINTER"


					text_single = {
						layoutpolicy_horizontal = expanding
						visible = "[Province.HasWinterLevel( '(int32)1' )]"
						text = "TERRAIN_MILD_WINTER"
						default_format = "#high"
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						visible = "[Province.HasWinterLevel( '(int32)2' )]"
						text = "TERRAIN_NORMAL_WINTER"
						default_format = "#high"
					}

					text_single = {
						layoutpolicy_horizontal = expanding
						visible = "[Province.HasWinterLevel( '(int32)3' )]"
						text = "TERRAIN_HARSH_WINTER"
						default_format = "#high"
					}
				}

				expand = {}
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding

			widget = {
				size = { 0 48 }
				layoutpolicy_horizontal = expanding
				#enabled = no
				datacontext = "[Holding.GetProvince]"
