	type widget_monthly_change_breakdown_tooltip = widget_value_breakdown_list {
		blockoverride "background" {
			using = DefaultTooltipBackground
		}
		blockoverride "list" {
			margin_bottom = 17
		}
		blockoverride "header" {
			text_single = {
				layoutpolicy_horizontal = expanding
				text = "COUNTY_MONTHLY_CHANGE_HEADER"
				default_format = "#T"
			}
		}
	}

	type county_value_cooltip = container {
		using = GeneralTooltipSetup
		alwaystransparent = no
		object_tooltip_pop_out = {
			blockoverride "header_additions" {
				widget = {
					size = { 42 42 }

					icon = {
						size = { 42 42 }
						parentanchor = center
						position = { -8 0 }
						block "icon" {}
					}
				}
			}
			blockoverride "main_description" {
				vbox = {
					min_width = 400
					layoutpolicy_horizontal = expanding
					spacing = 20
					allow_outside = yes

					hbox = {
						layoutpolicy_horizontal = expanding
						margin_left = 8

						vbox = {
							spacing = 8
							block "current_level_effects" {}
						}
						expand = {  }
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 2
						margin_bottom = 8

						background = {
							using = Text_Label_Background
							margin_left = 8
						}

						text_single = {
							text = "COUNTY_VALUE_LEVELS"
						}
						expand = {  }
					}

					vbox = {
						margin_top = 25
						allow_outside = yes

						widget = {
							size = { 460 30 }
							allow_outside = yes

							hbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								spacing = 4
								allow_outside = yes

								text_single = {
									min_width = 35
									text = "[ComplexBar.GetMinValue]"
									align = center|nobaseline
									default_format = "#low"
								}

								widget = {
									allow_outside = yes
									layoutpolicy_horizontal = expanding
									block "levels" {}
								}

								text_single = {
									min_width = 35
									align = center|nobaseline
									default_format = "#low"
									block "max_value" {
										text = "[ComplexBar.GetMaxValue]"
									}
								}
							}
						}
					}

					cooltip_paragraph = {
						align = nobaseline|hcenter
						block "current_level_value" {
							visible = no
						}
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 4

						block "pod_hide_size_baseline" {} # CfV PoD

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 3
							margin_top = 2
							margin_bottom = 8

							background = {
								using = Text_Label_Background
								margin_left = 8
							}

							text_single = {
								text = "COUNTY_VALUE_BASELINE"
							}

							hbox = {
								spacing = 3

								text_single = {
									default_format = "#high;L"
									tooltip_visible = "[ValueBreakdown.HasTooltip]"
									using = tooltip_se
									block "baseline_level" {}
									block "baseline_tooltip" {}
									block "baseline_context" {}
								}
								text_single = {
									block "baseline_value" {
										text = "COUNTY_LEVEL_VALUE"
										default_format = "#low"
									}
								}
							}
							expand = {  }

							hbox = {
								spacing = 3

								text_single = {
									text = "COUNTY_VALUE_TREND"
									tooltip_visible = "[ValueBreakdown.HasTooltip]"
									using = tooltip_se

									tooltipwidget = {
										widget_monthly_change_breakdown_tooltip = {  }
									}
								}
								text_value_indicator = {
									block "indicator" {}
								}
								block "gain" {}
							}
						}
						vbox_value_breakdown_list = {
							block "baseline_value_breakdown_list" {}
						}
						block "baseline_context" {}
					}
					block "baseline_reasons" {}
					block "post_content" {}
				}
			}
		}
	}

	type county_control_cooltip = county_value_cooltip {
		block "county_context" {
			datacontext = "[HoldingView.GetProvince.GetCounty]"
			datacontext = "[HoldingView.AccessCountyBreakdowns]"
			datacontext = "[County.GetCount.GetGovernment]"
			datacontext = "[HoldingView.AccessCountyControlBar]"
		}
		blockoverride "title_text" {
			text = "COUNTY_CONTROL_CURRENT_LEVEL"
			default_format = "#T"
		}
		blockoverride "concept_link" {
			text = "COUNTY_CONTROL_CONCEPT"
		}
		blockoverride "icon" {
			texture = "gfx/interface/icons/message_feed/control.dds"
		}
		blockoverride "current_level_effects" {
			cooltip_paragraph = {
				text = COUNTY_CONTROL_CURRENT_EFFECTS
			}
			cooltip_paragraph = {
				visible = "[And( And( County.UsesCountyFertility, Not( IsHerder( County.GetCount ) ) ), LessThan_CFixedPoint( County.GetControl, '(CFixedPoint)100' ) )]"
				text = COUNTY_CONTROL_FERTILITY_EFFECT
			}
		}
		blockoverride "current_level_value" {
			visible = yes
			text = "COUNTY_CONTROL_TOOLTIP_VALUE"
		}
		blockoverride "baseline_context" {
			datacontext = "[CountyDataBreakdowns.AccessBaseControl( County.Self )]"
		}
		blockoverride "baseline_level" {
			text = "COUNTY_CONTROL_BASELINE_LEVEL"
		}
		blockoverride "baseline_tooltip" {
			tooltip = "COUNTY_CONTROL_BASELINE_TOOLTIP"
		}
		blockoverride "gain" {
			datacontext = "[CountyDataBreakdowns.AccessControl( County.Self )]"
		}
		blockoverride "levels" {
			hbox_county_complex_bar_progress = {  }
			# inactive
			hbox_complex_bar_levels = {
				blockoverride "marker" {
					widget_level_marker = {
						position = { 0 -27 }
						blockoverride "marker_size_inactive" {
							size = { 35 35 }
						}
						blockoverride "visible_inactive" {
							visible = "[EqualTo_int32( Modulo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)5' ), '(int32)0' )]"
						}
						blockoverride "visible_active" {
							visible = no
						}
						blockoverride "marker_addon" {
							container = {
								position = { 0 30 }
								parentanchor = hcenter

								icon = {
									visible = "[Not( EqualTo_int32( Modulo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)5' ), '(int32)0' ))]"
									texture = "gfx/interface/colors/white.dds"
									using = Mask_Rough_Edges
									size = { 5 15 }
									position = { 0 3 }
									alpha = 0.6
									parentanchor = center
								}

								icon = {
									visible = "[EqualTo_int32( Modulo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)5' ), '(int32)0' )]"
									texture = "gfx/interface/colors/white.dds"
									using = Mask_Rough_Edges
									size = { 6 30 }
									alpha = 0.7
								}
							}
						}
					}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				allow_outside = yes
				alwaystransparent = yes

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutstretchfactor_horizontal = "[ValueBreakdown.GetIntegerValue]"
				}
				widget_baseline_indicator = {
					blockoverride "baseline_icon" {
						tooltip = "COUNTY_CONTROL_BASELINE_INDICATOR_TOOLTIP"
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutstretchfactor_horizontal = "[Subtract_int32( FixedPointToInt( ComplexBar.GetMaxValue ), ValueBreakdown.GetIntegerValue )]"
				}
				block "baseline_context" {}
			}
			blockoverride "marker_tooltip" {
				datacontext = "[ComplexBarItem]"
				tooltip = "COUNTY_CONTROL_MARKER_TOOLTIP"
				using = tooltip_se
			}
			blockoverride "marker_text" {
				text = "[Subtract_int32( ComplexBarItem.GetIndex, '(int32)10' )]"
			}
		}
	}

	type widget_baseline_indicator = widget {
		size = { 0 0 }
		allow_outside = yes

		icon = {
			parentanchor = hcenter
			position = { 0 4 }
			size = { 22 22 }
			texture = "gfx/interface/icons/change_indicator_icons.dds"
			framesize = { 26 26 }
			frame = 4

			modify_texture = {
				using = Color_Grey
				blend_mode = normal
				block "neutral" {
					visible = "[EqualTo_int32( ValueBreakdown.GetIntegerValue, ComplexBar.GetCurrentFilledWidth )]"
				}
			}

			modify_texture = {
				using = Color_Red
				blend_mode = normal
				block "negative" {
					visible = "[LessThan_int32( ValueBreakdown.GetIntegerValue, ComplexBar.GetCurrentFilledWidth )]"
				}
			}

			modify_texture = {
				using = Color_Green
				blend_mode = normal
				block "positive" {
					visible = "[GreaterThan_int32( ValueBreakdown.GetIntegerValue, ComplexBar.GetCurrentFilledWidth )]"
				}
			}
			block "baseline_icon" {}
		}
	}

