		button_icon_highlight = {
			name = "level_icon"
			parentanchor = center
			size = { 40 40 }
			down = "[GUITrackItem.IsCurrentBuildingSelected]"
			texture = "[GUITrackItem.GetCurrentLevelIcon]"
		}
		#icon = {
		#	visible = "[GUITrackItem.IsCurrentBuildingSelected]"
