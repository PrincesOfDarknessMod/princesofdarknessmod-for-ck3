									texture = "gfx/interface/colors/white.dds"
									using = Mask_Rough_Edges
									size = { 5 15 }
									position = { 0 3 }
									alpha = 0.6
									parentanchor = center
								}

								icon = {
									visible = "[Not( EqualTo_int32( Modulo_int32( PdxGuiWidget.GetIndexInDataModel, '(int32)2' ), '(int32)0' ))]"
									texture = "gfx/interface/colors/white.dds"
									using = Mask_Rough_Edges
									size = { 6 30 }
									alpha = 0.7
								}

								icon = {
									visible = "[EqualTo_int32( Province.GetProvinceSizeLevel, PdxGuiWidget.GetIndexInDataModel )]"
									texture = "gfx/interface/colors/white.dds"
									using = Mask_Rough_Edges
									parentanchor = hcenter
									size = { 7 30 }
									alpha = 0.5
								}
							}
						}
					}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				allow_outside = yes
				alwaystransparent = yes
				datacontext = "[CountyDataBreakdowns.AccessProvinceSizeBaseline( Province.Self )]"

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutstretchfactor_horizontal = "[ValueBreakdown.GetIntegerValue]"
				}
				widget_baseline_indicator = {
					blockoverride "baseline_icon" {
						tooltip = "PROVINCE_SIZE_BASELINE_INDICATOR_TOOLTIP"
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutstretchfactor_horizontal = "[Subtract_int32( FixedPointToInt( ComplexBar.GetMaxValue ), ValueBreakdown.GetIntegerValue )]"
				}
			}
			blockoverride "marker_tooltip" {
				datacontext = "[ComplexBarItem]"
				tooltip = "PROVINCE_SIZE_MARKER_TOOLTIP"
				using = tooltip_se
			}
			blockoverride "marker_text" {
				text = "[ComplexBarItem.GetIndex]"
			}
		}
	}

	# Requires County and CountyDataBreakdowns data context
	type county_prosperity_tooltip_container = container {
		using = GeneralTooltipSetup
		alwaystransparent = no
		object_tooltip_pop_out = {
			blockoverride "title_text" {
				margin = { 0 8 }
