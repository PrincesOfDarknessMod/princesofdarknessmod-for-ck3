	type hbox_popular_opinion_complex_bar_progress = hbox_complex_bar_progress {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		blockoverride "empty" {}
		blockoverride "filled" {
			background = {
				visible = "[GreaterThanOrEqualTo_int32( County.GetCurrentOpinion, '(int32)0' )]"
				texture = "gfx/interface/progressbars/progress_standard.dds"
			}

			background = {
				visible = "[LessThan_int32( County.GetCurrentOpinion, '(int32)0' )]"
				texture = "gfx/interface/progressbars/progress_grandeur_decrease.dds"
			}
		}
	}

