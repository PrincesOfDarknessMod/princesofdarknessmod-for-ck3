	type building_need_tooltip = object_tooltip_pop_out {
		blockoverride "title_text" {
			default_format = "#T"
			margin = { 0 8 }
			block "building_need_tooltip_header" {
				text = "BUILDING_NEED_TOOLTIP_HEADER"
			}
		}
		blockoverride "concept_link" {
			text = "[building_need|E]"
		}
		blockoverride "main_description" {
			datacontext = "[Province.GetTradeMarket]"
			spacing = 8

			cooltip_paragraph = {
				text = "BUILDING_NEED_TOOLTIP_CONSUMPTION"
				align = nobaseline
				block "building_need_tooltip_consumption_text" {
					visible = yes
				}
			}

			cooltip_paragraph = {
				visible = "[GUIBuildingNeedItem.HasSourceDescription]"
				text = "BUILDING_NEED_SOURCE_LINE"
				align = nobaseline
			}

			vbox = {
				layoutpolicy_horizontal = expanding

				text_label_left = {
					text = "BUILDING_NEED_TOOLTIP_MARKET_LABEL"
					layoutpolicy_horizontal = expanding
					autoresize = no
				}

				vbox = {
					# Market Status for a Category
					visible = "[GUIBuildingNeedItem.IsCategoryNeed]"
					datacontext = "[GUIBuildingNeedItem.GetTradeGoodCategory]"
					layoutpolicy_horizontal = expanding

					vbox = {
						layoutpolicy_horizontal = expanding
						datamodel = "[TradeGoodCategory.GetTradeGoodTypes]"

						item = {
							building_need_tooltip_goods_market_entry = {  }
						}
					}
					building_need_tooltip_category_market_entry = {  }
				}

				vbox = {
					# Market Status for a Good
					visible = "[Not( GUIBuildingNeedItem.IsCategoryNeed )]"
					datacontext = "[GUIBuildingNeedItem.GetTradeGoodType]"
					layoutpolicy_horizontal = expanding
					building_need_tooltip_goods_market_entry = {  }

					building_need_tooltip_category_market_entry = {
						visible = "[Not(TradeGoodType.IsAloneInNeedCategory)]"
						datacontext = "[TradeGoodType.GetNeedCategory]"
					}
				}
			}
		}
	}

	type building_need_tooltip_goods_market_entry = hbox {
		# needed datacontext
		#TradeGoodType
		#TradeMarket
		layoutpolicy_horizontal = expanding

		text_single = {
			raw_text = "[TradeGoodType.GetNameWithIcon]"
			layoutpolicy_horizontal = expanding
			using = DefaultTooltipText
			fonttintcolor = "[TooltipInfo.GetTintColor]"
		}

		text_single = {
			visible = "[And( TradeMarket.HasTradeBalanceForGood( TradeGoodType.Self ), TradeMarket.HasNetSurplusForGood( TradeGoodType.Self ) )]"
			raw_text = "[GetColoredValueString( TradeMarket.GetNetBalanceMagnitudeForGood( TradeGoodType.Self ), 'trade', '(int32)1' )]"
			default_format = "#underline"
			using = DefaultTooltipText
			fonttintcolor = "[TooltipInfo.GetTintColor]"
			using = tooltip_es

			tooltipwidget = {
				widget_trade_good_net_balance_breakdown_tooltip = {
					datacontext = "[GUIBuildingNeedItem.GetMarketGoodBalance( TradeGoodType.Self )]"
				}
			}
		}

		text_single = {
			visible = "[And( TradeMarket.HasTradeBalanceForGood( TradeGoodType.Self ), Not( TradeMarket.HasNetSurplusForGood( TradeGoodType.Self ) ) )]"
			raw_text = "[TradeMarket.GetNetBalanceMagnitudeForGood( TradeGoodType.Self )|1^]"
			default_format = "#trade_need;underline"
			using = DefaultTooltipText
			fonttintcolor = "[TooltipInfo.GetTintColor]"
			using = tooltip_es

			tooltipwidget = {
				widget_trade_good_net_balance_breakdown_tooltip = {
					datacontext = "[GUIBuildingNeedItem.GetMarketGoodBalance( TradeGoodType.Self )]"
				}
			}
		}

		text_single = {
			visible = "[Not(TradeMarket.HasTradeBalanceForGood( TradeGoodType.Self ))]"
			text = "NO_TRADE_BALANCE"
			default_format = "#low"
			using = DefaultTooltipText
			fonttintcolor = "[TooltipInfo.GetTintColor]"
		}
	}

	type building_need_tooltip_category_market_entry = hbox {
		# needed datacontext
		#TradeGoodCategory
		#TradeMarket
		layoutpolicy_horizontal = expanding

		text_single = {
			raw_text = "[TradeGoodCategory.GetNameWithIcon]"
			layoutpolicy_horizontal = expanding
			using = DefaultTooltipText
			fonttintcolor = "[TooltipInfo.GetTintColor]"
