			using = DefaultTooltipText
			fonttintcolor = "[TooltipInfo.GetTintColor]"
			using = tooltip_es

			tooltipwidget = {
				widget_trade_category_net_balance_breakdown_tooltip = {}
			}
		}
	}

	type building_need_icon = widget {
		size = { 26 26 }

		# tooltip with the building_need_segment
		tooltipwidget = {
			object_tooltip_pop_out = {
				blockoverride "title_text" {
					text = "SINGLE_TRADE_NEED_TOOLTIP_TITLE"
