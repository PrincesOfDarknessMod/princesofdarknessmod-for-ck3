		vbox = {
			name = "constructing_holding"
			visible = "[Not(HoldingView.HasHolding)]"
			spacing = 5
			max_width = 170

			progressbar_standard = {
				name = "constructing_holding_progress"
				alwaystransparent = yes
				layoutpolicy_horizontal = expanding
				value = "[HoldingView.GetConstructionProgressForNewHolding]"
				direction = horizontal
				visible = "[And( Not( HoldingView.HasHolding ), HoldingView.IsBeingConstructed )]"
				tooltip = "[HoldingView.GetHoldingUnderConstructionTooltip( GetPlayer.Self )]"

				text_single = {
					parentanchor = center
					text = "[HoldingView.GetConstructionTimeLeftForNewHolding]"
					default_format = "#high"
					align = nobaseline
					using = Font_Size_Medium
				}
			}

			button_standard = {
				name = "construct_holding"
				visible = "[And( Not( HoldingView.HasHolding ), Not( HoldingView.IsBeingConstructed ))]"
				layoutpolicy_horizontal = expanding
				enabled = "[And( HoldingView.CanNewHoldingBeConstructed, Not( HoldingView.IsSelectingHoldingType ))]"
				onclick = "[HoldingView.OnConstructHoldingClick]"
				tooltip = "[HoldingView.GetHoldingConstructionTooltip]"
				min_height = 64

				text_multi = {
					text = "CREATE_NEW_HOLDING_BUTTON"
					parentanchor = center
					max_width = 170
					autoresize = yes
					using = Font_Size_Medium
					align = center|nobaseline

					default_format = "#clickable"
				}
			}

			button_standard = {
				name = "cancel_construct_holding"
				visible = "[And3( Not( HoldingView.HasHolding ), HoldingView.IsBeingConstructed, HoldingView.CanCancelHoldingConstruction )]"
				layoutpolicy_horizontal = expanding
				enabled = "[HoldingView.CanCancelHoldingConstruction]"
