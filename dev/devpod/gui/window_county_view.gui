						visible = "[Not( And( HoldingView.GetTitle.HasHolder, HoldingView.HasHolding ) )]"
						using = Background_Area
					}

					county_holding_stat = {
						name = "tutorial_highlight_holding_view_loot_box"
						visible = "[And( HoldingView.GetTitle.HasHolder, HoldingView.HasHolding )]"
						size = { 100% 100% }
						tooltip_visible = yes

						tooltipwidget = {
							widget_value_breakdown_tooltip = {
								datacontext = "[Holding.GetProvince.GetLootBreakdownTooltip]"
							}
						}
						blockoverride "card_icon" {
							texture = "gfx/interface/icons/icon_loot.dds"
						}
