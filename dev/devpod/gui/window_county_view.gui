		layoutpolicy_horizontal = expanding
		size = { 5 6 }

		background = {
			texture = "gfx/interface/icons/building_types/building_buttons_connector.dds"
			margin = { 2 0 }
			using = Master_Button_Modify_Texture
			blockoverride "master_color_frame" {
				frame = 1
			}
		}
	}

