	type widget_district_item = button_standard {
		size = { 68 68 }

		tooltipwidget = {
			district_item_tooltip = {  }
		}
		using = tooltip_ne

		background = {
			using = Background_Area_Characterlist
		}

		button_standard_hover = {
			name = "district_button"
			size = { 100% 100% }
			onclick = "[GUIDistrictItem.OnClick]"
			down = "[GUIDistrictItem.IsHighlighted]"
			enabled = "[Or( Not( GUIDistrictItem.IsEmptySlot ), GUIDistrictItem.IsDistrictButtonEnabled )]"
			alpha = "[Select_float( GUIDistrictItem.IsDistrictInactive, '(float)0.5', '(float)1.0' )]"

			icon_building = {
				name = "queued_district_icon"
