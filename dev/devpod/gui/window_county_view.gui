types CountyViewTypes {

	type holding_stats_sidebar = vbox {
		name = "holding_stats_sidebar"
		max_width = 200
		layoutpolicy_vertical = expanding
		layoutpolicy_horizontal = expanding
		margin = { 8 8 }
		spacing = 2

		background = {
			using = Background_Area
		}

		expand = {visible = "[Not(HoldingView.HasHolding)]"}

		hbox = {
			visible = "[Not(HoldingView.HasHolding)]"
			spacing = 8

			vbox = {
				layoutpolicy_vertical = expanding
				spacing = 2

				expand = {}

				county_holding_status_terrain = {}

				county_holding_status_winter = {}

				expand = {}
			}

			vbox = {
				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding
				spacing = 8

				expand = {}

				text_single = {
					layoutpolicy_horizontal = expanding
					datacontext = "[HoldingView.GetProvince.GetTerrain]"
					datacontext = "[HoldingView.GetProvince]"
