			text = "COUNTY_POPULAR_OPINION_BASELINE_VALUE"
			default_format = "#low"
		}
		blockoverride "gain" {
			block "popular_opinion_monthly_breakdown_context" {
				datacontext = "[CountyDataBreakdowns.AccessMonthlyOpinion( County.Self )]"
			}
		}
		blockoverride "max_value" {
			text = "[ComplexBar.GetMaxValue|=0]"
		}
		blockoverride "levels" {
			background = {
				texture = "gfx/interface/progressbars/progress_black.dds"
			}
			hbox_popular_opinion_complex_bar_progress = {  }

			hbox_opinion_complex_bar_progress = {
				position = { 0 8 }
				margin_top = 20
			}
			hbox_complex_bar_levels = {
				blockoverride "marker" {
					widget_level_marker = {
						position = { 0 -30 }
						blockoverride "marker_size_inactive" {
							size = { 40 40 }
						}
						blockoverride "marker_size" {
							size = { 45 45 }
						}
						blockoverride "visible_inactive" {}
						blockoverride "visible_active" {
							visible = "[EqualTo_int32( County.GetOpinionLevel, PdxGuiWidget.GetIndexInDataModel )]"
						}
						blockoverride "marker_addon" {
							container = {
								position = { 0 30 }
								parentanchor = hcenter

								icon = {
									texture = "gfx/interface/colors/white.dds"
									using = Mask_Rough_Edges
									size = { 6 30 }
									alpha = 0.7
								}

								icon = {
									visible = "[EqualTo_int32( County.GetOpinionLevel, PdxGuiWidget.GetIndexInDataModel )]"
									texture = "gfx/interface/colors/white.dds"
									using = Mask_Rough_Edges
									parentanchor = hcenter
									size = { 7 30 }
									alpha = 0.5
								}
							}
						}
					}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				allow_outside = yes
				alwaystransparent = yes

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutstretchfactor_horizontal = "[Add_int32( ValueBreakdown.GetIntegerValue, FixedPointToInt( ComplexBar.GetMaxValue ))]"
				}
				widget_baseline_indicator = {
					blockoverride "baseline_icon" {
						tooltip = "COUNTY_POPULAR_OPINION_BASELINE_INDICATOR_TOOLTIP"
					}
					blockoverride "neutral" {
						visible = "[EqualTo_int32( ValueBreakdown.GetIntegerValue, County.GetCurrentOpinion )]"
					}
					blockoverride "positive" {
						visible = "[GreaterThan_int32( ValueBreakdown.GetIntegerValue, County.GetCurrentOpinion )]"
					}
					blockoverride "negative" {
						visible = "[LessThan_int32( ValueBreakdown.GetIntegerValue, County.GetCurrentOpinion )]"
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutstretchfactor_horizontal = "[Subtract_int32( FixedPointToInt( ComplexBar.GetMaxValue ), ValueBreakdown.GetIntegerValue )]"
				}
				block "baseline_context" {}
			}
			blockoverride "marker_tooltip" {
				datacontext = "[ComplexBarItem]"
				tooltip = "POPULAR_OPINION_MARKER_TOOLTIP"
				using = tooltip_se
			}
			blockoverride "marker_text" {
				text = "[Divide_CFixedPoint( ComplexBarItem.GetValue, '(CFixedPoint)25' )|+=0]"
			}
		}
	}

	type province_size_cooltip = county_value_cooltip {
		block "county_and_province_context" {
