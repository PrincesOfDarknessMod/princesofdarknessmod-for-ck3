							framesize = { 64 64 }
							texture = "gfx/interface/icons/development_levels.dds"
							frame = "[Select_int32( LessThan_int32( ComplexBarItem.GetIndex, '(int32)1' ), '(int32)1', Select_int32( LessThan_int32( ComplexBarItem.GetIndex, '(int32)3' ), '(int32)2', Select_int32( LessThan_int32( ComplexBarItem.GetIndex, '(int32)5' ), '(int32)3', Select_int32( LessThan_int32( ComplexBarItem.GetIndex, '(int32)7' ), '(int32)4', Select_int32( LessThan_int32( ComplexBarItem.GetIndex, '(int32)9' ), '(int32)5', '(int32)6' ) ) ) ) )]"
						}
						blockoverride "marker_size_inactive" {
							size = { 33 33 }
						}
						blockoverride "marker_size" {
							size = { 40 40 }
						}
						blockoverride "visible_inactive" {
							visible = "[Not( EqualTo_int32( Province.GetProvinceSizeLevel, PdxGuiWidget.GetIndexInDataModel ))]"
						}
						blockoverride "visible_active" {
							visible = "[EqualTo_int32( Province.GetProvinceSizeLevel, PdxGuiWidget.GetIndexInDataModel )]"
						}
						blockoverride "marker_addon" {
							container = {
