					icon = {
						size = { 42 42 }
						parentanchor = center

						texture = "gfx/interface/icons/development_levels.dds"
						## TODO CODE TIT-75751
						framesize = { 64 64 }
						frame = "[Select_int32( LessThan_int32( Province.GetProvinceSizeLevel, '(int32)1' ), '(int32)1', Select_int32( LessThan_int32( Province.GetProvinceSizeLevel, '(int32)3' ), '(int32)2', Select_int32( LessThan_int32( Province.GetProvinceSizeLevel, '(int32)5' ), '(int32)3', Select_int32( LessThan_int32( Province.GetProvinceSizeLevel, '(int32)7' ), '(int32)4', Select_int32( LessThan_int32( Province.GetProvinceSizeLevel, '(int32)9' ), '(int32)5', '(int32)6' ) ) ) ) )]"
					}

					icon = {
						parentanchor = bottom|left
						size = { 26 26 }
						texture = "gfx/interface/window_regency/regency_level_bg.dds"

						text_single = {
							text = "HOLDING_VIEW_PROVINCE_SIZE_VALUE"
							parentanchor = center
							align = nobaseline
							default_format = "#V"
						}
					}

					text_value_indicator = {
						visible = no # CfV: no settlement size changes in PoD
						parentanchor = bottom|right
						position = { 0 -4 }
						tooltip_visible = no
					}
				}
			}

			county_holding_status_maa = {
				visible = "[And( HoldingView.GetHolder.IsLocalPlayer, Regiment.IsValid )]"
			}

			county_trade_market_button = {
				size = { 0 48 }
				layoutpolicy_horizontal = expanding

				visible = no # CfV PoD: hide trade market info (for now)
			}
		}

		hbox = {
			min_height = 32
			layoutpolicy_horizontal = expanding
			visible = "[HoldingView.HasHolding]"

			background = {
				using = Background_Area_Dark
				alpha = 0.65
			}

			widget_value_card = {
				name = "tutorial_highlight_holding_view_taxes_box"
				visible = "[And( HoldingView.HasHolding, Not( Holding.GetHolder.HasBarterGoods ) )]"

				datacontext = "[Holding.GetTaxBreakdownTooltip]"
				tooltip_visible = "[ValueBreakdown.HasTooltip]"

				tooltipwidget = {
					widget_value_breakdown_tooltip = {  }
				}
