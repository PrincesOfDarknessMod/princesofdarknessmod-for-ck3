	### WINDOW TYPES ###
	type window_county_sub_window = window {
		visible_at_creation = no
		parentanchor = bottom|left
		position = { 640 0 }
		size = { 605 675 }
		movable = no
		#using = Window_Background
		using = Animation_ShowHide_Standard
		allow_outside = yes

		state = {
			name = _show
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
			on_finish = "[PdxGuiWidget.StackTop]"
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
		}

		vbox = {
			using = Window_Margins
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			#spacing = 5
			ignoreinvisible = yes
			datacontext = "[HoldingView.GetHolding]"
			datacontext = "[HoldingView.GetProvince]"
			datacontext = "[HoldingView.GetHolder]"
			datacontext = "[Province.GetCounty]"
			datacontext = "[HoldingView.GetDistrict]"

			background = {
				texture = "gfx/interface/skinned/tile_window_background_subwindow.dds"
				spriteType = Corneredtiled
				spriteborder = { 18 18 }
				margin_left = -20
				margin_bottom = 20
				texture_density = 2
				margin_right = -20

				modify_texture = {
					name = "overlay"
					texture = "gfx/interface/component_overlay/overlay_effect.dds"
					spriteType = Corneredstretched
					spriteborder = { 0 0 }
					blend_mode = overlay
				}
			}

			vbox = {
				visible = "[Or( Not( HoldingView.IsBuildingTracksViewShown ), HoldingView.IsSelectingConstruction )]"
				layoutpolicy_horizontal = expanding
				margin_bottom = 5

				background = {
					texture = "[HoldingView.GetViewedDistrictType.GetBackground( HoldingView.GetProvince )]"
					alpha = 1
					fittype = centercrop

					modify_texture = {
						texture = "gfx/interface/component_masks/mask_rough_edges.dds"
						blend_mode = alphamultiply
						alpha = 1
					}

					modify_texture = {
						alpha = 0.8
						texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
						blend_mode = alphamultiply
					}

					modify_texture = {
						alpha = 0.8
						texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
						blend_mode = alphamultiply
						mirror = vertical
					}

					modify_texture = {
						alpha = 0.1
						texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
						mirror = horizontal
						blend_mode = alphamultiply
					}
				}

				# Header
				header_pattern = {
					layoutpolicy_horizontal = expanding

					icon_building = {
						size = { 46 46 }
						texture = "[HoldingView.GetViewedDistrictType.GetTypeIcon]"
					}
					blockoverride "header_text" {
						text = "[HoldingView.GetViewedDistrictType.CalcTriggeredNameNoTooltip( HoldingView.GetProvince )]"
					}
					blockoverride "button_back" {
						visible = "[And4( HoldingView.GetTrack.HasNextBuilding, HoldingView.IsSelectingConstruction, EqualTo_int32( HoldingView.GetTrack.GetNextBuilding.GetLevel, '(int32)1' ), Not( HoldingView.GetTrack.IsConstructing ) )]"
						onclick = "[HoldingView.GetTrack.GoBack]"
						tooltip = "BACK_TOOLTIP"
					}
					blockoverride "button_close" {
						onclick = "[HoldingView.CloseTracksView]"
						shortcut = "close_window"
					}
				}

				# Building Grid
				hbox = {
					visible = "[Not( HoldingView.IsViewingNewDistrict )]"
					layoutpolicy_vertical = expanding
					layoutpolicy_horizontal = expanding
					margin = { 16 4 }

					hbox = {
						layoutpolicy_vertical = expanding
						spacing = 4

						# Primary Building
						vbox = {
							layoutpolicy_vertical = expanding

							hbox = {
								datamodel = "[HoldingView.GetBuildingItems]"

								item = {
									vbox = {
										visible = "[GUIBuildingItem.HasBuilding]"

										vbox = {
											ignoreinvisible = yes
											visible = "[GUIBuildingItem.IsPrimaryBuilding]"

											widget_building_item_needs = {
												layoutpolicy_horizontal = expanding
											}

											widget_building_item = {
												size = { 77 77 }
												blockoverride "building_icon" {
													icon_building = {
														parentanchor = center
														size = { 68 68 }
														texture = "[GUIBuildingItem.GetCurrentOrConstrucingBuilding.GetTypeIcon]"
													}
												}
											}


										}
									}
								}
							}
							expand = {  }
						}

						# Buildings Grid
						vbox = {
							layoutpolicy_vertical = expanding
							margin_top = 16

							flowcontainer = {
								name = "buildings_grid"
								datamodel = "[HoldingView.GetNonPrimaryBuildingItems]"
								ignoreinvisible = yes
								wrap_count = 7
								spacing = 4

								item = {
									flowcontainer = {
										direction = vertical
										ignoreinvisible = yes


										widget_building_item_needs = {
											size = { 100% 40 }
										}

										widget_building_item_draggable_slot = {  }
									}
								}
							}
						}
						expand = {  }
					}

					# slots, widget to control y position better
					widget = {
						size = { 68 0 }
						layoutpolicy_vertical = expanding

						text_label_left = {
							parentanchor = vcenter|left
							position = { 4 30 }
							raw_text = "[HoldingView.CalcNumOccupiedBuildSlots|V]/[HoldingView.EstimateTotalNumAvailableBuildSlots]"
							tooltip = "[HoldingView.GetBuildSlotBreakdown]"
						}
					}
					expand = {}

					# replace button, in widget to control y position
					widget = {
						size = { 40 0 }
						layoutpolicy_vertical = expanding

						button_round = {
							name = "replace_district"
							parentanchor = bottom


							tooltip = "REPLACE_DISTRICT_TOOLTIP"
							onclick = "[HoldingView.OnReplaceDistrict]"
							visible = "[And( HoldingView.CanReplaceDistrict, Not(And( HoldingView.GetTrack.IsCurrentBuildingSelected, HoldingView.GetTrack.CanReplace )))]"

							button_icon = {
								alwaystransparent = yes
								parentanchor = center
								size = { 30 30 }
								texture = "gfx/interface/icons/flat_icons/replace.dds"
							}
						}

						button_round = {
							name = "replace_building"
							parentanchor = bottom

							onclick = "[HoldingView.GetTrack.Replace]"
							tooltip = "[HoldingView.GetTrack.GetReplaceTooltip]"
							visible = "[And( HoldingView.GetTrack.IsCurrentBuildingSelected, HoldingView.GetTrack.CanReplace )]"

							button_change = {
								alwaystransparent = yes
								parentanchor = center
							}
						}
					}
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				visible = "[And( Not( Or3( HoldingView.IsSelectingNewBuilding, HoldingView.IsReplacingBuilding, HoldingView.IsViewingNewDistrict ) ), District.IsOwnedByTitle )]"
				datacontext = "[District.GetOwningTitle]"
				margin = { 8 8 }

				background = {
					using = Background_Area
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 8
					coa_title_tiny_crown = {  }

					vbox = {
						layoutpolicy_horizontal = expanding

						hbox = {
							layoutpolicy_horizontal = expanding

							text_multi = {
								align = nobaseline
								autoresize = yes
								max_width = 400
								text = "DISTRICT_OWNED_BY_TITLE"
							}
							expand = {  }
						}

						hbox = {
							visible = no
							layoutpolicy_horizontal = expanding
							spacing = 8

							button_standard = {
								layoutpolicy_horizontal = expanding
							}

							button_standard = {
								layoutpolicy_horizontal = expanding
							}
						}
					}

					# Trade post interactions
					hbox = {
						margin = { 0 6 }

						# Dismantle (only for owner)
						button_round = {
							visible = "[Title.GetHolder.IsLocalPlayer]"
							enabled = "[Title.GetHolder.IsPlayerInteractionWithTargetDistrictValid( 'dismantle_trade_post_interaction', HoldingView.GetDistrict )]"
							tooltip = "[Title.GetHolder.GetPlayerInteractionWithTargetDistrictTooltip( 'dismantle_trade_post_interaction', HoldingView.GetDistrict )]"
							onclick = "[Title.GetHolder.OpenPlayerInteractionWithTargetDistrict( 'dismantle_trade_post_interaction', HoldingView.GetDistrict )]"

							button_icon_highlight = {
								alwaystransparent = yes
								parentanchor = center
								size = { 26 26 }
								texture = "gfx/interface/icons/flat_icons/revoke_trade_post.dds"
							}
						}
						# Oust
						button_round = {
							visible = "[Title.GetHolder.IsPlayerInteractionShown( 'oust_trade_post_interaction' )]"
							enabled = "[Title.GetHolder.IsPlayerInteractionWithTargetDistrictValid( 'oust_trade_post_interaction', HoldingView.GetDistrict )]"
							tooltip = "[Title.GetHolder.GetPlayerInteractionWithTargetDistrictTooltip( 'oust_trade_post_interaction', HoldingView.GetDistrict )]"
							onclick = "[Title.GetHolder.OpenPlayerInteractionWithTargetDistrict( 'oust_trade_post_interaction', HoldingView.GetDistrict )]"

							button_icon_highlight = {
								alwaystransparent = yes
								parentanchor = center
								size = { 26 26 }
								texture = "gfx/interface/icons/flat_icons/oust_from_trade_post.dds"
							}
						}
						# Revoke
						button_round = {
							visible = "[Title.GetHolder.IsPlayerInteractionShown( 'revoke_trade_post_interaction' )]"
							enabled = "[Title.GetHolder.IsPlayerInteractionWithTargetDistrictValid( 'revoke_trade_post_interaction', HoldingView.GetDistrict )]"
							tooltip = "[Title.GetHolder.GetPlayerInteractionWithTargetDistrictTooltip( 'revoke_trade_post_interaction', HoldingView.GetDistrict )]"
							onclick = "[Title.GetHolder.OpenPlayerInteractionWithTargetDistrict( 'revoke_trade_post_interaction', HoldingView.GetDistrict )]"

							button_icon_highlight = {
								alwaystransparent = yes
								parentanchor = center
								size = { 26 26 }
								texture = "gfx/interface/icons/flat_icons/revoke_trade_post.dds"
							}
						}
						# Steal
						button_round = {
							visible = "[Title.GetHolder.IsPlayerInteractionShown( 'start_steal_trade_post_interaction' )]"
							enabled = "[Title.GetHolder.IsPlayerInteractionWithTargetDistrictValid( 'start_steal_trade_post_interaction', HoldingView.GetDistrict )]"
							tooltip = "[Title.GetHolder.GetPlayerInteractionWithTargetDistrictTooltip( 'start_steal_trade_post_interaction', HoldingView.GetDistrict )]"
							onclick = "[Title.GetHolder.OpenPlayerInteractionWithTargetDistrict( 'start_steal_trade_post_interaction', HoldingView.GetDistrict )]"

							button_icon_highlight = {
								alwaystransparent = yes
								parentanchor = center
								size = { 26 26 }
								texture = "gfx/interface/icons/flat_icons/steal_trade_post.dds"
							}
						}
						# Request
						button_round = {
							visible = "[And( District.GetHolding.GetProvince.GetCounty.GetTitle.GetHolder.IsPlayerInteractionShown( 'request_trade_post_interaction' ), Not( Title.GetHolder.IsLocalPlayer ) )]"
							enabled = "[District.GetHolding.GetProvince.GetCounty.GetTitle.GetHolder.IsPlayerInteractionWithTargetTitleValid( 'request_trade_post_interaction', District.GetHolding.GetProvince.GetTitle )]"
							tooltip = "[District.GetHolding.GetProvince.GetCounty.GetTitle.GetHolder.GetPlayerInteractionWithTargetTitleTooltip( 'request_trade_post_interaction', District.GetHolding.GetProvince.GetTitle )]"
							onclick = "[District.GetHolding.GetProvince.GetCounty.GetTitle.GetHolder.OpenPlayerInteractionWithTargetTitle( 'request_trade_post_interaction', District.GetHolding.GetProvince.GetTitle )]"

							button_icon_highlight = {
								alwaystransparent = yes
								parentanchor = center
								size = { 26 26 }
								texture = "gfx/interface/icons/flat_icons/request_trade_post.dds"
							}
						}
						# Expel
						button_round = {
							visible = "[District.GetHolding.GetProvince.GetCounty.GetTitle.GetHolder.IsPlayerInteractionShown( 'expel_rival_leagues_interaction' )]"
							enabled = "[District.GetHolding.GetProvince.GetCounty.GetTitle.GetHolder.IsPlayerInteractionWithTargetTitleValid( 'expel_rival_leagues_interaction', District.GetHolding.GetProvince.GetCounty.GetTitle )]"
							tooltip = "[District.GetHolding.GetProvince.GetCounty.GetTitle.GetHolder.GetPlayerInteractionWithTargetTitleTooltip( 'expel_rival_leagues_interaction', District.GetHolding.GetProvince.GetCounty.GetTitle )]"
							onclick = "[District.GetHolding.GetProvince.GetCounty.GetTitle.GetHolder.OpenPlayerInteractionWithTargetTitle( 'expel_rival_leagues_interaction', District.GetHolding.GetProvince.GetCounty.GetTitle )]"

							button_icon_highlight = {
								alwaystransparent = yes
								parentanchor = center
								size = { 26 26 }
								texture = "gfx/interface/icons/flat_icons/revoke_trade_post.dds"
							}
						}
					}
				}
			}

			# New District
			vbox_construct_new_district = {
				visible = "[And( HoldingView.IsBuildingTracksViewShown, Or( HoldingView.IsSelectingNewDistrict, HoldingView.IsReplacingDistrict ) )]"
			}



			# New Building
			vbox_construct_new_building = {
				visible = "[And( HoldingView.IsBuildingTracksViewShown, Or( HoldingView.IsSelectingNewBuilding, HoldingView.IsReplacingBuilding ) )]"
			}

			# Building Selection & Upgrade
			vbox = {
				visible = "[And( HoldingView.IsBuildingTracksViewShown, HoldingView.IsSelectingConstruction )]"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				vbox = {
					visible = "[And( HoldingView.IsBuildingTracksViewShown, HoldingView.IsSelectingConstruction )]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					alwaystransparent = no
					margin_bottom = -14

					vbox = {
						layoutpolicy_horizontal = expanding
						datacontext = "[HoldingView.GetTrack]"
						margin_left = 18

						text_label_left = {
							layoutpolicy_horizontal = expanding
							text = "[GUITrackItem.GetSelectedBuilding.CalcTriggeredNameNoTooltip(HoldingView.GetProvince)]"
							default_format = "#high"
							using = Font_Size_Medium
							autoresize = no
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							hbox_building_level_track_standard = {}
							expand = {}
						}


					}

					## Upgrade Building
					vbox = {
						name = "upgrade"
						datacontext = "[HoldingView.GetTrack]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						scrollbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							blockoverride "scrollbox_content" {
								vbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding

									vbox = {
										visible = "[GUITrackItem.IsConstructing]"
										layoutpolicy_horizontal = expanding
										margin_bottom = 14
										building_in_vassal_warning_hbox = {  }

										text_single = {
											text = "HOLDING_VIEW_IN_PROGRESS"
											margin = { 0 2 }
										}

										spacer = {
											size = { 0 6 }
										}

										hbox = {
											spacing = 20

											progressbar_standard = {
												name = "construct_progressbar"
												layoutpolicy_horizontal = expanding
												layoutstretchfactor_horizontal = 1
												size = { 300 25 }
												alwaystransparent = yes
												value = "[GUITrackItem.GetConstructionProgress]"

												text_single = {
													parentanchor = center
													text = "[GUITrackItem.GetConstructTimeLeft]"
													default_format = "#high"
													align = nobaseline
												}
											}

											widget = {
												size = { 20 20 }
												allow_outside = yes

												button_round = {
													name = "abort_button"
													parentanchor = center
													visible = "[GUITrackItem.CanShowCancel]"
													enabled = "[GUITrackItem.CanCancel]"
													onclick = "[GUITrackItem.Cancel]"
													tooltip = "[GUITrackItem.GetCancelTooltip]"

													button_cancel = {
														parentanchor = center
														alwaystransparent = yes
													}
												}
											}
										}
									}

									# TODO TIT-74550 - Remove if we decide to use new upgrade track
									#hbox_building_level_track = {}
									# Building Information



									vbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding

										vbox = {
											name = "flavor_and_effect"
											layoutpolicy_horizontal = expanding

											vbox = {
												layoutpolicy_horizontal = expanding
												margin = { 0 6 }
												spacing = 16
												vbox_building_effect_and_needs = {
													blockoverride "effect_description" {
														text_multi = {
															min_width = 500
															max_width = 500
															autoresize = yes
															text = "[GUITrackItem.GetSelectedBuilding.GetEffectDescriptionAtProvinceWithoutNeeds( Character.Self, HoldingView.GetProvince )]"
														}
													}
													blockoverride "needs_list" {
														vbox = {
															name = "building_needs_list_tutorial_uses_this"
															layoutpolicy_horizontal = expanding
															datamodel = "[GUITrackItem.GetSelectedBuildingNeeds]"
															spacing = 4

															item = {
																vbox = {
																	building_need_segment = {
																		visible = "[GUITrackItem.IsCurrentBuildingSelected]"
																	}

																	building_need_segment_preview = {
																		visible = "[Not(GUITrackItem.IsCurrentBuildingSelected)]"
																	}
																}
															}
														}
													}
												}

												text_building_flavor = {
													datacontext = "[GUITrackItem.GetSelectedBuilding]"
													max_width = 480
												}
											}

											vbox = {
												layoutpolicy_horizontal = expanding

												text_single = {
													datacontext = "[GUITrackItem.GetSelectedBuilding]"
													visible = "[InDebugMode]"
													layoutpolicy_horizontal = expanding
													text = "BUILDING_DEBUG_FULL"
													margin = { 5 5 }
												}

												hbox = {
													visible = "[And( And( GreaterThan_int32( GUITrackItem.GetSelectedBuilding.GetLevel, GUITrackItem.GetCurrentBuilding.GetLevel ), GreaterThan_int32( GUITrackItem.GetSelectedBuilding.GetLevel, '(int32)1' )), Not( GUITrackItem.IsNextBuildingSelected ))]"
													layoutpolicy_horizontal = expanding
													margin_left = 5

													text_label_left = {
														layoutpolicy_horizontal = expanding
														text = "UPGRADE_HOLDING"
													}

													hbox = {
														layoutpolicy_horizontal = expanding
														spacing = 10
														margin = { 10 10 }

														hbox = {
															spacing = 10

															text_single = {
																datacontext = "[GUITrackItem.GetSelectedCost( GetPlayer.Self )]"
																visible = "[GUITrackItem.HasSelectedCost]"
																text = "[ValueBreakdown.GetValue]"
																align = nobaseline
																tooltip_visible = "[ValueBreakdown.HasTooltip]"

																tooltipwidget = {
																	widget_value_breakdown_tooltip = {  }
																}

																background = {
																	visible = "[Not( GUITrackItem.CanAffordSelectedCost( GetPlayer.Self ) )]"
																	using = Status_Bad
																}
															}

															text_single = {
																datacontext = "[GUITrackItem.GetSelectedPrestigeCost]"
																visible = "[GUITrackItem.HasSelectedPrestigeCost]"
																text = "[ValueBreakdown.GetValue]"
																align = nobaseline
																tooltip_visible = "[ValueBreakdown.HasTooltip]"

																tooltipwidget = {
																	widget_value_breakdown_tooltip = {  }
																}
															}

															text_single = {
																datacontext = "[GUITrackItem.GetSelectedPietyCost]"
																visible = "[GUITrackItem.HasSelectedPietyCost]"
																text = "[ValueBreakdown.GetValue]"
																align = nobaseline
																tooltip_visible = "[ValueBreakdown.HasTooltip]"

																tooltipwidget = {
																	widget_value_breakdown_tooltip = {  }
																}
															}

															text_single = {
																datacontext = "[GUITrackItem.GetSelectedConstructionTime]"
																text = "[ValueBreakdown.GetValue]"
																align = nobaseline
																tooltip_visible = "[ValueBreakdown.HasTooltip]"

																tooltipwidget = {
																	widget_value_breakdown_tooltip = {  }
																}
															}
														}

														warning_icon = {
															name = "cant_construct"
															size = { 30 30 }
															tooltip = "[GUITrackItem.GetSelectedBuildingBlockReasons]"
															visible = "[Not(GUITrackItem.CanConstructSelectedBuilding)]"
														}
														expand = {  }
													}
												}
											}
											expand = {  }
										}
										expand = {}
									}
									# Constructing Building
								}
							}
							blockoverride "scrollbox_margins" {
								margin = { 10 4 }
							}
						}
						# Footer Buttons
						hbox_track_item_action_row = {  }
					}
				}
			}
		}
		block "county_sub_visible" {}
	}
}

template Special_Building_Texture {
	texture = "gfx/interface/buttons/button_special_building.dds"
	spriteType = Corneredtiled
	spriteborder = { 18 18 }
	framesize = { 252 80 }
}

template Small_Grey_Progress {
	texture = "gfx/interface/progressbars/progress_frozen.dds"
	margin = { 0 -3 }
	alpha = 0.5
}

template Background_Banner_Right {
	mirror = horizontal
	texture_density = 3
	texture = "gfx/interface/window_military/military_banner_gray.dds"
}

template Main_Construction_Button {
	onclick = "[GUITrackItem.OnClick]"
	#onclick = "[HoldingView.CloseTracksView]"
	tooltip = "HOLDING_VIEW_CONSTRUCT_NEXT_BUILDING_TOOLTIP"
	enabled = "[GUITrackItem.CanQueueNextBuilding]"
}

# POD CfV: Hide mod compatibility warning
types PODCompatibilityTypes {
	type pod_warning_county = widget { visible = no }
}
# CfV end
