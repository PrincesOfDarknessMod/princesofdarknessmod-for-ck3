				default_format = "#T"
			}
			blockoverride "concept_link" {
				visible = no
			}
			blockoverride "main_description" {
				vbox = {
					layoutpolicy_horizontal = expanding
					datacontext = "[County.GetCount]"
					datacontext = "[Character.GetGovernment]"
