					cooltip_paragraph = {
						visible = "[Not( GovernmentType.IsAffectedByProsperity )]"
						text = "COUNTY_PROSPERITY_IGNORED_DESC"
					}

					cooltip_paragraph = {
						text = "COUNTY_PROSPERITY_TOOLTIP_VALUE"
					}

					hbox = {
						layoutpolicy_horizontal = expanding

						progressbar_standard = {
							size = { 250 25 }
							value = "[County.GetProsperityLevel]"
							max = "100"
						}
						expand = {  }
					}
					spacer = {  }

					cooltip_paragraph = {
						text = "[County.GetProsperityProgressOutOfMax]"
					}

					hbox = {
						layoutpolicy_horizontal = expanding

						progressbar_standard = {
							size = { 250 15 }
							value = "[County.GetProsperityProgress]"
							max = "[County.GetProsperityProgressMax]"
						}
						expand = {  }
					}

					spacer = {
						size = { 0 5 }
					}

					cooltip_paragraph = {
						datacontext = "[CountyDataBreakdowns.AccessProsperityChange( County.Self )]"
						text = "VALUE_BREAKDOWN_TEXT_LINK"
						tooltip_visible = "[ValueBreakdown.HasTooltip]"

						tooltipwidget = {
							widget_value_breakdown_tooltip = {  }
						}
					}

					vbox_value_breakdown_list = {
						datacontext = "[CountyDataBreakdowns.AccessProsperityChange( County.Self )]"
						visible = "[ValueBreakdown.HasTooltip]"
					}

					spacer = {
						size = { 0 5 }
					}

					cooltip_paragraph = {
						text = "[County.GetCountyProsperityEffectsDesc]"
					}
				}
			}
			blockoverride "header_additions" {
				widget = {
					size = { 42 42 }

					icon = {
						size = { 42 42 }
						parentanchor = center
						position = { -8 0 }
						texture = "gfx/interface/icons/prosperity.dds"
					}
				}
			}
		}
	}

	type county_production_tooltip = container
	{
		using = GeneralTooltipSetup
		alwaystransparent = no

		datacontext = "[HoldingView.GetProvince.GetCounty]"
		datacontext = "[HoldingView.GetProvince.GetTradeMarket]"

		object_tooltip_pop_out = {
			blockoverride "title_text"
			{
				margin = { 0 8 }
				text = "COUNTY_PRODUCTION_TOOLTIP_HEADER"
				default_format = "#T"
			}

			blockoverride "subtitle_text"
			{
				text = "[TradeMarket.GetNameNoTooltip]"
				default_format = "#weak"
			}

			blockoverride "concept_link"
			{
				visible = no
			}

			blockoverride "header_additions"
			{
				widget = {
					size = { 42 42 }

					icon = {
						size = { 42 42 }
						parentanchor = center
						position = { -8 0 }
						texture = "[GUIProductionItem.GetTradeGoodType.GetIcon]"
					}
				}
			}

			blockoverride "main_description"
			{
				spacing = 8
				vbox = {
					layoutpolicy_horizontal = expanding
					datamodel = "[HoldingView.GetProductionItems]"
					spacing = 4

					item = {
						production_row = {
							margin = { 4 4 }

							background = {
								using = Background_Area_Characterlist
							}

							blockoverride "production_row_market_info" {
								text_single = {
									visible = "[TradeMarket.HasTradeBalanceForGood( TradeGoodType.Self )]"
									text = "COUNTY_PRODUCTION_MARKET_BALANCE"
									align = nobaseline

									tooltip_visible = "[GUIProductionItem.HasMarketBalance]"
									tooltipwidget = { widget_trade_good_balance_breakdown_tooltip = {} }
								}

								text_single = {
									visible = "[And( TradeMarket.HasTradeBalanceForGood( TradeGoodType.Self ), TradeMarket.PlayerHasExploitativeAccessToGood( TradeGoodType.Self ) )]"
									text = "COUNTY_PRODUCTION_EXPLOITATIVE_ACCESS"
									align = nobaseline
									tooltip = "COUNTY_PRODUCTION_EXPLOITATIVE_ACCESS_TT"
								}
							}
						}
					}
				}

				vbox = {
					name = "potential_trade_goods"
					visible = "[Not( IsDataModelEmpty( County.GetPotentialTradeGoodTypes ) )]"
					layoutpolicy_horizontal = expanding
					spacing = 8
					margin = { 8 8 }

					background = {
						using = Background_Area_Light
					}

					cooltip_paragraph = {
						text = "COUNTY_POTENTIAL_TRADE_GOODS_HEADER"
						default_format = "#low"
						layoutpolicy_horizontal = expanding
						max_width = 9999 #no max width needed, we are matching vbox above anyway
					}

					hbox = {
						layoutpolicy_horizontal = expanding
						hbox = {
							datamodel = "[County.GetPotentialTradeGoodTypes]"
							spacing = 4
							item = {
								icon = {
									size = { 35 35 }
									texture = "[TradeGoodType.GetSmallIcon]"
									tooltipwidget = trade_good_type_tooltip
									using = tooltip_se
								}
							}
						}
						expand = {}
					}


				}
			}
		}
	}

	# Requires HoldingView data context, unless "market_needs_context" is overridden.
	# Row blocks default to TradeMarket.GetRealmNeeds.
	type county_market_needs_tooltip = container {
		alwaystransparent = no

		using = DefaultTooltipBackground
		using = GeneralTooltipSetup

		block "market_needs_context" {
			datacontext = "[HoldingView.GetProvince.GetCountyCapitalProvince.GetTradeMarket]"
		}

		object_tooltip_pop_out = {
			blockoverride "title_text"
			{
				margin = { 0 8 }
				default_format = "#T"

				block "needs_tooltip_title" {
					text = "COUNTY_MARKET_NEEDS_TOOLTIP_HEADER"
				}
			}

			blockoverride "subtitle_text"
			{
				block "needs_tooltip_subtitle" {
					text = ""
				}
			}

			blockoverride "concept_link"
			{
				visible = no
			}

			blockoverride "header_additions"
			{
				block "needs_tooltip_header" {
					widget = {
						visible = "[Not( IsDataModelEmpty( TradeMarket.GetRealmNeeds ) )]"
						size = { 42 42 }
						datacontext = "[TradeMarket.GetTopRealmNeed]"

						icon = {
							visible = "[Not( TradeMarketRealmNeed.IsCategory )]"
							datacontext = "[TradeMarketRealmNeed.GetTradeGoodType]"
							size = { 42 42 }
							parentanchor = center
							position = { -8 0 }
							texture = "[TradeGoodType.GetIcon]"
						}

						icon = {
							visible = "[TradeMarketRealmNeed.IsCategory]"
							datacontext = "[TradeMarketRealmNeed.GetCategory]"
							size = { 42 42 }
							parentanchor = center
							position = { -8 0 }
							texture = "[TradeGoodCategory.GetIcon]"
						}
					}
				}
			}

			blockoverride "main_description"
			{

				vbox = {
					set_parent_size_to_minimum = yes
					layoutpolicy_horizontal = expanding
					margin = { 0 8 }
					spacing = 4

					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 3

						block "needs_list" {
							datamodel = "[TradeMarket.GetRealmNeeds]"
						}

						item = {
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 4
								margin = { 8 4 }

								block "need_row_context" {}

								block "need_row_tooltip" {
									tooltipwidget = { widget_market_need_holdings_tooltip = {} }
								}

								background = {
									using = Background_Area_Characterlist
								}

								icon = {
									block "need_good_icon" {
										visible = "[Not( TradeMarketRealmNeed.IsCategory )]"
										datacontext = "[TradeMarketRealmNeed.GetTradeGoodType]"
									}
									size = { 25 25 }
									texture = "[TradeGoodType.GetSmallIcon]"
								}

								icon = {
									block "need_category_icon" {
										visible = "[TradeMarketRealmNeed.IsCategory]"
										datacontext = "[TradeMarketRealmNeed.GetCategory]"
									}
									size = { 25 25 }
									texture = "[TradeGoodCategory.GetSmallIcon]"
								}

								text_single = {
									block "need_good_name" {
										visible = "[Not( TradeMarketRealmNeed.IsCategory )]"
										datacontext = "[TradeMarketRealmNeed.GetTradeGoodType]"
									}
									text = "[TradeGoodType.GetNameNoTooltip]"
									default_format = "#high"
									align = nobaseline
								}

								text_single = {
									block "need_category_name" {
										visible = "[TradeMarketRealmNeed.IsCategory]"
										datacontext = "[TradeMarketRealmNeed.GetCategory]"
									}
									text = "[TradeGoodCategory.GetNameNoTooltip]"
									default_format = "#high"
									align = nobaseline
								}

								block "need_exploited_marker" {
									text_single = {
										visible = "[TradeMarketRealmNeed.IsExploited]"
										datacontext = "[TradeMarketRealmNeed.GetExploitingMonopoly]"
										text = "MARKET_NEED_EXPLOITED_MARKER"
										align = nobaseline
										tooltip = "MARKET_NEED_EXPLOITED_LINE"
									}
								}

								expand = {
									minimumsize = { 20 0 }
								}

								text_single = {
									block "need_amount" {
										text = "[TradeMarketRealmNeed.GetTotalUnmet|1^]"
									}
									align = nobaseline
									default_format = "#trade_need"
								}
							}
						}
					}

					block "needs_hidden" {
						hbox = {
							visible = "[GreaterThan_int32( TradeMarket.GetHiddenRealmNeedCount, '(int32)0' )]"
							layoutpolicy_horizontal = expanding
							margin = { 6 3 }
							margin_top = 5

							tooltipwidget = { widget_market_needs_hidden_tooltip = {} }

							text_single = {
								layoutpolicy_horizontal = expanding
								text = "COUNTY_MARKET_NEEDS_HIDDEN"
								align = nobaseline
								default_format = "#weak"
							}
						}
					}
				}
			}
		}
	}

