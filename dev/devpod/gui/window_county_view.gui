	type building_need_segment = vbox {
		alpha = "[Select_float( GUIBuildingNeedItem.IsDimmed, '(float)0.5', '(float)1.0' )]"
		margin_top = 4

		background = {
			using = Background_Area
		}

		hbox = {
			vbox = {
				margin = { 4 4 }



				widget = {
					name = "category_or_good_icon"
					size = { 90 65 }  # width = 5 times checkbox size

					block "building_need_icon_tooltip" {
						tooltipwidget = {
							building_need_tooltip = {  }
						}
					}

					# Specific trade good
					building_need_type_icon = {
						parentanchor = top|hcenter
					}

					# Trade good category
					building_need_type_icon = {
						parentanchor = top|hcenter
						blockoverride "visible" {
							visible = "[GUIBuildingNeedItem.IsCategoryNeed]"
						}
						blockoverride "datacontext" {
							datacontext = "[GUIBuildingNeedItem.GetTradeGoodCategory]"
						}
						blockoverride "icon" {
							texture = "[TradeGoodCategory.GetIcon]"
						}
					}
				}

				# wrap in container to ensure min_width but also that checkboxes are centered
				container = {
					min_width = 90  # width = 5 times checkbox size

					fixedgridbox = {
						name = "checkboxes"
						visible = "[GUIBuildingNeedItem.IsRepeating]"
						datamodel = "[GUIBuildingNeedItem.GetChecklist]"
						parentanchor = hcenter

						addcolumn = 18
						addrow = 18
						datamodel_wrap = 5
						maxhorizontalslots = 5
						flipdirection = yes
						using = tooltip_se

						item = {
							widget = {
								size = { 18 18 }

								background = {
									using = Background_Frame
								}

								background = {
									using = Background_Frame
									color = { 1 0.4 0.4 0.3 }
									block "building_need_unfilled" {
										visible = "[BuildingNeedChecklistSlot.IsUnfilled]"
									}
								}

								icon = {
									parentanchor = center
									size = { 18 18 }
									texture = "gfx/interface/icons/symbols/icon_check.dds"
									block "building_need_filled" {
										visible = "[BuildingNeedChecklistSlot.IsFilled]"
									}
								}
							}
						}
						block "needs_boxes_tooltip" {
							# none by default, only preview uses it
						}
					}
				}


			}
			building_need_section_line = {  }

			vbox = {
				layoutpolicy_vertical = expanding
				spacing = 4
				margin_left = 4

				text_single = {
					visible = "[GUIBuildingNeedItem.IsRepeating]"
					text = "BUILDING_NEED_REPEATING_PER_LEVEL"
					default_format = "#low"
					layoutpolicy_horizontal = expanding
					autoresize = no
					align = nobaseline

					background = {
						using = Background_Area
					}
				}

				text_multi = {
					autoresize = yes
					block "building_need_segment_effect_description_width" {
						min_width = 370
						max_width = 370
					}
					text = "[GUIBuildingNeedItem.GetPerLevelModifierDescription( Character.Self )]"
				}

				expand = {  }
			}
		}

		text_single = {
			visible = "[GUIBuildingNeedItem.HasSourceDescription]"
			autoresize = no
			layoutpolicy_horizontal = expanding
			align = nobaseline
			text = "BUILDING_NEED_SOURCE_LINE"
			default_format = "#weak"
			margin = { 8 8 }

			background = {
				using = Background_Area
			}
		}
	}

