	# Requires a GUIDistrictItem data context.
	type district_item_tooltip = object_tooltip_pop_out {
		blockoverride "title_text" {
			text = "DISTRICT_TT_TITLE"
			align = nobaseline
		}
		blockoverride "concept_link" {
			text = "[GUIDistrictItem.GetDistrictTypeText]"
			align = nobaseline
		}
		blockoverride "main_description" {
			spacing = 8
			margin_bottom = 24

			# TEMPORARY STATUSES
			cooltip_paragraph = {
				visible = "[GUIDistrictItem.IsConstructing]"
				text = "DISTRICT_TT_CONSTRUCTING"
			}

			cooltip_paragraph = {
				visible = "[GUIDistrictItem.IsInQueue]"
				text = "DISTRICT_TT_QUEUED"
			}

			cooltip_paragraph = {
				visible = "[GUIDistrictItem.IsRebuilding]"
				text = "DISTRICT_TT_REBUILDING"
			}

			cooltip_paragraph = {
				visible = "[And( GUIDistrictItem.IsDistrictRuined, Not( GUIDistrictItem.IsRebuilding ) )]"
				text = "[GUIDistrictItem.GetDistrictRuinedDesc]"
			}

			cooltip_paragraph = {
				visible = "[And( GUIDistrictItem.IsDistrictInactive, Not( GUIDistrictItem.IsDistrictRuined ) )]"
				text = "DISTRICT_INACTIVE_DESC"
			}

			cooltip_paragraph = {
				visible = "[GUIDistrictItem.IsDistrictDisabled]"
				text = "[GUIDistrictItem.GetDistrictDisabledDesc]"
			}

			cooltip_paragraph = {
				visible = "[And( GUIDistrictItem.IsEmptySlot, Not( GUIDistrictItem.IsDistrictButtonEnabled ) )]"
				text = "[GUIDistrictItem.GetCannotHaveDistrictReason]"
			}

			cooltip_paragraph = {
				visible = "[And4( GUIDistrictItem.IsEmptySlot, GUIDistrictItem.IsDistrictButtonEnabled, Not( GUIDistrictItem.CanConstructDistrict ), Not( GUIDistrictItem.IsAnotherDistrictConstructing ) )]"
				text = "CONSTRUCT_DISTRICT_INVALID_SLOT"
			}

			cooltip_paragraph = {
				visible = "[GUIDistrictItem.IsEmptySlot]"
				text = "DISTRICT_TT_EMPTY_EXPLANATION"
				default_format = "#weak"
			}

			# END OF TEMPORARY STATUSES
			cooltip_paragraph = {
				visible = "[GUIDistrictItem.HasImmediatelyUpgradableBuilding]"
				text = "HOLDING_DISTRICT_CAN_UPGRADE_BUILDING_NOW"
			}

			cooltip_paragraph = {
				visible = "[GUIDistrictItem.HasImmediatelyConstructableBuilding]"
				text = "HOLDING_DISTRICT_CAN_CONSTRUCT_BUILDING_NOW"
			}

			vbox = {
				name = "needs"
				visible = "[Not( IsDataModelEmpty( GUIDistrictItem.GetDistrictNeeds ) )]"
				layoutpolicy_horizontal = expanding
				spacing = 4

				cooltip_paragraph = {
					text = "DISTRICT_NEEDS_TOOLTIP_HEADER"
					default_format = "#low"
				}

				# One icon per need of every building in the district, same icons as on the building card.
				flowcontainer = {
					layoutpolicy_horizontal = expanding
					ignoreinvisible = yes
					wrap_count = 8
					spacing = 4
					datamodel = "[GUIDistrictItem.GetDistrictNeeds]"

					item = {
						building_need_icon = {  }
					}
				}
			}

			vbox = {
				name = "production"
				visible = "[Not( IsDataModelEmpty( GUIDistrictItem.GetDistrictProduction ) )]"
				layoutpolicy_horizontal = expanding
				spacing = 4

				cooltip_paragraph = {
					text = "DISTRICT_PRODUCTION_TOOLTIP_HEADER"
					default_format = "#low"
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					datamodel = "[GUIDistrictItem.GetDistrictProduction]"
					spacing = 4

					item = {
						production_row = {  }
					}
				}
			}

			hbox = {
				visible = "[GUIDistrictItem.HasOwningTitle]"
				datacontext = "[GUIDistrictItem.GetDistrict.GetOwningTitle]"
				layoutpolicy_horizontal = expanding
				spacing = 4
				coa_title_tiny_crown = {  }

				text_single = {
					text = "DISTRICT_OWNED_BY_TITLE"
					using = DefaultTooltipText
					fonttintcolor = "[TooltipInfo.GetTintColor]"
					alwaystransparent = no
					align = nobaseline
					autoresize = no
					layoutpolicy_horizontal = expanding
				}
			}

			vbox_district_type_info = {
				visible = "[Not(GUIDistrictItem.IsEmptySlot)]"
				datacontext = "[GUIDistrictItem.GetCurrentOrConstrucingDistrict]"
			}

			# Debug
			cooltip_paragraph = {
				visible = "[And( InDebugMode, Not( GUIDistrictItem.IsEmptySlot ) )]"
				datacontext = "[GUIDistrictItem.GetCurrentOrConstrucingDistrict]"
				text = "DISTRICT_DEBUG_KEY"
			}
		}
		blockoverride "header_additions" {
			hbox = {
				visible = "[Not( GUIDistrictItem.IsEmptySlot )]"
				margin_right = 10
				margin_left = -4

				icon_building = {
					texture = "[GUIDistrictItem.GetCurrentOrConstrucingDistrict.GetPrimaryBuildingType.GetTypeIcon]"
					size = { 56 56 }
				}
			}
		}
		blockoverride "tooltip_text_shortcut" {
			visible = no
		}
		blockoverride "call_to_action" {
			cooltip_paragraph = {
				visible = "[And( GUIDistrictItem.IsBuildNewIconShown, GUIDistrictItem.IsDistrictButtonEnabled )]"
				text = "DISTRICT_TT_CLICK_TO_CONSTRUCT"
				default_format = "#I"
			}

			cooltip_paragraph = {
				visible = "[GUIDistrictItem.HasDistrict]"
				text = "DISTRICT_TT_CLICK_TO_SELECT"
				default_format = "#I"
			}

			cooltip_paragraph = {
				visible = "[And3( GUIDistrictItem.HasDistrict, GUIDistrictItem.IsRegularDistrict, HoldingView.CanDrag )]"
				text = "DISTRICT_TT_CLICK_AND_DRAG_PRIORITY"
				default_format = "#I"
			}
		}
	}

