######################################################
################### COUNTY VIEW ######################
######################################################

window = {
	name = "holding_view"
	widgetid = "holding_view"
	parentanchor = bottom|left
	allow_outside = yes
	movable = no
	layer = windows_layer
	size = { 688 900 }
	alwaystransparent = yes

	state = {
		name = _show
		on_start = "[GetVariableSystem.Set( 'county_view_open', 'true' )]"
		on_start = "[GetVariableSystem.Set( 'hide_bottom_left_HUD', 'true' )]"
		using = Animation_FadeIn_Standard
		using = Sound_WindowShow_Standard
		position_x = 0
		# CfV PoD: remove incompatible buildings on AI holdings
		# TODO GDP: test if this is still necessary (probably not)
		# on_start = "[GetScriptedGui('incompatible_building_clean_gui').Execute(GuiScope.SetRoot(HoldingView.GetHolder.MakeScope).AddScope('province',HoldingView.GetProvince.MakeScope).End)]"
		# CfV end
	}

	state = {
		name = _hide
		on_start = "[GetVariableSystem.Clear( 'county_view_open' )]"
		on_start = "[GetVariableSystem.Clear( 'hide_bottom_left_HUD' )]"
		on_start = "[GetVariableSystem.Clear( 'selected_potential_district' )]"
		on_start = "[GetVariableSystem.Clear( 'selected_potential_building' )]"
		using = Animation_FadeOut_Standard
		using = Sound_WindowHide_Standard
		position_x = -60
	}

	window_county_sub_window = {
		widgetid = "district_view"
		# reactive_advice_building_needs uses this
		blockoverride "county_sub_visible" {
			visible = "[HoldingView.IsBuildingTracksViewShown]"
		}
	}

	vbox = {
		layoutpolicy_vertical = expanding
		layoutpolicy_horizontal = expanding

		expand = {
			ignoreinvisible = yes
			layoutpolicy_vertical = expanding
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			name = "window_content"
			min_height = 660
			margin_right = 32
			datacontext = "[HoldingView.GetHolding]"
			datacontext = "[HoldingView.GetProvince]"
			datacontext = "[HoldingView.GetHolder]"
			datacontext = "[Province.GetCounty]"

			background = {
				texture = "gfx/interface/skinned/tile_window_background_subwindow.dds"
				spriteType = Corneredtiled
				spriteborder = { 18 18 }
				margin = { 18 15 }
				margin_left = 20
				margin_bottom = 20
				texture_density = 2
				margin_right = -20

				modify_texture = {
					name = "overlay"
					texture = "gfx/interface/component_overlay/overlay_effect.dds"
					spriteType = Corneredstretched
					spriteborder = { 0 0 }
					blend_mode = overlay
				}
			}

			background = {
				visible = "[Not(HoldingView.HasHolding)]"
				texture = "[HoldingView.GetProvince.GetTerrain.GetIllustration]"
				alpha = 0.7
				margin_top = -250
				fittype = centercrop

				modify_texture = {
					texture = "gfx/interface/window_county/mask_holding_illustration.dds"
					blend_mode = alphamultiply
					alpha = 0.95
				}
			}

			# county
			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				alwaystransparent = no

				widget = {
					name = "county_header"
					layoutpolicy_horizontal = expanding
					size = { 0 68 }

					hbox = {
						layoutpolicy_horizontal = expanding
						margin_right = 15
						margin_left = 5
						margin_top = 5
						margin_bottom = 5
						spacing = 10
						min_height = 70

						background = {
							using = Background_Header
						}

						background = {
							using = Background_Header_Pattern
						}

						coa_title_small = {
							datacontext = "[HoldingView.GetCountyTitle]"
						}

						vbox = {
							layoutpolicy_horizontal = expanding

							hbox = {
								layoutpolicy_horizontal = expanding
								ignoreinvisible = yes
								spacing = 5

								text_single = {
									text = "[HoldingView.GetCountyTitle.GetNameNoTooltip|U]"
									using = Font_Size_Big
									font = TitleFont
									fontsize_min = 16
									align = nobaseline
									max_width = 230
								}

								button_edit_text = {
									visible = "[HoldingView.GetCountyTitle.CanPlayerCustomizeTitle]"
									onclick = "[OpenTitleCustomizationWindow(HoldingView.GetCountyTitle)]"
									tooltip = "CUSTOMIZE_TITLE"
								}
								expand = {  }
							}

							vbox = {
								datacontext = "[HoldingView.GetCountyTitle.GetHolder]"
								layoutpolicy_horizontal = expanding

								text_single = {
									name = "your_county"
									visible = "[ObjectsEqual( Character.Self, GetPlayer )]"
									layoutpolicy_horizontal = expanding
									text = "HOLDING_VIEW_YOUR_COUNTY"
									margin_bottom = 5
									align = nobaseline
									using = Font_Size_Small
									fontsize_min = 10
									autoresize = no
								}

								text_single = {
									name = "top_realm_county"
									visible = "[Character.IsOtherLiegeOrAbove( GetPlayer )]"
									layoutpolicy_horizontal = expanding
									text = "HOLDING_VIEW_TOP_REALM_COUNTY"
									margin_bottom = 5
									using = Font_Size_Small
									fontsize_min = 10
									autoresize = no
								}

								text_single = {
									name = "foreign_county"
									visible = "[Not( Or( ObjectsEqual( Character.Self, GetPlayer ), Character.IsOtherLiegeOrAbove( GetPlayer )))]"
									layoutpolicy_horizontal = expanding
									text = "HOLDING_VIEW_FOREIGN_COUNTY"
									margin_bottom = 5
									using = Font_Size_Small
									fontsize_min = 10
									autoresize = no
								}
							}
						}
						expand = {  }

						### SIEGE AND RAID GOTO BUTTON ###
						button_group = {
							name = "open_siege_button"
							datacontext = "[HoldingView.GetProvince.GetSiege]"
							visible = "[HoldingView.GetProvince.HasActiveSiege]"
							onclick = "[DefaultOnSiegeClick(Siege.GetID)]"
							tooltip = "[Siege.GetSiegeDescription]"
							using = tooltip_se
							shortcut = county_go_to_siege
							using = siege_goto_template
						}

						button_group = {
							name = "open_raid_button"
							datacontext = "[HoldingView.GetProvince.GetRaid]"
							visible = "[HoldingView.GetProvince.HasActiveRaid]"
							onclick = "[DefaultOnRaidClick( Raid.Self )]"
							tooltip = "MAP_RAID_TOOLTIP"
							shortcut = county_go_to_siege
							using = tooltip_se
							using = raid_goto_template
							blockoverride "tooltip" {}
						}
						buttons_window_control = {
							blockoverride "button_go_to" {
								tooltip = "GOTO_PROVINCE_TT"
								using = tooltip_ne
								onclick = "[HoldingView.PanToCountyCapital]"
							}
							blockoverride "button_back" {
								visible = "[HasViewHistory]"
								onclick = "[OpenFromViewHistory]"
								tooltip = "[GetViewHistoryTooltip]"
							}
							blockoverride "button_next" {
								onclick = "[HoldingView.GoToNextCounty]"
								enabled = "[HoldingView.CanGoToNextCounty]"
								tooltip = "YOUR_NEXT_HOLDING"
							}
							blockoverride "button_close" {
								onclick = "[HoldingView.Close]"
							}
						}
					}
				}

				widget = {
					size = { 0 52 }
					layoutpolicy_horizontal = expanding

					hbox = {
						layoutpolicy_horizontal = expanding
						margin = { 8 0 }
						spacing = 10
						min_height = 52

						hbox = {
							datamodel = "[HoldingView.GetDeJureLieges]"
							margin_top = 4
							margin_bottom = -4

							item = {
								coa_title_tiny_crown = {
									visible = "[GreaterThan_int32( Title.GetTierFrame, '(int32)3' )]"
									using = tooltip_se
								}
							}
						}

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "DE_JURE_HIERARCHY"
							default_format = "#low"
							autoresize = no
						}
						expand = {  }

						hbox = {
							spacing = 3

							background = {
								using = Background_Area
								margin = { 4 4 }
							}

							flowcontainer = {
								name = "county_modifiers_grid"
								visible = "[DataModelHasItems(HoldingView.GetCountyModifiers)]"
								datamodel = "[DataModelFirst( HoldingView.GetCountyModifiers, Min_int32( GetDataModelSize( HoldingView.GetCountyModifiers ), '(int32)5' ) )]"
								ignoreinvisible = yes
								righttoleft = yes

								item = {
									modifier_item_icon = {
										size = { 28 28 }
										blockoverride "icon_data" {
											using = tooltip_ne
										}
									}
								}
							}

							text_single = {
								visible = "[GreaterThan_int32( GetDataModelSize( HoldingView.GetCountyModifiers ), '(int32)5' )]"
								autoresize = no
								size = { 30 30 }
								raw_text = "+[Subtract_int32( GetDataModelSize( HoldingView.GetCountyModifiers ), '(int32)5' )]"
								align = center|nobaseline
								using = tooltip_se

								tooltipwidget = {
									scrolltip = {
										blockoverride "scrolltip_header" {
											text_single = {
												margin_top = 8
												text = "COUNTY_ALL_MODIFIERS"
											}
										}
										blockoverride "scrolltip_size" {
											size = { 200 0 }
										}
										blockoverride "scrolltip_content" {
											flowcontainer = {
												direction = vertical
												bottomtotop = yes
												datamodel = "[HoldingView.GetCountyModifiers]"
												spacing = 3

												item = {
													flowcontainer = {
														spacing = 5
														modifier_item_text = {  }
													}
												}
											}
										}
									}
								}
							}
						}

						hbox = {

							hbox = {
								button_round_interaction_title = {
									name = "bestow_civic_liberties_interaction"
									datacontext = "[GetPlayer]"
									datacontext = "[HoldingView.GetCountyTitle]"

									blockoverride "icon" {
										button_icon_highlight = {
											parentanchor = center
											size = { 25 25 }
											position = { 0 1 }
											texture = "gfx/interface/icons/flat_icons/civic_liberties_bestow.dds"
										}
									}
								}

								button_round_interaction_title = {
									name = "revoke_civic_liberties_interaction"
									datacontext = "[GetPlayer]"
									datacontext = "[HoldingView.GetCountyTitle]"

									blockoverride "icon" {
										button_icon_highlight = {
											parentanchor = center
											size = { 25 25 }
											position = { 0 1 }
											texture = "gfx/interface/icons/flat_icons/civic_liberties_revoke.dds"
										}
									}
								}
							}

							button_round = {
								name = "move_domcicle_button"
								datacontext = "[GetPlayer.GetDomicile]"
								datacontext = "[HoldingView.GetProvince]"
								visible = "[IsLandlessAdventurer( GetPlayer )]"
								widgetid = "move_domcicle_button"
								size = { 50 50 }
								enabled = "[Domicile.CanMoveTo( Province.Self )]"
								onclick = "[OpenGameViewData( 'move_domicile_planner', Province.Self )]"
								tooltip = "[Domicile.GetType.GetMoveTooltip( Character.Self )]"
								tooltip_when_disabled = "[Domicile.GetMoveToTooltip( Province.Self )]"
								using = tooltip_ne

								button_icon = {
									alwaystransparent = yes
									parentanchor = center
									size = { 30 30 }
									texture = "gfx/interface/icons/flat_icons/move_camp.dds"
								}
							}
							expand = {  }

							spacer = {
								visible = "[Or( IsLandlessAdventurer( GetPlayer ), County.IsFullyOccupied )]"
								size = { 8 0 }
							}

							widget = {
								datacontext = [County.GetCountyOccupant]
								visible = [County.IsFullyOccupied]
								size = { 50 50 }

								icon = {
									name = "war_icon"
									parentanchor = center
									size = { 50 50 }
									texture = "gfx/interface/icons/war_status/war_icon.dds"
								}

								coa_realm_tiny = {
									parentanchor = center
									position = { 0 6 }
									blockoverride "coa_button" {
										onclick = "[DefaultOnRealmFlagClick(Character.GetID)]"
										onrightclick = "[DefaultOnCharacterRightClick(Character.GetID)]"
										button_ignore = none
										tooltip_visible = "[Not(IsInteractionMenuOpenForCharacter(Character.GetID))]"
										tooltip = "COUNTY_OCCUPIER_TOOLTIP"
									}
								}
							}
						}
					}
				}

				### County Info
				hbox = {
					name = "county_info"
					datacontext = "[HoldingView.GetProvince.GetCountyCapitalProvince]"
					layoutpolicy_horizontal = expanding
					min_height = 130
					margin = { 8 8 }

					background = {
						texture = "gfx/interface/component_tiles/tile_window_background_no_edge_grey.dds"
						alpha = 0.3
						margin_bottom = 10

						modify_texture = {
							texture = "gfx/interface/colors/grey.dds"
							blend_mode = normal
							alpha = 1
						}

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
							mirror = vertical
							blend_mode = alphamultiply
							alpha = 0.8
						}

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
							mirror = horizontal
							blend_mode = alphamultiply
							alpha = 0.8
						}

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_rough_edges.dds"
							spriteType = Corneredtiled
							spriteborder = { 25 25 }
							blend_mode = alphamultiply
						}

						modify_texture = {
							using = Color_Black
							blend_mode = normal
						}

						# me
						modify_texture = {
							using = Color_Green
							blend_mode = normal
							visible = "[ObjectsEqual( Character.Self, GetPlayer )]"
						}

						# someone below me
						modify_texture = {
							using = Color_Blue
							blend_mode = normal
							visible = "[Character.IsOtherLiegeOrAbove( GetPlayer )]"
						}

						# under my top liege, not me
						modify_texture = {
							using = Color_Bright_Yellow
							blend_mode = normal
							visible = "[And( And( Not( ObjectsEqual( Character.Self, GetPlayer )), Not( Character.IsOtherLiegeOrAbove( GetPlayer ))), ObjectsEqual( Character.GetTopLiege, GetPlayer.GetTopLiege ))]"
						}

						# others
						modify_texture = {
							using = Color_White
							blend_mode = normal
							visible = "[And( And( Not( ObjectsEqual( Character.Self, GetPlayer )), Not( Character.IsOtherLiegeOrAbove( GetPlayer ))), Not( ObjectsEqual( Character.GetTopLiege, GetPlayer.GetTopLiege )))]"
						}
					}

					#pattern
					background = {
						texture = "gfx/interface/colors/black.dds"
						alpha = 0.3
						margin_bottom = 10

						modify_texture = {
							texture = "gfx/interface/skinned/mask_pattern.dds"
							texture_density = 3
							spriteType = Corneredtiled
							blend_mode = alphamultiply
						}

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
							mirror = vertical
							blend_mode = alphamultiply
						}

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
							mirror = horizontal
							blend_mode = alphamultiply
						}

						modify_texture = {
							texture = "gfx/interface/component_masks/mask_rough_edges.dds"
							spriteType = Corneredtiled
							spriteborder = { 25 25 }
							blend_mode = alphamultiply
						}
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						expand = {}

						hbox = {
							layoutpolicy_horizontal = expanding
							allow_outside = yes

							# for the faction warning
							vbox = {
								name = "holder_info"
								datacontext = "[HoldingView.GetCountyTitle.GetHolder]"
								visible = "[Province.IsValid]"

								text_single = {
									text = "HOLDING_VIEW_HOLDER"
									align = nobaseline
									max_width = 85
								}

								## Holder
								hbox = {
									layoutpolicy_horizontal = expanding
									expand = {  }
									portrait_head_small = {  }
								}
							}

							vbox = {
								spacing = -2
								margin_left = 6
								min_width = 220

								# Culture
								hbox = {
									datacontext = "[County.GetCulture]"
									layoutpolicy_horizontal = expanding
									spacing = 0
									using = tooltip_ne

									icon = {
										texture = "gfx/interface/icons/icon_culture.dds"
										size = { 28 28 }

										background = {
											using = Background_Area_Dark
											alpha = 0.3
											margin_bottom = 2

											modify_texture = {
												texture = "gfx/interface/component_masks/mask_fade_circle_hard.dds"
												blend_mode = alphamultiply
												#mirror = vertical
												alpha = 0.9
											}
										}
									}

									button_group = {
										onclick = "[OpenGameViewData( 'culture_window', Culture.GetID )]"

										tooltipwidget = {
											culture_tooltip = {
												blockoverride "extra_info" {
													text_single = {
														fonttintcolor = "[TooltipInfo.GetTintColor]"
														using = DefaultTooltipText
														visible = "[Not( ObjectsEqual( Culture.Self, GetPlayer.GetCulture ) )]"
														text = "COUNTY_NOT_YOUR_CULTURE"
													}
												}
											}
										}

										text_single = {
											text = "CULTURE_COUNTY_WINDOW"
											default_format = "#high"
											margin = { 2 0 }
											max_width = 110

											background = {
												visible = "[And( NotEqualTo_uint32( Culture.GetID, GetPlayer.GetCulture.GetID ), EqualTo_CFixedPoint( Culture.GetAcceptance( GetPlayer.GetCulture ), '(CFixedPoint)100' ) )]"
												margin = { 2 0 }
												using = Status_Good
											}

											background = {
												visible = "[And( And( NotEqualTo_uint32( Culture.GetID, GetPlayer.GetCulture.GetID ), NotEqualTo_CFixedPoint( Culture.GetAcceptance( GetPlayer.GetCulture ), '(CFixedPoint)100' ) ), NotEqualTo_CFixedPoint( Culture.GetAcceptance( GetPlayer.GetCulture ), '(CFixedPoint)0' ) )]"
												margin = { 2 0 }
												using = Status_Mixed
											}

											background = {
												visible = "[EqualTo_CFixedPoint( Culture.GetAcceptance( GetPlayer.GetCulture ), '(CFixedPoint)0' )]"
												margin = { 2 0 }
												using = Status_Bad
											}
										}
									}

									text_single = {
										visible = "[NotEqualTo_uint32( Culture.GetID, GetPlayer.GetCulture.GetID )]"
										text = "COUNTY_CULTURE_ACCEPTANCE_DIFF_CULTURE"
										margin_right = 5
										max_width = 55
										tooltip = "CULTURE_ACCEPTANCE_TOOLTIP"
									}
									expand = {  }
								}

								# Faith
								hbox = {
									datacontext = "[County.GetFaith]"
									layoutpolicy_horizontal = expanding
									spacing = 2
									using = tooltip_ne

									vbox = {
										expand = {
											minimumsize = { 0 2 }
										}

										icon = {
											size = { 28 28 }
											datacontext = "[Province.GetCounty.GetRite]"
											texture = "[Rite.GetIcon]"

											background = {
												using = Background_Area_Dark
												alpha = 0.3

												modify_texture = {
													texture = "gfx/interface/component_masks/mask_fade_circle_hard.dds"
													blend_mode = alphamultiply
													alpha = 0.9
												}
											}
										}
									}

									button_group = {
										datacontext = "[County.GetRite]"
										onclick = "[OpenGameViewData( 'faith', Rite.Self )]"

										tooltipwidget = {
											rite_tooltip = {
												blockoverride "extra_info" {
													using = faith_tooltip_click_default_extra_info

													text_single = {
														margin = { 10 0 }
														layoutpolicy_horizontal = expanding
														fonttintcolor = "[TooltipInfo.GetTintColor]"
														using = DefaultTooltipText
														visible = "[Not( ObjectsEqual( Faith.Self, GetPlayer.GetFaith ) )]"
														text = "COUNTY_NOT_YOUR_FAITH"
													}
												}
											}
										}

										flowcontainer = {
											ignoreinvisible = yes
											resizeparent = yes

											text_single = {
												visible = "[EqualTo_uint32( Faith.GetID, GetPlayer.GetFaith.GetID )]"
												text = "WINDOW_COUNTY_RITE_NAME"
												default_format = "#high"
												margin_right = 5
												max_width = 140
											}

											text_single = {
												visible = "[NotEqualTo_uint32( Faith.GetID, GetPlayer.GetFaith.GetID )]"
												text = "WINDOW_COUNTY_RITE_NAME"
												default_format = "#high"
												margin = { 2 0 }
												max_width = 140

												background = {
													margin = { 2 0 }
													using = Status_Bad
												}
											}
										}
									}
									expand = {  }
								}
							}
							expand = {  }

							hbox = {
								name = county_stats
								datacontext = "[HoldingView.GetProvince.GetCounty]"
								datacontext = "[HoldingView.AccessCountyBreakdowns]"
								allow_outside = yes
								layoutpolicy_horizontal = expanding
								margin_top = 28
								margin_right = 8

								hbox = {
									background = {
										using = Background_Area_Dark
										alpha = 0.8
									}

									# POPULAR OPINION INFO
									widget_top_county_info_vertical = {
										datacontext = "[HoldingView.AccessCountyBreakdowns]"
										datacontext = "[CountyDataBreakdowns.AccessMonthlyOpinion( County.Self )]"
										datacontext = "[HoldingView.AccessPopularOpinionBar]"

										tooltipwidget = {
											county_opinion_cooltip = {  }
										}

										using = tooltip_se
										blockoverride "card_icon" {
											texture = "gfx/interface/icons/popular_opinion_levels.dds"
											framesize = { 64 64 }
											frame = "[Add_int32( County.GetOpinionLevel, '(int32)1' )]"
										}
										blockoverride "card_value" {
											datacontext = "[HoldingView.AccessPopularOpinionBar]"
											raw_text = "[ComplexBar.GetCurrentFilledWidth]"
										}
										blockoverride "card_value" {
											raw_text = "[County.GetCurrentOpinion]"
										}
										blockoverride "card_progress" {}
										blockoverride "card_progress_size" {}
									}

									vbox = {
										margin = { 0 10 }
										layoutpolicy_vertical = expanding

										divider_light = {
											layoutpolicy_vertical = expanding
											size = { 4 0 }
										}
									}

									# CONTROL INFO
									widget_top_county_info_vertical = {
										datacontext = "[County.GetCount.GetGovernment]"
										datacontext = "[CountyDataBreakdowns.AccessControl( County.Self )]"

										tooltipwidget = {
											county_control_cooltip = {  }
										}
										using = tooltip_se
										blockoverride "card_icon" {
