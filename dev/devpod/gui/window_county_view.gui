	type widget_building_item_draggable_object = widget {
		size = { 60 60 }

		button_standard = {
			size = { 100% 100% }
			alwaystransparent = yes
			down = "[GUIBuildingItem.IsHighlighted]"

			background = {
				visible = "[Or( HoldingView.GetTitle.GetHolder.IsLocalPlayer, District.GetOwningTitle.GetHolder.IsLocalPlayer )]"
			}

			icon_building = {
				parentanchor = center
				size = { 46 46 }
				texture = "[GUIBuildingItem.GetCurrentOrConstrucingBuilding.GetTypeIcon]"
			}

			icon_drag_indicator = {
				name = "drag_indicator"
				visible = "[And( Not( District.IsRuined ), HoldingView.GetTitle.GetHolder.IsLocalPlayer )]"
				alpha = 0

				state = {
					name = hover_enter
					alpha = 1
					duration = 0.2
					using = Animation_Curve_Default
				}

				state = {
					name = hover_leave
					alpha = 0
					duration = 0.2
					using = Animation_Curve_Default
				}
			}

			icon_building_level = {
				parentanchor = top|left
				position = { 2 2 }
				blockoverride "icon_size" {
					size = { 16 16 }
				}
			}
		}
		block "upgrade_indicator" {
			button_icon_can_upgrade = {
				visible = "[GUIBuildingItem.CanUpgradeImmediately]"
				tooltip = "HOLDING_BUILDING_CAN_UPGRADE_NOW"
				parentanchor = bottom|left
				position = { 0 -4 }
			}
		}
	}

