	type button_building_track_next = button_icon {
		name = "next_building"
		visible = "[GUITrackItem.HasNextBuilding]"
		down = "[GUITrackItem.IsNextBuildingSelected]"
		alwaystransparent = "[GUITrackItem.IsNextBuildingSelected]"
