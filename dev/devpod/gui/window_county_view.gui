					texture = "gfx/interface/icons/icon_gold.dds"
				}
				blockoverride "card_value" {
					text = "HOLDING_TAX_VALUE"
				}
			}

			widget_value_card = {
				visible = "[And( HoldingView.HasHolding, Holding.GetHolder.HasBarterGoods )]"

				tooltip = "[Holding.GetBarterGoodsIncomeTooltip]"
				blockoverride "card_icon" {
					texture = "gfx/interface/icons/icon_barter.dds"
				}
				blockoverride "card_value" {
					text = "HOLDING_BARTER_GOODS_VALUE"
				}
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = fixed
			spacing = 2

