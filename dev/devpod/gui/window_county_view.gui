												}
											}

											hbox = {
												name = "holding_modifiers"
												ignoreinvisible = yes

												datamodel = "[DataModelFirst( HoldingView.GetHoldingModifiers, Select_int32( GreaterThan_int32( Add_int32( Add_int32( GetDataModelSize( HoldingView.GetProvince.GetEpidemics ), GetDataModelSize( HoldingView.GetProvince.GetLegends ) ), GetDataModelSize( HoldingView.GetHoldingModifiers ) ), '(int32)8' ), Max_int32( Subtract_int32( '(int32)7', Add_int32( GetDataModelSize( HoldingView.GetProvince.GetEpidemics ), GetDataModelSize( HoldingView.GetProvince.GetLegends ) ) ), '(int32)0' ), GetDataModelSize( HoldingView.GetHoldingModifiers ) ) )]"

												item = {
													modifier_item_icon = {
														size = { 30 30 }
														blockoverride "icon_data" {
															using = tooltip_ne
														}
													}
												}
											}

											text_single = {
												### This visible trigger checks if there are more than 8 elements amongst modifiers, plagues and legends in a barony
												visible = "[GreaterThan_int32( Add_int32( Add_int32( GetDataModelSize( HoldingView.GetProvince.GetEpidemics ), GetDataModelSize( HoldingView.GetProvince.GetLegends ) ), GetDataModelSize( HoldingView.GetHoldingModifiers ) ), '(int32)8' )]"
												autoresize = no
												size = { 30 30 }
												raw_text = "+[Subtract_int32( Add_int32( Add_int32( GetDataModelSize( HoldingView.GetProvince.GetEpidemics ), GetDataModelSize( HoldingView.GetProvince.GetLegends ) ), GetDataModelSize( HoldingView.GetHoldingModifiers ) ), '(int32)7' )]"
												align = center|nobaseline
												using = tooltip_se

												tooltipwidget = {
													scrolltip = {
														blockoverride "scrolltip_header" {
															text_single = {
																margin_top = 8
																text = "HOLDING_ALL_MODIFIERS"
															}
														}
														blockoverride "scrolltip_size" {
															size = { 200 0 }
														}
														blockoverride "scrolltip_content" {
															flowcontainer = {
																direction = vertical
																spacing = 3
																ignoreinvisible = yes

																flowcontainer = {
																	spacing = 4
																	ignoreinvisible = yes
																	datamodel = "[HoldingView.GetHoldingStatuses]"

																	item = {
																		widget = {
																			visible = "[And( Or( HoldingStatus.IsEpidemic, HoldingStatus.IsLegend ), Not( LessThan_int32( PdxGuiWidget.GetIndexInDataModel, Add_int32( Subtract_int32( GetDataModelSize( HoldingView.GetHoldingStatuses ), Add_int32( GetDataModelSize( HoldingView.GetProvince.GetEpidemics ), GetDataModelSize( HoldingView.GetProvince.GetLegends ) ) ), '(int32)7' ) ) ) )]"
																			size = { 38 38 }

																			county_holding_status_epidemic = {
																				parentanchor = center
																			}

																			county_holding_status_legend = {
																				parentanchor = center
																			}
																		}
																	}
																}

																flowcontainer = {
																	direction = vertical
																	bottomtotop = yes
																	datamodel = "[DataModelSkipFirst( HoldingView.GetHoldingModifiers, Max_int32( Subtract_int32( '(int32)7', Add_int32( GetDataModelSize( HoldingView.GetProvince.GetEpidemics ), GetDataModelSize( HoldingView.GetProvince.GetLegends ) ) ), '(int32)0' ) )]"
																	spacing = 3

																	item = {
																		flowcontainer = {
																			spacing = 5
																			modifier_item_text = {  }
																		}
																	}
																}
															}
														}
													}
												}

												background = {
													using = Background_Area_Dark
													margin = { 3 3 }

													modify_texture = {
														texture = "gfx/interface/component_masks/mask_fade_circle.dds"
														blend_mode = alphamultiply
													}
												}
											}
										}
										expand = {}
									}

									hbox = {
										margin_left = 4
										layoutpolicy_horizontal = expanding

										hbox_title_shared_buttons_county = {
											datacontext = "[HoldingView.GetTitle]"
											datacontext = "[Title.GetHolder]"
										}

										expand = {}
									}
								}
								expand = {}
							}

							expand = {}

							vbox = {
								visible = "[HoldingView.HasHolding]"
								layoutpolicy_horizontal = expanding
								margin = { 2 2 }

								widget_district_item = {
									name = "special_building_no_others"
									visible = "[And( HoldingView.HasSpecialDistrictSlot, HoldingView.GetHolding.GetType.HasParameter( 'no_buildings' ))]"
									datacontext = "[HoldingView.GetGUISpecialDistrict]"

									highlight_icon = {
										size = { 100% 100% }
										using = Special_Building_Texture
									}
								}

								vbox = {
									name = "holding_view_buildings_area"
									widgetid = "holding_view_buildings_area"
									# ra_merit_governor_holding_view / reactive_advice_building_needs uses this
									visible = "[Not(HoldingView.GetHolding.GetType.HasParameter('no_buildings'))]"
									layoutpolicy_horizontal = expanding
									spacing = 2

									# Premium districts in the holding view display order
									# Display order only: trade goods and disabling follow CHolding::ForEachDistrict
									flowcontainer = {
										visible = "[HoldingView.HasAnySpecialDistrictSlot]"
										layoutpolicy_horizontal = expanding
										spacing = 2
										wrap_count = 6
										ignoreinvisible = yes

										widget_district_item = {
											name = "resource_district"
											datacontext = "[HoldingView.GetGUIResourceDistrict]"
											visible = no # CfV PoD: no resource districts
										}

										widget_district_item = {
											name = "trade_post_district"
											datacontext = "[HoldingView.GetGUITradePostDistrict]"
											visible = "[And( HoldingView.HasTradePostDistrictSlot, Or( GetPlayer.CanOwnTradePosts, HoldingView.GetHolding.HasConstructedTradePost ) )]"


											blockoverride "district_item_icon_ghost" {
												icon_empty_trade_post = {
													parentanchor = center
													size = { 62 62 }
												}
											}
										}

										widget_district_item = {
											name = "duchy_capital_district"
											datacontext = "[HoldingView.GetGUIDuchyCapitalDistrict]"
											visible = "[HoldingView.HasDuchyCapitalDistrictSlot]"
											blockoverride "building_frame" {
												district_building_frame_icon = {
													texture = "gfx/interface/buttons/button_duchy_capital.dds"
												}
											}
										}

										widget_district_item = {
											name = "special_building"
											datacontext = "[HoldingView.GetGUISpecialDistrict]"
											visible = "[HoldingView.HasSpecialDistrictSlot]"
											blockoverride "shortcut" {
												shortcut = "special_building"
											}
											blockoverride "building_frame" {
												district_building_frame_icon = {
													texture = "gfx/interface/buttons/button_special_building.dds"
												}
											}
										}

										widget_district_item = {
											name = "great_building"
											datacontext = "[HoldingView.GetGUIGreatDistrict]"
											visible = "[HoldingView.HasGreatDistrictSlot]"

											warning_icon = {
												name = "ruined_great_district"
												visible = "[And( GUIDistrictItem.IsDistrictRuined, Not( GUIDistrictItem.IsRebuilding ) )]"
												alwaystransparent = yes
												position = { -3 3 }
												size = { 20 20 }
												parentanchor = top|right
											}
											blockoverride "shortcut" {
												shortcut = "great_building"
											}
											blockoverride "building_frame" {
												district_building_frame_icon = {
													texture = "gfx/interface/buttons/button_great_building.dds"
												}
											}
										}

										widget_district_item = {
											name = "entrepot_district"
											datacontext = "[HoldingView.GetGUIEntrepotDistrict]"
											visible = "[HoldingView.HasEntrepotDistrictSlot]"
										}
									}

									flowcontainer = {
										name = "regular_districts_tutorial_uses_this"
										layoutpolicy_horizontal = expanding
										spacing = 2
										wrap_count = 6
										datamodel = "[HoldingView.GetDistricts]"

										item = {
											widget_district_item_draggable_slot = {
												blockoverride "shortcut" {
													shortcut = "[Concatenate( 'sub_tab_', IntToString( Subtract_int32( GetDataModelSize( HoldingView.GetBuildings ), PdxGuiWidget.AccessParent.GetIndexInDataModel )))]"
												}
											}
										}
									}
								}
							}
						}

						holding_stats_sidebar = {}
					}
				}
			}
			expand = {}
		}
	}
}
######################################################
########### CONSTRUCT NEW BUILDING WINDOW ############
######################################################
### TODO TIT-74553 - Investigate if we can remove this window.

window = {
	name = "holding_tracks_view"
	size = { 605 900 }
	movable = no
	layer = top
	datacontext = "[HoldingView.GetHolder]"

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		position_x = 0
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		position_x = -50
	}
	alwaystransparent = yes
}
######################################################
############ HOLDING TYPE SELECTION VIEW #############
######################################################

window = {
	name = "holding_type_selection_view"
	layer = windows_layer
	parentanchor = bottom|left
	position = { 660 0 }
	size = { 605 675 }
	movable = no
	using = Animation_ShowHide_Quick
	using = Window_Background_Subwindow

	vbox = {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		margin = { 4 4 }
		margin_bottom = 5

		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text" {
				text = "CREATE_NEW_HOLDING_HEADING"
			}
			blockoverride "button_close" {
				onclick = "[HoldingView.CloseHoldingConstruction]"
			}
		}
		building_in_vassal_warning_hbox = {  }

		scrollbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			blockoverride "scrollbox_background" {}
			blockoverride "scrollbox_content" {
				vbox = {
					name = "holding_types"
					layoutpolicy_horizontal = expanding
					spacing = 10
					datamodel = "[HoldingView.GetHoldingTypeItems]"

					item = {
						button_standard = {
							layoutpolicy_horizontal = expanding
							size = { 512 148 }
							enabled = "[HoldingTypeItem.CanConstructDistrict]"
							onclick = "[HoldingTypeItem.OnClick]"
							tooltip = "[HoldingTypeItem.GetTooltip( GetPlayer.Self )]"
							datacontext = "[HoldingTypeItem.GetProvince]"

							hbox = {
								set_parent_size_to_minimum = yes

								widget = {
									size = { 220 148 }

									widget = {
										scissor = yes
										size = { 217 146 }

										icon = {
											visible = "[HoldingTypeItem.CanConstructDistrict]"
											alwaystransparent = yes
											size = { 320 146 }
											texture = "[HoldingTypeItem.GetDistrictType.GetIllustration(Province.Self)]"
											using = Mask_Rough_Edges
											alpha = 0.7
										}

										highlight_icon = {
											visible = "[Not(HoldingTypeItem.CanConstructDistrict)]"
											alwaystransparent = yes
											size = { 320 146 }
											texture = "[HoldingTypeItem.GetDistrictType.GetIllustration(Province.Self)]"
											effectname = "GreyedOut"
											tintcolor = { 0.6 0.6 0.6 1 }
											using = Mask_Rough_Edges
										}
									}

									flowcontainer = {
										parentanchor = bottom|right
										ignoreinvisible = yes
										margin = { 5 5 }

										warning_icon = {
											name = "wrong_type"
											visible = "[Not(HoldingTypeItem.IsValidForPlayer)]"
											size = { 35 35 }
											tooltip = HOLDING_SELECTION_VIEW_WRONG_HOLDING_TYPE
										}
									}
								}

								vbox = {
									size = { 260 0 }
									layoutpolicy_vertical = expanding
									spacing = 8
									margin = { 16 8 }
									margin_top = 16

									text_multi = {
										layoutpolicy_horizontal = expanding
										text = "CONSTRUCT_HOLDING_NAME"
										autoresize = yes
										max_width = 260
										alwaystransparent = yes
									}

									text_multi = {
										layoutpolicy_horizontal = expanding
										autoresize = yes
										max_width = 260
										raw_text = "CONSTRUCT_HOLDING_SHORT_DESC"
										alwaystransparent = yes
									}
									expand = {  }

									potential_item_cost_row = {
										datacontext = "[HoldingTypeItem.AccessAsPotentialItem]"
										layoutpolicy_horizontal = expanding
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
