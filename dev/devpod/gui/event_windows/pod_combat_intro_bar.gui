######################################
######   POD COMBAT INTRO BAR   ######
######################################

# Event window for pod_combat.0201, the first-fight intro's ready bar. Cloned
# from pod_combat_shell.gui, which solves the same problem at the other end of a
# fight: an event held open so its scope table survives GUI clicks, presented as
# a card small enough to live alongside a full-screen window.
#
# Here the window it has to live alongside is the loadout editor, which the
# intro's review option opens underneath this card. The editor is centred at
# 1460x900, so the bar is docked to the TOP edge instead: event windows draw
# above the royal_court layer the editor sits on, and at 1080p that leaves the
# overlap confined to the editor's top frame rather than its controls.
#
# Minimal for the same reasons the shell is: no dimmer, no portraits, no theme
# art. Unlike the shell it is always visible - it exists only before a fight, so
# there is no live-fight state to hide from and no stale-card case to keep
# reachable.

window = {
	name = "pod_combat_intro_bar"

	parentanchor = top|hcenter
	widgetanchor = top|hcenter
	position = { 0 12 }
	size = { 470 -1 }
	layer = events
	alpha = 1

	datacontext = "[EventWindow.AccessEventWindowData]"

	using = Window_Background
	using = Window_Decoration_Warfare
	
	pod_combat_event_background = {}
	
	state = {
		name = _show
		using = Animation_FadeIn_Standard
	}

	# The world must not tick while the duel waits on this click: Part 3 has
	# already stamped engaged_in_single_combat on both principals. Same state the
	# combat window uses (pod_combat_window.gui); the intro event carries its own
	# copy through pod_combat_intro_pause.gui.
	state = {
		name = _pause
		trigger_when = "[Not(IsGamePaused)]"
		on_start = "[OnPause]"
	}

	pod_combat_event_contents = {
		blockoverride "event_option_enabled" {
			# IsOnTop keeps the bar from taking clicks through whatever
			# the player has stacked over it. No fight-state arm here,
			# unlike the shell: this card only ever exists before the
			# fight is built.
			enabled = "[And(EventOption.IsValid, EventWindow.IsOnTop)]"
		}
	}
}
