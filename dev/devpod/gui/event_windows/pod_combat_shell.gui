######################################
######   POD COMBAT DUEL SHELL   ######
######################################

# Event window for pod_combat.9995, the duel shell. The shell is an ordinary
# character event deliberately held open for the whole fight so the launching
# event's saved-scope table stays alive across the combat window's GUI clicks
# (see the event's own header). This window is all the player sees of that
# mechanism, so it has to read as a passive status card while the fight runs
# and only become actionable once the fight resolves.
#
# Minimal by design: no event_window_dimmer_widget (vanilla windows opt into
# the screen dimmer explicitly, and dimming for the length of a fight would be
# absurd), no portraits, no theme art.
#
# The card stays hidden for the length of the fight and appears, centred, once
# the fight is decided. The EVENT still opens at launch and stays open the
# whole time - it has to, since being fired inside the launching effect is what
# captures the scope table, and an event opened at the end would be fired from
# a scope-less GUI click. Only the window is withheld. That also keeps it off
# the combat window entirely during play: event windows draw above the
# royal_court layer, and the combat window is centred at 1525 wide and
# auto-widens further, so there is no corner a visible card could stay clear of.
#
# The second arm keeps a card that outlived its fight reachable rather than
# invisible-and-open forever (see the option's enabled binding below).

window = {
	name = "pod_combat_shell"

	parentanchor = center
	widgetanchor = center
	size = { 470 150 }
	layer = events
	alpha = 1

	visible = "[Or(GetPlayer.MakeScope.Var('pod_combat_is_over').IsSet, Not(GetPlayer.MakeScope.Var('pod_combat_active').IsSet))]"

	datacontext = "[EventWindow.AccessEventWindowData]"

	using = Window_Background
	using = Window_Decoration

	# Fires on the visibility flip, not on create: the window is created hidden
	# at duel launch and only becomes visible when the fight resolves. Same
	# pattern as pod_combat_window.gui's own _show state.
	state = {
		name = _show
		using = Animation_FadeIn_Standard
	}

	vbox = {
		margin = { 18 12 }
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
		# The two status lines are mutually exclusive; without this the hidden
		# one still reserves its height inside the fixed window size and can
		# clip the option button off the bottom.
		ignoreinvisible = yes
		# No expand between the text and the button: every line fits on one
		# row at this width, so an expand only opens a dead gap mid-card.
		# Even spacing throughout instead, with the window sized to the stack.
		spacing = 6

		text_single = {
			name = "title"
			text = "[EventWindowData.GetTitle]"
			default_format = "#bold;glow_color:{0.0,0.0,0.0,1.0}"
			fontsize = 18
			fontsize_min = 13
			max_width = 430
			align = center
			layoutpolicy_horizontal = expanding
		}

		text_multi = {
			name = "description"
			text = "[EventWindowData.GetDescription]"
			default_format = "#weak"
			minimumsize = { 430 -1 }
			maximumsize = { 430 -1 }
			autoresize = yes
			fontsize = 14
			align = center
		}

		# The window is only visible when the fight is decided OR when no fight
		# is live, so Not(is_over) here means the second case: a card that
		# outlived its fight. The title and description read for the normal
		# case, so that one needs saying. Tests only whether a variable is set,
		# never dereferences one, so it cannot error while the var is absent.
		text_single = {
			visible = "[Not(GetPlayer.MakeScope.Var('pod_combat_is_over').IsSet)]"
			raw_text = "[Localize('pod_combat_shell_status_stale')]"
			fontsize = 14
			align = center
			layoutpolicy_horizontal = expanding
		}

		### Option row
		fixedgridbox = {
			name = "option_grid"
			addcolumn = 434
			addrow = 34
			datamodel = "[EventWindowData.GetOptions]"
			layoutpolicy_horizontal = expanding

			item = {
				button_standard = {
					name = "event_option_button"
					# Centred in the full-width cell rather than filling it, so
					# the button frames its label instead of stretching to the
					# card edges (vanilla does the same in the letter event's
					# option grid).
					parentanchor = hcenter
					size = { 260 32 }

					text = "[EventOption.GetText]"

					onclick = "[EventOption.Select]"
					onmousehierarchyenter = "[EventOption.OnEnter]"
					onmousehierarchyleave = "[EventOption.OnLeave]"

					# Gates script cannot supply. Option triggers are evaluated
					# when the event fires, long before the fight resolves, so
					# readiness has to be a live GUI binding; IsOnTop keeps a
					# card sitting under a stacked event (the combat help hub,
					# a follow-up popup) from taking clicks.
					#
					# The no-live-fight arm keeps a card that outlived its
					# fight dismissable - otherwise, with is_over cleared by
					# cleanup, it would be permanently disabled and there is no
					# close button and no keyboard accelerator to fall back on.
					# The option's own trigger makes that click a safe no-op.
					enabled = "[And(And(EventOption.IsValid, EventWindow.IsOnTop), Or(GetPlayer.MakeScope.Var('pod_combat_is_over').IsSet, Not(GetPlayer.MakeScope.Var('pod_combat_active').IsSet)))]"

					tooltip = "[EventOption.GetTooltip]"
					tooltip_visible = "[Not( StringIsEmpty( EventOption.GetTooltip ) )]"
					tooltipwidget = {
						using = DefaultTooltipWidget
					}
					using = tooltip_es
				}
			}

			# Deliberately no button_event_shortcut child. Vanilla's option
			# buttons carry a shift+N accelerator that calls EventOption.Select
			# from its own widget, so it ignores the parent button's enabled
			# state, and nothing gates it against a non-event window holding
			# the player's attention. Omitting it is the only way to stop a
			# stray keypress concluding a fight that is still in progress.
		}
	}
}
