window = {
	name = "umbra_expedition_window"
	layer = middle
	parentanchor = center
	size = { 600 825 }
	using = Window_Background_Popup
	using = Window_Decoration_Spike
	allow_outside = yes
		
	visible = "[And(GetVariableSystem.Exists( 'pod_expedition_view' ),IsInGame)]"
	
	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}
	
	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}

	button_close = {
        name = "button_close"
		position = { 550 25 }
		shortcut = "close_window"
		tooltip = "CLOSE_TOOLTIP"
		clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_close"
		
		onclick = "[GetVariableSystem.Clear('pod_expedition_view')]"
	}
	
	background = {
		name = "triangle_background"
		alpha = 0.4
		fittype = start
		texture = "gfx/interface/illustrations/spirit_world.dds"

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
			blend_mode = alphamultiply
			mirror = vertical
		}
	}
	
	container = {
		line = { visible = "[GetScriptedGui( 'umbra_b7_to_c8_unlocked' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = Line_Lifestyles_Unlocked from = { 200 150 } to = { 300 50 } }
		line = { visible = "[GetScriptedGui( 'umbra_b7_to_c8_available' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = Line_Lifestyles_CanUnlock from = { 200 150 } to = { 300 50 } }
		line = { visible = "[GetScriptedGui( 'umbra_b7_to_c8_unavailable' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = Line_Lifestyles_Unavailable from = { 200 150 } to = { 300 50 } }
	}
	container = {
		line = { visible = "[GetScriptedGui( 'umbra_c7_to_c8_unlocked' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = Line_Lifestyles_Unlocked from = { 300 150 } to = { 300 50 } }
		line = { visible = "[GetScriptedGui( 'umbra_c7_to_c8_available' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = Line_Lifestyles_CanUnlock from = { 300 150 } to = { 300 50 } }
		line = { visible = "[GetScriptedGui( 'umbra_c7_to_c8_unavailable' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = Line_Lifestyles_Unavailable from = { 300 150 } to = { 300 50 } }
	}
	container = {
		line = { visible = "[GetScriptedGui( 'umbra_d7_to_c8_unlocked' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = Line_Lifestyles_Unlocked from = { 400 150 } to = { 300 50 } }
		line = { visible = "[GetScriptedGui( 'umbra_d7_to_c8_available' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = Line_Lifestyles_CanUnlock from = { 400 150 } to = { 300 50 } }
		line = { visible = "[GetScriptedGui( 'umbra_d7_to_c8_unavailable' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = Line_Lifestyles_Unavailable from = { 400 150 } to = { 300 50 } }
	}
	button_umbra_expedition = { 
		datacontext = "[GetScriptedGui( 'umbra_expedition_end' )]"
		onclick = "[GetVariableSystem.Clear('pod_expedition_view')]"
		position = { 275 25 }
	
		highlight_icon = {
			texture = "gfx/interface/icons/umbra/icon_umbra.dds"
			size = { 50 50 }
		}

		text_multi = {
			parentanchor = top|hcenter
			position = { 0 50 }
			max_width = 75
			autoresize = yes

			text = "[Localize(Concatenate('umbra_discovery_', GetPlayer.MakeScope.GetVariable('current_umbra_discovery').GetFlagName))]"
			default_format = "#high"
			align = top|hcenter

			background = {
				using = Background_Area
				margin = { 20 0 }
				margin_bottom = 5
				margin_top = 5
			}
		}
		
	}
	container = {
		line = { visible = "[GetScriptedGui( 'umbra_a6_to_b7_unlocked' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = Line_Lifestyles_Unlocked from = { 100 250 } to = { 200 150 } }
