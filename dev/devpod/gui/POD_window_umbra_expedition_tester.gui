window = {
	name = "umbra_expedition_tester_window"
	layer = middle
	parentanchor = center
	size = { 650 840 }
	using = Window_Background_Popup
	using = Window_Decoration_Spike
	allow_outside = yes
		
	visible = "[And(GetVariableSystem.Exists('pod_expedition_tester_view'), GetPlayer.MakeScope.Var('umbra_map').IsSet)]"
	
	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}
	
	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}

	margin_widget = {
		name = "main_content"
		# Actual positions should be calculated against a 600x800 panel
		margin = { 25 20 }
		size = { 100% 100% }
	
		# Top Button Row
		button_undo = {
			name = "button_reload"
			position = { 530 0 }
			onclick = "[GetScriptedGui('POD_umbra_expedition_reload').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			onclick = "[PdxGuiTriggerAllAnimations('set_button_position')]"
		}
				
		button_close = {
			name = "button_close"
			position = { 570 0 }
			shortcut = "close_window"
			tooltip = "CLOSE_TOOLTIP"
			clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_close"
			
			onclick = "[GetVariableSystem.Clear('pod_expedition_tester_view')]"
		}

		widget = {
			name = "pod_lines_nodes"
			size = { 100% 100% }
			alwaystransparent = yes
			datamodel = "[GetPlayer.MakeScope.Var('umbra_map').GetList('lines')]"
			item = {
				pod_umbra_line = {}
			}
		}

		widget = {
			name = "pod_umbra_nodes"
			size = { 100% 100% }
			alwaystransparent = yes
			datamodel = "[GetPlayer.MakeScope.Var('umbra_map').GetList('nodes')]"
			item = {
				pod_umbra_node = {}
			}
		}
	}

	background = {
		name = "triangle_background"
		alpha = 0.4
		fittype = fill
		texture = "gfx/interface/illustrations/spirit_world.dds"

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
			blend_mode = alphamultiply
			mirror = vertical
		}
	}
}

types UmbraTesterTypes
{
	type pod_umbra_node = widget
	{ 
		button_normal = {
			size = { 40 40 }
			visible = "[StoryGuiIsShown('POD_umbra_node_button_sgui')]"
			position = "[PdxGetWidgetScreenSize(PdxGuiWidget.AccessParent.FindChild('positioning_helper').Self)]"

			# TODO: Abuse culutral innovations
			highlight_icon = {
				visible = "[StoryGuiIsShown('POD_umbra_node_start_sgui')]"
				texture = "gfx/interface/icons/message_feed/vampire.dds"
				size = { 40 40 }
			}

			highlight_icon = {
				visible = "[StoryGuiIsShown('POD_umbra_node_end_sgui')]"
				texture = "gfx/interface/icons/message_feed/demon.dds"
				size = { 40 40 }
			}

			highlight_icon = {
				visible = "[StoryGuiIsShown('POD_umbra_node_unknown_sgui')]"
				texture = "gfx/interface/icons/message_feed/control.dds"
				size = { 40 40 }
			}
		}

		# Please give us a better way to create CVector2f Paradox
		widget = {
			name = "positioning_helper"
			# Fix 0 indexing--simplified ((cols - 1) - (coord_x/y)) = (cols - (coord_x/y + 1))
			min_width = "[UmbraScaledScopedNodeX]"
			max_width = "[UmbraScaledScopedNodeX]"
			min_height = "[UmbraScaledScopedNodeY]"
			max_height = "[UmbraScaledScopedNodeY]"
		}
	}

	type pod_umbra_line = widget
	{
		size = { 100% 100% }
		line = {
			# TODO: Can we reuse this?
			# (highlights the paths that can be taken by the player right now, based on their current position)
			#alpha = "[Select_float( StoryGuiIsValid('POD_heist_line_sgui'), '(float)1', '(float)0.3' )]"
			using = Line_Lifestyles_Unlocked
			scale = "[GetInvParentScale(PdxGuiWidget.Self)]"
			from  = "[PdxGetWidgetScreenSize(PdxGuiWidget.AccessParent.FindChild('pod_line_start').Self)]"
			to    = "[PdxGetWidgetScreenSize(PdxGuiWidget.AccessParent.FindChild('pod_line_end').Self)]"
		}
		widget = {
			name = "pod_line_start"
			min_width = "[Add_int32(UmbraScaledScopedLineX1, UmbraNodeOffset)]"
			max_width = "[Add_int32(UmbraScaledScopedLineX1, UmbraNodeOffset)]"
			min_height = "[Add_int32(UmbraScaledScopedLineY1, UmbraNodeOffset)]"
			max_height = "[Add_int32(UmbraScaledScopedLineY1, UmbraNodeOffset)]"
		}
		widget = {
			name = "pod_line_end"
			min_width = "[Add_int32(UmbraScaledScopedLineX2, UmbraNodeOffset)]"
			max_width = "[Add_int32(UmbraScaledScopedLineX2, UmbraNodeOffset)]"
			min_height = "[Add_int32(UmbraScaledScopedLineY2, UmbraNodeOffset)]"
			max_height = "[Add_int32(UmbraScaledScopedLineY2, UmbraNodeOffset)]"
		}
	}
}
