flowcontainer = {
	name = "resource_bars_hud"
	visible = "[And( Not( IsPauseMenuShown ), And(And(IsDefaultGUIMode, GetPlayer.IsValid), Not(GetVariableSystem.Exists( 'hide_bottom_left_HUD'))))]"
	
	parentanchor = bottom|hcenter
	position = { -66 -8 }

	ignoreinvisible = yes
	alwaystransparent = no

	vbox = {
		set_parent_size_to_minimum = yes
		
		pod_resource_bar_glamour = {}
		
		pod_resource_bar_pathos = {}
		
		pod_resource_bar_sekhem = {}
		
		pod_resource_bar_resolve = {}
		
		pod_resource_bar_yin = {}
		
		pod_resource_bar_yang = {}
		
		pod_resource_bar_gnosis = {}
		
		pod_resource_bar_rage = {}
		
		pod_resource_bar_masquerade = {}
		
		pod_resource_bar_blood = {}
	}
}