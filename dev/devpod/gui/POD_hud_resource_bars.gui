widget = {
	name = "resource_bars_hud"
	visible = "[And( And( Not( IsPauseMenuShown ), IsDefaultGUIMode ), GetPlayer.IsValid)]"
	size = { 100% 100% }
	
	flowcontainer = {
		#visible = "[Not(GetVariableSystem.Exists( 'hide_bottom_left_HUD'))]"
		visible = "[IsMapMode('realms')]"
		
		parentanchor = bottom|hcenter
		position = { -66 -8 }

		ignoreinvisible = yes
		alwaystransparent = no

		vbox = {
			set_parent_size_to_minimum = yes
			
			pod_resource_bar_glamour = {
				visible = "[GetScriptedGui('glamour_meters_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			
			pod_resource_bar_pathos = {
				visible = "[GetScriptedGui('pathos_meters_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			
			pod_resource_bar_sekhem = {
				visible = "[GetScriptedGui('sekhem_meters_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			
			pod_resource_bar_resolve = {
				visible = "[GetScriptedGui('resolve_meters_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			
			pod_resource_bar_yin = {
				visible = "[GetScriptedGui('yin_meters_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			
			pod_resource_bar_yang = {
				visible = "[GetScriptedGui('yang_meters_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			
			pod_resource_bar_gnosis = {
				visible = "[GetScriptedGui('gnosis_meters_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			
			pod_resource_bar_rage = {
				visible = "[GetScriptedGui('rage_meters_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			
			pod_resource_bar_masquerade = {
				visible = "[GetScriptedGui('masquerade_bar_gui').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
			
			pod_resource_bar_blood = {
				visible = "[GetScriptedGui('blood_hunger_show').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}
	}

	window = {
		parentanchor = center
		visible = "[GetScriptedGui('resource_hint_shown').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

		using = Window_Background
		using = Window_Decoration_Spike
	
		state = {
			name = _show
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
			position = "[DecisionDetailView.GetDynamicPosition]"
		}
	
		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
		}

		vbox = {
			using = Window_Margins
			#layoutpolicy_horizontal = expanding
			set_parent_size_to_minimum = yes
	
			header_pattern_interaction = {
				layoutpolicy_horizontal = expanding
	
				blockoverride "header_text" {
					text = "[GetPlayer.Custom('PODHintWindow')]"
				}
	
				blockoverride "button_close"
				{
					onclick = "[GetScriptedGui('resource_hint_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}

			vbox = {
				using = Background_Inset
				layoutpolicy_horizontal = expanding

				resource_hints_blood = {
					visible = "[GetScriptedGui('blood_hunger_hint').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}
		}
	}
}

types ResourceHintTypes
{
	type resource_hints_blood = vbox
	{
		layoutpolicy_horizontal = expanding

		min_width = 550
		margin = { 16 16 }

		# Hunt in Capital Journey (only visible for Vampires)
		vbox = {
			layoutpolicy_horizontal = expanding
			visible = "[GetScriptedGui('hunt_in_capital_requirements').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

			# Journey already in progress
			vbox = {
				layoutpolicy_horizontal = expanding
				visible = "[GetScriptedGui('blood_hunger_hint_journey').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

				resource_hints_text = {
					text = POD_hunger_window_hunt_in_capital_inprogress
				}
			}

			# Journey button
			vbox = {
				layoutpolicy_horizontal = expanding
				visible = "[Not(GetScriptedGui('blood_hunger_hint_journey').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
				ignoreinvisible = yes

				resource_hints_text = {
					text = POD_hunger_window_hunt_in_capital
				}
				
				widget = { size = { 16 16 } }
				
				button_journey_entry = {
					datacontext = "[GetPlayer.MakeScope.Var('hunt_in_capital_story')]"
					visible = "[GetScriptedGui(Concatenate(Scope.Var('journey_type').GetFlagName,'_requirements')).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					enabled = "[GetScriptedGui('POD_journey_requirements').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('journey',Scope.Story.MakeScope).End)]"
					layoutpolicy_horizontal = expanding
					
					onclick = "[GetScriptedGui('POD_journey_detail_open').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('journey',Scope.Story.MakeScope).End)]"
					onclick = "[GetScriptedGui('resource_hint_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
					down = "[GetScriptedGui('POD_journey_is_selected').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('journey',Scope.Story.MakeScope).End)]"
					
					tooltip = "POD_journey_GUI_tooltip"
				}
			}

			widget = { size = { 16 16 } }
	
			divider_light = {
				layoutpolicy_horizontal = expanding
			}
		}

		# Herd interactions
		vbox = {
			layoutpolicy_horizontal = expanding

			# Drink from a herd member
			vbox = {
				layoutpolicy_horizontal = expanding
				visible = "[GetScriptedGui('blood_hunger_hint_herd_drink').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

				hbox = {
					layoutpolicy_horizontal = expanding
					visible = "[And( GetScriptedGui('blood_hunger_hint_herd_drink').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End), GetScriptedGui('blood_hunger_hint_herd_drink').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End) )]"

					expand = {}

					portrait_head_small = {
						datacontext = "[GetPlayer.MakeScope.Var('suggested_herdmember').Char]"
						
						blockoverride "opinion_box" {
							visible = no
						}
						blockoverride "status_icons" {
							visible = no
						}
					}

					widget = { size = { 16 16 } }

					vbox = {
						resource_hints_text = {
							text = POD_hunger_window_herd_drink
						}

						widget = { size = { 16 16 } }

						button_standard = {
							text = "POD_drink_herd"
							onclick = "[GetPlayer.MakeScope.Var('suggested_herdmember').Char.OpenPlayerInteraction('POD_drink_herd')]"
							#onclick = "[GetScriptedGui('resource_hint_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
					}

					expand = {}
				}

				# None of your herd members have blood left
				resource_hints_text = {
					text = POD_hunger_window_herd_drink_noblood
					visible = "[Not( GetScriptedGui('blood_hunger_hint_herd_drink').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End) )]"
				}
			}

			# You don't have any herd members yet
			vbox = {
				layoutpolicy_horizontal = expanding
				visible = "[Not( GetScriptedGui('blood_hunger_hint_herd_drink').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End) )]"

				# Herdify button
				hbox = {
					layoutpolicy_horizontal = expanding
					visible = "[GetScriptedGui('blood_hunger_hint_herd_mortal').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

					expand = {}

					hbox = {
						resource_hints_alert_button = {
							texture = "[GetImportantActionType('action_can_add_herd_alert').GetIcon]"
							#texture = "gfx/interface/icons/alerts/action_can_add_herd_alert.dds"
							onclick = "[GetScriptedGui('blood_hunger_hint_herd_mortal').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							onclick = "[GetScriptedGui('resource_hint_close').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						}
	
						widget = { size = { 16 16 } }
	
						resource_hints_text = {
							text = POD_hunger_window_herdify
						}

					}

					expand = {}
				}

				resource_hints_text = {
					visible = "[Not( GetScriptedGui('blood_hunger_hint_herd_mortal').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End) )]"
					text = POD_hunger_window_herdify_invalid
				}
			}
		}
	}

	type resource_hints_text = text_multi
	{
		max_width = 500
		layoutpolicy_horizontal = expanding
		align = center
		autoresize = yes
	}

	type resource_hints_alert_button = button
	{
		framesize = { 144 144 }
		size = { 72 72 }

		gfxtype = buttongfx
		effectname = "NoHighlight"
		shaderfile = "gfx/FX/pdxgui_pushbutton.shader"
		button_ignore = none

		modify_texture = {
			name = "mask"
			texture = "gfx/interface/component_masks/mask_alert_solid.dds"
			blend_mode = mask
		}

		modify_texture = {
			name = "glow"
			texture = "gfx/interface/component_effects/effect_shimmer.dds"
			blend_mode = colordodge
			translate_uv = { 0.2 0.2 }
		}

		state = {
			trigger_on_create = yes
			name = _show
			next = shimmer
			duration = 0.2

			modify_texture = {
				name = "glow"
				translate_uv = { 1 -1 }
			}
		}

		state = {
			name = shimmer
			next = pause
			duration = 1.2

			bezier = { 0 0.9 1 0.4 }

			modify_texture = {
				name = "glow"
				translate_uv = { -1 1 }
			}
		}

		state = {
			name = pause
			next = shimmer
			duration = 0
			delay = 5

			modify_texture = {
				name = "glow"
				translate_uv = { 1 -1 }
			}
		}

		state = {
			name = _mouse_enter
			duration = 0.05
			frame = 2
			start_sound = {soundeffect = "event:/SFX/UI/Notifications/Alerts/sfx_ui_notification_alert_action_oversound"}
		}

		state = {
			name = _mouse_leave
			duration = 0.1
			frame = 1
		}

		state = {
			name = _mouse_press
			duration = 0.25
			frame = 3
			start_sound = {soundeffect = "event:/SFX/UI/Notifications/Alerts/sfx_ui_notification_alert_action_mouse_press"}
		}

		state = {
			name = _mouse_release
			duration = 0.25
			frame = 2
			start_sound = {soundeffect = "event:/SFX/UI/Notifications/Alerts/sfx_ui_notification_alert_action_mouse_release"}
		}
	}
}