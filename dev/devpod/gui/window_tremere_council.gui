window = {
	name = "tremere_council"
	#position = { 0 0 }
	parentanchor = center

	layer = windows_layer
	size = { 1500 1060 }
	
	#state = {
	#	name = _show
	#	using = Animation_FadeIn_Quick
	#	using = Sound_WindowShow_Standard
	#}
	
	#state = {
	#	name = _hide
	#	using = Animation_FadeOut_Quick
	#	using = Sound_WindowHide_Standard
	#}
	using = Window_Background
	using = Window_Decoration_Spike

	visible = "[GetVariableSystem.Exists( 'tremere_council_open' )]"
	
	background = {	
	texture = "gfx/interface/illustrations/loading_screens/castle.dds"
	}
	
	vbox = {
		layoutpolicy_horizontal = expanding
		#margin_left = 10
		#margin_bottom = 20
		#position = { 0 0}
		#spacer = {
		#	size = { 0 14 }
		#}
		header_pattern_interaction = {
			layoutpolicy_horizontal = expanding
			max_width = 1450
			#position = { 0 0 }
			blockoverride "header_text"
			{
				text = tremere_council_tab_tt
			}
			
			blockoverride "button_close"
			{
				onclick = "[GetVariableSystem.Toggle('tremere_council_open')]"
			}
		}
		hbox = {
			parentanchor = top|left		
			text_single = {
				max_width = 1000
				text = tremere_council_intro
				#margin_right = 20
				using = Font_Size_Medium
			}
		}
		vbox_character_list = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			max_width = 1400
		
			blockoverride "sort_buttons" {}
			blockoverride "character_count" {}
			blockoverride "scrollbox_margins" {
				margin_right = 10
				margin_top = 6
				
			}

			blockoverride "container_implementation" {
				dynamicgridbox = {
					name = "characters_grid"

					datamodel = "[GetGlobalList('tremere_council_list')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					ignoreinvisible = yes
					datamodel_wrap = 2
					flipdirection = yes	
					#spacing = 10
					
					item = {
					
						widget = {
							size = { 750 200 } 
							#visible = "[Or(GetVariableSystem.Exists( 'web_out_of_range_chars' ),GetScriptedGui('web_of_knives_list_gui_dip_range').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Scope.GetCharacter.MakeScope ).End) )]"
							datacontext = "[Scope.GetCharacter]"
							hbox = {
								layoutpolicy_horizontal = expanding
								margin_right = 10
								spacing = 5

								background = {
									using = Background_Area_With_Header
								}
								vbox = {
									margin_left = 10
									#text_single = {
									#	text = WoK_target_loc
									#	
									#	using = Font_Size_Medium
									#}
									portrait_shoulders = {}
									
								}
								
								vbox = {
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									vbox = {
										layoutpolicy_horizontal = expanding
										
										text_single = {
											name = "name"
											layoutpolicy_horizontal = expanding
											autoresize = no
											text = "[Character.GetUINameNoTooltip]"
											using = Font_Size_Medium
											align = nobaseline
											fontsize_min = 14
											#margin_right = 10
											#margin_bottom = 20
											#max_width = 400
											#min_width = 400
										}

										hbox = {
											layoutpolicy_horizontal = expanding
											text_single = {
												text = council_influence_loc
												using = Font_Size_Medium
												#margin_left = 500
											}									
											text_single = {
												text = "[Character.MakeScope.Var('influence_inner_council').GetValue|0]"												align = nobaseline
												using = Font_Size_Medium
												margin_bottom = -5
												margin_left = -250
											}
										}
										
										
									}
									#hbox = {
									#	#vbox = {
									#	#	text_single = {
									#	#		text = WoK_reward_loc
									#	#		margin_right = 20
									#	#		using = Font_Size_Medium
									#	#	}
									#	#	text_single = {
									#	#		text = "[gold_i|E][Character.MakeScope.Var('web_gold_reward').GetValue|0]"
									#	#		margin_right = 20
									#	#		using = Font_Size_Medium
									#	#	}
									#	#}
									#	dynamicgridbox = {
									#		flipdirection = yes
									#		datamodel = "[Character.MakeScope.GetList('contractor')]"
									#		item = {
									#			vbox = {
									#
									#				text_single = {
									#					text = "[Localize('WoK_contractor_loc')] [Scope.GetCharacter.GetFirstNameNoTooltip]"
									#					margin_right = 20
									#					#autoresize = no
									#					layoutpolicy_horizontal = expanding
									#					
									#					align = nobaseline
									#					fontsize_min = 14
									#					
									#				}
									#				
									#				portrait_head_small = {
									#					datacontext = "[Scope.GetCharacter]"
									#					name = "contractor_portrait"
									#					blockoverride "opinion_box" {}
									#					blockoverride "status_icons" {}
									#				}
									#			}
									#		}
									#	}
									#	
									#	
									#}
									
								}
							}
						}
					}
				}
			}
		}
	}
	button_primary = {
		size = { 380 50 }
		parentanchor = left|bottom
		position = { 550 0 }
		#icon = {
		#	texture = "gfx/interface/buttons/button_hold_court_bg.dds"
		#}
		text = "Council_Session"
		tooltip = "window_council_session_tooltip"
		#enabled = "[GetScriptedGui('council_session').IsValid(GuiScope.SetRoot(Character.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
		#onclick = "[GetScriptedGui('council_session').Execute(GuiScope.SetRoot(Character.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
		enabled = "[GetScriptedGui('council_session').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		onclick = "[GetScriptedGui('council_session').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		alwaystransparent = no
		layoutpolicy_vertical = expanding
	}	
}	
	


