### TITLE WINDOW

window = {
	name = "title_view_window"
	size = { 628 100% }

	movable = no
	allow_outside = yes
	alwaystransparent = yes
	layer = middle

	state = {
		name = _show
		position = { 0 0 }
		on_start = "[GetVariableSystem.Clear( 'display_allegiance' )]"
		on_start = "[GetVariableSystem.Set( 'hide_bottom_left_HUD', 'true' )]"

		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
	}

	state = {
		name = _hide
		position_x = -60
		on_start = "[GetVariableSystem.Clear( 'hide_bottom_left_HUD' )]"

		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}

	######################################################
	#################### TITLE VIEW ######################
	######################################################
	vbox = {
		datacontext = "[TitleViewWindow.GetTitle]"

		using = Window_Margins_Sidebar

		### Widget to push down window when viewing a Clerical Region or Holy Order title
		widget = {
			visible = "[Or( Title.HasClericalRegion, Title.IsHolyOrder )]"
			layoutpolicy_vertical = expanding
			layoutstretchfactor_vertical = 2
		}

		### Window decoration that is only being used when viewing a Clerical Region or Holy Order title
		widget = {
			visible = "[Or( Title.HasClericalRegion, Title.IsHolyOrder )]"
			size = { 612 22 }

			icon = {
				parentanchor = bottom|hcenter
				position = { 0 5 }
				size = { 680 100% }
				spriteType = Corneredtiled
				spriteborder = { 60 0 }
				texture_density = 2
				texture = "gfx/interface/skinned/component_decoration/decoration_frame_top.dds"
			}

			icon = {
				parentanchor = hcenter
				position = { 0 -33 }
				size = { 142 60 }
				texture = "gfx/interface/skinned/component_decoration/decoration_frame_top_center.dds"
			}
		}

		vbox = {
			name = "title_view_main_tab"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			layoutstretchfactor_vertical = 1

			alwaystransparent = no

			using = Window_Background_Sidebar
			using = Window_Margins_Sidebar

			state = {
				name = _show
				using = Animation_FadeIn_Quick
			}

			state = {
				name = _hide
				using = Animation_FadeOut_Quick
			}

			### HEADER ###
			hbox = {
				name = "header_area"
				layoutpolicy_horizontal = expanding

				background = {
					using = Background_Header
					margin = { 4 0 }
					margin_bottom = 20
				}

				background = {
					using = Background_Header_Pattern
					margin = { 4 0 }
					margin_bottom = 20
				}

				vbox = {
					layoutpolicy_vertical = expanding
					margin = { 5 0 }

					#Different sized widgets so crowns of each tier align with the header
					#Hegemony and Empire Titles
					widget = {
						visible = "[GreaterThanOrEqualTo_int32(Title.GetTierFrame, '(int32)6')]"
						size = { 96 150 }

						coa_title_big_crown = {
							datacontext = "[TitleViewWindow.GetTitle]"
							parentanchor = bottom|hcenter
							scale = 0.9

							tooltip = "[Title.GetCOADeJureTooltip]"

							icon = {
								name = "has_laws"
								visible = "[And( InDebugMode, TitleViewWindow.GetTitle.HasLaws) ]"
								parentanchor = bottom|right
								position = { -5 0 }
								size = { 42 42 }
								texture = "gfx/interface/icons/title_status/icon_title_law.dds"
							}
						}
					}

					# Kingdom Titles
					widget = {
						visible = "[EqualTo_int32(Title.GetTierFrame, '(int32)5')]"
						size = { 96 142 }

						coa_title_big_crown = {
							datacontext = "[TitleViewWindow.GetTitle]"
							parentanchor = bottom|hcenter
							scale = 0.9

							tooltip = "[Title.GetCOADeJureTooltip]"

							icon = {
								name = "has_laws"
								visible = "[And( InDebugMode, TitleViewWindow.GetTitle.HasLaws) ]"
								parentanchor = bottom|right
								position = { -5 0 }
								size = { 42 42 }
								texture = "gfx/interface/icons/title_status/icon_title_law.dds"
							}
						}
					}

					# Duchy Titles
					widget = {
						visible = "[EqualTo_int32(Title.GetTierFrame, '(int32)4')]"
						size = { 96 133 }

						coa_title_big_crown = {
							datacontext = "[TitleViewWindow.GetTitle]"
							parentanchor = bottom|hcenter
							scale = 0.9

							tooltip = "[Title.GetCOADeJureTooltip]"

							icon = {
								name = "has_laws"
								visible = "[And( InDebugMode, TitleViewWindow.GetTitle.HasLaws) ]"
								parentanchor = bottom|right
								position = { -5 0 }
								size = { 42 42 }
								texture = "gfx/interface/icons/title_status/icon_title_law.dds"
							}
						}
					}

					# County Titles
					widget = {
						visible = "[EqualTo_int32(Title.GetTierFrame, '(int32)3')]"
						size = { 96 128 }

						coa_title_big_crown = {
							datacontext = "[TitleViewWindow.GetTitle]"
							parentanchor = bottom|hcenter
							scale = 0.9

							tooltip = "[Title.GetCOADeJureTooltip]"

							icon = {
								name = "has_laws"
								visible = "[And( InDebugMode, TitleViewWindow.GetTitle.HasLaws) ]"
								parentanchor = bottom|right
								position = { -5 0 }
								size = { 42 42 }
								texture = "gfx/interface/icons/title_status/icon_title_law.dds"
							}
						}
					}

					# Barony Titles
					widget = {
						visible = "[EqualTo_int32(Title.GetTierFrame, '(int32)2')]"
						size = { 96 110 }

						coa_title_big_crown = {
							datacontext = "[TitleViewWindow.GetTitle]"
							parentanchor = bottom|hcenter
							scale = 0.9

							tooltip = "[Title.GetCOADeJureTooltip]"

							icon = {
								name = "has_laws"
								visible = "[And( InDebugMode, TitleViewWindow.GetTitle.HasLaws) ]"
								parentanchor = bottom|right
								position = { -5 0 }
								size = { 42 42 }
								texture = "gfx/interface/icons/title_status/icon_title_law.dds"
							}
						}
					}

					expand = {}
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					vbox = {
						datacontext = "[TitleViewWindow.GetTitle]"
						layoutpolicy_horizontal = expanding
						ignoreinvisible = yes
						spacing = 5

						hbox = {
							layoutpolicy_horizontal = expanding

							vbox = {
								margin_top = 5

								hbox = {
									layoutpolicy_horizontal = expanding
									ignoreinvisible = yes
									spacing = 5

									text_multi = {
										text = "[TitleViewWindow.GetTitle.GetNameNoTooltip|U]"
										default_format = "#high"
										max_width = 325
										autoresize = yes
										using = Font_Size_Big
									}

									button_edit_text = {
										visible = "[TitleViewWindow.GetTitle.CanPlayerCustomizeTitle]"

										onclick = "[OpenTitleCustomizationWindow(TitleViewWindow.GetTitle)]"

										tooltip = "CUSTOMIZE_TITLE"
									}

									expand = {}
								}

								vbox_title_type_text = {
									datacontext = "[GuiScope.SetRoot( TitleViewWindow.GetTitle.MakeScope ).GetScriptValueBreakdown( 'appointment_title_value' )]"
									layoutpolicy_horizontal = expanding

									text_single = {
										visible = "[TitleViewWindow.HasMeritPoolData]"
										layoutpolicy_horizontal = expanding

										text = "[TitleViewWindow.GetMeritPoolDescription]"
									}

									using = tooltip_ne
									tooltip_visible = "[ValueBreakdown.HasTooltip]"
									tooltipwidget = {
										visible = "[ValueBreakdown.HasTooltip]"

										widget_value_breakdown_tooltip = {
											blockoverride "header" {
												text_label_left = {
													layoutpolicy_horizontal = expanding
													text = prominence_breakdown_header
													default_format = "#T"
												}
											}
										}
									}
								}
							}

							watch_window_button = {
								size = { 60 40 }
								onclick = "[AddWatchWindow( TitleViewWindow.GetTitle.MakeScope )]"
							}

							expand = {}

							vbox = {
								layoutpolicy_vertical = expanding

								buttons_window_control = {
									blockoverride "extra_buttons" {
										button_pin = {
											shortcut = "pin"
											tooltip = "TITLE_PIN_TT"
											onclick = "[Title.ToggleTitlePinned]"
											visible = "[Not(Title.IsPinned)]"
										}
										button_unpin = {
											shortcut = "pin"
											tooltip = "TITLE_PIN_TT"
											onclick = "[Title.ToggleTitlePinned]"
											visible = "[Title.IsPinned]"
										}
									}

									blockoverride "button_close"
									{
										onclick = "[TitleViewWindow.Close]"
										onclick = "[TitleViewWindow.CloseHistory]"
										onclick = "[TitleViewWindow.CloseClaimants]"
									}

									blockoverride "button_back"
									{
										visible = "[HasViewHistory]"
										onclick = "[OpenFromViewHistory]"
										tooltip = "[GetViewHistoryTooltip]"
									}

									blockoverride "button_me"
									{
										onclick = "[DefaultOnCharacterClick(GetPlayer.GetID)]"
									}
								}

								expand = {}
							}
						}

						divider_light = {
							layoutpolicy_horizontal = expanding
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							margin_right = 10
							spacing = 5

							text_single = {
								visible = "[And( Title.IsHolyOrder, Not( Title.HasHolder ) )]"
								layoutpolicy_horizontal = expanding
								text = "TV_NOT_CREATED"
							}

							text_single = {
								visible = "[And( Title.HasClericalRegion, Not( Title.HasHolder ) )]"
								layoutpolicy_horizontal = expanding
								text = "TV_NO_HOLDER"
							}

							text_single = {
								datacontext = "[Title.GetFaction]"
								visible = "[Title.HasFaction]"
								text = "TITLE_VIEW_FACTION"
								max_width = 280
							}

							hbox = {
								name = "title_view_rite_button_tutorial_uses_this"

								background = {
									margin = { 8 8 }
									using = Background_Area
									modify_texture = {
										name = "mask"
										texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
										spriteType = Corneredstretched
										blend_mode = alphamultiply
										alpha = 0.7
										mirror = horizontal
									}

								}

								layoutpolicy_horizontal = expanding

								datacontext = "[Title.GetHolder.GetRite.GetFaith]"
								visible = "[And( Or( Title.HasClericalRegion, Title.IsHolyOrder ), Title.HasHolder )]"
								spacing = 5

								button_rite_icon = {
									datacontext = "[Title.GetHolder.GetRite]"
									size = { 45 45 }
								}

								vbox = {
									layoutpolicy_vertical = expanding

									text_single = {
										layoutpolicy_horizontal = expanding

										state = {
											name = "faith_view_refresh"
											using = Animation_Refresh_FadeOut
										}

										state = {
											using = Animation_Refresh_FadeIn
										}

										text = "TITLE_VIEW_RITE_NAME"
										align = nobaseline
									}

									hbox = {
										layoutpolicy_horizontal = expanding
										spacing = 10

										text_single = {
											name = "my_clerical_region"
											visible = "[And( Title.HasClericalRegion, Or( TitleViewWindow.IsPlayerInRegion, Title.GetHolder.IsLocalPlayer ) )]"
											layoutpolicy_horizontal = expanding

											text = "TV_MY_CLERICAL_REGION"
										}
										
										text_single = {
											name = "holder_treasury"
											visible = "[Title.GetHolder.HasTreasury]"
											layoutpolicy_horizontal = expanding

											tooltip = "[Title.GetHolder.GetTreasuryTooltipWithBalance]"
											using = tooltip_ne

											text = "TITLE_VIEW_HOLDER_TREASURY"
											align = nobaseline
										}

										expand = {}
									}

									text_single = {
										datacontext = "[Title.GetHolyOrder]"
										visible = "[Title.IsHolyOrder]"

										layoutpolicy_horizontal = expanding

										state = {
											name = "faith_view_refresh"
											using = Animation_Refresh_FadeOut
										}

										state = {
											using = Animation_Refresh_FadeIn
										}

										text = "TITLE_VIEW_HOLY_ORDER_HEADING"
										align = nobaseline
									}
								}
								expand = {}
							}

							vbox = {
								visible = "[Not( Title.HasClericalRegion )]"
								layoutpolicy_vertical = expanding

								text_single = {
									name = "is_created"
									visible = "[Not(Title.HasHolder)]"
									layoutpolicy_horizontal = expanding
									text = "TV_NOT_CREATED"
								}

								vbox = {
									name = "existing_title"
									visible = "[Title.HasHolder]"
									layoutpolicy_horizontal = expanding
									ignoreinvisible = yes
									spacing = 5

									text_single = {
										name = "my_title"
										visible = "[EqualTo_uint32( Title.GetHolder.GetID, GetPlayer.GetID )]"
										layoutpolicy_horizontal = expanding

										text = "TV_MY_TITLE"
										max_width = 300
									}

									text_single = {
										visible = "[And(And(NotEqualTo_uint32( Title.GetHolder.GetID, GetPlayer.GetID ), Not(GetPlayer.HasClaimOnTitle(TitleViewWindow.GetTitle ))),Title.CanHaveClaim)]"
										layoutpolicy_horizontal = expanding

										text = "TV_NO_CLAIM"
										max_width = 300
									}

									text_multi = {
										name = "have_claim"
										visible = "[And(NotEqualTo_uint32( Title.GetHolder.GetID, GetPlayer.GetID ), GetPlayer.HasClaimOnTitle(TitleViewWindow.GetTitle ))]"
										layoutpolicy_horizontal = expanding

										text = "[Title.GetClaimStateFor(GetPlayer)]"
										align = nobaseline
										minimumsize = { 200 50 }
										max_width = 300
										autoresize = yes
									}

									text_single = {
										visible = "[Title.GetHolder.GetTopLiege.HasRealmLaw('top_liege_not_redirected_to_border_wars_law')]"
										layoutpolicy_horizontal = expanding

										text = "TITLE_VIEW_DISABLED_BORDER_WARS"
										align = nobaseline
										max_width = 340
										fontsize_min = 9
									}

									text_multi = {
										visible = "[Title.GetHolder.GetTopLiege.HasRealmLaw('top_liege_redirected_to_border_wars_law')]"
										layoutpolicy_horizontal = expanding

										text = "TITLE_VIEW_ENABLED_BORDER_WARS"
										align = nobaseline
										autoresize = yes
										max_width = 340
										fontsize_min = 9
									}
								}

								expand = {}
							}

							spacer = { size = { 12 0 } }

							expand = {}

							flowcontainer = {
								direction = vertical
								ignoreinvisible = yes
								spacing = 3

								button_sidepanel_right = {
									name = "view_claimants"
									visible = "[And(Title.CanHaveClaim, Not(TitleViewWindow.GetTitle.GetHolder.GetGovernment.IsType('landless_adventurer_government') ) )]"
									parentanchor = right

									enabled = "[GreaterThan_int32( TitleViewWindow.GetNumberOfClaimants, '(int32)0' )]"
									onclick = "[TitleViewWindow.ToggleClaimants]"

									tooltip = "TITLE_CLAIMANTS_TOOLTIP"

									blockoverride "button_text"
									{
										text = "TITLE_VIEW_CLAIMANTS"
										max_width = 110
									}
								}

								button_sidepanel_right = {
									name = "title history"
									visible = "[And( Not( Title.IsBarony ), Not( Title.HasFaction ) )]"
									parentanchor = right

									onclick = "[TitleViewWindow.ToggleHistory]"

									tooltip = "SHOW_TITLE_HISTORY"

									blockoverride "button_text"
									{
										text = "TITLE_HISTORY"
										max_width = 110
									}
								}

								text_single = {
									visible = "[Not(Title.CanHaveClaim)]"
									parentanchor = right

									text = "TITLE_VIEW_NO_CLAIMANTS"
									align = right|nobaseline
									default_format = "#weak"
									max_width = 120
									fontsize_min = 5

									tooltip = "TITLE_VIEW_NO_CLAIMANTS_TOOLTIP"
								}
							}
						}

						### COUNTY PART OF ####
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 10
							margin_right = 10
							margin_bottom = 10

							hbox = {
								spacing = 5
								margin_top = 10

								text_single = {
									visible = "[DataModelHasItems(TitleViewWindow.GetLiegeItems)]"
									text = "TITLE_VIEW_DE_JURE_PART_OF"
									max_width = 180
									align = nobaseline
								}

								fixedgridbox = {
									name = "dejure_liege_grid"
									datamodel = "[TitleViewWindow.GetLiegeItems]"
									flipdirection = yes
									addcolumn = 40
									addrow = 40
									maxverticalslots = 1
									setitemsizefromcell = yes

									item = {
										widget = {
											size = { 40 50 }

											coa_title_tiny_crown = {
												datacontext = "[TitleItem.GetTitle]"
												parentanchor = center

												using = tooltip_se
											}
										}
									}
								}
							}

							expand = {}

							vbox = {
								visible = "[And(TitleViewWindow.GetTitle.HasHolder,TitleViewWindow.GetTitle.IsLanded)]"
								spacing = 5

								text_single = {
									layoutpolicy_horizontal = expanding

									align = center
									max_width = 130
									raw_text = "[TitleViewWindow.GetTypeOfLanded]: "
								}

								button_tertiary = {
									datacontext = "[TitleViewWindow.GetHolding]"

									onclick = "[TitleViewWindow.GoToHolding]"

									size = { 120 30 }
									text = "[Holding.GetProvince.GetNameNoTooltip]"
									max_width = 130

									tooltip = "TITLE_VIEW_GO_TO_HOLDING"
								}
							}
						}
					}

					expand = {}
				}
			}

			### Rulers in region label and portraits
			vbox = {
				visible = "[And( DataModelHasItems( TitleViewWindow.GetRealmsInRegion ), Title.HasHolder )]"
				layoutpolicy_horizontal = expanding

				margin = { 5 0 }
				margin_bottom = 10
				spacing = 5

				background = {
					using = Background_Area
				}

				text_label_center = {
					text = "TITLE_VIEW_RULERS_IN_REGION"
				}

				widget = {
					layoutpolicy_horizontal = expanding

					scrollbox = {
						layoutpolicy_horizontal = expanding
						resizeparent = yes
						maximumsize = { -1 220 }

						blockoverride "scrollbox_content" {
							set_parent_size_to_minimum = yes

							widget = {
								size = { 550 0 } # min width
							}

							fixedgridbox = {
								visible = "[Title.HasClericalRegion]"
								layoutpolicy_horizontal = expanding
								addcolumn = 90
								addrow = 95
								flipdirection = yes
								datamodel_wrap = 6

								datamodel = "[TitleViewWindow.GetRealmsInRegion]"

								item = {
									portrait_head_small = {}
								}
							}
						}
					}
				}
			}

			spacer = {
				visible = "[TitleViewWindow.GetTitle.GetHolder.HasDomicile]"
				size = { 10 10 }
			}

			vbox = {
				datacontext = "[Title.GetHolder]"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				### TABS ###
				hbox = {
					name = "tabs"
					visible = "[Not(IsDataModelEmpty(TitleViewWindow.GetTitleAllegianceVassals))]"
					layoutpolicy_horizontal = expanding

					button_tab = {
						name = "show_vassals"
						layoutpolicy_horizontal = expanding

						text = "TITLE_VIEW_DE_JURE"
						default_format = "#weak"

						down = "[Not( GetVariableSystem.Exists( 'display_allegiance' ) )]"
						onclick = "[GetVariableSystem.Clear( 'display_allegiance' )]"
					}

					button_tab = {
						name = "show_allegiance"
						layoutpolicy_horizontal = expanding

						text = "TITLE_VIEW_VASSALS"
						default_format = "#weak"

						down = "[GetVariableSystem.Exists( 'display_allegiance' )]"
						onclick = "[GetVariableSystem.Set( 'display_allegiance', 'true' )]"
					}
				}

				vbox = {
					name = "dejure_tab_contents"
					datacontext = "[TitleViewWindow.GetTitle]"
					visible = "[And(DataModelHasItems(TitleViewWindow.GetVassalGroupItems), Not(Or(GetVariableSystem.Exists( 'display_allegiance' ), Or(Title.IsMercenaryCompany,Title.IsHolyOrder))))]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					margin_top = 15
					spacing = 10

					text_label_center = {
						text = "[TitleViewWindow.GetDeJureDescription]"
						max_width = 550
					}

					scrollbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						minimumsize = { 0 300 }

						background = {
							using = Background_Area_Holding
						}

						blockoverride "scrollbox_content" {
							vbox = {
								layoutpolicy_horizontal = expanding
								datamodel = "[TitleViewWindow.GetVassalGroupItems]"
								spacing = 10

								item = {
									vbox = {
										layoutpolicy_horizontal = expanding

										vbox = {
											datamodel = "[DeJureVassalGroupItem.GetTitleItems]"
											layoutpolicy_horizontal = expanding
											spacing = 5

											text_single = {
												layoutpolicy_horizontal = expanding
												text = "[DeJureVassalGroupItem.GetOwnedBy]"
												default_format = "#low"
												max_width = 600
												margin = { 0 10 }
											}

											item = {
												button_standard_list = {
													datacontext = "[TitleItem.GetTitle]"
													layoutpolicy_horizontal = expanding
													minimumsize = { 0 60 }
													onclick = "[DefaultOnCoatOfArmsClick(Title.GetID)]"
													onrightclick = "[DefaultOnCoatOfArmsRightClick(Title.GetID)]"
													button_ignore = none

													tooltipwidget = {
														using = LandedTitleTooltip
													}

													coa_title_tiny_crown = {
														parentanchor = left|vcenter
														position = { 8 -3}
													}

													hbox = {
														margin_left = 50
														spacing = 5

														text_single = {
															layoutpolicy_horizontal = expanding
															text = "[Title.GetNameNoTooltip|U]"
															default_format = "#high"
															max_width = 600
															align = nobaseline
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}

				scrollbox = {
					name = "tab_contents_empty"
					visible = "[And(Not(Or(DataModelHasItems(TitleViewWindow.GetVassalGroupItems), GetVariableSystem.Exists( 'display_allegiance' ))), Not(Or(Title.HasClericalRegion, Title.IsHolyOrder)))]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					background = {
						using = Background_Area_Holding
					}

					blockoverride "scrollbox_content" {
						vbox = {
							layoutpolicy_vertical = expanding

							container = {
								visible = "[Not(DataModelHasItems(TitleViewWindow.GetVassalGroupItems))]"

								text_single = {
									visible = "[Not(TitleViewWindow.GetTitle.IsBarony)]"
									text = "TITLE_VIEW_TITULAR"
									default_format = "#weak"
								}

								text_single = {
									visible = "[TitleViewWindow.GetTitle.IsBarony]"
									text = "TITLE_VIEW_BARONY_NO_DEJURE"
