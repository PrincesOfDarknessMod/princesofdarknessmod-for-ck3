									expand = {}
								}
							}

							expand = {}
						}
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 10

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 5
							margin = { 10 5 }

							# you can't grant
							text_multi = {
								visible = "[Or( Not( Faith.HasParameterByKey( 'has_clerical_regions' ) ), Nor( ObjectsEqual( Faith.GetReligiousHead.Self, GetPlayer.Self ), And( Not( Faith.GetReligiousHead.IsValid ), ObjectsEqual( Faith.GetMainRite.GetHeadOfRite.Self, GetPlayer.Self ) ) ) )]"
								layoutpolicy_horizontal = expanding
								autoresize = yes
								max_width = 550
								margin_bottom = 15

								text = "TITLE_VIEW_CANNOT_GRANT_CLERICAL_REGION"
								default_format = "#low"
							}

							# you can grant
							hbox = {
								visible = "[Faith.HasParameterByKey( 'has_clerical_regions' )]"

								# you can grant it
								hbox = {
									visible = "[Or( ObjectsEqual( Faith.GetReligiousHead.Self, GetPlayer.Self ), And( Not( Faith.GetReligiousHead.IsValid ), ObjectsEqual( Faith.GetMainRite.GetHeadOfRite.Self, GetPlayer.Self ) ) )]"
									layoutpolicy_horizontal = expanding

									text_multi = {
										layoutpolicy_horizontal = expanding
										autoresize = yes
										max_width = 550

										text = "TITLE_VIEW_YOU_CAN_GRANT_CLERICAL_REGION"
										default_format = "#low"
									}
								}
							}

							expand = {}
						}

						# suggestions
						# if you are HoF or HoR of the main rite with no HoF
						vbox = {
							visible = "[Or( ObjectsEqual( Faith.GetReligiousHead.Self, GetPlayer.Self ), And( Not( Faith.GetReligiousHead.IsValid ), ObjectsEqual( Faith.GetMainRite.GetHeadOfRite.Self, GetPlayer.Self ) ) )]"
							layoutpolicy_horizontal = expanding

							spacing = 10

							text_label_left = {
								visible = "[GreaterThan_int32( PdxGuiWidget.AccessParent.FindChild('suggested').CountVisibleChildren, '(int32)0')]"
								layoutpolicy_horizontal = expanding
								text = "TITLE_VIEW_SUGGESTED_CLERGY"
							}

							vbox = {
								name = "suggested"
								layoutpolicy_horizontal = expanding
								spacing = 10

								hbox_suggested_clergy_item = {
									datacontext = "[Title.GetPreferredCapital.GetCountyData.GetCount.GetCouncillor( 'councillor_court_chaplain' )]"
									visible = "[And( Character.IsValid, Character.IsPlayerInteractionWithTargetTitleValid( 'grant_ecclesiastical_title_interaction', Title.Self ) )]"
								}

								hbox_suggested_clergy_item = {
									datacontext = "[Title.GetPreferredCapital.GetCountyData.GetCount.GetLiege.GetCouncillor( 'councillor_court_chaplain' )]"
									visible = "[And3( Character.IsValid, Title.GetPreferredCapital.GetCountyData.GetCount.HasLiege, Character.IsPlayerInteractionWithTargetTitleValid( 'grant_ecclesiastical_title_interaction', Title.Self ) )]"
								}

								hbox_suggested_clergy_item = {
									datacontext = "[Title.GetPreferredCapital.GetCountyData.GetCount.GetLiege.GetLiege.GetCouncillor( 'councillor_court_chaplain' )]"
									visible = "[And3( Character.IsValid, Title.GetPreferredCapital.GetCountyData.GetCount.GetLiege.HasLiege, Character.IsPlayerInteractionWithTargetTitleValid( 'grant_ecclesiastical_title_interaction', Title.Self ) )]"
								}
							}
						}
					}
				}

				vbox_strength_info = {
					visible = "[Title.IsMercenaryCompany]"
					datacontext = "[Title.GetMercenaryCompany]"

					blockoverride "hired_troops_knights" {
						text = "TITLE_VIEW_MERCENARY_NUMBER_OF_KNIGHTS"
					}

					blockoverride "hired_troops_soldiers" {
						text = "TITLE_VIEW_MERCENARY_NUMBER_OF_SOLDIERS"
					}

					blockoverride "strength_values" {
						value = "[CurrentAndMaxToProgressbarValueInt32( MercenaryCompany.GetCurrentSoldiers, MercenaryCompany.GetMaxSoldiers )]"
					}
				}

				#### PORTRAITS ###
				vbox_title_associated_characters = {
					visible = "[TitleViewWindow.GetTitle.HasHolder]"
					layoutpolicy_horizontal = expanding
				}

				### Hire Buttons
				vbox = {
					datacontext = "[Title.GetHolyOrder]"
					datacontext = "[TitleViewWindow.GetHiredTroopsItem]"
					visible = "[And( Title.IsHolyOrder, HolyOrder.IsMilitary )]"
					layoutpolicy_horizontal = expanding

					vbox_hired_troops_hire_buttons = {}
				}
			}
		}
	}
}

######################################################
################ TYPES AND TEMPLATES #################
######################################################


template title_view_window_side_pop_out
{
	position = { 0 80 }


	state = {
		name = _show
		using = Animation_FadeIn_Standard
		position_x = 630
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Standard
		position_x = 500
	}
}

template Background_Area_Holding
{
	texture = "[GetIllustration( 'title_holding' ).GetTexture( Title.MakeScope )]"
	alpha = 0.5
	fittype = centercrop

	modify_texture = {
		texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
		blend_mode = alphamultiply
		mirror = vertical
	}

	using = Mask_Rough_Edges
}

types Title
{
	type vbox_title_type_text = vbox {

		text_single = {
			layoutpolicy_horizontal = expanding
			visible = "[StringIsEmpty(Title.GetSpecialDescription)]"
			text = "TV_TIER_INFO"
		}

		text_multi = { # CfV PoD
			layoutpolicy_horizontal = expanding
			visible = "[Not(StringIsEmpty(Title.GetSpecialDescription))]"
			text = "[Title.GetSpecialDescription]"
			min_width = 380 # CfV PoD
			align = nobaseline
		}
	}

	type vbox_domicile_button = vbox
	{
		datacontext = "[Character.GetDomicile]"
		layoutpolicy_horizontal = expanding
		margin = { 10 0 }

		background = {
			fittype = centercrop
			alpha = 0.4
			texture = "[Domicile.GetType.GetIllustration]"
			margin = { -10 0 }

			modify_texture = {
				texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
				blend_mode = alphamultiply
			}

			modify_texture = {
				texture = "gfx/interface/component_overlay/overlay_effect.dds"
				blend_mode = overlay
			}
		}

		button_standard_clean = {
			layoutpolicy_horizontal = expanding
			size = { 0 80 }

			onclick = "[ToggleGameViewData( 'domicile', Domicile.Self )]"

			background = {
				visible = "[IsGameViewOpen( 'domicile' )]"
				using = Background_Button_Illustration
			}

			using = Background_Vignette_Button

			hbox = {
				layoutpolicy_horizontal = expanding

				vbox = {
					spacing = 0
					margin = { 10 0 }

					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					hbox = {
						name = "domicile_header"
						layoutpolicy_horizontal = expanding

						hbox = {
							layoutpolicy_horizontal = expanding

							background = {
								margin_left = 15
								margin_right = 25
								margin_top = 0
								margin_bottom = 5

								texture = "gfx/interface/component_tiles/tile_title_bg_01.dds"
								spriteType = Corneredtiled
								spriteborder = { 40 8 }
								texture_density = 2

								modify_texture = {
									name = "mask"
									texture = "gfx/interface/component_masks/mask_fade_horizontal.dds"
									blend_mode = alphamultiply
									mirror = horizontal
								}
							}

							text_single = {
								text = "[Domicile.GetMainLevelText]"
							}

							expand = {}
						}
					}

					hbox = {
						name = "domicile_construction_info"

						layoutpolicy_horizontal = expanding

						minimumsize = { 0 40 }

						vbox = {
							tooltip = "[Domicile.GetBuildingUnderConstruction.GetConstructionTooltip( Character.Self )]"
							using = tooltip_ne

							hbox = {
								text_single = {
									text = "[Domicile.GetConstructionStatusText]"
									align = nobaseline
								}
							}

							hbox = {
								layoutpolicy_horizontal = expanding

								progressbar_standard = {
									name = "building_progressbar"
									visible = "[Domicile.IsConstructing]"
									alwaystransparent = yes

									layoutpolicy_horizontal = expanding
									maximumsize = { -1 15 }
									value = "[Multiply_float( FixedPointToFloat( Domicile.GetConstructionProgress ), '(float)100' )]"
									direction = horizontal
								}

								expand = {}
							}
						}

						text_single = {
							margin_right = 52
							visible = "[And( ObjectsEqual( Domicile.GetOwner.Self, GetPlayer ), Domicile.CanUpgradeMain )]"
							text = "[Domicile.GetUpgradeMainText]"
							default_format = "#P"
						}

						expand = {}
					}
				}

				widget_access_domicile_button = {
					visible = "[And( Character.HasDomicile, ObjectsEqual( Character.Self, GetPlayer ) )]"
				}

				widget = {
					size = { 12 0 }
				}

				expand = {}
			}
		}
	}


	### Widget that displays current holder, and line of succession, at the bottom of the title view.
	#
	# Holder | Line of Succession
	# +---+  |
	# |^ ^|  | +-+ +-+ +-+ +-+ +-+
	# | _ |  | | | | | | | | | | |
	# +---+  | +-+ +-+ +-+ +-+ +-+
	#
	type vbox_title_associated_characters = vbox {
		ignoreinvisible = yes
		margin_top = 6

		hbox = {
			layoutpolicy_horizontal = expanding
			margin_left = 10
			margin_bottom = 10

			vbox_title_current_holder = {
				layoutpolicy_vertical = expanding
				datacontext = "[TitleViewWindow.GetTitle.GetHolder]"
			}

			vbox = {
				visible = "[Title.IsHolyOrder]"
				layoutpolicy_vertical = expanding
				margin = { 10 10 }
				margin_top = 42

				divider_light = {
					layoutpolicy_vertical = expanding
				}
			}

			vbox_title_line_of_succession = {
				name = "title_view_succession_tutorial_uses_this"
				visible = "[Not( Title.HasFaction )]"
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
			}

			expand = {}
		}
	}


	## Current holder of the title (displayed in the bottom left of the title view)
	type vbox_title_current_holder = vbox {

		background = {
			visible = "[And( GetPlayer.IsValid, Title.HasClericalRegion )]"
			texture = "gfx/interface/component_masks/patterns/mask_pattern_06.dds"
			spriteType = Corneredtiled
			margin_top = -30
			margin_left = 10
			alpha = 0.2
			
			modify_texture = {
				visible = "[Not( ObjectsEqual( GetPlayer.GetFaith.GetReligion, Character.GetFaith.GetReligion ) )]"
				using = Color_Grey
				blend_mode = normal
			}
			
			modify_texture = {
				visible = "[And( ObjectsEqual( GetPlayer.GetFaith.GetReligion, Character.GetFaith.GetReligion ), ObjectsEqual( GetPlayer.GetRite.Self, Character.GetRite.Self ) )]"
				using = Color_Bright_Yellow
				blend_mode = normal
			}
			
			modify_texture = {
				visible = "[And( ObjectsEqual( GetPlayer.GetFaith.GetReligion, Character.GetFaith.GetReligion ), Not( ObjectsEqual( GetPlayer.GetRite.Self, Character.GetRite.Self ) ) )]"
				using = Color_Red
				blend_mode = normal
			}

			modify_texture = {
				texture = "gfx/interface/component_masks/mask_fade_corner.dds"
				blend_mode = alphamultiply
				mirror = horizontal|vertical
			}

			modify_texture = {
				texture = "gfx/interface/component_masks/mask_rough_edges.dds"
				spriteType = Corneredtiled
				spriteborder = { 20 20 }
				texture_density = 2
				blend_mode = alphamultiply
			}
		}
		
		background = {
			visible = "[And( GetPlayer.IsValid, Not( Title.HasClericalRegion ) )]"
			texture = "gfx/interface/component_masks/patterns/mask_pattern_06.dds"
			using = Color_Blue
			spriteType = Corneredtiled
			margin_top = -30
			margin_left = 10
			alpha = 0.3

			modify_texture = {
				texture = "gfx/interface/component_masks/mask_fade_corner.dds"
				blend_mode = alphamultiply
				mirror = horizontal|vertical
			}

			modify_texture = {
				texture = "gfx/interface/component_masks/mask_rough_edges.dds"
				spriteType = Corneredtiled
				spriteborder = { 20 20 }
				texture_density = 2
				blend_mode = alphamultiply
			}
		}

		text_label_center = {
			layoutpolicy_horizontal = expanding
			text = "TITLE_VIEW_HOLDER"
			max_width = 180
		}

		# Spacer that is only visible when viewing a Clerical Region to align with Succession portraits
		spacer = {
			visible = "[Title.HasClericalRegion]"
			layoutpolicy_horizontal = expanding
			alwaystransparent = yes
			size = { 0 45 }
			allow_outside = yes
			
			widget = {
				size = { 75 75 }
				scissor = yes
				position = { -10 5 }
				
				widget = {
					size = { 100% 100% }
					background = {
						texture = "gfx/interface/component_masks/mask_arrow.dds"
						margin_bottom = 75
						mirror = horizontal
						using = Color_Black
						alpha = 0.65
					}
				}
			}
			
			button_rite_icon = {
				datacontext = "[Character.GetRite]"
				size = { 55 55 }
				position = { -5 13 }
			}
		}

		expand = {}

		hbox = {
			# Current Holder Portrait
			widget = {
				size = { 165 200 }
				allow_outside = no

				portrait_torso = {
					blockoverride "portrait_button_size"
					{
						size = { 300 280 }
					}

					blockoverride "portrait_mask"
					{
						mask = "gfx/portraits/portrait_mask_body.dds"
					}

					blockoverride "portrait_texture"
					{
						portrait_texture = "[Character.GetPortrait('environment_torso', 'camera_character_view_main', 'idle', PdxGetWidgetScreenSize(PdxGuiWidget.Self))]"
					}

					blockoverride "portrait_status_icons" {
						portrait_status_icons = {
							parentanchor = bottom|right
							position = { -15 -5 }
							scale = 0.85

							background = {
								using = Background_Area_Dark
								margin = { 2 3 }
								alpha = 0.8
							}
						}
					}
				}
			}

			# Patron small portrait, only visible for holy orders
			vbox = {
				datacontext = "[Title.GetHolyOrder]"
				visible = "[Title.IsHolyOrder]"
				layoutpolicy_vertical = expanding

				margin_top = 15

				portrait_head_small = {
					datacontext = "[HolyOrder.GetPatron]"
				}

				text_label_center = {
					text = "FAITH_VIEW_HOLY_ORDER_DETAILS_PATRON"
					max_width = 100
				}

				expand = {}

				hbox = {
					visible = "[And( Character.IsValid, Not( IsObserver ) )]"
					layoutpolicy_horizontal = expanding

					button_round = {
						onclick = "[ToggleFilteredCharacterInteractionMenu(Character.Self, 'interaction_category_religion')]"
						tooltip = "RELIGIOUS_INTERACTIONS_BUTTON_TOOLTIP"
						tooltip_visible = "[Not(IsInteractionMenuOpenForCharacterWithFilter(Character.Self, 'interaction_category_religion'))]"

						button_icon = {
							alwaystransparent = yes
							parentanchor = center
							size = { 30 30 }
							texture = "gfx/interface/icons/flat_icons/character_interactions.dds"
						}

						text_single = {
							position = { 0 3 }
							parentanchor = bottom|hcenter

							background = {
								margin = { 5 0 }
								margin_top = -5
								using = Background_Area_Dark
							}

							text = "[GetNumberOfValidInteractionsWithFilter( Character.Self, 'interaction_category_religion' )]"
							default_format = "#glow_color:{0.1,0.1,0.1,1.0}"
						}
					}
					expand = {}
				}
			}
		}

		# interactions
		hbox = {
			visible = "[Title.IsClericalRegion]"
			layoutpolicy_horizontal = expanding
			allow_outside = yes
			margin_top = 10
			margin_bottom = 4
			margin_left = 5

			spacing = 6

			expand = {}

			button_interactions_religion = {
				glow = {
					color = { 0 0 0 0.5 }
					glow_radius = 8
				}
			}

			container_single_interaction = {
				visible = "[Title.GetHolder.IsLocalPlayer]"
				blockoverride "interaction_name" {
					name = "request_ecclesiastical_title_expansion_interaction"
				}
				# we don't ask ourselves and ignore the archbishop check, jumping straight to religious authority
				blockoverride "show_archbishop" {
					visible = no
				}
				blockoverride "ignore_archbishop" {}
				blockoverride "show_interaction" {
					visible = "[And3( Character.IsPlayerInteractionShown( PdxGuiWidget.GetName ), Character.IsValid, Character.IsPlayerInteractionValid( PdxGuiWidget.GetName ) )]"
				}
			}

			button_round_interaction = {
				name = "expand_ecclesiastical_title_interaction"
				blockoverride "show_interaction" {
					visible = "[And3( Character.IsPlayerInteractionShown( PdxGuiWidget.GetName ), Character.IsValid, Character.IsPlayerInteractionValid( PdxGuiWidget.GetName ) )]"
				}
			}

			container_single_interaction = {
				blockoverride "interaction_name" {
					name = "request_elevation_interaction"
				}
				blockoverride "ignore_archbishop" {}
				blockoverride "button_round_interaction" {
					button_round_interaction_title = {}
				}
			}

			# if you have a best candidate who isn't you, this lets you invest yourself
			hbox = {
				datacontext = "[TitleViewWindow.GetSuccessorCandidateList]"
				datacontext = "[AdminVassalSuccessorCandidateList.GetBestLocalPlayerCandidate( '(int32)0' )]"
				datacontext = "[AdminVassalSuccessorCandidate.GetCandidate]"

				visible = "[And( And( TitleViewWindow.ShowAppointment, AdminVassalSuccessorCandidateList.ShowBestPlayerCandidateIndependently( '(int32)0' ) ), Not( Character.IsLocalPlayer ) )]"

				button_round_interaction_title = {
					datacontext = "[GetPlayer]"
					name = "influence_clerical_candidacy_interaction"
					blockoverride "icon" {
						button_promote_candidate = {
							parentanchor = center
							alwaystransparent = yes
						}
					}
				}
			}
		}
	}

	## Titles line of succession (displayed at the bottom right of the title view)
	type vbox_title_line_of_succession = vbox {
		datacontext = "[TitleViewWindow.GetTitle]"

		### Title Destroyed
		vbox = {
			visible = "[Title.IsDestroyedOnSuccession]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			hbox = {
				layoutpolicy_horizontal = expanding

				text_single = {
					text = "TITLE_VIEW_SUCCESSION_NONE"
					default_format = "#weak"
				}
			}
		}

		### Succession Exists
		vbox = {
			visible = "[Not( Title.IsDestroyedOnSuccession )]"
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			hbox = {
				layoutpolicy_horizontal = expanding

				text_label_center = {
					text = "TITLE_VIEW_SUCCESSION"
					max_width = 400
				}
			}

			expand = {}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 10

					hbox = {
						layoutpolicy_horizontal = expanding
						visible = "[Title.HasLaws]"

						vbox = {
							layoutpolicy_vertical = expanding
							margin_top = 2
							margin_left = 2

							icon = {
								name = "has_laws"
								size = { 25 25 }
								texture = "gfx/interface/icons/title_status/icon_title_law.dds"
							}

							expand = {}
						}

						text_multi = {
							layoutpolicy_horizontal = expanding
							size = { 0 100 }
							margin = { 4 5 }

							text = "[Title.GetSuccessionDescription]"
						}
					}

					text_multi = {
						visible = "[Not( Title.HasLaws )]"
						layoutpolicy_horizontal = expanding
						size = { 0 80 }
						margin = { 20 5 }

						text = "[Title.GetSuccessionDescription]"
						align = center|nobaseline
					}

					vbox = {
						visible = "[And( Title.HasSuccessionOrder( 'election' ), Not( Title.HasClericalRegion ) )]"
						layoutpolicy_vertical = expanding
						margin_right = 20

						expand = {}

						# Round button in the top right that opens the election window
						button_round = {
							name = "show_election_window"
							datacontext = "[Title.GetHolder]"
							size = { 60 60 }

							tooltip = "TITLE_VIEW_SHOW_ELECTION_TT"
							onclick = "[TitleViewWindow.OpenElection]"

							button_election_vote = {
								alwaystransparent = yes
								parentanchor = center
								position = { 1 -1 }
								size = { 40 40 }
							}
						}
						expand = {}
					}
				}

				hbox = {
					visible = "[Not( TitleViewWindow.ShowAppointment )]"
					datamodel = "[TitleViewWindow.GetLineOfSuccession]"

					item = {
						portrait_head_small = {}
					}
				}

				hbox = {
					visible = "[And3( Not( TitleViewWindow.ShowAppointment ), ObjectsEqual( Title.GetHolder, GetTitleByKey( 'k_papal_state' ).GetHolder ), ObjectsEqual( GetPlayer.GetRite, Title.GetHolder.GetRite ) )]"

					margin_top = 10
					margin_right = 5
					
					button_standard = {
						size = { 250 40 }
						text = "TITLE_VIEW_COLLEGE_OF_CARDINALS"
						onclick = "[ToggleGameView( 'cardinals_window' )]"
						tooltip = "TITLE_VIEW_COLLEGE_OF_CARDINALS_TOOLTIP"
					}
				}

				hbox = {
					datacontext = "[TitleViewWindow.GetSuccessorCandidateList]"
					visible = "[TitleViewWindow.ShowAppointment]"

					blockoverride "score_breakdown" {
						datacontext = "[TitleViewWindow.GetSuccessionScoreBreakdown( Character.Self )]"
					}
					
					# default admin succession
					hbox_admin_title_successor_candidates_list = {
						visible = "[Not( Title.HasClericalRegion )]"
					}
					# clerical succession with bigger portraits, with one less for all numbers
					hbox_admin_title_successor_candidates_list = {
						visible = "[Title.HasClericalRegion]"
						blockoverride "show_candidate" {
							visible = "[AdminVassalSuccessorCandidateList.ShowBestPlayerCandidateIndependently( '(int32)2' )]"
						}
						blockoverride "candidates_datamodel_small" {
							datamodel = "[DataModelFirst( AdminVassalSuccessorCandidateList.GetSuccessorCandidates, '(int32)2')]"
						}
						blockoverride "candidate_datacontext" {
							datacontext = "[AdminVassalSuccessorCandidateList.GetBestLocalPlayerCandidate( '(int32)2' )]"
						}
						blockoverride "not_show_candidate" {
							visible = "[Not( AdminVassalSuccessorCandidateList.ShowBestPlayerCandidateIndependently( '(int32)2' ) )]"
							datamodel = "[DataModelFirst( AdminVassalSuccessorCandidateList.GetSuccessorCandidates, '(int32)3')]"
						}
					}
				}

				hbox = {
					name = "title_appointment"
					visible = "[TitleViewWindow.ShowAppointment]"
					margin_top = 10
					spacing = 5

					button_standard = {
						size = { 150 40 }
						text = "TITLE_VIEW_APPOINTMENT"

						onclick = "[ToggleGameViewData( 'title_appointment', Title.GetID )]"

						tooltip = "TITLE_VIEW_APPOINTMENT_TOOLTIP"
					}

					# INVEST IN BEST LOCAL PLAYER CANDIDATE IF THEY EXIST
					hbox = {
						datacontext = "[TitleViewWindow.GetSuccessorCandidateList]"
						datacontext = "[AdminVassalSuccessorCandidateList.GetBestLocalPlayerCandidate( '(int32)0' )]"
						datacontext = "[AdminVassalSuccessorCandidate.GetCandidate]"

						visible = "[And( TitleViewWindow.ShowAppointment, AdminVassalSuccessorCandidateList.ShowBestPlayerCandidateIndependently( '(int32)0' ) )]"
						layoutpolicy_horizontal = expanding

						# appointment
						# show for county or higher in japan and duchy or higher elsewhere
						button_standard = {
							visible = "[And( Or( And( GetPlayer.GetGovernment.IsType( 'japan_administrative_government' ), Not( Title.IsBarony) ), Not( Or( Title.IsCounty, Title.IsBarony) ) ), Character.IsPlayerInteractionShown('influence_candidacy_interaction') )]"
							size = { 180 40 }

							enabled = "[Character.IsPlayerInteractionValid('influence_candidacy_interaction')]"
							onclick = "[Character.OpenPlayerInteractionWithTargetTitle('influence_candidacy_interaction', Title.Self)]"

							tooltip = "[Character.GetPlayerInteractionTooltip('influence_candidacy_interaction')]"


							hbox = {
								layoutpolicy_horizontal = expanding
								margin = { 8 4 }

								button_promote_candidate = {
									alwaystransparent = yes
								}

								text_single = {
									text = ADMIN_VASSAL_DETAILS_VOTE_FOR_SUCCESSOR_BUTTON
									align = nobaseline
									default_format = "#clickable"
									max_width = 130
								}
							}
						}

						# clerical appointment
						button_standard = {
							visible = "[And( GetPlayer.GetGovernment.IsType( 'ecclesiastical_government' ), Character.IsPlayerInteractionShown('influence_clerical_candidacy_interaction') )]"
							size = { 180 40 }

							onclick = "[Character.OpenPlayerInteractionWithTargetTitle( 'influence_clerical_candidacy_interaction', Title.Self )]"
							enabled = "[And( Character.IsPlayerInteractionWithTargetTitleValid( 'influence_clerical_candidacy_interaction', Title.Self ), Character.IsPlayerInteractionShownAndCanPickTitle( 'influence_clerical_candidacy_interaction', Title.Self ) )]"
							tooltip = "[Character.GetPlayerInteractionWithTargetTitleTooltip( 'influence_clerical_candidacy_interaction', Title.Self )]"

							hbox = {
								layoutpolicy_horizontal = expanding
								margin = { 8 4 }

								button_promote_candidate = {
									alwaystransparent = yes
								}

								text_single = {
									text = ADMIN_VASSAL_DETAILS_VOTE_FOR_SUCCESSOR_BUTTON
									align = nobaseline
									default_format = "#clickable"
									max_width = 130
								}
							}
						}
					}

					# INVEST IN ANYONE (FALLBACK)
					hbox = {
						datacontext = "[TitleViewWindow.GetSuccessorCandidateList]"

						visible = "[And( TitleViewWindow.ShowAppointment, Not( AdminVassalSuccessorCandidateList.ShowBestPlayerCandidateIndependently( '(int32)0' ) ) )]"
						layoutpolicy_horizontal = expanding

						# appointment
						button_standard = {
							visible = "[And( Or( And( GetPlayer.GetGovernment.IsType( 'japan_administrative_government' ), Not( Title.IsBarony) ), Not( Or( Title.IsCounty, Title.IsBarony) ) ), Character.IsPlayerInteractionShown('influence_candidacy_interaction') )]"
							size = { 180 40 }

							enabled = "[Character.IsPlayerInteractionValid('influence_candidacy_interaction')]"
							onclick = "[Character.GetTopLiege.OpenPlayerInteractionWithTargetTitle('influence_candidacy_interaction', Title.Self)]"

							tooltip = "[Character.GetPlayerInteractionTooltip('influence_candidacy_interaction')]"

							hbox = {
								layoutpolicy_horizontal = expanding
								margin = { 8 4 }

								button_promote_candidate = {
									alwaystransparent = yes
								}

								text_single = {
									text = "influence_clerical_candidacy_interaction_short"
									align = nobaseline
									default_format = "#clickable"
								}
							}
						}

						# clerical appointment
						button_standard = {
							datacontext = "[GetPlayer]"
							visible = "[And( GetPlayer.GetGovernment.IsType( 'ecclesiastical_government' ), Character.IsPlayerInteractionShown('influence_clerical_candidacy_interaction') )]"
							size = { 180 40 }

							onclick = "[Character.OpenPlayerInteractionWithTargetTitle( 'influence_clerical_candidacy_interaction', Title.Self )]"
							enabled = "[And( Character.IsPlayerInteractionWithTargetTitleValid( 'influence_clerical_candidacy_interaction', Title.Self ), Character.IsPlayerInteractionShownAndCanPickTitle( 'influence_clerical_candidacy_interaction', Title.Self ) )]"
							tooltip = "[Character.GetPlayerInteractionWithTargetTitleTooltip( 'influence_clerical_candidacy_interaction', Title.Self )]"

							hbox = {
								layoutpolicy_horizontal = expanding
								margin = { 8 4 }

								button_promote_candidate = {
									alwaystransparent = yes
								}

								text_single = {
									text = "influence_clerical_candidacy_interaction_short"
									align = nobaseline
									default_format = "#clickable"
									max_width = 130
								}
							}
						}
					}
				}
			}
		}
	}

	type hbox_suggested_clergy_item = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 10

		portrait_head_small = {}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				background = {
					using = Background_Area
					margin = { 4 4 }
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					autoresize = no
					text = "[Character.GetShortUINameNoTooltip]"
					align = nobaseline
				}

				expand = {}

				hbox = {
					using = character_age_or_death_text
				}

				hbox_skills_grid_character_model = {}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				datacontext = "[Character.GetRite]"
				spacing = 10

				button_rite_icon = {
					size = { 35 35 }
				}

				text_single = {
					layoutpolicy_horizontal = expanding
					autoresize = no

					text = "[Character.GetRelationToString( Character.GetLiege.Self )]"
					tooltip = "[Character.GetRelationToStringExtended( Character.GetLiege.Self )]"
					align = nobaseline
				}

				expand = {}

				hbox = {
					spacing = 10

					text_single = {
						text = "TITLE_VIEW_GRANT"
						default_format = "#clickable"
						align = nobaseline
					}

					button_round = {
						datacontext = "[GetCharacterInteraction( 'grant_ecclesiastical_title_interaction' )]"

						enabled = "[Character.IsPlayerInteractionWithTargetTitleValid( 'grant_ecclesiastical_title_interaction', Title.Self )]"
						onclick = "[Character.OpenPlayerInteractionWithTargetTitle( 'grant_ecclesiastical_title_interaction', Title.Self )]"
						tooltip = "[Character.GetPlayerInteractionWithTargetTitleTooltip( 'grant_ecclesiastical_title_interaction', Title.Self )]"

						button = {
							parentanchor = center
							size = { 60% 60% }
							alwaystransparent = yes

							texture = "[CharacterInteraction.GetIcon( Character.Self )]"
						}
					}
				}

			}
		}

		expand = {}
	}
}
