widget = {
	name = "pod_umbra_adventure_window"
	visible = "[And( And( Not( IsPauseMenuShown ), IsDefaultGUIMode ), GetPlayer.IsValid)]"
	layer = royal_court # above the HUD, but below interaction windows and events
	size = { 100% 100% }

	window = {
		size = { 100% 100% }
		using = Window_Background_No_Edge

		visible = "[And(GetVariableSystem.Exists('pod_umbra_adventure_view'), GetPlayer.MakeScope.Var('umbra_adventure').IsSet)]"

		vbox = {
			header_no_background = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					raw_text = "Hello!"
				}

				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Clear('pod_umbra_adventure_view')]"
				}
			}

			widget = {
				size = { 1000 1000 }
				hbox = {
					layoutpolicy_vertical = expand
					parentanchor = center
					widget = {
						size = { 500 500 }
						vbox = {
							text_single = {
								raw_text = "Your Inventory"
							}
							spacer = {
								size = { 0 5 }
							}

							widget = {
								size = { 220 420 }
								background = {
									using = Background_Frame_Gold
								}
								fixedgridbox = {
									parentanchor = center
									margin = { 10 10 }
									datamodel = "[GetPlayer.MakeScope.Var('umbra_adventure').GetList('inventory')]"
									datamodel_wrap = 4
									addcolumn = 100
									addrow = 100

									item = {
										widget = {
											size = { 100 100 }
											background = {
												using = Background_Frame
											}
										}
									}
								}
							}

							expand = {}
						}
					}
					widget = {
						size = { 800 800 }
						background = {
							using = Background_Area_Solid
						}
					}
					widget = {
						size = { 500 500 }
						vbox = {
							text_single = {
								raw_text = "Your Inventory"
							}
							spacer = {
								size = { 0 5 }
							}

							widget = {
								size = { 220 420 }
								background = {
									using = Background_Frame_Gold
								}
								fixedgridbox = {
									parentanchor = center
									margin = { 10 10 }
									datamodel = "[GetPlayer.MakeScope.Var('umbra_adventure').GetList('inventory')]"
									datamodel_wrap = 4
									addcolumn = 100
									addrow = 100

									item = {
										widget = {
											size = { 100 100 }
											background = {
												using = Background_Frame
											}
										}
									}
								}
							}

							expand = {}
						}
					}
				}
			}

			expand = {}
		}
	}
}
