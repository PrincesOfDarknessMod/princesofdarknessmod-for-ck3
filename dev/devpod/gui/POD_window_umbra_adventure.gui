    type button_umbra_adv = button_normal {
		size = { 50 50 }
		clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_advance"
							
		tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
							
		visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		enabled = "[And(Not(IsPausedByEvent), ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

		icon = {
			name = "victory_glow2"
			visible = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			size = { 100% 100% }
			texture = "gfx/interface/component_masks/mask_fade_circle.dds"
			using = Color_Orange
			alpha = 1
		}
	}
	
    type button_umbra_fight = button_umbra_adv {
		highlight_icon = {
			texture = "gfx/interface/icons/activity_pulse_actions/martial.dds"
			size = { 50 50 }
		}
	}
	
    type button_umbra_chest = button_umbra_adv {
		highlight_icon = {
			texture = "gfx/interface/icons/activity_pulse_actions/stewardship.dds"
			size = { 50 50 }
		}
	}
	
    type button_umbra_event = button_umbra_adv {
		highlight_icon = {
			texture = "gfx/interface/icons/activity_pulse_actions/language.dds"
			size = { 50 50 }
		}
	}
	
    type button_umbra_trial = button_umbra_adv {
		highlight_icon = {
			texture = "gfx/interface/icons/activity_pulse_actions/intrigue.dds"
			size = { 50 50 }
		}
	}
	
    type button_umbra_elite = button_umbra_adv {
		highlight_icon = {
			texture = "gfx/interface/icons/activity_pulse_actions/icon_dread.dds"
			size = { 50 50 }
		}
	}
