types Umbra  {
    type window_umbra_adventure = window {
		name = "umbra_adventure_window"
		layer = middle
		parentanchor = center
		size = { 575 925 }
		movable = no
			
		visible = "[GetScriptedGui( 'umbra_expedition_enable' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
		state = {
			name = _show
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
		}
		
		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
		}
		
		container = {
			line = { visible = "[GetScriptedGui( 'umbra_b7_to_c8_unlocked' ).IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]" using = Line_Lifestyles_Unlocked from = { 175 200 } to = { 275 100 } }
