widget = {
	name = "pod_umbra_adventure_window"
	visible = "[And( And( Not( IsPauseMenuShown ), IsDefaultGUIMode ), GetPlayer.IsValid)]"
	layer = bottom # WIP
	size = { 100% 100% }

	window = {
		size = { 100% 100% }
		using = Window_Background_No_Edge
		movable = no

		visible = "[And(GetVariableSystem.Exists('pod_umbra_adventure_view'), GetPlayer.MakeScope.Var('umbra_adventure').IsSet)]"

		vbox = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding

			header_no_background = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					raw_text = "Hello!"
				}

				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Clear('pod_umbra_adventure_view')]"
				}
			}

			expand = {}

			hbox = {
				widget = {
					size = { 800 600 }
					# background = {
					# 	using = Background_Area_Solid
					# }
					widget = {
						name = "pod_lines_nodes"
						size = { 100% 100% }
						alwaystransparent = yes
						datamodel = "[GetPlayer.MakeScope.Var('umbra_map').GetList('lines')]"
						datacontext = "[GetScriptedGui('POD_umbra_expedition_line')]"
						item = {
							pod_umbra_line_2 = {}
						}
					}
		
					widget = {
						name = "pod_umbra_nodes"
						size = { 100% 100% }
						alwaystransparent = yes
						datamodel = "[GetPlayer.MakeScope.Var('umbra_map').GetList('nodes')]"
						item = {
							pod_umbra_node_2 = {}
						}
					}
				}
				spacer = { 
					size = { 20 0 }
				}
				vbox = {
					layoutpolicy_vertical = expanding
					
					expand = {}

					text_single = {
						raw_text = "Your Inventory"
					}
					spacer = {
						size = { 0 5 }
					}

					widget = {
						size = { 220 420 }
						background = {
							using = Background_Frame_Gold
						}
						fixedgridbox = {
							parentanchor = center
							datamodel = "[GetPlayer.MakeScope.Var('umbra_adventure').GetList('dummy_inventory')]"
							datamodel_wrap = 4
							addcolumn = 100
							addrow = 100

							item = {
								pod_inventory_placeholder = {}
							}
						}
						fixedgridbox = {
							# extreme jank
							# margin_widget prevents input from reaching the items for some reason
							position = { 10 10 }
							datamodel = "[GetPlayer.MakeScope.Var('umbra_adventure').GetList('inventory')]"
							datamodel_wrap = 4
							addcolumn = 100
							addrow = 100
							
							flipdirection = yes


							item = {
								pod_inventory_item = {}
							}
						}
					}
					
					expand = {}
				}
			}

			expand = {}
		}
	}
}

types UmbraAdventureTypes
{
	type pod_inventory_item = widget
	{
		size = { 100 100 }
		background = {
			using = Background_Frame
		}

		margin_widget = {
			visible = "[Scope.Var('type').IsSet]"
			size = { 100% 100% }
			margin = { 10 10 }
			
			# essence
			widget = {
				size = { 100% 100% }
				visible = "[StoryGuiIsShown('POD_umbra_adventure_is_essence')]"
				icon = {
					parentanchor = center
					texture = "gfx/interface/icons/icon_gold.dds"
				}

				text_single = {
					visible = "[Scope.Var('quantity').IsSet]"
					parentanchor = bottom|right
					raw_text = "[Scope.Var('quantity').GetValue]"
				}

				button_close = {
					parentanchor = top|right
					scale = 0.5
					tooltip = "Drop this item forever"
					onclick = "[StoryGuiExecute('POD_umbra_adventure_drop_item')]"
				}
			}

			# artifact
			widget = {
				visible = "[StoryGuiIsShown('POD_umbra_adventure_is_artifact')]"
				size = { 100% 100% }

				datacontext = "[Scope.Var('artifact').Artifact]"

				icon_artifact = {
					parentanchor = center
					size = { 100 100 }
				}

				button_close = {
					parentanchor = top|right
					scale = 0.5
					tooltip = "Drop this item forever"
					onclick = "[StoryGuiExecute('POD_umbra_adventure_drop_item')]"
				}
			}
		}
	}
	type pod_inventory_placeholder = widget
	{
		# alwaystransparent = "[StoryGuiIsShown('POD_umbra_adventure_inventory_placeholder')]"
		size = { 100 100 }
		background = {
			using = Background_Frame
		}
	}
	type pod_umbra_node_2 = button_normal {
		size = { 50 50 }
		visible = "[StoryGuiIsShown('POD_umbra_expedition_node')]"
		# Scale down positions by the scaling vector
		# Widgets scale up automatically so we need to apply the scaling vector here to ensure that the position of the icon is appropriately adjusted
		position = "[Multiply_CVector2f(GetScalingVector, PdxGetWidgetScreenSize(PdxGuiWidget.FindChild('positioning_helper').Self))]"
		
		enabled = "[And(Not(IsPausedByEvent), StoryGuiIsValid('POD_umbra_expedition_node'))]"

		onclick = "[StoryGuiExecute('POD_umbra_expedition_node')]"

		tooltip = "[StoryGuiBuildTooltip('POD_umbra_expedition_node')]"


		button_icon = {
			texture = "gfx/interface/buttons/button_activity_base.dds"
			size = { 64 64 }
			position = { -7 -7 }

			visible = "[StoryGuiIsShown('POD_umbra_expedition_is_current_location')]"

			onclick = "[StoryGuiExecute('POD_umbra_expedition_node')]"
		}

		highlight_icon = {
			texture = "gfx/interface/buttons/button_activity_base.dds"
			size = { 64 64 }
			position = { -7 -7 }

			visible = "[Not(StoryGuiIsShown('POD_umbra_expedition_is_current_location'))]"
		}

		highlight_icon = {
			texture = "[GetCultureInnovationType(Concatenate('umbra_', Scope.Var('type').GetFlagName)).GetIcon]"
			size = { 50 50 }
		}

		using = POD_scaling_helper

		# Please give us a better way to create CVector2f Paradox
		widget = {
			name = "positioning_helper"
			min_width = "[UmbraScaledScopedNodeY]"
			max_width = "[UmbraScaledScopedNodeY]"
			min_height = "[UmbraScaledScopedNodeX]"
			max_height = "[UmbraScaledScopedNodeX]"
		}
	}

	type pod_umbra_line_2 = widget
	{
		size = { 100% 100% }
		line = {
			using = Line_Lifestyles_Unlocked
			color = { 0 0 0 0.6 }
			width = 22
			scale = "[GetInvParentScale(PdxGuiWidget.Self)]"
			from  = "[PdxGetWidgetScreenSize(PdxGuiWidget.AccessParent.FindChild('pod_line_start').Self)]"
			to    = "[PdxGetWidgetScreenSize(PdxGuiWidget.AccessParent.FindChild('pod_line_end').Self)]"
		}
		line = {
			visible = "[StoryGuiIsShown('POD_umbra_expedition_line')]"
			using = Line_Lifestyles_Unlocked
			scale = "[GetInvParentScale(PdxGuiWidget.Self)]"
			from  = "[PdxGetWidgetScreenSize(PdxGuiWidget.AccessParent.FindChild('pod_line_start').Self)]"
			to    = "[PdxGetWidgetScreenSize(PdxGuiWidget.AccessParent.FindChild('pod_line_end').Self)]"
		}
		line = {
			visible = "[Not(StoryGuiIsShown('POD_umbra_expedition_line'))]"
			using = Line_Lifestyles_Unavailable
			# brighten the lines to make them more visible
			color = { 2 2 2 1 }
			scale = "[GetInvParentScale(PdxGuiWidget.Self)]"
			from  = "[PdxGetWidgetScreenSize(PdxGuiWidget.AccessParent.FindChild('pod_line_start').Self)]"
			to    = "[PdxGetWidgetScreenSize(PdxGuiWidget.AccessParent.FindChild('pod_line_end').Self)]"
		}
		widget = {
			name = "pod_line_start"
			min_width = "[UmbraScaledScopedLineY1]"
			max_width = "[UmbraScaledScopedLineY1]"
			min_height = "[UmbraScaledScopedLineX1]"
			max_height = "[UmbraScaledScopedLineX1]"
		}
		widget = {
			name = "pod_line_end"
			min_width = "[UmbraScaledScopedLineY2]"
			max_width = "[UmbraScaledScopedLineY2]"
			min_height = "[UmbraScaledScopedLineX2]"
			max_height = "[UmbraScaledScopedLineX2]"
		}
	}
}
