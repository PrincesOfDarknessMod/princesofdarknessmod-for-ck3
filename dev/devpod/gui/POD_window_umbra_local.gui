types Umbra  {
    type window_local_umbra = window {
        size = { 400 600 }
        position = { 580 15 }
        layer = middle
    
        using = Window_Background
        using = Window_Decoration
        using = Animation_ShowHide_Standard
		
		visible = "[GetVariableSystem.Exists('window_local_umbra')]"

		state = {
			name = _show
			using = Animation_FadeIn_Quick
		}
		
        vbox = {
            using = Window_Margins
            restrictparent_min = yes
			ignoreinvisible = yes
			header_pattern = {
				layoutpolicy_horizontal = expanding
	
				blockoverride "header_text"
				{
					text = "local_umbra"
				}
	
				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Clear( 'window_local_umbra' )]"
				}
			}
			
			icon = {
				size = { 400 525 }
				background = {
					texture = "gfx/interface/illustrations/spirit_world.dds"

					alpha = 0.3
					using = Mask_Rough_Edges

					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
						blend_mode = alphamultiply
						mirror = vertical
					}
				}
				
				vbox = {
					vbox = {
						datacontext = "[Province.GetCounty.GetTitle.MakeScope.GetVariable('spirit_wilds_controller').GetCharacter]"
						text_label_center = {
							text = "game_concept_spirit_wilds"
							default_format = "#high;bold;glow_color:{0,0,0,1}"
							margin_bottom = 10
						}
						icon = {
							size = { 390 100 }
							background = {
								using = Background_Area_Dark
								alpha = 1
								margin_left = 5
								margin_right = 5
								margin_top = 5
								margin_bottom = 5
							}
							
							flowcontainer = {
								margin_left = 10
								margin_right = 10
								margin_top = 0
								margin_bottom = 5
								direction = vertical
								
								text_multi = {
									layoutpolicy_horizontal = expanding
									raw_text = "#bold [Localize('local_controller')]#!#V [SelectLocalization( Character.IsValid, 'local_controller_name', 'NONE' )]#!"
									align = left
									autoresize = yes
									max_width = 300
								}
								text_multi = {
									layoutpolicy_horizontal = expanding
									raw_text = "#bold [Localize('local_gauntlet')]#!#V [Province.Custom( 'gauntlet_level' )]#!"
									align = left
									autoresize = yes
									max_width = 300
								}
								text_multi = {
									layoutpolicy_horizontal = expanding
									raw_text = "#bold [Localize('spirit_opinion')]#!#V [SelectLocalization( Character.IsValid, 'spirit_opinion_name', 'NONE' )]#!"
									align = left
									autoresize = yes
									max_width = 300
								}
								text_multi = {
									layoutpolicy_horizontal = expanding
									raw_text = "#bold [Localize('active_effect')]#!#V [Province.Custom( 'LocalSpiritWildsBuff' )]#!"
									align = left
									autoresize = yes
									max_width = 300
								}
							}
							
							flowcontainer = {
								parentanchor = right|vcenter
								direction = vertical
								margin_right = 10
								portrait_head_small = {}
							}
						}
						
						hbox = {
							margin_top = 10
							spacing = 10
							button_standard = {
								text = "DISCERN_THE_GAUNTLET"
								datacontext = "[GetScriptedGui( 'discern_the_gauntlet' )]"
								tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(Province.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
													
								visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(Province.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
								onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(Province.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
							}
							button_local_umbra = {
								text = "MANIPULATE_THE_WALL"
								datacontext = "[GetScriptedGui( 'manipulate_the_wall' )]"
								tooltip = "[Localize('MANIPULATE_THE_WALL_TOOLTIP')]"
							}
							button_local_umbra = {
								text = "MANIPULATE_THE_GAUNTLET"
								datacontext = "[GetScriptedGui( 'manipulate_the_gauntlet' )]"
								tooltip = "[Localize('MANIPULATE_THE_GAUNTLET_TOOLTIP')]"
							}
							button_standard = {
								text = "UMBRA_BUFF_WINDOW_CHANGE"
								enabled = "[And( And( Character.IsValid, ObjectsEqual( Character.Self, GetPlayer )), GetScriptedGui('spirit_wilds_buff_window_open').IsValid( GuiScope.SetRoot( Province.MakeScope ).End))]"
								onclick = "[GetScriptedGui('spirit_wilds_buff_window_open').Execute( GuiScope.SetRoot( Province.MakeScope ).End)]"
								onclick = "[GetVariableSystem.Set('umbra_tab_choice','spirit_wilds')]"
							}
						}
						hbox = {
							margin_top = 10
							spacing = 10
							button_local_umbra = {
								text = "calm_spirits"
								datacontext = "[GetScriptedGui( 'calm_local_spirit' )]"
							}
							button_standard = {
								text = "USURP_TITLE_CONFIRM_ACCEPT"
								datacontext = "[GetScriptedGui( 'become_spirit_wilds_controller' )]"
								enabled = "[And(GetPlayer.IsValid, And(Or( Not(Character.IsValid), Not(ObjectsEqual( Character.Self, GetPlayer ))), ScriptedGui.IsValid(GuiScope.SetRoot(Province.MakeScope).AddScope( 'player', GetPlayer.MakeScope ).End)))]"
								onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(Province.MakeScope).AddScope( 'player', GetPlayer.MakeScope ).End)]"
								tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(Province.MakeScope).AddScope( 'player', GetPlayer.MakeScope ).End)]"
							}
						}
					}
					
					container = {
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('gauntlet_level'), '(CFixedPoint)10' )]"
							texture = "gfx/interface/icons/icon_grace.dds"
							position = { 0 0 }
							size = { 35 35 }
							tooltip = "gauntletdesc10"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('gauntlet_level'), '(CFixedPoint)9' )]"
							texture = "gfx/interface/icons/icon_grace.dds"
							position = { 35 0 }
							size = { 35 35 }
							tooltip = "gauntletdesc9"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('gauntlet_level'), '(CFixedPoint)8' )]"
							texture = "gfx/interface/icons/icon_grace.dds"
							position = { 70 0 }
							size = { 35 35 }
							tooltip = "gauntletdesc8"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('gauntlet_level'), '(CFixedPoint)7' )]"
							texture = "gfx/interface/icons/icon_grace.dds"
							position = { 105 0 }
							size = { 35 35 }
							tooltip = "gauntletdesc7"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('gauntlet_level'), '(CFixedPoint)6' )]"
							texture = "gfx/interface/icons/icon_grace.dds"
							position = { 140 0 }
							size = { 35 35 }
							tooltip = "gauntletdesc6"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('gauntlet_level'), '(CFixedPoint)5' )]"
							texture = "gfx/interface/icons/icon_grace.dds"
							position = { 175 0 }
							size = { 35 35 }
							tooltip = "gauntletdesc5"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('gauntlet_level'), '(CFixedPoint)4' )]"
							texture = "gfx/interface/icons/icon_grace.dds"
							position = { 210 0 }
							size = { 35 35 }
							tooltip = "gauntletdesc4"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('gauntlet_level'), '(CFixedPoint)3' )]"
							texture = "gfx/interface/icons/icon_grace.dds"
							position = { 245 0 }
							size = { 35 35 }
							tooltip = "gauntletdesc3"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('gauntlet_level'), '(CFixedPoint)2' )]"
							texture = "gfx/interface/icons/icon_grace.dds"
							position = { 280 0 }
							size = { 35 35 }
							tooltip = "gauntletdesc2"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('gauntlet_level'), '(CFixedPoint)1' )]"
							texture = "gfx/interface/icons/icon_grace.dds"
							position = { 315 0 }
							size = { 35 35 }
							tooltip = "gauntletdesc1"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('gauntlet_level'), '(CFixedPoint)0' )]"
							texture = "gfx/interface/icons/icon_grace.dds"
							position = { 350 0 }
							size = { 35 35 }
							tooltip = "gauntletdesc0"
						}
					}
					container = {
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('shroud_level'), '(CFixedPoint)10' )]"
							texture = "gfx/interface/icons/icon_umbra.dds"
							position = { 0 0 }
							size = { 35 35 }
							tooltip = "shrouddesc10"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('shroud_level'), '(CFixedPoint)9' )]"
							texture = "gfx/interface/icons/icon_umbra.dds"
							position = { 35 0 }
							size = { 35 35 }
							tooltip = "shrouddesc9"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('shroud_level'), '(CFixedPoint)8' )]"
							texture = "gfx/interface/icons/icon_umbra.dds"
							position = { 70 0 }
							size = { 35 35 }
							tooltip = "shrouddesc8"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('shroud_level'), '(CFixedPoint)7' )]"
							texture = "gfx/interface/icons/icon_umbra.dds"
							position = { 105 0 }
							size = { 35 35 }
							tooltip = "shrouddesc7"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('shroud_level'), '(CFixedPoint)6' )]"
							texture = "gfx/interface/icons/icon_umbra.dds"
							position = { 140 0 }
							size = { 35 35 }
							tooltip = "shrouddesc6"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('shroud_level'), '(CFixedPoint)5' )]"
							texture = "gfx/interface/icons/icon_umbra.dds"
							position = { 175 0 }
							size = { 35 35 }
							tooltip = "shrouddesc5"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('shroud_level'), '(CFixedPoint)4' )]"
							texture = "gfx/interface/icons/icon_umbra.dds"
							position = { 210 0 }
							size = { 35 35 }
							tooltip = "shrouddesc4"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('shroud_level'), '(CFixedPoint)3' )]"
							texture = "gfx/interface/icons/icon_umbra.dds"
							position = { 245 0 }
							size = { 35 35 }
							tooltip = "shrouddesc3"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('shroud_level'), '(CFixedPoint)2' )]"
							texture = "gfx/interface/icons/icon_umbra.dds"
							position = { 280 0 }
							size = { 35 35 }
							tooltip = "shrouddesc2"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('shroud_level'), '(CFixedPoint)1' )]"
							texture = "gfx/interface/icons/icon_umbra.dds"
							position = { 315 0 }
							size = { 35 35 }
							tooltip = "shrouddesc1"
						}
						icon = {
							enabled = "[LessThanOrEqualTo_CFixedPoint( Province.MakeScope.ScriptValue('shroud_level'), '(CFixedPoint)0' )]"
							texture = "gfx/interface/icons/icon_umbra.dds"
							position = { 350 0 }
							size = { 35 35 }
							tooltip = "shrouddesc0"
						}
					}
					
					vbox = {
						datacontext = "[Province.GetCounty.GetTitle.MakeScope.GetVariable('shadowlands_controller').GetCharacter]"
						
						text_label_center = {
							text = "game_concept_shadowlands"
							default_format = "#high;bold;glow_color:{0,0,0,1}"
							margin_bottom = 10
						}
						
						icon = {
							size = { 390 100 }
							background = {
								using = Background_Area_Dark
								alpha = 1
								margin_left = 5
								margin_right = 5
								margin_top = 5
								margin_bottom = 5
							}
							
							flowcontainer = {
								margin_left = 10
								margin_right = 10
								margin_top = 0
								margin_bottom = 5
								direction = vertical
								
								text_multi = {
									layoutpolicy_horizontal = expanding
									raw_text = "#bold [Localize('local_controller')]#!#V [SelectLocalization( Character.IsValid, 'local_controller_name', 'NONE' )]#!"
									align = left
									autoresize = yes
									max_width = 300
								}
								text_multi = {
									layoutpolicy_horizontal = expanding
									raw_text = "#bold [Localize('local_shroud')]#!#V [Province.Custom( 'shroud_level' )]#!"
									align = left
									autoresize = yes
									max_width = 300
								}
								text_multi = {
									layoutpolicy_horizontal = expanding
									raw_text = "#bold [Localize('plasmic_opinion')]#!#V [SelectLocalization( Character.IsValid, 'plasmic_opinion_name', 'NONE' )]#!"
									align = left
									autoresize = yes
									max_width = 300
								}
								text_multi = {
									layoutpolicy_horizontal = expanding
									raw_text = "#bold [Localize('active_effect')]#!#V [Province.Custom( 'LocalShadowlandsBuff' )]#!"
									align = left
									autoresize = yes
									max_width = 300
								}
							}
							
							flowcontainer = {
								parentanchor = right|vcenter
								direction = vertical
								margin_right = 10
								portrait_head_small = {}
							}
						}
						hbox = {
							margin_top = 10
							spacing = 10
							button_standard = {
								text = "DISCERN_THE_SHROUD"
								datacontext = "[GetScriptedGui( 'discern_the_shroud' )]"
								tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(Province.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
													
								visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(Province.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
								onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(Province.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
							}
							button_local_umbra = {
								text = "MANIPULATE_THE_SHROUD"
								datacontext = "[GetScriptedGui( 'manipulate_the_shroud' )]"
								tooltip = "[Localize('MANIPULATE_THE_SHROUD_TOOLTIP')]"
							}
							button_standard = {
								text = "UMBRA_BUFF_WINDOW_CHANGE"
								enabled = "[And( And( Character.IsValid, ObjectsEqual( Character.Self, GetPlayer )), GetScriptedGui('shadowlands_buff_window_open').IsValid( GuiScope.SetRoot( Province.MakeScope ).End))]"
								onclick = "[GetScriptedGui('shadowlands_buff_window_open').Execute( GuiScope.SetRoot( Province.MakeScope ).End)]"
								onclick = "[GetVariableSystem.Set('umbra_tab_choice','shadowlands')]"
							}
						}
						hbox = {
							margin_top = 10
							spacing = 10
							button_local_umbra = {
								text = "calm_wraiths"
								datacontext = "[GetScriptedGui( 'calm_local_plasmic' )]"
							}
							button_standard = {
								text = "USURP_TITLE_CONFIRM_ACCEPT"
								datacontext = "[GetScriptedGui( 'become_shadowlands_controller' )]"
								enabled = "[And(GetPlayer.IsValid, And(Or( Not(Character.IsValid), Not(ObjectsEqual( Character.Self, GetPlayer ))), ScriptedGui.IsValid(GuiScope.SetRoot(Province.MakeScope).AddScope( 'player', GetPlayer.MakeScope ).End)))]"
								onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(Province.MakeScope).AddScope( 'player', GetPlayer.MakeScope ).End)]"
								tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(Province.MakeScope).AddScope( 'player', GetPlayer.MakeScope ).End)]"
							}
						}
					}
				}
			}
		}
	}

    type window_local_umbra_show = window {
        size = { 80 120 }
        position = { 600 500 }
        layer = middle
		movable = no
		
		visible = "[And(Not(GetVariableSystem.Exists('window_local_umbra')), Or(Not(GetPlayer.IsValid), GetScriptedGui('local_umbra_enable').IsValid(GuiScope.AddScope( 'player', GetPlayer.MakeScope ).End)))]"
		
		button_standard = {
			size = { 80 120 }
			
			background = {
				using = Background_Area_Dark
				alpha = 1
				margin_left = 5
				margin_right = 5
				margin_top = 5
				margin_bottom = 5
			}
							
			icon = {
				texture = "gfx/interface/icons/icon_umbra.dds"
				parentanchor = center
				size = { 70 70 }
			}
			
			onclick = "[GetVariableSystem.Toggle( 'window_local_umbra' )]"
		}
	}
}


types Buttons
{
    type button_local_umbra = button_standard
    {
		tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(Province.MakeScope).End)]"
							
		visible = "[ScriptedGui.IsShown(GuiScope.SetRoot(Province.MakeScope).End)]"
		enabled = "[And( And( Character.IsValid, ObjectsEqual( Character.Self, GetPlayer )), ScriptedGui.IsValid(GuiScope.SetRoot(Province.MakeScope).End))]"
		onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(Province.MakeScope).End)]"
    }
}