widget = {
	name = "Era_Window"

	size = { 100% 100% }
	visible = "[And( Not( IsPauseMenuShown ), And(Or(Not(IsObserver), GetPlayer.IsValid), IsDefaultGUIMode))]"
	layer = bottom_bottom

	######################################################
	####################### ERA TEXT #####################
	######################################################

	text_single = {
		name = "era_text"
		visible = "[And( And( And( Not(IsGameViewOpen('barbershop')), Not(IsManuallyPaused)), Not(IsGameViewOpen('struggle'))), GetScriptedGui('era_enable').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		parentanchor = top|hcenter
		widgetanchor = center
		position = { 0 135 }

		margin = { 50 0 }
		margin_bottom = 10

		fontsize = 40
		text = "custom_era_name"
		tooltip = "custom_era_desc"
		using = Font_Type_Flavor
		default_format = "#high;glow_color:{0.1,0.1,0.1,1.0}"
		snap_to_pixels = no
		fonttintcolor = { 1.0 1.0 1.0 0.5 }

		state = {
			name = _hide
			using = Animation_FadeOut_Standard
		}

		state = {
			name = _show
			using = Animation_FadeIn_Standard
		}

		background = {
			using = Background_Title
			margin = { 0 -5 }
		}
	}

	# icon = {
		# name = "era_border_strong"
		# visible = "[And( And( Not(IsGameViewOpen('barbershop')), Not(IsGameViewOpen('struggle'))), GetScriptedGui('era_enable').IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		# parentanchor = top|left
		# position = { -172 -172 }

		# texture = "gfx/interface/icons/wheel_of_ages.dds"
	# }
}
