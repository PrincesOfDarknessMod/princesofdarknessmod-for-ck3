window = {
	name = "pod_achievement_window"
	size = { 250 250 }
	layer = middle
	parentanchor = center
	widgetanchor = center

	visible = "[And(And(GetVariableSystem.Exists('pod_achievement'), Not(IsRightWindowOpen)), IsSidebarVisibilityValid)]"

	using = Window_Background
	using = Window_Decoration
	using = Animation_ShowHide_Standard

	state = {
		name = _show
		using = Animation_FadeIn_Quick
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
	}
	
	vbox = {
		using = Window_Margins
		restrictparent_min = yes

		vbox = {
			layoutpolicy_horizontal = expanding
			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					text = "ACHIEVEMENT"
				}

				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Clear('pod_achievement')]"
				}
			}
		}
		
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			button_normal = {
				size = { 50 50 }
				clicksound = "event:/SFX/UI/Generic/sfx_ui_generic_advance"
				
				icon = {
					visible = "[GetGlobalVariable( 'pod_achievement_01' ).IsSet]"
					texture = "gfx/interface/icons/artifact/artifact_goblet.dds"
					size = { 50 50 }
				}

				text_multi = {
					parentanchor = top|hcenter
					position = { 0 50 }
					max_width = 75
					autoresize = yes

					text = "action_reactive_advice_achievement_01"
					default_format = "#high"
					align = top|hcenter

					background = {
						using = Background_Area
						margin = { 20 0 }
						margin_bottom = 5
						margin_top = 5
					}
				}
			}
		}
	}
}