window = {
	name = "pod_archivement_window"
	size = { 250 250 }
	layer = middle
	parentanchor = center
	widgetanchor = center

	visible = "[And(And(GetVariableSystem.Exists('pod_archivement'), Not(IsRightWindowOpen)), IsSidebarVisibilityValid)]"

	using = Window_Background
	using = Window_Decoration
	using = Animation_ShowHide_Standard

	state = {
		name = _show
		using = Animation_FadeIn_Quick
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
	}
	
	vbox = {
		using = Window_Margins
		restrictparent_min = yes

		vbox = {
			layoutpolicy_horizontal = expanding
			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					text = "ACHIEVEMENT"
				}

				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Clear('pod_archivement')]"
				}
			}
		}
		
		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			icon = {
				visible = "[GetGlobalVariable( 'pod_archivement_01' ).IsSet]"
				texture = "gfx/interface/icons/event_types/type_umbra.dds"
				size = { 70 70 }
			}
		}
	}
}