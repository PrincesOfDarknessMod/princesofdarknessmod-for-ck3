
@max_height_before_scrolling = 920

#adjustment to make scrollbar appear as if outside window
@scrollbar_outside_tweak = 15
@scrollbar_outside_tweak_negative = -15
@scrollbar_outside_tweak_negative_plus_8 = -7

#### THE WINDOW

window = {
	gfxtype = windowgfx
	name = "character_interaction_menu_window"
	widgetid = "character_interaction_menu_window"
	movable = no

	#this is the offset from the character portrait
	position = { 420 70 }
	alwaystransparent = yes
	layer = top
	allow_outside = yes

	# widget_anchor is set dynamically by code
	using = Animation_ShowHide_Quick

	# Cfv
	state = {
		name = _show

		on_start = "[GetScriptedGui('splat_initiation_gui').Execute(GuiScope.SetRoot(CharacterInteractionMenuWindow.GetCharacter.MakeScope).End)]"
	}
	# Cfv end

	# Not shown to the player, but is used by the hotkey system
	button_normal = {
		name = "button_close"
		size = { 0 0 }
		onclick = "[CharacterInteractionMenuWindow.Close]"
		shortcut = "close_window"
	}

	container = {
		alwaystransparent = yes
		resizeparent = yes
		allow_outside = yes

		puppet_item_selection_flowcontainer = {
			position = { -55 50 }
		}

		interaction_list_flowcontainer = { }

		### MORE INTERACTIONS
		more_interactions_container = { }
	}
}


types InteractionTypes
{
	type puppet_item_selection_flowcontainer = flowcontainer
	{
		visible = "[Not( IsDataModelEmpty( CharacterInteractionMenuWindow.GetAvailablePuppets ) )]"
		alwaystransparent = no
		direction = vertical
		ignoreinvisible = yes
		allow_outside = yes

		datamodel = "[CharacterInteractionMenuWindow.GetAvailablePuppets]"

		item = {
			# Parent widget added to allow for animations on button hover
			widget = {
				size = { 80 60 }
				allow_outside = yes

				# Selection glow
				icon = {
					visible = "[And( CharacterInteractionMenuWindow.IsPuppetViewActive, ObjectsEqual( CharacterInteractionMenuWindow.GetSelectedPuppetType, PuppetInteractionsFilter.GetPuppetType ) )]"
					texture = "gfx/interface/buttons/interaction_menu_tab_background_glow.dds"
					parentanchor = center
					position = { -23 0 }
					size = { 80 64 }

					# Glow animation when tab is selected
					state = {
						name = a
						next = b
						trigger_on_create = yes
						alpha = 1
						duration = 1.5
						using = Animation_Curve_Default
					}

					state = {
						name = b
						next = a
						alpha = 0.7
						duration = 1.5
						using = Animation_Curve_Default
					}
				}

				available_puppet_button = {
					position = { -20 0 }
					parentanchor = center
					allow_outside = yes
				}
			}
		}
	}

	type available_puppet_button = button {
		size = { 80 60 }
		framesize = { 160 120 }
		texture = "gfx/interface/buttons/button_tab_interaction_menu.dds"

		gfxtype = togglepushbuttongfx
		effectname = "NoHighlight"

		upframe = 1
		uphoverframe = 2
		uppressedframe = 3
		downframe = 2

		alwaystransparent = "[And( CharacterInteractionMenuWindow.IsPuppetViewActive, ObjectsEqual( CharacterInteractionMenuWindow.GetSelectedPuppetType, PuppetInteractionsFilter.GetPuppetType ) )]"
		down = "[And( CharacterInteractionMenuWindow.IsPuppetViewActive, ObjectsEqual( CharacterInteractionMenuWindow.GetSelectedPuppetType, PuppetInteractionsFilter.GetPuppetType ) )]"
		onclick = "[CharacterInteractionMenuWindow.SelectPuppet( PuppetInteractionsFilter.GetPuppetType )]"

		tooltip = "puppet_interaction_filter_tt"
		tooltip_offset = { 408 0 }

		highlight_icon = {
			size = { 100% 100% }
			gfxtype = togglepushbuttongfx
			effectname = "NoHighlight"
			texture = "gfx/interface/buttons/button_tab_interaction_menu_mouseover.dds"
			framesize  = { 160 120 }

			upframe = 1
			uphoverframe = 2
			uppressedframe = 1
			downframe = 1
			downhoverframe = 1
			downpressedframe = 1
			disableframe = 1

			alpha = 0.5

			block "button_standard_mouseover" {}
		}

		# Mouse enter & leave Animation
		state = {
			name = "_mouse_enter"
			on_start = "[CharacterInteractionMenuWindow.PreviewPuppetInteractions( PuppetInteractionsFilter.GetPuppetType )]"
			duration = 0.15
			using = Animation_Curve_Default
		}

		state = {
			name = "_mouse_leave"
			on_start = "[CharacterInteractionMenuWindow.ClearPuppetPreview]"
			duration = 0.15
			using = Animation_Curve_Default
		}

		# Hover & Selected Position Animation
		state = {
			name = "active_offset"
			trigger_when = "[ObjectsEqual( CharacterInteractionMenuWindow.GetSelectedPuppetType, PuppetInteractionsFilter.GetPuppetType )]"
			duration = 0.15
			position = { -23 0 }
			using = Animation_Curve_Default
		}

		state = {
			name = "inactive_offset"
			trigger_when = "[Not( ObjectsEqual( CharacterInteractionMenuWindow.GetSelectedPuppetType, PuppetInteractionsFilter.GetPuppetType ) )]"
			duration = 0.15
			position = { -20 0 }
			using = Animation_Curve_Default
		}

		widget = {
			parentanchor = center
			position = { 5 0 }
			size = { 48 48 }
			alwaystransparent = yes

			highlight_icon = {
				size = { 48 48 }
				texture = "gfx/interface/buttons/button_tab_interaction_menu_icon_background.dds"
				parentanchor = center
			}

			# Selected & deselected alpha Animation
			state = {
				name = "alpha_selected"
				trigger_when = "[Or( Not( CharacterInteractionMenuWindow.IsPuppetViewActive ), ObjectsEqual( CharacterInteractionMenuWindow.GetSelectedPuppetType, PuppetInteractionsFilter.GetPuppetType ) )]"
				duration = 0.15
				alpha = 1
				using = Animation_Curve_Default
			}

			state = {
				name = "alpha_deselected"
				trigger_when = "[And( CharacterInteractionMenuWindow.IsPuppetViewActive, Not( ObjectsEqual( CharacterInteractionMenuWindow.GetSelectedPuppetType, PuppetInteractionsFilter.GetPuppetType ) ) )]"
				duration = 0.15
				alpha = 0.7
				using = Animation_Curve_Default
			}

			highlight_icon = {
				parentanchor = center
				position = { 0 1 }
				size = { 46 46 }
				alwaystransparent = yes

				texture = "[PuppetInteractionsFilter.GetPuppetType.GetIcon( PuppetInteractionsFilter.GetPuppet )]"

				modify_texture = {
					texture = "gfx/interface/component_masks/round_button_icon_mask.dds"
					blend_mode = alphamultiply

				}
			}

			text_single = {
				parentanchor = bottom|hcenter
				widgetanchor = bottom|hcenter
				position = { 0 5 }
				alwaystransparent = yes

				raw_text = "[CharacterInteractionMenuWindow.GetAvailableActionsForPuppetType( PuppetInteractionsFilter.GetPuppetType )]"
				align = nobaseline
				default_format = "#high;glow_color:{0,0,0,1.0}"

				background = {
					using = Background_Area_ExtraDark
					margin = { 10 2 }

					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_circle.dds"
						blend_mode = alphamultiply
					}
				}
			}
		}
	}

	type interaction_list_flowcontainer = flowcontainer
	{
		alwaystransparent = no
		direction = vertical
		ignoreinvisible = yes

		background = {
			texture = "gfx/interface/skinned/interaction_menu_bg.dds"
			spriteType = Corneredtiled
			spriteborder = { 11 11 }
			spriteborder_top = 49
			margin = { 8 12 }
			margin_right = @scrollbar_outside_tweak_negative_plus_8

			modify_texture = {
				name = "overlay"
				texture = "gfx/interface/component_overlay/overlay_window.dds"
				blend_mode = overlay
			}
		}

		widget = {
			name = "puppet_info"
			visible = "[CharacterInteractionMenuWindow.IsPuppetViewActive]"
			size = { 317 32 }

			datacontext = "[CharacterInteractionMenuWindow.GetCurrentPuppetCharacter]"

			hbox = {
				margin = { 10 4 }

				background = {
					using = Background_Header
					margin = { 0 4 }
					margin_bottom = 8
					alpha = 0.5
				}

				background = {
					using = Background_Header_Pattern
					margin = { 0 4 }
					margin_bottom = 12
					alpha = 0.5
				}

				text_label_center = {
					name = "character_name"
					layoutpolicy_horizontal = expanding
					text = "puppet_interact_as_title"
				}

				expand = {}

				button_close = {
					size = { 20 20 }

					onclick = "[CharacterInteractionMenuWindow.ClearPuppetFilter]"

					using = Animation_ShowHide_Quick

					tooltip = "CLOSE_TOOLTIP"
				}
			}
		}

		widget = {
			datacontext = "[CharacterInteractionMenuWindow.GetCharacter]"
			size = { 317 32 }
			name = "character_info"

			hbox = {
				margin = { 10 4 }

				background = {
					using = Background_Header
					margin = { 0 4 }
					margin_bottom = 8
					alpha = 0.5
				}

				background = {
					using = Background_Header_Pattern
					margin = { 0 4 }
					margin_bottom = 8
					alpha = 0.5
				}

				text_single = {
					name = "character_name"
					visible = "[Not(Character.IsLocalPlayer)]"
					layoutpolicy_horizontal = expanding
					text = "[Character.GetNameNoTooltip|U]"
					default_format = "#Bold;high"
					align = nobaseline
					autoresize = no
				}

				text_single = {
					name = "character_name_me"
					visible = "[Character.IsLocalPlayer]"
					layoutpolicy_horizontal = expanding
					text = "FRAME_RELATION_ME"
					align = nobaseline
					autoresize = no
				}

				expand = {}

				hbox = {
					button_pin = {
						name = "button_pin"
						visible = "[Not(Character.IsPinned)]"
						onclick = "[Character.ToggleCharacterPinned]"
						size = { 25 25 }

						tooltip = "PIN_TT"
						using = tooltip_se
					}

					button_barbershop = {
						name = "customize_portrait"
						visible = "[Character.CanCustomizePortrait]"
						onclick = "[Character.OnCustomizePortrait]"
						onclick = "[CharacterInteractionMenuWindow.Close]"
						size = { 25 25 }

						tooltip = "CV_CUSTOMIZE_PORTRAIT"
						using = tooltip_ne
					}

					button_edit_text = {
						name = "button_rename"
						datacontext = "[GetScriptedGui( 'rename_character_after_birth' )]"
						visible = "[Character.CanCharacterBeRenamed]"
						onclick = "[ScriptedGui.Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).AddScope( 'child', Character.MakeScope ).End  )]"
						size = { 25 25 }

						tooltip = "RENAME_CHARACTER"
						using = tooltip_ne
					}

					button_go_to_my_location = {
						name = "button_go_to_my_location"
						onclick = "[Character.PanCameraTo]"
						size = { 25 25 }

						tooltip = "GOTO_CHARACTER"
						using = tooltip_ne
					}
				}
			}
		}

		widget = {
			visible = [CharacterInteractionMenuWindow.OutsideDiplomaticRange]
			size = { 317 40 }
			
			tooltip = OUT_OF_DIPLOMACY_RANGE_TOOLTIP

			text_label_center = {
				name = "label"
				parentanchor = center
				position = { 0 3 }
				text = OUT_OF_DIPLOMACY_RANGE
			}
		}

		text_multi = {
			datacontext = "[CharacterInteractionMenuWindow.GetCharacter]"
			visible = "[CharacterInteractionMenuWindow.IsFiltered]"
			parentanchor = hcenter

			text =  "[CharacterInteractionMenuWindow.GetFilterDescription]"
			align = center
			autoresize = yes
			max_width = 280
			min_width = 280

			margin = { 0 10 }
			margin_right = @scrollbar_outside_tweak
		}

		scrollarea = {
			autoresizescrollarea = yes
			scrollbarpolicy_horizontal = always_off
			maximumsize = { -1 @max_height_before_scrolling }

			scrollbar_vertical = {
				using = Scrollbar_Vertical
			}

			scrollwidget = {
				flowcontainer = {
					# name used in code
					name = "category_interaction_list"

					datamodel = "[CharacterInteractionMenuWindow.GetCategoryItems]"
					direction = vertical
					ignoreinvisible = yes
					margin_right = @scrollbar_outside_tweak

					item = {
						flowcontainer_category_group = {}
					}
				}
			}
		}
	}

	type more_interactions_container = container
	{
		alwaystransparent = no
		name = "more_interactions_container"
		visible = "[CharacterInteractionMenuWindow.AreMoreInteractionsVisisble]"

		container = {
			#this is used in code as an offset to its position
			position = { -5 30 }

			background = {
				texture = "gfx/interface/skinned/interaction_menu_bg.dds"
				spriteType = Corneredtiled
				spriteborder = { 11 11 }
				spriteborder_top = 49
				margin = { 8 14 }

				# don't resize the bg if the menu is empty: outside of diplo range and don't have debug interactions
				margin_right = "[Select_int32(And(CharacterInteractionMenuWindow.OutsideDiplomaticRange, Not(InDebugMode)), '(int32)0', '(int32)8')]"
				shaderfile = "gfx/FX/pdxgui_default.shader"

				modify_texture = {
					name = "overlay"
					texture = "gfx/interface/component_overlay/overlay_window.dds"
					spriteType = Corneredstretched
					spriteborder = { 0 0 }
					blend_mode = overlay
				}
			}

			# Cfv
			scrollarea = {
				maximumsize = { -1 1000% }
				autoresizescrollarea = yes
				scrollbarpolicy_horizontal = always_off

				scrollwidget = {
					dynamicgridbox_interaction_list = {
						datamodel = "[CharacterInteractionMenuWindow.GetMoreInteractions]"
					}
				}

				scrollbar_vertical = {
					using = Scrollbar_Vertical
				}
			}
			# Cfv end
		}
	}
}

# POD CfV: Hide mod compatibility warning
types PODCompatibilityTypes {
	type pod_warning_interaction = widget { visible = no }
}
# CfV end
