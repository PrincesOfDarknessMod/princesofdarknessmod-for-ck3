window = {
	name = "window_POD_war_of_seasons"
	widgetid = "window_POD_war_of_seasons"
	datacontext = "[SituationWindow.GetSituation]"
	datacontext = "[GetVariableSystem]"
	datacontext = "[GetPlayer]"
	parentanchor = top|right
	layer = windows_layer
	movable = no
	allow_outside = yes

	using = Window_Size_MainTab

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
	}

	margin_widget = {
		size = { 100% 100% }
		margin = { 0 26 }
		margin_right = 13

		widget = {
			size = { 100% 100% }

			vbox = {
				using = Window_Margins

				layoutpolicy_vertical = expanding
				layoutpolicy_horizontal = expanding

				vbox = {
					layoutpolicy_horizontal = expanding
					spacing = 6

					header_pattern = {
						layoutpolicy_horizontal = expanding

						blockoverride "header_text"
						{
							text = "[Situation.GetNameNoTooltip]"
						}

						blockoverride "button_back"
						{
							onclick = "[OpenGameView( 'situations' )]"
						}

						blockoverride "button_close"
						{
							onclick = "[SituationWindow.Close]"
						}
					}
				}

				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					margin = { 15 15 }
					margin_top = 5

					background = {
						using = Background_Area
					}

					text_label_center = {
						text = "WINDOW_POD_WAR_OF_SEASONS_LEADERS"
						layoutpolicy_horizontal = expanding
					}
					vbox = {
						background = {
							using = Background_Area
						}

						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						min_height = 285
						max_height = 355

						window_POD_war_of_seasons_leader = {
							visible = "[ObjectsEqual(Character.GetFaith.GetReligion, GetReligionByKey('spring_court_religion').Self)]"
							blockoverride "character" {
								datacontext = "[Situation.MakeScope.GetVariable('spring_leader').Char]"
							}
							blockoverride "text" {
								text = "WINDOW_POD_WAR_OF_SEASONS_LEADERS_SPRING"
							}
							blockoverride "button" {
								button_standard_small = {
									size = { 150 30 }
									enabled = "[GetScriptedGui('spring_button_script').IsValid(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									tooltip = "[GetScriptedGui('spring_button_script').BuildTooltip(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									onclick = "[GetScriptedGui('spring_button_script').Execute(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									text = "WINDOW_POD_WAR_OF_SEASONS_LEADERS_SPRING_BUTTON"
								}
							}
						}
						window_POD_war_of_seasons_leader = {
							visible = "[ObjectsEqual(Character.GetFaith.GetReligion, GetReligionByKey('summer_court_religion').Self)]"
							blockoverride "character" {
								datacontext = "[Situation.MakeScope.GetVariable('summer_leader').Char]"
							}
							blockoverride "text" {
								text = "WINDOW_POD_WAR_OF_SEASONS_LEADERS_SUMMER"
							}
							blockoverride "button" { }
						}
						window_POD_war_of_seasons_leader = {
							visible = "[ObjectsEqual(Character.GetFaith.GetReligion, GetReligionByKey('autumn_court_religion').Self)]"
							blockoverride "character" {
								datacontext = "[Situation.MakeScope.GetVariable('autumn_leader').Char]"
							}
							blockoverride "text" {
								text = "WINDOW_POD_WAR_OF_SEASONS_LEADERS_AUTUMN"
							}
							blockoverride "button" {
								button_standard_small = {
									size = { 150 30 }
									visible = "[Not(ObjectsEqual(GetPlayer.Self,Situation.MakeScope.GetVariable('autumn_leader').Char))]"
									enabled = "[GetScriptedGui('autumn_button_script').IsValid(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									tooltip = "[GetScriptedGui('autumn_button_script').BuildTooltip(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									onclick = "[GetScriptedGui('autumn_button_script').Execute(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									text = "WINDOW_POD_WAR_OF_SEASONS_LEADERS_AUTUMN_BUTTON"
								}
							}
						}
						window_POD_war_of_seasons_leader = {
							visible = "[ObjectsEqual(Character.GetFaith.GetReligion, GetReligionByKey('winter_court_religion').Self)]"
							blockoverride "character" {
								datacontext = "[Situation.MakeScope.GetVariable('winter_leader').Char]"
							}
							blockoverride "text" {
								text = "WINDOW_POD_WAR_OF_SEASONS_LEADERS_WINTER"
							}
							blockoverride "button" { }
						}
						window_POD_war_of_seasons_leader = {
							visible = "[And(ObjectsEqual(Character.GetFaith.GetReligion, GetReligionByKey('solstice_court_religion').Self),ObjectsEqual(Character.Self,GetScriptedCharacterByHistoryID('POD_wraith_01').Self))]"
							blockoverride "character" {
								datacontext = "[Situation.MakeScope.GetVariable('solstice_leader').Char]"
							}
							blockoverride "text" {
								text = "WINDOW_POD_WAR_OF_SEASONS_LEADERS_SOLSTICE"
							}
							blockoverride "button" {
								button_standard_small = {
									size = { 200 40 }
									enabled = "[GetScriptedGui('solstice_button_script').IsValid(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									tooltip = "[GetScriptedGui('solstice_button_script').BuildTooltip(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									onclick = "[GetScriptedGui('solstice_button_script').Execute(GuiScope.SetRoot( GetPlayer.MakeScope ).End)]"
									text = "WINDOW_POD_WAR_OF_SEASONS_LEADERS_SOLSTICE_BUTTON"
								}
							}
						}
						window_POD_war_of_seasons_leader = {
							visible = "[And(ObjectsEqual(Character.GetFaith.GetReligion, GetReligionByKey('solstice_court_religion').Self),Not(ObjectsEqual(Character.Self,GetScriptedCharacterByHistoryID('POD_wraith_01').Self)))]"
							blockoverride "character" {
								datacontext = "[Situation.MakeScope.GetVariable('solstice_leader').Char]"
							}
							blockoverride "text" {
								text = "WINDOW_POD_WAR_OF_SEASONS_LEADERS_SOLSTICE_LEADER"
							}
							blockoverride "button" { }
						}
						expand = {}
					}
				}

				vbox = {
					name = "current_sub_region"
					margin_top = 2
					layoutpolicy_horizontal = expanding

					datacontext = "[SituationWindow.GetSelectedSubRegion]"
					datacontext = "[SituationSubRegion.GetCurrentPhase]"

					visible = "[SituationSubRegion.IsValid]"

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						min_height = 75

						margin = { 15 15 }

						datacontext = "[SituationSubRegion.GetCharacterParticipantGroup( GetPlayer )]"

						background = {
							using = Background_Area
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							text_multi = {
								visible = "[Not( SituationParticipantGroup.IsValid )]"
								layoutpolicy_horizontal = expanding

								text = "SITUATION_WINDOW_NO_REGION_PARTICIPANT_GROUP"
								default_format = "#low"
								align = nobaseline
							}

							icon = {
								visible = "[SituationParticipantGroup.IsValid]"

								size = { 40 40 }
								texture = "[SituationParticipantGroup.GetType.GetIcon]"

								background = {
									texture = "gfx/interface/buttons/button_lifestyles_base.dds"
									margin = { 5 5 }
								}
							}

							vbox = {
								visible = "[SituationParticipantGroup.IsValid]"

								margin_left = 10
								text_single = {
									layoutpolicy_horizontal = expanding
									text = "[SituationParticipantGroup.GetName]"
									align = nobaseline
								}

								text_single = {
									layoutpolicy_horizontal = expanding

									text = "[SelectLocalization( Situation.HasMultipleSubRegions, 'SITUATION_WINDOW_YOUR_PARTICIPANT_GROUP_MULTI_SUBREGION', 'SITUATION_WINDOW_YOUR_PARTICIPANT_GROUP' ) ]"

									align = nobaseline
									default_format = "#Weak"
								}
							}

							expand = {}

							button_standard_small = {
								onclick = "[SituationWindow.AccessParticipantCharacterList.Toggle]"
								text = "SITUATION_WINDOW_VIEW_PARTICIPANT_GROUPS"
							}
						}
					}

					vbox = {
						layoutpolicy_horizontal = expanding

						margin = { 15 15 }

						background = {
							using = Background_Area
						}

						vbox  = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin_top = 15
							
							visible = "[EqualTo_string( 'PoD_war_of_seasons_situation_status_quo' , Situation.GetTopCurrentPhase.GetType.GetKey )]"

							hbox = {
								layoutpolicy_horizontal = expanding
								widget = {
									size = { 200 25 }
									text_single = {
										layoutpolicy_horizontal = growing
										position = { 0 0 }

										text = "[GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_war').GetName]"
										align = nobaseline|left
									}
								}
								hbox = {
									layoutpolicy_horizontal = expanding

									text_single = {
										layoutpolicy_horizontal = expanding

										text = "[GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_status_quo').GetName]"
										align = nobaseline|center
									}

								}
								widget = {
									size = { 200 25 }
									text_single = {
										layoutpolicy_horizontal = growing
										position = { 129 0 }

										text = "[GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_peace').GetName]"
										align = nobaseline|right
									}
								}
							}

							spacer = {
								size = { 0 25 }
							}

							widget = {
								allow_outside = yes
								size = { 505 40 }

								icon = {
									parentanchor = center
									size = { 240 20 }
									position = { -100 0 }
									texture = "gfx/interface/window_scheme/scheme_success_progressbar_bg.dds"
								}
								icon = {
									parentanchor = center
									size = { 240 20 }
									position = { 120 0 }
									texture = "gfx/interface/window_scheme/scheme_success_progressbar_bg.dds"
								}

								progressbar_standard_transparent = {
									parentanchor = left|vcenter
									size = { 230 20 }
									position = { 25 0 }
									allow_outside = yes

									min = 0 #Hardcoded, since for 100 I use other bar
									max = 50

									value = "[SituationPhase.GetFuturePhaseByType(GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_war')).GetProgress]"
									progresstexture = "gfx/interface/progressbars/progress_orange.dds"
									noprogresstexture = "gfx/interface/progressbars/blank.dds"
									invertprogress = yes

									tooltip = "WINDOW_POD_WAR_OF_SEASONS_PROGRESSBAR_WAR"
								}
								progressbar_standard_transparent = {
									parentanchor = left|vcenter
									size = { 230 20 }
									position = { 250 0 }
									allow_outside = yes

									min = 0 #Hardcoded, since for 100 I use other bar
									max = 50

									value = "[SituationPhase.GetFuturePhaseByType(GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_peace')).GetProgress]"
									progresstexture = "gfx/interface/progressbars/progress_grandeur_increase.dds"
									noprogresstexture = "gfx/interface/progressbars/blank.dds"

									tooltip = "WINDOW_POD_WAR_OF_SEASONS_PROGRESSBAR_PEACE"
								}

								widget_level_marker = {
									position = { -225 0 }
									allow_outside = yes

									icon = {
										name = "current_phase_icon"
										size = { 40 40 }
										texture = "[GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_war').GetIcon]"
										parentanchor = center
									}

									blockoverride "visible_active" {
										visible = yes
									}

									blockoverride "highlight_addon" {
										visible = no
									}
									tooltip = "[GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_war').GetDesc]"
								}
								widget_level_marker = {
									position = { 0 0 }
									allow_outside = yes

									icon = {
										name = "current_phase_icon"
										size = { 40 40 }
										texture = "[GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_status_quo').GetIcon]"
										parentanchor = center
									}

									blockoverride "visible_active" {
										visible = yes
									}

									blockoverride "highlight_addon" {
										visible = yes
									}
									tooltip = "[GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_status_quo').GetDesc]"
								}
								widget_level_marker = {
									position = { 225 0 }
									allow_outside = yes

									icon = {
										name = "current_phase_icon"
										size = { 40 40 }
										texture = "[GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_peace').GetIcon]"
										parentanchor = center
									}

									blockoverride "visible_active" {
										visible = yes
									}

									blockoverride "highlight_addon" {
										visible = no
									}
									tooltip = "[GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_peace').GetDesc]"
								}
							}

							spacer = {
								size = { 0 25 }
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								button_standard_small = {
									size = { 60 25 }

									down = "[ObjectsEqual( SituationWindow.GetSelectedFuturePhaseType().Self, GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_war') )]"
									onclick = "[SituationWindow.ToggleSelectedFuturePhaseType( GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_war') )]"
									text = "SITUATION_WINDOW_VIEW_PHASE"
								}
								expand = {}
								button_standard_small = {
									size = { 60 25 }

									down = "[ObjectsEqual( SituationWindow.GetSelectedFuturePhaseType().Self, GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_peace') )]"
									onclick = "[SituationWindow.ToggleSelectedFuturePhaseType( GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_peace') )]"
									text = "SITUATION_WINDOW_VIEW_PHASE"
								}
							}
						}

						vbox  = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin_top = 15
							
							visible = "[Not(EqualTo_string( 'PoD_war_of_seasons_situation_status_quo' , Situation.GetTopCurrentPhase.GetType.GetKey ))]"

							hbox = {
								layoutpolicy_horizontal = expanding
								widget = {
									size = { 200 25 }
									text_single = {
										layoutpolicy_horizontal = growing
										position = { 0 0 }

										text = "[SituationWindow.GetSelectedSubRegion.GetCurrentPhase.GetType.GetName]"
										align = nobaseline|left
									}
								}
								widget = {
									size = { 200 25 }
									text_single = {
										layoutpolicy_horizontal = growing
										position = { 129 0 }

										text = "[SituationWindow.GetSelectedOrLeadingFuturePhaseType.GetName]"
										align = nobaseline|right
									}
								}
							}

							spacer = {
								size = { 0 25 }
							}

							widget = {
								allow_outside = yes
								size = { 505 40 }

								icon = {
									parentanchor = center
									size = { 480 20 }
									position = { 0 0 }
									texture = "gfx/interface/window_scheme/scheme_success_progressbar_bg.dds"
								}

								progressbar_standard_transparent = {
									parentanchor = left|vcenter
									size = { 480 20 }
									position = { 20 0 }
									allow_outside = yes

									min = 0 #Hardcoded, since for 100 I use other bar
									max = 100

									value = "[SituationPhase.GetFuturePhaseByType(GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_war')).GetProgress]"
									progresstexture = "gfx/interface/progressbars/progress_purple.dds"
									noprogresstexture = "gfx/interface/progressbars/blank.dds"

									tooltip = "WINDOW_POD_WAR_OF_SEASONS_PROGRESSBAR_STATUS_QUO"
								}

								widget_level_marker = {
									position = { -225 0 }
									allow_outside = yes

									icon = {
										name = "current_phase_icon"
										size = { 40 40 }
										texture = "[SituationWindow.GetSelectedSubRegion.GetCurrentPhase.GetType.GetIcon]"
										parentanchor = center
									}

									blockoverride "visible_active" {
										visible = yes
									}

									blockoverride "highlight_addon" {
										visible = no
									}
									tooltip = "[GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_war').GetDesc]"
								}
								widget_level_marker = {
									position = { 225 0 }
									allow_outside = yes

									icon = {
										name = "current_phase_icon"
										size = { 40 40 }
										texture = "[SituationWindow.GetSelectedOrLeadingFuturePhaseType.GetIcon]"
										parentanchor = center
									}

									blockoverride "visible_active" {
										visible = yes
									}

									blockoverride "highlight_addon" {
										visible = no
									}
									tooltip = "[SituationWindow.GetSelectedOrLeadingFuturePhaseType.GetDesc]"
								}
							}

							spacer = {
								size = { 0 25 }
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								button_standard_small = {
									size = { 60 25 }

									down = "[ObjectsEqual( SituationWindow.GetSelectedFuturePhaseType().Self, GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_status_quo') )]"
									onclick = "[SituationWindow.ToggleSelectedFuturePhaseType( GetSituationType('PoD_war_of_seasons').GetPhaseType('PoD_war_of_seasons_situation_status_quo') )]"
									text = "SITUATION_WINDOW_VIEW_PHASE"
								}
							}
						}

						expand = {}

						
					}
				}


				vbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					datacontext = "[SituationWindow.GetSelectedOrLeadingFuturePhaseType]"

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding

						margin = { 15 15 }
						margin_top = 10

						background = {
							using = Background_Area
						}

						vbox = {
							name = "catalyst_information_area"

							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							### LOCATION EFFECTS & PREDICITON ###
							text_label_center = {
								layoutpolicy_horizontal = expanding
								text = "WINDOW_POD_WAR_OF_SEASONS_FUTURE_EFFECTS"
							}

							widget = {
								size = { 505 40 }

								fixedgridbox = {
									name = "leading_named_effect_sets"
									position = { 0 12 }

									addcolumn = 48
									addrow = 48
									setitemsizefromcell = yes
									datamodel_wrap = 6
									maxhorizontalslots = 6
									maxverticalslots = 1
									flipdirection = yes
									parentanchor = center

									datamodel = "[SituationWindow.GetSelectedOrLeadingFuturePhaseType.GetModifierNamedSets]"
									item = {
										button_phase_named_set_item = {
											enabled = yes
										}
									}
								}
							}

							spacer = {
								size = { 0 25 }
							}

							text_label_center = {
								layoutpolicy_horizontal = expanding
								text = "SITUATION_WINDOW_FUTURE_CATALYSTS_HEADER"
							}

							scrollbox = {
								layoutpolicy_vertical = expanding
								layoutpolicy_horizontal = expanding

								blockoverride "scrollbox_background" {}
								blockoverride "scrollbox_background_fade" {}
								blockoverride "scrollbox_margins" {}

								blockoverride "scrollbox_content"
								{
									vbox = {
										name = "catalyst_entries"
										datamodel = "[SituationWindow.GetCatalystsForSelectedPhase]"

										datacontext = "[SituationWindow.GetSelectedSubRegion.GetCurrentPhase]"

										layoutpolicy_vertical = expanding
										layoutpolicy_horizontal = expanding

										maximumsize = { 1000 50 }

										item = {
											hbox = {
												layoutpolicy_vertical = expanding
												layoutpolicy_horizontal = expanding

												hbox = {
													layoutpolicy_vertical = expanding

													background = {
														using = Background_Area_Dark
														using = Color_Green
														alpha = 0.1
														margin_left = 4
														margin_right = 6

													}

													background = {
														using = Background_Frame
														using = Color_Green
														alpha = 0.3
														margin_left = 4
														margin_right = 6

													}

													hbox = {
														layoutpolicy_horizontal = expanding
														icon = {
															size = { 25 25 }
															texture = "[SituationWindow.GetSelectedOrLeadingFuturePhaseType.GetIcon]"
														}
														text_single = {
															text = "[SituationCatalystEntry.GetPoints|-=]"
															align = nobaseline
														}
													}
												}

												text_multi = {
													layoutpolicy_horizontal = expanding
													layoutpolicy_vertical = expanding
													text = "[SituationCatalystEntry.GetCatalystDescription]"
													autoresize = no
													align = left|nobaseline
													max_width = 400
													margin = { 10 5 }
												}

												background = {
													using = Background_Area_Dark
												}

												hbox = {
													layoutpolicy_vertical = expanding
													min_width = 70

													background = {
														visible = "[GreaterThan_int32( SituationPhase.GetNumCompletionsOfCatalystForPhase( SituationWindow.GetSelectedOrLeadingFuturePhaseType, SituationCatalystEntry.GetCatalyst ), '(int32)0' )]"
														using = Background_Frame
														color = { 0.4 0.603 0.298 1 }
														alpha = 0.6
													}

													background = {
														visible = "[GreaterThan_int32( SituationPhase.GetNumCompletionsOfCatalystForPhase( SituationWindow.GetSelectedOrLeadingFuturePhaseType, SituationCatalystEntry.GetCatalyst ), '(int32)0' )]"
														using = Background_Area
														color = { 0.4 0.603 0.298 1 }
														alpha = 0.1
													}

													background = {
														visible = "[EqualTo_int32( SituationPhase.GetNumCompletionsOfCatalystForPhase( SituationWindow.GetSelectedOrLeadingFuturePhaseType, SituationCatalystEntry.GetCatalyst ), '(int32)0' )]"
														using = Background_Frame
														using = Color_Grey
														alpha = 0.4
													}

													background = {
														visible = "[EqualTo_int32( SituationPhase.GetNumCompletionsOfCatalystForPhase( SituationWindow.GetSelectedFuturePhaseType, SituationCatalystEntry.GetCatalyst ), '(int32)0' )]"
														using = Background_Area
														using = Color_Grey
														alpha = 0.1
													}

													text_single = {
														min_width = 70
														min_height = 50
														layoutpolicy_vertical = expanding

														align = nobaseline|center
														raw_text = "[Select_CString(GreaterThan_int32( SituationPhase.GetNumCompletionsOfCatalystForPhase( SituationWindow.GetSelectedOrLeadingFuturePhaseType, SituationCatalystEntry.GetCatalyst ), '(int32)0'), '#COLOR_GREEN ', '#COLOR_GRAY ')]x[SituationPhase.GetNumCompletionsOfCatalystForPhase(SituationWindow.GetSelectedOrLeadingFuturePhaseType, SituationCatalystEntry.GetCatalyst)]#!"
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

	window_situation_participant_groups = {
		datacontext = "[SituationWindow.AccessParticipantCharacterList]"
		datacontext = "[SituationParticipantCharacterList.AccessCharacterList]"
		visible = "[SituationParticipantCharacterList.IsVisible]"

		datacontext = "[SituationWindow.GetSelectedSubRegion]"
		blockoverride "header_text"
		{
			text = "[SituationWindow.GetParticipationWindowHeader]"
		}
	}
}

types window_POD_war_of_seasons_types {
	type window_POD_war_of_seasons_leader = hbox {
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding
			margin = { 15 5 }

		portrait_body = {
			block "character" {
				datacontext = "[GetPlayer]"
			}
			size = { 250 300 }
			visible = "[And(Character.IsValid,Not(ObjectsEqual(Character.Self,GetScriptedCharacterByHistoryID('POD_wraith_01').Self)))]"
			parentanchor = left
		}
		vbox = {
			block "character" {
				datacontext = "[GetPlayer]"
			}
			margin = { 5 15 }
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding
			vbox = {
				visible = "[And(Character.IsValid,Not(ObjectsEqual(Character.Self,GetScriptedCharacterByHistoryID('POD_wraith_01').Self)))]"
				text_label_center = {
					text = "[Character.GetName]"
					layoutpolicy_horizontal = expanding
				}
				text_single = {
					text = "[Character.Custom('PODWarOfSeasonsLeader')]"
					default_format = "#weak"
				}
			}
			spacer = {
				visible = "[And(Character.IsValid,Not(ObjectsEqual(Character.Self,GetScriptedCharacterByHistoryID('POD_wraith_01').Self)))]"
				size = { 0 25 }
			}
			text_multi = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				block "text" {
					raw_text = "EXAMPLE TEXT" 
				}
				autoresize = no
				multiline = yes
				align = nobaseline|center
			}
			block "button" {
				button_standard_small = {
					raw_text = "Button"
				}
			}
		}
	}
}