				vbox = {
					name = "powerful_vassals"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 0 20 }

					background = {
						using = Background_Area
					}

					expand = {}

					vbox = {
						spacing = 6

						text_label_center = {
							text = "FAITH_DOCTRINE_CHANGE_WINDOW_POWERFUL_VASSALS"
						}

						text_multi = {
							text = "FAITH_DOCTRINE_CHANGE_WINDOW_POWERFUL_VASSALS_DESC"
							default_format = "#weak"
							autoresize = yes
							max_width = 500
						}
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						margin_left = 28

						fixedgridbox = {
							name = "elector_box"
							datamodel = "[GetPlayer.MakeScope.GetList('doctrine_elector_list')]"
							layoutpolicy_horizontal = expanding

							addcolumn = 120
							addrow = 155
							datamodel_wrap = 8
							flipdirection = yes

							item = {
								flowcontainer = {
									datacontext = "[Scope.GetCharacter]"
									datacontext = "[GetScriptedGui( 'opposing_doctrine_change' )]"
									direction = vertical

									portrait_head = {}

									flowcontainer = {
										visible = "[ScriptedGui.IsValid(GuiScope.SetRoot(Character.MakeScope).AddScope( 'player', GetPlayer.MakeScope ).End)]"
										parentanchor = hcenter
										ignoreinvisible = yes
										tooltip = "FAITH_DOCTRINE_CHANGE_WINDOW_POWERFUL_OPPOSE_TT"
										using = tooltip_se

										icon = {
											name = "X_opposing"
											size = { 30 30 }
											texture = "gfx/interface/icons/symbols/icon_cross.dds"
										}

										text_single = {
											name = "opposes"
											text = "FAITH_DOCTRINE_CHANGE_WINDOW_POWERFUL_OPPOSE"
										}
									}

									text_single = {
										name = "approves"
										visible = "[Not(ScriptedGui.IsValid(GuiScope.SetRoot(Character.MakeScope).AddScope( 'player', GetPlayer.MakeScope ).End))]"
										parentanchor = hcenter
										text = "FAITH_DOCTRINE_CHANGE_WINDOW_POWERFUL_APPROVE"

										tooltip = "FAITH_DOCTRINE_CHANGE_WINDOW_POWERFUL_APPROVE_TT"
										using = tooltip_se
									}
								}
							}
						}
					}

					expand = {}
				}
			}
		
			vbox = {
				name = "footer"
				layoutpolicy_horizontal = expanding
				spacing = 10
				margin_bottom = 12

				text_single = {
					text = "FAITH_DOCTRINE_CHANGE_WINDOW_ENACT_COST"
					datacontext = "[GuiScope.SetRoot( GetPlayer.MakeScope ).GetScriptValueBreakdown( 'POD_doctrine_change_value' )]"

					tooltipwidget = {
						widget_value_breakdown_tooltip = {}
					}
					using = Font_Size_Medium
				}

				hbox = {
					name = "control_buttons"
					spacing = 20

					button_standard = {
						name = "close_button"
						datacontext = "[GetScriptedGui( 'cancel_doctrine_change' )]"
						onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						onclick = "[GetVariableSystem.Clear('doctrine_tab_choice')]"
						onclick = "[GetVariableSystem.Toggle('faith_doctrine_change_window_open')]"
						text = "CANCEL"
						using = tooltip_above
					}

					button_primary = {
						name = "enact_button"
						datacontext = "[GetScriptedGui( 'apply_doctrine_change' )]"
						enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

						text = "FAITH_DOCTRINE_CHANGE_WINDOW_CHANGE"

						using = tooltip_above
						tooltip = "[ScriptedGui.BuildTooltip(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					}
				}
			}
		}
	}
}

types Buttons
{
    type button_change_doctrine = button_standard_hover
	{
		tooltip = "FAITH_DOCTRINE_GENERAL_TOOLTIP"
		onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
		size = { 210 53 }
		background = {
			using = Background_Area
			margin = { 5 5 }
		}

		hbox = {
			name = "faith_list_item"
			spacing = 5
			using = tooltip_nw
			tooltip = "FAITH_WINDOW_DOCTRINE_TOOLTIP"

			icon_doctrine = {
				name = "doctrine_icon"
				size = { 50 50 }
				block "doctrine_icon_texture"
				{
					texture = "[FaithDoctrine.GetGroup.GetIcon]"
				}

				#alpha = "[Select_float( GetPlayer.GetFaith.HasDoctrine( GetPlayer.GetFaith.GetDoctrine ), '(float)0.4', '(float)1.0' )]"
			}

			vbox = {
				layoutpolicy_horizontal = expanding

				text_single = {
					name = "doctrine_group_name"
					text = "[FaithDoctrine.GetGroup.GetName( GetPlayer.GetFaith )]"
					align = left
					default_format = "#low"
					layoutpolicy_horizontal = expanding
					autoresize = no
					fontsize_min = 12
				}

				text_single = {
					name = "faith_name"
					text = "[FaithDoctrine.GetNameNoTooltip( GetPlayer.GetFaith )]"
					datacontext = "[GetPlayer.GetFaith]"
					layoutpolicy_horizontal = expanding
					elide = right
					autoresize = no
					fontsize_min = 12
					align = left
				}
			}
		}

		button_active_marker = {
			name = "victory_glow"
			visible = "[Not(ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		}

		icon = {
			name = "victory_glow2"
			visible = "[Not(ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			size = { 100% 100% }
			texture = "gfx/interface/component_masks/mask_fade_circle.dds"
			using = Color_Orange
			alpha = 0.4
		}
	}

    type button_change_enlightenment = button_standard_hover
	{
		tooltip = "FAITH_DOCTRINE_GENERAL_TOOLTIP"
		onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		
		size = { 210 53 }
		background = {
			using = Background_Area
			margin = { 5 5 }
		}

		hbox = {
			name = "faith_list_item"
			spacing = 5
			using = tooltip_nw
			tooltip = "FAITH_WINDOW_DOCTRINE_TOOLTIP"

			icon_doctrine = {
				name = "doctrine_icon"
				size = { 50 50 }
				block "doctrine_icon_texture"
				{
					texture = "[FaithDoctrine.GetIcon]"
				}

				#alpha = "[Select_float( GetPlayer.GetFaith.HasDoctrine( GetPlayer.GetFaith.GetDoctrine ), '(float)0.4', '(float)1.0' )]"
			}

			vbox = {
				layoutpolicy_horizontal = expanding

				text_single = {
					name = "doctrine_group_name"
					text = "[FaithDoctrine.GetGroup.GetName( GetPlayer.GetFaith )]"
					align = left
					default_format = "#low"
					layoutpolicy_horizontal = expanding
					autoresize = no
					fontsize_min = 12
				}

				text_single = {
					name = "faith_name"
					text = "[FaithDoctrine.GetNameNoTooltip( GetPlayer.GetFaith )]"
					datacontext = "[GetPlayer.GetFaith]"
					layoutpolicy_horizontal = expanding
					elide = right
					autoresize = no
					fontsize_min = 12
					align = left
				}
			}
		}

		button_active_marker = {
			name = "victory_glow"
			visible = "[Not(ScriptedGui.IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
		}

		icon = {
			name = "victory_glow2"
			visible = "[Not(ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End))]"
			size = { 100% 100% }
			texture = "gfx/interface/component_masks/mask_fade_circle.dds"
			using = Color_Orange
			alpha = 0.4
		}
	}
}