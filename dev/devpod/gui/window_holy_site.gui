window = {
	name = "holy_site_window"
	widgetid = "holy_site_window"
	layer = middle
	parentanchor = vcenter
	size = { 560 920 }
	alwaystransparent = yes

	position = { 600 0 }

	datacontext = "[GetVariableSystem]"
	datacontext = "[HolySiteWindow.GetHolySite]"
	datacontext = "[HolySiteWindow.GetHolySite.GetInventory]"
	datacontext = "[HolySiteWindow.GetHolySiteItem]"

	allow_outside = yes

	using = Window_Movable

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard

		on_start = "[GetVariableSystem.Clear( 'expand_elevate_demote' )]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
	}

	state = {
		name = "auto_open_inventory"
		trigger_when = "[And3( Or3( HolySite.GetCounty.GetHolder.IsLocalPlayer, HolySite.GetCounty.GetHolder.GetTopLiege.IsLocalPlayer, HolySite.GetBarony.GetProvince.GetClericalRegionHolder.IsLocalPlayer ), DataModelHasItems( HolySiteWindow.GetEnshrinableArtifacts ), LessThan_int32( GetDataModelSize( HolySite.GetInventory.GetArtifacts ), GetDataModelSize( HolySiteWindow.GetSlots ) ) )]"
		on_start = "[GetVariableSystem.Set( 'holy_site_inventory', 'yes' )]"
	}

	state = {
		name = "open_artifact"
		trigger_when = "[HolySiteWindow.GetSelectedArtifact.IsValid]"
		on_start = "[GetVariableSystem.Set( 'holy_site_inventory', 'yes' )]"
	}

	widget = {
		visible = "[GetVariableSystem.Exists( 'holy_site_inventory' )]"
		size = { 50 100% }
		position = { 520 0 }
		alwaystransparent = yes

		state = {
			name = _show
			using = Animation_FadeIn_Standard
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Standard
		}

		background = {
			using = Background_Area_Dark
			alpha = 0.6
			margin = { 0 -10 }
		}
	}

	### Main window
	widget = {
		widgetid = "holy_site"
		size = { 560 100% }
		allow_outside = yes
		alwaystransparent = no

		using = Window_Background
		using = Window_Decoration

		vbox = {
			using = Window_Margins
			spacing = -8

			header_pattern = {
				datacontext = "[HolySite.GetBarony]"
				layoutpolicy_horizontal = expanding

				widget = {
					position = { 15 10 }
					size = { 30 28 }
					allow_outside = yes

					coa_title_tiny = {
						parentanchor = center
						allow_outside = yes
						tooltip_visible = no
						position = { 0 5 }
					}
				}

				blockoverride "header_text"
				{
					text = "HOLY_SITE_WINDOW_HEADER"
					margin_left = 10
				}

				blockoverride "button_close"
				{
					onclick = "[HolySiteWindow.Close]"
				}
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				margin_bottom = 10

				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 15 12 }
					margin_left = 5

					spacing = 10

					using = Background_Holy_Site_Header

					vbox = {
						layoutpolicy_vertical = expanding
						datacontext = "[HolySite.GetCounty]"

						hbox = {
							datacontext = "[Title.GetHolder]"
							datacontext =  "[HolySiteWindow.GetCompareToFaith]"
							margin = { 4 0 }
							margin_right = 8
							tooltip = "FAITH_HOLY_SITE_HOLDER_TOOLTIP"

							background = {
								visible = "[Not( HolySiteItem.IsHeldByFaith )]"
								margin_left = -1
								margin_top = 1
								margin_bottom = 1

								using = Status_Bad
								alpha = 0.8
							}

							background = {
								visible = "[HolySiteItem.IsHeldByFaith]"
								margin_top = 4
								margin_right = 4
								margin_bottom = 4

								using = Background_Area
								alpha = 0.8
							}

							button = {
								name = "faith_button"
								datacontext = "[Title.GetHolder.GetFaith]"
								size = { 55 55}

								onclick = "[OpenGameViewData( 'faith', Faith.GetMainRite.Self )]"

								texture = "[Faith.GetIcon]"
							}

							widget = {
								visible = "[Title.HasHolder]"
								datacontext = "[Title.GetHolder]"
								size = { 30 30 }
								coa_realm_tiny_crown = {
									parentanchor = center
									position = { 0 -3 }
									scale = 0.95
								}
							}
						}

						expand = {}
					}

					# name and type
					vbox = {
						datacontext = "[HolySite.GetType]"
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding
						spacing = -2
						margin_bottom = 2

						tooltip = "HOLY_SITE_TYPE_TOOLTIP"

						using = tooltip_se

						### Holy site name
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 10
							allow_outside = yes

							text_single = {
								name = "name_notheld"
								visible = "[Not( HolySiteItem.IsHeldByFaith )]"
								max_width = 180
								margin_bottom = 5

								text = "[HolySite.GetName]"
								align = nobaseline
								default_format = "#low"
								using = Font_Size_Big
							}

							text_single = {
								name = "name_held"
								visible = "[HolySiteItem.IsHeldByFaith]"
								max_width = 180
								margin_bottom = 5

								text = "[HolySite.GetName]"
								align = nobaseline
								default_format = "#high"
								using = Font_Size_Big
							}

							button_go_to_my_location = {
								datacontext = "[HolySite.GetBarony]"
								onclick = "[DefaultOnCoatOfArmsRightClick(Title.GetID)]"
								onrightclick = "[DefaultOnCoatOfArmsRightClick(Title.GetID)]"
								onrightclick = "[ToggleGameViewData( 'holding_view', Title.GetProvince.Self )]"
								button_ignore = none
								tooltip = "GOTO_OPEN_PROVINCE"
							}
							expand = {}
						}

						hbox = {
							layoutpolicy_horizontal = expanding

							text_single = {
								text = "FAITH_HOLY_SITE_EMINENCE_SUBSCRIPT"
								layoutpolicy_horizontal = expanding
								autoresize = no
								align = nobaseline
							}
						}

						expand = {}
					}

					button_round = {
						visible = no # CfV PoD: hide enshrinable artifacts button
						size = { 45 45 }

						onclick = "[GetVariableSystem.Toggle( 'holy_site_inventory' )]"
						down = "[GetVariableSystem.Exists( 'holy_site_inventory' )]"
						shortcut = "holy_site_inventory"

						tooltip = "OPEN_INVENTORY_FOR_HOLY_SITE_TOOLTIP"

						button_icon_highlight = {
							parentanchor = center
							size = { 30 30 }
							down = "[GetVariableSystem.Exists( 'holy_site_inventory' )]"
							texture = "gfx/interface/icons/flat_icons/inventory.dds"
						}

						text_single = {
							position = { 0 3 }
							parentanchor = bottom|hcenter

							background = {
								margin = { 5 0 }
								margin_top = -5
								using = Background_Area_Dark
							}

							text = "[GetDataModelSize( HolySiteWindow.GetEnshrinableArtifacts )]"
							default_format = "#glow_color:{0.1,0.1,0.1,1.0}"
						}
					}
				}

				vbox = {
					datacontext = "[HolySite.GetBarony]"
					datacontext = "[Title.GetProvince.GetHolding]"
					layoutpolicy_horizontal = expanding

					# Building
					hbox = {
						datacontext = "[HolySite.GetRelatedBuildingType]"
						visible = "[Building.IsValid]"
						layoutpolicy_horizontal = expanding
						spacing = 20
						margin = { 45 5 }
						margin_bottom = 10

						background = {
							using = Background_Area
							alpha = 0.5
						}

						background = {
							visible = "[Not( Holding.IsEmpty )]"
							texture = "[Holding.GetIllustration]"
							alpha = 0.3

							fittype = centercrop

							using = Mask_Rough_Edges

							modify_texture = {
								texture = "gfx/interface/window_county/mask_holding_illustration.dds"
								blend_mode = alphamultiply
								alpha = 0.6
							}

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
								blend_mode = alphamultiply
							}
						}

						background = {
							visible = "[Holding.IsEmpty]"
							texture = "[Holding.GetProvince.GetTerrain.GetIllustration]"
							alpha = 0.2

							fittype = centercrop

							using = Mask_Rough_Edges

							modify_texture = {
								texture = "gfx/interface/window_county/mask_holding_illustration.dds"
								blend_mode = alphamultiply
								alpha = 0.8
							}

							modify_texture = {
								texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
								blend_mode = alphamultiply
							}
						}

						proportional_icon = {
							texture = "[Building.GetTypeIcon]"
							size = { 70 70 }

							using = Master_Button_Modify_Texture

							enabled = "[HolySite.GetBarony.GetProvince.GetHolding.HasBuildingFromChain( Building.Self )]"

							alpha = "[Select_float( HolySite.GetBarony.GetProvince.GetHolding.HasBuildingFromChain( Building.Self ), '(float)1.0', '(float)0.6' )]"
						}

						vbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							margin_bottom = 4

							text_single = {
								layoutpolicy_horizontal = expanding
								text = "[Building.GetName]"
								max_width = 440
								autoresize = yes
								align = nobaseline
							}

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 10

								text_single = {
									text = "HOLY_SITE_WINDOW_HOLY_SITE_BUILDING_HEADER"
								}

								divider_light = {
									layoutpolicy_vertical = expanding
								}
								text_single = {
									layoutpolicy_horizontal = expanding
									autoresize = no

									text = "HOLY_SITE_WINDOW_HOLY_SITE_BUILDING_BUILT"
								}
							}
						}
					}

					vbox = {
						visible = no # CfV PoD: hide enshrined artifacts
						layoutpolicy_horizontal = expanding
						margin_top = 5

						### Artifact slots
						text_single = {
							layoutpolicy_horizontal = expanding
							text = "HOLY_SITE_WINDOW_SLOTS_HEADER"
							align = center
							using = Font_Size_Medium
							default_format = "#high"
						}

						flowcontainer = {
							name = "holy_site_slots"
							ignoreinvisible = yes
							direction = horizontal
							spacing = 8
							wrap_count = 3
							margin_top = -4

							background = {
								using = Background_Area
								margin = { 0 -30 }
								alpha = 0.8

								modify_texture = {
									texture = "gfx/interface/component_masks/mask_fade_horizontal_short.dds"
									blend_mode = alphamultiply
								}

								modify_texture = {
									texture = "gfx/interface/component_masks/mask_fade_horizontal_short.dds"
									blend_mode = alphamultiply
									mirror = horizontal
								}
							}

							datamodel = "[HolySiteWindow.GetSlots]"
							item = {
								widget_holy_site_slot = {}
							}
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							margin_bottom = 6

							hbox = {
								spacing = 1
								datamodel = "[GetSegmentedProgressTargetBar( GetDefine( 'NReligion','MAX_HOLY_SITE_RARITY_TOTAL' ), HolySite.GetTotalActiveArtifactRarity, HolySite.GetTotalActiveArtifactRarity)]"

								background = {
									margin = { 8 8 }
									using = Background_Area
								}

								item = {
									icon = {
										size = { 33 16 }

										texture = "gfx/interface/progressbars/progress_magnificence.dds"
										framesize = { 45 45 }
										frame = "[int32.GetInt]"
									}
								}
							}
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 6
							margin = { 0 6 }

							expand = {}

							hbox = {
								visible = "[NotZero( HolySite.GetTotalActiveArtifactRarity )]"
								spacing = 6

								text_single = {
									max_width = 400
									text = "HOLY_SITE_TOTAL_RARITY_LEVELS"
									align = nobaseline
								}

								text_single = {
									text = "[HolySite.GetTotalActiveArtifactRarity]"
									default_format = "#high"
									align = nobaseline
								}
							}

							hbox = {
								visible = "[IsZero( HolySite.GetTotalActiveArtifactRarity )]"
								spacing = 6

								text_single = {
									max_width = 400
									text = "HOLY_SITE_TOTAL_RARITY_LEVELS"
									align = nobaseline
									default_format = "#low"
								}

								text_single = {
									text = "[HolySite.GetTotalActiveArtifactRarity]"
									align = nobaseline
								}
							}

							expand = {}
						}
					}
				}

				### Effect description
				scrollbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					blockoverride "scrollbox_margins" {
						margin = { 5 15 }
						margin_right = 10
					}

					blockoverride "scrollbox_content" {
						vbox = {
							layoutpolicy_horizontal = expanding
							margin = { 10 0 }
							spacing = 10

							datacontext = "[HolySite.GetCounty.GetHolder.GetFaith]"

							vbox_holy_site_effects = {
								visible = no # CfV PoD: hide holy site effects (for now)
								spacing = 10
							}

							vbox = {
								datamodel = "[HolySiteWindow.GetActiveHolySiteFaiths]"
								visible = "[Not( IsDataModelEmpty( HolySiteWindow.GetActiveHolySiteFaiths ) )]"
								layoutpolicy_horizontal = expanding
								margin_top = 20

								text_label_center = {
									layoutpolicy_horizontal = expanding
									min_height = 26 # This helps with weird auto-layouting issues
									autoresize = no # This helps with weird auto-layouting issues
									text =  "HOLY_SITE_WINDOW_HOLY_SITE_FAITHS_HEADER"
								}

								item = {
									holy_site_faith_item = {}
								}
							}

							vbox = {
								datamodel = "[HolySiteWindow.GetInactiveHolySiteFaiths]"
								visible = "[Not( IsDataModelEmpty( HolySiteWindow.GetInactiveHolySiteFaiths ) )]"
								layoutpolicy_horizontal = expanding
								margin_top = 20

								text_label_center = {
									layoutpolicy_horizontal = expanding
									text =  "HOLY_SITE_WINDOW_HOLY_SITE_FAITHS_INACTIVE_HEADER"
								}

								item = {
									holy_site_faith_item = {}
								}
							}
						}
					}
				}

				### Decision shortcuts (elevate / demote)
				hbox = {
					layoutpolicy_horizontal = expanding
					spacing = 8
					margin_top = 14
					margin_bottom = 4
					datacontext = "[GetPlayer.GetFaith]"

					expand = {}

					blockoverride "show_puppet_flag" {
						visible = "[And( Decision.IsEnabledByPuppet, Not( IsHoF( GetPlayer ) ) )]"
					}

					hbox = {
						datacontext = "[PdxGuiWidget.MakeDecisionTypeWithParam( 'elevate_holy_site_decision', 'selected_item', HolySite.MakeScope )]"
						visible = "[HolySiteWindow.IsElevateButtonVisible]"

						button_decision_entry_with_parameters = {
							size = { 220 35 }
							onclick = "[OpenGameViewData( 'decision_detail', DecisionTypeWithParams.Self )]"
							onclick = "[HolySiteWindow.Close]"
							using = tooltip_ne
						}
					}

					hbox = {
						datacontext = "[PdxGuiWidget.MakeDecisionTypeWithParam( 'demote_holy_site_decision', 'selected_item', HolySite.MakeScope )]"
						visible = "[HolySiteWindow.IsDemoteButtonVisible]"

						button_decision_entry_with_parameters = {
							size = { 220 35 }
							onclick = "[OpenGameViewData( 'decision_detail', DecisionTypeWithParams.Self )]"
							onclick = "[HolySiteWindow.Close]"
							using = tooltip_ne
						}
					}

					hbox = {
						datacontext =  "[PdxGuiWidget.MakeDecisionTypeWithParam( 'abandon_holy_site_decision', 'selected_item', HolySite.MakeScope )]"
						visible = "[HolySiteWindow.IsAbandonButtonVisible]"

						button_decision_entry_with_parameters = {
							size = { 220 35 }
							onclick = "[OpenGameViewData( 'decision_detail', DecisionTypeWithParams.Self )]"
							onclick = "[HolySiteWindow.Close]"
							using = tooltip_ne
						}
					}

					hbox = {
						datacontext =  "[PdxGuiWidget.MakeDecisionTypeWithParam( 'adopt_holy_site_decision', 'selected_item', HolySite.MakeScope )]"
						visible = "[HolySiteWindow.IsAdoptButtonVisible]"

						button_decision_entry_with_parameters = {
							size = { 220 35 }
							onclick = "[OpenGameViewData( 'decision_detail', DecisionTypeWithParams.Self )]"
							onclick = "[HolySiteWindow.Close]"
							using = tooltip_ne
						}
					}

					expand = {}
				}
			}
		}

		### Inventory
		widget = {
			visible = "[GetVariableSystem.Exists( 'holy_site_inventory' )]"
			position = { 530 0 }
			size = { 710 100% }
			alwaystransparent = no

			using = Window_Background
			using = Window_Decoration_Flat

			state = {
				name = _show
				using = Animation_FadeIn_Standard
			}

			state = {
				name = _hide
				using = Animation_FadeOut_Standard
			}

			vbox = {
				using = Window_Margins
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				header_pattern = {
					layoutpolicy_horizontal = expanding

					blockoverride "header_text"
					{
						text = "INVENTORY_TITLE"
					}

					blockoverride "button_close"
					{
						onclick = "[GetVariableSystem.Clear( 'holy_site_inventory' )]"
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					margin = { 20 8 }
					spacing = 16

					### RIGHT — PLAYER ARTIFACT PICKER + ACTION BUTTON
					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 6

						datacontext = "[GetPlayer]"

						# the artifact tooltip in both scrollboxes
						blockoverride "extra_information" {
							vbox = {
								layoutpolicy_horizontal = expanding
								margin_top = 10
								spacing = 10

								divider_light = {
									layoutpolicy_horizontal = expanding
								}
								hbox = {
									layoutpolicy_horizontal = expanding

									text_multi = {
										text = "[HolySiteWindow.GetEnshrineTooltip( Artifact.Self )]"
										max_width = 500
										autoresize = yes
										using = Font_Size_Small
									}

									expand = {}
								}
							}
						}

						blockoverride "rarity_level" {
							hbox_artifact_rarity_level = {}
						}

						hbox = {
							layoutpolicy_horizontal = expanding

							margin_left = 30

							text_single = {
								layoutpolicy_horizontal = expanding
								margin_bottom = 2
								autoresize = no

								text = "HOLY_SITE_WINDOW_PICKER_HEADER"
								align = center|nobaseline
								using = Font_Size_Medium
							}

							button_menu = {
								onclick = "[GetVariableSystem.Toggle( 'holy_site_compact' )]"
								shortcut = "holy_site_compact"
								tooltip = "MY_REALM_COMPACT_SUBJECT_LIST"
							}
						}

						scrollbox = {
							visible = "[Not( GetVariableSystem.Exists( 'holy_site_compact' ) )]"
							layoutpolicy_horizontal = expanding
							size = { 0 425 }

							blockoverride "scrollbox_content" {
								fixedgridbox = {
									name = "equippable_artifacts_list"
									datamodel = "[HolySiteWindow.GetEnshrinableArtifacts]"
									layoutpolicy_horizontal = expanding

									addcolumn = 560
									addrow = 116

									item = {
										widget_artifact_entry = {
											blockoverride "background_button_overrides" {
												onclick = "[HolySiteWindow.SelectArtifact( Artifact.Self )]"
												down = "[HolySiteWindow.IsArtifactSelected( Artifact.Self )]"
												onrightclick = "[ToggleGameViewData( 'artifact_details', Artifact.GetID )]"
												onrightclick = "[LocalPlayerNewArtifacts.RemoveNewArtifact( Artifact.Self )]"
												button_ignore = none
											}
										}
									}
								}
							}

							blockoverride "scrollbox_empty"
							{
								visible = "[IsDataModelEmpty( HolySiteWindow.GetEnshrinableArtifacts )]"
								text = "HOLY_SITE_NO_ENSHRINEABLE_ARTIFACTS"
							}
						}

						scrollbox = {
							visible = "[GetVariableSystem.Exists( 'holy_site_compact' )]"
							layoutpolicy_horizontal = expanding
							size = { 0 320 }

							blockoverride "scrollbox_content" {
								fixedgridbox = {
									name = "equippable_artifacts_list"

									addcolumn = 100
									addrow = 100
									flipdirection = yes
									datamodel_wrap = 5

									datamodel = "[HolySiteWindow.GetEnshrinableArtifacts]"

									item = {
										button_standard_hover = {
											size = { 90 90 }
											down = "[HolySiteWindow.IsArtifactSelected( Artifact.Self )]"

											button_artifact = {
												blockoverride "on_click" {
													onclick = "[HolySiteWindow.SelectArtifact( Artifact.Self )]"
													onrightclick = "[ToggleGameViewData( 'artifact_details', Artifact.GetID )]"
													onrightclick = "[LocalPlayerNewArtifacts.RemoveNewArtifact( Artifact.Self )]"
													button_ignore = none
												}
											}
										}
									}
								}
							}

							blockoverride "scrollbox_empty"
							{
								visible = "[IsDataModelEmpty( HolySiteWindow.GetEnshrinableArtifacts )]"
								text = "HOLY_SITE_NO_ENSHRINEABLE_ARTIFACTS"
							}
						}

						### Action effect preview
						vbox = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							spacing = 4

							text_single = {
								layoutpolicy_horizontal = expanding
								text = "HOLY_SITE_ACTION_EFFECTS_HEADER"
								align = center|nobaseline
								using = Font_Size_Small
								default_format = "#weak"
							}

							scrollbox = {
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding

								blockoverride "scrollbox_content" {
									vbox = {
										layoutpolicy_horizontal = expanding
										margin = { 10 5 }

										text_multi = {
											visible = "[HolySiteWindow.GetSelectedArtifact.IsValid]"
											layoutpolicy_horizontal = expanding
											text = "[HolySiteWindow.GetSelectedActionEffectDesc]"
											autoresize = yes
											max_width = 560
										}

										text_single = {
											visible = "[Not( HolySiteWindow.GetSelectedArtifact.IsValid )]"
											min_height = 130
											align = center
											layoutpolicy_horizontal = expanding
											text = "HOLY_SITE_SELECT_ARTIFACT_OR_SLOT"
											autoresize = yes
										}
									}
								}
							}
						}

						### Action buttons
						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 8
							margin_top = 8

							expand = {}

							button_standard = {
								text = "HOLY_SITE_ACTION_BUTTON_REMOVE"
								enabled = "[HolySiteWindow.IsRemoveButtonEnabled]"
								tooltip = "[HolySiteWindow.GetRemoveButtonTooltip]"
								onclick = "[HolySiteWindow.OnRemoveButtonClicked]"
								shortcut = "holy_site_remove_artifact"
							}

							button_primary = {
								text = "HOLY_SITE_ACTION_BUTTON_SWAP"
								visible = "[HolySiteWindow.HasSelectedFilledSlot]"
								enabled = "[HolySiteWindow.IsEnshrineButtonEnabled]"
								tooltip = "[HolySiteWindow.GetEnshrineButtonTooltip]"
								onclick = "[HolySiteWindow.OnEnshrineButtonClicked]"
							}

							button_primary = {
								text = "HOLY_SITE_ACTION_BUTTON_ENSHRINE"
								visible = "[Not( HolySiteWindow.HasSelectedFilledSlot )]"
								enabled = "[HolySiteWindow.IsEnshrineButtonEnabled]"
								tooltip = "[HolySiteWindow.GetEnshrineButtonTooltip]"
								onclick = "[HolySiteWindow.OnEnshrineButtonClicked]"
							}
							expand = {}
						}
					}
				}
			}
		}
	}
}

types HolySiteWindowTypes
{
	type widget_holy_site_slot = widget
	{
		# Requires:
		# datacontext = InventorySlot
		# datacontext = HolySiteWindow (inherited from window scope)
		size = { 150 140 }

		state = {
			name = "open_slot"
			trigger_when = "[HolySiteWindow.IsSelectedSlot( InventorySlot.Self )]"
			on_start = "[GetVariableSystem.Set( 'holy_site_inventory', 'yes' )]"
		}

		glow_effect = {
			visible = "[HolySiteWindow.IsSelectedSlot( InventorySlot.Self )]"
		}

		widget = {
			using = Window_Background_NoDecoration
			size = { 100% 100% }
		}

		button_artifact = {
			name = "enshrined_artifact_button"
			datacontext = "[InventorySlot.GetArtifact]"
			visible = "[Not( InventorySlot.IsEmpty )]"
			parentanchor = center
			size = { 100 100 }
			allow_outside = yes

			using = tooltip_es

			onclick = "[HolySiteWindow.SelectArtifact( Artifact.Self )]"
			onclick = "[HolySiteWindow.ToggleSelectedSlot( InventorySlot.Self )]"
			onrightclick = "[ToggleGameViewData( 'artifact_details', Artifact.GetID )]"
			onrightclick = "[LocalPlayerNewArtifacts.RemoveNewArtifact( Artifact.Self )]"
			button_ignore = none
			down = "[Or( HolySiteWindow.IsArtifactSelected( Artifact.Self ), HolySiteWindow.IsSelectedSlot( InventorySlot.Self ) )]"

			icon = {
				visible = "[Not( Artifact.IsHolyRelicFor( HolySite.GetCounty.GetHolder.GetFaith.Self ) )]"
				parentanchor = hcenter|bottom
				size = { 25 25 }
				alwaystransparent = yes

				texture = "gfx/interface/icons/symbols/icon_warning.dds"
			}

			blockoverride "rarity_level" {
				hbox_artifact_rarity_level = {}
			}

			blockoverride "not_holy" {
				hbox = {
					layoutpolicy_horizontal = expanding
					datacontext = "[HolySite.GetCounty.GetHolder.GetFaith]"
					spacing = 5

					icon = {
						visible = "[Not( Artifact.IsHolyRelicFor( HolySite.GetCounty.GetHolder.GetFaith.Self ) )]"
						size = { 20 20 }
						texture = "gfx/interface/icons/symbols/icon_warning.dds"
					}

					text_single = {
						text =  "ARTIFACT_IS_HOLY_RELIC"
						max_width = 350
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
					expand = {}
				}
			}

			blockoverride "extra_information" {
				vbox = {
					layoutpolicy_horizontal = expanding
					margin_top = 10
					spacing = 10

					divider_light = {
						layoutpolicy_horizontal = expanding
					}

					hbox = {
						layoutpolicy_horizontal = expanding

						text_multi = {
							autoresize = yes
							max_width = 440
							text = "[HolySiteWindow.GetRemoveTooltip( Artifact.Self )]"
						}

						expand = {}
					}
				}
			}

			blockoverride "on_click"
			{
				alwaystransparent = yes
			}

			state = {
				name = _mouse_hierarchy_enter
				on_start = "[PdxGuiWidget.FindChild('remove_button').TriggerAnimation('hover_enter')]"
			}

			state = {
				name = _mouse_hierarchy_leave
				on_start = "[PdxGuiWidget.FindChild('remove_button').TriggerAnimation('hover_leave')]"
			}

			button_round = {
				name = "remove_button"
				parentanchor = top|right
				size = { 30 30 }

				enabled = "[HolySiteWindow.CanRemoveEnshrinedArtifact( Artifact.Self )]"
				alpha = 0

				state = {
					name = hover_enter
					alpha = 1
					duration = 0.4
					using = Animation_Curve_Default
				}

				state = {
					name = hover_leave
					alpha = 0
					duration = 0.6
					using = Animation_Curve_Default
				}

				alwaystransparent = yes

				button_icon_highlight = {
					parentanchor = center
					size = { 30 30 }
					texture = "gfx/interface/icons/flat_icons/cancel_small.dds"
				}
			}
		}

		# Empty-slot placeholder
		button_standard_clean = {
			name = "empty_slot_button"
			datacontext = "[InventorySlot]"
			visible = "[InventorySlot.IsEmpty]"
			parentanchor = center
			size = { 70 70 }

			onclick = "[HolySiteWindow.ToggleSelectedSlot( InventorySlot.Self )]"
			down = "[HolySiteWindow.IsSelectedSlot( InventorySlot.Self )]"
			tooltip = "HOLY_SITE_INVENTORY_SLOT_TT"

			button_plus = {
				datacontext = "[HolySite.GetCounty]"
				visible = "[And( Or3( Title.GetHolder.IsLocalPlayer, Title.GetHolder.GetTopLiege.IsLocalPlayer, Title.GetProvince.GetClericalRegionHolder.IsLocalPlayer ), DataModelHasItems( HolySiteWindow.GetEnshrinableArtifacts ) )]"
				parentanchor = center
				alwaystransparent = yes
			}
		}
	}

	type holy_site_faith_item = widget
	{
		name = "show_faith_info"
		size = { 0 40 }
		layoutpolicy_horizontal = expanding
		
		# CfV PoD: hide vanilla/modern faiths
		visible = "[And( GetScriptedGui('POD_hide_vanilla_religions').IsShown(GuiScope.SetRoot(Faith.GetReligion.MakeScope).End), GetScriptedGui('POD_hide_modern_faiths').IsShown(GuiScope.SetRoot(Faith.MakeScope).End) )]"

		background = {
			visible = "[ObjectsEqual( Faith.Self, HolySiteWindow.GetCompareToFaith.Self )]"
			using = Background_Area
		}

		divider_light = {
			alpha = "[Select_float(GreaterThan_int32(Faith.GetNumberOfCountiesOfFaith,'(int32)0'), '(float)1.0','(float)0.5')]"
			size = { 100% 3 }
			parentanchor = bottom
			position = { 0 1 }
		}

		hbox = {
			margin = { 10 5 }
			alpha = "[Select_float(GreaterThan_int32(Faith.GetNumberOfCountiesOfFaith,'(int32)0'), '(float)1.0','(float)0.5')]"
			layoutpolicy_horizontal = expanding

			icon = {
				name = "faith_icon"
				texture = "[Faith.GetIcon]"
				size = { 30 30 }
			}

			vbox = {
				margin_left = 10
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				hbox = {
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					spacing = 10

					text_single = {
						name = "faith_name"

						text = "HOLY_SITE_FAITH_EMINENCE"
						align = left|nobaseline
						max_width = 240
					}

					expand = {}

					text_single = {
						name = "religion_faith_name"
						layoutpolicy_horizontal = expanding
						autoresize = no
						margin_right = 5

						text = "FAITH_RELIGION"
						align = right|nobaseline
					}
				}
			}
		}
	}

	type vbox_holy_site_effects = vbox {
		layoutpolicy_horizontal = expanding

		### warnings
		text_multi = {
			block "show_wrong_faith" {
				visible = "[Not( HolySiteItem.IsHeldByFaith )]"
			}
			layoutpolicy_horizontal = expanding
			text = "[HolySiteItem.GetControlDesc]"
			align = center|nobaseline
			max_width = 440
			autoresize = yes
		}

		text_multi = {
			visible = "[IsZero( HolySite.GetTotalActiveArtifactRarity )]"
			layoutpolicy_horizontal = expanding
			text = "HOLY_SITE_WINDOW_HOLY_SITE_NO_ENSHRINED_ARTIFACTS"
			align = center|nobaseline
			max_width = 440
			autoresize = yes
		}

		### headers
		hbox = {
			layoutpolicy_horizontal = expanding

			text_label_center = {
				visible = "[HolySite.IsActive]"

				text = "HOLY_SITE_WINDOW_HOLY_SITE_EFFECTS_HEADER"
				block "active_effects_format" {
					layoutpolicy_horizontal = expanding
				}
			}

			text_label_center = {
				visible = "[Not( HolySite.IsActive )]"
				text = "HOLY_SITE_WINDOW_HOLY_SITE_INACTIVE_EFFECTS_HEADER"
				block "inactive_effects_format" {
					layoutpolicy_horizontal = expanding
				}
			}

			expand = {}
		}

		# inactive effects
		text_multi = {
			visible = "[Not( HolySite.IsActive )]"
			layoutpolicy_horizontal = expanding
			text = "[HolySite.GetInactiveEffectDesc( Faith.Self )]"
			max_width = 440
			autoresize = yes
			alpha = 0.6
		}

		# active effects
		vbox = {
			visible = "[HolySite.IsActive]"
			layoutpolicy_horizontal = expanding
			spacing = 10

			# regular effects
			text_multi = {
				layoutpolicy_horizontal = expanding
				visible = "[Not( StringIsEmpty( HolySite.GetType.GetRegularEffectDesc( HolySiteItem.GetFaith.Self, HolySiteItem.GetHolySite.GetBarony.Self, IntToFixedPoint( HolySite.GetTotalActiveArtifactRarity ) ) ) )]"

				text = "[HolySite.GetType.GetRegularEffectDesc( Faith.Self, HolySiteItem.GetHolySite.GetBarony.Self, IntToFixedPoint( HolySite.GetTotalActiveArtifactRarity ) )]"
				max_width = 440
				autoresize = yes
			}

			# eminent effects
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 10

				divider_light = {
					visible = "[And( HolySiteItem.IsHeldByFaith, Faith.IsEminentHolySite( HolySite.Self ) )]"
					layoutpolicy_horizontal = expanding
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					visible = "[Or( Not( Faith.IsEminentHolySite( HolySite.Self ) ), Not( HolySiteItem.IsHeldByFaith ) )]"

					text_label_center = {
						text = "HOLY_SITE_WINDOW_HOLY_SITE_INACTIVE_EFFECTS_HEADER"
						block "inactive_effects_format" {
							layoutpolicy_horizontal = expanding
						}
					}
					expand = {}
				}

				text_multi = {
					layoutpolicy_horizontal = expanding
					max_width = 440
					autoresize = yes

					text = "[HolySite.GetType.GetEminentEffectDesc( Faith.Self, HolySiteItem.GetHolySite.GetBarony.Self, IntToFixedPoint( HolySite.GetTotalActiveArtifactRarity ) )]"
					alpha = "[Select_float( And( Faith.IsEminentHolySite( HolySite.Self ), HolySiteItem.IsHeldByFaith), '(float)1.0', '(float)0.6' )]"
				}
			}
		}
	}
}

template Background_Holy_Site_Header {
	background = {
		using = Background_Area_Light
	}

	background = {
		visible = "[Not(HolySiteItem.IsHeldByFaith )]"
		using = Status_Bad
		alpha = 0.35

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
			blend_mode = alphamultiply
		}
	}

	background = {
		visible = "[And( Not( HolySiteItem.GetHolySite.IsActive), HolySiteItem.IsHeldByFaith )]"
		using = Status_Highlight
		alpha = 0.3

		modify_texture = {
			texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
			blend_mode = alphamultiply
		}
	}

	background = {
		visible = "[And3( HolySiteItem.GetHolySite.IsActive, HolySiteItem.IsHeldByFaith, HolySiteItem.GetFaith.IsEminentHolySite( HolySite.Self ) )]"
		texture = "gfx/interface/window_military/military_banner_blue.dds"
		margin_bottom = 8
		alpha = 0.8
	}

	background = {
		visible = "[And( Not(HolySiteItem.IsHeldByFaith ), HolySiteItem.GetFaith.IsEminentHolySite( HolySite.Self ) )]"
		texture = "gfx/interface/window_military/military_banner_red.dds"
		margin_bottom = 8
		alpha = 0.8
	}

	background = {
		visible = "[And( And( Not( HolySiteItem.GetHolySite.IsActive), HolySiteItem.IsHeldByFaith ), HolySiteItem.GetFaith.IsEminentHolySite( HolySite.Self ) )]"
		texture = "gfx/interface/window_military/military_banner_gray.dds"
		margin_bottom = 8
	}
}
