######################################################
############# Web Of Knives Window ################
######################################################

window = {
	name = "web_of_knives"
	position = { 0 0 }
	parentanchor = center

	layer = windows_layer
	size = { 650 600 }
	
	#state = {
	#	name = _show
	#	using = Animation_FadeIn_Quick
	#	using = Sound_WindowShow_Standard
	#}

	#state = {
	#	name = _hide
	#	using = Animation_FadeOut_Quick
	#	using = Sound_WindowHide_Standard
	#}
	using = Window_Background
	using = Window_Decoration_Spike
	
	vbox = { 
		layoutpolicy_horizontal = expanding
		margin_left = 10
		margin_bottom = 20
		spacer = {
			size = { 0 14 }
		}
		header_pattern_interaction = {
			layoutpolicy_horizontal = expanding
			max_width = 600
			blockoverride "header_text" {
				text = WoK_title_loc
			}

			blockoverride "button_close"
			{
				onclick = "[ExecuteConsoleCommand('GUI.ClearWidgets web_of_knives')]"
				
			}
			
			button_standard = {
				down = "[GetVariableSystem.Exists( 'web_out_of_range_chars' )]"
				onclick = "[GetVariableSystem.Toggle( 'web_out_of_range_chars' )]"
				text = WoK_out_range_loc
				tooltip = WoK_out_range_loc
			}
			#icon_character_interaction = {}
		}
		hbox = {
			parentanchor = top|left	
			text_single = {
				max_width = 650
				text = web_of_knives_intro
				#margin_right = 20
				using = Font_Size_Big
			}
		}		
		vbox_character_list = {
			layoutpolicy_vertical = expanding
			layoutpolicy_horizontal = expanding
			max_width = 600
			
			blockoverride "sort_buttons" {}
			blockoverride "character_count" {}
			blockoverride "scrollbox_margins" {
				margin_right = 15
				margin_top = 6
				
			}

			blockoverride "container_implementation" {
				dynamicgridbox = {
					name = "characters_grid"
		
					
		
					datamodel = "[GetPlayer.MakeScope.GetList('web_of_knives_targets')]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding
					ignoreinvisible = yes
					
					item = {
							
						widget = {
							size = { 600 200 } 
							visible = "[Or(GetVariableSystem.Exists( 'web_out_of_range_chars' ),GetScriptedGui('web_of_knives_list_gui_dip_range').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('target', Scope.GetCharacter.MakeScope ).End) )]"
						
							datacontext = "[Scope.GetCharacter]"
							hbox = {
								layoutpolicy_horizontal = expanding
								margin_right = 10
								spacing = 5

								background = {
									using = Background_Area_With_Header
								}
								vbox = {
									margin_left = 20
									text_single = {
										text = WoK_target_loc
										
										using = Font_Size_Medium
									}
									portrait_shoulders = {}
									
								}
								
								vbox = {
									
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									hbox = {
										layoutpolicy_horizontal = expanding

										text_single = {
											name = "name"
											layoutpolicy_horizontal = expanding
											autoresize = no
											text = "[Character.GetUINameNoTooltip]"
											using = Font_Size_Medium
											align = nobaseline
											fontsize_min = 14
											margin_right = 10
											margin_bottom = 20
										}
										
										hbox_skills_grid = {
											margin_bottom = 20
											text_single = {
												name = "intrigue"
												layoutpolicy_horizontal = expanding
												autoresize = no
												text = "[intrigue_i|e][Character.GetSkill('intrigue')|0]"
												align = nobaseline
											}
										}
										
										
									}
									hbox = {
										vbox = {
											text_single = {
												text = WoK_reward_loc
												margin_right = 20
												using = Font_Size_Medium
											}
											text_single = {
												text = "[gold_i|E][Character.MakeScope.Var('web_gold_reward').GetValue|0]"
												margin_right = 20
												using = Font_Size_Medium
											}
										}
										dynamicgridbox = {
											flipdirection = yes
											datamodel = "[Character.MakeScope.GetList('contractor')]"
											item = {
												vbox = {

													text_single = {
														text = "[Localize('WoK_contractor_loc')] [Scope.GetCharacter.GetFirstNameNoTooltip]"
														margin_right = 20
														#autoresize = no
														layoutpolicy_horizontal = expanding
														
														align = nobaseline
														fontsize_min = 14
														
													}
													
													portrait_head_small = {
														datacontext = "[Scope.GetCharacter]"
														name = "contractor_portrait"
														blockoverride "opinion_box" {}
														blockoverride "status_icons" {}
													}
												}
											}
										}
										
										
									}
									
								}
							}
						}
					}
				}
			}
		}
		
		
	}
		
		

	
	




}

