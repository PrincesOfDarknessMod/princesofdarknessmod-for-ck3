pod_angra_mainyu_conversion_scheme = {
	# Basic Setup
	skill = intrigue
	desc = pod_angra_mainyu_conversion_scheme_desc
	success_desc = pod_angra_mainyu_conversion_scheme_success_desc
	icon = icon_scheme_vampire
	illustration = "gfx/interface/illustrations/event_scenes/corridor.dds"
	target_type = character
	is_secret = yes 
	maximum_breaches = 0
	is_basic = yes
	cooldown = { years = 2 }

	# Parameters
	speed_per_skill_point = -0.25
	speed_per_target_skill_point = 0.5
	base_progress_goal = 400
	maximum_secrecy = 95
	base_maximum_success = 95
	minimum_success = 0
	freeze_scheme_when_traveling = yes
	freeze_scheme_when_traveling_target = yes

	# Core Triggers
	allow = {
		has_personal_tenet_flag = unlocks_tempt_conversion_scheme
		POD_is_vampire_trigger = yes
		is_adult = yes
		is_imprisoned = no
		trigger_if = {
			limit = {
				NOT = { government_has_flag = government_is_landless_adventurer }
			}
			is_travelling = no
		}
		scope:target = {
			is_adult = yes
			faith != scope:owner.faith
			is_imprisoned = no
			trigger_if = {
				limit = {
					scope:owner = {
						NOT = { government_has_flag = government_is_landless_adventurer }
					}
				}
				is_travelling = no
			}
			POD_is_available = yes
		}
	}
	valid = {
		is_incapable = no
		custom_tooltip = {
			text = pod_setite_serpent_embrace_blocked
			NOT = {
				scope:target = {
					has_variable = block_pod_setite_serpent_embrace
				}
			}
		}
	}
	use_secrecy = {
		trigger_if = {
			limit = { exists = scope:owner }
			use_convert_to_witchcraft_secrecy_trigger = { OWNER = scope:owner }
		}
	}

	odds_prediction = {
		add = base_odds_prediction_target_is_char_value
		add = odds_skill_contribution_intrigue_value
		min = 0
	}

	# Base Chances
	base_success_chance = {
		base = 0
		scheme_type_skill_success_chance_modifier = { SKILL = INTRIGUE }

		# Target trait modifiers
		modifier = {
			scope:target = { has_trait = zealous }
			desc = "SCHEME_TRAIT_ZEALOUS"
			add = -50
		}
		modifier = {
			scope:target = { has_trait = devoted }
			desc = "SCHEME_TRAIT_DEVOTED"
			add = -30
		}
		modifier = {
			scope:target = { has_trait = cynical }
			desc = "SCHEME_TRAIT_CYNICAL"
			add = 15
		}
		modifier = {
			scope:target = { has_trait = trusting }
			desc = "SCHEME_TRAIT_TRUSTING"
			add = 10
		}
		modifier = {
			scope:target = { has_trait = lustful }
			desc = "SCHEME_LUSTFUL_TRAIT"
			add = 10
		}
		modifier = {
			scope:target = { has_trait = greedy }
			desc = "SCHEME_TRAIT_GREEDY"
			add = 10
		}
		modifier = {
			scope:target = { has_trait = deceitful }
			desc = "SCHEME_TRAIT_DECEITFUL"
			add = 5
		}
		modifier = {
			scope:target = { has_trait = ambitious }
			desc = "SCHEME_TRAIT_AMBITIOUS"
			add = 5
		}
		modifier = {
			scope:target = { has_trait = paranoid }
			desc = "SCHEME_TRAIT_PARANOID"
			add = -20
		}

		# Opinion
		opinion_modifier = {
			who = scope:target
			opinion_target = scope:owner
			min = -50
			max = 50
			multiplier = 0.5
			step = 5
		}

		# Attraction
		modifier = {
			add = 15
			scope:owner = { attraction >= 15 }
			scope:target = { is_attracted_to_gender_of = scope:owner }
			desc = SCHEME_ATTRACTION
		}

		# Personal Scheme Shared
		personal_scheme_base_success_chance_modifiers = yes
	}

	base_secrecy = {
		add = secrecy_base_value
		add = countermeasure_apply_secrecy_maluses_value
	}

	# On Actions
	on_start = {
		save_scope_as = scheme
		scheme_owner = { save_scope_as = owner }
		scheme_target_character = { save_scope_as = target }
		# If target already shares our faith, abort
		if = {
			limit = {
				scope:target = { faith = scope:owner.faith }
			}
			end_scheme = yes
		}
	}

	on_phase_completed = {
		save_scope_as = scheme
		scheme_target_character = { save_scope_as = target }
		scheme_owner = { save_scope_as = owner }

		# The engine rolls success automatically for non-basic schemes.
		# This fires after each phase — we roll against success chance
		# to determine if this phase succeeds or we continue.
		
		scope:scheme = {
			scheme_owner = {
				#SUCCESS ROLL
				random = {
					chance = scope:scheme.scheme_success_chance
					save_scope_value_as = {
						name = scheme_successful
						value = yes
					}
				}
				if = {
					limit = { scope:target = { is_ai = yes } }
					if = {
						limit = { exists = scope:scheme_successful }
						scope:target = {
							set_character_faith = scope:owner.faith
							hidden_effect = {
								set_variable = {
									name = block_pod_setite_serpent_embrace
									value = yes
									years = 10
								}
							}
						}
						scope:owner = {
							trigger_event = pod_angra_mainyu_conversion.0001
							send_interface_message = {
								type = event_generic_good
								title = pod_angra_mainyu_conversion_scheme_success_title
								left_icon = scope:target
								custom_tooltip = pod_angra_mainyu_conversion_scheme_success_tt
							}
						}
						scope:scheme = { end_scheme = yes }
					}
					else = {
						scope:target = {
							hidden_effect = {
								set_variable = {
									name = block_pod_setite_serpent_embrace
									value = yes
									years = 10
								}
							}
						}
						send_interface_message = {
							type = event_generic_neutral
							title = pod_angra_mainyu_conversion_scheme_failure_title
							left_icon = scope:target
							custom_tooltip = pod_angra_mainyu_conversion_scheme_failure_tt
						}
						scope:scheme = { end_scheme = yes }
					}
				}
				else = {
					if = {
						limit = { exists = scope:scheme_successful }
						scope:target = {
							trigger_event = pod_angra_mainyu_conversion.0002
						}
						scope:scheme = { end_scheme = yes }
					}
					else = {
						scope:target = {
							hidden_effect = {
								set_variable = {
									name = block_pod_setite_serpent_embrace
									value = yes
									years = 10
								}
							}
						}
						scope:scheme = { end_scheme = yes }
					}
				}
			}
		}
	}

	on_monthly = {
		save_scope_as = scheme
		scheme_owner = { save_scope_as = owner }
		scope:target = { save_scope_as = target }
		hostile_scheme_monthly_discovery_chance_effect = yes

		if = {
			limit = {
				NOT = { exists = scope:discovery_event_happening }
			}			
			scheme_owner = {
				trigger_event = {
					on_action = PODgeneric_intrigue_ongoing
					days = { 1 30 }
				}
			}
		}
	}

	on_invalidated = {
		save_scope_as = scheme
		scheme_target_character = { save_scope_as = target }
		scheme_owner = { save_scope_as = owner }
		# Notify owner on invalidation
		scope:owner = {
			send_interface_message = {
				type = event_generic_neutral
				title = pod_angra_mainyu_conversion_scheme_failure_title
				left_icon = scope:target
				custom_tooltip = pod_angra_mainyu_conversion_scheme_failure_tt
			}
		}
		scope:target = {
			hidden_effect = {
				set_variable = {
					name = block_pod_setite_serpent_embrace
					value = yes
					years = 5
				}
			}
		}
	}
}