
# PoD has a few custom effects to further customize the way story_cycles are displayed.
# These have to be used in an effect block (like on_setup) on the story scope unless otherwise specified.


##### GRAPHICAL EFFECTS

# By default, the icon for the story_cycle has a blueish brushstroke as a background.
# This effect lets you change the color of that background.
# The arguments are the red/green/blue/alpha values for the color, with values between 0 and 1.
# Here's a color picker for RGB 0-1: https://rgbcolorpicker.com/0-1
# The values in the example below are the default blueish color from the vanilla story_cycles.
POD_set_story_cycle_icon_bg_colors = {
	R = 0.3
	G = 0.4
	B = 0.48
	A = 0.75
}

# Makes the brushstroke completely invisible.
# Equivalent to setting all the arguments for the above effect to 0.
POD_set_story_cycle_icon_bg_transparent = yes

# Completely hides the story's title, flavor description, and icon.
# The title and desc can't have dynamic text, but take up a lot of space.
# Hiding them can make the layout flow better.
POD_hide_story_cycle_header = yes

# Used in conjunction with the above effect to put the story's icon to the right of the custom_string.
# For when you want to save on vertical space but still want to display the icon.
POD_display_story_cycle_icon_right = yes


##### DATA DISPLAY EFFECTS

# Makes it so traits don't show their modifiers or flavor text.
# For when you only care about displaying a trait experience track.
POD_hide_story_cycle_trait_desc = yes


##### CUSTOM LISTS

# Displays your Coterie as a character list.
# It's listed before the other character lists and shows every member (including you) and the CoA.
# Displays nothing if you have no Coterie.
POD_show_coterie_in_story_cycle = yes

# Adds a Journey button to the story_cycle, similar to the decision buttons.
# The usual triggers apply, so the button is only visible if the Journey would be visible to the player.
# The argument is the Journey ID of a Journey that is in one of the two main global lists.
# (GUITYPE = journey or GUITYPE = great_journey when using POD_add_to_journey_list)
# Due to when journeys are loaded, you can't call this effect in a story made in /history or other early points
POD_add_journey_to_story_cycle = { TYPE = hunt_in_capital }

# Adds a toggleable checkbox to the story_cycle.
# The SGUI argument refers to two things:
# - A localization key, which will be used as the label for the checkbox.
# - A scripted_gui, which will be used for the functionality.
# The scripted_gui would have this kind of setup:
# example_sgui = {
#     # The story_cycle is the root scope.
#     # You can access its usual event targets from there (e.g. story_owner).
#     scope = story
#     effect = {
#         # What happens when you toggle the checkbox.
#         # The effect tooltip is also shown as the checkbox button's tooltip.
#     }
#     is_shown = {
#         # Whether the checkbox is ticked or not.
#     }
#     is_valid = {
#         # Optional: Whether the option is enabled (clickable).
#         # Also shows up in the tooltip in case the option is disabled.
#     }
# }
POD_add_sgui_checkbox_to_story_cycle = { SGUI = example_sgui }

# Removes a checkbox from the list, since otherwise there's no way to hide them.
POD_remove_sgui_checkbox_from_story_cycle = { SGUI = example_sgui }