# Idle

entity = {
	name = "pod_weremillipede_idle_entity"
	pdxmesh = "pod_weremillipede_mesh"
	
	default_state = "weremillipede_idle_entry"

	state = {	name = "weremillipede_idle_entry"							animation = "pod_weremillipede_idle_1"		next_state = "weremillipede_idle" }
	state = {	name = "weremillipede_idle"								animation = "pod_weremillipede_idle_1"		next_state = "weremillipede_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

