		portrait_entity_user_data = {
			portrait_accessory = {
				pattern_mask = "gfx/models/portraits/supe/skeleton/skeleton_head_pattern_01_masks.dds"	#Any 4-channel texture. Each channel will be used to mask a pattern from the variation object
				variation = "lich_skull_runes"	#A "variation" object in gfx/portraits/accessory_variations/
			}
		}
	}

}

