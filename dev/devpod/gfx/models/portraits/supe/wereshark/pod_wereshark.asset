pdxmesh = {
	name = "pod_wereshark_mesh"
	file = "pod_wereshark.mesh"

	meshsettings = {
		name = "pod_wereshark_body_m"
		index = 0
		#texture_diffuse = "null_diffuse.dds"
		texture_normal = "null_normal.dds"
		texture_specular = "null_gloss.dds"	
		texture_diffuse = "pod_wereshark_body_01_diffuse.dds"
		#texture_normal = "pod_wereshark_body_01_normal.dds"
		#texture_specular = "pod_wereshark_body_01_properties.dds"
		#shader = "portrait_skin"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	animation = { id = "pod_wereshark_idle_1"				type = "pod_wereshark_idle.anim" }
}

