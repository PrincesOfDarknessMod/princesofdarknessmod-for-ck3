# Idle

entity = {
	name = "pod_wereshark_idle_entity"
	pdxmesh = "pod_wereshark_mesh"
	
	default_state = "shark_idle_entry"

	state = {	name = "shark_idle_entry"							animation = "pod_wereshark_idle_1"		next_state = "shark_idle" }
	state = {	name = "shark_idle"								animation = "pod_wereshark_idle_1"		next_state = "shark_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

