# Idle

entity = {
	name = "pod_aquarii_idle_entity"
	pdxmesh = "pod_aquarii_mesh"
	
	default_state = "aquarii_idle_entity"

	state = {	name = "aquarii_idle_entity"							animation = "pod_aquarii_idle_1"		next_state = "aquarii_idle" }
	state = {	name = "aquarii_idle"								animation = "pod_aquarii_idle_1"		next_state = "aquarii_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

