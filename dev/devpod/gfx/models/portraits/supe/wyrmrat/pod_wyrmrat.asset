# Wyrmrat

pdxmesh = {
	name = "pod_wyrmrat_mesh"
	file = "pod_wyrmrat.mesh"

	meshsettings = {
		name = "pod_wyrmrat_body_m"
		index = 0
		texture_normal = "null_normal.dds"
		texture_specular = "null_gloss.dds"	
		texture_diffuse = "pod_wyrmrat_body_01_diffuse.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "pod_wyrmrat_fur_m"
		index = 0
		texture_diffuse = "pod_wererat_fur_01_diffuse.dds"
		texture_normal = "pod_wererat_fur_01_normal.dds"
		texture_specular = "null_gloss.dds"
		shader = "portrait_hair"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	animation = { id = "wyrmrat_idle_1"				type = "pod_wyrmrat_idle_1.anim" }
	animation = { id = "wyrmrat_idle_2"				type = "pod_wyrmrat_idle_2.anim" }	
}

