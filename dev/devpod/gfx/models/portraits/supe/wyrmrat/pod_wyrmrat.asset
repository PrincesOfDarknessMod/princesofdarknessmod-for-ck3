# Idle

entity = {
	name = "pod_wyrmrat_idle_entity"
	pdxmesh = "pod_wyrmrat_mesh"
	scale = 1.5
	
	default_state = "wyrmrat_idle_entry"

	state = {	name = "wyrmrat_idle_entry"							animation = "wyrmrat_idle_1"		next_state = "wyrmrat_idle" }
	state = {	name = "wyrmrat_idle"								animation = "wyrmrat_idle_1"		next_state = "wyrmrat_idle" }
	state = {	name = "wyrmrat_idle"								animation = "wyrmrat_idle_2"		next_state = "wyrmrat_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

