pdxmesh = {
	name = "pod_fox_mesh"
	file = "pod_fox.mesh"

	meshsettings = {
		name = "pod_werefox_body_m"
		index = 0
		#texture_diffuse = "null_diffuse.dds"
		texture_normal = "null_normal.dds"
		texture_specular = "null_gloss.dds"	
		texture_diffuse = "pod_werefox_body_01_diffuse.dds"
		#texture_normal = "pod_werefox_body_01_normal.dds"
		#texture_specular = "pod_werefox_body_01_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	animation = { id = "pod_fox_idle_1"				type = "pod_fox_idle.anim" }
}

