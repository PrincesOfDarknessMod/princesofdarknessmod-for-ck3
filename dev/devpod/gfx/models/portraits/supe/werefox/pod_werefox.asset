# Idle
entity = {
	name = "pod_fox_idle_entity"
	pdxmesh = "pod_fox_mesh"
	scale = 2.7
	
	default_state = "fox_idle_entry"

	state = {	name = "fox_idle_entry"							animation = "pod_fox_idle_1"		next_state = "fox_idle" }
	state = {	name = "fox_idle"								animation = "pod_fox_idle_1"		next_state = "fox_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

