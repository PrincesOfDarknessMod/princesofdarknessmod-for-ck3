# Idle

entity = {
	name = "pod_werebeetle_idle_entity"
	pdxmesh = "pod_werebeetle_mesh"
	
	default_state = "beetle_idle_entry"

	state = {	name = "beetle_idle_entry"							animation = "pod_werebeetle_idle_1"		next_state = "beetle_idle" }
	state = {	name = "beetle_idle"								animation = "pod_werebeetle_idle_1"		next_state = "beetle_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

