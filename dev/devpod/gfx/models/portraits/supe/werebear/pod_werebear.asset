# POD werebear meshes and entities
# Model purchased from Dremorn's Mithical Monsters Pack https://www.cgtrader.com/3d-model-collections/mithical-monsters-collection-pack1

pdxmesh = {
	name = "pod_werebear_mesh"
	file = "pod_werebear.mesh"

	meshsettings = {
		name = "pod_werebear_body_m"
		index = 0
		texture_specular = "null_gloss.dds"
		texture_diffuse = "pod_werebear_body_01_diffuse.dds"
		texture_normal = "null_normal.dds"
		shader = "portrait_hair"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "pod_werebear_fur_m"
		index = 0
		texture_diffuse = "pod_werebear_fur_01_diffuse.dds"
		texture_normal = "pod_werebear_fur_01_normal.dds"
		texture_specular = "null_gloss.dds"
		shader = "portrait_hair"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	animation = { id = "pod_werebear_idle_1"				type = "pod_werebear_idle.anim" } #y+35 z-105
}


pdxmesh = {
	name = "pod_werebear_hairless_mesh"
	file = "pod_werebear.mesh"

	meshsettings = {
		name = "pod_werebear_body_m"
		index = 0
		texture_specular = "null_gloss.dds"
		texture_diffuse = "pod_werebear_body_01_diffuse.dds"
