# Idle

entity = {
	name = "pod_wereant_idle_entity"
	pdxmesh = "pod_wereant_mesh"
	
	default_state = "ant_idle_entry"

	state = {	name = "ant_idle_entry"							animation = "pod_wereant_idle_1"		next_state = "ant_idle" }
	state = {	name = "ant_idle"								animation = "pod_wereant_idle_1"		next_state = "ant_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

