# Idle

entity = {
	name = "pod_werespider_idle_entity"
	pdxmesh = "pod_werespider_mesh"
	
	default_state = "spider_idle_entry"

	state = {	name = "spider_idle_entry"							animation = "pod_werespider_idle_1"		next_state = "spider_idle" }
	state = {	name = "spider_idle"								animation = "pod_werespider_idle_1"		next_state = "spider_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

