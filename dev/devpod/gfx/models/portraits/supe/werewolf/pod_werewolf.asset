# POD werewolf meshes and entities
# Model purchased from Dremorn's Mithical Monsters Pack https://www.cgtrader.com/3d-model-collections/mithical-monsters-collection-pack1

pdxmesh = {
	name = "pod_werewolf_mesh"
	file = "pod_werewolf.mesh"

	meshsettings = {
		name = "pod_werewolf_body_m"
		index = 0
		texture_diffuse = "pod_werewolf_body_01_diffuse.dds"
		texture_normal = "pod_werewolf_body_01_normal.dds"
		texture_specular = "pod_werewolf_body_01_properties.dds"
		shader = "portrait_hair"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "pod_werewolf_fur_m"
		index = 0
		#texture_diffuse = "null_diffuse.dds"
		#texture_normal = "null_normal.dds"
		#texture_specular = "null_gloss.dds"	
		texture_diffuse = "pod_werewolf_fur_01_diffuse.dds"
		texture_normal = "pod_werewolf_fur_01_normal.dds"
		texture_specular = "pod_werewolf_fur_01_properties.dds"
		#shader = "portrait_attachment"
		texture = { file = "black_ssao_color.dds" index = 3 }
		shader = "portrait_hair"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

