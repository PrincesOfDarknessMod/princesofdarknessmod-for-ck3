# Idle

entity = {
	name = "pod_werelion_idle_entity"
	pdxmesh = "pod_werelion_mesh"
	
	default_state = "lion_idle_entry"

	state = {	name = "lion_idle_entry"							animation = "pod_werelion_idle_1"		next_state = "lion_idle" }
	state = {	name = "lion_idle"								animation = "pod_werelion_idle_1"		next_state = "lion_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

entity = {
	name = "pod_werelion_hairless_idle_entity"
