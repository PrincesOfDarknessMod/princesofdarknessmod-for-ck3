# Idle

entity = {
	name = "pod_wererat_idle_entity"
	pdxmesh = "pod_wererat_mesh"
	
	default_state = "wererat_idle_entry"

	state = {	name = "wererat_idle_entry"							animation = "wererat_idle_1"		next_state = "wererat_idle" }
	state = {	name = "wererat_idle"								animation = "wererat_idle_1"		next_state = "wererat_idle" }
	state = {	name = "wererat_idle"								animation = "wererat_idle_2"		next_state = "wererat_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

entity = {
	name = "pod_wererat_hairless_idle_entity"
	pdxmesh = "pod_wererat_hairless_mesh"
	
