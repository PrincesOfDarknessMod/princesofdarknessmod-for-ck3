# Idle

entity = {
	name = "pod_werebee_idle_entity"
	pdxmesh = "pod_werebee_mesh"
	
	default_state = "bee_idle_entry"

	state = {	name = "bee_idle_entry"							animation = "pod_werebee_idle_1"		next_state = "bee_idle" }
	state = {	name = "bee_idle"								animation = "pod_werebee_idle_1"		next_state = "bee_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

