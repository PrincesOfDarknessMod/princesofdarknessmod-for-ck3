pdxmesh = {
	name = "pod_werecat_female_mesh"
	file = "pod_werecat_female_head.mesh"

	meshsettings = {
		name = "pod_werecat_body_m"
		index = 0
		#texture_diffuse = "null_diffuse.dds"
		texture_normal = "null_normal.dds"
		texture_specular = "null_gloss.dds"	
		texture_diffuse = "pod_werecat_body_01_diffuse.dds"
		#texture_normal = "pod_werecat_body_01_normal.dds"
		#texture_specular = "pod_werecat_body_01_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "pod_werecat_neck_m"
		index = 0
		texture_diffuse = "female_head_diffuse.dds"
		texture_normal = "female_head_normal.dds"
		texture_specular = "female_head_properties.dds"
		texture = { file = "female_head_ssao_color.dds" index = 3 }
		shader = "portrait_skin_face"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}

