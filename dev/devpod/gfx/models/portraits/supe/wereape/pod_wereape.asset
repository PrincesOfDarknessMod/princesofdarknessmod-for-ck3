pdxmesh = {
	name = "pod_wereape_mesh"
	file = "pod_wereape.mesh"

	meshsettings = {
		name = "pod_wereape_body_m"
		index = 0
		texture_normal = "null_normal.dds"
		texture_specular = "null_gloss.dds"
		texture_diffuse = "pod_wereape_body_01_diffuse.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "pod_wereape_fur_m"
		index = 0
		texture_diffuse = "pod_wereape_fur_01_diffuse.dds"
		texture_normal = "pod_wereape_fur_01_normal.dds"
		texture_specular = "null_gloss.dds"
		shader = "portrait_hair"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	animation = { id = "pod_wereape_idle_1"				type = "pod_wereape_idle.anim" }
}

pdxmesh = {
	name = "pod_wereape_hairless_mesh"
	file = "pod_wereape.mesh"

	meshsettings = {
		name = "pod_wereape_body_m"
		index = 0
		texture_normal = "null_normal.dds"
		texture_specular = "null_gloss.dds"
		texture_diffuse = "pod_wereape_body_01_diffuse.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
	
	meshsettings = {
		name = "pod_wereape_fur_m"
		index = 0
		shader = "portrait_hair"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}	

	animation = { id = "pod_wereape_idle_1"				type = "pod_wereape_idle.anim" }
}

# Idle

entity = {
	name = "pod_wereape_idle_entity"
	pdxmesh = "pod_wereape_mesh"
	
	default_state = "ape_idle_entry"

	state = {	name = "ape_idle_entry"							animation = "pod_wereape_idle_1"		next_state = "ape_idle" }
	state = {	name = "ape_idle"								animation = "pod_wereape_idle_1"		next_state = "ape_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

entity = {
	name = "pod_wereape_hairless_idle_entity"
