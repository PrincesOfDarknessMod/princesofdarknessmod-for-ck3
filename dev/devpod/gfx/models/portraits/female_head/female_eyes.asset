# NOTE FOR POD:
# the vanilla eye shader assumes that you'll further blend its colors with the character's genetic eye color
# which will lead to visual glitches unless we use a custom shader
# add these lines to the meshsettings to prevent this:
#	additional_shader_defines = { "IGNORE_GENETIC_EYE_COLOR" }
#	shader = "portrait_eye"
#	shader_file = "gfx/FX/jomini/portrait.shader"

entity = {
	name = "female_eyes_POD_serp_entity"
	pdxmesh = "female_eyes_mesh"
	
	meshsettings = {
		name = "female_eyesShape"
		index = 0
		texture_diffuse = "male_POD_serp_eyes_diffuse.dds"
		#texture_normal = "male_POD_serp_eyes_normal.dds"
		#texture_specular = "male_POD_serp_eyes_properties.dds"
		additional_shader_defines = { "IGNORE_GENETIC_EYE_COLOR" }
		shader = "portrait_eye"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}

