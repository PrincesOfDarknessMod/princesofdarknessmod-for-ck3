# Idle

entity = {
	name = "pod_wereserpent_idle_entity"
	pdxmesh = "pod_wereserpent_mesh"
	
	default_state = "serpent_idle_entry"

	state = {	name = "serpent_idle_entry"							animation = "pod_wereserpent_idle_1"		next_state = "serpent_idle" }
	state = {	name = "serpent_idle"								animation = "pod_wereserpent_idle_1"		next_state = "serpent_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

