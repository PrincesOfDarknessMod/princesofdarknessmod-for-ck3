pdxmesh = {
	name = "pod_wereraven_mesh"
	file = "pod_wereraven.mesh"

	meshsettings = {
		name = "pod_wereraven_body_m"
		index = 0
		texture_normal = "null_normal.dds"
		texture_specular = "null_gloss.dds"	
		texture_diffuse = "pod_wereraven_body_01_diffuse.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = { # Feather
		name = "pod_wereraven_fur_m"
		index = 0
		texture_specular = "null_gloss.dds"
		texture_diffuse = "pod_wereraven_fur_01_diffuse.dds"
		texture_normal = "pod_wereraven_fur_01_normal.dds"
		shader = "portrait_hair"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "pod_wereraven_armor_m"
		index = 0
		texture_normal = "null_normal.dds"
		texture_specular = "null_gloss.dds"
		texture_diffuse = "pod_wereraven_armor_01_diffuse.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	animation = { id = "pod_wereraven_idle_1"				type = "pod_wereraven_idle.anim" } #y+35 z-105
}


