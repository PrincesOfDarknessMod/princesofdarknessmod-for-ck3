# Idle

entity = {
	name = "pod_wereraven_idle_entity"
	pdxmesh = "pod_wereraven_mesh"
	
	default_state = "raven_idle_entry"

	state = {	name = "raven_idle_entry"							animation = "pod_wereraven_idle_1"		next_state = "raven_idle" }
	state = {	name = "raven_idle"								animation = "pod_wereraven_idle_1"		next_state = "raven_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

