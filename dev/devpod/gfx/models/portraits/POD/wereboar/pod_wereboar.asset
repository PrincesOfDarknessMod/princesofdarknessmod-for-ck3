pdxmesh = {
	name = "pod_wereboar_mesh"
	file = "pod_wereboar.mesh"

	meshsettings = {
		name = "pod_wereboar_body_m"
		index = 0
		texture_normal = "null_normal.dds"
		texture_specular = "null_gloss.dds"
		texture_diffuse = "pod_wereboar_body_01_diffuse.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "pod_wereboar_fur_m"
		index = 0
		texture_diffuse = "pod_wereboar_fur_01_diffuse.dds"
		texture_normal = "pod_wereboar_fur_01_normal.dds"
		texture_specular = "null_gloss.dds"
		shader = "portrait_hair"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	animation = { id = "pod_wereboar_idle_1"				type = "pod_wereboar_idle.anim" } #y+35 z-105
}

