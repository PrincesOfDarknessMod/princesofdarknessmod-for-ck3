# Idle

entity = {
	name = "pod_wereboar_idle_entity"
	pdxmesh = "pod_wereboar_mesh"
	
	default_state = "boar_idle_entry"

	state = {	name = "boar_idle_entry"							animation = "pod_wereboar_idle_1"		next_state = "boar_idle" }
	state = {	name = "boar_idle"								animation = "pod_wereboar_idle_1"		next_state = "boar_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}


