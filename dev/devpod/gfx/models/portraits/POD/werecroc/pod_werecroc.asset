# Idle

entity = {
	name = "pod_werecroc_idle_01_entity"
	pdxmesh = "pod_werecroc_01_mesh"
	
	default_state = "werecroc_idle_entry"

	state = {	name = "werecroc_idle_entry"							animation = "pod_werecroc_idle_1"		next_state = "werecroc_idle" }
	state = {	name = "werecroc_idle"								animation = "pod_werecroc_idle_1"		next_state = "werecroc_idle" }
	
	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

