pdxmesh = {
	name = "pod_werecroc_01_mesh"
	file = "pod_werecroc.mesh"

	meshsettings = {
		name = "pod_werecroc_body_m"
		index = 0
		#texture_normal = "null_normal.dds"
		texture_normal = "pod_werecroc_body_01_normal.dds"
		texture_specular = "null_gloss.dds"	
		texture_diffuse = "pod_werecroc_body_01_diffuse.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	animation = { id = "pod_werecroc_idle_1"				type = "pod_werecroc_idle.anim" }
}


