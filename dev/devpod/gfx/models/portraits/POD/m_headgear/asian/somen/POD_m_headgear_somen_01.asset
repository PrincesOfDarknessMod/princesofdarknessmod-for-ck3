}

# Wooden

entity = {
	name = "POD_m_headgear_somen_01_entity"
	pdxmesh = "POD_m_headgear_somen_01_mesh"

	game_data = {
		portrait_entity_user_data = {
			portrait_accessory = {
				pattern_mask = "/gfx/models/portraits/POD/m_headgear/asian/somen/POD_m_headgear_somen_01_masks.dds"	#Any 4-channel texture. Each channel will be used to mask a pattern from the variation object
				variation = "POD_somen_01"	#A "variation" object in gfx/portraits/accessory_variations/
			}
		}
	}
}	

