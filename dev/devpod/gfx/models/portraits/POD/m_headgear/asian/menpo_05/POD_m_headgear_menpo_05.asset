pdxmesh = {
	name = "POD_m_headgear_menpo_05_pattern_mesh"
	file = "POD_m_headgear_menpo_05_pattern.mesh"

	meshsettings = {
		name = "POD_m_headgear_mask_menpo_05_patternShape"
		index = 0
		texture_diffuse = "POD_m_headgear_menpo_05_white_diffuse.dds"
		#texture_normal = "POD_m_headgear_menpo_05_normal.dds"
		texture_normal = "null_normal.dds"
		texture_specular = "null_gloss.dds"	
		shader = "portrait_attachment_pattern"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}
}


# Wooden

entity = {
	name = "POD_m_headgear_menpo_05_wood_entity"
	pdxmesh = "POD_m_headgear_menpo_05_pattern_mesh"

	game_data = {
		portrait_entity_user_data = {
			portrait_accessory = {
				pattern_mask = "/gfx/models/portraits/POD/m_headgear/asian/menpo_05/POD_m_headgear_menpo_05_masks.dds"	#Any 4-channel texture. Each channel will be used to mask a pattern from the variation object
				#pattern_mask = "/gfx/models/portraits/POD/POD_plain_masks.dds"	#Any 4-channel texture. Each channel will be used to mask a pattern from the variation object
				variation = "POD_somen_01"	#A "variation" object in gfx/portraits/accessory_variations/
			}
		}
	}
}	

