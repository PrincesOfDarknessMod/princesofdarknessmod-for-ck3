# Idle

entity = {
	name = "pod_lung_idle_entity"
	pdxmesh = "pod_lung_mesh"
	scale = 20
	
	default_state = "lung_idle_entry"

	state = {	name = "lung_idle_entry"							animation = "pod_lung_anim_damped"		next_state = "lung_idle" }
	state = {	name = "lung_idle"								animation = "pod_lung_anim_damped"		next_state = "lung_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

entity = {
