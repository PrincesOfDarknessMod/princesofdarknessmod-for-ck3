pdxmesh = {
	name = "pod_lung_mesh"
	file = "pod_lung.mesh"

	meshsettings = {
		name = "pod_lung_body_m"
		index = 0
		texture_normal = "null_normal.dds"
		texture_specular = "null_gloss.dds"	
		texture_diffuse = "pod_lung_body_01_diffuse.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "pod_lung_fur_m"
		index = 0
		texture_diffuse = "pod_lung_fur_01_diffuse.dds"
		texture_normal = "pod_lung_fur_01_normal.dds"
		texture_specular = "pod_lung_fur_01_properties.dds"
		shader = "portrait_hair"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "pod_lung_eye_m"
		index = 0
		texture_normal = "null_normal.dds"
		texture_specular = "null_gloss.dds"	
		texture_diffuse = "pod_lung_eye_01_diffuse.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	# LUNG-ANIM begin: idles cut from PoD's existing animations
	animation = { id = "pod_lung_anim_coiled"			type = "pod_lung_idle_coiled.anim" }
	animation = { id = "pod_lung_anim_damped"			type = "pod_lung_idle_damped.anim" }
	# LUNG-ANIM end
	animation = { id = "pod_lung_idle_1"				type = "pod_lung_idle.anim" }
}

