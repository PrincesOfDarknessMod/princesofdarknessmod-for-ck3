pdxmesh = {
	name = "pod_rat_mesh"
	file = "pod_rat.mesh"

	meshsettings = {
		name = "pod_wererat_body_m"
		index = 0
		texture_diffuse = "pod_wererat_body_01_diffuse.dds"
		texture_normal = "pod_wererat_body_01_normal.dds"
		texture_specular = "pod_wererat_body_01_properties.dds"
		shader = "portrait_hair_alpha"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "pod_wererat_fur_m"
		index = 0
		texture_diffuse = "pod_wererat_fur_01_diffuse.dds"
		texture_normal = "pod_wererat_fur_01_normal.dds"
		texture_specular = "pod_wererat_fur_01_properties.dds"
		shader = "portrait_hair_alpha"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	animation = { id = "pod_rat_idle_1"				type = "pod_rat_idle.anim" } # y+40 z-52; Rotate X -25
}

# Idle

entity = {
	name = "pod_rat_idle_entity"
	pdxmesh = "pod_rat_mesh"
	
	default_state = "rat_idle_entry"

	state = {	name = "rat_idle_entry"							animation = "pod_rat_idle_1"		next_state = "rat_idle" }
	state = {	name = "rat_idle"								animation = "pod_rat_idle_1"		next_state = "rat_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}