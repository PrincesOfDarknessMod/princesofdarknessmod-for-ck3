# Idle

entity = {
	name = "pod_werewolf_idle_entity"
	pdxmesh = "pod_werewolf_mesh"
	
	default_state = "wolf_idle_entry"

	state = {	name = "wolf_idle_entry"							animation = "pod_werewolf_idle_1"		next_state = "wolf_idle" }
	state = {	name = "wolf_idle"								animation = "pod_werewolf_idle_1"		next_state = "wolf_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}

