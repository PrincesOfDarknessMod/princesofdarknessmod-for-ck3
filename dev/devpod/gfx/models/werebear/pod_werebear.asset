# Idle

entity = {
	name = "pod_werebear_idle_entity"
	pdxmesh = "pod_werebear_mesh"
	
	default_state = "bear_idle_entry"

	state = {	name = "bear_idle_entry"							animation = "pod_werebear_idle_1"		next_state = "bear_idle" }
	state = {	name = "bear_idle"								animation = "pod_werebear_idle_1"		next_state = "bear_idle" }

	game_data = {
		portrait_entity_user_data = {
			color_mask_remap_interval = {
				interval = {0.0 1.0}
			}
		}
	}
}