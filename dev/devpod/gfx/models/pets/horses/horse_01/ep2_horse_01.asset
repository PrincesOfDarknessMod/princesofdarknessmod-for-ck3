pdxmesh = {
	name = "ep2_horse_01_mesh"
	file = "ep2_horse_01.mesh"

	meshsettings = {
		name = "ep2_horse_01Shape"
		index = 0
		texture_diffuse = "ep2_horse_body_01_diffuse.dds"
		texture_normal = "ep2_horse_body_01_normal.dds"
		texture_specular = "ep2_horse_body_01_properties.dds"
		shader = "portrait_attachment_pattern_alpha_to_coverage"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "ep2_horse_01Shape"
		index = 1
		texture_diffuse = "ep2_horse_reins_01_diffuse.dds"
		texture_normal = "ep2_horse_reins_01_normal.dds"
		texture_specular = "ep2_horse_reins_01_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	meshsettings = {
		name = "ep2_horse_01Shape"
		index = 2
		texture_diffuse = "ep2_horse_saddle_01_diffuse.dds"
		texture_normal = "ep2_horse_saddle_01_normal.dds"
		texture_specular = "ep2_horse_saddle_01_properties.dds"
		shader = "portrait_attachment"
		shader_file = "gfx/FX/jomini/portrait.shader"
	}

	animation = { id = "horse_idle_1"				type = "ep2_horse_idle_1.anim" }
	animation = { id = "horse_idle_2"				type = "ep2_horse_idle_2.anim" }	
	animation = { id = "horse_gallop"				type = "ep2_horse_gallop.anim" }
	animation = { id = "horse_walk"					type = "ep2_horse_walk.anim" }
	animation = { id = "horse_gallop_race"			type = "ep2_horse_gallop_race.anim" }
    animation = { id = "horse_idle_for_victory"		type = "ep2_horse_idle_for_victory.anim" }
}

# Idle

entity = {
	name = "ep2_horse_01_idle_entity"
	pdxmesh = "ep2_horse_01_mesh"
	
	default_state = "jockey_idle_entry"

	state = {	name = "jockey_idle_entry"							animation = "horse_idle_1"		next_state = "jockey_idle" }
	state = {	name = "jockey_idle"								animation = "horse_idle_1"		next_state = "jockey_idle" }
	state = {	name = "jockey_idle"								animation = "horse_idle_1"		next_state = "jockey_idle" }
	state = {	name = "jockey_idle"								animation = "horse_idle_1"		next_state = "jockey_idle" }
	state = {	name = "jockey_idle"								animation = "horse_idle_2"		next_state = "jockey_idle" }
	
	game_data = {
		portrait_entity_user_data = {
			portrait_accessory = {
				pattern_mask = "gfx/models/pets/horses/horse_01/ep2_horse_body_01_masks.dds"	#Any 4-channel texture. Each channel will be used to mask a pattern from the variation object
				variation = "ep2_horse_basic"	#A "variation" object in gfx/portraits/accessory_variations/
			}
		}
	}
}

