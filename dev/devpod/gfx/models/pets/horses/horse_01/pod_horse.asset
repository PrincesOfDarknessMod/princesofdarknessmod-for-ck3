# Idle
entity = {
	name = "pod_horseear_female_entity"
	pdxmesh = "pod_horse_female_ear_mesh"
	
	game_data = {
		portrait_entity_user_data = {
			portrait_accessory = {
				pattern_mask = "gfx/models/pets/horses/horse_01/ep2_horse_body_01_masks.dds"	#Any 4-channel texture. Each channel will be used to mask a pattern from the variation object
				variation = "ep2_horse_basic"	#A "variation" object in gfx/portraits/accessory_variations/
			}
		}
	}
}

