entity = { # Falcon is being attached to the bn_l_prop (left hand)
	name = "ep2_falcon_peregrine_01_entity"
	pdxmesh = "ep2_falcon_peregrine_01.mesh"

	default_state = "falcon_start_entry"	
	state = {	name = "hunting_falcon_start_entry"					animation = "falcon_start" looping = no next_state = "hunting_falcon_loop" }
	state = {	name = "hunting_falcon_loop"						animation = "falcon_loop"  looping = no next_state = "hunting_falcon_loop" }

}

