# POD Coffin

pdxmesh = { #Coffin
	name = "POD_coffin_wooden_mesh"
	file = "POD_coffin_wooden.mesh"

	meshsettings = {
		name = "pCubeShape1"
		index = 0
		texture_diffuse = "POD_coffin_wooden_diffuse.dds"
		texture_normal = "nonormal.dds" #"POD_coffin_wooden_normal.dds"
		texture_specular =  "nospec.dds" #"POD_coffin_wooden_properties.dds"
		shader = "court"
		shader_file = "gfx/FX/court_scene.shader"
	}
}

entity = {
	name = "POD_coffin_wooden_entity"
	pdxmesh = "POD_coffin_wooden_mesh"
}

# POD Sarcophagi

pdxmesh = { #Sarcophagus Stone
	name = "POD_sarcophagus_stone_mesh"
	file = "POD_sarcophagus_stone.mesh"

	meshsettings = {
		name = "pCubeShape1"
		index = 0
		texture_diffuse = "POD_sarcophagus_stone_diffuse.dds"
		texture_normal = "nonormal.dds" #"POD_coffin_wooden_normal.dds"
		texture_specular =  "nospec.dds" #"POD_coffin_wooden_properties.dds"
		shader = "court"
		shader_file = "gfx/FX/court_scene.shader"
	}
}

entity = {
	name = "POD_sarcophagus_stone_entity"
	pdxmesh = "POD_sarcophagus_stone_mesh"
}